    <script>
        // Select Excel File And Submit Form
        $("input[name='usr_Picture']").change(function () {

            var file = this.files[0];
            var ext = file.name.split('.')[1];
            if (ext == "png" || ext == "jpg" || ext == "jpeg") {
                $("#pic_form").submit();
            }
            else {

                Swal.fire({
                    icon: 'warning',
                    background: 'rgb(29,40,52)',
                    color: 'white',
                    confirmButtonText: 'باشه',
                    title: 'نوع فایل',
                    text: 'لطفا فایلی با پسوند تصویر وارد کنید',
                });
                return false;
            }

        });
        /// Open Dialog File
        function UploadProfile() {
            $("input[name='usr_Picture']").click();
        }
    </script>
