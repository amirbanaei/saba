    <link href="~/Assets/plugins/sweetalert/sweetalert.css" rel="stylesheet" />
    <link href="~/MyStyles/MyStyle.css" rel="stylesheet" />

    @RenderSection("Styles", false)
    <style type="text/css">
        #loading-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #000;
            opacity: 0.5;
        }

        #loading-message {
            position: absolute;
            width: 100%;
            height: 100%;
            line-height: 100px;
            background-color: #1a1a1a;
            vertical-align: central;
            text-align: center;
            font-size: 1.2em;
            left: 0;
            top: 0;
            opacity: 0.7;
            margin-left: 0;
            margin-top: 0;
            z-index: 100000000000;
        }
    </style>
    <style>
        .page {
            display: none;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: white;
            z-index: 9999;
            overflow: hidden;
            animation-duration: 1s;
        }

        .show-page {
            display: block;
            animation-name: slide-in;
        }

        @@keyframes slide-in {
            from {
                opacity: 0;
                transform: translateX(-100%);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
    </style>
</head>
