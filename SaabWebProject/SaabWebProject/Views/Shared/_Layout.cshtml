                                                icon: 'error',
                                                confirmButtonText: 'باشه',
                                                title: 'خطا',
                                                text: 'برنامه با خطا مواجه شد',
                                            });
                                            return false;
                                        }
                                        Swal.fire({
                                            icon: 'success',
                                            confirmButtonText: 'باشه',
                                            title: ' غیر فعال شد ',
                                            text: 'بنرهای مورد نظر غیر فعال شدند',
                                        }).then(function () {
                                            document.location.reload();
                                        });
                                    },
                                    error: function () {
                                        document.getElementById("loading-message").style.display = "none";
                                        Toast.fire({
                                            icon: 'error',
                                            background: '#35434A',
                                            color: 'white',
                                            title: "عملیات با خطا مواجه شد لطفا بعدا تلاش کنید"
                                        });
                                    }
                                });
                            }
                        });

                    }
                    //---------------------------------------------
                };
        </script>

        <script>
            const appElement = document.getElementById('app');
            const floatSubmenu = document.getElementById('app-float-submenu'); // تعریف floatSubmenu در اینجا
            if (document.getElementById('app-float-submenu')) {
                const menuLinks = document.querySelectorAll('.menu-link');

                // حلقه ایجاد کنید تا برای هر آیکون یک رویداد موس وارد شدن و خروج اضافه کنید
                menuLinks.forEach(link => {
                    link.addEventListener('click', function () {
                        // بررسی آیا آیکون دارای کلاس menu-iconSidebar است یا خیر
                        if (this.querySelector('.menu-iconSidebar')) {
                            // یافتن دایو menu-submenu مربوطه
                            const submenu = this.nextElementSibling;

                            // اگر دایو menu-submenu مربوطه وجود داشته باشد
                            if (submenu) {
                                // محاسبه موقعیت مطلق بر اساس موقعیت آیکون
                                const iconRect = this.getBoundingClientRect();

                                // نمایش دادن دایو menu-submenu مربوطه
                                submenu.style.display = 'block';

                                // محاسبه و تنظیم موقعیت دایو app-float-submenu
                                floatSubmenu.style.top = `${iconRect.bottom}px`;
                                floatSubmenu.style.left = `${iconRect.left}px`;

                                // **ایجاد div جدید برای نمایش مقادیر menu-text**
                                const menuTextDiv = document.createElement('div');
                                menuTextDiv.classList.add('menu-text-container'); // اضافه کردن کلاس برای استایل دهی
                                menuTextDiv.style.fontWeight = 'bold';
                                menuTextDiv.style.marginRight = '11px';

                                // **استخراج متن menu-text و اضافه کردن آن به div جدید**
                                const menuText = this.querySelector('.menu-text').textContent;
                                menuTextDiv.textContent = menuText;

                                const hr = document.createElement('hr');
                                hr.style.marginTop = '6px'; // تنظیم حاشیه
                                hr.style.marginBottom = '2px'; // تنظیم فاصله گذاری
                                // **اضافه کردن div menu-text به div app-float-submenu**
                                floatSubmenu.innerHTML = '';
                                floatSubmenu.appendChild(menuTextDiv); // اضافه کردن div menu-text در ابتدا
                                floatSubmenu.appendChild(hr); // اضافه کردن div menu-text در ابتدا

                                floatSubmenu.appendChild(submenu.cloneNode(true)); // اضافه کردن menu-submenu

                                // نمایش دادن دایو app-float-submenu
                                floatSubmenu.style.display = 'block';
                            }
                        }
                    });

                    // اضافه کردن رویداد موس خروج
                    link.addEventListener('click', function () {
                        if (this.querySelector('.menu-iconSidebar')) {
                            // یافتن دایو menu-submenu مربوطه
                            const submenu = this.nextElementSibling;

                            // اگر دایو menu-submenu مربوطه وجود داشته باشد
                            if (submenu) {
                                // محاسبه موقعیت مطلق بر اساس موقعیت آیکون
                                const iconRect = this.getBoundingClientRect();

                                // نمایش دادن دایو menu-submenu مربوطه
                                submenu.style.display = 'none';
                            }
                        }
                        // مخفی کردن دایو app-float-submenu فقط اگر موس از آن خارج شود
                        floatSubmenu.addEventListener('mouseleave', function () {
                            floatSubmenu.style.display = 'none';
                        });
                    });

                });

            }
            const observer = new MutationObserver(function (mutations) {
                mutations.forEach(function (mutation) {
                    // بررسی تغییرات در کلاسهای المان #app
                    if (mutation.attributeName === 'class') {
                        const appElement = document.getElementById('app');
                        const floatSubmenu = document.getElementById('app-float-submenu'); // تعریف floatSubmenu در اینجا
                        floatSubmenu.style.display = 'none';
                        // اگر کلاس app-sidebar-collapsed فعال باشد
                        if (appElement.classList.contains('app-sidebar-collapsed')) {
                            // اجرای کد مربوط به کلاس app-sidebar-collapsed
                            console.log("Collapsed mode active");

                        } else {
                            // اجرای کد مربوط به سایر حالات
                            console.log("Collapsed mode inactive");
                            floatSubmenu.style.display = 'none';
                        }
                    }
                });
            });

            observer.observe(document.getElementById('app'), { attributes: true, attributeFilter: ['class'] });



        </script>
