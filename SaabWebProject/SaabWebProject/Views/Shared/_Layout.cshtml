        <script>

            document.addEventListener("DOMContentLoaded", function () {
                // دریافت عنوان صفحه
                let pageTitle = document.querySelector(".page-header.mb-0");
                if (!pageTitle) return;

                let titleText = pageTitle.innerText.trim(); // گرفتن متن عنوان صفحه

                // پیدا کردن تمام لینک‌های منو
                let menuLinks = document.querySelectorAll(".menu-link");

                menuLinks.forEach(link => {
                    let spanText = link.querySelector(".menu-text");
                    if (spanText && spanText.innerText.trim() === titleText) {
                        link.classList.add("choic"); // اضافه کردن کلاس به آیتم اصلی منو

                        // پیدا کردن منوی والد (اگر داخل یک زیرمنو باشد)
                        let parentMenu = link.closest(".menu-item.has-sub");
                        if (parentMenu) {
                            let mainLink = parentMenu.querySelector(".menu-link");
                            if (mainLink) {
                                mainLink.classList.add("choic"); // اضافه کردن کلاس به منوی والد
                            }
                        }
                    }
                });
            });
        </script>
