                function updateTime(){
                    //+++++++++++++++++++++++++++++++++++++++++++++
                    var options1 = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
                    var DateCheck = new Date().toLocaleTimeString('fa-IR-u-nu-latn', options1)
                    var DateMon = DateCheck.slice(05, 07)
                    var DateDay = DateCheck.slice(08, 10)
                    var DateHor = DateCheck.slice(12, 14)
                    var DateMin = DateCheck.slice(15, 17)
                    var DateSec = DateCheck.slice(18, 20)
                    if (DateMon == '01' && DateDay == '05' && DateHor == '09' && DateMin == '30' && DateSec == '01') {
                        Swal.fire({
                            title: 'آیا مطمئن هستید؟',
                            text: "کلیه بنر ها با تغییر سال غیرفعال می شود",
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'بله',
                            cancelButtonText: 'خیر'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                $.ajax({
                                    type: 'POST',
                                    url: '@Url.Action("DeactivateBannersForNewYear", "Dashboard")',
                                    success: function (res) {
                                        document.getElementById("loading-message").style.display = "none";
                                        if (res === "False") {
