        <script>
$(function () {
    let isModalOpen = false; // فلگ برای بررسی باز بودن مدال

    function fetchSuggestionCount() {
        // اگر مدال باز باشه، اجرا نشه
        if (isModalOpen) return;

        $.ajax({
            beforeSend: function () {
                document.getElementById("loading-message").style.display = "block";
            },
            url: '@Url.Action("Hoshdarattention", "Orders", new { area = "Setting" })',
            type: "post",
            success: function (result) {
                document.getElementById("loading-message").style.display = "none";

                if (result.success) {
                    let timer = parseInt(result.timetamarkoz);
                    isModalOpen = true; // مدال باز شد

                    Swal.fire({
                        title: result.name,
                        html: `
                            <div style="margin-top:10px">${result.description}</div>
                            <div id="countdown-timer" style="margin-top:15px; font-weight:bold; font-size:20px;">${timer}</div>
                            <button id="confirmBtn" class="swal2-confirm swal2-styled" style="margin-top:20px;" disabled>
                                مطالعه نمودم و متشکرم
                            </button>`,
                        showConfirmButton: false,
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        allowEnterKey: false,
                        background: 'rgb(29,40,52)',
                        color: 'white',
                        didOpen: () => {
                            const timerEl = document.getElementById('countdown-timer');
                            const btn = document.getElementById('confirmBtn');

                            const interval = setInterval(() => {
                                timer--;
                                if (timer <= 0) {
                                    clearInterval(interval);
                                    btn.disabled = false;
                                    timerEl.textContent = "00";
                                } else {
                                    timerEl.textContent = timer;
                                }
                            }, 1000);

                            btn.addEventListener('click', () => {
                                if (!btn.disabled) {
                                    Swal.close();
                                    isModalOpen = false; // وقتی کاربر دکمه رو زد، فلگ رو false کن
                                }
                            });
                        }
                    });
                }
            },
            error: function () {
                document.getElementById("loading-message").style.display = "none";
                console.log("خطا در دریافت هشدار");
            }
        });
    }

    fetchSuggestionCount(); // اجرای اولیه
    setInterval(fetchSuggestionCount, 6000000); // اجرای دوره‌ای فقط زمانی که مدال باز نیست
});
        </script>



