        <script>

$(function () {
    $.ajax({
        beforeSend: function () {
            document.getElementById("loading-message").style.display = "block";
        },
        url: '@Url.Action("countarzyabi", "Orders", new { area = "Setting" })',
        type: "post",
        success: function (result) {
            document.getElementById("loading-message").style.display = "none";

            let count = parseInt(result.count);
            let evaluation = parseInt(result.evaluation);
            let poll = parseInt(result.poll);

            let $icon = $("#icon_arzyabi");
            let $notify = $("#notify_suggestion");
            let $text = $("#notify_text");
            let $alarm = $("#btnalarm");

            // تنظیم رنگ آیکون
            if (count === 1) {
                $icon.css({
                    "color": "#2faa92",
                    "text-shadow": "0 0 10px #2faa92",

                }),
                    $notify.css({
                        "background-color": "#2faa92"
                    });

            } else if (count === 2) {
                $icon.css({
                    "color": "#ffa500",
                    "text-shadow": "0 0 10px #ffa500"
                }),
                $notify.css({
                    "background-color": "#ffa500"
                }),
                    $alarm.css("animation", "alarm 1s infinite");

            } else if (count ===3) {
                $icon.css({
                    "color": "#ff0000",
                    "text-shadow": "0 0 12px #ff0000"
                }),
                    $notify.css({
                        "background-color": "#ff0000"
                    }),
                    $alarm.css("animation", "alarm 1s infinite");

            } else {
                $icon.css("color", "#ffffff");
            }

            // اگر تعداد ارزیابی یا نظرسنجی بیشتر از صفر بود، نوتیفیکیشن رو نشون بده
            if ((evaluation > 0 || poll > 0 )&& count!=1 ) {
                $text.text(`ارزیابی: ${evaluation} | نظرسنجی: ${poll}`);
                $notify.fadeIn();
            } else {
                $text.text(`ارزیابی: ${evaluation} | نظرسنجی: ${poll}`);

                console.log(count);
                $notify.hide();
            }
        },
        error: function (result) {
            document.getElementById("loading-message").style.display = "none";
            console.log("خطا در دریافت اطلاعات ارزیابی");
        }
    });
});




