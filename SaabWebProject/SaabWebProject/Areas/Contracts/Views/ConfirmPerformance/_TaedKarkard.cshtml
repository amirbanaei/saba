
@{

    Layout = null;
}
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<link href="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.style.css" rel="stylesheet" />
<style>
    .days > tr > td {
        color: white !important;
    }

    .mds-bootstrap-persian-datetime-picker-popover {
        background: #1d2834;
        font-family: var(--bs-body-font-family);
    }

    .select-year-box {
        background-color: #1d2834 !important;
    }

    .popover-header {
        background-color: #1d2834 !important;
        color: white !important;
    }
</style>

<h5>تایید کارکرد</h5>
<div class="row">
    <div class="col-xl-3">

        <div class="form-group mb-3">
            <label class="form-label"> پیمان</label>
            <input class="form-control" />

        </div>

    </div>
    <div class="col-xl-3">

        <div class="form-group mb-3">
            <label class="form-label"> بسته</label>
            <input class="form-control" />

        </div>

    </div>
    <div class="col-xl-3">
        <div class=" form-group mb-12">
            <div class="col-xl-12">
                <label class="form-label"> از تاریخ</label>

            </div>

            <div class="col-xl-12" style="margin-top:8px">
                <input class="form-control" id="datepickerFrom_Eq" />
                <input class="form-control" type="hidden" id="datepickerFromEn_Eq" />
            </div>
        </div>
    </div>
    <div class="col-xl-3">
        <div class=" form-group mb-12">
            <div class="col-xl-12">
                <label class="form-label"> تا تاریخ</label>

            </div>

            <div class="col-xl-12" style="margin-top:8px">
                <input class="form-control" id="datepickerFrom_Eq1" />
                <input class="form-control" type="hidden" id="datepickerFromEn_Eq1" />
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-3">

            <div class="form-group mb-3">
                <label class="form-label"> تایید کننده</label>
                <input class="form-control" />

            </div>

        </div>
        <div class="col-xl-3">

            <div class="form-group mb-3">
                <label class="form-label"> مقدار قبلی</label>
                <select class="form-control">
                    <option>انتخاب کنید</option>
                </select>

            </div>

        </div>
        <div class="col-xl-3" style="margin-top:30px">
            <div class="form-group mb-3">
                <button class="btn form-control buttonGeneral">
                    <i class="bi bi-download fa-fw me-1 VecGeneral"></i>
                    <span class="bGeneral-text">دانلود فایل نمونه</span>
                </button>
            </div>
        </div>
        <div class="col-xl-3" style="margin-top:30px">
            <div class="form-group mb-3">

                <button class="btn form-control buttonGeneral">
                    <i class="bi bi-upload fa-fw me-1 VecGeneral"></i>
                    <span class="bGeneral-text">بارگذاری اطلاعات</span>
                </button>
            </div>
        </div>


    </div>
    <div class="row">
        <div class="table-responsive">
            <table class="table table-hover text-nowrap">
                <thead>
                    <tr style="text-align:center;margin:auto">
                        <th>
                            @Html.DisplayName("ردیف")
                        </th>
                        <th style="width:40%">
                            @Html.DisplayName("نام کاربر")
                        </th>
                        <th>
                            @Html.DisplayName("مولفه")
                        </th>
                        <th>
                            @Html.DisplayName("مقدار قبلی")
                        </th>
                        <th>
                            @Html.DisplayName("مقدار تاییدی")
                        </th>
                        <th>
                            @Html.DisplayName("تغییر")
                        </th>
                        <th style="width:30%">
                            @Html.DisplayName("شرح علت تغییر")
                        </th>
                        <th>
                            @Html.DisplayName("جزئیات")
                        </th>


                    </tr>

                </thead>
                <tbody>


                    <tr style="text-align:center;">


                        <td> <span>1</span></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td>
                            <i style="color: red !important" class="bi bi-file-arrow-down text-theme"></i>

                        </td>
                        <td></td>

                        <td>
                            <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                    <i class="fa fa-edit"></i>
                                </a>
                                <div class="dropdown-menu">
                                    <a style="cursor:pointer" class="dropdown-item EditUser" data-bs-toggle="modal" data-bs-target="#modalLgDetail" id="ShowDetail">
                                        مشاهده
                                    </a>
                                </div>

                            </div>
                        </td>

                    </tr>
                    <tr style="text-align:center;">


                        <td> <span>2</span></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td>
                            <i style="color: green !important" class="bi bi-file-arrow-up text-theme"></i>

                        </td>
                        <td></td>

                        <td>
                            <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                    <i class="fa fa-edit"></i>
                                </a>
                                <div class="dropdown-menu">
                                    <a style="cursor:pointer" class="dropdown-item EditUser" data-bs-toggle="modal" data-bs-target="#modalLgDetail" id="ShowDetail">
                                        مشاهده
                                    </a>
                                </div>

                            </div>
                        </td>

                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-9">

        </div>

        <div class="col-xl-3">
            <div class="form-group mb-3">
                <button class="btn btn-success form-control buttonsabt">
                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                    <span class="bSabt-text">تایید و ثبت</span>
                </button>
            </div>
        </div>
    </div>

</div>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>
<script>
    $(function () {


        $('#year_Eq').picker({ search: true });
        $('#month_Eq').picker({ search: true });

        $('#datepickerFrom_Eq').MdPersianDateTimePicker({
            targetTextSelector: '#datepickerFrom_Eq',
            targetDateSelector: '#datepickerFromEn_Eq',
            dateFormat: 'yyyy-MM-dd',
            isGregorian: false,
            enableTimePicker: true,
            disableBeforeToday: false
        });

        $('#datepickerTo_Eq').MdPersianDateTimePicker({
            targetTextSelector: '#datepickerTo_Eq',
            targetDateSelector: '#datepickerToEn_Eq',
            dateFormat: 'yyyy-MM-dd',
            isGregorian: false,
            enableTimePicker: true,
            disableBeforeToday: false
        });


        //1
        $('#datepickerFrom_Eq1').MdPersianDateTimePicker({
            targetTextSelector: '#datepickerFrom_Eq1',
            targetDateSelector: '#datepickerFromEn_Eq1',
            dateFormat: 'yyyy-MM-dd',
            isGregorian: false,
            enableTimePicker: true,
            disableBeforeToday: false
        });

        $('#datepickerTo_Eq1').MdPersianDateTimePicker({
            targetTextSelector: '#datepickerTo_Eq1',
            targetDateSelector: '#datepickerToEn_Eq1',
            dateFormat: 'yyyy-MM-dd',
            isGregorian: false,
            enableTimePicker: true,
            disableBeforeToday: false
        });
    });
</script>

<script>

   $("#ShowDetail").click(function () {


       $("#DetailModal").load('@Url.Content("../../Contracts/ConfirmPerformance/_TaedKarkardDetail")');

    });
</script>
