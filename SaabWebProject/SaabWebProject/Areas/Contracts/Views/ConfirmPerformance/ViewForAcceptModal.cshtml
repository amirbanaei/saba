@model SaabWebProject.Models.ViewModels.ConfirmPerformance.viewModel

@{
    Layout = null;
}

<table class="table table-hover text-nowrap">
    <tr>
        <th>نام  </th>
        <th>نفش  </th>
        <th>مقدار</th>
    </tr>
    @for (var i = 0; i < Model.name.Count; i++)
    {
        <tr>
            <td>@Model.name[i]</td>
            <td>@Model.Family[i]</td>
            <td>@Model.Value[i]</td>
        </tr>
    }
</table>


