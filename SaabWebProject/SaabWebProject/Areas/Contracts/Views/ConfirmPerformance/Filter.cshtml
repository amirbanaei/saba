<h6>جستجو براساس </h6>
<div class="row">@*جستجو براساس مولفه و کاربر*@ </div>
<div class="row">

    <div class="col-xl-4">
        <div class="row">
            <div class="col-xl-5">
                <label class="form-label"> کاربر ها  </label>
                
                <select class="form-select " id="usss">
                    <option value="0">انتخاب نمایید..</option>
                    @*@{ int? previousFK_Baste = null;
                            int? previousFK_pec_ID = null;
                            int? previousFK_svdfunc_ID = null;

                        }*@
                    @foreach (var item in db.Link_User_And_Peyman.Where(p => p.FK_Peyman_ID == Model.fkpy && p.Status == true).ToList())
                    {

                        <option value="@item.FK_User_ID" )">@item.tbUsers.FullName</option>


                    }

                </select>
            </div>
            <div class="col-xl-5">
                <div class="row">
                    <div class="col-xl-12">
                        <label class="form-label"> مولفه ها  </label>
                        
                        <select class="form-select " id="mooalf">
                            <option value="0">انتخاب نمایید..</option>
                            @*@{ int? previousFK_Baste = null;
                                    int? previousFK_pec_ID = null;
                                    int? previousFK_svdfunc_ID = null;

                                }*@
                            @foreach (var item in db.tbReffrenceSaveLevelMoalefe.Where(p => p.FK_LevelID == Model.fkBasteh && p.Deleted2!=true).ToList())
                            {

                                <option value="@item.FK_MoalefeID" )">@item.tbContractMoalefeDastmozdi.md_Title</option>


                            }

                        </select>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 " style="font-size:14px">
                <a data-bs-toggle="modal" data-bs-target="#modalLg" href="#" class=" btn form-control buttonGeneralPlus responsive"  id="detailnew1">
                    <i class="fa fa-eye fa-fw me-1 VecGeneral"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-xl-4 ">
        <div class="row">
            <div class="col-xl-10">
