            </div>
            <div class="col-xl-2 " style="font-size:14px">
                <a data-bs-toggle="modal" data-bs-target="#modalLg1" href="#" class=" btn form-control buttonGeneralPlus responsive  " id="detailnew2">
                    <i class="fa fa-eye fa-fw me-1 VecGeneral"></i>
