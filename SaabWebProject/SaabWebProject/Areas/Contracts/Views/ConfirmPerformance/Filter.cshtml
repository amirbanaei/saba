<script>
    $("#detailnew1").click(function () {
        var selectedValue = $("#baste_peyman_ACCEpt2").val();

        if (selectedValue) {
            var parts = selectedValue.split('_');

            if (parts.length >= 2) {
                var svdfunc_ID = parts[0];
                var svdfunc_pymnID = parts[1];
                var svdfunc_BastehID = parts[2];
            }
        }
        if (svdfunc_pymnID == undefined || svdfunc_pymnID==0 ) {
            alert("پیمان مورد نظر را انتخاب نمایید")
        }
        else if ($("#year_pY").val() == 0) {
            alert("سال مورد نظر را انتخاب نمایید")

        } else if ($("#month_pY").val() == 0) {
            console.log($("#month_pY").val())
            alert("ماه مورد نظر را انتخاب نمایید")

        } else {

                    var year_pY = $("#year_pY").val();
            var month_pY = $("#month_pY").val();
                                                $.ajax({
 beforeSend: function () {
     document.getElementById("loading-message").style.display = "block";

             console.log($("#basteOfPeyman1").val());

         },

                                                    url: '@Url.Action("cHEAK", "ConfirmPerformance", new { area = "Contracts" })?MoalfeVal_Year=' + year_pY + '&MoalfeVal_Month=' + month_pY + '&Basteh=' + svdfunc_BastehID + '&baste_peyman1=' + svdfunc_pymnID,
 type: 'GET',
 dataType: 'html',


 success: function (res) {
     document.getElementById("loading-message").style.display = "none";


     if (res == "true") {
         console.log(res);

         $("#big_modal_body").load('@Url.Action("Viewonmoalanus", "ConfirmPerformance", new { area = "Contracts" })?Basteh=' + svdfunc_BastehID + '&Py=' + svdfunc_pymnID + '&Year=' + year_pY + '&Month=' + month_pY + '&fkusr=' + $('#usss').val() + '&fkmoalfe=' + $('#mooalf').val());

     } else if (res == "False2") {
         alert("برای این بسته در این ماه و سال ثبت نشده است   ");
         location.reload();

     }

},
error: function (res) {
    console.log(res);
}
     });

        }
        }
        );



</script>
