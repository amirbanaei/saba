<script>
        $(".Delete22566").click(function () {
        console.log("sda;");
        var idd = $(this).attr("id").split("_")[1];
        console.log(idd);

        Swal.fire({
            title: 'آیا از حذف مطمئن هستید؟',
            icon: 'question',
            showCancelButton: true,
            background: 'rgb(29,40,52)',
            color: 'white',
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'بله ',
            cancelButtonText: 'خیر'
        }).then((result) => {
            if (result.isConfirmed == true) {
                $(".loader").css('display', 'block');

                $.ajax({
                    url: '@Url.Action("DELETESORAT", "Moalefe", new { area = "Salaries" })',
                    data: { ID: idd },
                    type: "Post",
                    dataType: "html",
                    success: function (resp) {
                        $("#loading-message").css("display", "none");
                        if (resp == "True") {
                            toastInstance.fire({
                                icon: 'success',
                                background: '#35434A',
                                color: 'white',
                                title: "بسته با موفقیت حدف شد"
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            toastInstance.fire({
                                icon: 'success',
                                background: '#35434A',
                                color: 'white',
                                title: "نمیتوانید این بسته را حذف کنید"
                            });
                        }
                    },
                    error: function (resp2) {
                        $("#loading-message").css("display", "none");
                        toastInstance.fire({
                            icon: 'error',
                            background: '#35434A',
                            color: 'white',
                            title: "حذف بسته با خطا مواجه شده است، از این بسته در قسمتی استفاده شده است"
                        }).then(() => {
                            location.reload();
                        });
                    }
                });
            }
        });
    });

    // تغییر نام متغیر Toast به toastInstance
    var toastInstance = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
</script>