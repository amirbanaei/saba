<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />


@section Scripts
{
    <script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
    <script>

    $(function () {


      

        ///DateTime Picker From
        $('#datepickerFrom_pr').MdPersianDateTimePicker({
            targetTextSelector: '#datepickerFrom_pr',
            targetDateSelector: '#datepickerFromEn_pr',
            dateFormat: 'yyyy-MM-dd',
            isGregorian: false,
            enableTimePicker: true,
            disableBeforeToday: false
        });

        ///DateTime Picker To
        $('#datepickerTo_pr').MdPersianDateTimePicker({
            targetTextSelector: '#datepickerTo_pr',
            targetDateSelector: '#datepickerToEn_pr',
            dateFormat: 'yyyy-MM-dd',
            isGregorian: false,
            enableTimePicker: true,
            disableBeforeToday: false
        });
    });

     $("#pymn" ).load('@Url.Content("/../Contracts/Peyman/_GetAllListPeymans_Select")',function(){
         $("#select_peyman").attr("id", "select_peyman1");


    });
    </script>
}