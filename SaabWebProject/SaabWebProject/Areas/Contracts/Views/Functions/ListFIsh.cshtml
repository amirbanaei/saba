    SaabEntities db = new SaabEntities();
}
@model IEnumerable<SaabWebProject.Models.DomainModels.tbmoalfefishexcel>
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
<style>

    .tableH_Lock {
        max-height: 449px;
        /*height: 260px;*/
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0px !important;
    }

    thead th {
        vertical-align: middle;
    }
</style>
<div class="card">
    <div class="table-content p-2" id="TaedKarkardKarbaran">
        <div class="row">
            <div class="col-xl-12">
                <div class="form-group mb-12">
                    <div class="table-responsive tableH_Lock">
                        <table class="table table-hover text-nowrap">
                            <thead>
                                <tr style="text-align:center;margin:auto">
                                    <th>
                                        @Html.DisplayName("عملیات")
                                    </th>
                                    <th>
                                        @Html.DisplayName("ردیف")
                                    </th>
                                    <th>
                                        @Html.DisplayName("پیمان")
                                    </th>
                                    <th>
                                        @Html.DisplayName("بسته")
                                    </th>
                                    <th>
                                        @Html.DisplayName("ماه")
                                    </th>
                                    <th>
                                        @Html.DisplayName("سال")
                                    </th>
                                    <th>
                                        @Html.DisplayName("پیوست")
                                    </th>


                                </tr>

                            </thead>
                            <tbody>
                                @{ int cont = 0;
                                    int month = 0;
                                    int year = 0;
                                    int fkPymn =0;
                                    int fkBasteh = 0;
                                    }
                                @foreach (var item in Model)
                                {
                                    //var fit = item.tbEquipmentMoalefeValue.FirstOrDefault();
                                    //var month = fit.Month;
                                    //var yr = fit.Year;
                                    var firstMoalefeVal = item.tbMoalefeValueFish.FirstOrDefault();
                                    if (firstMoalefeVal != null)
                                    {
                                        month = (int)firstMoalefeVal.mlfvlfsh_Month;
                                        year = (int)firstMoalefeVal.mlfvlfsh_Year;
                                        fkPymn = (int)item.Fk_Pymn;
                                        fkBasteh = (int)item.Fk_Basteh;
                                    }
                                    var ex = db.tbmoalfefishexcel
                                               .Where(p => p.tbMoalefeValueFish.Any(s => s.Finalaccept == true && s.mlfvlfsh_Month == month && s.mlfvlfsh_Year == year) && p.Fk_Pymn == fkPymn && p.Fk_Basteh == fkBasteh)
                                               .FirstOrDefault();

                                    cont++;



<tr style="text-align:center;">
                                        <td>
                                            <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">

                                                <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <div class="dropdown-menu">
                                                    @if (ex == null)
                                                    {
                                                        <a class="dropdown-item editapload" id="uploadSummery_@item.ID">
                                                            <span>ویرایش</span>
                                                        </a>
                                                        <a class="dropdown-item Delete2243" id="Delete_@item.ID">حذف</a>

                                                    }

                                                </div>
                                            </div>
                                            <input id="editfil" style="display:none" type="file" class="form-control" value="" />
                                        </td>


                                        <td>@cont</td>
                                        <td>@item.tbPeymanContracts.pec_Title</td>
                                        <td>@item.tbReffrenceSaveLevel.Title</td>
                                        <td>
                                            @{
                                                var monthNumber = item.tbMoalefeValueFish.Select(s => s.mlfvlfsh_Month).FirstOrDefault();
                                                string monthName;

                                                switch (monthNumber)
                                                {
                                                    case 1:
                                                        monthName = "فروردین";
                                                        break;
                                                    case 2:
                                                        monthName = "اردیبهشت";
                                                        break;
                                                    case 3:
                                                        monthName = "خرداد";
                                                        break;
                                                    case 4:
                                                        monthName = "تیر";
                                                        break;
                                                    case 5:
                                                        monthName = "مرداد";
                                                        break;
                                                    case 6:
                                                        monthName = "شهریور";
                                                        break;
                                                    case 7:
                                                        monthName = "مهر";
                                                        break;
                                                    case 8:
                                                        monthName = "آبان";
                                                        break;
                                                    case 9:
                                                        monthName = "آذر";
                                                        break;
                                                    case 10:
                                                        monthName = "دی";
                                                        break;
                                                    case 11:
                                                        monthName = "بهمن";
                                                        break;
                                                    case 12:
                                                        monthName = "اسفند";
                                                        break;
                                                    default:
                                                        monthName = "نامشخص";
                                                        break;
                                                }
                                            }
                                            @monthName
                                        </td>



                                        <td>@item.tbMoalefeValueFish.Select(s=>s.mlfvlfsh_Year).FirstOrDefault()</td>
                                        @if (item.Filsesystem != null)
                                        {
                                            <td>
                                                <a href="~/Areas/Salaries/Content/UserFunctionsFile/@item.Filsesystem">
                                                    <i class="bi bi-download DownloadExcelFunction" style="cursor:pointer"></i>
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                پیوستی ثبت نشده
                                            </td>
                                        }









                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
