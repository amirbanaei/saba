<script>
    var fd = new FormData();

    function sendAjaxFile(url2, fd2) {
        //alert("hjdsvfhjfdsv2");

        $("#loading-message").css("display", "block");
        fd2.append("svdfunc_BastehID", svdfunc_BastehID);
        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                $("#loading-message").css("display", "none");

                if (resp1 == "True") {
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "اطلاعات با موفقیت آپدیت شد"
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });


                }

            },
            error: function (resp1) {
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });



    }
</script>
<script>
    $(".Delete").click(function () {
        console.log("sda;");
        var idd = $(this).attr("id").split("_")[1];
        console.log(idd);

        Swal.fire({
            title: 'آیا از حذف مطمئن هستید؟',
            icon: 'question',
            showCancelButton: true,
            background: 'rgb(29,40,52)',
            color: 'white',
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'بله ',
            cancelButtonText: 'خیر'
        }).then((result) => {
            if (result.isConfirmed == true) {
                $(".loader").css('display', 'block');

                $.ajax({
                    url: '@Url.Action("deletebast", "Functions", new { area = "Contracts" })',
                    data: { ID: idd },
                    type: "Post",
                    dataType: "html",
                    success: function (resp) {
                        $("#loading-message").css("display", "none");
                        if (resp == "True") {
                            toastInstance.fire({
                                icon: 'success',
                                background: '#35434A',
                                color: 'white',
                                title: "بسته با موفقیت حدف شد"
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            toastInstance.fire({
                                icon: 'success',
                                background: '#35434A',
                                color: 'white',
                                title: "نمیتوانید این بسته را حذف کنید"
                            });
                        }
                    },
                    error: function (resp2) {
                        $("#loading-message").css("display", "none");
                        toastInstance.fire({
                            icon: 'error',
                            background: '#35434A',
                            color: 'white',
                            title: "حذف بسته با خطا مواجه شده است، از این بسته در قسمتی استفاده شده است"
                        }).then(() => {
                            location.reload();
                        });
                    }
                });
            }
        });
    });

    // تغییر نام متغیر Toast به toastInstance
    var toastInstance = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
</script>