<script>
    var fd = new FormData();

    $(".uploadSummery").click(function () {
        $("#summery_file").click();
    });

    $("#summery_file").change(function (e) {
        $.each(e.target.files, function (index, file) {
            fd.append("files", file);
            sendAjax2('@Url.Action("sabtpavast", "Moalefe", new { area = "Salaries" })', fd);
        });
    });
    $(".AmountInput").on("keyup", function (event) {

        // کاربر متنی انتخابی انتخاب میکند
        var selection = window.getSelection().toString();
        if (selection !== '') {
            return;
        }

        // زمانی که جهت ها کلیک میشوند
        if ($.inArray(event.keyCode, [38, 40, 37, 39]) !== -1) {
            return;
        }

        var $this = $(this);

        // گرفتن مقدار
        var input = $this.val();

        var input = input.replace(/[\D\s\._\-]+/g, "");
        input = input ? parseInt(input, 10) : 0;

        $this.val(function () {
            return (input === 0) ? "" : input.toLocaleString("en-US");
        });
    });

    function sendAjax2(url2, fd2) {


        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                console.log("okeye");
                console.log(resp1);
                $("#loading-message").css("display", "none");
                fd = new FormData();
                if (resp1 == "True") {
                    alert("با موفقیت ثبت شد");
                    location.reload();
                }
                else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });
                }

            },
            error: function (resp1) {
                console.log(resp1);
                console.log("Nokeye");
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });
    }
</script>

