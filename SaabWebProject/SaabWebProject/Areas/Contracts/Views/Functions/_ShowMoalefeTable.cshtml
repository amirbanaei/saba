@model IEnumerable<SaabWebProject.Models.DomainModels.tbMoalefeDastmozdiValueFromExcel>

@{
    Layout = null;
}
@if (Model != null)
{
    <div class="card">

        <div class="tab-content p-4">
            <div class="tab-pane fade show active" id="allTab">
                <div class="table-responsive">
                    <table class="table table-hover text-nowrap">
                        <thead>
                            <tr style="text-align:center">

                                <th>
                                    @Html.DisplayName("#")
                                </th>
                                <th>
                                    @Html.DisplayName("عنوان")
                                </th>

                                <th>
                                    @Html.DisplayName("کاربر")
                                </th>
                                <th>
                                    @Html.DisplayName("سال")
                                </th>
                                <th>
                                    @Html.DisplayName("ماه")
                                </th>

                                <th>
                                    @Html.DisplayName("مقدار")
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int counter = 0;}
                            @foreach (var item in Model)
                            {
                                <tr style="text-align:center;">


                                    <td>
                                        @{counter = counter + 1;}

                                        <span>@counter</span>
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.tbContractMoalefeDastmozdi.md_Title)
                                    </td>
                                    <td>
                                        @item.tbUsers.FullName
                                    </td>
                                    <td>
                                        @item.MoalfeVal_Year

                                    </td>

                                    <td>
                                        @switch (item.MoalfeVal_Month)
                                        {
                                            case 1:
                                                <span>فروردین</span>
                                                break;
                                            case 2:
                                                <span>اردیبهشت</span>
                                                break;
                                            case 3:
                                                <span>خرداد</span>
                                                break;
                                            case 4:
                                                <span>تیر</span>
                                                break;
                                            case 5:
                                                <span>مرداد</span>
                                                break;
                                            case 6:
                                                <span>شهریور</span>
                                                break;
                                            case 7:
                                                <span>مهر</span>
                                                break;
                                            case 8:
                                                <span>آبان</span>
                                                break;
                                            case 9:
                                                <span>آذر</span>
                                                break;
                                            case 10:
                                                <span>دی</span>
                                                break;
                                            case 11:
                                                <span>بهمن</span>
                                                break;
                                            case 12:
                                                <span>اسفند</span>
                                                break;
                                        }

                                    </td>
                                    <td>
                                        @item.MoalfeVal_Value
                                    </td>


                                </tr>
                            }


                        </tbody>
                    </table>
                </div>

                @*<div class="d-md-flex align-items-center">
                        <div class="me-md-auto text-md-left text-center mb-2 mb-md-0">
                            نمایش 1 تا 10 از 57 داده
                        </div>
                        <ul class="pagination mb-0 justify-content-center">
                            <li class="page-item disabled"><a class="page-link">قبلی</a></li>
                            <li class="page-item"><a class="page-link" href="#">1</a></li>
                            <li class="page-item active"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item"><a class="page-link" href="#">4</a></li>
                            <li class="page-item"><a class="page-link" href="#">5</a></li>
                            <li class="page-item"><a class="page-link" href="#">6</a></li>
                            <li class="page-item"><a class="page-link" href="#">بعدی</a></li>
                        </ul>
                    </div>*@
            </div>
        </div>
        <div class="card-arrow">
            <div class="card-arrow-top-left"></div>
            <div class="card-arrow-top-right"></div>
            <div class="card-arrow-bottom-left"></div>
            <div class="card-arrow-bottom-right"></div>
        </div>
    </div>
}

