<script>

    var fd = new FormData();

    //بارگذاری فایل مدرک
    $(".UploadAttachment").click(function () {
        $("#inp_file").click();
    });
</script>

<script>
       $("#inp_file").change(function (e) {
                   $.each(e.target.files, function (index, file) {
                      fd.append("files", file);
                   });
                   sendAjax1('@Url.Action("UploadAcceptFile", "Functions", new { area = "Contracts" })', fd);
      });
</script>
<script>

    function sendAjax1(url2, fd2) {
        $("#loading-message").css("display", "block");
        fd2.append("SaveFunction_ID", @Model.svdfunc_ID);

        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                $("#loading-message").css("display", "none");
                fd = new FormData();
                if (resp1 == "True") {
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "اطلاعات با موفقیت ثبت شد"
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });


                }

            },
            error: function (resp1) {
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });
    }
</script>
