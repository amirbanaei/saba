@{ Layout = null;}
@model  SaabWebProject.Models.DomainModels.tbSavedFunctions

<div class="row">
    <div class="col-xl-12">
        <div class="form-group mb-12">
            <div class="table-responsive">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center;margin:auto">

                            <th>
                                @Html.DisplayName("ردیف")
                            </th>
                            <th>
                                @Html.DisplayName("نوع فعالیت")
                            </th>
                            <th>
                                @Html.DisplayName("پیمان")
                            </th>
                            <th>
                                @Html.DisplayName("بسته")
                            </th>
                            <th>
                                @Html.DisplayName("تاریخ ذخیره")
                            </th>
                            <th>
                                @Html.DisplayName(" کاربر")
                            </th>
                            <th>
                                @Html.DisplayName(" دانلود")
                            </th>
                             <th>
     @Html.DisplayName(" دانلود پیوست")
 </th>

                      
                    </thead>
                    <tbody>
                        @{ int counter = 1;}
                        @if (Model != null)
                        {
                            <tr style="text-align:center;">
                                <td>1</td>
                                <td>ثبت</td>
                                <td id="py">@Model.tbPeymanContracts.pec_Title</td>
                                <td id="baste">@Model.tbReffrenceSaveLevel.Title</td>
                                <td>@Model.svdfunc_SavedDateTime</td>
                                <td id="user">@Model.tbUsers.FullName</td>
                                <td style="display:none" id="usr2">@Model.tbUsers.usr_ID</td>
                                <td style="display:none" id="id">@Model.svdfunc_ID</td>
                                <td id="click">
                                    <a href="#" class=" btn form-control buttonGeneral" style="font-size:10px;margin-bottom:10px;" id="dwn">
                                        <i class="bi bi-download fa-fw me-1 VecGeneral"></i>
                                        <span class="bGeneral-text">دانلود فایل نمونه</span>
                                    </a>

                                </td>
                                @if (Model.svdfunc_FileName != null)
                                {
                                <td>
                                    <a href="~/Areas/Salaries/Content/UserFunctionsFile/@Model.svdfunc_FileSystemName">
                                        <i class="bi bi-download DownloadExcelFunction" style="cursor:pointer"></i>
                                    </a>
                                </td>}
                                else { 
                                <td>
                                    پیوستی ثبت نشده 
                                </td>
                                }

                            </tr>

                            foreach (var item in Model.tbFucntionExcel)
                            {
                                counter = counter + 1;
                                <tr style="text-align:center;">
                                    <td>1</td>
                                    <td>تایید</td>
                                    <td>@item.tbSavedFunctions.tbPeymanContracts.pec_Title</td>
                                    <td>@item.tbSavedFunctions.tbReffrenceSaveLevel.Title</td>
                                    <td>@item.Funcexcl_DateTime</td>
                                    <td>@item.tbUsers.FullName</td>

                                    <td>
                                        <a href="~/Areas/Salaries/Content/UserFunctionsFile/@item.Funcexcl_ExcelName">
                                            <i class="bi bi-download DownloadExcelFunction" style="cursor:pointer"></i>
                                        </a>

                                    </td>
                                </tr>



                            }

                        }




                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
@if (Model.OnlineUserUploadedFile == false)
{

    <div class="row">
        <div class="col-xl-3">
            <a class="dropdown-item UploadAttachment" style="text-align: center;margin-top:20px;">
                <span>بارگذاری فایل تایید کننده </span>
            </a>
            <input id="inp_file" style="display:none" type="file" class="form-control inp_file" value="" />
            <input id="summery_file" style="display:none" type="file" class="form-control" value="" />
        </div>
    </div>
}
