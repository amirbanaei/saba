                   // Select Excel File And Submit Form
    $("input[name='MyExcelStream']").change(function () {
        console.log($("#baste_peyman").val());
        if ($("#baste_peyman").val() == null) {
            alert("پیمان مورد نظر را انتخاب نمایید")
        } else if ($("#basteOfPeyman").val() == null) {
            alert("بسته مورد نظر را انتخاب نمایید")
        }
        else if ($("#year_usr").val() == 0) {
            alert("سال مورد نظر را انتخاب نمایید")
        } else if ($("#month_usr").val() == 0) {
            console.log($("#month_usr").val())
            alert("ماه مورد نظر را انتخاب نمایید")
        } else if ($("#datepickerFrom_usr").val() == null) {
            alert("از تاریخ مورد نظر را انتخاب نمایید")
        } else if ($("#datepickerTo_usr1").val() == null) {
            alert("تا تاریخ مورد نظر را انتخاب نمایید")
        } else {
                var file = this.files[0];
                var ext = file.name.split('.')[1];
                if (ext == "xlsx" || ext == "xls") {

                    var  obj = new FormData();

                    obj.append("MyExcelStream", file);
                    obj.append("FromDate", $("#datepickerFromEn_usr").val());
                    obj.append("ToDate", $("#datepickerToEn_usr1").val());
                    obj.append("Basteh", $('#basteOfPeyman').val());
                    obj.append("PeymanID", $("#baste_peyman2").val());
                    console.log(file);
                    $.ajax({
                    beforeSend:function (){
                      document.getElementById("loading-message").style.display = "block";
                    },
                       url: "@Url.Action("ImportExcel_Moalefe", "Moalefe",new { area="Salaries" })",
                       type: "post",
                       contentType: false,
                       data: obj,
                       processData: false,
                       cache: false,
                        success: function (res) {
                            document.getElementById("loading-message").style.display = "none";
                            //UploadedFile(res);



                            // نمایش مدال SweetAlert2

                            // نمایش مدال شما
                           // if (res.lenght() > 300) {
                                $("#big_modal_body").html(res);

                           // } else {
                           //     alert(res);
                           // }




                       },
                       error: function (res) {
                           console.log(res);
                       }
                   });
                }
                else {

                    Swal.fire({
                        icon: 'warning',
                        background: 'rgb(29,40,52)',
                        color: 'white',
                        confirmButtonText: 'باشه',
                        title: 'نوع فایل',
                        text: 'لطفا فایل را صحیح وارد کنید',
                    });
                    return false;
                }
        }


            });
            /// Open Dialog File
    function ShowDialogFile() {
        console.log($("#datepicker1").val());
        console.log($("#datepicker").val());
                $("input[name='MyExcelStream']").val(null);
                $("input[name='MyExcelStream']").click();
            }


    function DownloadExcel() {
        console.log($("#month_usr").val());
        var aa = $("#month_usr").val();
        Basteh = $('#basteOfPeyman').val();
        var ye = ($("#year_usr").val())
        console.log($("#basteOfPeyman").val());
        console.log($("#year_usr").val());
        console.log($("#datepicker1").val());
        console.log($("#datepicker").val());


                    $.ajax({
                        beforeSend: function () {
                            document.getElementById("loading-message").style.display = "block";//مهندس دارین برعککس میزارین
                            //این درسته
                            //شبیه هم ننوشتین
                            //خوب ورودی هام فرق داتشنت الاان فهمیدم چیشد + اضافه گذاشته بود
                        },
                        url: '@Url.Action("ExportMoalefeExcel", "Moalefe", new { area = "Salaries" })?year=' + ye + '&month=' + aa + '&FromDate=' + $("#datepicker1").val() + '&ToDate=' + $("#datepicker").val() + '&PeymanID=' + $("#baste_peyman2").val() + '&Basteh=' + Basteh,
                        type: 'GET',
                        dataType: 'html',
                        //در گام اول میخواین اطلاعات رو بفرستین کاری به دانلود ندارین
//الان چرا از این استفاده نمیکنید ؟
    //من میخوام اکسل دانلود کنه نه pdf
    //من اطلاعات که ثبت کرده را فرستادم توی دیتابیس حالا میخوام نمایش بدم به اون که بادی تایید کند
    //دقت کنید ! ..
    //شما میخواین یک ایدی را بفرستید صرفا ، بقیه اطلاعات در بقیه ستون های آن ایدی نهفته است
    //ای دی را بفرستید اطلاعات را از دیتابیس واکشی کنید در یک فایل اکسل بریزید و اکسل را برگردانید
    //                    درسته ؟
    //خوب شما منم اگر کدم را ببینید همین کار را کردم ولی نمیفرسته سمت سرور و اگر برود درسته الاناون تابع که نمیره مشکلم اون جاست
    //متوجهم
    //گام اول پس نیاز نیست ماه و سال و .. رو بفرستید
    //صرفا ایدی رو بفرستید
    //حالا در گام دوم ببینیم چرا وارد نمیشه

                        success: function (res) {
                            document.getElementById("loading-message").style.display = "none";
                            window.location = '@Url.Action("ExportMoalefeExcel", "Moalefe",new { area = "Salaries" })?year=' + ye + '&month=' + aa + '&FromDate=' + $("#datepicker1").val() + '&ToDate=' + $("#datepicker").val() + '&PeymanID=' + $("#baste_peyman2").val() + '&Basteh=' + Basteh;
                       },
                       error: function (res) {
                           console.log(res);
                       }
                   });
            }

</script>

