@{
    ViewBag.Title = "ادامه پردازش...";
    int count = ViewBag.CountPdf ?? 0;
    int month = ViewBag.Month ?? 1;
    int year = ViewBag.Year ?? 1404;
}

<div style="text-align:center; margin-top:50px;">
    <h2>⚠️ پردازش متوقف شد بعد از @count فایل</h2>
    <p>در حال ادامه خودکار...</p>
</div>

<script>
    var count = @ViewBag.CountPdf ?? 0;
    var year = @ViewBag.Year ?? 1404;
    var month = @ViewBag.Month ?? 1;

    setTimeout(function () {
        var url = '/Contracts/UserContract/vi?usr_ID=0&year=' + year + '&month=' + month + '&count=' + count;
        window.location.href = url;
    }, 1000);
</script>
