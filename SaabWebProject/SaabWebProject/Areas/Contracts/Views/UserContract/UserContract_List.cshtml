@{
    Layout = null;
}
@model List<SaabWebProject.Models.DomainModels.tbUserContracts>
<input type="file" value="" id="input_file" style="display:none;" />

<div class="card">
    <div class="table-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("فعالیت")
                            </th>
                            <th>
                                @Html.DisplayName("#")
                            </th>
                            <th>
                                @Html.DisplayName("از تاریخ")
                            </th>
                            <th>
                                @Html.DisplayName("تا تاریخ")
                            </th>

                            <th>
                                @Html.DisplayName("نوع قرارداد")
                            </th>
                            <th>
                                @Html.DisplayName("عنوان شغل")
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            int counter = 0;
                            foreach (var item in Model)
                            {
                                <tr style="text-align:center;">
                                    <td>
                                        <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                            <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <div class="dropdown-menu">
                                                <a  class="dropdown-item delete" id="delete_@item.usc_ID">حذف</a>
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item details" id="details_@item.usc_ID">مشاده جزئیات</a>
                                                <a class="dropdown-item details" id="" href="~/Areas/Contracts/Contents/ContractsFile/@item.usc_FileSystemName">مشاهده قرارداد امضا شده</a>
                                                <a class="dropdown-item uplload" id="btn_file_@item.usc_ID">
                                                    <span>آپلود قرارداد امضا شده</span>
                                                </a>
                                                <input id="inp_file" style="display:none" type="file" class="form-control" value="" />


                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        @{counter = counter + 1;}

                                        <span>@counter</span>
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.usc_ShmasiStartTime)
                                    </td>
                                    <td>

                                        @Html.DisplayFor(modelItem => item.usc_ShmasiENDTime)
                                    </td>


                                    <td>
                                        @if (item.usc_TypeOfContract == false)
                                        {
                                            <span>وقت مزدی</span>
                                        }
                                        else
                                        {
                                            <span>کارمزدی</span>
                                        }
                                    </td>
                                    <td>
                                        @item.usc_Jobtitle
                                    </td>
                                </tr>
                            }

                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>

<script>
    $(".details").click(function () {
        var idd = $(this).attr("id").split("_")[1];
        $("#big_modal_body1").load('@Url.Content("/UserContract/UserContract_Details")?contractId='+idd);
    });
   $(".delete").click(function () {
        var idd = $(this).attr("id").split("_")[1];

    /*document.getElementById("loading-message").style.display = "block";*/





    Swal.fire({
        title: 'آیا از حدف قرارداد مطمئن هستید؟',
        icon: 'question',
        showCancelButton: true,
        background: 'rgb(29,40,52)',
        color: 'white',
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'بله ',
        cancelButtonText: 'خیر'
    }).then((result) => {

        if (result.isConfirmed == true) {
            $(".loader").css('display', 'block');

          $.ajax({
              url: '@Url.Action("UserContract_Delete", "UserContract", new { area = "Contracts" })',
              data: { userContractID: idd },
              type: "Post",
              dataType: "html",
              success: function (resp) {
                  $("#loading-message").css("display", "none");
                  if (resp == "True") {
                      Toast.fire({
                          icon: 'success',
                          background: '#35434A',
                          color: 'white',
                          title: "قرارداد با موفقیت حذف شد"
                      }).then(() => {
                          location.reload();
                      });
                  } else {
                      Toast.fire({
                          icon: 'success',
                          background: '#35434A',
                          color: 'white',
                          title: "نمیتوانید این قرارداد را حذف کنید"
                      }).then(() => {
                      });
                  }

              },
              error: function (resp2) {
                  $("#loading-message").css("display", "none");
                  Toast.fire({
                      icon: 'success',
                      background: '#35434A',
                      color: 'white',
                      title: "حذف قرارداد با خطا مواجه شده است"
                  }).then(() => {
                      location.reload();
                  });
              }
          });
        }

    });






      });

 //   $(".uplload").click(function(){
   // $("#input_file").click();
   // })

    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
</script>

@* آپلود فایل *@
<script>
        var fd = new FormData();

        $(".uplload").click(function () {
        $("#inp_file").click();
    });

    $("#inp_file").change(function (e) {
               // fd.append("id", 1);
                $.each(e.target.files, function (index, file) {
                    fd.append("files", file);
                });
                    sendAjax1('@Url.Action("UploadFile", "UserContract",new { area = "Contracts" })',fd)

     });
        var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
    function sendAjax1(url2,fd2) {
            $("#loading-message").css("display", "block");
             fd2.append("ID", $(".uplload").attr("id").split("_")[2]);
                                   $.ajax({
                                       url: url2,
                                       type: 'POST',
                                       data: fd2,
                                       processData: false,
                                       contentType: false,
                                       success: function (resp1) {
                                           $("#loading-message").css("display", "none");

                                           if (resp1 == "True") {
                                               Toast.fire({
                                                   icon: 'success',
                                                   background: '#35434A',
                                                   color: 'white',
                                                   title: "اطلاعات با موفقیت آپدیت شد"
                                               }).then(() => {
                                                   location.reload();
                                               });
                                           } else {
                                               $("#loading-message").css("display", "none");
                                               Toast.fire({
                                                   icon: 'success',
                                                   background: '#35434A',
                                                   color: 'white',
                                                   title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                                               }).then(() => {
                                                   $("#loading-message").css("display", "none");
                                               });


                                           }

                                       },
                                       error: function (resp1) {
                                           $("#loading-message").css("display", "none");
                                           Toast.fire({
                                               icon: 'success',
                                               background: '#35434A',
                                               color: 'white',
                                               title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                                           }).then(() => {
                                               $("#loading-message").css("display", "none");
                                           });
                                       }
                                   });



    }


</script>