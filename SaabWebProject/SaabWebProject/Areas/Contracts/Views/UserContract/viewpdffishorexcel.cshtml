<script type="text/javascript">
    jalaliDatepicker.startWatch({
        time: true,
        days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
        persianDigits: true,
        autoClose: true,
        autocomplete: true,
        showCloseBtn: true,
        showEmptyBtn: false,
        showCloseBtn: true,
        zIndex: 100000,

    });
    var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
    for (var i = 0; i < inputs.length; i++) {
        inputs[i].addEventListener("jdp:change", function (e) {
            var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
            var date = this.value.replace(' ', '').slice(0, 10).split('/');
            date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]),)
            // If it was empty
            if (!this.value) {
                date = "";
            }
            // If it was only history
            else if (this.value.replace(' ', '').length < 11) {
                date = date.gy + '-' + date.gm + '-' + date.gd
            }
            // If it was the date and time
            else {
                date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30)
            }
            miladiInput.value = date
        });
    }
     
</script>
<script>
        $("#users-1").load('@Url.Content("/../Users/Users/_PartialViewUsersListWithSearchAndMultiple")', function () {
            $("#select_users1").attr("id", "users1");
            $('#users1').attr("multiple", "multiple");
            $('#users1').picker({ search: true });
            $('#users1').on('sp-change', function () { });

        });
    $(document).on("click", "#deleteFish", function () {

        var year = $("#Year1").val();
        var month = $("#month1").val();

        if (year == "0" || month == "0") {
            alert("لطفاً سال و ماه را انتخاب کنید");
            return;
        }

        if (!confirm("⚠️ تمام فیش‌های این ماه حذف خواهند شد. ادامه می‌دهید؟"))
            return;

        $.ajax({
            url: "/Contracts/UserContract/DeleteFishByMonth",
            type: "POST",
            data: { year: year, month: month },
            success: function (res) {
                alert(res);
            },
            error: function () {
                alert("خطا در حذف فایل‌ها");
            }
        });
    });


    $(document).on("click", "#downloadFish", function () {

        var year = $("#Year1").val();
        var month = $("#month1").val();

        if (year == "0" || month == "0") {
            alert("لطفاً سال و ماه را انتخاب کنید");
            return;
        }

        window.location.href =
            "/Contracts/UserContract/DownloadFishByMonth?year=" + year + "&month=" + month;
    });


</script>
