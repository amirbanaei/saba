<script>
    $(document).ready(function () {

        // کلیک روی دکمه submit (تب دوم)
        $(document).on("click", "#submit25", function () {
            console.log("submit clicked!");
            document.getElementById("loading-circle").style.display = "block";

            var PeymanArr = [];
            $.each($("#users2").val().toString().split(","), function (index, item) {
                if (item !== "" && item !== "Select") {
                    PeymanArr.push(item);
                    console.log(item);
                }
            });

            var year = $("#Year1").val();
            var month = $("#month1").val();
            var count = 0; // اگر مقدار خاصی نداری، پیش‌فرض صفر

            console.log("سال:", year);
            console.log("ماه:", month);
            console.log("کاربران:", PeymanArr);

            $.ajax({
                url: "@Url.Action("vi1", "UserContract", new { area = "Contracts" })",
                type: "POST",
                dataType: "html",
                data: { Fkpym: PeymanArr, month: month, year: year, count: count },
                success: function (res) {

                    console.log("نتیجه:", res);
                    if (res === "True") {
                        document.getElementById("loading-circle").style.display = "none";

                        alert("با موفقیت ثبت شد");
                        location.reload();
                    } else {
                        alert("خطا در ثبت: " + res);
                    }
                },
                error: function (res) {
                    console.log("خطای Ajax:", res);
                    alert("خطای سرور در ثبت اطلاعات.");
                }
            });
        });

    });
</script>


