    function sendAjax(url, data) {

        $.ajax({
            beforeSend: function () {
                document.getElementById("loading-message").style.display = "block";
            },
            url: url,
            data: { obj_ContractsListViewModel: data },
            type: "Post",
            dataType: "html",
            success: function (resp) {
                document.getElementById("loading-message").style.display = "none";
                console.log(resp);
                if (resp.split("_")[0] == "Falsee") {
                    alert("یکی از کاربران انتخاب شده این تاریخ قرارداد دیگری دارد");
                } else if (resp == "Falsee_WithoutUser") {
                    alert("کاربری انتخاب نشده است");
                } else if (resp == "False") {
                    alert("دچار مشکل شده است ");
                } else {
                    alert("با موفقیت ثبت شد");
                }
            },
            error: function (resp) {
                document.getElementById("loading-message").style.display = "none";
                alert("دچار مشکل شده است ");
                console.log(resp);
            }
        });

    }


