    $(function () {
        $.each($(".numbers"), function (index, item) {

            var amount = $(this).text().replace(/[\D\s\._\-]+/g, "-");

            amount = amount ? parseInt(amount, 10) : 0;
            $(this).text(function () {
                return (amount === 0) ? "0 " : amount.toLocaleString("fa-IR") + " " + "";
            });
        });

