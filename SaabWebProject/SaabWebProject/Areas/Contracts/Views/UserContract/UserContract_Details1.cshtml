                            dataType: "html",
                           success: function (resp) {
                               $("#loading-message").css("display", "none");
                               $("#FromJobGroups").html(resp);
                            },
                            error: function (resp) {
                                console.log(resp);
                                console.log("nashod");
                                Toast.fire({
                                    icon: 'success',
                                    background: '#35434A',
                                    color: 'white',
                                    title: "عملیات با خطا مواجه شده است"
                                }).then(() => {
                                });
                             $("#loading-message").css("display", "none");

                            }
                       });

            $("#FromMoalefe").load('@Url.Content("/../Contracts/MoalefeDastMozdi/_PartialViewGetGhararDadiMoalefeForGharardadProject")',
                function () {
                    $("#roww").attr("id", "roww_1");
                    $("#minu").attr("id", "minu_1");
                    $("#moalefe").attr("id", "moalefe_1");
                    $("#valueMoalefe").attr("id", "valueMoalefe_1");
                    $("#NextRow").attr("id", "NextRow_2");
                    $(".minus_class").on("click", function () {
                        var id = $(this).attr("id").split("_")[1];
                        $("#roww_" + id).remove();
                    });
                });

        }
    }

    $("#Plus").click(function () {
            i++;
           $("#NextRow_" + i).load('@Url.Content("/../Contracts/MoalefeDastMozdi/_PartialViewGetGhararDadiMoalefeForGharardadProject")', function () {
               $("#roww").attr("id", "roww_"+i);
               $("#minu").attr("id", "minu_"+i);
               $("#moalefe").attr("id", "moalefe_"+i);
               $("#valueMoalefe").attr("id", "valueMoalefe_"+i);
               $("#NextRow").attr("id", "NextRow_" + (i + 1));
               $(".minus_class").on("click", function () {
                   var id = $(this).attr("id").split("_")[1];
                   $("#roww_" + id).remove();
