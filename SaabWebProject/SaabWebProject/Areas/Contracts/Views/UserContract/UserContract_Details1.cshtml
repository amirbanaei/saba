            alert("حق مسکن را وارد نمایید");
        } else if ($("#jg_KharoBar").val().trim().length == 0) {
            alert("خوار و بار را وارد نمایید");
        } else {
            var Filters = new Object();
        var Total = new Object();
        Total.list_usersIDs = $("#users").val();
        Filters.usc_TypeOfContract = $("#usc_TypeOfContract").val();
        Filters.FK_KarfarmaID = $("#FK_KarfarmaID").val();
        Filters.FK_JobGroup = $("#FK_JobGroup").val();
        Filters.usc_TedadSalSanavat = $("#usc_TedadSalSanavat").val();
        Filters.usc_JobCode = $("#usc_JobCode").val();
        Filters.usc_Jobtitle = $("#usc_Jobtitle").val();
        Filters.ShamsiStartTime_day = $("#ShamsiStartTime_day").val();
        Filters.ShamsiStartTime_month = $("#ShamsiStartTime_month").val();
        Filters.ShamsiStartTime_year = $("#ShamsiStartTime_year").val();
        Filters.ShamsiENDTime_day = $("#ShamsiENDTime_day").val();
        Filters.ShamsiENDTime_month = $("#ShamsiENDTime_month").val();
        Filters.ShamsiENDTime_year = $("#ShamsiENDTime_year").val();
        Filters.jobgroup_ValueMozdGroup = $("#ValueMozdGroup").val();
        Filters.jobgroup_ValueSanavat = $("#ValueSanavat").val();
        Filters.jobgroup_HagheOlad = $("#jg_HagheOlad").val();
        Filters.jobgroup_HagheMaskan = $("#jg_HagheMaskan").val();
        Filters.jobgroup_KharoBar = $("#jg_KharoBar").val();

        let barArray = [];
        var flag = true;
        var counter = 0;
        $('.Contract_row_class').each(function (i, obj) {
            counter++;
            var id = $(this).attr("id").split("_")[1];
            var obj = new Object();
            if ($("#moalefe_" + id).val() != 0 && $("#valueMoalefe_" + id).val().trim().length == 0) {
                alert("مولفه" + counter + "را انتخاب نمایید");
                flag = false;

            } else if ($("#moalefe_" + id).val() != 0 && $("#valueMoalefe_" + id).val().trim().length != 0) {
                console.log("here");
                console.log($("#valueMoalefe_" + id).val().trim().length);
                console.log($("#moalefe_" + id).val());
                obj.Value = $("#valueMoalefe_" + id).val();
                obj.FKMoalefeGhararDadi = $("#moalefe_" + id).val();
                barArray.push(obj);
            }

        });
        Filters.tbUserContractsAndMoalefeGhararDadi = barArray;
        Total.obj_tbuserContracts = Filters;

        if (flag == false) {
            return false;
        }

        sendAjax('@Url.Action("UserContract_Save", "UserContract", new { area = "Contracts" })', Total);
        }

    });

    function sendAjax(url, data) {

        $.ajax({
            beforeSend: function () {
                document.getElementById("loading-message").style.display = "block";
            },
            url: url,
            data: { obj_ContractsListViewModel: data },
            type: "Post",
            dataType: "html",
            success: function (resp) {
                document.getElementById("loading-message").style.display = "none";
                console.log(resp);
                if (resp.split("_")[0] == "Falsee") {
                    alert("یکی از کاربران انتخاب شده این تاریخ قرارداد دیگری دارد");
                } else if (resp == "Falsee_WithoutUser") {
                    alert("کاربری انتخاب نشده است");
                } else if (resp == "False") {
                    alert("دچار مشکل شده است ");
                } else {
                    alert("با موفقیت ثبت شد");
                }
            },
            error: function (resp) {
                document.getElementById("loading-message").style.display = "none";
                alert("دچار مشکل شده است ");
                console.log(resp);
            }
        });

    }


