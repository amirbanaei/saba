    $("#btnSaveContract").click(function () {
        if ($("#users").val().toString().split(',').length == 0) {
            alert("کاربران را انتخاب نمایید");
        } else if ($("#usc_TypeOfContract").val() == -1) {
            alert("نوع قرارداد را انتخاب نمایید");
        } else if ($("#FK_KarfarmaID").val() == -1) {
            alert("کارفرما را انتخاب نمایید");
        } else if ($("#FK_JobGroup").val() == 0) {
            alert("گروه شغلی را انتخاب نمایید");
        } else if ($("#usc_TedadSalSanavat").val() > 40 || $("#usc_TedadSalSanavat").val() < 0 || $("#usc_TedadSalSanavat").val().trim().length == 0) {
            alert("تعداد سال سنوات را صحیح پر نمایید");
        } else if ($("#ShamsiStartTime_day").val() == 0) {
            alert("روز شروع را انتخاب نمایید");
        } else if ($("#ShamsiStartTime_month").val() == 0) {
            alert("ماه شروع را انتخاب نمایید");
        } else if ($("#ShamsiStartTime_year").val() == 0) {
            alert("سال شروع را انتخاب نمایید");
        } else if ($("#ShamsiENDTime_day").val() == 0) {
            alert("روز پایان را انتخاب نمایید");
        } else if ($("#ShamsiENDTime_month").val() == 0) {
            alert("ماه پایان را انتخاب نمایید");
        } else if ($("#ShamsiENDTime_year").val() == 0) {
            alert("سال پایان را انتخاب نمایید");
        } else if ($("#ValueMozdGroup").val() == 0) {
            alert("مزد گروه را وارد نمایید");
        } else if ($("#ValueSanavat").val().trim().length == 0) {
            alert("مقدار سنوات را وارد نمایید");
        } else if ($("#jg_HagheOlad").val().trim().length == 0) {
            alert("حق اولاد را وارد نمایید");
