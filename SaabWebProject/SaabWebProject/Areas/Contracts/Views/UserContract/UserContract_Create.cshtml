<script>
    var i = 1;
    $(function () {

            $("#FromMoalefe").load('@Url.Content("/../Contracts/MoalefeDastMozdi/_PartialViewGetGhararDadiMoalefeForGharardadProject")',
                function () {
                    $("#roww").attr("id", "roww_1");
                    $("#minu").attr("id", "minu_1");
                    $("#moalefe").attr("id", "moalefe_1");
                    $("#valueMoalefe").attr("id", "valueMoalefe_1");
                    $("#NextRow").attr("id", "NextRow_2");
                    $(".minus_class").on("click", function () {
                        var id = $(this).attr("id").split("_")[1];
                        $("#roww_" + id).remove();
                    });
                });

        $("#div_users1").load('@Url.Content("/../Users/Users/_PartialViewUsersListWithSearchAndMultiple")', function () {
            $("#select_users1").attr("id", "users");
            $("#users").picker({ search: true });
            $("#users").picker();
            $('#users').picker({ search: true });
        });

        $("#span_karfarmayan").load('@Url.Content("/../Users/Company/_PartialListCompaniesInDropDown")', function () {
            $("#companies").attr("id", "FK_KarfarmaID");
            $('#FK_KarfarmaID').removeAttr("multiple");
            $("#FK_KarfarmaID").picker();
            $('#FK_KarfarmaID').picker({ search: true });
        });
       $("#span_karfarmayan_Asli").load('@Url.Content("/../Users/Company/_PartialListCompaniesInDropDown")', function () {
            $("#companies").attr("id", "FK_KarfarmaAsli");
            $('#FK_KarfarmaAsli').removeAttr("multiple");
            $("#FK_KarfarmaAsli").picker();
            $('#FK_KarfarmaAsli').picker({ search: true });
        });
    });
    $("#select_position").removeAttr("multiple");
    $('#select_position').change(function () {
         var x = $("#select_position").val();
         $("#div_users1").load('@Url.Content("/../Users/Users/_PartialViewUsersListWithSearchAndMultiple")' , { positions: x }  , function () {
            $("#select_users1").attr("id", "users");
            $("#users").picker({ search: true });
            $("#users").picker();
            $('#users').picker({ search: true });

          //$('#select_users1 option').attr("selected","selected");
          //$('#select_users1').picker('refresh');
        });
    });
    $("#listjob").removeAttr("multiple");
    $("#FK_JobGroup").on("change",function () {
        upload_formula_and_jobgroup_information();
    });

    $("#usc_TedadSalSanavat").on("change", function () {
        upload_formula_and_jobgroup_information();
    });

    function upload_formula_and_jobgroup_information() {
        if ($("#FK_JobGroup").val() != 0 && $("#usc_TedadSalSanavat").val().trim().length != 0) {
                   $("#loading-message").css("display", "block");
                       $.ajax({
                           url: '@Url.Action("_PartialGetJobGroupMoalefeForContracts", "JobGroups", new { area = "Contracts" })',
                           data: { groupNumber: $("#FK_JobGroup").val(), sanavatYear: $("#usc_TedadSalSanavat").val()},
                            type: "Post",
                            dataType: "html",
                           success: function (resp) {
                               $("#loading-message").css("display", "none");
                               $("#FromJobGroups").html(resp);
                            },
                            error: function (resp) {
                                console.log(resp);
                                console.log("nashod");
                                Toast.fire({
                                    icon: 'success',
                                    background: '#35434A',
                                    color: 'white',
                                    title: "عملیات با خطا مواجه شده است"
                                }).then(() => {
                                });
                             $("#loading-message").css("display", "none");

                            }
                       });


        }
    }

    $("#Plus").click(function () {
            i++;
            console.log("hello");
           $("#NextRow_" + i).load('@Url.Content("/../Contracts/MoalefeDastMozdi/_PartialViewGetGhararDadiMoalefeForGharardadProject")', function () {
               $("#roww").attr("id", "roww_"+i);
               $("#minu").attr("id", "minu_"+i);
               $("#moalefe").attr("id", "moalefe_"+i);
               $("#valueMoalefe").attr("id", "valueMoalefe_"+i);
               $("#NextRow").attr("id", "NextRow_" + (i + 1));
               $(".minus_class").on("click", function () {
                   var id = $(this).attr("id").split("_")[1];
                   $("#roww_" + id).remove();
               });
           });
    });

