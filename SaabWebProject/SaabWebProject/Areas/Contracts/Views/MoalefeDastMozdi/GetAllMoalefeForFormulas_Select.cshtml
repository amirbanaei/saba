@model List<SaabWebProject.Areas.Contracts.Models.Classes.ListOfMoalefeha>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<select class="form-control" id="select_moalefe" name="select_moalefe" multiple="multiple">
    @foreach (var item in Model)
    {
        if (item.Type == 0)
        {
            <option value="@item.GharardadColoumnName">
                @item.variablePersianName
            </option>
        }
        else
        {
            <option value="@item.ID">
                @{var s = item.Type + "_" + item.ID;}
                @item.variablePersianName
            </option>
        }
    }
</select>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script>
    $("#select_moalefe").picker({ search: true });
</script>