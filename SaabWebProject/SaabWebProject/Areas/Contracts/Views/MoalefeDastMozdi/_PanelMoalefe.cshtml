
@model IEnumerable<SaabWebProject.Models.DomainModels.tbContractPanels>

<select class="form-select select_Allmoalefe select_moalefe" id="select_moalefe" name="select_moalefe">

    @foreach (var item in Model)
    {

        <option value="@item.Id">@item.Title</option>

    }
</select>

<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script>
    $('.select_moalefe').picker({ search: true });
    $(".select_moalefe").removeClass("select_moalefe")
</script>