@model IEnumerable<SaabWebProject.Models.DomainModels.tbControllyPeyman>

<div class="card mt-3" style="width: 100%">
    <div class="tab-content p-4">
        <div class="row">
            <div class="col-lg-6">
                <div class="form-group mb-3">
                    <label class="form-label">  پیمان </label>
                    <div id="sectionPeymanEdit"></div>
                    @*@Html.Action("PeymanList", "MoalefeDastmozdi", new { area = "Contracts" })*@
                </div>
            </div>
            <div class="col-lg-6">
                <div class="form-group mb-3" id="sectionControllyMoalefeEdit">
                    <label class="form-label">  مولفه کنترلی</label>
                    @Html.Action("ControllyMoalefeList2", "MoalefeDastmozdi", new { area = "Contracts" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xl-11"></div>
            <div class="col-xl-1">
                <button type="button" onclick="SubmitProjectEdit()" class="btn form-control buttonsabt">
                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                    <span class="bSabt-text">ثبت</span>
                </button>
            </div>
        </div>

    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
    @*<input class="d-none" value="@Model.ProjectCode" id="ProjectCode1" />*@



    <script>

    $("#sectionPeymanEdit").load('@Url.Content("/Contracts/MoalefeDastmozdi/PeymanList")', function () {
        $("#sectionPeymanEdit > #select_Peymans").attr("id", "select_moalefePeymanEdit");
        $("#sectionControllyMoalefeEdit > #ControllyMoalefe2").attr("id", "ControllyMoalefe2Edit");

        $("#select_moalefePeymanEdit").picker('set', @Model.First().tbPeymanContracts.pec_ID);

        var myArray = [];
        @foreach (var d in Model)
        {
            @:myArray.push(@d.tbContractMoalefeDastmozdi.md_ID);
        }
            myArray.forEach((x) => $("#ControllyMoalefe2Edit").picker('set', x));
        });
    </script>
