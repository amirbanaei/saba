@using SaabWebProject.Utility
@model IEnumerable<SaabWebProject.Models.DomainModels.tbContractMoalefeDastmozdi>

<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />

<style>
    .tableH_Lock1 {
        max-height: 483px;
        /*height: 260px;*/
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0px !important;
    }

    thead th {
        vertical-align: middle;
    }
</style>
<div class="card">

    <div class="table-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive tableH_Lock1">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("فعالیت")
                            </th>
                            <th>
                                @Html.DisplayName("#")
                            </th>
                            <th>
                                @Html.DisplayName("عنوان")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter01-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("دسته")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("واحد")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter04-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("نوع مولفه")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter05-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("جنس مولفه")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter06-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>

                            <th>
                                @Html.DisplayName("وضعیت")
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int counter = 0;
                            string vahed = "";
                            string noemoalefe = "";
                            string jensmoalefe = "";

                        }
                        @foreach (var item in Model)
                        {

                            if (item.tbUnitParameter != null)
                            {
                                vahed = @item.tbUnitParameter.unt_Name;
                            }
                            else
                            {
                                vahed = "-";
                            }
                            //==========================================
                            if (item.md_Type != null)
                            {
                                switch (item.md_Type)
                                {
                                    case (int)Type_Moalefe.Gharardadi:
                                        noemoalefe = "قراردادی";
                                        break;
                                    case (int)Type_Moalefe.Amalkardi:
                                        noemoalefe = "عملکردی";
                                        break;
                                    case (int)Type_Moalefe.Karbari:
                                        noemoalefe = "کاربری";
                                        break;
                                    case (int)Type_Moalefe.Controlli:
                                        noemoalefe = "کنترلی";
                                        break;
                                    case (int)Type_Moalefe.Dastmozdi:
                                        noemoalefe = "دستمزدی";
                                        break;
                                    case (int)Type_Moalefe.Karkardi:
                                        noemoalefe = "کارکردی";
                                        break;
                                    case (int)Type_Moalefe.Calculational:
                                        noemoalefe = "محاسباتی";
                                        break;
                                    case (int)Type_Moalefe.Sayer:
                                        noemoalefe = "سایر";
                                        break;
                                    case (int)Type_Moalefe.Pishkhan:
                                        noemoalefe = "پیشخوان";
                                        break;
                                    case (int)Type_Moalefe.Fish:
                                        noemoalefe = "فیش‏حقوقی";
                                        break;

                                    case (int)Type_Moalefe.sorat:
                                        noemoalefe = "صورت وضعیت";
                                        break;
                                }
                            }
                            //==========================================
                            if (item.md_variable != null)
                            {
                                if (item.md_variable == "string")
                                {
                                    jensmoalefe = "رشته";
                                }
                                else if (item.md_variable == "int")
                                {
                                    jensmoalefe = "عدد";
                                }
                                else if (item.md_variable == "date")
                                {
                                    jensmoalefe = "تاریخ";
                                }
                                else if (item.md_variable == "time")
                                {
                                    jensmoalefe = "زمان";
                                }
                                else if (item.md_variable == "tik")
                                {
                                    jensmoalefe = "تیک";
                                }
                                else
                                {
                                    jensmoalefe = "نامعلوم";
                                }
                            }
                            <tr class="task-list-row "
                                data-filter01="@Html.DisplayFor(modelItem => item.md_Title)"
                                data-filter03=@item.tbCategories.Category_Name
                                data-filter04="@vahed"
                                data-filter05="@noemoalefe"
                                data-filter06="@jensmoalefe">
                                <td>
                                    <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                        <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <div class="dropdown-menu">
                                            <a data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item edit" id="Edit_@item.md_ID">ویرایش</a>
                                            <a class="dropdown-item disable" id="Disable_@item.md_ID">غیرفعال/فعال</a>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @{counter = counter + 1;}

                                    <span>@counter</span>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.md_Title)
                                </td>
                                <td>
                                    @if (item.tbCategories.Category_Name != null)
                                    {
                                        @item.tbCategories.Category_Name

                                    }
                                </td>
                                <td>
                                    @vahed
                                </td>

                                <td>
                                    @noemoalefe
                                </td>
                                <td>
                                    @jensmoalefe
                                </td>

                                <td>
                                    @if (item.md_IsActive == true)
                                    {
                                        <i class="far fa-lg fa-fw me-2 fa-check-square" style="color:green"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-lg fa-fw me-2 fa-window-close" style="color:red"></i>
                                    }
                                </td>
                            </tr>
                        }


                    </tbody>
                </table>
            </div>

            @*<div class="d-md-flex align-items-center">
                    <div class="me-md-auto text-md-left text-center mb-2 mb-md-0">
                        نمایش 1 تا 10 از 57 داده
                    </div>
                    <ul class="pagination mb-0 justify-content-center">
                        <li class="page-item disabled"><a class="page-link">قبلی</a></li>
                        <li class="page-item"><a class="page-link" href="#">1</a></li>
                        <li class="page-item active"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item"><a class="page-link" href="#">4</a></li>
                        <li class="page-item"><a class="page-link" href="#">5</a></li>
                        <li class="page-item"><a class="page-link" href="#">6</a></li>
                        <li class="page-item"><a class="page-link" href="#">بعدی</a></li>
                    </ul>
                </div>*@
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script>

    var
        filters = {
            filter01: null,
            filter03: null,
            filter04: null,
            filter05: null,
            filter06: null,
        };

    function updateFiltersT() {
        $('.task-list-row').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilterT(filterName) {
        filters[filterName] = this.value;
        updateFiltersT();
    }

    // Assigned User Dropdown Filter
    $('#filter01-filter').on('input', function () {
        changeFilterT.call(this, 'filter01');
    });

    $('#filter03-filter').on('input', function () {
        changeFilterT.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilterT.call(this, 'filter04');
    });
    $('#filter05-filter').on('input', function () {
        changeFilterT.call(this, 'filter05');
    });
    $('#filter06-filter').on('input', function () {
        changeFilterT.call(this, 'filter06');
    });


</script>
<script>
    $(".edit").click(function () {
        var idd = $(this).attr("id").split("_")[1];
        $("#big_modal_body").load('@Url.Content("/MoalefeDastMozdi/_PartialUpdateMoalefeDastMozdi")?id='+idd);
    });
    $(".disable").click(function () {
        var idd = $(this).attr("id").split("_")[1];
                    $("#loading-message").css("display", "block");

                       $.ajax({
                           url: '@Url.Action("DisableEnableMoalefeDastMozdi","MoalefeDastMozdi",new { area = "Contracts" })',
                            data: { id: idd},
                            type: "Post",
                            dataType: "html",
                           success: function (resp) {
                               console.log(resp);
                                           $("#loading-message").css("display", "none");

                               if (resp == "False") {
                                   swal({
                                       title: "",
                                       type: "error",
                                       text: "ثبت با خطا مواجه شده است ! لطفا بعدا تکرار فرمایید",
                                       buttons: false,
                                       timer: 2000
                                   });
                               } else if (resp == "True") {
                                   location.reload();
                               }

                            },
                           error: function (resp) {
                                            $("#loading-message").css("display", "none");

                                 swal({
                                       title: "",
                                       type: "Error",
                                       text: "ثبت با خطا مواجه شده است ! لطفا بعدا تکرار فرمایید",
                                       buttons: false,
                                       timer: 2000
                                   });
                            }
                       });


    });
</script>
