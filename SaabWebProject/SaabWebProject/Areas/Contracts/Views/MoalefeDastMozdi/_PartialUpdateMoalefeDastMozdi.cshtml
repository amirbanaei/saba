@using SaabWebProject.Utility
@model SaabWebProject.Models.DomainModels.tbContractMoalefeDastmozdi


<link href="~/Assets/plugins/select-picker/dist/picker.min.css" type="text/css" rel="stylesheet" />
<style>
    .modal-lg, .modal-xl {
        margin-top: 8px !important;
        max-width: 90% !important;
    }
</style>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div id="formControls" class="mb-5">

        <div class="card">
            <div class="card-body pb-2">
                <form>
                    <div class="row">
                        <div class="col-xl-7">
                            <label class="form-label"> عنوان </label>
                            @Html.EditorFor(model => model.md_Title, new { htmlAttributes = new { @class = "form-control", @id = "title", @style = "" } })
                        </div>
                        <div class="col-xl-2">
                            <label class="form-label">جنس مولفه</label>
                            <select class="form-select" id="md_variable">
                                <option value="@Gender_Moalefe.Int">عدد</option>
                                <option value="@Gender_Moalefe.String">رشته</option>
                                <option value="@Gender_Moalefe.Date">تاریخ</option>
                                <option value="@Gender_Moalefe.Time">زمان</option>
                            </select>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label">نوع مولفه</label>
                            <select class="form-select" id="md_Type">
                                <option value="-1" selected>انتخاب مورد</option>
                                <option value="1">قراردادی</option>
                                <option value="2">عملکردی</option>
                                <option value="3">کاربری</option>
                                <option value="5">کنترلی</option>
                                <option value="4">سایر</option>
                                <option value="6">محاسباتی</option>
                                <option value="7">دستمزدی</option>
                                <option value="8">کارکردی</option>
                                <option value="9">پیشخوان</option>
                                <option value="10">فیش حقوقی</option>
                                <option value="11">صورت وضعیت </option>

                            </select>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label">دسته بندی</label>
                            @Html.Action("_GetAllListCategory_Select", "Categories", new { area = "Contracts" })
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label">واحد</label>
                            @Html.Action("_ListVahedForSelect222", "Moalefe", new { area = "BaseInformation" })
                        </div>
                    </div>
                    <div class="row" style="margin-top:4.5%">
                        <div class="col-xl-11">
                        </div>
                        <div class="col-xl-1">
                            <button id="btnSaveMoalefeDatMozdi" type="button" class="btn form-control buttonsabt">
                                <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                                <span class="bSabt-text">ثبت</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-arrow">
                <div class="card-arrow-top-left"></div>
                <div class="card-arrow-top-right"></div>
                <div class="card-arrow-bottom-left"></div>
                <div class="card-arrow-bottom-right"></div>
            </div>
        </div>
    </div>
}
<script src="~/Scripts/sweetalert2.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>

<script>
     $(function () {
         $("#select_category")[0].attributes.getNamedItem("name").value = "FK_Category_ID";
         $("#select_category").picker({ search: true });
         $("#select_category").picker('set', '@Model.FK_Category_ID.ToString()');
         $("#select_Unit")[0].attributes.getNamedItem("name").value = "FK_UnitParameter";
         $("#select_Unit").picker({ search: true });
         $("#select_Unit").picker('set', '@Model.FK_UnitParameter.ToString()');
         $("#md_variable").picker();
         $("#md_Type").picker();
         $("#md_variable").picker('set', '@Model.md_variable.ToString()');
         $("#md_Type").picker('set', '@Model.md_Type.ToString()');
     });

    var Toast = Swal.mixin({
            toast: true,
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
       }
    });


        function sendAjax(url, data) {
            $("#loading-message").css("display", "block");
                       $.ajax({
                           url: url,
                            data: { Filters: data},
                            type: "Post",
                            dataType: "html",
                           success: function (resp) {
                               console.log(resp);
                               $("#loading-message").css("display", "none");

                               if (resp == "True") {
                                   Toast.fire({
                                       icon: 'success',
                                       background: '#35434A',
                                       color: 'white',
                                       title: "اطلاعات با موفقیت ویرایش شد"
                                   }).then(() => {
                                       location.reload();
                                   });
                               } else {
                                               $("#loading-message").css("display", "none");

 swal({
                                       title: "",
                                       type: "success",
                                       text: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید",
                                       buttons: false,
                                       timer: 2000
                                   }, function () {
     });
                                   $("#loading-message").css("display", "none");

                               }

                            },
                            error: function (resp) {
                                console.log(resp);
                                console.log("nashod");
                                 swal({
                                       title: "",
                                       type: "success",
                                       text: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید",
                                       buttons: false,
                                       timer: 2000
                                   }, function () {
                                   });
                            }
                       });

        }

    $("#btnSaveMoalefeDatMozdi").click(function () {
        if ($("#title").val().trim().length == 0) {
            alert("لطفا عنوان مولفه را وارد نمایید");
        } else if ($("#md_variable").val() == 0) {
            alert("لطفا جنس متغیر را انتخاب کنید");
        }  else if ($("#md_Type").val() == -1) {
            alert("لطفا نوع متغیر را انتخاب کنید");
        }else {
            var Filters = new Object();
            Filters.md_variable = $("#md_variable").val();
            Filters.md_IsActive = '@Model.md_IsActive';
            Filters.md_Type = $("#md_Type").val();
            Filters.md_Title = $("#title").val();
            Filters.md_ID = @Model.md_ID;
            Filters.FK_UnitParameter = $("#select_Unit").val();
            Filters.FK_Category_ID = $("#select_category").val();

            console.log($("#select_category").val())
            sendAjax('@Url.Action("UpdateMoalefeDastMozdi", "MoalefeDastMozdi", new { area = "Contracts" })', Filters);
        }
    });
</script>