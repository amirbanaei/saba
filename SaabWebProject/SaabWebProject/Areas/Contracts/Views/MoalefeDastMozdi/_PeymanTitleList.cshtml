
@model IEnumerable<SaabWebProject.Models.DomainModels.tbPeymanContracts>
    <link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<select class="form-select select_Allmoalefe select_Peymans" id="select_Peymans" name="select_Peymans">
    @foreach (var item in Model)
    {
        <option value="@item.pec_ID">@item.pec_Title</option>
    }
</select>

<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script>    
    $('.select_Peymans').picker({ search: true });
    $(".select_Peymans").removeClass("select_Peymans")
</script>
