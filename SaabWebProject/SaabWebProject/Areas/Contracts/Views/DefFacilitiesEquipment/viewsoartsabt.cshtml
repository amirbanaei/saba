        console.log(FK_Baste);
        console.log(pymnID);

        $("#loading-message").css("display", "block");
        var selectedValue = $("#baste_peyman7").val();
        var parts = selectedValue.split('_');
        var FK_Baste = parts[1];
        var pymnID = parts[0];
        fd2.append("svdfunc_pymnID", pymnID);
        fd2.append("svdfunc_BastehID", FK_Baste);
        fd2.append("FromDate", $("#datepickerFromEn_usr").val());
        fd2.append("ToDate", $("#datepickerToEn_usr").val());
        //fd2.append("Year", $("#year_Eq4").val());
        //fd2.append("Month", $("#month_Eq4").val());
        //fd2.append("Type", $("#select_EquipmentGroup").val());

        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (res) {
                $("#loading-message").css("display", "none");
                fd = new FormData();
                console.log(res);
                console.log("jj");
                if (res == "True") {

                    alert("با موفقیت ثبت شد");

                    location.reload();
                }

                    //$("#big_modal_body1").html(res)
                    //    .then(() => {
                       @*$("#table_div").load('@Url.Content("../defFacilitiesEquipment/_ListEquipmentMoalefeValue")');*@


            },
            error: function (res) {
                $("#loading-message").css("display", "none");
                console.log(res);
                console.log("jj");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
