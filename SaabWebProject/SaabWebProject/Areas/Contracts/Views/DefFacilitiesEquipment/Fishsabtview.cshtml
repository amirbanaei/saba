                },
                error: function (res) {
                    alart("fdslsfdk")
                    console.log(res);
                }
            });
        }



    var Toast2 = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });

    $(function () {
        $("#myTable").load('@Url.Content("/MoalefeDastMozdi/_PartialListMoalefeDastMozdi")');
    });
    $("#createMoalefeButtonModal").click(function () {
            $("#big_modal_body").load('@Url.Content("/MoalefeDastMozdi/_PartialCreateMoalefeDastMozdi")');
    });
    var Temp = "@TempData["Message"]";
    if (Temp != "") {

        Toast2.fire({
            icon: 'success',
            background: '#35434A',
            color: 'white',
            title: Temp
        });

    }
    $("#btn_submit").click(function () {
        $("#submit_input").click();
    });
    $("#submit_input").click(function () {
        $("#send").click();
    });
</script>
<script>
      $("input[name='MyExcelStream']").change(function () {
        var file = this.files[0];
        var ext = file.name.split('.')[1];
        if (ext == "xlsx" || ext == "xls") {

            var  obj = new FormData();

            obj.append("MyExcelStream", file);

            console.log(file);
            $.ajax({
            beforeSend:function (){
              document.getElementById("loading-message").style.display = "block";
            },
                 url: "@Url.Action("ImportExcel_AddFish", "Formula", new { area = "Salaries" })",
               type: "post",
               contentType: false,
               data: obj,
               processData: false,
               cache: false,
               success: function (res) {
                   document.getElementById("loading-message").style.display = "none";
                   Swal.fire({
                       icon: 'success',
                       background: 'rgb(29,40,52)',
                       color: 'white',
                       confirmButtonText: 'باشه',
                       title: 'آپلود اکسل',
                       text: res,
                   });

               },
               error: function (res) {
                   console.log(res);
               }
           });
        }
        else {

            Swal.fire({
                icon: 'warning',
                background: 'rgb(29,40,52)',
                color: 'white',
                confirmButtonText: 'باشه',
                title: 'نوع فایل',
                text: 'لطفا فایلی با پسوند اکسل وارد کنید',
            });
            return false;
        }

    });
    /// Open Dialog File
    function ShowDialogFile() {
        $("input[name='MyExcelStream']").val(null);
        $("input[name='MyExcelStream']").click();
    }
</script>
