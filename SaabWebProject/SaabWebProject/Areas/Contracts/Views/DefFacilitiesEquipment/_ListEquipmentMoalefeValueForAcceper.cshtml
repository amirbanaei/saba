<script>
    function downloadAjax2(pym, fromdata, todata, id, type) {
        console.log(fromdata);
        console.log(pym);
        console.log(id);

        $("#loading-message").css("display", "block");

        window.location = '@Url.Action("ExportExcel_MachinsOrTools2", "DefFacilitiesEquipment", new { area = "Contracts" })' +
            '?Peyman_ID2=' + encodeURIComponent(pym) +
            '&Fromdata=' + encodeURIComponent(fromdata) +
            '&Todate=' + encodeURIComponent(todata) +
            '&type2=' + encodeURIComponent(type)+
            '&id=' + encodeURIComponent(id);

        $("#loading-message").css("display", "none");
    }
</script>
