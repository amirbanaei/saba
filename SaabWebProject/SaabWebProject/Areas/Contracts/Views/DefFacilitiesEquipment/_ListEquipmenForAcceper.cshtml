@model List<SaabWebProject.Models.DomainModels.tbEquipmentMoalefeValueReffrenceSave>
@{
    Layout = null;
}

<div class="card">
    <div class="table-content p-4">

        <div class="table-responsive" id="allTab">
            <table class="table table-hover text-nowrap">
                <thead>
                    <tr style="text-align:center">
                        <th>
                            @Html.DisplayName("فعالیت")
                        </th>
                        <th>
                            @Html.DisplayName("#")
                        </th>
                        <th>
                            @Html.DisplayName("پیمان")
                        </th>
                        <th>
                            @Html.DisplayName("نوع تجهیز")
                        </th>
                        <th>
                            @Html.DisplayName("از تاریخ")
                        </th>
                        <th>
                            @Html.DisplayName("تا تاریخ")
                        </th>
                        <th>
                            @Html.DisplayName("سال")
                        </th>
                        <th>
                            @Html.DisplayName("ماه")
                        </th>
                        <th>
                            @Html.DisplayName("جزئیات")
                        </th>
                        <th>
                            @Html.DisplayName("بارگیری اطلاعات")
                        </th>
                    </tr>
                </thead>
                <tbody style="text-align:center;">
                    @{ var counter = 0;}
                    @foreach (var item in Model)
                    {
                        counter++;

                        <tr>
                            <td>
                                <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                    <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <div class="dropdown-menu">
                                        @if (item.File_SystemName == null)
                                        {

                                            <a class="dropdown-item uploadSummery" id="uploadSummery_@item.ID">
                                                <span>بارگذاری خلاصه مدرک </span>
                                            </a>

                                        }

                                        <input id="summery_file5" style="display:none" type="file" class="form-control" value="" />



                                    </div>

                                </div>
                            </td>
                            <td>@counter</td>
                            <td id="pym">@item.tbEquipmentMoalefeValue.FirstOrDefault().tbEquipments.tbPeymanContracts.pec_Title</td>
                            <td>
                                @item.tbEquipmentMoalefeValue.FirstOrDefault().tbEquipments.tbEquipmentBunch.tbEquipmentGroup.Eqpgrp_Name
                            </td>
                            <td id="from">@item.tbEquipmentMoalefeValue.FirstOrDefault().FromDate</td>
                            <td id="todata">@item.tbEquipmentMoalefeValue.FirstOrDefault().ToDate</td>
                            <td>@item.tbEquipmentMoalefeValue.FirstOrDefault().Year</td>
                            <td>@item.tbEquipmentMoalefeValue.FirstOrDefault().Month</td>
                            @if (item.File_SystemName != null)
                            {

                                <td>
                                    <a target="_blank" href="~/Areas/Contracts/Contents/DefFacilitiesEquipment/UserUpload/@item.FileName">دانلود</a>
                                </td>
                            }
                            else
                            {
                                <td>پیوستی ثبت نشده </td>
                            }
                        <td>
                            <button class="btn form-control buttonGeneralPlus" onclick="downloadAjax2('@item.tbEquipmentMoalefeValue.FirstOrDefault().tbEquipments.tbPeymanContracts.pec_Title', '@item.tbEquipmentMoalefeValue.FirstOrDefault().FromDate', '@item.tbEquipmentMoalefeValue.FirstOrDefault().ToDate', '@item.ID','@item.tbEquipmentMoalefeValue.FirstOrDefault().tbEquipments.tbEquipmentBunch.tbEquipmentGroup.Eqpgrp_ID')" style="margin-right: 36px;">
                                <i class="bi bi-download  fa-fw me-1 VecGeneral" style="margin-right: -2px;"></i>
                                @*<span class="bGeneral-text">دانلود اطلاعات ثبت شده</span>*@
                            </button>
                        </td>
                            <td id="id5" style="display:none">@item.ID</td>
                            <td id="type" style="display:none">
                                @item.tbEquipmentMoalefeValue.FirstOrDefault().tbEquipments.tbEquipmentBunch.tbEquipmentGroup.Eqpgrp_ID
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>

<!-- Your existing script references -->

<script>
    function downloadAjax2(pym, fromdata, todata, id, type) {
        console.log(fromdata);
        console.log(pym);
        console.log(id);

        $("#loading-message").css("display", "block");

        window.location = '@Url.Action("ExportExcel_MachinsOrTools2", "DefFacilitiesEquipment", new { area = "Contracts" })' +
            '?Peyman_ID2=' + encodeURIComponent(pym) +
            '&Fromdata=' + encodeURIComponent(fromdata) +
            '&Todate=' + encodeURIComponent(todata) +
            '&type2=' + encodeURIComponent(type)+
            '&id=' + encodeURIComponent(id);

        $("#loading-message").css("display", "none");
    }
</script>
<script>

    var obj = new FormData();

     $(".uploadSummery").click(function () {
       FK_DDOfTitle = $(this).attr("id").split("_")[2];
       ID = $(this).attr("id").split("_")[1];
         $("#summery_file5").click();
   });

    $("#summery_file5").change(function (e) {
       $.each(e.target.files, function (index, file) {
           obj.append("files", file);
       });
            sendAjax2('@Url.Action("pavastrools", "DefFacilitiesEquipment", new { area = "Contracts" })', obj);
    });


    function sendAjax2(url2, fd2) {
        obj.append("id", ID);




        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                console.log("okeye");
                console.log(resp1);
                $("#loading-message").css("display", "none");
                fd = new FormData();
                if (resp1 == "True") {
                    alert("با موفقیت ثبت شد");
                    setTimeout(function () {
                        location.reload(); // یا می‌توانید از location.reload(true) هم استفاده کنید
                    }, 2000); // بازه زمانی به میلی‌ثانیه، اینجا 2000 میلی‌ثانیه (یعنی 2 ثانیه)
                }
                else {
                    $("#loading-message").css("display", "none");
                    console.log("jlk;;kkj");
                    Toast.fire({

                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });
                }

            },
            error: function (resp1) {
                console.log(resp1);
                console.log("Nokeye");
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });
    }


</script>

