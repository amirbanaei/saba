@{
    Layout = null;
}
@model IEnumerable<SaabWebProject.Models.DomainModels.tbEquipmentGroup>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<select class="form-select" id="select_EquipmentGroupForBunch" name="GrpIdBunch">
    <option value="Select">انتخاب کنید</option>
    @foreach (var item in Model)
    {
        <option value="@item.Eqpgrp_ID">@item.Eqpgrp_Name</option>
    }
</select>
<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script>
    $("#EquipmentGroup_id").picker();
    $('#EquipmentGroup_id').picker({ search: true });
</script>

