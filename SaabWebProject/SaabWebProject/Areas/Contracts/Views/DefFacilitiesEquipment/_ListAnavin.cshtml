
@{
    Layout = null;
}

@model int

<div class="row">
   
        @{ for (int i = 0; i < Model; i++)
            {
                int tedad = i + 1;
                <div class="col-xl-3">
                    <div class="form-group mb-3">
                        <input id="Spec_@tedad" class="form-control"  placeholder="@tedad )" name="FeatureTitle" />
                    </div>
                </div>
            }
        }
 
</div>


<script>
    $("#btn1").css("display", "flex");
    $("#btn2").css("display", "flex");
    $("#btn3").css("display", "flex");
    $("#btn4").css("display", "flex");
    $("#moshakhast").css("display", "flex");
    $("#moshakhast2").css("display", "flex");
</script>