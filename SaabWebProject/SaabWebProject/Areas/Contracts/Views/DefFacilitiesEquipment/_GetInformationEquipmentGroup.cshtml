@model List<SaabWebProject.Models.DomainModels.tbEquipmentGroup>


<div id="jstree">

    @foreach (var item in Model)
    {

        <ul>
            <li>
                <span style="font-size:17px;font-weight:bold">@item.Eqpgrp_Name</span>
                <ul>
                    @foreach (var Eq in item.tbEquipmentBunch)
                    {
                        <li id="child_@Eq.Eqpbnch_ID" >

                            <span style="font-size: 15px; font-weight: bold">@Eq.Eqpbnch_Name</span>
                            <ul>
                                @foreach (var Spec in Eq.tbEquipmentSpecifications)
                                {
                                    <li id="child_@Spec.sp_ID" style="list-style:persian">
                                        @Spec.sp_SpecTitle
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
            </li>
        </ul>

    }



</div>
