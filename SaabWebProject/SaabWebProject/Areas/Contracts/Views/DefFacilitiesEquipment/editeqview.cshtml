<script>
    function formatCurrency(input) {
        // حذف همه کاراکترهای غیر از اعداد و "." (جداکننده اعشاری)
        let value = input.value.replace(/[^\d.]/g, '');

        // تبدیل مقدار به عدد اعشاری
        let number = parseFloat(value);

        // اگر عدد معتبر باشد، آن را به صورت سه رقمی جداکنده کنید
        if (!isNaN(number)) {
            let formattedValue = number.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
            // قرار دادن مقدار فرمت شده در ورودی
            input.value = formattedValue;
        }
    }
    $(function () {
        $.each($(".number"), function (index, item) {

            var amount = $(this).text().replace(/[\D\s\._\-]+/g, "");

            amount = amount ? parseInt(amount, 10) : 0;
            $(this).text(function () {
                return (amount === 0) ? "" : amount.toLocaleString("en-US");
            });
        });

    });
</script>
