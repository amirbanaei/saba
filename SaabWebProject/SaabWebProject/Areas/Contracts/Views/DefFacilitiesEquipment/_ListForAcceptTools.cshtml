<script>


    function sendAjax450(url2, fd2) {

        var selectedValue = $("#baste_peyman_ACCEpt3").val();

        // Split the value into three parts based on the underscore
        var parts = selectedValue.split('_');

        // Extract the three values
        var FK_Baste = parts[0];
        var pymnID = parts[1];
        var Type = parts[2];
        var year_pY1 = $("#year_pY1").val()
        var month_pY1 = $("#month_pY1").val()

        console.log("svdfunc_ID: " + FK_Baste);
        console.log("pec_Title: " + pymnID);
        console.log("reffrence_Title: " + Type);
        console.log("svdfunc_ID: " + year_pY1);
        console.log("svdfunc_ID: " + month_pY1);










        $("#loading-message").css("display", "block");
        fd2.append("peymanID", pymnID);
        fd2.append("Year", year_pY1);
        fd2.append("Month", month_pY1);
        fd2.append("Type", Type);
        fd2.append("FK_Baste", FK_Baste);

        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                $("#loading-message").css("display", "none");
                fd = new FormData();
                if (resp1 == "True") {
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "اطلاعات با موفقیت ذخیره شد"
                    });
                    location.reload();


                } else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: resp1,
                    }).then(() => {
                        $("#loading-message").css("display", "none"); location.reload();

                    });


                }

            },
            error: function (resp1) {
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });
    }
</script>