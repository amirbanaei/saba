    <script>
     var obj = new FormData();

  $(".uploadSummery").click(function () {
    //FK_DDOfTitle = $(this).attr("id").split("_")[2];
    //ID = $(this).attr("id").split("_")[1];
      $("#summery_file5").click();
});

 $("#summery_file5").change(function (e) {
    $.each(e.target.files, function (index, file) {
        obj.append("MyExcelStream", file);

    });
         sendAjax2('@Url.Action("ImportExcel_AddSabtmarahel", "DefFacilitiesEquipment", new { area = "Contracts" })', obj);
 });


 function sendAjax2(url2, fd2) {
     //obj.append("Basteh", ID);




     $.ajax({
         url: url2,
         type: 'POST',
         data: fd2,
         processData: false,
         contentType: false,
         success: function (resp1) {
             console.log("okeye");
             console.log(resp1);
             $("#loading-message").css("display", "none");
             fd = new FormData();
             if (resp1 == "با موفقیت انجام شد") {
                 alert("با موفقیت ثبت شد");
                 setTimeout(function () {
                     location.reload(); // یا می‌توانید از location.reload(true) هم استفاده کنید
                 }, 2000); // بازه زمانی به میلی‌ثانیه، اینجا 2000 میلی‌ثانیه (یعنی 2 ثانیه)
             }
             else {
                 $("#loading-message").css("display", "none");
                 console.log("jlk;;kkj");
                 Toast.fire({

                     icon: 'success',
                     background: '#35434A',
                     color: 'white',
                     title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                 }).then(() => {
                     $("#loading-message").css("display", "none");
                 });
             }

         },
         error: function (resp1) {
             console.log(resp1);
             console.log("Nokeye");
             $("#loading-message").css("display", "none");
             Toast.fire({
                 icon: 'success',
                 background: '#35434A',
                 color: 'white',
                 title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
             }).then(() => {
                 $("#loading-message").css("display", "none");
             });
         }
     });
 }
    </script>


