                        // اجرای کد مربوط به انتخاب "تیرسان" در گروه دوم
                    equipment.Rent_or_fuel = true;

                }

                else {
                    equipment.Rent_or_fuel = false;

                }



                equipment.Count_InQardad = $("#Tedad_InQardad_" + i).val();
                let counterman = 0;
                for (var j = shomarande; j < shomarande + (Specs / (Count-1)); j++) {
                    console.log(j);
                    console.log(shomarande + (Specs / Count));
                    //var spec = $(".SpecData_" + i)[counterman];
                    var specif = new Object();
                    specif.FK_Spec_ID = $(".SpecData_" + i)[counterman].id.split('_')[1];
                    specif.SpcData = $(".SpecData_" + i)[counterman].value;
                    console.log(specif.SpcData);
                    console.log(specif.FK_Spec_ID);

                    Specifics.push(specif);
                    counterman++;
                }
                shomarande = shomarande+( Specs / Count);
                equipment.tbEquipmentSpecificationData = Specifics;
                equipments.push(equipment);

           }











            if (Specs >= 1) {
                $.ajax({
                    url: "@Url.Action("SaveSpecData", "DefFacilitiesEquipment")",
                    type: "post",
                    data: {equipments:equipments},
                    dataType:"html",
                    success: function (result) {
                        Toast.fire({
                            icon: 'success',
                            background: '#35434A',
                            color: 'white',
                            title: "داده ها با موفقیت ثبت شد"
                        }).then(() => {
                            location.reload();
                        });
                    }
                    , error: function () {
                        Toast.fire({
                            icon: 'warning',
                            background: '#35434A',
                            color: 'white',
                            title: "عملیات با خطا مواجه شده است"
                        }).then(() => {
                        });
                    }
                })
            }


        });
    </script>





