<div class="row">



    <div class="col-xl-6">
        <div class="row">
            <div class="col-xl-12">
                <label class="form-label"> پیمان ها </label>
                
                <select class="form-select " id="pROJESELECT">
                    <option value="0">انتخاب نمایید..</option>
                    @{
                        int? previousFK_pec_ID = null;


                    }
                    @foreach (var item in Model)
                    {
                        if (item.FK_PeymanContracts != previousFK_pec_ID)
                        {


                            <option value="@(item.FK_PeymanContracts)">@item.tbPeymanContracts.pec_Title</option>
                        }

                        previousFK_pec_ID = item.FK_PeymanContracts;

                    }

                </select>
            </div>
        </div>
    </div>
    <div class="col-xl-2">
        <div class="row">
            <div class="col-xl-12">
                <label class="form-label">سال</label>
                
            </div>
            <div class="col-xl-12">
                <select id="year_pY4" class="form-select">
                    <option value="0">انتخاب کنید</option>
                    @{
                        System.Globalization.PersianCalendar cs2 = new System.Globalization.PersianCalendar();
                        int currentYear = cs2.GetYear(DateTime.Now);

                        for (var i = 4; i >= 0; i--)
                        {
                            var s = DateTime.Now.AddYears(-i);

                            <option value="@cs2.GetYear(s)">@cs2.GetYear(s)</option>
                        }
                    }
                </select>

            </div>
        </div>
    </div>

    <div class="col-xl-3">
        <div class="row">
            <div class="col-xl-12">
                <label class="form-label">ماه</label>
                
            </div>
            <div class="col-xl-12">
                <select id="month_pY4" class="form-select">
                    <option value="0">انتخاب کنید  </option>

                    <option value="1">فروردین</option>
                    <option value="2">اردیبهشت</option>
                    <option value="3">خرداد</option>
                    <option value="4">تیر</option>
                    <option value="5">مرداد</option>
                    <option value="6">شهریور</option>
                    <option value="7">مهر</option>
                    <option value="8">آبان</option>
                    <option value="9">آذر</option>
                    <option value="10">دی</option>
                    <option value="11">بهمن</option>
                    <option value="12">اسفند</option>
                </select>
            </div>
        </div>
    </div>


</div>
