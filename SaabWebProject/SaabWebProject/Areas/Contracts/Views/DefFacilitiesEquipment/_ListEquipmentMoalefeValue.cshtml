                                        </div>

                                    </div>
                                </td>
                                <td>@counter</td>
                                <td id="pym">@item.tbEquipmentMoalefeValue.FirstOrDefault().tbEquipments.tbPeymanContracts.pec_Title</td>
                                <td>
                                    @item.tbEquipmentMoalefeValue.FirstOrDefault().tbEquipments.tbEquipmentBunch.tbEquipmentGroup.Eqpgrp_Name
                                </td>
                                @*<td id="from">@item.tbEquipmentMoalefeValue.FirstOrDefault().FromDate</td>*@
                                @*<td id="todata">@item.tbEquipmentMoalefeValue.FirstOrDefault().ToDate</td>*@
                                @*------------------------------------------------[1402/09/20]-|KH|-*@
                                <td cont-date1="dateS_@counter" hidden>@item.tbEquipmentMoalefeValue.FirstOrDefault().FromDate</td>
                                <td id="dateS_@counter"></td>
                                <td cont-date1="dateE_@counter" hidden>@item.tbEquipmentMoalefeValue.FirstOrDefault().ToDate</td>
                                <td id="dateE_@counter"></td>
                                @*-------------------------------------------------------------|KH|-*@



                                <td>@item.tbEquipmentMoalefeValue.FirstOrDefault().Year</td>
                                <td>@item.tbEquipmentMoalefeValue.FirstOrDefault().Month</td>
                                @if (item.File_SystemName != null)
                                {

                                    <td>
                                        <a target="_blank" href="~/Areas/Contracts/Contents/DefFacilitiesEquipment/UserUpload/@item.FileName">دانلود</a>
                                    </td>
                                }
                                else
                                {
                                    <td>پیوستی ثبت نشده </td>
                                }


                                @if (item.File_SystemNameForAccept != null)


                                {

                                    <td>
                                        <a class="btn form-control buttonGeneralW" target="_blank" href="~/Areas/Contracts/Contents/DefFacilitiesEquipment/UserUpload/@item.File_SystemNameForAccept" style="font-size:10px;margin-bottom:10px;">
                                            <i class="bi bi-download fa-fw me-1 VecGeneral"></i>
                                            <span class="bGeneral-text">دانلود اطلاعات ثبت شده</span>
                                        </a>
                                    </td>

                                }



                                else
                                {
                                    <td>
                                        <button class="btn form-control buttonGeneralPlus" onclick="downloadAjax2('@item.tbEquipmentMoalefeValue.FirstOrDefault().tbEquipments.tbPeymanContracts.pec_Title', '@item.tbEquipmentMoalefeValue.FirstOrDefault().FromDate', '@item.tbEquipmentMoalefeValue.FirstOrDefault().ToDate', '@item.ID','@item.tbEquipmentMoalefeValue.FirstOrDefault().tbEquipments.tbEquipmentBunch.tbEquipmentGroup.Eqpgrp_ID')"
                                                style="margin-left: 24px !important;">
                                            <i class="bi bi-download fa-fw me-1 VecGeneral"></i>
                                            @*<span class="bGeneral-text">دانلود اطلاعات ثبت شده</span>*@

                                        </button>
                                    </td>
                                }

                                @if (item.Final_Accept == true)
                                {

                                    <td>تایید کننده نهایی</td>
                                }
                                else if (item.For_Acceot == true)
                                {
                                    <td>تایید کننده </td>

                                }
                                else
                                {
                                    <td>ثبت کننده </td>

                                }



                                <td id="id5" style="display:none">@item.ID</td>
                                <td id="type" style="display:none">
                                    @item.tbEquipmentMoalefeValue.FirstOrDefault().tbEquipments.tbEquipmentBunch.tbEquipmentGroup.Eqpgrp_ID
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>

