<link href="~/MyStyles/MyStyle.css" rel="stylesheet" />

@model SaabWebProject.Models.DomainModels.tbCategories
<div class="row">
    @using (Html.BeginForm("_EditCategory", "Categories", FormMethod.Post))
    {
        <input type="hidden" value="@Model.Category_ID" name="Category_ID" />
        <div class="col-md-12">
            <label class="form-label">دسته</label>
            <input class="form-control" type="text" name="Category_Name" value="@Model.Category_Name" placeholder="عنوان دسته بندی را وارد کنید ..." />
        </div>
        <hr />
        <div class="row">
            <div class="col-xl-11"></div>
            <div class="col-xl-1">

                <button type="submit" class="btn form-control buttonsabt">
                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                    <span class="bSabt-text">ثبت</span>
                </button>
            </div>
        </div>

    }
</div>
