@model List<SaabWebProject.Models.DomainModels.tbCategories>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<select class="form-select " id="select_category" name="select_category">
    <option aria-selected="True" value="-1" selected>انتخاب مورد</option>
    @foreach (var item in Model.ToList())
    {
        <option value="@item.Category_ID" >@item.Category_Name</option>
    }
</select>
@section Scripts{
    <script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
    <script>
        $("#select_category").picker({ search: true });
    </script>
}
