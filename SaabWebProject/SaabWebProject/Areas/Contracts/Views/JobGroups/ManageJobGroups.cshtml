@{
    ViewBag.Title = "گروه شغلی";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
<link href="~/MyStyles/MyStyle.css" rel="stylesheet" />

<div class="tab-content">
    <div class="row" style="margin-bottom:20px">
        @*-------------------------------------------------[1402/08/11]-|KH|-*@
        <div class="col-xl-9"></div>
        <div class="col-xl-1">
            <a href="~/Content/ExcelFiles/JobGroups.xlsx" class="btn form-control buttonGeneral">
                <i class="VecGeneral bi bi-download  fa-fw me-1"></i>
                <span class="bGeneral-text">دانلود فایل اکسل نمونه</span>
            </a>
        </div>
        <div class="col-xl-1">
            <input name="MyExcelStream" type="file" style="display:none" />
            <a href="#" onclick="ShowDialogFile()" class="btn  form-control buttonGeneral">
                <i class="VecGeneral bi bi-upload  fa-fw me-1"></i>
                <span class="bGeneral-text">بارگذاری اطلاعات</span>

            </a>
        </div>
        @*--------------------------------------------------------------|KH|-*@
        <div class="col-xl-1">
            <a href="#" id="createJobGroupsButtonModal" class="btn  form-control buttonGeneral" data-bs-toggle="modal" data-bs-target="#modalLg1">
                <i class="VecGeneral fa fa-plus-circle fa-fw me-1"></i>
                <span class="bGeneral-text">گروه شغلی جدید</span>

            </a>
        </div>

    </div>

    <div class="row">
        <div class="" id="myTable"></div>
    </div>
</div>

<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Areas/Contracts/MyJs/Ajax.js"></script>

<script>
    $(function () {
        $("#myTable").load('@Url.Content("/JobGroups/_PartialListJobGroups")');
    });
    $("#createJobGroupsButtonModal").click(function () {
        $("#big_modal_body1").load('@Url.Content("/JobGroups/_PartialCreateJobGroups")');


    });
       $("#updateBaseJobGroupInformation").click(function () {
            $("#big_modal_body1").load('@Url.Content("/JobGroups/_PartialUpdateBaseJobGroupInformation")');
    });
</script>
@*-----------------------------------------------[1402/08/11]-|KH||-*@
<script>
      $("input[name='MyExcelStream']").change(function () {
        var file = this.files[0];
        var ext = file.name.split('.')[1];
        if (ext == "xlsx" || ext == "xls") {

            var  obj = new FormData();

            obj.append("MyExcelStream", file);

            console.log(file);
            $.ajax({
            beforeSend:function (){
                    document.getElementById("loading-circle").style.display = "block";
            },
               url: "@Url.Action("ImportExcel_AddJobGroups", "JobGroups", new { area = "Contracts" })",
               type: "post",
               contentType: false,
               data: obj,
               processData: false,
               cache: false,
               success: function (res) {
                   document.getElementById("loading-circle").style.display = "none";
                   Swal.fire({
                       icon: 'success',
                       background: 'rgb(29,40,52)',
                       color: 'white',
                       confirmButtonText: 'باشه',
                       title: 'آپلود اکسل',
                       text: res,
                   });

               },
               error: function (res) {
                   console.log(res);
               }
           });
        }
        else {

            Swal.fire({
                icon: 'warning',
                background: 'rgb(29,40,52)',
                color: 'white',
                confirmButtonText: 'باشه',
                title: 'نوع فایل',
                text: 'لطفا فایلی با پسوند اکسل وارد کنید',
            });
            return false;
        }

    });
    /// Open Dialog File
    function ShowDialogFile() {
        $("input[name='MyExcelStream']").val(null);
        $("input[name='MyExcelStream']").click();
    }
</script>
@*-------------------------------------------------------------|KH|-*@

