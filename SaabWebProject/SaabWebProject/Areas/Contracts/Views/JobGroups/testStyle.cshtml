    <script>
        let Count = 1;

        $("#GetInfo").click(function() {
            $.ajax({
                url: "@Url.Action("_GetInformationEquipmentGroup","DefFacilitiesEquipment")",
                success: function(result) {
                    $("#big_modal_body").html(result);
                }
            });
        });


        $(".picker").picker();
        const Toast = Swal.mixin({
            toast: true,
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });
        $(function () {


            $('#year_Eq').picker({ search: true });
            $('#month_Eq').picker({ search: true });

        });
    </script>

