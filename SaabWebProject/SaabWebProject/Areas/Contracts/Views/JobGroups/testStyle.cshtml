@{
    /**/

    ViewBag.Title = "گزارش";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .buttonGeneral1 {
        width: 40px;
        height: 40px;
        /*width: max-content;*/
        border-radius: 50%;
        background: linear-gradient(129deg, rgba(29,29,27,1) 0%, rgba(29,113,184,1) 53%, rgba(54,169,225,1) 100%);
        border: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0px 0px 20px rgba(0, 0, 0, 0.164);
        cursor: pointer;
        transition-duration: .5s;
        overflow: hidden;
        position: relative;
        margin-top: -4px;
    }

    .VecGeneral {
        transition-duration: .3s;
        margin: 10px;
        color: #fff;
        font-size: 15px;
        font-size: large;
    }

    .buttonGeneral1:hover {
        width: 160px;
        border-radius: 50px;
        transition-duration: .3s;
        align-items: center;
    }

        .buttonGeneral1:hover .VecGeneral {
            width: 50px;
            transition-duration: .3s;
            transform: translateY(240%);
        }

    .bGeneral-text {
        position: absolute;
        top: -20px;
        color: white;
        font-size: 2px;
    }

    .buttonGeneral1:hover .bGeneral-text {
        font-size: 13px;
        opacity: 1;
        transform: translateY(31px);
        transition-duration: .3s;
    }

    .buttonGeneral1:hover {
        transform: translateX(71%); /* #برای باز شدن به سمت راست*/
    }
    /*--------------*/
    .buttonsabt1 {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-image: linear-gradient(#46b8cd, #10635b);
        border: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0px 0px 20px rgba(0, 0, 0, 0.164);
        cursor: pointer;
        transition-duration: .3s;
        overflow: hidden;
        position: relative;
        /*border: 2px solid #ffffff7a;*/
        margin-top: -4px;
    }

    .VecGeneral {
        transition-duration: .3s;
        margin: 10px;
        color: #fff;
        font-size: 15px;
        font-size: large;
    }

    .buttonsabt1:hover {
        width: 160px;
        border-radius: 50px;
        transition-duration: .3s;
        align-items: center;
    }

        .buttonsabt1:hover .VecGeneral {
            width: 50px;
            transition-duration: .3s;
            transform: translateY(240%);
        }

    .bGeneral-text {
        position: absolute;
        top: -20px;
        color: white;
        font-size: 2px;
        opacity: 0;
        text-align: center;
        width: 100%;
    }

    .buttonsabt1:hover .bGeneral-text {
        font-size: 13px;
        opacity: 1;
        transform: translateY(31px);
        transition-duration: .3s;
    }

    .buttonsabt1:hover {
        transform: translateX(71%); /* #برای باز شدن به سمت راست*/
    }
    /*------------------------------*/
    .me-1 {
        margin-left: 10px !important;
        margin-top: 11px !important;
        width: 20px !important;
    }
</style>
