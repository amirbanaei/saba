    <script>
        $("#SaveData").click(function () {
            var Specs = $(".SpecData").length;

            var equipments = [];
            var specif = new Object();
            var shomarande = 0;
            debugger;
            for (var i = 1; i <= Count; i++) {
                var equipment = new Object();

                let Specifics = [];

                equipment.TotalPrice = $("#col_mablagh_" + i).val().replaceAll(",", "");;
                equipment.Unit = $("#vahed_" + i).val();
                equipment.UnitCount = $("#tedad_vahed_" + i).val();
                equipment.EachValue = $("#vahed_harozv_" + i).val().replaceAll(",", "");
                equipment.Users = $("#select_users_" + i).val().toString();;
                equipment.TypeTazmin = $("#TazminType_" + i).val();
                equipment.TazminPrice = $("#TazminMoney_" + i).val().replaceAll(",", "");
                equipment.ExpiredDate = $("#datepickerFromEn_Eq_" + i).val();
                equipment.FK_Bunch = $("#SelectBunch2").val();
                equipment.FK_Peyman = $("#select_peyman2").val();
                equipment.Count_InQardad = $("#Tedad_InQardad_" + i).val();
                let counterman = 0;
                for (var j = shomarande; j < shomarande + (Specs / Count); j++) {
                    //var spec = $(".SpecData_" + i)[counterman];
                    var specif = new Object();
                    specif.FK_Spec_ID = $(".SpecData_" + i)[counterman].id.split('_')[1];
                    specif.SpcData = $(".SpecData_" + i)[counterman].value;
                    Specifics.push(specif);
                    counterman++;
                }
                shomarande = shomarande+( Specs / Count);
                equipment.tbEquipmentSpecificationData = Specifics;
                equipments.push(equipment);

           }











            if (Specs >= 1) {
                $.ajax({
                    url: "@Url.Action("SaveSpecData", "DefFacilitiesEquipment")",
                    type: "post",
                    data: {equipments:equipments},
                    dataType:"html",
                    success: function (result) {
                        Toast.fire({
                            icon: 'success',
                            background: '#35434A',
                            color: 'white',
                            title: "داده ها با موفقیت ثبت شد"
                        }).then(() => {
                            location.reload();
                        });
                    }
                    , error: function () {
                        Toast.fire({
                            icon: 'warning',
                            background: '#35434A',
                            color: 'white',
                            title: "عملیات با خطا مواجه شده است"
                        }).then(() => {
                        });
                    }
                })
            }


        });
    </script>





