        $("#btn4").click(function () {


            var EqGroup = $("#select_EquipmentGroupForBunch1").val();
            var EqBunch = $("#SelectBunch").val();


            var CountSpec = $("#Count").val();
            if (CountSpec != 0) {

                var ListSpec = [];

                for (var i = 1; i <= CountSpec; i++) {
                    var Spec = $("#Spec_" + i).val();
                    if (Spec == null || Spec == "") {
                        Toast.fire({
                            icon: 'warning',
                            background: '#35434A',
                            color: 'white',
                            title: "اطلاعات فیلد" + i + "خالی می باشد"
                        });
                        return false;
                    }
                    else {
                        ListSpec.push(Spec);
                    }

                }

                if (ListSpec.length >= 1) {

                    $.ajax({
                        url: "@Url.Action("AddSpecification", "DefFacilitiesEquipment",new {area="Contracts"})",
                        type: "Post",
                        dataType: "html",
                        data: { ListSpec: ListSpec, FK_EqpGroup_ID: EqGroup, FK_EqpBunch_ID: EqBunch },
                        success: function (result) {
                            if (result == "True") {
                                Toast.fire({
                                    icon: 'success',
                                    background: '#35434A',
                                    color: 'white',
                                    title: "اطلاعات با موفقیت ثبت شد"
                                });
                            }
                        },
                        error: function (result) {
                            Toast.fire({
                                icon: 'warning',
                                background: '#35434A',
                                color: 'white',
                                title: "ثبت اطلاعات با خطا مواجه شد برای مشاهده خطا به کنسول مرورگر مراجعه کنید"
                            });
                            console.log(result);
                            return false;
                        }
                    })

                }


            }
            else {
                Toast.fire({
                    icon: 'warning',
                    background: '#35434A',
                    color: 'white',
                    title: "فیلدی برای ثبت وجود ندارد"
                });
                return false;
            }

        });


