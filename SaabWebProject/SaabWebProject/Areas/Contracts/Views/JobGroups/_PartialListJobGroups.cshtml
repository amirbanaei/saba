@{
    Layout = null;
}
@model IEnumerable<SaabWebProject.Models.DomainModels.tbContractJobGroup>

<style>
    .tableH_Lock {
        max-height: 523px;
        /*height: 523px;*/
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0px !important;
    }

    thead th {
        vertical-align: middle;
    }
</style>

<div class="card">

    <div class="table-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive tableH_Lock">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("فعالیت")
                            </th>
                            <th>
                                @Html.DisplayName("#")
                            </th>
                            <th>
                                @Html.DisplayName("سال")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter01-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("حق مسکن")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter02-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("حق اولاد")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("خوار و بار")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter04-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("شرح")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter05-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("وضعیت")
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        @{ int counter = 0;}
                        @foreach (var item in Model)
                        {
                            <tr class="task-list-row"
                                data-filter01="@item.jg_Year"
                                data-filter02="@item.jg_HagheMaskan.Replace(",", "")"
                                data-filter03="@item.jg_HagheOlad.Replace(",", "")"
                                data-filter04="@item.jg_KharoBar.Replace(",", "")"
                                data-filter05="@item.title">

                                <td>
                                    <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                        <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <div class="dropdown-menu">
                                            <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item edit" id="Edit_@item.jg_Year _@item.jg_ID">ویرایش</a>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @{counter = counter + 1;}

                                    <span>@counter</span>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.jg_Year)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.jg_HagheMaskan)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.jg_HagheOlad)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.jg_KharoBar)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.title)
                                </td>
                                <td>
                                    @if (item.isActive != false)
                                    {
                                        <i class="bi bi-check2-square" style="color:green;font-size:20px;"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check2-square" style="color:red;font-size:20px;"></i>
                                    }
                                </td>
                            </tr>
                        }


                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script>
    var
        filters = {
            filter01: null,
            filter02: null,
            filter03: null,
            filter04: null,
            filter05: null,
        };
    function updateFilters() {
        $('.task-list-row').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter(filterName) {
        filters[filterName] = this.value;
        updateFilters();
    }

    // Assigned User Dropdown Filter
    $('#filter01-filter').on('input', function () {
        changeFilter.call(this, 'filter01');
    });
    $('#filter02-filter').on('input', function () {
        changeFilter.call(this, 'filter02');
    });
    $('#filter03-filter').on('input', function () {
        changeFilter.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilter.call(this, 'filter04');
    });
    $('#filter05-filter').on('input', function () {
        changeFilter.call(this, 'filter05');
    });
</script>
<script>
    $(".edit").click(function () {
        var year = $(this).attr("id").split("_")[1];
        var id = $(this).attr("id").split("_")[2];
        $("#big_modal_body1").load('@Url.Content("/JobGroups/_PartialCreateJobGroups")?id='+id);
    });
</script>
