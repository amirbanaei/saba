<script>
    var map = L.map('map').setView([32.4279, 53.6880], 5);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    var provinceLayer = L.geoJSON().addTo(map);
    var cityLayer = L.geoJSON().addTo(map);
    var pointsLayer = L.layerGroup().addTo(map);

    function loadProvincePolygon(provinceName) {
        provinceLayer.clearLayers();
        cityLayer.clearLayers();
        pointsLayer.clearLayers();

        if (provinceName === "ایران") {
            map.setView([32.4279, 53.6880], 5);
            $('#shahr').empty().append('<option value="">انتخاب شهر</option>');
            return;
        }

        $.getJSON("/Areas/Contracts/Contents/Peymans/dataset_province.json", function (data) {
            var provinceFeature = data.features.find(f => f.properties.province_name === provinceName);

            if (provinceFeature) {
                provinceLayer.addData(provinceFeature).setStyle({
                    color: "#FF0000",
                    fillColor: "#edf90029",
                    fillOpacity: 0.3,
                    weight: 3
                });

                map.fitBounds(provinceLayer.getBounds());
                loadCities(provinceName);
                generateRandomPoints(provinceLayer.getBounds().getCenter());
            }
        });
    }

    function loadCities(provinceName) {
        $.getJSON("/Areas/Contracts/Contents/Peymans/dataset_county.json", function (data) {
            var cities = data.features.filter(f => f.properties.province_name === provinceName);

            var citySelect = $('#shahr');
            citySelect.empty().append('<option value="">انتخاب شهر</option>');
            cities.forEach(city => {
                citySelect.append(`<option value="${city.properties.county_name}">${city.properties.county_name}</option>`);
            });
        });
    }

    function loadCityPolygon(cityName) {
        cityLayer.clearLayers();

        $.getJSON("/Areas/Contracts/Contents/Peymans/dataset_county.json", function (data) {
            var cityFeature = data.features.find(f => f.properties.county_name === cityName);

            if (cityFeature) {
                cityLayer.addData(cityFeature).setStyle({
                    color: "#0a6960",
                    fillColor: "#00ff0029",
                    fillOpacity: 0.3,
                    weight: 3
                });
               map.fitBounds(cityLayer.getBounds());
            }
        });
    }

    function generateRandomPoints(center) {
        pointsLayer.clearLayers();

        for (var i = 0; i < 5; i++) {
            var latOffset = (Math.random() - 0.5) * 0.2;
            var lonOffset = (Math.random() - 0.5) * 0.2;

            var point = L.circleMarker([center.lat + latOffset, center.lng + lonOffset], {
                color: "#3399ff",
                fillColor: "#ffff00",
                fillOpacity: 0.8,
                radius: 8
            }).addTo(pointsLayer);
            animatePoint(point);
        }
    }

    function animatePoint(point) {
        var grow = true;
        setInterval(() => {
            var radius = point.getRadius();
            point.setRadius(grow ? radius + 2 : radius - 2);
            grow = !grow;
        }, 500);
    }

    $(function () {
        $('#ostan').change(function () {
            loadProvincePolygon($(this).val());
        });
        $('#shahr').change(function () {
            loadCityPolygon($(this).val());
        });
    });
</script>
