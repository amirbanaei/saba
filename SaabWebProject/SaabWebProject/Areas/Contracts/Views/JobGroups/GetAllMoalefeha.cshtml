@{
    Layout = null;
}
@model  List<SaabWebProject.Models.DomainModels.tbRelMoalefeJobGroup>

<div class="row">
    <div class="col-xl-3">
        <div class="form-group mb-3">
            <label class="form-label"> مولفه های دست مزدی </label>
        </div>
    </div>
</div>
@for (var i = 0; i < Model.Count(); i += 4)
{
    <div class="row">
        @{ if (Model.ElementAtOrDefault(i) != null)
            {
                <div class="col-xl-3">
                    <div class="form-group mb-3">
                        <label class="form-label"> @Model[i].tbContractMoalefeDastmozdi.md_Title </label>
                        <input class="form-control _moalefe" id="@Model[i].tbContractMoalefeDastmozdi.md_ID" value="@Model[i].rmg_Value" />
                    </div>
                </div>
            }
        }
        @{ if (Model.ElementAtOrDefault(i + 1) != null)
            {
                <div class="col-xl-3">
                    <div class="form-group mb-3">

                        <label class="form-label"> @Model[i + 1].tbContractMoalefeDastmozdi.md_Title </label>
                        <input class="form-control _moalefe" id="@Model[i + 1].tbContractMoalefeDastmozdi.md_ID" value="@Model[i + 1].rmg_Value" />
                    </div>
                </div>
            }
        }

        @{ if (Model.ElementAtOrDefault(i + 2) != null)
            {
                <div class="col-xl-3">
                    <div class="form-group mb-3">
                        <label class="form-label"> @Model[i + 2].tbContractMoalefeDastmozdi.md_Title </label>
                        <input class="form-control _moalefe" id="@Model[i + 2].tbContractMoalefeDastmozdi.md_ID" value="@Model[i + 2].rmg_Value" />
                    </div>
                </div>
            }
        }
        @{ if (Model.ElementAtOrDefault(i + 3) != null)
            {

                <div class="col-xl-3">
                    <div class="form-group mb-3">
                        <label class="form-label"> @Model[i + 3].tbContractMoalefeDastmozdi.md_Title </label>
                        <input class="form-control _moalefe" id="@Model[i + 3].tbContractMoalefeDastmozdi.md_ID" value="@Model[i + 3].rmg_Value" />
                    </div>
                </div>
            }
        }



    </div>

}




