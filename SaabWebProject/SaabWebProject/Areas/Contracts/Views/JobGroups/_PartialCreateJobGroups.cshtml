@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div id="formControls">

        <div class="card">
            <div class="card-body pb-2">
                <form>
                    <div class="row">
                        <div class="col-xl-2">
                            <div class="form-group mb-2">
                                <label class="form-label">سال</label>
                                <select class="form-select" id="Year">
                                    <option value="0">انتخاب کنید..</option>
                                    <option value="1400">1400</option>
                                    <option value="1401">1401</option>
                                    <option value="1402">1402</option>
                                    <option value="1403">1403</option>
                                    <option value="1404">1404</option>
                                    <option value="1405">1405</option>
                                    <option value="1406">1406</option>
                                    <option value="1407">1407</option>
                                    <option value="1408">1408</option>
                                    <option value="1409">1409</option>
                                    <option value="1410">1410</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div id="MyTable"></div>
                    <div class="row" style="margin-top:10px">
                        <div class="col-xl-11">
                        </div>
                        @*<div class="col-xl-1">
                            <button class="btn form-control buttonGeneral" id="printPageButton" onclick="window.print()">
                                <i class="fa fa-print fa-fw me-1 VecGeneral"></i>
                                <span class="bGeneral-text">پرینت</span>
                            </button>
                        </div>*@
                        <div class="col-xl-1">
                            <button id="savebtn" type="button" class="btn form-control buttonsabt">
                                <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                                <span class="bSabt-text">ثبت</span>
                            </button>
                        </div>
                    </div>

                </form>
            </div>
            <!-- arrow -->
            <div class="card-arrow">
                <div class="card-arrow-top-left"></div>
                <div class="card-arrow-top-right"></div>
                <div class="card-arrow-bottom-left"></div>
                <div class="card-arrow-bottom-right"></div>
            </div>
        </div>
    </div>
}




<script src="~/Scripts/sweetalert2.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script>

    $(function () {

        if ("@Model.jg_Year.HasValue" != "False") {
            $("#Year").val(@Model.jg_Year);
            $("#Year").attr("disabled", "disabled");

            $("#MyTable").load('@Url.Content("/JobGroups/_PartialUpdateJobGroups")?id=' +@Model.jg_ID);
        }
    });

    $("#Year").change(function () {

        $("#MyTable").load('@Url.Content("/JobGroups/_PartialUpdateJobGroups")?year=' + $(this).val());
    });

    $("#savebtn").click(function () {
        var Filters = new Object();

        var listvalues = [];
        $('.mytd').each(function (i, obj) {
            var value = new Object();
            value.GroupNumber = $(this).attr("id").split("_")[1];
            value.SanavatYear = $(this).attr("id").split("_")[2];
            if (value.SanavatYear == 0) {
                value.ValueMozdGroup = $(this).val();
            } else {
                value.ValueSanavat = $(this).val();
            }
            listvalues.push(value);
        });

        Filters.jg_HagheMaskan = $("#jg_HagheMaskan").val() ;
        Filters.jg_HagheOlad = $("#jg_HagheOlad").val();
        Filters.jg_KharoBar = $("#jg_KharoBar").val();
        Filters.jg_Year = $("#Year").val();
        /*------------------------------------------------[1402/08/11]-|KH|-*/
        Filters.title = $("#title").val();
        /*-------------------------------------------------------------|KH|-*/
       /* Filters.jg_Year = $("#Year").val();*//*--------------------------------*/
        Filters.tbContractJobGroupValues = listvalues;
        $("#loading-message").css("display", "block");
                       $.ajax({
                           url: '@Url.Action("SaveJobGroup", "JobGroups", new { area = "Contracts" })',
                           data: { Filters: Filters},
                            type: "Post",
                            dataType: "html",
                           success: function (resp) {
                               $("#loading-message").css("display", "none");
                               console.log(resp);
                               Toast.fire({
                                   icon: 'success',
                                   background: '#35434A',
                                   color: 'white',
                                   title: "گروه شغلی با موفقیت ثبت شد"
                               }).then(() => {
                                   location.reload();
                               });

                            },
                            error: function (resp) {
                                console.log(resp);
                                console.log("nashod");
                                Toast.fire({
                                    icon: 'success',
                                    background: '#35434A',
                                    color: 'white',
                                    title: "عملیات با خطا مواجه شده است"
                                }).then(() => {
                                });
                             $("#loading-message").css("display", "none");

                            }
                       });

    });
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });


</script>


