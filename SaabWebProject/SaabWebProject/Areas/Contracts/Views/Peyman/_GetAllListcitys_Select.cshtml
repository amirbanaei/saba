@model List<SaabWebProject.Models.DomainModels.tbpeymancities>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
@{
    Layout = null;
}

<select class="form-select select_peymancitys" id="select_peymancitys" name="select_peymancitys">
    <option  value="Select">انتخاب مورد</option>
    <option  value="0"> همه</option>

    @foreach (var item in Model.ToList())
    {
        <option value="@item.tbCities.ID">@item.tbCities.Name</option>
    }
</select>

<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>



<script>
    $(document).ready(function () {
        $("#select_peymancitys").picker({ search: true });

    });
</script>
