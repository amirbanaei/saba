@{Layout = null;}
@model List<SaabWebProject.Models.DomainModels.tbPeymanContracts>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />

<select class="form-select select_peyman" id="select_peyman1" name="select_peyman">
    <option value="Select" hidden>انتخاب کنید</option>
    @foreach (var item in Model.ToList())
    {
        <option value="@item.pec_ID">@item.pec_ContractNumber _ @item.pec_Title</option>
    }
</select>




<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
