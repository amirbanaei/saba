@{
    //   ViewBag.TitleLargModal = " پیمان ها جدید";
    Layout = null;
}
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
@model IEnumerable<SaabWebProject.Models.DomainModels.tbPeymanContracts>
<style>
    .tableH_Lock {
        max-height: 533px;
        /*height: 533px;*/
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0px !important;
    }

    thead th {
        vertical-align: middle;
    }
</style>
<div class="card">
    <div class="table-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive tableH_Lock">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("فعالیت")
                            </th>
                            <th>
                                @Html.DisplayName("#")
                            </th>
                            <th>
                                @Html.DisplayName("عنوان")
