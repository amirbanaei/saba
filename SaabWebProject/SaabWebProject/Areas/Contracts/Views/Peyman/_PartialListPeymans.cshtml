                                    <input type="text" id="filter01-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("خلاصه عنوان")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter02-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("شماره پیمان")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("کد پروژه")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter04-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("از تاریخ")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter05-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("تا تاریخ")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter06-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int counter = 0;}
                        @if (Model != null)
                        {

                            foreach (var item in Model)
                            {
                                <tr class="task-list-row "
                                    data-filter01="@Html.DisplayFor(modelItem => item.pec_Title)"
                                    data-filter02="@Html.DisplayFor(modelItem => item.pec_BriefTitle)"
                                    data-filter03="@Html.DisplayFor(modelItem => item.pec_ContractNumber)"
                                    data-filter04="@Html.DisplayFor(modelItem => item.pec_ProjectCode)"
                                    data-filter05="@Html.DisplayFor(modelItem => item.pec_ShmasiStartTime)"
                                    data-filter06="@Html.DisplayFor(modelItem => item.pec_ShmasiENDTime)">
                                    <td>
                                        <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                            <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <div class="dropdown-menu">
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item edit" id="Edit_@item.pec_ID">ویرایش</a>
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item Details" id="Detail_@item.pec_ID">جزئیات</a>
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item HadeEntezar" id="HadeEntezar_@item.pec_ID">تعیین حدود انتظار</a>
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item Pey2in" id="Pey2in_@item.pec_ID">مشاهده حدود انتظار</a>

                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item zaribHa" id="zaribHa_@item.pec_ID">مقادیر کادر ستادی پیمان </a>
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item Pey4in" id="Pey4in_@item.pec_ID">محدودیت ریالی</a>

                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item soratvaziatmafad" id="soratvaziatmafad_@item.pec_ID">مفاد صورت وضعیت</a>

                                                <a class="dropdown-item Delete" id="Delete_@item.pec_ID">غیر فعال</a>
                                                <a class="dropdown-item uploadSummery" id="uploadSummery_@item.pec_ID">
                                                    <span>آپلود پیمان امضا شده</span>
                                                </a>
                                                @if (item.pec_FileSystemName != null)
                                                {
                                                    <a class="dropdown-item details" id="" href="~/Areas/Contracts/Contents/Peymans/@item.pec_FileSystemName">مشاهده پبمان امضا شده</a>
                                                }
                                                <input id="inp_file" style="display:none" type="file" class="form-control" value="" />
                                                <input id="summery_file5" style="display:none" type="file" class="form-control" value="" />


                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{counter = counter + 1;}

                                        <span>@counter</span>
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.pec_Title)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.pec_BriefTitle)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.pec_ContractNumber)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.pec_ProjectCode)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.pec_ShmasiStartTime)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.pec_ShmasiENDTime)
                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>

<script>

    var
        filters = {
            filter01: null,
            filter02: null,
            filter03: null,
            filter04: null,
            filter05: null,
            filter06: null,
        };

    function updateFilters() {
        $('.task-list-row').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter(filterName) {
        filters[filterName] = this.value;
        updateFilters();
    }

    // Assigned User Dropdown Filter
    $('#filter01-filter').on('input', function () {
        changeFilter.call(this, 'filter01');
    });
    $('#filter02-filter').on('input', function () {
        changeFilter.call(this, 'filter02');
    });
    $('#filter03-filter').on('input', function () {
        changeFilter.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilter.call(this, 'filter04');
    });
    $('#filter05-filter').on('input', function () {
        changeFilter.call(this, 'filter05');
    });
    $('#filter06-filter').on('input', function () {
        changeFilter.call(this, 'filter06');
    });


</script>
