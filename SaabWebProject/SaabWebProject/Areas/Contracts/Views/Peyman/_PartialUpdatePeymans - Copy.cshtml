<script>
    var Filters = new Object();

    $(function () {

       $("#div_karfamayan").load('@Url.Content("/../Users/Company/_PartialListCompaniesInDropDown")',function(){
           $("#companies").attr("id", "karfarma");
           $("#karfarma").val(@Model.FK_KarfarmaID);
           $("#karfarma").attr("disabled","disabled");
       });
       $("#div_dastgah").load('@Url.Content("/../Users/Company/_PartialListCompaniesInDropDown")',function(){
           $("#companies").attr("id", "dastgah");
           $("#dastgah").val(@Model.FK_UserDastGahNezarati);
           $("#dastgah").attr("disabled","disabled");
       });
        $("#div_tarafeDovvom").load('@Url.Content("/../Users/Company/_PartialListCompaniesInDropDown")', function () {
            $("#companies").attr("id", "tarafeDovvom");
            $("#tarafeDovvom").val(@Model.FK_UserTarafDovvom);
            $("#tarafeDovvom").attr("disabled","disabled");
        });

       $("#PlaceOfRegister").load('@Url.Content("/../Users/Users/_Cities_Select")',function(){
           $("#cities").attr("id", "select_Cities");
           $('#select_Cities').attr("multiple", "multiple");
           $('#select_Cities').picker({ search: true });
           const selectElement = document.querySelector("#PlaceOfRegisterHid");
           for (const option of selectElement.options) {
               $('#select_Cities').picker('set', option.value)
           }
           $('#select_Cities').on('sp-change', function () { });
       });


        $("#pec_TypeOfContract").val('@Model.pec_TypeOfContract');
        $("#pec_StartTime_day").val(@Model.pec_StartTime_day);
        $("#pec_StartTime_month").val(@Model.pec_StartTime_month);
        $("#pec_ENDTime_year").val(@Model.pec_ENDTime_year);
        $("#pec_ENDTime_month").val(@Model.pec_ENDTime_month);
        $("#pec_ENDTime_day").val(@Model.pec_ENDTime_day);
        $("#pec_StartTime_year").val(@Model.pec_StartTime_year);


        $("#Price").change(function () {
            var a = 0;
            console.log(back_number_to_standard_format(@Model.pec_Price.ToString()));
            if ($("#IsLower").val() == -1)
                alert("ابتدا نوع الحاق را افزایش یا کاهش انتخاب نمایید ");
            else if ($("#IsLower").val() == "true") {
                console.log("kahesh")
                a = (parseInt(@Model.pec_Price.ToString().Replace(",","")) - parseFloat(back_number_to_standard_format($(this).val()))).toFixed();

            $("#pec_Price").val(FloatNumber_to_digited_format(a));
            $("#pec_Price").css("border", "1px solid #3cd2a5");
            $("#pec_Price").css("background-color", "rgb(116 205 178)");

            } else  {
                console.log("afzayesh");
                a = (parseInt(@Model.pec_Price.ToString().Replace(",","")) + parseFloat(back_number_to_standard_format($(this).val()))).toFixed();

            $("#pec_Price").val(FloatNumber_to_digited_format(a));
            $("#pec_Price").css("border", "1px solid #3cd2a5");
            $("#pec_Price").css("background-color", "rgb(116 205 178)");
            }



        });
    });
    $("#btnupdate").click(function () {

