    function sendAjax(url, data) {
        $("#loading-message").css("display", "block");
        $.ajax({
            url: url,
            data: { Filters: data },
            type: "Post",
            dataType: "html",
            success: function (resp) {

                $("#loading-message").css("display", "none");
                if (resp == "True") {
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "الحاقیه با موفقیت اعمال شد"
                    }).then(() => {
                        location.reload();

                    });
                } else {
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "عملیات با خطا مواجه شده است"
                    }).then(() => {
                    });
                }
            },
            error: function (resp) {
                console.log(resp);
                console.log("nashod");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "عملیات با خطا مواجه شده است"
                }).then(() => {
                });
                $("#loading-message").css("display", "none");

            }
        });

    }
