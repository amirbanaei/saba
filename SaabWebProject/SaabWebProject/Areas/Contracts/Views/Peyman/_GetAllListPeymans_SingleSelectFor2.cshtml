@{Layout = null;}
@model List<SaabWebProject.Models.DomainModels.tbReffrenceSave>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />

<select class="form-select select_peyman" id="baste_peymanofAccept" name="select_peyman">
    <option value="Select" hidden>انتخاب کنید</option>
    @foreach (var outerItem in Model)
    {
        <option value="@(outerItem.FK_PeymanID)_@(outerItem.tbReffrenceSaveLevel.OrderByDescending(innerItem => innerItem.ID).FirstOrDefault()?.ID)">
            ( @outerItem.tbPeymanContracts.pec_ContractNumber __ @outerItem.tbPeymanContracts.pec_Title ) -   نام بسته: @(outerItem.tbReffrenceSaveLevel.OrderByDescending(innerItem => innerItem.ID).FirstOrDefault()?.Title)
        </option>
    }

</select>




<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
