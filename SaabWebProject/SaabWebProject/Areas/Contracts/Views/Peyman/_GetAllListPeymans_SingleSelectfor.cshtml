@{Layout = null;}
@model List<SaabWebProject.Models.DomainModels.tbReffrenceSave>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />

<select class="form-select select_peyman" id="baste_peyman" name="select_peyman">
    <option value="0" hidden>انتخاب کنید</option>
    @foreach (var item in Model)
    {
        <option value="@item.FK_PeymanID">@item.tbPeymanContracts.pec_ContractNumber __ @item.tbPeymanContracts.pec_Title</option>
    }
</select>

<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script>
    $("#baste_peyman").picker({ search: false });
</script>




<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
