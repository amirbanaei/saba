<script>
    $(".numbers").keyup(function () {
        $(this).val(FloatNumber_to_digited_format($(this).val()));
    });
    function number_to_digited_format(input) {
        var amount = input.toString().replace(/[\D\s\._\-]+/g, "");
        amount = amount ? parseInt(amount, 10) : 0;
        return (amount === 0) ? "" : amount.toLocaleString("en-US");
    }
    function FloatNumber_to_digited_format(input) {
        if (input.toString().split(".").length == 2) {
            var amount = input.toString().split(".")[0].toString().replace(/[\D\s\._\-]+/g, "");
            amount = amount ? parseInt(amount, 10) : 0;
            return (amount === 0) ? "0." + input.toString().split(".")[1] : amount.toLocaleString("en-US") + "." + input.toString().split(".")[1];
        } else {
            var amount = input.toString().replace(/[\D\s\._\-]+/g, "");
            amount = amount ? parseInt(amount, 10) : 0;
            return (amount === 0) ? "" : amount.toLocaleString("en-US");

        }
    }
    function back_number_to_standard_format(input) {
        input = input.toString().replace(/,/g, "", "").replace("/", ".");

        return input;
    }
    $(".Count").change(function () {
        var id = $(this).attr("id").split("_")[1];
        $("#Price_" + id).val(FloatNumber_to_digited_format($(this).val() * back_number_to_standard_format($("#CountForPer_" + id).val())));
        calculate_total_price();

    });
    $(".PricePer").change(function () {
        var id = $(this).attr("id").split("_")[1];
        var num = (back_number_to_standard_format($(this).val()) * $("#Count_" + id).val());
        $("#Price_" + id).val(FloatNumber_to_digited_format(num));
        calculate_total_price();

    });
    function calculate_total_price() {
        var sum = 0;
        $('.TotalPriceForEveryUnit').each(function (item) {
            var id = $(this).attr("id");
            sum = parseFloat(sum) + parseFloat(back_number_to_standard_format($(this).val()));
        });

        var final = sum + parseFloat(back_number_to_standard_format( @Model.pec_Price));
        console.log(final);
        if (isNaN(final)) {
            final =  @Model.pec_Price;
        } else {
           final = number_to_digited_format(final)
        }
        console.log(final);
        $("#pec_Price").val(final);

    }
</script>