@{
    Layout = null;
}
@using SaabWebProject.Models.DomainModels;
@{
    SaabEntities db = new SaabEntities();
}



<style>
    .modal-dialog {
        max-width: 80% !important;
    }


    .modal2 {
        display: none;
        position: absolute; /* Change this from fixed */
        z-index: 1000; /* Adjust z-index as needed */
        left: 0;
        top: 0;
        width: 65%;
        height: auto;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
    }

    .modal-content2 {
        background-color: black;
        position: relative; /* Add relative positioning */
        /*  margin: 15% auto;*/
        padding: 20px;
        border: 4px solid aqua;
        border-radius: 30px;
        width: 100%;
        max-height: 100%;
        overflow-y: auto;
    }

    .modal3 {
        display: none;
        position: absolute; /* Change this from fixed */
        z-index: 1000; /* Adjust z-index as needed */
        left: 0;
        top: 0;
        width: 65%;
        height: auto;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
    }

    .modal-content3 {
        background-color: black;
        position: relative; /* Add relative positioning */
          margin: 65% auto;
        padding: 20px;
        border: 4px solid aqua;
        border-radius: 30px;
        width: 100%;
        max-height: 100%;
        overflow-y: auto;
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .fade-in {
        animation: fadeIn 1s ease-in-out; /* Adjust duration and timing function as needed */
    }
</style>

@model SaabWebProject.Models.DomainModels.tbPeymanContracts

@{
    var itemCount = 0;
}

@{
    string lastCityName = null; // متغیر کمکی برای ذخیره نام شهرستان قبلی
}
@{
    var yy = db.tblink_moalfe_city.Where(p => p.Fk_pymn == Model.pec_ID).GroupBy(o => o.Fk_City).ToList();
}
@foreach (var item2 in yy)

{
    foreach (var item in item2) { 

        if (item.tbCities.Name != lastCityName)
        {
            <div class="row mt-10px">
                <div class="col-xl-3">
                    <label class="form-label">نام شهرستان</label>
                    <input class="form-control" value="@item.tbCities.Name" />
                </div>
            </div>
            lastCityName = item.tbCities.Name; // بروزرسانی متغیر با نام شهرستان فعلی
        }

<div class="row">
    @foreach (var it in item.tblink_moalfe_city_valu)
    {
        <div class="col-xl-2">
            <label class="form-label">شماره صورت وضعیت</label>
            <input class="form-control" value="@it.number" />
        </div>
        <div class="col-xl-2">
            <label class="form-label">مقدار</label>
            <input class="form-control" value="@string.Format("{0:#,##0.##}", it.value)" />
        </div>

        <div class="col-xl-2">
            <label class="form-label">نام مولفه</label>
            <input class="form-control" value="@it.tblink_moalfe_city.tbContractMoalefeDastmozdi.md_Title" />
        </div>
        <div class="col-xl-1">
            <button class="click2 btn buttonGeneralPlus form-control" id="click_@it.ID">
                <i class="fa fa-pen VecGeneral"></i>
            </button>
        </div>
        <div class="col-xl-1">
            <button class="click3 btn buttonGeneralMins form-control" id="click_@it.ID">
                <i class="fa fa-trash VecGeneral"></i>
            </button>
        </div>
        {
            itemCount++;
            if (itemCount % 12 == 0)
            {
            @:</div> @* بستن دو div بعد از نمایش شش input *@
                @:<div class="row">
                }
            }
        }
    </div>
    <hr />
}}
<div id="myModal3" class="modal3" style="margin-left:25% !important;">
    <div class="modal-content3">
        <div class="row">
            <i class="close fa fa-window-close"></i>
        </div>

        <div id="ss2">

        </div>

    </div>
</div>


@section Scripts {
    <script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>
    <script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
    <script src="~/Scripts/popper.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
}

<script>
    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#myModal3").addClass("fade-in"); // Add the fade-in class
            $("#myModal3").css("display", "block");
        });

        $(".close").click(function () {
            $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
            $("#myModal3").css("display", "none");
        });

        $(window).click(function (event) {
            if (event.target == $("#myModal3")[0]) {
                $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
                $("#myModal3").css("display", "none");
            }
        });
    });</script>
