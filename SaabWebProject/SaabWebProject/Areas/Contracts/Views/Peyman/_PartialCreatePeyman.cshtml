<script>


    //----------------------------------------------------------------------------------------------------------
    var fd = new FormData();
    var Obj_fd = new Object();
    var i = 1;
    
    $(function () {
        // ------------------------------------------------[1402/10/20]-|KH|-
       $("#PlaceOfRegister").load('@Url.Content("/../Users/Users/_Cities_Select")',function(){
           $("#cities").attr("id", "select_Cities");
           $('#select_Cities').attr("multiple", "multiple");
           $('#select_Cities').picker({ search: true });
           $('#select_Cities').on('sp-change', function () {});
       });
       // -------------------------------------------------------------|KH|-
       $("#div_karfamayan" ).load('@Url.Content("/../Users/Company/_PartialListCompaniesInDropDown")',function(){
           $("#companies").attr("id", "karfarma");

       });
       $("#div_dastgah").load('@Url.Content("/../Users/Company/_PartialListCompaniesInDropDown")',function(){
            $("#companies").attr("id","dastgah");
       });
       $("#div_tarafeDovvom").load('@Url.Content("/../Users/Company/_PartialListCompaniesInDropDown")',function(){
            $("#companies").attr("id","tarafeDovvom");
       });

       $("#prices").load('@Url.Content("/../Contracts/Peyman/_SetPeymansPrice")', function () {
           $("#roww").attr("id", "roww_1");
           $("#minu").attr("id", "minu_1");
           $("#UnitTitle").attr("id", "UnitTitle_1");
           $("#Unit").attr("id", "Unit_1");
           $("#CountForPer").attr("id", "CountForPer_1");
           $("#Count").attr("id", "Count_1");
           $("#Price").attr("id", "Price_1");
           $("#NextRow").attr("id", "NextRow_" + (i + 1));
           $(".minus_class").on("click", function () {
               var id = $(this).attr("id").split("_")[1];
               $("#roww_" + id).remove();
               calculate_total_price();

           });
           $(".Count").change(function () {
               var id = $(this).attr("id").split("_")[1];
               $("#Price_" + id).val(FloatNumber_to_digited_format($(this).val() * back_number_to_standard_format($("#CountForPer_" + id).val())));
               calculate_total_price();

           });
           $(".PricePer").change(function () {
               var id = $(this).attr("id").split("_")[1];
               var num = (back_number_to_standard_format($(this).val()) * $("#Count_" + id).val());
               $("#Price_" + id).val(FloatNumber_to_digited_format(num));
               calculate_total_price();

           });




       });
    });

    function calculate_total_price(){
           var sum = 0;
           $('.TotalPriceForEveryUnit').each(function (item) {
               sum = parseFloat(sum) + parseFloat(back_number_to_standard_format($(this).val())) ;
           });
          // $("#pec_Price").val(parseFloat(FloatNumber_to_digited_format(sum)).toFixed(3));
               $("#pec_Price").val(number_to_digited_format(sum.toFixed()));

    }

        $("#Plus").click(function () {
            i++;
           $("#NextRow_" + i).load('@Url.Content("/../Contracts/Peyman/_SetPeymansPrice")', function () {
               $("#roww").attr("id", "roww_"+i);
               $("#minu").attr("id", "minu_"+i);
               $("#UnitTitle").attr("id", "UnitTitle_"+i);
               $("#Unit").attr("id", "Unit_"+i);
               $("#CountForPer").attr("id", "CountForPer_"+i);
               $("#Count").attr("id", "Count_"+i);
               $("#Price").attr("id", "Price_"+i);
               $("#NextRow").attr("id", "NextRow_" + (i + 1));
               $(".minus_class").on("click", function () {
                   var id = $(this).attr("id").split("_")[1];
                   $("#roww_" + id).remove();
                    calculate_total_price();
                });
               $(".Count").change(function () {
                   var id = $(this).attr("id").split("_")[1];
                   $("#Price_" + id).val(FloatNumber_to_digited_format(($(this).val() * back_number_to_standard_format($("#CountForPer_" + id).val()))));
                   calculate_total_price();
               });
               $(".PricePer").change(function () {
                   var id = $(this).attr("id").split("_")[1];
                   var num = (back_number_to_standard_format($(this).val()) * $("#Count_" + id).val());
                   $("#Price_" + id).val(FloatNumber_to_digited_format(num));
                    calculate_total_price();

               });
               calculate_total_price();

           });

        });

    $("#btn_file").click(function () {
        $("#inp_file").click();
    });

    $("#inp_file").change(function (e) {
                fd.append("id", 1);
                $.each(e.target.files, function (index, file) {
                    fd.append("files", file);
                });
     });

    $("#btnCreate").click(function () {
        if ($("#title").val().trim().length == 0) {
            alert("عنوان را وارد نمایید");
        } else if ($("#brieftitle").val() < 0) {
            alert("خلاصه عنوان را انتخاب نمایید");
        }else if ($("#karfarma").val() < 0) {
            alert("کارفرمارا انتخاب نمایید");
        } 
        else if ($("#pec_StartTime_day").val() == 0) {
            alert("روز شروع را وارد نمایید");
        }else if ($("#pec_StartTime_month").val() == 0) {
            alert("ماه شروع را وارد نمایید");
        }else if ($("#pec_StartTime_year").val() == 0) {
            alert("سال شروع را وارد نمایید");
        } else if ($("#pec_ENDTime_year").val().trim().length == 0) {
            alert("سال پایان را انخاب کنید");
        } else if ($("#pec_ENDTime_month").val().trim().length == 0) {
            alert("ماه پایان را انخاب کنید");
        } else if ($("#pec_ENDTime_day").val().trim().length == 0) {
            alert("روز پایان را انخاب کنید");
        } else if ($("#pec_ContractNumber").val()[1] == undefined) {
            alert("شماره قرارداد را وارد نمایید");
        } else if ($("#pec_ProjectCode").val().trim().length == 0) {
            alert("کد پروژه را وارد نمایید");
        } else {
            let barArray = [];
            var counter = 0 ;
            var flag = true;
            $('.prices_row_class').each(function (i, obj) {
                counter++;
                var id = $(this).attr("id").split("_")[1];
                var obj = new Object();
                if($("#UnitTitle_" + id).val().trim().length == 0){
                   alert("عنوان سطر " + counter + "را وارد نمایید");
                       flag = false;

                }else if($("#Unit_" + id).val().trim().length == 0){
                   alert("واحد سطر " + counter + "را وارد نمایید");
                     flag = false;
                }else if($("#CountForPer_" + id).val().trim().length == 0){
                   alert("نرخ واحد سطر " + counter + "را وارد نمایید");
                     flag = false;

                }else if($("#Count_" + id).val().trim().length == 0){
                   alert("تعداد سطر " + counter + "را وارد نمایید");
                     flag = false;
    }

                obj.UnitTitle = $("#UnitTitle_" + id).val();
                obj.Unit = $("#Unit_" + id).val();
                obj.CountForPer = $("#CountForPer_" + id).val();
                obj.Count = $("#Count_" + id).val();
                obj.Price = $("#Price_" + id).val();

                barArray.push(obj);
            });
           if(flag == false){
              return false;
            }
            // ------------------------------------------------[1402/10/20]-|KH|-
            console.log($("#select_Cities").val())
            var CitiesArr = [];
            $.each($("#select_Cities").val().toString().split(","), function (index, item) {
                if (item !== "") {
                    var citise_obj = new Object();
                    var peyman_obj = new Object();
                    if (item != 0) {
                        citise_obj.FK_City = item;
                        CitiesArr.push(citise_obj);
                        console.log(item);
                        console.log(CitiesArr)
                    }
                }
            });
            // -------------------------------------------------------------|KH|-
            var obj_fd = new FormData();

            Obj_fd.pec_Title =  $("#title").val();
            Obj_fd.pec_TypeOfContract = $("#pec_TypeOfContract").val();
            Obj_fd.pec_Price =  $("#pec_Price").val();
            Obj_fd.FK_KarfarmaID = $("#karfarma").val();
            Obj_fd.pec_StartTime_day = $("#pec_StartTime_day").val();
            Obj_fd.pec_StartTime_month= $("#pec_StartTime_month").val();
            Obj_fd.pec_StartTime_year= $("#pec_StartTime_year").val();
            Obj_fd.pec_ENDTime_day= $("#pec_ENDTime_day").val();
            Obj_fd.pec_ENDTime_month= $("#pec_ENDTime_month").val();
            Obj_fd.pec_ENDTime_year= $("#pec_ENDTime_year").val();
            Obj_fd.pec_ContractNumber= $("#pec_ContractNumber").val();
            Obj_fd.pec_ProjectCode = $("#pec_ProjectCode").val();
            Obj_fd.FK_UserTarafDovvom =$("#tarafeDovvom").val();
            Obj_fd.FK_UserDastGahNezarati = $("#dastgah").val();
            Obj_fd.tbPeymanContractPrice = barArray;
            // ------------------------------------------------[1402/10/21]-|KH|-
            Obj_fd.tbpeymancities = CitiesArr;
            // -------------------------------------------------------------|KH|-
            Obj_fd.pec_BriefTitle = $("#brieftitle").val();
            console.log($("#brieftitle").val());
            console.log(Obj_fd);
            console.log(Obj_fd.tbpeymancities);
            sendAjax('@Url.Action("Peyman_Create","Peyman",new { area = "Contracts" })', Obj_fd,'@Url.Action("Peyman_UploadFile", "Peyman",new { area = "Contracts" })',fd)
        }
    });
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
    function sendAjax(url, fd1,url2,fd2) {
            $("#loading-message").css("display", "block");
            $.ajax({
                url: url,
                data: { Filters: fd1 },
                type: "Post",
                dataType: "html",
                           success: function (resp) {
                               if (resp != "0") {
                                   fd2.append("PeymanID", resp);
                                   $.ajax({
                                       url: url2,
                                       type: 'POST',
                                       data: fd2,
                                       processData: false,
                                       contentType: false,
                                       success: function (resp1) {
                                           $("#loading-message").css("display", "none");

                                           if (resp1 == "True") {
                                               Toast.fire({
                                                   icon: 'success',
                                                   background: '#35434A',
                                                   color: 'white',
                                                   title: "اطلاعات با موفقیت ثبت  شد"
                                               }).then(() => {
                                                   location.reload();
                                               });
                                           } else {
                                               $("#loading-message").css("display", "none");
                                               Toast.fire({
                                                   icon: 'warning',
                                                   background: '#35434A',
                                                   color: 'white',
                                                   title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                                               }).then(() => {
                                                   $("#loading-message").css("display", "none");
                                               });


                                           }

                                       },
                                       error: function (resp1) {
                                           $("#loading-message").css("display", "none");
                                           Toast.fire({
                                               icon: 'warning',
                                               background: '#35434A',
                                               color: 'white',
                                               title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                                           }).then(() => {
                                               $("#loading-message").css("display", "none");
                                           });
                                       }
                                   });

                               } else {
                                   $("#loading-message").css("display", "none");

                                   Toast.fire({
                                       icon: 'warning',
                                       background: '#35434A',
                                       color: 'white',
                                       title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                                   }).then(() => {
                                       $("#loading-message").css("display", "none");
                                   });

                               }

                            },
                            error: function (resp2) {
                                Toast.fire({
                                    icon: 'warning',
                                    background: '#35434A',
                                    color: 'white',
                                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                                }).then(() => {
                                    $("#loading-message").css("display", "none");
                                });


                            }
                       });

    }

    $.fn.digits = function () {
        return this.each(function () {
            var a = $(this).val().toString().replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1,");
            $(this).val(a.toString());

        })
    }

    function back_number_to_standard_format(input) {
      input = input.toString().replace(/,/g,"", "").replace("/",".");
      return input;
    }

    $(".numbers").keyup(function () {
       $(this).val(FloatNumber_to_digited_format($(this).val()));
    });

    function number_to_digited_format(input){
         var amount = input.toString().replace(/[\D\s\._\-]+/g, "");
         amount = amount ? parseInt(amount, 10) : 0;
         return ( amount === 0 ) ? "" : amount.toLocaleString("en-US");
    }

   function FloatNumber_to_digited_format(input){
         if(input.toString().split(".").length == 2){
             var amount = input.toString().split(".")[0].toString().replace(/[\D\s\._\-]+/g, "");
             amount = amount ? parseInt(amount, 10) : 0;
             return ( amount === 0 ) ? "0."+input.toString().split(".")[1] : amount.toLocaleString("en-US")+"."+input.toString().split(".")[1];
          }else{
             var amount = input.toString().replace(/[\D\s\._\-]+/g, "");
             amount = amount ? parseInt(amount, 10) : 0;
             return ( amount === 0 ) ? "" : amount.toLocaleString("en-US");

          }
    }
</script>


