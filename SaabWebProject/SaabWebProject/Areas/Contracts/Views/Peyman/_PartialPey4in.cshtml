@using SaabWebProject.Models.DomainModels;


@{
    Layout = null;
            SaabEntities db = new SaabEntities();

}
@{ 
    float a = 0;
    float b = 0;
    float c = 0;
    float d = 0;
    float x = 0;

    var find = db.tbRial_restrictions_pymn.Where(p => p.Fk_pymn == Model.pec_ID).FirstOrDefault();
    if(find != null)
    {
        a =(float) find.restrictions_A;
        b = (float)find.restrictions_B;
        c = (float)find.restrictions_C;
        d = (float)find.restrictions_D;
        x = (float)find.mahdodatmogym_B;

    }
}
<style>
    .modal-dialog {
        max-width: 80% !important;
    }
</style>
@model SaabWebProject.Models.DomainModels.tbPeymanContracts

<div class="card" style="margin-top:10px;">
    <div class="card-body">
        <div class="row">
            <div class="col-xl-3">
                <label class="form-label">محدودیت A (ریال)</label>
                <input class="form-control" id="MahdudiyatA" value="@a" />
            </div>
            <div class="col-xl-3">
                <label class="form-label">محدودیت B (ریال)</label>
                <input class="form-control" id="MahdudiyatB" value="@b" />
            </div>
            <div class="col-xl-3">
                <label class="form-label">محدودیت C (ریال)</label>
                <input class="form-control" id="MahdudiyatC" value="@c" />
            </div>
            <div class="col-xl-3">
                <label class="form-label">محدودیت D (ریال)</label>
                <input class="form-control" id="MahdudiyatD" value="@d" />
            </div>
            <div class="col-xl-3">
                <label class="form-label">محدودیت های نماینده های </label>
                <input class="form-control" id="MahdudiyatX" value="@x" />
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-xl-11">

            </div>
            <div class="col-xl-1">
                <button class="btn form-control buttonsabt" id="btn41">
                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                    <span class="bSabt-text">ثبت</span>
                </button>
            </div>
        </div>
    </div>

    <!-- arrow -->
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Scripts/popper.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script>
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
    function sendAjaxABCD(url2, fd2) {

        fd2.append("restrictions_A", $("#MahdudiyatA").val());
        fd2.append("restrictions_B", $("#MahdudiyatB").val());
        fd2.append("restrictions_C", $("#MahdudiyatC").val());
        fd2.append("restrictions_D", $("#MahdudiyatD").val());
        fd2.append("mahdodatmogym_B", $("#MahdudiyatX").val());

        fd2.append("Fk_pymn",@Model.pec_ID);

        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                console.log("okeye");
                $("#loading-message").css("display", "none");
                fd = new FormData();
                if (resp1 == "True") {
                    console.log("dfjsdf");
                    alert("با موفقیت ثبت شد");
                    location.reload();
                }
                else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });
                }

            },
            error: function (resp1) {
                console.log(resp1);
                console.log("Nokeye");
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });
    }
</script>
<script>
        var fdd = new FormData();
        //----------------------------------------------------------------
    $("#btn41").click(function () { 

            if       ($("#MahdudiyatA").val() == '') {
                alert("لطفا محدودیت A را وارد کنید");
            }
            else if ($("#MahdudiyatB").val() == '') {
                alert("لطفا محدودیت B را وارد کنید");
            }
            else if ($("#MahdudiyatC").val() == '') {
                alert("لطفا محدودیت C را وارد کنید");
            }
            else if ($("#MahdudiyatD").val() == '') {
                alert("لطفا محدودیت D را وارد کنید");
            }
           else {
                sendAjaxABCD('@Url.Action("UploadRestrictions_ABCD", "Peyman", new { area = "Contracts" })', fdd);
           };
    });

</script>
