            </div>


            @*<div class="col-xl-3">
                <label class="form-label">شماره صورت وضعیت </label>
                <input class="form-control" id="numbersorat" />
            </div>*@
        </div>
        <div class="row">
            <div class="col-xl-11">

            </div>
            <div class="col-xl-1">
                <button class="btn form-control buttonsabt" id="btnBarrasi">
                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                    <span class="bSabt-text">بررسی</span>
                </button>
            </div>
        </div>

        <hr />

        <div>
            <div class="ROW" id="div_table" style="display:block;">

            </div>

        </div>
    </div>

    <!-- arrow -->
