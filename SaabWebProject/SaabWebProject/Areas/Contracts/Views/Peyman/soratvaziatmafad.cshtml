    $("#btn41").click(function () {

            if       ($("#MahdudiyatA").val() == '') {
                alert("لطفا محدودیت A را وارد کنید");
            }
            else if ($("#MahdudiyatB").val() == '') {
                alert("لطفا محدودیت B را وارد کنید");
            }
            else if ($("#MahdudiyatC").val() == '') {
                alert("لطفا محدودیت C را وارد کنید");
            }
            else if ($("#MahdudiyatD").val() == '') {
                alert("لطفا محدودیت D را وارد کنید");
            }
           else {
                sendAjaxABCD('@Url.Action("UploadRestrictions_ABCD", "Peyman", new { area = "Contracts" })', fdd);
           };
    });

</script>
