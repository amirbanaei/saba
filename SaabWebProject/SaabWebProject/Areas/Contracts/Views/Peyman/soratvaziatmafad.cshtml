</div>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Scripts/popper.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script>
    $("#btnBarrasi").click(function () {
        getlist()
    });
    $("#month").change(function () {
        $("#div_table").css("display", "block")
    });
      function getlist() {
          $("#loading-message").css("display", "block");

     $("#div_table").load('@Url.Content("/../Contracts/Peyman/barrsiview")', {
         id: @Model.pec_ID, numbersorat: $("#numbersorat").val(), mostrak: $("#moshtarkenjari").val(), beme: $("#bemeh").val(), hosin: $("#hosn").val(),jari: $("#jari").val()
     }, function () {
          $("#loading-message").css("display", "none");

             //بارگذاری فایل مدرک
             $(".UploadAttachment").click(function () {
                 FK_DDOfTitle = $(this).attr("id").split("_")[2];
                 ID = $(this).attr("id").split("_")[1];
                 $("#inp_file").click();
             });

              $("#inp_file").change(function (e) {
                 $.each(e.target.files, function (index, file) {
                    fd.append("files", file);
                 });
                 sendAjax1('@Url.Action("UploadAttachmentFile", "RegistrationDocument",new { area = "Contracts" })', fd);
              });
             //دریافت نمونه اکسل خلاصه مدرک
             $(".DownloadSummery").click(function () {
                 downloadAjax();
             });
             //بارگذاری خلاصه مدرک
              $(".uploadSummery").click(function () {
                 FK_DDOfTitle = $(this).attr("id").split("_")[2];
                 ID = $(this).attr("id").split("_")[1];
                 $("#summery_file").click();
             });

              $("#summery_file").change(function (e) {
                 $.each(e.target.files, function (index, file) {
                    fd.append("files", file);
                 });
                 sendAjax2('@Url.Action("UploadSummaryFile", "RegistrationDocument",new { area = "Contracts" })', fd);
              });
          });
  }

</script>
<script>
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
    function sendAjaxABCD(url2, fd2) {

        fd2.append("restrictions_A", $("#MahdudiyatA").val());
        fd2.append("restrictions_B", $("#MahdudiyatB").val());
        fd2.append("restrictions_C", $("#MahdudiyatC").val());
        fd2.append("restrictions_D", $("#MahdudiyatD").val());
        fd2.append("Fk_pymn",@Model.pec_ID);

        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                console.log("okeye");
                $("#loading-message").css("display", "none");
                fd = new FormData();
                if (resp1 == "True") {
                    console.log("dfjsdf");
                    alert("با موفقیت ثبت شد");
                    location.reload();
                }
                else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });
                }

            },
            error: function (resp1) {
                console.log(resp1);
                console.log("Nokeye");
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });
    }
</script>
<script>
        var fdd = new FormData();
