<script>
    function sabtgozareshh(month, year, vaziatt, fkpymn, fkcity, usr) {
        console.log(vaziatt)
        console.log(fkpymn)
        console.log(fkcity)
        console.log(usr)

    $.ajax({
        url: '@Url.Action("viewadetailcontroll", "RegistrationAndConfirmationProcedures")',
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ month: month, year: year, vaziatt: vaziatt, fkpymn: fkpymn, fkcity: fkcity, Usr: usr }),
        success: function (response) {
            $("#big_modal_body1").html(response);
        },
        error: function (xhr, status, error) {
            console.log("Error: " + error);
        }
    });
}

</script>