<script>

 function viewfilter(event, id, month, year, person) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }

    // نمایش لودینگ
    $("#loading-circle .loadingText1").text("لطفا منتظر نمایش اطلاعات بمانید ...");
    $("#loading-circle").css("display", "flex");
    document.getElementById("loading-message").style.display = "block";

    // افکت fade-in و نمایش مدال
    $("#myModal2").addClass("fade-in").css("display", "block");

    // لود کردن محتوا داخل مدال با پارامترها
    $("#ss").load(
        '@Url.Content("/Salaries/Moalefe/viewsabttaeedbyfilterdetail")',
        { id: id, month: month, year: year, person: person },
        function () {
            // این قسمت بعد از کامل شدن لود اجرا می‌شود
            document.getElementById("loading-message").style.display = "none";
            $("#loading-circle").css("display", "none");
        }
    );
}

</script>
<script>
    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#myModal2").addClass("fade-in"); // Add the fade-in class
            $("#myModal2").css("display", "block");
        });

        $(".close").click(function () {
            $("#myModal2").removeClass("fade-in"); // Remove the fade-in class
            $("#myModal2").css("display", "none");
        });

        $(window).click(function (event) {
            if (event.target == $("#myModal2")[0]) {
                $("#myModal2").removeClass("fade-in"); // Remove the fade-in class
                $("#myModal2").css("display", "none");
            }
        });
    });</script>
