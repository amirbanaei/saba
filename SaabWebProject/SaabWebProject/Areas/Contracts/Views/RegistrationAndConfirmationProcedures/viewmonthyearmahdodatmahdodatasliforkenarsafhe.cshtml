    $(document).ready(function () {
        function formatNumberWithCommas(number) {
            return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        function removeCommas(number) {
            return number.replace(/,/g, '');
        }

        // بررسی ورودی هنگام تایپ
        $("input.form-technololghhhh").on('input', function () {
            let $input = $(this);
            let value = removeCommas($input.val());
            let maxAllowed = parseFloat($input.data("delay")); // مقدار حداکثر
            let bindValue = parseFloat($input.data("bind")); // مقدار اولیه محدودیت
            let backdropKey = $input.data("backdrop"); // شناسه گروه
            let inputsInGroup = $(`input.form-technololghhhh[data-backdrop="${backdropKey}"]`);
            console.log("maxAllowed" + maxAllowed);
            // اطمینان از عددی بودن مقدار
            if ($.isNumeric(value)) {
                value = parseFloat(value);
                console.log("value" + value);
                console.log("bindValue" + bindValue);

                // بررسی اینکه مقدار از مقدار `data-bind` بیشتر نباشد
                if (value > bindValue) {
                    console.log("bindValue2" + bindValue);

                    Swal.fire({
                        icon: 'error',
                        title: 'خطا',
                        text: `مقدار وارد شده نباید از ${formatNumberWithCommas(bindValue)} بیشتر باشد.`,
                        confirmButtonText: 'باشه'
                    });
                    $input.val(formatNumberWithCommas(0)); // مقدار را به مقدار `data-bind` برگردانید
                    return; // متوقف کردن پردازش بیشتر
                }

                // محاسبه میانگین برای گروه
                let total = 0;
                let count = 0;
                inputsInGroup.each(function () {
                    let groupValue = removeCommas($(this).val());
                    if ($.isNumeric(groupValue)) {
                        total += parseFloat(groupValue);
                        count++;
                    }
                });

                let average = count > 0 ? (total / count).toFixed(2) : 0;
                console.log("avra" + average);
                console.log("total" + total);
                console.log("count" + count);

                // بررسی اینکه مقدار از میانگین یا `maxAllowed` بیشتر نباشد
                if (average > maxAllowed) {
                    console.log("maxAllowed2" + maxAllowed);
                    console.log("maxAllowed3" + average);
                    let valuee = average - maxAllowed;
                    valuee = valuee * count;
                    value = (value - valuee).toFixed(2);
                    let limit = Math.min(maxAllowed, average); // حد مجاز
                    Swal.fire({
                        icon: 'error',
                        title: 'خطا',
                        text: `مقدار وارد شده نباید از ${formatNumberWithCommas(value)} بیشتر باشد.`,
                        confirmButtonText: 'باشه'
                    });
                    $input.val(formatNumberWithCommas(0)); // مقدار را به حد مجاز برگردانید
                } else {
                    $input.val(formatNumberWithCommas(value)); // فرمت با کاما اعمال شود
                }

                // مقادیر خالی را به 0 تغییر دهید
                inputsInGroup.each(function () {
                    let groupValue = removeCommas($(this).val());
                    if (!$.isNumeric(groupValue) || groupValue === "") {
                        $(this).val(formatNumberWithCommas(0));
                    }
                });

                // به روز رسانی همه اعضای گروه
                inputsInGroup.each(function () {
                    $(this).data("average", average); // ذخیره میانگین در داده
                });
            }
        });


        // اعمال فرمت اولیه
        $("input.form-technololghhhh").each(function () {
            let value = $(this).val();
            if ($.isNumeric(value)) {
                $(this).val(formatNumberWithCommas(value)); // فرمت با کاما
            }
        });
    });

