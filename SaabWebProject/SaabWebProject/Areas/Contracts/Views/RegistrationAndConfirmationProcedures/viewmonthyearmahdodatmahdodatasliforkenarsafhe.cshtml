    function changeFilter41432() {
        const mainTableRows = document.querySelectorAll('#mainTable tbody tr');
        const secondaryTableRows = document.querySelectorAll('#secondaryTable tbody tr');

        const dataMap = {}; // نگهداری داده‌ها بر اساس IDBasteh
        const totalStats = {
            totalDelay: 0,
            totalValueFromInput: 0,
            maxFromInput: 0,
            count: 0
        };

        mainTableRows.forEach(row => {
            const computedStyle = window.getComputedStyle(row);
            if (computedStyle.display === 'none') return;

            const input = row.querySelector('input');
            if (!input) return;

            const idTackBasteh = input.dataset.keyboard;
            const delayValue = parseFloat(input.dataset.delay);
            const valueFromInput = parseFloat(removeCommas(input.value));

            if (isNaN(delayValue) || isNaN(valueFromInput)) return;

            // ذخیره مقادیر کلی
            totalStats.totalDelay += delayValue;
            totalStats.totalValueFromInput += valueFromInput;
            totalStats.count++;

            if (valueFromInput > totalStats.maxFromInput) {
                totalStats.maxFromInput = valueFromInput;
            }

            // ذخیره مقادیر به تفکیک IDBasteh
            if (!dataMap[idTackBasteh]) {
                dataMap[idTackBasteh] = {
                    totalDelay: 0,
                    count: 0,
                    valueFromInput: 0,
                    maxFromInput: 0
                };
            }

            dataMap[idTackBasteh].totalDelay += delayValue;
            dataMap[idTackBasteh].valueFromInput += valueFromInput;
            dataMap[idTackBasteh].count++;

            if (valueFromInput > dataMap[idTackBasteh].maxFromInput) {
                dataMap[idTackBasteh].maxFromInput = valueFromInput;
            }
        });

        // به‌روزرسانی جدول دوم
        secondaryTableRows.forEach(row => {
            const idBasteh = row.querySelector('[data-container]')?.dataset.container;
            if (!idBasteh) return;

            if (dataMap[idBasteh]) {
                const avgValue = dataMap[idBasteh].totalDelay / dataMap[idBasteh].count;
                const avgValue2 = dataMap[idBasteh].valueFromInput / dataMap[idBasteh].count;
                const maxValueFromInput = dataMap[idBasteh].maxFromInput;

                row.querySelector('#sabtshodeh').textContent = formatNumberWithCommas(avgValue.toFixed(0));
                row.querySelector('#taeedshodeh').textContent = formatNumberWithCommas(avgValue2.toFixed(2));
                row.querySelector('#maxtaeedshodeh').textContent = formatNumberWithCommas(maxValueFromInput.toFixed(0));
            } else {
                row.querySelector('#sabtshodeh').textContent = 0;
                row.querySelector('#taeedshodeh').textContent = 0;
                row.querySelector('#maxtaeedshodeh').textContent = 0;
            }
        });
        console.log(totalStats.count);

        // اضافه کردن یک سطر کلی به جدول دوم
        if (totalStats.count > 0) {
            const overallAvgValue = totalStats.totalDelay / totalStats.count;
            const overallAvgValue2 = totalStats.totalValueFromInput / totalStats.count;
            const overallMaxValue = totalStats.maxFromInput;
            console.log(overallAvgValue);
            console.log(overallMaxValue);
            console.log(overallAvgValue2);

            let totalRow = document.querySelector('#secondaryTable tfoot #totalRow');
            if (!totalRow) {
                const tfoot = document.querySelector('#secondaryTable tfoot') || document.createElement('tfoot');
                totalRow = document.createElement('tr');
                totalRow.id = "totalRow";
                totalRow.innerHTML = `
             <td>براساس فیلتر</td>
             <td id="total_sabtshodeh"></td>
             <td id="total_taeedshodeh"></td>
             <td id="total_maxtaeedshodeh"></td>
         `;
                tfoot.appendChild(totalRow);
                document.querySelector('#secondaryTable').appendChild(tfoot);
            }

            document.querySelector('#total_sabtshodeh').textContent = formatNumberWithCommas(overallAvgValue.toFixed(0));
            document.querySelector('#total_taeedshodeh').textContent = formatNumberWithCommas(overallAvgValue2.toFixed(2));
            document.querySelector('#total_maxtaeedshodeh').textContent = formatNumberWithCommas(overallMaxValue.toFixed(0));
        }
        else {
            const overallAvgValue = 0;
            const overallAvgValue2 = 0;
            const overallMaxValue = 0;
            console.log(overallAvgValue);
            console.log(overallMaxValue);
            console.log(overallAvgValue2);

            let totalRow = document.querySelector('#secondaryTable tfoot #totalRow');
            if (!totalRow) {
                const tfoot = document.querySelector('#secondaryTable tfoot') || document.createElement('tfoot');
                totalRow = document.createElement('tr');
                totalRow.id = "totalRow";
                totalRow.innerHTML = `
          <td>براساس فیلتر</td>
          <td id="total_sabtshodeh"></td>
          <td id="total_taeedshodeh"></td>
          <td id="total_maxtaeedshodeh"></td>
      `;
                tfoot.appendChild(totalRow);
                document.querySelector('#secondaryTable').appendChild(tfoot);
            }

            document.querySelector('#total_sabtshodeh').textContent = formatNumberWithCommas(overallAvgValue.toFixed(0));
            document.querySelector('#total_taeedshodeh').textContent = formatNumberWithCommas(overallAvgValue2.toFixed(2));
            document.querySelector('#total_maxtaeedshodeh').textContent = formatNumberWithCommas(overallMaxValue.toFixed(0));
        }
        console.log("Filter updated.");
    }
