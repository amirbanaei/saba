    function selectAllRadios(type, columnId) {
        // انتخاب همه رادیوها با کلاس و ستون مشخص‌شده
        const radios = document.querySelectorAll(`.form-check-input.${type}[data-column="${columnId}"]`);
        const tr = document.querySelectorAll('tr.vasile');
        console.log(tr[0])
        console.log(radios)
        let allChecked = true;

        // Check if all radios are already checked
        var cont = 0;
        radios.forEach(function (radio) {
            if (!radio.checked) {
                if (window.getComputedStyle(tr[cont]).display != 'none') {
                    allChecked = false;
                }

            }
            cont += 1
        });
        var cont = 0;
        // If all are checked, uncheck all, otherwise check all
        radios.forEach(function (radio) {

            if (window.getComputedStyle(tr[cont]).display != 'none') {
                radio.checked = !allChecked;
            }
            cont += 1
        });

        // رادیوی اصلی در سربرگ را بر اساس وضعیت رادیوهای ستون تنظیم می‌کنیم
        const headerRadio = document.querySelector(`#selectAllMamur_${columnId}`);
        console.log(headerRadio)
        if (allChecked) {
            headerRadio.checked = false;
        } else {
            headerRadio.checked = true;
        }
    }

    function formatNumberWithCommas(number) {
        return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }
    $("input.form-control44334").on('input', function () {
        var value = $(this).val();
        value = removeCommas(value); // Remove existing commas
        if ($.isNumeric(value)) {
            $(this).val(formatNumberWithCommas(value)); // Format with commas
        }
    });
    $("input.form-control44334").each(function () {
        var value = $(this).val();
        if ($.isNumeric(value)) {
            $(this).val(formatNumberWithCommas(value)); // اعمال فرمت
        }
    });
    function removeCommas(number) {
        return number.replace(/,/g, '');
    }
    $("#btnSaveEsmahdod2").click(function () {
        // جمع‌آوری داده‌ها
        var dataList = []; // ایجاد یک آرایه برای ذخیره تمام داده‌ها

        $("input.form-control44334").each(function () {
            var bindValue = $(this).data("bind"); // گرفتن مقدار data-bind
            var keyboardValue = $(this).data("keyboard"); // گرفتن مقدار data-keyboard
            var isChecked = $(this).is(":checked"); // بررسی اینکه آیا رادیو انتخاب شده است یا خیر

            // تعیین مقدار value بر اساس اینکه آیا چک شده یا خیر
            var value = isChecked ? "true" : "false";

            // اضافه کردن داده به dataList
            dataList.push({
                FK_usr: keyboardValue, // استفاده از data-keyboard به عنوان FK_usr
                FK_name: bindValue, // استفاده از data-bind به عنوان FK_moalfe
                Position: value
            });
        });

        // ارسال داده‌ها به سرور
        if (dataList.length > 0) {
            updateDatabasemah4(dataList);
            console.log(dataList);
        }
    });
    function updateDatabasemah4(dataList) {
        $.ajax({
            url: '/Reporter/Dashboard/UpdateRecordmahdodat3', // آدرس اکشن کنترلر شما
            method: 'POST',
            data: JSON.stringify(dataList), // ارسال آرایه به سرور

            contentType: 'application/json',
            success: function (response) {
                console.log("Record updated successfully.");
                if (response == "true") {
                    alert("با موفقیت ثبت شد");
                    location.reload();

                }
            },
            error: function (error) {
                console.error("Error updating record:", error);
            }
        });
    }
</script>