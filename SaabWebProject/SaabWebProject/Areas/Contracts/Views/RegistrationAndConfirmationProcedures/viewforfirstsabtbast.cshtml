<script>
    $("#btnCalculateAzmayeshi").click(function () {
    var PeymanArr = [];
    $.each($("#select_peymancitys").val().toString().split(","), function (index, item) {
        if (item !== "" && item !== 'Select') {
            PeymanArr.push(item);
        }
    });

    var namebasteh = $("#basteh").val();
    var fishorsorat = $("#soratvaz").val();
    var fkpymn = $("#select_peyman1").val();

    if ($("#select_peyman_").val() === 'Select') {
        alert("لطفا پیمان ها را انتخاب کنید");
        return;
    } else if ($("#CourseAz").val() === "0") {
        alert("لطفا دوره را انتخاب کنید");
        return;
    } else if ($("#MonthAz").val() === "0") {
        alert("لطفا ماه را انتخاب کنید");
        return;
    } else if ($("#YearAz").val() === "0") {
        alert("لطفا سال را انتخاب کنید");
        return;
        }
        console.log(PeymanArr);
    var formData = new FormData();
        PeymanArr.forEach((item) => {
            formData.append("FKcity[]", item); // ارسال هر عنصر به صورت جداگانه
        });
        formData.append("fkpymn", fkpymn);
        formData.append("namebasteh", namebasteh);
        formData.append("fishorsorat", fishorsorat);

    // اضافه کردن فایل‌ها
        fd.forEach((value, key) => {
        formData.append(key, value);
    });
        console.log(formData);

    $.ajax({
                  url: "@Url.Action("createmarhaleh1", "RegistrationAndConfirmationProcedures", new { area = "Contracts" })",
        type: "POST",
        processData: false,
        contentType: false,
        data: formData,
        success: function (res) {
            if (res == "True") {
                alert("با موفقیت ثبت شد ");
                location.reload();
            }
            console.log(res);
        },
        error: function (res) {
            console.log(res);
            Toast.fire({
                icon: 'error',
                background: '#35434A',
                color: 'white',
                title: "عملیات با خطا مواجه شد"
            });
        }
    });
});

</script>