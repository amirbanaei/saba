@using SaabWebProject.Models.DomainModels
@{
    Layout = null;


}

@model Dictionary<string, int>
<style>
    td input, td input[class="form-control"] {
        margin-bottom: 0 !important;
    }
    td .picker, td .form-select {
        margin-bottom: 0 !important;
    }
</style>
<div class="table-responsive">
    <table class="table table-hover" style="text-align:center;">
        <thead >
            <tr>
                <th>ردیف</th>
                <th style="width:30%">عنوان بسته</th>
                <th style="width:30%">مولفه های قابل ثبت </th>
                <th>افراد مجاز</th>
                <th style="width:10%">روز شروع عملیات در ماه</th>
                <th style="width:10%">حداکثر مهلت(روز)</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model["IsFor"] == 1)
                {

                    for (int i = 0; i < Model["count"]; i++)
                    {
                        var radif = i + 1;
                        if (radif == 1)
                        {
                            <tr>
                                <td>@radif</td>
                                <td><input class="form-control" max="31" min="1" id="title_@radif" /></td>
                                <td class="td_MoalefeDatMozdi"></td>
                                <td class="td_users"></td>
                                <td><input class="form-control" type="number" max="31" min="1" id="StartDaysInMonth_@radif" /></td>
                                <td><input class="form-control count_Perdays" type="number" max="31" min="1" id="DeadLine_@radif" /></td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@radif</td>
                                <td><input class="form-control" max="31" min="1" id="title_@radif" /></td>
                                <td class="td_MoalefeDatMozdi"></td>
                                <td class="td_users"></td>
                                <td><input class="form-control" type="number" max="31" min="1" id="StartDaysInMonth_@radif" /></td>
                                <td><input class="form-control count_Perdays" type="number" max="31" min="1" id="DeadLine_@radif" /></td>
                            </tr>
                        }

                    }
                }
                else
                {
                    SaabEntities db = new SaabEntities();

                    string name = "";
                    if (Model.TryGetValue("pymn", out int pymnValue))
                    {
                        int pymn = (int)pymnValue;

                        name = db.tbPeymanContracts
                            .Where(x => x.pec_ID == pymn)
                            .Select(p => p.pec_Title)
                            .FirstOrDefault();
                    }
                    if (Model["IsFor"] == 4)
                    {
                        var radif = 1;
                        <tr>
                            <td>@radif</td>
                            <td><input class="form-control" max="31" min="1" id="title_@radif" value="بسته ابزار _@name " readonly /></td>
                            <td class="td_MoalefeDatMozdi"></td>
                            <td class="td_users"></td>
                            <td><input class="form-control" type="number" max="31" min="1" id="StartDaysInMonth_@radif" /></td>
                            <td><input class="form-control count_Perdays" type="number" max="31" min="1" id="DeadLine_@radif" /></td>
                        </tr>
                    }
                    else if (Model["IsFor"] == 3)
                    {
                        var radif = 1;
                        <tr>
                            <td>@radif</td>
                            <td><input class="form-control" max="31" min="1" id="title_@radif" value=" بسته ماشین آلات _@name " readonly /></td>
                            <td class="td_MoalefeDatMozdi"> </td>
                            <td class="td_users"></td>
                            <td><input class="form-control" type="number" max="31" min="1" id="StartDaysInMonth_@radif" /></td>
                            <td><input class="form-control count_Perdays" type="number" max="31" min="1" id="DeadLine_@radif" /></td>
                        </tr>
                    }
                    else if (Model["IsFor"] == 6)
                    {
                        var radif = 1;
                        <tr>
                            <td>@radif</td>
                            <td><input class="form-control" max="31" min="1" id="title_@radif" value=" بسته پروژه کالایی _@name " readonly /></td>
                            <td class="td_MoalefeDatMozdi"> </td>
                            <td class="td_users"></td>
                            <td><input class="form-control" type="number" max="31" min="1" id="StartDaysInMonth_@radif" /></td>
                            <td><input class="form-control count_Perdays" type="number" max="31" min="1" id="DeadLine_@radif" /></td>
                        </tr>
                    }
                    else if (Model["IsFor"] == 5)
                    {
                        var radif = 1;
                        <tr>
                            <td>@radif</td>
                            <td><input class="form-control" max="31" min="1" id="title_@radif" value=" بسته صورت وضعیت _@name " readonly /></td>
                            <td class="td_MoalefeDatMozdi"> </td>
                            <td class="td_users"></td>
                            <td><input class="form-control" type="number" max="31" min="1" id="StartDaysInMonth_@radif" /></td>
                            <td><input class="form-control count_Perdays" type="number" max="31" min="1" id="DeadLine_@radif" /></td>
                        </tr>
                    }
                    else if (Model["IsFor"] == 7)
                    {
                        var radif = 1;
                        <tr>
                            <td>@radif</td>
                            <td><input class="form-control" max="31" min="1" id="title_@radif" value=" بسته فیش _@name " readonly /></td>
                            <td class="td_MoalefeDatMozdi"> </td>
                            <td class="td_users"></td>
                            <td><input class="form-control" type="number" max="31" min="1" id="StartDaysInMonth_@radif" /></td>
                            <td><input class="form-control count_Perdays" type="number" max="31" min="1" id="DeadLine_@radif" /></td>
                        </tr>
                    }
                    else
                    {
                        var ty = Model["IsFor"];
                        var n = db.tbmarahelsabt.Where(p => p.ID == ty).FirstOrDefault();
                        var ne = "";
                        if (n != null)
                        {
                            ne = n.Name;
                        }
                        var radif = 1;
                        <tr>
                            <td>@radif</td>
                            <td><input class="form-control" max="31" min="1" id="title_@radif" value=" @ne _@name " readonly /></td>
                            <td class="td_MoalefeDatMozdi"> </td>
                            <td class="td_users"></td>
                            <td><input class="form-control" type="number" max="31" min="1" id="StartDaysInMonth_@radif" /></td>
                            <td><input class="form-control count_Perdays" type="number" max="31" min="1" id="DeadLine_@radif" /></td>
                        </tr>
                    }

                }
            }

        </tbody>

    </table>
</div>
