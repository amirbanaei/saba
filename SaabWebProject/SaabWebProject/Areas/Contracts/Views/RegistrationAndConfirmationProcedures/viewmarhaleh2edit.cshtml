
@using SaabWebProject.Models.DomainModels;

@{
    SaabEntities db = new SaabEntities();

    Layout = null;
}
<style>

    .tableH_LockSS {
        max-height: 487px;
        /*height: 260px;*/
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0px !important;
    }
    .RadioFilter {
        margin-bottom: 0px !important;
    }

    thead th {
        vertical-align: middle;
    }
    .inputSS44334{
        margin-bottom:0px !important;
