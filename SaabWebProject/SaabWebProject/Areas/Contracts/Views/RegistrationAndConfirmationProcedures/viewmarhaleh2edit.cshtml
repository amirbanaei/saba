</style>

<div class="card">
    <div class="table-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive tableH_LockSS">
                <table class="table table-hover text-nowrap">
                    <thead class="sticky-header">
                        <tr>
                            <th class="users headRi0">
                                نام کارگزاری
                                <input type="text" id="filter01-filter" class="inputFilter form-control" placeholder="">
                            </th>
                            <th class="users headRi1">
                                شهرستان
                                <input type="text" id="filter02-filter" class="inputFilter form-control" placeholder="">
                            </th>
                            @foreach (var item in db.tbmarahlsabtbastedit1.Where(p => p.naem != null).ToList())
                            {
                                <th class="TitelL" style="padding-bottom: 11px !important;">
                                    @item.naem
                                    <div class="form-check EmkRadio" style=" justify-self: center;"> 
                                        <!-- رادیو باتن برای انتخاب همه چک‌باکس‌ها در ستون -->
                                        <input class="form-check-input RadioFilter" type="checkbox"
                                               name="selectAllOwner"
                                               id="selectAllMamur_@item.ID"
                                               onclick="selectAllRadios('@item.ID')" />
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int II = 0;
                            var marahls = db.tbmarahlsabtbastedit1.Where(p => p.naem != null).ToList(); // ستون‌های ثابت

                            var list = db.tbmarahlsabtbastedit2.ToList();
                            var cit = db.tbpeymancities.ToList();
                        }
                        @foreach (var contract in db.tbPeymanContracts.ToList())
                        {
                            var cities = cit.Where(p => p.FK_PYMN == contract.pec_ID).ToList();
                            foreach (var city in cities)
                            {
                                var cityName = city.tbCities?.Name ?? "N/A";

                                <tr class="task-list-row dateS_@II"
                                    data-filter01="@contract.pec_Title"
                                    data-filter02="@cityName">
                                    <td class="headRi0">@contract.pec_Title</td>
                                    <td class="headRi1">@cityName</td>
                                    @foreach (var marahl in marahls)
                                    {
                                        var findvalu = list
                                                         .FirstOrDefault(p => p.FK_City == city.FK_City
                                                                              && p.FK_namebAST == marahl.ID
                                                                              && p.FK_pymn == contract.pec_ID);
                                        var hasValue = findvalu?.Has ?? false;

                                        <td data-column="@marahl.ID">
                                            <input class="form-check-input mamur inputSS44334 weewee"
                                                   name="checkRow_@marahl.ID"
                                                   type="checkbox"
                                                   id="checkVasileV1-@marahl.ID-@city.FK_City-@contract.pec_ID"
                                                   data-column="@marahl.ID"
                                                   data-bind="@marahl.ID"
                                                   data-keyboard="@marahl.ID"
                                                   @(hasValue ? "checked" : "") />
                                        </td>

                                    }
                                </tr>
                                II++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>



    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<div class="row mt-10px">
    <div class="col-xl-11"></div>
    <div class="col-xl-1">
        <button id="savabtn" type="button" class="btn form-control buttonsabt">
            <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
            <span class="bSabt-text">ثبت</span>
        </button>
    </div>
</div>


<script src="~/Scripts/jquery-3.3.1.js"></script>
