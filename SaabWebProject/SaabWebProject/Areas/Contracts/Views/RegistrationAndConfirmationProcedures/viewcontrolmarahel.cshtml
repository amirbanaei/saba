    $(document).ready(function () {
        $("#downfish2").on('click', function () {
            var year_usr = $("#year_usr").val();
            var month_usr = $("#month_usr").val();
            console.log(month_usr);
            console.log(year_usr);

            // اعتبارسنجی مقادیر ورودی
            if (!year_usr || !month_usr || isNaN(year_usr) || isNaN(month_usr)) {
                alert("Please enter valid year and month.");
                return;
            }

            // ذخیره URL در متغیر
            var url = '@Url.Action("viewmonthyearmahdodat", "RegistrationAndConfirmationProcedures", new { area = "Contracts" })';

            // ارسال درخواست Ajax
            $.ajax({
                url: url,

                type: "POST",
                dataType: "html",
                success: function (resp) {
                    // در صورت موفقیت
                    window.location.replace(url + '?year=' + year_usr + '&month=' + month_usr);
                },
                error: function (resp2) {
                    // در صورت خطا
                    alert("An error occurred: " + resp2.statusText);
                    console.error(resp2);
                }
            });
        });
    });
