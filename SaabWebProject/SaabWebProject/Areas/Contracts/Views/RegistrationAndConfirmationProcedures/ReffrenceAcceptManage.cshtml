<script>
    //ثبت اطلاعات
    $("#btn_saveAccept").click(function () {
        if ($("#baste_peyman").val() == 0) {
            alert("پیمان را انتخاب نمایید");
        } else if ($("#basteOfPeyman").val() == 0) {
            alert("بسته را انتخاب نمایید")
        } else if ($("#MaxDaysForAccept1").val() == 0) {
            alert("حداکثر تعداد روز برای عملیات تایید را وارد نمایید")
        } else if ($("#CountLevels1").val() == 0) {
            alert("تعداد مراحل را وارد نمایید")
        } else {
            var Total = new Object();
            Total.FK_PeymanID = $("#select_peyman1").val();
            Total.FK_ReffrenceSaveLevel = $("#basteOfPeyman").val();
            Total.MaxDaysForAccept = $("#MaxDaysForAccept1").val();
            Total.CountLevels = $("#CountLevels1").val();
            Total.EndDayAllLevels = $("#EndDayAllLevels").val();
            let levelArr = []; // ارایه ذخیره سازی  همه سطوح تایید
            let counter = 0;
            $.each($(".count_Perdays1"), function (index, item) {
                var id = $(this).attr("id").split("_")[1];
                var obj = new Object();
                obj.StartDayInMonth = $("#StartDayInMonth_"+id).val();
                obj.Duration = $("#Duration_" + id).val();
                //ارایه ذخیره افراد هر سطر
                var UsersArr = [];
                $.each($("#select_usersTaeed_" + counter).val().toString().split(","),function (index,item){
                    if(item != ""){
                        var user_obj = new Object();
                        user_obj.FK_User =  item;
                        UsersArr.push(user_obj);
                    }

                });
                obj.tbReffrenceAcceptLevelUsers = UsersArr;

                counter++;
                levelArr.push(obj);
            });
            Total.tbReffrenceAcceptLevel = levelArr;

            sendAjax('@Url.Action("SaveReffrenceAccept", "RegistrationAndConfirmationProcedures", new { area = "Contracts" })', Total)
        }
    });
</script>-->
