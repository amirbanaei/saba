@using SaabWebProject.Models.DomainModels;

@{
    Layout = null;
    SaabEntities db = new SaabEntities();

}
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />

@model IEnumerable<SaabWebProject.Models.DomainModels.tbReffrenceSave>
<style>
    .tableH_Lock {
        max-height: 483px !important;
        /*height: 260px;*/
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0px !important;
    }

    thead th {
        vertical-align: middle;
    }
</style>
<div class="card">
    <div class="table-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive tableH_Lock">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("فعالیت")
                            </th>
                            <th>
                                @Html.DisplayName("#")
                            </th>
                            <th>
                                @Html.DisplayName("جهت")
                                <input type="text" id="filter01-filter" class="inputFilter form-control" placeholder="">
                            </th>
                            <th>
                                @Html.DisplayName("پروژه")
                                <input type="text" id="filter02-filter" class="inputFilter form-control" placeholder="">
                            </th>
                            <th>
                                @Html.DisplayName("دوره گزارش گیری")
                                <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">
                            </th>
                            <th>
                                @Html.DisplayName("نوع بارگذاری داده")
                                <input type="text" id="filter04-filter" class="inputFilter form-control" placeholder="">
                            </th>
                            <th>
                                @Html.DisplayName("تعداد مراحل")
                                <input type="text" id="filter05-filter" class="inputFilter form-control" placeholder="">
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        @{ int counter = 0;
                            string doregozaresh = "";
                            string noebargozari = "";
                        }
                        @if (Model != null)
                        {

                            foreach (var item in Model)
                            {
                                switch (@item.Duration)
                                {
                                    case 1:
                                        doregozaresh = "ماهیانه";
                                        break;
                                    case 2:
                                        doregozaresh = "دو ماهه";
                                        break;
                                    case 3:
                                        doregozaresh = "فصلی";
                                        break;
                                    default:
                                        doregozaresh = "نامعلوم";
                                        break;
                                }
                                //=====================================
                                switch (@item.TypeOfUpload)
                                {
                                    case 1:
                                        noebargozari = "تجمیعی";
                                        break;
                                    case 2:
                                        noebargozari = "متوالی";
                                        break;

                                    default:
                                        noebargozari = "نامعلوم";
                                        break;
                                }
                                <tr class="task-list-row"
                                    data-filter01="@db.tbmarahelsabt.Where(p => p.ID == item.IsFor).Select(s => s.Name).FirstOrDefault()"
                                    data-filter02="@item.tbPeymanContracts.pec_Title"
                                    data-filter03="@doregozaresh"
                                    data-filter04="@noebargozari"
                                    data-filter05="@item.CountLevels">
                                    <td>
                                        <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                            <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <div class="dropdown-menu">
                                                @*<a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item edit" id="Edit_@item.ID">ویرایش</a>*@
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item Details" id="Detail_@item.ID">جزئیات</a>
                                                @*<a class="dropdown-item Delete" id="Delete_@item.ID">حذف</a>*@
                                                @*<a data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item edit" id="Edit_@item.ID">ویرایش</a>*@
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{counter = counter + 1;}

                                        <span>@counter</span>
                                    </td>

                                    <td>
                                        @db.tbmarahelsabt.Where(p => p.ID == item.IsFor).Select(s => s.Name).FirstOrDefault()
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.tbPeymanContracts.pec_Title)
                                    </td>
                                    <td>
                                        @doregozaresh
                                    </td>


                                    <td>
                                        @noebargozari
                                    </td>
                                    <td>
                                        @item.CountLevels
                                    </td>


                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script>

    var filters = {
            filter01: null,
            filter02: null,
            filter03: null,
            filter04: null,
            filter05: null,
        };

    function updateFilters() {
        $('.task-list-row').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter(filterName) {
        filters[filterName] = this.value;
        updateFilters();
    }

    // Assigned User Dropdown Filter
    $('#filter01-filter').on('input', function () {
        changeFilter.call(this, 'filter01');
    });
    $('#filter02-filter').on('input', function () {
        changeFilter.call(this, 'filter02');
    });
    $('#filter03-filter').on('input', function () {
        changeFilter.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilter.call(this, 'filter04');
    });
    $('#filter05-filter').on('input', function () {
        changeFilter.call(this, 'filter05');
    });


</script>

