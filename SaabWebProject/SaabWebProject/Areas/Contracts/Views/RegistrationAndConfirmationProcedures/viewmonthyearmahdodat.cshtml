<script>
    // Convert Gregorian date to jaali in the table
    var tds = document.querySelectorAll("[cont-date]");
    var valueD, id, target;
    var options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    tds.forEach(td => {
        valueD = new Date(td.textContent).toLocaleDateString('fa-IR-u-nu-latn', options).replace(',', '').replace(" ", "");
        valueD = valueD.slice(0, 10) + " " + td.textContent.slice(10, 30)
        id = td.getAttribute("cont-date");
        target = document.getElementById(id);
        target.textContent = valueD;
    });
</script>
<script>
        $(document).ready(function () {
            // بازگردانی مقادیر ذخیره‌شده
            const selectedYear = sessionStorage.getItem('selectedYear');
            const selectedMonth = sessionStorage.getItem('selectedMonth');

            if (selectedYear) {
                $('#year_usr').val(selectedYear);
            }
            if (selectedMonth) {
                $('#month_usr').val(selectedMonth);
            }

            // ذخیره مقادیر هنگام تغییر
            $('#year_usr').change(function () {
                const yearValue = $(this).val();
                sessionStorage.setItem('selectedYear', yearValue);
            });

            $('#month_usr').change(function () {
                const monthValue = $(this).val();
                sessionStorage.setItem('selectedMonth', monthValue);
            });

        });

</script>
