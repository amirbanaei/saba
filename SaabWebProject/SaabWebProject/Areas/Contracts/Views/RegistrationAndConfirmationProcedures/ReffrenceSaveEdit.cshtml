                        <i class="fa fa-arrow-alt-circle-left" style="font-size:large"></i>
                    </button>
                </div>


            </div>
            <div class="row" id="Div_TedadMarahel" style="margin-top:20px;overflow-y:scroll;height:400px;">

                <div class="table-responsive">
                    <table class="table table-hover" style="text-align:center;">
                        <thead class="table-dark">
                            <tr>
                                <td>ردیف</td>
                                <td style="width:30%">عنوان بسته</td>
                                <td style="width:30%">مولفه های قابل ثبت </td>
                                <td>افراد مجاز</td>
                                <td style="width:10%">روز شروع عملیات در ماه</td>
                                <td style="width:10%">حداکثر مهلت(روز)</td>
                            </tr>
                        </thead>
                        <tbody>
                    
                                @foreach (var item in Model.tbReffrenceSaveLevel)
                                {
                                    var radif = 1;
                                    if (radif == 1)
                                    {
                                        <tr>
                                            <td>@radif</td>
                                            <td><input class="form-control" max="31" min="1" id="title_@radif" value="@item.Title" /></td>
                                            <td class="td_MoalefeDatMozdi"></td>
                                            <td class="td_users"></td>
                                            <td><input class="form-control" type="number" max="31" min="1" id="StartDaysInMonth_@radif" value="@item.StartDaysInMonth" /></td>
                                            <td><input class="form-control count_Perdays" type="number" max="31" min="1" id="DeadLine_@radif" value="@item.DeadLine" /></td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>@radif</td>
                                            <td><input class="form-control" max="31" min="1" id="title_@radif" value="@item.Title" /></td>
                                            <td class="td_MoalefeDatMozdi_"></td>
                                            <td class="td_users"></td>
                                            <td><input class="form-control" type="number" max="31" min="1" id="StartDaysInMonth_@radif" value="@item.StartDaysInMonth" disabled /></td>
                                            <td><input class="form-control count_Perdays" type="number" max="31" min="1" id="DeadLine_@radif" value="@item.DeadLine" /></td>
                                        </tr>
                                    }

                                }
                            

                        </tbody>

                    </table>
                </div>

<script>
