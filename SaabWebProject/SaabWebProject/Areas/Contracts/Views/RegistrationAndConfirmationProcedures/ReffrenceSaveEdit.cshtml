@*ذخیره اطلاعات*@
<script>
    $("#btn_ReffrenceSave").click(function () {
        if ($("#select_peyman2").val() == 0) {
            alert("پیمان را انتخاب نمایید");
        } else if ($("#Duration").val() == 0) {
            alert("دوره گزارش گیری را انتخاب نمایید")
        } else if ($("#TypeOfUpload").val() == 0) {
            alert("نوع بارگذاری داده را وارد نمایید")
        }
        //else if ($("#MaxDaysForSave").val() == 0) {
        //    alert("حداکثر تعداد روز برای عملیات ثبت را وارد نمایید")
        //}
    else if ($("#CountLevels").val() == 0) {
            alert("تعداد مراحل را وارد نمایید")
        } else {
            var Total = new Object();
            Total.FK_PeymanID = $("#select_peyman2").val();
            Total.Duration = $("#Duration").val();
            Total.TypeOfUpload = $("#TypeOfUpload").val();
            //Total.MaxDaysForSave = $("#MaxDaysForSave").val();
            Total.TypeOfUser = $("#TypeOfUser").val();
            Total.CountLevels = $("#CountLevels").val();
            Total.StartMonth = $("#startMonth").val();
            Total.ID = $("#model_ID").val();
            let levelArr = []; // ارایه ذخیره سازی  همه سطوح بسته ها
            let counter = 0;
            $.each($(".count_Perdays"), function (index, item) {
                var id = $(this).attr("id").split("_")[1];
                var obj = new Object();
                obj.Title = $("#title_"+id).val() ;
                obj.StartDaysInMonth = $("#StartDaysInMonth_"+id).val();
                obj.DeadLine = $("#DeadLine_" + id).val();
                //ارایه ذخیره افراد هر سطر
                var UsersArr = [];
                console.log($("#select_users_" + counter).val());
                $.each($("#select_users_" + counter).val().toString().split(","),function (index,item){
                    if(item != ""){
                        var user_obj = new Object();
                        user_obj.FK_UserID =  item;
                        console.log(item);
                        UsersArr.push(user_obj);
                    }

                });
                console.log(UsersArr);
                obj.tbReffrenceSaveLevelUser = UsersArr;
                //ارایه ذخیره مولفه های هر سطر
                var MoalefeArr = [];
                $.each($("#select_Allmoalefe_" + counter).val().toString().split(","),function (index,item){
                    if(item != ""){
                        var moalefe_obj = new Object();
                        moalefe_obj.FK_MoalefeID =  item;
                        MoalefeArr.push(moalefe_obj);
                    }
                });
                obj.tbReffrenceSaveLevelMoalefe = MoalefeArr;
                counter++;
                levelArr.push(obj);
            });
            Total.tbReffrenceSaveLevel = levelArr;

            sendAjax('@Url.Action("SaveReffrenceSave", "RegistrationAndConfirmationProcedures", new { area = "Contracts" })', Total)
        }
    });
</script>

@* ajax code *@
<script>
    function sendAjax(url, data) {
        $.ajax({
            beforeSend: function () {
                document.getElementById("loading-message").style.display = "block";
            },
            url: url,
            data: { Total: data },
            type: "Post",
            dataType: "html",
            success: function (resp) {
                document.getElementById("loading-message").style.display = "none";
                console.log(resp);
                if (resp == "True") {

                    alert("با موفقیت ثبت شد..");
                    location.reload();
                }
            },
            error: function (resp) {
                document.getElementById("loading-message").style.display = "none";
                alert("دچار مشکل شده است ");
                console.log(resp);
            }
        });
    }
</script>

@* show Continiue form information *@
<script>
    $("#Duration").change(function () {
        GetListSabt();
    });
    $("#TypeOfUpload").change(function () {
        GetListSabt();
    });
    function GetListSabt() {
        if ($("#Duration").val() != 0 && $("#TypeOfUpload").val() != 0 && $('#select_peyman2').val() != 'Select') {
            var typee = $("#TypeOfUpload").val();
            var durationn = $("#Duration").val() ;
            var peymann = $('#select_peyman2').val();
            console.log(peymann);
            $("#Div_ContinueForm").load('@Url.Content("/../Contracts/RegistrationAndConfirmationProcedures/ReffrenceSaveUpdate")?peymanId='+ peymann + '&type='+ typee + '&duration=' + durationn, function () {
                controlLevels();
            });
        }
    }
</script>
<script>
    function controlLevels(){
    @* نمایش سطوح مختلف *@

        $(function () {
            if ($("#model_ID").val() != null) {
                $("Submit").click();
            }
        });
        $("#Submit").click(function () {
            if ($("#TypeOfUpload").val() != 0) {
                $("#Div_TedadMarahel").load('@Url.Content("/RegistrationAndConfirmationProcedures/ReffrenceSaveListMarahelSabt")?count=' + $("#CountLevels").val() + '&TypeOfUser=' + $("#TypeOfUser").val() + '&pymn=' + $("#select_peyman2").val(), function () {

                    $("#StartDaysInMonth_1").keyup(function () {
                        FillStartDays();
                    });

                    $(".count_Perdays").keyup(function () {
                        FillStartDays();
                    });
                });
            } else {
                alert("نوع بارگذاری داده را مشخص نمائید.")
            }
        });
        // تابع پر کردن تاریخ ها
        function FillStartDays(){
            if ($("#TypeOfUpload").val() == 1) { // اگر تجمیعی بود
                var max = 0; // متغیری برای ذخیره کردن بزرگ ترین روز در بین روز های هر سطر
                $.each($(".count_Perdays"), function (index, item) {
                    var id = $(this).attr("id").split("_")[1];
                    $("#StartDaysInMonth_" + id).val($("#StartDaysInMonth_1").val());
                    if ($("#DeadLine_" + id).val().toString().length != 0 && $("#DeadLine_" + id).val() > max) {
                        max = $("#DeadLine_" + id).val();
                    }

                });
                // محاسبه اتمام روز مراحل تایید
                var sumation = parseInt($("#StartDaysInMonth_1").val()) + parseInt(max);
                console.log($("#StartDaysInMonth_1").val());

                if (sumation > 30) {
                    sumation = parseInt(sumation) - 30;
                    $("#EndDay").val(sumation + "ماه بعد");

                } else {
                    $("#EndDay").val(sumation);
                }
            } else if ($("#TypeOfUpload").val() == 2) { // اگر متوالی بود

                counter = 1;

                $.each($(".count_Perdays"), function (index, item) {
                    counter++;
                    var id = $(this).attr("id").split("_")[1];
                    var sumation = parseInt($("#StartDaysInMonth_" + (counter - 1)).val()) + parseInt($("#DeadLine_" + (counter - 1)).val());
                    if (sumation > 30) {
                        sumation = sumation - 30;
                    }
                    $("#StartDaysInMonth_" + counter).val(sumation);
                });
                var end_sum = parseInt($("#StartDaysInMonth_" + (counter - 1)).val()) + parseInt($("#DeadLine_" + (counter - 1)).val());
                if (end_sum > 30) {
                    end_sum = end_sum - 30;
                    $("#EndDay").val(end_sum + "ماه بعد");

                } else {
                    $("#EndDay").val(end_sum);
                }
                // محاسبه اتمام روز مراحل تایید
                $("#EndDay").val(end_sum);

            }
            //بیش از تعداد روز اعلامی نشده باشد
            //var endday = 0;
            //$.each($(".count_Perdays"), function (index, item) {
            //    endday++;
             //   var id = $(this).attr("id").split("_")[1];
            //    var sumation = 0;
            //    sumation += parseInt($("#DeadLine_" + endday).val());
            //    if (sumation > $("#MaxDaysForSave").val()) {
             //       alert("تعداد روز ها بیش از زمان در نظر گرفته شده است، لطفا اصلاح نمایید")
            //   }
           // });


        }
    }
</script>

