             }
             else {
                 $("#loading-message").css("display", "none");
                 console.log("jlk;;kkj");
                 Toast.fire({

                     icon: 'success',
                     background: '#35434A',
                     color: 'white',
                     title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                 }).then(() => {
                     $("#loading-message").css("display", "none");
                 });
             }

         },
         error: function (resp1) {
             console.log(resp1);
             console.log("Nokeye");
             $("#loading-message").css("display", "none");
             Toast.fire({
                 icon: 'success',
                 background: '#35434A',
                 color: 'white',
                 title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
             }).then(() => {
                 $("#loading-message").css("display", "none");
             });
         }
     });
 }
</script>