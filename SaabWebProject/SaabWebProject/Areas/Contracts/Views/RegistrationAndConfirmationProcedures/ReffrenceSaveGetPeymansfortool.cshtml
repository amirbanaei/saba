
@{Layout = null;}
@model IEnumerable<SaabWebProject.Models.DomainModels.tbReffrenceSave>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<label class= "form-label"> پیمان</label >
<div class="col-xl-12">
    <select class="form-select select_peyman" id="Select_pymn_tool" name="select_peyman" onchange="handleSelectChange()">
        <option value="Select" hidden>انتخاب کنید</option>
        @foreach (var item in Model)
        {
            foreach (var level in item.tbReffrenceSaveLevel)
            {
                <option value="@(level.ID)_@(item.FK_PeymanID)">@(item.tbPeymanContracts.pec_Title)_(نام بسته:@(level.Title))</option>
            }
        }

    </select>
</div>
