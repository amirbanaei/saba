    function viewgozareshdatail11(month, year, vaziatt, fkpymn, fkcity) {
        var listData = @Html.Raw(Json.Encode(Model.listinttb4));
        console.log(listData)
        console.log(vaziatt)
        console.log(fkpymn)
        console.log(fkcity)

    $.ajax({
        url: '@Url.Action("viewgozareshdatail1", "RegistrationAndConfirmationProcedures")',
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ listinttb4: listData, month: month, year: year, vaziatt: vaziatt, fkpymn: fkpymn, fkcity: fkcity }),
        success: function (response) {
            $("#big_modal_body").html(response);
        },
        error: function (xhr, status, error) {
            console.log("Error: " + error);
        }
    });
}

    var
        filters = {
            filter01: null,
            filter02: null,
            filter03: null,
            filter04: null,
            filter05: null,
        };

    function updateFilters() {
        $('.task-list-row').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);

                // تغییر: اگر مقدار فیلتر برابر "همه" است، فیلتر را نادیده بگیریم
                if (filters[filter] && filters[filter] != 'None' && filters[filter] != '✔🔄❌') {
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter(filterName) {
        filters[filterName] = this.value;

        // اگر فیلتر "همه" انتخاب شده بود، آن را به null تغییر بده
        if (this.value === '✔🔄❌') {
            filters[filterName] = null;
        }

        updateFilters();
    }

    // Assigned User Dropdown Filter
    $('#filter01-filter').on('input', function () {
        changeFilter.call(this, 'filter01');
    });
    $('#filter02-filter').on('input', function () {
        changeFilter.call(this, 'filter02');
    });
    $('#filter03-filter').on('input', function () {
        changeFilter.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilter.call(this, 'filter04');
    });
    $('#filter05-filter').on('input', function () {
        changeFilter.call(this, 'filter05');
    });

</script>
