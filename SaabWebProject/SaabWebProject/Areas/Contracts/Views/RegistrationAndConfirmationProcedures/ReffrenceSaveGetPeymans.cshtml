@{
    Layout = null;
    <link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
}
@model IEnumerable<SaabWebProject.Models.DomainModels.tbReffrenceSave>

<div class="col-xl-6">
    <div class="form-group mb-3">
        <label class="form-label"> پیمان ها </label>
        <select class="form-select" id="baste_peyman2">

            <option value="0">انتخاب نمایید..</option>
            @foreach (var item in Model)
            {
                string a = "";
                if (item.IsFor == 3)
                {
                    a = "ماشین آلات";
                }
                else if (item.IsFor == 4)
                {
                    a = "ابزار آلات";
                }
                else
                {
                    a = "عمل کرد افراد";
                }
                <option value="@item.FK_PeymanID ">@item.tbPeymanContracts.pec_Title ( @a )</option>
            }

        </select>
    </div>
</div>
<div class="col-xl-6">
    <div class="form-group mb-3">
        <label class="form-label"> بسته ها </label>
        <div id="mybaste1"></div>

    </div>
</div>


<script src="~/Scripts/jquery-3.4.1.js"></script>
