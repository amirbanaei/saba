
@{

    ViewBag.Title = "تنظیم مراحل ثبت و تایید";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="">

    <ul class="nav nav-tabs nav-tabs-v2 ps-4 pe-4" id="pills-tab" style="margin-bottom:30px">
        <li class="nav-item me-3">
            <a class="nav-link active" id="pills-home-tab" data-bs-toggle="pill" href="#Save_Levels">
                <button class=" nav-btn">مجوز ثبت</button>
            </a>
        </li>
        <li class="nav-item me-3">
            <a class="nav-link " id="pills-profile-tab" data-bs-toggle="pill" href="#pills-profile">
                <button class=" nav-btn">مجوز تایید</button>
            </a>
        </li>
        @*<li class="nav-item">
                <a class="nav-link" id="pills-profile-tab" data-bs-toggle="pill"
                   href="#Report">گزارش</a>
            </li>*@
    </ul>
    <div class="tab-content " id="pills-tabContent">
        <div class="tab-pane fade show active" id="Save_Levels" style=" height: auto;">
            @Html.Action("ReffrenceSaveManage", "RegistrationAndConfirmationProcedures")
        </div>

        <div class="tab-pane fade " id="pills-profile" style="height:auto;">
            @Html.Action("ReffrenceAcceptManage", "RegistrationAndConfirmationProcedures")
        </div>

        <div class="tab-pane fade" id="Report" style="height: auto; ">
            <div class="row" id="show" style="display:flex">
                <div class="col-xl-4">
                    <div class="form-group mb-3">
                        <label class="form-label"> پیمان </label>
                        <div id="peyman3">

                        </div>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group mb-3">
                        <label class="form-label"> بسته </label>
                        <select class="form-select" multiple="multiple" id="basteh2">
                            <option>قرائت</option>
                            <option>بازرسی</option>
                            <option>وصول</option>
                            <option>نصب و اصلاح</option>
                            <option>قطع و وصل</option>
                            <option>کروکی</option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <label class="form-label">کاربر</label>
                    @*@Html.Action("_GetAllUsers_Select", "Users", new { area = "Users" })*@
                </div>
            </div>
            <div class="row" style=" margin-top: 20px ">

                <div class="col-xl-5">
                    <label class="form-label">گزارشات آماده</label>
                    <select class="form-control" style="background-color: #10171D" id="ReadyReports">
                        <option value="0"> انتخاب کنید</option>
                        <option value="1">گزارش بسته های اطلاعای تعریف شده</option>
                        <option value="2">گزارش مراحل تایید بسته های اطلاعاتی</option>
                    </select>
                </div>
                <div class="col-xl-2" style="margin-top:30px">
                    <a href="#" class="btn btn-outline-info form-control" id="Show_Report">
                        <i class="fa fa-eye fa-fw me-1 VecGeneral"></i>
                        <span class="bGeneral-text"> نمایش</span>
                    </a>
                </div>

            </div>
            @*pics*@
            <div class="row" style="margin-top:30px">
                <div id="pic1" style="display: none;overflow-x: scroll">

                    <img src="~/Areas/Contracts/ReportFiles/BastehTarifShode.jpg" />
                </div>
                <div id="pic2" style="display: none;overflow-x: scroll">
                    <img src="~/Areas/Contracts/ReportFiles/MarahelTaeedBasteh.jpg" />

                </div>

            </div>
        </div>

    </div>
</div>

<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>

@*نمایش پیمان ها*@
<script>
      $("#peyman3" ).load('@Url.Content("/../Contracts/Peyman/_GetAllListPeymans_Select")',function(){
          $("#select_peyman").attr("id", "select_peyman3");
          $("#select_peyman3").removeAttr("multiple");
      });
</script>
<script>
    //ویوبسته ها
    $('#basteh2').picker({ search: true });
</script>
@*نمایش گزارشات آماده*@
<script>
    $("#ReadyReports").on('change', function () {
        var selectvalue = $(this).find(":selected").val();
        if (selectvalue == 1 || selectvalue == 2 || selectvalue == 3) {
            $("#show").css('display', 'none');
        }
        if (selectvalue == 0) {
            $("#show").css('display', 'flex');
        }
    });
</script>
@*نمایش گزارشات آماده*@
<script>
    $("#Show_Report").click(function () {
        var selectvalue = $("#ReadyReports").find(":selected").val();
        if (selectvalue == 1) {
            $("#pic1").css('display', 'block');
            $("#pic2").css('display', 'none');
        }
        else if (selectvalue == 2) {
            $("#pic1").css('display', 'none');
            $("#pic2").css('display', 'block');
        }
        else {
            $("#pic1").css('display', 'none');
            $("#pic2").css('display', 'none');
        }
    });
</script>
