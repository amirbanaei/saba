<script>
    $(".aaa").each(function () {
        let value = $(this).text(); // مقدار متن داخل سلول
        if ($.isNumeric(value)) {
            $(this).text(formatNumberWithCommas2(value)); // اعمال فرمت سه‌رقم سه‌رقم
        }
    });
    function formatNumberWithCommas2(number) {
        return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }
    function submitDataT() {
        $("#loading-message").css("display", "block");

        // جمع‌آوری آی‌دی‌های چک‌شده
        var dataList = [];
        $('input.ckeckkk:checked').each(function () {
            dataList.push(parseInt($(this).attr('id'))); // استخراج آی‌دی و افزودن به آرایه
        });

        console.log("Collected IDs:", dataList);

        // ارسال داده‌ها به سرور
        if (dataList.length > 0) {
            $.ajax({
                url: '/Contracts/RegistrationAndConfirmationProcedures/teaaeddasteh', // آدرس اکشن کنترلر
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ IDmoalfeh: dataList, year: 1403, month: 9 }), // ارسال به صورت JSON
                success: function (response) {
                    $("#loading-message").css("display", "none");

                    if (response === "true") {
                        alert("با موفقیت ثبت شد");
                        location.reload();
                    } else {
                        alert("خطا در ثبت داده‌ها");
                    }
                },
                error: function (error) {
                    $("#loading-message").css("display", "none");
                    console.error("Error updating record:", error);
                }
            });
        } else {
            $("#loading-message").css("display", "none");
            alert("هیچ آیتمی انتخاب نشده است.");
        }
    }

</script>
