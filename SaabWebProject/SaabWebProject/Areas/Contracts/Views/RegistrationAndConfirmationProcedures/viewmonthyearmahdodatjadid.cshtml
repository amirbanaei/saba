}
<div class="table-content ">
    <div class="tab-pane fade show active" id="allTab">
        <hr />
        <div class="table-responsive tableH_Lock4">
            <table id="mainTable" class="table table-hover text-nowrap tableGozaresh">
                <tbody>
                    @foreach (var it in Model.tickmomahdodat.ToList())
                    {
                        var yearMonthValue = $"{@Model.year.month}/{@Model.year.month:D2}";

                        <tr>
                            @if (it.value == 0)
                            {
                                <td>
                                    <input class="form-check-input ckeckkk " name="" type="checkbox" id="@it.IDMOalfeh"  data-column="1" data-bind="1" data-keyboard="1" checked="">
                                </td>
                                <td>@it.namemoalfeh</td>
                                <td>@it.nomoalfeh</td>
                                <td class="aaa">@it.valueMiyang.ToString("F2")</td>
                                <td class="aaa">@it.valueMax.ToString("F2")</td>
                                <td><i class="fa fa-multiply iRed"></i></td>
                            }
                            else if (it.value == 1)
                            {
                                <td>
                                    <input class="form-check-input ckeckkk " name="" type="checkbox" id="@it.IDMOalfeh" data-column="1" data-bind="1" data-keyboard="1" checked="">
                                </td>
                                <td>@it.namemoalfeh</td>
                                <td>@it.nomoalfeh</td>
                                <td class="aaa">@it.valueMiyang.ToString("F2")</td>
                                <td class="aaa">@it.valueMax.ToString("F2")</td>
                                <td><i class="bi bi-arrow-repeat iOrang"></i></td>
                            }
                            else if (it.value == 2)
                            {
                                <td>
                                    <input class="form-check-input ckeckkk" name="" type="checkbox" id="@it.IDMOalfeh"  data-column="1" data-bind="1" data-keyboard="1" checked="">
                                </td>
                                <td>@it.namemoalfeh</td>
                                <td>@it.nomoalfeh</td>
                                <td class="aaa">@it.valueMiyang.ToString("F2")</td>
                                <td class="aaa">@it.valueMax.ToString("F2")</td>
                                <td><i class="fa fa-check iGreen"></i></td>
                            }

                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
