            $.each(e.target.files, function (index, file) {
                fd1234.append("MyExcelStream", file);
            });
        });
        // اضافه کردن فیلتر به جدول
        document.querySelectorAll('.inputFilter1').forEach(function (filterInput) {
            filterInput.addEventListener('input', function () {
                const columnIndex = Array.from(filterInput.parentNode.parentNode.children).indexOf(filterInput.parentNode);
                const filterValue = filterInput.value.trim().toLowerCase();

                document.querySelectorAll('tbody tr').forEach(function (row) {
                    const cellText = row.children[columnIndex].textContent.trim().toLowerCase();
                    if (cellText.includes(filterValue)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });

        // کد ارسال اطلاعات به سرور
        $("#savabtn12345").click(function () {
            var dataList = [];

            $("input.weewee").each(function () {
                var inputId = $(this).attr("id");
                var isChecked = $(this).is(":checked");

                var parts = inputId.split('-');
                if (parts.length >= 4) {
                    var FK_namebAST = parseInt(parts[1]);
                    var FK_city = parseInt(parts[2]);
                    var FK_pymn = parseInt(parts[3]);

                    dataList.push({
                        FK_namebAST: FK_namebAST,
                        FK_city: FK_city,
                        FK_pymn: FK_pymn,
                        Has: isChecked
                    });
                } else {
                    console.warn("Invalid ID format for input:", inputId);
                }
            });

            if (dataList.length > 0) {
                updateDatabase55(dataList);
                console.log("Data sent:", dataList);
            } else {
                console.warn("No valid data collected!");
            }
        });

        function updateDatabase55(dataList) {
            $.ajax({
                url: '/Contracts/RegistrationAndConfirmationProcedures/UpdateRecordmahedit2',
                method: 'POST',
                data: JSON.stringify(dataList),
                contentType: 'application/json',
                success: function (response) {
                    if (response === "true") {
                        alert("با موفقیت ثبت شد");
                        location.reload();
                    } else {
                        alert("خطا در ثبت اطلاعات: " + response);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error updating record:", {
                        status: status,
                        error: error,
                        responseText: xhr.responseText
                    });
                    alert("خطا در ارسال اطلاعات.");
                }
            });
        }
</script>


