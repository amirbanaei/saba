        document.addEventListener("DOMContentLoaded", function () {
            // دکمه و inputs را انتخاب کنید
            const buttonContainer = document.getElementById("actionButtonContainer");
            const button = document.getElementById("createMoalefeButtonModal");
            const inputs = document.querySelectorAll("input.sabt, input.taeed, input.controlmarahel");
            console.log(inputs);
            console.log(button);

            // آرایه برای ذخیره مقادیر انتخاب شده
            let selectedValues = [];

            // رویداد کلیک برای inputها
            inputs.forEach(input => {

                input.addEventListener("click", function () {
                    // بررسی مقدار input
                    const value = this.id;
                    console.log(value);

                    if (this.checked) {
                        // اگر انتخاب شد، به آرایه اضافه کنید
                        if (!selectedValues.includes(value)) {
                            selectedValues.push(value);
                        }
                    } else {
                        // اگر برداشته شد، از آرایه حذف کنید
                        selectedValues = selectedValues.filter(val => val !== value);
                    }

                    // اگر آرایه مقادیر دارد، دکمه را نمایش دهید
                    if (selectedValues.length > 0) {
                        buttonContainer.classList.remove("d-none");
                    } else {
                        buttonContainer.classList.add("d-none");
                    }

                    // مقدارها را به دکمه اضافه کنید (در صورت نیاز)
                    button.setAttribute("data-selected-values", selectedValues.join(","));
                });
            });
        });
