    function submitData() {
        $("#loading-circle .loadingText1").text('لطفا منتظر ثبت و ارسال اطلاعات بمانید ...');
        $("#loading-circle").css("display", "flex");

        var dataList = [];

        $("input.form-technololghhhh").each(function () {
            var cityID = $(this).data("cityid");
            var pymnID = $(this).data("pymnid");
            var year = $(this).data("year");
            var month = $(this).data("month");
            var idPersonal = $(this).data("idpersonal");
            var fkMoalfe = $(this).data("fkmoalfe");
            var value = removeCommas($(this).val());
            var sabt = 1;

            dataList.push({
                "CityID": cityID,
                "PymnID": pymnID,
                "Year": year,
                "Month": month,
                "sabt": sabt,
                "value": value,
                "IDPersonal": idPersonal,
                "FkMoalfe": fkMoalfe
            });
        });

        if (dataList.length > 0) {
            $.ajax({
                url: '/Contracts/RegistrationAndConfirmationProcedures/viewmonthyearmahdodatmahdodataslicreate',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(dataList),
                timeout: 800000,
                success: function (response) {
                    $("#loading-circle").css("display", "none");
                    if (response.success === true) {
                        alert("با موفقیت ثبت شد");
                        location.reload();
                    } else {
                        alert(response.message || "خطا در ثبت داده‌ها");
                    }
                },
                error: function (xhr, status, error) {
                    console.log("کد وضعیت:", xhr.status); // مثل 500 یا 404
                    console.log("وضعیت:", status);       // مثل timeout یا error
                    console.log("پیام خطا:", error);     // مثل "Internal Server Error"

                    $("#loading-circle").css("display", "none");
                    alert("خطا در ارتباط با سرور یا اینترنت: " + error);
                }
            });
        }
    }

