<script>
    $(document).ready(function () {
        function formatNumberWithCommas(number) {
            return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        function removeCommas(number) {
            return number.replace(/,/g, '');
        }

        $(document).ready(function () {
            $("input.form-technololghhhh").each(function () {
                let $input = $(this);
                let value = removeCommas($input.val());
                let maxAllowed = parseFloat($input.data("delay"));
                let bindValue = parseFloat($input.data("bind"));
                let backdropKey = $input.data("backdrop");
                let keyboard = $input.data("keyboard");
                let keyboard23 = $input.data("keyboard23");
                let inputsInGroup = $(`input.form-technololghhhh[data-backdrop="${backdropKey}"]`);
                const dataMap = {};

                if ($.isNumeric(value)) {
                    value = parseFloat(value);
                    if (value > bindValue) {
                        Swal.fire({
                            icon: 'error',
                            title: 'خطا',
                            text: `مقدار وارد شده برای ${keyboard23} نباید از ${formatNumberWithCommas(bindValue)} بیشتر باشد.`,
                            confirmButtonText: 'باشه'
                        });
                        $input.val(formatNumberWithCommas(bindValue));
                    }

                    let total = 0, count = 0;
                    inputsInGroup.each(function () {
                        let groupValue = removeCommas($(this).val());
                        if ($.isNumeric(groupValue)) {
                            total += parseFloat(groupValue);
                        }
                        count++;

                    });

                    let average22 = count > 0 ? (total / count).toFixed(2) : 0;
                    if (average22 > maxAllowed) {
                        Swal.fire({
                            icon: 'error',
                            title: 'خطا',
                            text: `مقدار وارد شده نباید از ${formatNumberWithCommas(value)} بیشتر باشد.`,
                            confirmButtonText: 'باشه'
                        });
                        $input.val(formatNumberWithCommas(0));
                    }

                    inputsInGroup.each(function () {
                        let groupValue = removeCommas($(this).val());
                        if (!$.isNumeric(groupValue) || groupValue === "") {
                            $(this).val(formatNumberWithCommas(0));
                        }
                    });

                    $("table#mainTable tbody tr").each(function () {
                        const row = $(this)[0];
                        if (window.getComputedStyle(row).display === 'none') return;
                        const input = row.querySelector('input.form-technololghhhh');
                        if (!input) return;

                        const idTackBasteh = input.dataset.keyboard;
                        const valueFromInput = parseFloat(removeCommas(input.value));

                        if (!isNaN(valueFromInput)) {
                            if (!dataMap[idTackBasteh]) {
                                dataMap[idTackBasteh] = { totalDelay: 0, count: 0, maxFromInput: 0 };
                            }

                            dataMap[idTackBasteh].totalDelay += valueFromInput;
                            dataMap[idTackBasteh].count++;
                            if (valueFromInput > dataMap[idTackBasteh].maxFromInput) {
                                dataMap[idTackBasteh].maxFromInput = valueFromInput;
                            }
                        }
                    });

                    let totalOverallDelay = 0, totalOverallCount = 0, overallMaxValue = 0;
                    Object.values(dataMap).forEach(group => {
                        totalOverallDelay += group.totalDelay;
                        totalOverallCount += group.count;
                        if (group.maxFromInput > overallMaxValue) {
                            overallMaxValue = group.maxFromInput;
                        }
                    });

                    let overallAvgValue = totalOverallCount > 0 ? (totalOverallDelay / totalOverallCount).toFixed(2) : 0;
                    $(document).ready(function () {

                    // به‌روزرسانی مقادیر در جدول دوم
                    const secondaryTableRows = document.querySelectorAll('#secondaryTable tbody tr');
                    secondaryTableRows.forEach(row => {
                        const idBasteh = row.querySelector('[data-container]')?.dataset.container;
                        if (dataMap[idBasteh]) {
                            const maxValueFromInput = dataMap[idBasteh].maxFromInput;
                            const avgValue = dataMap[idBasteh].totalDelay / dataMap[idBasteh].count;
                            row.querySelector('#taeedshodeh').textContent = formatNumberWithCommas(avgValue.toFixed(2));
                            row.querySelector('#maxtaeedshodeh').textContent = formatNumberWithCommas(maxValueFromInput.toFixed(0));
                        } else {
                            row.querySelector('#taeedshodeh').textContent = formatNumberWithCommas(0);
                            row.querySelector('#maxtaeedshodeh').textContent = formatNumberWithCommas(0);
                        }
                    });
                    });
                    // به‌روزرسانی یا ایجاد ردیف `tfoot`
                    let totalRow = document.querySelector('#secondaryTable tfoot #totalRow');
                    if (!totalRow) {
                        let tfoot = document.querySelector('#secondaryTable tfoot') || document.createElement('tfoot');
                        totalRow = document.createElement('tr');
                        totalRow.id = "totalRow";
                        totalRow.innerHTML = `
                    <td>براساس فیلتر</td>
                    <td id="total_sabtshodeh"></td>
                    <td id="total_taeedshodeh"></td>
                    <td id="total_maxtaeedshodeh"></td>
                `;
                        tfoot.appendChild(totalRow);
                        document.querySelector('#secondaryTable').appendChild(tfoot);
                    }

                    document.querySelector('#total_taeedshodeh').textContent = formatNumberWithCommas(overallAvgValue);
                    document.querySelector('#total_maxtaeedshodeh').textContent = formatNumberWithCommas(overallMaxValue.toFixed(0));
                }
            });
        });

        // بررسی ورودی هنگام تایپ
        $("input.form-technololghhhh").on('input', function () {
            let $input = $(this);
            let value = removeCommas($input.val());
            console.log(value);
