<script>

    var
        filtersSB = {
            filter08: null,
            filter09: null,
            filter10: null,
            filter11: null,
            filter12: null,
            filter13: null,
        };

    function updateFiltersSB() {
        $('.task-list-rowSB').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filtersSB).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filtersSB[filter] && (filtersSB[filter] != 'None') && (filtersSB[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filtersSB[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilterSB(filterName) {
        filtersSB[filterName] = this.value;
        updateFiltersSB();
    }

    // Assigned User Dropdown Filter
    $('#filter08-filter').on('input', function () {
        changeFilterSB.call(this, 'filter08');
    });
    $('#filter09-filter').on('input', function () {
        changeFilterSB.call(this, 'filter09');
    });
    $('#filter10-filter').on('input', function () {
        changeFilterSB.call(this, 'filter10');
    });
    $('#filter11-filter').on('input', function () {
        changeFilterSB.call(this, 'filter11');
    });
    $('#filter12-filter').on('input', function () {
        changeFilterSB.call(this, 'filter12');
    });
    $('#filter13-filter').on('input', function () {
        changeFilterSB.call(this, 'filter13');
    });
</script>
<script>
    // Convert Gregorian date to jaali in the table
    var tds = document.querySelectorAll("[cont-date]");
    var valueD, id, target;
    var options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    tds.forEach(td => {
        valueD = new Date(td.textContent).toLocaleDateString('fa-IR-u-nu-latn', options).replace(',', '').replace(" ", "");
        valueD = valueD.slice(0, 10) + " " + td.textContent.slice(10, 30)
        id = td.getAttribute("cont-date");
        target = document.getElementById(id);
        target.textContent = valueD;
    });
</script>
