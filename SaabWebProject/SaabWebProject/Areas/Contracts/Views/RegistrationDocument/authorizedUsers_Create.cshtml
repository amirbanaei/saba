
@{
    ViewBag.TitleLargModal = " کاربران مجاز";
    Layout = null;
}
<link href="~/MyStyles/MyStyle.css" rel="stylesheet" />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div id="formControls" >

        <div class="card">
            <div class="card-body pb-2">
                <form>
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="form-group mb-3 ">
                                <label class="form-label"> پیمان </label>
                                <div id="div_peyman1"></div>
                            </div>
                        </div>

                        <div class="col-xl-4">
                            <div class="form-group mb-3">
                                <label class="form-label"> افراد مجاز </label>
                                <span id="div_users1"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-11">

                        </div>
                        <div class="col-xl-1" >
                            <div class="form-group mb-3">
                                <button id="btnCreate" type="button" class="btn form-control buttonsabt">
                                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                                    <span class="bSabt-text">ثبت</span>
                                </button>
                            </div>
                        </div>
                    </div>

               
                </form>
            </div>

            <div class="card-arrow">
                <div class="card-arrow-top-left"></div>
                <div class="card-arrow-top-right"></div>
                <div class="card-arrow-bottom-left"></div>
                <div class="card-arrow-bottom-right"></div>
            </div>
        </div>
    </div>
}

<script>
         $("#div_users1").load('@Url.Content("/../Users/Users/_PartialViewUsersListWithSearchAndMultiple")', function () {
            $("#select_users1").attr("id", "users1");
            $("#users1").picker({ search: true });
            $("#users1").picker();
            $('#users1').picker({ search: true });
        });
        $("#div_peyman1").load('@Url.Content("/../Contracts/Peyman/_GetAllListPeymans_SingleSelect")',function(){
            console.log("hello");
            $("#select_peyman1").attr("id", "select_peyman2");
            $("#select_peyman2").picker({ search: true });
        });
</script>


<script>
    $("#btnCreate").click(function () {
        if ($("#users1").val() == 0) {
            alert("کاربران را انتخاب نمایید");
        } else if ($("#select_peyman2").val() == 0) {
            alert("پروژه را انتخاب نمایید");
        } else {
           var users = $("#users1").val();
           var things = [];      
           for(let i =0 ; i<$("#users1").val().length;i++){
               var obj =new Object();
                obj.FK_UserID = $("#users1").val()[i];
                obj.FK_PeymanID = $("#select_peyman2").val();
                things.push(obj);
           }
           console.log(things);
           things = JSON.stringify({ 'things': things });
           sendAjax('@Url.Action("authorizedUsers_Edit", "RegistrationDocument",new { area = "Contracts" })',things);
        }
    });
</script>
<script>
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
</script>
<script>
    function sendAjax(url, things) {
    
    console.log(things);
            $("#loading-message").css("display", "block");
             $.ajax({
                                    contentType: 'application/json; charset=utf-8',
                                   // dataType: 'json',
                                    type: 'POST',
                                    url: url,
                                    data: things,
                                    success: function (resp1) {
                                            console.log(resp1);
                                           $("#loading-message").css("display", "none");

                                           if (resp1 == "True") {
                                               Toast.fire({
                                                   icon: 'success',
                                                   background: '#35434A',
                                                   color: 'white',
                                                   title: "اطلاعات با موفقیت ذخیره شد"
                                               }).then(() => {
                                                   location.reload();
                                               });
                                           } else {
                                               $("#loading-message").css("display", "none");
                                               Toast.fire({
                                                   icon: 'success',
                                                   background: '#35434A',
                                                   color: 'white',
                                                   title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                                               }).then(() => {
                                                   $("#loading-message").css("display", "none");
                                               });


                                           }

                                       },
                                       error: function (resp1) {
                                                console.log(resp1);

                                           $("#loading-message").css("display", "none");
                                           Toast.fire({
                                               icon: 'success',
                                               background: '#35434A',
                                               color: 'white',
                                               title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                                           }).then(() => {
                                               $("#loading-message").css("display", "none");
                                           });
                                       }
                                   });


    }


</script>
