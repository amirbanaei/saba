
@{
    ViewBag.TitleLargModal = " پیمان ها جدید";
    Layout = null;
}
<link href="~/MyStyles/MyStyle.css" rel="stylesheet" />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div id="formControls" class="">

        <div class="card">
            <div class="card-body pb-2">
                <form>
                    <div class="row">
                        <div class="col-xl-3">
                            <div class="form-group mb-3">
                                <label class="form-label"> پیمان </label>
                                <div id="div_peyman2"></div>

                            </div>
                        </div>

                        <div class="col-xl-3">
                            <div class="form-group mb-4">
                                <label class="form-label" > عنوان </label>
                                <input class="form-control" id="Title" @*placeholder="متن را وارد نشده "*@   />
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <div class="form-group mb-3">
                                <label class="form-label"> نوع مدک </label>
                                <Select class="form-select" id="TypeOfDocument">
                                    <option value="0">انتخاب نوع مدرک...</option>
                                    <option value="1">صورت وضعیت</option>
                                    <option value="2">حقوقودستمزد</option>

                                    <option value="3">استاد سیستمی</option>
                                    <option value="4">پیشخوان</option>

                                </Select>
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <div class="form-group mb-3">
                                <label class="form-label"> مولفه کنترلی </label>
                                @Html.Action("ControllyMoalefeList_SingleSelect", "MoalefeDastMozdi", new { area = "Contracts" })

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-3">
                            <label class="form-label"> نوع کنترل </label>
                            <Select class="form-select" id="TypeOfControl">
                                <option value="0">انتخاب نوع کنترل...</option>
                                <option value="1">دستی</option>
                                <option value="2">مکانیزه</option>

                            </Select>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label"> قابلیت ثبت خلاصه مدرک </label>
                            <Select class="form-select" id="AbleToSetSummery">
                                <option value="true">دارد</option>
                                <option value="false">ندارد</option>
                            </Select>
                        </div>
                        <div class="col-xl-6">
                            <label class="form-label"> شرح </label>
                            <input class="form-control" id="Description" @*placeholder="متن را وارد نشده"*@  />
                        </div>

                    </div>
                    <div class="row">

                        <div class="col-xl-11">

                        </div>

                        <div class="col-xl-1" >
                            <div class="form-group mb-3">
                                <button id="btnCreate" type="button" class="btn form-control buttonsabt">
                                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                                    <span class="bSabt-text">ثبت</span>
                                </button>
                            </div>
                        </div>

                    </div>



                </form>
            </div>

            <div class="card-arrow">
                <div class="card-arrow-top-left"></div>
                <div class="card-arrow-top-right"></div>
                <div class="card-arrow-bottom-left"></div>
                <div class="card-arrow-bottom-right"></div>
            </div>
        </div>
    </div>
}
