@model IEnumerable<SaabWebProject.Models.DomainModels.tbDocumentsDefinitionOfDocumentTitles>

<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
@{
    Layout = null;
}
<select class="form-select select_peyman" id="select_Titles" name="select_Title" multiple="multiple">
    <option hidden value="Select">انتخاب کنید</option>
    @foreach (var item in Model.ToList())
    {
        <option value="@item.ID">@item.Title</option>
    }
</select>

<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>



<script>
    $(document).ready(function () {
        $("#select_Titles").picker({ search: true });
    });
</script>