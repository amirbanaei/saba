        function sendAjax2(url2, fd2) {
        console.log(ID);
        $("#loading-message").css("display", "block");

        // Append form data
        fd2.append("ID", ID);
        fd2.append("FK_DDOfTitle", FK_DDOfTitle);
        fd2.append("FK_PeymanID", $("#select_peyman4").val());
        fd2.append("TypeOfDocument", $("#typeOfDocument").val());
        fd2.append("Year", $("#year4").val());
        fd2.append("Month", $("#month4").val());
        fd2.append("SooratNumber", $("#soorat_number").val());

        console.log(fd2);

        // Make the AJAX call
        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                console.log("okeye");
                $("#loading-message").css("display", "none");
                fd2 = new FormData(); // Reset FormData object

                if (resp1 === "True") {

                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "اطلاعات با موفقیت آپدیت شد"
                    }).then(() => {
                        getlist();
                    });
         }
                else if (resp1 === "False") {
                    Swal.fire({
                        title: 'فایل شما مغایرت دارد آیا بازم ثبت شود ؟',
                        icon: 'question',
                        showCancelButton: true,
                        showDenyButton: true,
                        background: 'rgb(29,40,52)',
                        color: 'white',
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        denyButtonColor: '#6c757d',
                        confirmButtonText: 'بله',
                        cancelButtonText: 'خیر',
                        denyButtonText: 'مشاهده'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            Toast.fire({
                                icon: 'success',
                                background: '#35434A',
                                color: 'white',
                                title: "اطلاعات با موفقیت آپدیت شد"
                            }).then(() => {
                                getlist();
                            });

                        } else if (result.isDenied) {
                            // عملکرد مربوط به گزینه مشاهده
                            //getlist();
                            @*sendAjax5('@Url.Action("viewdetail", "RegistrationDocument",new { area = "Contracts" })');*@
                            //var url = "/RegistrationDocument/viewdetail";
                            //$("#big_modal_body1").load(url);
                            $("#myModal2").addClass("fade-in"); // Add the fade-in class
                            $("#myModal2").css("display", "block");
            $("#ss").load('@Url.Content("/Contracts/RegistrationDocument/viewdetail")');

                            // اینجا کدی که برای مشاهده باید اجرا شود را بنویسید
                        }


                        else if (result.isDismissed && result.dismiss === Swal.DismissReason.cancel) {




                            // عملکرد مربوط به گزینه خیر
                            sendAjax533('@Url.Action("deletee", "RegistrationDocument",new { area = "Contracts" })');
                            // اینجا کدی که برای گزینه "خیر" باید اجرا شود را بنویسید
                        }
                    });
                }




                else {
                    Toast.fire({
                        icon: 'error',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    });
                }
            },
            error: function (resp1) {
                console.log(resp1);
                console.log("Nokeye");
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'error',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                });
            }
        });
    }

    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#myModal2").addClass("fade-in"); // Add the fade-in class
            $("#myModal2").css("display", "block");
        });

        $(".close").click(function () {
            $("#myModal2").removeClass("fade-in"); // Remove the fade-in class
            $("#myModal2").css("display", "none");
        });

        $(window).click(function (event) {
            if (event.target == $("#myModal2")[0]) {
                $("#myModal2").removeClass("fade-in"); // Remove the fade-in class
                $("#myModal2").css("display", "none");
            }
        });
    });</script>
