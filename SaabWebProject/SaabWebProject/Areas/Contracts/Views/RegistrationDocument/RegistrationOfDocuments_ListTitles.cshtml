@model List<SaabWebProject.Models.DomainModels.tbDocuments>
@{
    Layout = null;
}
<div class="card">
    <div class="tab-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive">

                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("فعالیت")
                            </th>
                            <th>
                                @Html.DisplayName("#")
                            </th>
                            <th>
                                @Html.DisplayName("عنوان")
                            </th>
                            <th>
                                @Html.DisplayName(" خلاصه مدرک")
                            </th>
                            <th>
                                @Html.DisplayName(" پیوست مدرک")
                            </th>

                            <th>
                                @Html.DisplayName("نوع کنترل")
                            </th>
                            <th>
                                @Html.DisplayName("نوع مدرک")
                            </th>

                            <th>
                                @Html.DisplayName("وضعیت تایید مدرک")
                            </th>

                            <th>
                                @Html.DisplayName("امکان تغییر ثبت")
                            </th>

                        </tr>
                    </thead>
                    <tbody style="text-align:center;">
                        @{ int counter = 0;}
                        @foreach (var item in Model)
                        {
                            counter++;
                        <tr>
                            <td>
                                <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                    <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <div class="dropdown-menu">
                                        @if (item.SummaryDocument == null && item.doc_ableToSaveSummery == true)
                                        {
                                            <a class="dropdown-item DownloadSummery" id="DownloadSummery_@item.ID">دانلود خلاصه مدرک</a>
                                            <a class="dropdown-item uploadSummery" id="uploadSummery_@item.ID _@item.FK_DDOfTitle">
                                                <span>بارگذاری خلاصه مدرک </span>
                                            </a>

                                        }
                                        @if (item.attachment == null)
                                        {
                                            <a class="dropdown-item UploadAttachment" id="UploadAttachment_@item.ID _@item.FK_DDOfTitle">
                                                <span>بارگذاری پیوست مدرک </span>
                                            </a>

                                        }
                                        <input id="inp_file" style="display:none" type="file" class="form-control inp_file" value="" />
                                        <input id="summery_file" style="display:none" type="file" class="form-control" value="" />

                                    </div>
                                </div>
                            </td>
                            <td>@counter</td>
                            <td>@item.doc_Title</td>

                            @if (item.doc_ableToSaveSummery == true)
                            {
                                if (item.SummaryDocument != null)
                                {
                                    <td style="color:green">
                                        <a target="_blank" href="~/Areas/Contracts/Contents/RegistrationDucumentSummery/@item.SummaryDocumentSystemName">
                                            دانلود
                                        </a>
                                    </td>
                                }
                                else
                                {
                                    <td style="color:red">ذخیره نشده</td>
                                }
                            }
                            else
                            {
                                <td>بدون نیاز</td>
                            }


                            @if (item.attachment != null)
                            {
                                <td style="color:green">
                                    <a target="_blank" href="~/Areas/Contracts/Contents/RegistrationDucumentAttachmentsFile/@item.attachmentSystemName">
                                        دانلود
                                    </a>
                                </td>
                            }
                            else
                            {
                                <td style="color:red">ذخیره نشده</td>
                            }
                            @if (item.type_control == 2)
                            {
                                <td>مکانیزه</td>
                            }
                            else
                            {
                                <td>دستی</td>

                            }
                            @if (item.TypeOfDocument == 1)
                            {
                                <td>صورت وضعیت</td>
                            }
                            else if (item.TypeOfDocument == 2)
                            {
                                <td>حقوق و دست مزد</td>
                            }
                            else if (item.TypeOfDocument == 3)
                            {
                                <td>اسناد سیستمی</td>

                            }
                            else if (item.TypeOfDocument ==43)
                            {
                                <td>پیشخوان</td>

                            }
                            @if (item.IsAccepted == true)
                            {
                                <td><i class="bi bi-brightness-high-fill" style="color:green" title="تایید شده"></i></td>
                            }
                            else if (item.IsAccepted == false)
                            {
                                <td><i class="bi bi-brightness-high-fill" style="color:red" title="رد شده"></i></td>
                            }
                            else
                            {
                                <td>بررسی نشده</td>
                            }

                            @if (item.IsAccepted == true)
                            {
                                <td><i class="bi bi-ckeck-circle" style="color:red"></i></td>
                            }
                            else
                            {
                                <td><i class="bi bi-check-circle" style="color:green"></i></td>
                            }
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>