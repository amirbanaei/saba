@model List<SaabWebProject.Models.DomainModels.tbDocumentsDefinitionOfDocumentTitles>

@{
    Layout = null;
}
<div class="card">
    <div class="table-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive tableH_Lock">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("فعالیت")
                            </th>
                            <th>
                                @Html.DisplayName("#")
                            </th>
                            <th>
                                @Html.DisplayName("عنوان")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("توضیحات")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter04-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("نوع کنترل")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter05-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("مولفه کنترلی متناظر")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter06-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("پیمان ها")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter07-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>


                        </tr>
                    </thead>
                    <tbody style="text-align:center;">
                        @{ var counter = 0;
                            string noekontrol = "";
                        }
                        @foreach (var item in Model)
                        {
                            counter += 1;
                            switch (item.TypeOfControl)
                            {
                                case 1:
                                    noekontrol = "دستی";
                                    break;

                                case 2:
                                    noekontrol = "مکانیزه";
                                    break;

                                default:
                                    noekontrol = "نامعلوم";
                                    break;
                            }
                            <tr class="task-list-rowT"
                                data-filter03="@item.Title"
                                data-filter04="@item.Description"
                                data-filter05="@noekontrol"
                                data-filter06="@item.tbContractMoalefeDastmozdi.md_Title"
                                data-filter07="@item.tbPeymanContracts.pec_Title">
                                <td>
                                    <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                        <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <div class="dropdown-menu">
                                            <a data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item edit" id="Edit_@item.ID">ویرایش</a>
                                        </div>

                                    </div>
                                </td>
                                <td>@counter</td>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td>
                                    @noekontrol
                                </td>
                                <td>@item.tbContractMoalefeDastmozdi.md_Title</td>
                                <td>@item.tbPeymanContracts.pec_Title</td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script>
    var
        filtersT = {
            filter03: null,
            filter04: null,
            filter05: null,
            filter06: null,
            filter07: null,
        };

    function updateFiltersT() {
        $('.task-list-rowT').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filtersT).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filtersT[filter] && (filtersT[filter] != 'None') && (filtersT[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filtersT[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilterT(filterName) {
        filtersT[filterName] = this.value;
        updateFiltersT();
    }

    // Assigned User Dropdown Filter
    $('#filter03-filter').on('input', function () {
        changeFilterT.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilterT.call(this, 'filter04');
    });
    $('#filter05-filter').on('input', function () {
        changeFilterT.call(this, 'filter05');
    });
    $('#filter06-filter').on('input', function () {
        changeFilterT.call(this, 'filter06');
    });
    $('#filter07-filter').on('input', function () {
        changeFilterT.call(this, 'filter07');
    });

</script>
<script>
      $(".edit").click(function () {
                                        var idd = $(this).attr("id").split("_")[1];
        $("#big_modal_body").load('@Url.Content("/RegistrationDocument/DefinitionOfDocumentTitles_Update")?ID='+idd);
                                    });
</script>
