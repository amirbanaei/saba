
@model SaabWebProject.Models.DomainModels.tbDocumentsDefinitionOfDocumentTitles

@{
    ViewBag.TitleLargModal = " ";
    Layout = null;
}
<link href="~/MyStyles/MyStyle.css" rel="stylesheet" />


    <div id="formControls" class="">

        <div class="card">
            <div class="card-body pb-2">
                <form>
                    <div class="row">
                        <div class="col-xl-3">
                            <div class="form-group mb-3">
                                <label class="form-label"> پیمان </label>
                                <input class="form-control" disabled value="@Model.tbPeymanContracts.pec_Title" />

                            </div>
                        </div>

                        <div class="col-xl-3">
                            <div class="form-group mb-4">
                                <label class="form-label"> عنوان </label>
                                <input class="form-control" id="Title" value="@Model.Title"  />
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <div class="form-group mb-3">
                                <label class="form-label"> نوع مدک </label>
                                <Select class="form-select" id="TypeOfDocument">
                                    <option value="0">انتخاب نوع مدرک...</option>
                                    <option value="1">صورت وضعیت</option>
                                    <option value="2">حقوقودستمزد</option>option>
                                    <option value="3">استاد سیستمی</option>
                                    <option value="4">پیشخوان</option>

                                </Select>
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <div class="form-group mb-3">
                                <label class="form-label"> مولفه کنترلی </label>
                                @Html.Action("ControllyMoalefeList_SingleSelect", "MoalefeDastMozdi", new { area = "Contracts" })

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-3">
                            <label class="form-label"> نوع کنترل </label>
                            <Select class="form-select" id="TypeOfControl">
                                <option value="0">انتخاب نوع کنترل...</option>
                                <option value="1">دستی</option>
                                <option value="2">مکانیزه</option>
                            </Select>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label">  قابلیت ثبت خلاصه مدرک </label>
                            <Select class="form-select" id="AbleToSetSummery2">

                                @if (Model.AbleToSetSummery == true)
                                {
                                    <option value="true">دارد</option>
                                    <option value="false">ندارد</option>
                                }
                                else
                                {
                                    <option value="false">ندارد</option>
                                    <option value="true">دارد</option>
                                }
                            </Select>
                        </div>
                        <div class="col-xl-6">
                            <label class="form-label"> شرح </label>
                            <input class="form-control" id="Description" value="@Model.Description" />
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-xl-11">

                        </div>
                        <div class="col-xl-1" style="margin-top: 30px;">
                            <div class="form-group mb-3">
                                <button id="btnCreate" type="button" class="btn form-control buttonsabt">
                                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                                    <span class="bSabt-text">ثبت</span>
                                </button>
                            </div>
                        </div>
                    </div>


                </form>
            </div>

            <div class="card-arrow">
                <div class="card-arrow-top-left"></div>
                <div class="card-arrow-top-right"></div>
                <div class="card-arrow-bottom-left"></div>
                <div class="card-arrow-bottom-right"></div>
            </div>
        </div>
    </div>


    <script>
            $("#TypeOfDocument").val(@Model.TypeOfDocument);
        $("#TypeOfControl").val(@Model.TypeOfControl);
 
            $("#ControllyMoalefe1").picker('set', @Model.FK_MoalefeControll)
    </script>


<script>
    $("#btnCreate").click(function () {
        if ($("#title").val() == 0) {
            alert("کاربران را انتخاب نمایید");
        }  else {
            console.log($("#ControllyMoalefe1").val());
               var obj =new Object();
                obj.Title = $("#Title").val();
                obj.TypeOfDocument = $("#TypeOfDocument").val();
                obj.FK_MoalefeControll = $("#ControllyMoalefe1").val();
                obj.TypeOfControl = $("#TypeOfControl").val();
                obj.Description = $("#Description").val();
            obj.ID = @Model.ID;
            obj.AbleToSetSummery = $("#AbleToSetSummery2").val();
           sendAjax('@Url.Action("DefinitionOfDocumentTitles_Edit", "RegistrationDocument",new { area = "Contracts" })',obj);
        }
    });
</script>

<script>
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
</script>

<script>
    function sendAjax(url, things) {
        $("#loading-message").css("display", "block");
        $.ajax({
            url: url,
                data: { things: things },
                type: "Post",
                dataType: "html",
            success: function (resp1) {
                console.log(resp1);
                $("#loading-message").css("display", "none");

                if (resp1 == "True") {
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "اطلاعات با موفقیت ذخیره شد"
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });


                }

            },
            error: function (resp1) {
                console.log(resp1);

                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });


    }


</script>