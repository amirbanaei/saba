    function sendAjax2(url2, fd2) {

        fd2.append("MoalefeID", $("#MoalefeID").val());
        fd2.append("Year", $("#Year345").val());
        fd2.append("Month", $("#Month455").val());

        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                console.log("okeye");
                console.log(resp1);
                $("#loading-message").css("display", "none");
                fd = new FormData();
                $(".mytable").html(resp1); // دریافتی از بک‌اند را در المان با کلاس myTable نمایش دهید

            },
            error: function (resp1) {
                console.log(resp1);
                console.log("Nokeye");
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });
    }

    var fd = new FormData();
        //----------------------------------------------------------------
    $("#btnShow").click(function () {
        console.log($("#Month455").val());
        console.log($("#Year345").val());

            if ($("#MoalefeID").val() == 0) {
                alert("لطفا مولفه را انتخاب کنید");
            }
            else if ($("#Month455").val() == 0) {
                alert("لطفا ماه را انتخاب کنید");
            }
            else if ($("#Year345").val() == 0) {
                alert("لطفا سال را انتخاب کنید");
