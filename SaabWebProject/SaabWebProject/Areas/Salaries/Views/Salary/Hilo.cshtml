<script>
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });

    function DownloadExcel3() {
    $.ajax({
        beforeSend: function () {
            document.getElementById("loading-message").style.display = "block";
        },
        // از داده‌های دریافتی با Ajax استفاده کنید
        @*url: '@Url.Action("ExportMoalefeExcel4", "Moalefe", new { area = "Salaries" })',*@
        type: 'GET',
        dataType: 'html',
        success: function (res) {
            console.log($("#Month455").val());
            console.log($("#Year345").val());

            document.getElementById("loading-message").style.display = "none";
            // از داده‌های دریافتی با Ajax استفاده کنید
            var url = '@Url.Action("ExportMoalefeExcel8", "Moalefe", new { area = "Salaries" })';
            url += '?MoalefeID=' + $("#MoalefeID").val() + '&Year=' + $("#Year345").val() + '&Month=' + $("#Month455").val();
            window.location = url;
        },
        error: function (res) {
            alert("fdslsfdk"); // تغییر از alart به alert
            console.log(res);
        }
    });
    }
