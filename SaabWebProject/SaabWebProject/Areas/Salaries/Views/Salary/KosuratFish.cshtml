@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />

<div class="row">
    <div class="col-xl-3">
        <label class="form-label"> کاربر </label>
        <span id="users"></span>
    </div>
    <div class="col-xl-3">
        <label class="form-label">مبلغ</label>
        <input class="form-control" id="value"/>
    </div>
    <div class="col-xl-3">
        <label class="form-label">ماه</label>
        <select class="form-select my_Select" id="Month">
            <option value="0">انتخاب مورد</option>
            <option value="1">فروردین</option>
            <option value="2">اردیبهشت</option>
            <option value="3">خرداد</option>
            <option value="4">تیر</option>
            <option value="5">مرداد</option>
            <option value="6">شهریور</option>
            <option value="7">مهر</option>
            <option value="8">آبان</option>
            <option value="9">آذر</option>
            <option value="10">دی</option>
            <option value="11">بهمن</option>
            <option value="12">اسفند</option>
        </select>
    </div>
    <div class="col-xl-3">
        <div class="col-xl-12">
            <label class="form-label">سال</label>
        </div>
        <div class="col-xl-12">
            <div class="col-xl-12">
                <select class="form-select" id="Year">
                    <option value="0">انتخاب کنید</option>

                    @{
                        System.Globalization.PersianCalendar cs2 = new System.Globalization.PersianCalendar();
                        int currentYear = cs2.GetYear(DateTime.Now);

                        for (var i = 4; i >= 0; i--)
                        {
                            var s = DateTime.Now.AddYears(-i);

                            <option value="@cs2.GetYear(s)">@cs2.GetYear(s)</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-xl-11"></div>
    <div class="col-xl-1">
        <button class="btn form-control buttonsabt" id="btnSave11">
            <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
            <span class="bSabt-text">ثبت</span>
        </button>
    </div>
</div>


<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Scripts/popper.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
      $("#users").load('@Url.Content("/Users/Users/_GetAllUsers_Select")',function(){
          $('#select_users').attr("id","UserID");

        });
    });
</script>
<script>
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
    function sendAjax2(url2, fd2) {
        //int UserID, int Month, int Year, float value
        fd2.append("UserID", $("#UserID").val());
        fd2.append("value", $("#value").val());
        fd2.append("Year", $("#Year").val());
        fd2.append("Month", $("#Month").val());

        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                console.log("okeye");
                console.log(resp1);
                $("#loading-message").css("display", "none");
                fd = new FormData();
                if (resp1 == "True") {
                    alert("با موفقیت ثبت شد");
                    location.reload();
                }
                else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });
                }

            },
            error: function (resp1) {
                console.log(resp1);
                console.log("Nokeye");
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });
    }
</script>
<script>
    var fd = new FormData();
        //----------------------------------------------------------------
        $("#btnSave11").click(function () {
            if ($("#UserID").val() == 0) {
                alert("لطفا کاربر را انتخاب کنید");
            }
            else if ($("#value").val() == 0) {
                alert("لطفا مبلغ را انتخاب کنید");
            }
            else if ($("#Month").val() == 0) {
                alert("لطفا ماه را انتخاب کنید");
            }
            else if ($("#Year").val() == 0) {
                alert("لطفا سال را انتخاب کنید");
            }

           else {
             sendAjax2('@Url.Action("SetAddorReduceKarkard", "Formula", new { area = "Salaries" })',fd);
           };
         });

</script>


