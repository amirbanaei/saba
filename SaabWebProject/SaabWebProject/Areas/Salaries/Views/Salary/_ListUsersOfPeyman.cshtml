@model IEnumerable<SaabWebProject.Models.DomainModels.tbUsers>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<label class="form-label"> کاربر مورد نظر  </label>
<select class="form-select select_peyman" id="UserOfPeyman" name="select_UserOfPeyman" multiple="multiple">
    <option value="Select">انتخاب کنید</option>
    @foreach (var item in Model)
    {
        <option value="@item.usr_ID">@item.FullName</option>
    }
</select>

<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script>
    $("#UserOfPeyman").picker({ search: true });
</script>
