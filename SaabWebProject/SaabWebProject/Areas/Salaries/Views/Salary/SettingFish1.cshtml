        padding: 15px;
    }

    ul.nav-tabs {
        position: absolute;
        top: -64px;
        right: 197px;
    }

    .tab-content {
        border: 1px solid #05c6c8 !important;
    }

    .nav-link {
        position: relative
    }

    .toolTipTab {
        visibility: hidden;
        background: var(--bs-tab-content-bg) !important;
        /*        background: #06c6c85e;
        backdrop-filter: blur(10px);*/
        padding: 6px 10px;
        border-radius: 13px 13px 0px 13px;
        top: -38px;
        right: 28px;
        width: max-content;
        opacity: 0;
        transition: opacity 0.3s;
        position: absolute;
        border: 1px solid #06c7c95e !important;
    }

        .nav-item:hover .toolTipTab {
            visibility: visible;
            display: block;
            opacity: 1;
        }


</style>
<style>
    .responsive {
        font-size: 10px !important;
