@section Scripts{

    <script>

        $("#btnCalculateFishQatee").click(function () {


            var year = $("#YearSelect").val();
            var month = $("#MonthSelect").val();



          $.ajax({
                url: "@Url.Action("CalculateFormula", "Formula",new {area="Salaries"})",
                type: "Post",
                dataType: "html",
              data: { Month: month, Year: year },
                success: function (res) {
                    document.getElementById("loading-message").style.display = "none";


                    $("#big_modal_body").html(res)
                    $("#modalLg").modal('show')

                },
                error: function (res) {
                    console.log(res);

                    document.getElementById("loading-message").style.display = "none";
                    Toast.fire({
                        icon: 'error',
                        background: '#35434A',
                        color: 'white',
                        title: "عملیات  با خطا مواجه شد"
                    });
                    return false;
                }
            })
    })

    </script>

    <script>
        $('#Total').click(function () {
            if ($('#Total').is(':checked')) {

                $("#ToPersonalCode").css('display', 'none');
                $("#FromPersonalcode").css('display', 'none');
                $("#topersonaldiv").css('display', 'none');
                $("#frompersonaldiv").css('display', 'none');

            }
        });
        $('#Customize').click(function () {
            if ($('#Customize').is(':checked')) {

                $("#FromPersonalcode").css('display', 'block');
                $("#ToPersonalCode").css('display', 'block');
                $("#topersonaldiv").css('display', 'block');
                $("#frompersonaldiv").css('display', 'block');



            }
        });
    </script>

