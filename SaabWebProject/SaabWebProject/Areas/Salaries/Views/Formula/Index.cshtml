    function CheckOperator(input) {
        var data = input;
        switch (data) {
            case "SmallerThan": {
                data = "<";
                break;
            }
            case "BiggerThan": {
                data = ">";
                break;
            }
            case "Contrary": {
                data = "!=";
                break;
            }
            case "Equal": {
                data = "=";
                break;
            }
            default: {
                data = "";
            }
        }
        return data;
    }

