    function check(input) {
        var data = input;
        switch (data) {
            case "plus": {
                data = "+";
                break;
            }
            case "minus": {
                data = "-";
                break;
            }
            case "divide": {
                data = "/";
                break;
            }
            case "multiplication": {
                data = "*";
                break;
            }
            default: {
                data = "";
            }
        }
        return data;
    }
    function checkName(input) {
        var data = input;
        switch (data) {
            case "+": {
                data = "plus";
                break;
            }
            case "-": {
                data = "minus";
                break;
            }
            case "/": {
                data = "minus";
                break;
            }
            case "*": {
                data = "multiplication";
                break;
            }
        }
        return data;
    }

