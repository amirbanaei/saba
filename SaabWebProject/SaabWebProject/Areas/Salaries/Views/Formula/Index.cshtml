                        $("#moalefedastmozdi").picker('set', moalefe);
                    }
                    $("#big_modal_body").html(result);

                },
                error:function (){
                   document.getElementById("loading-message").style.display = "none";
                   Toast.fire({
                       icon: 'error',
                       background: '#35434A',
                       color: 'white',
                       title: "عملیات با خطا مواجه شد"
                    });
                }
            });
        }
        else {
            Toast.fire({
                icon: 'warning',
                background: '#35434A',
                color: 'white',
                title: "لطفا یک عملگر را انتخاب کنید"
            });
        }


    });


    $("#clearall").click(function() {

        if (list_moalefeha.length >= 1) {

            list_moalefeha = [];
            list_moalefeha_farsi = [];
            List_If_False = [];
            List_If_False_persian = [];
            List_If_True = [];
            List_If_True_persian = [];
            $("#textbox-calc").val(null);

        }

    });

</script>
