

@{
    ViewBag.Title = "محاسبه گر";
    // Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = null;

}
<link href="assets/plugins/bootstrap-table/dist/bootstrap-table.min.css" rel="stylesheet" />
<style>


    /*scroll bar custom css*/
    /* width */
    ::-webkit-scrollbar {
        width: 3px;
    }

    /* Track */
    ::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    /* Handle */
    ::-webkit-scrollbar-thumb {
        background: #888;
    }

        /* Handle on hover */
        ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    /*content css*/
    .box-formula:focus {
        outline: none;
    }

    .td-formula {
        padding: 15px;
        width: 310px;
    }

    .tr-formula {
        margin-top: 5px;
        cursor: pointer;
    }

    .style-class {
        text-align: center;
        margin-top: 10px;
        width: 100%;
        height: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        color: white;
        transition: 0.5s all;
    }

        .style-class:hover {
            transform: scale(1.1, 1.1);
            box-shadow: -2px 1px 20px 0px #363636;
        }
</style>
<div>
    <div class="row">
        <input id="textbox-calc" value=" " disabled type="text" class="box-formula border text-white rounded" style="background:none;padding:10px;border:none;width:100%;height:50px;font-size:15px;" dir="rtl" />
    </div>
    <div class="row" dir="rtl">
        <div class="col-md-4" style="text-align: center;">
            @Html.Action("Create56", "Formula", new { area = "Salaries" })
        </div>
        <div class="col-md-4" style="text-align:center;">
            <select id="moalefeSelector" class="form-control" style="margin-bottom:10px;">
                <option value="0">مولفه ها</option>
                <option value="1">کاربران حقوقی۱</option>
                <option value="2">پیمان ها</option>
                <option value="3">شغل </option>
                <option value="4">شهرستان</option>
                <option value="5">قرارداد پرسنل</option>
                <option value="6">تجهیزات</option>
                <option value="7"> بودجه</option>
                <option value="8">سایر عملیات صورت وضعیت</option>

                <option value="9"> تراز فیش</option>
                <option value="10">مولفه های فرمول</option>
                <option value="11">اقساط</option>
                <option value="12">معادل کار</option>

                <!-- گزینه‌های دیگر -->
            </select>

            <div id="moalefeContainer">
                @Html.Action("GetAllMoalefeForFormulasbyid", "MoalefeDastMozdi", new { area = "Contracts" })
            </div>
            @*@Html.Action("GetAllMoalefeForFormulas", "MoalefeDastMozdi", new { area = "Contracts" })*@
        </div>
        <div class="col-md-4" style="text-align:center;">
            @Html.Action("GetAllFormula", "Formula", new { area = "Salaries" })
        </div>

    </div>
</div>

<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="assets/plugins/bootstrap-table/dist/bootstrap-table.min.js"></script>
<script src="~/Scripts/sweetalert2.js" type="text/javascript"></script>
<script>
    document.getElementById("moalefeSelector").addEventListener("change", function () {
        var selectedId = this.value;

        fetch(`/Contracts/MoalefeDastMozdi/GetAllMoalefeForFormulasById?id=${selectedId}`)
            .then(response => response.text())
            .then(html => {
                document.getElementById("moalefeContainer").innerHTML = html;
            })
            .catch(error => {
                console.error("خطا در بارگذاری:", error);
            });
    });
</script>



