@using SaabWebProject.Models.DomainModels;
@{
    SaabEntities db = new SaabEntities();
    ViewBag.Title = "تولید گزارش ساز ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- انتخاب گزارش -->
<select class="form-select select_peyman" id="select_peyman" name="select_peyman">
    <option hidden value="Select">انتخاب مورد</option>
    @foreach (var item in db.TBGOZARESHSAZ1_Creat.Where(s => s.NAME != null && s.QURY_SQL != null).ToList())
    {
        <option value="@item.ID" data-sql="@item.QURY_SQL">@item.NAME</option>
    }
</select>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- دکمه اضافه کردن تنظیمات -->
<button type="button" class="btn btn-success mt-2" id="addConfig">➕ افزودن تنظیم</button>

<div id="selectorsContainer" class="mt-3"></div>

<!-- ذخیره تنظیم -->
<button type="button" class="btn btn-primary mt-3" id="saveConfigs">💾 ذخیره تنظیمات</button>

<script>
    let selectedGozareshId = null;
    let currentSelectOptions = [];

    $('#select_peyman').on('change', function () {
        selectedGozareshId = $(this).val();

        if (!selectedGozareshId || selectedGozareshId === 'Select') return;

        // گرفتن ستون‌ها از دیتابیس
        $.ajax({
            url: '/Salaries/Formula/GetSelectedColumns',
            type: 'GET',
            data: { id: selectedGozareshId },
            success: function (res) {
                currentSelectOptions = res;

                console.log("ستون‌های دریافتی:", currentSelectOptions);
            },
            error: function () {
                alert("خطا در بارگذاری ستون‌ها.");
            }
        });
    });


    // اضافه کردن یک سطر تنظیم
    $('#addConfig').on('click', function () {
        console.log(selectedGozareshId);
        console.log(currentSelectOptions);

        if (!selectedGozareshId || currentSelectOptions.length === 0) {
            alert('ابتدا یک گزارش انتخاب کنید.');
            return;
        }

        let row = `
<div class="row setting-row mb-2">
    <div class="col-md-3">
        <select class="form-select radif-select">
            <option hidden>ردیف</option>
            ${currentSelectOptions.map(o => `<option value="${o.full}" data-table="${o.table}">${o.full}</option>`).join('')}
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select soton-select">
            <option hidden>ستون</option>
            ${currentSelectOptions.map(o => `<option value="${o.full}" data-table="${o.table}">${o.full}</option>`).join('')}
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select value-select">
            <option hidden>مقدار</option>
            ${currentSelectOptions.map(o => `<option value="${o.full}" data-table="${o.table}">${o.full}</option>`).join('')}
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-danger remove-row">❌</button>
    </div>
</div>`;

        $('#selectorsContainer').append(row);
    });

    // حذف سطر
    $(document).on('click', '.remove-row', function () {
        $(this).closest('.setting-row').remove();
    });

    // ذخیره تنظیمات
// ذخیره تنظیمات
$('#saveConfigs').on('click', function () {
    let data = [];

    $('.setting-row').each(function () {
        // گرفتن ستون‌ها از سلکت‌ها
        let radifFull = $(this).find('.radif-select').val();
        let sotonFull = $(this).find('.soton-select').val();
        let valueFull = $(this).find('.value-select').val();

        // استخراج فقط نام ستون نهایی
        let radif = radifFull.split('.').pop();
        let soton = sotonFull.split('.').pop();
        let value = valueFull.split('.').pop();

        let radifTable = $(this).find('.radif-select option:selected').data('table');
        let sotonTable = $(this).find('.soton-select option:selected').data('table');
        let valueTable = $(this).find('.value-select option:selected').data('table');
        console.log(radifTable);
        console.log(valueTable);
        console.log(valueFull);
        console.log(sotonFull);
        console.log(radifFull);
        console.log(value);
        console.log(soton);
        console.log(radif);
        if (radif && soton && value) {
            data.push({
                FK_GOZARSH1: selectedGozareshId,
                RADIF: radif,
                TABLENAEM_RADIF: radifTable,
                SOTON: soton,
                SOTON_NAME: sotonTable,
                Value: value,
                Value_NAME: valueTable
            });
        }
    });

    if (data.length === 0) {
        alert("هیچ داده‌ای برای ذخیره وجود ندارد.");
        return;
    }
    console.log(data);

    $.ajax({
        type: 'POST',
        url: '@Url.Action("SaveGozaresh3", "Formula", new { area = "Salaries" })',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: function (res) {
            alert(res);
            $('#selectorsContainer').empty();
        }
    });
});
</script>
