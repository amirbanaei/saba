    }

    var divs = document.querySelectorAll("[ClassI_I]");
    var i = 0;
    var id;
    divs.forEach(div => {
        console.log(divs[i].classList[1])
        id = div.getAttribute("ClassI_I");
        setTimeout(showNextDiv.bind(null, id), (i + 1) * delay);
        i++
    });
</script>
