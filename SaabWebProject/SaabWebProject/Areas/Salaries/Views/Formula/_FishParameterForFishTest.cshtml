<div id="DetailModal" style="margin-top:10px">

</div>
<script>
    var ISRoozMozd = true;
    $('#RoozMozd').click(function () {
        if ($('#RoozMozd').is(':checked')) {

            $("#InputsForRoozMozd").css('display', 'block');
            $("#InputsForKarMozd").css('display', 'none');
        }
    });
    $('#KarMozd').click(function () {
        if ($('#KarMozd').is(':checked')) {

            $("#InputsForRoozMozd").css('display', 'none');
            $("#InputsForKarMozd").css('display', 'block');
            ISRoozMozd = false;

        }
    });


       $("#Calculate").click(function () {
           var obj = new Object();
           obj.tedadrooz = $("#tedadrooz_RoozMozd").val();
           obj.tedadroozQeybat = $("#tedadroozQeybat_RoozMozd").val();
           obj.tedadroozStelaji = $("#tedadroozStelaji_RoozMozd").val();
           obj.tedadsaatEzafeKar = $("#tedadsaatEzafeKar_RoozMozd").val();
           obj.tedadroozMamoriat = $("#tedadroozMamoriat_RoozMozd").val();
           obj.teadadsaatKasrekar = $("#teadadsaatKasrekar_RoozMozd").val();
           obj.jamezafat = $("#jamezafat_RoozMozd").val();
           obj.jambedehiha = $("#jambedehiha_RoozMozd").val();
           obj.qestbimetakmili=$("#qestbimetakmili_RoozMozd").val();
           obj.ayabozahab=$("#ayabozahab_RoozMozd").val();

           var objkarmozd = new Object();
           objkarmozd.MoadelKarkard = $("#MoadelKarkard_KarMozd").val();
           objkarmozd.tedadroozkarkard = $("#tedadroozkarkard_KarMozd").val();
           objkarmozd.tedadroozQeybat = $("#tedadroozQeybat_KarMozd").val();
           objkarmozd.tedadroozStelaji = $("#tedadroozStelaji_KarMozd").val();
           objkarmozd.tedadroozMamoriat = $("#tedadroozMamoriat_KarMozd").val();
           objkarmozd.jamezafat = $("#jamezafat_KarMozd").val();
           objkarmozd.jambedehiha = $("#jambedehiha_KarMozd").val();
           objkarmozd.teadaroozjome = $("#teadaroozjome_KarMozd").val();
           objkarmozd.tedadrooztatil = $("#tedadrooztatil_KarMozd").val();
           objkarmozd.qestbimetakmili=$("#qestbimetakmili_KarMozd").val();
           objkarmozd.ayabozahab=$("#ayabozahab_KarMozd").val();
        var users = $("#select_users1");
           var Year = $("#Year").val();
           var Month = $("#Month").val();


        if (users.val().length == 0) {
            $("#buttons").css("display","none");

            Toast.fire({
                icon: 'warning',
                background: '#35434A',
                color: 'white',
                title: "لطفا کاربر را انتخاب کنید !!"
            });
        }
        else {
        $("#buttons").css("display","block");
            document.getElementById("loading-message").style.display = "block";
            $.ajax({
                url: "@Url.Action("CalculateFishTest", "Formula",new {area="Salaries"})",
                type: "Post",
                dataType: "html",
                data: { UserID: users.val(), ISRoozMozd: ISRoozMozd, roozMozdParam: obj, karMozdParam: objkarmozd, Year: Year,Month:Month },
                success: function (res) {
                    document.getElementById("loading-message").style.display = "none";


                    $("#DetailModal").html(res);
                    /*$('#modalLgDetail').modal('show');*/
                   /* $("#BodyCalc").html(res);*/
                },
                error: function (res) {
                    console.log(res);

                    document.getElementById("loading-message").style.display = "none";
                    Toast.fire({
                        icon: 'error',
                        background: '#35434A',
                        color: 'white',
                        title: "عملیات  با خطا مواجه شد"
                    });
                    return false;
                }
            })

        }




    });
</script>

<script>
