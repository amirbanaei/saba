    function markAsChanged(input) {
        input.dataset.changed = true; // Mark input as changed
    }

    document.getElementById("ButtonRe").addEventListener("click", function () {
        var changedInputs = document.querySelectorAll("input[data-changed='true']");

        // Prepare data to send
        var data = [];
        for (var i = 0; i < changedInputs.length; i++) {
            var input = changedInputs[i];
            var userId = input.id;
            var value = input.value;
            var fullName = input.parentElement.previousElementSibling.textContent;
            var year = input.parentElement.nextElementSibling.textContent;
            var month = input.parentElement.nextElementSibling.textContent;
            var moalefeID = input.parentElement.nextElementSibling.nextElementSibling.textContent;

            data.push({
                FullName: fullName,
                UserID: userId,
                Value: value,
                Year: year,
                Month: month,
                MoalefeID: moalefeID,
            });
        }

        // Send data using appropriate method (e.g., AJAX, form submission)
        console.log(data); // Example: Print submitted data in the console
        // Send data to your server-side code here

        $.ajax({
            type: "POST",
            url: "/Salaries/Formula/getEditeHiLo",
            data: JSON.stringify(data),
            contentType: "application/json",
            success: function (response) {
                // Handle success response
                console.log(response);
            },
            error: function (xhr, status, error) {
                // Handle error response
                console.log(xhr.responseText);
            }
        });
    });
</script>

