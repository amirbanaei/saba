@model List<SaabWebProject.Models.DomainModels.tbContractMoalefeDastmozdi>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" type="text/css" />
<div>
    <div class="row">
        <div class="col-md-12" style="margin-top: 10px;">
            <select class="form-control" id="select_moalefe">
                @foreach (var item in Model)
                {
                    var s = item.md_Type + "_" + item.md_ID;

                    <option value="@s">@item.md_Title ( @item.md_Type.GetTypeOfMoalefe() ) </option>
                }
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12" style="margin-top:10px;">
            <input type="button" value="ذخیره" class="btn btn-outline-success" id="save" style="float:left;" />
        </div>
    </div>
</div>
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js" type="text/javascript"></script>
<script>
    $("#select_moalefe").picker();
    $("#save").click(function () {

        var val = list_moalefeha_farsi[list_moalefeha_farsi.length - 1];

        var select_moalefe = document.getElementById("select_moalefe");
        var datetime_exits = $("#datetime_exists").val();
        var datetime_exists_en = $("#datetime_exists_en").val();

        list_moalefeha_farsi.push(datetime_exits + " " + "(" + select_moalefe.selectedOptions[0].innerText + " " + ")");
        list_moalefeha.push(datetime_exists_en + "(" + select_moalefe.value + ")");


        var textbox = $("#textbox-calc");
        textbox.val(textbox.val() + " " + datetime_exits + " " + "(" + " " + select_moalefe.selectedOptions[0].innerText + ")");
        $(".modal-dialog").css("display", "none");
        $(".modal-backdrop").hide();

    });

</script>