@model SaabWebProject.Models.ViewModels.Salaries.Formula.ManualFishDetail
@using SaabWebProject.Models.DomainModels
@{ SaabEntities db = new SaabEntities();

}
@{
    var tb = db.tbMoalefeDastmozdiValueFromExcel
        .Where(p => p.tbUsers.usr_Personal_ID == Model.FishHeader.PersonalCode
                    && p.MoalfeVal_Year == Model.FishHeader.year
                    && p.MoalfeVal_Value != 0
                    && p.MoalfeVal_Month == Model.month)
        .ToList();
    long day = 0;
    List<string> mode = new List<string>();
    List<string> mode2 = new List<string>();

    var findusr = db.tbUsers.Where(s => s.usr_Personal_ID == Model.FishHeader.PersonalCode).FirstOrDefault();
    if (findusr != null)
    {
        var findmoadel = db.tbMoadelPadashJarimeAyab.Where(s => s.UserID == findusr.usr_ID && s.Year == Model.FishHeader.year && s.Month == Model.month && s.Moadel < 1).FirstOrDefault();
        if (findmoadel != null)
        {
            if (Model.month < 7)
            {
                day = (long)(findmoadel.Moadel * 31);
            }
            else if (Model.month < 12 && Model.month > 6)
            {
                day = (long)(findmoadel.Moadel * 30);
            }
            else
            {
                day = (long)(findmoadel.Moadel * 29);


            }
            mode2.Add($"کارکرد شما در این ماه معادل <span style='color:red;'>{day}</span> روز کاری بوده است و در صورت تکرار کسر کار و جریمه متناسب اعمال می‌گردد.");

        }




    }
    string nameint = "";
    var findstrimg = db.tbDetailFish.Where(s => s.month == Model.month && s.year == Model.FishHeader.year && s.FK_usr == findusr.usr_ID).FirstOrDefault();
    if (findstrimg != null)
    {
        nameint = findstrimg.sharh;
    }

    foreach (var it in tb)
    {
        var y = db.tbCaranSettings
            .Where(p => p.FK_Moalefe_ID == it.MoalfeVal_FKMoalafeDastmozdi && p.CaranStandard != 0)
            .FirstOrDefault();

        if (y == null)
        {
            var u = db.tbCaranSettings
                .Where(p => p.FK_Moalefe_ID == it.MoalfeVal_FKMoalafeDastmozdi && p.CaranAyabOZahab != 0)
                .FirstOrDefault();

            if (u != null)
            {
                //mode.Add($"{it.tbContractMoalefeDastmozdi.md_Title} ( {Convert.ToDecimal(u.CaranAyabOZahab).ToString("F2")}/ 0 /{Convert.ToDecimal(it.MoalfeVal_Value).ToString("F2")} )----");

                mode.Add($"{it.tbContractMoalefeDastmozdi.md_Title} ( {Convert.ToInt64(u.CaranAyabOZahab)}/ 0 /{it.MoalfeVal_Value} )----");
            }
        }
        else
        {
            mode.Add($"{it.tbContractMoalefeDastmozdi.md_Title} ( {Convert.ToInt64(y.CaranAyabOZahab)}/ {Convert.ToInt64(y.CaranStandard)} /{it.MoalfeVal_Value} )---");
        }
    }




}
