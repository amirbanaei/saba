    $(function () {
        $(".numbers").each(function () {
            var number = parseFloat($(this).text().replace(/,/g, ""));
            if (!isNaN(number)) {
                number = Math.round(number); // رند به نزدیک‌ترین عدد صحیح
                $(this).text(number.toLocaleString('en-US'));
            }
        });
    });
</script>
