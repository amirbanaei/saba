            @{
                PersianCalendar pc = new PersianCalendar();

                int shYear = Model.FishHeader.year;   // 1404
                int shMonth = Model.month;            // 8 (آبان)

                // تاریخ شروع ماه شمسی
                DateTime startDate = pc.ToDateTime(shYear, shMonth, 1, 0, 0, 0, 0);

                // تعداد روزهای ماه
                int monthDays = pc.GetDaysInMonth(shYear, shMonth);

                // تاریخ پایان ماه شمسی
                DateTime endDate = pc.ToDateTime(shYear, shMonth, monthDays, 23, 59, 59, 999);
            }

            @{
                var user = db.tbUsers.FirstOrDefault(u => u.usr_Personal_ID == Model.FishHeader.PersonalCode);

                List<FinancialDocuments> creditorList = new List<FinancialDocuments>();
                List<FinancialDocuments> debtorList = new List<FinancialDocuments>();

                if (user != null)
                {
                    creditorList = db.FinancialDocuments
                        .Where(f => f.User_ID == user.usr_ID &&
                                    f.Creditor != 0 &&
                                    f.DataDocument >= startDate &&
                                    f.DataDocument <= endDate)
                        .OrderBy(f => f.DataDocument)
                        .ToList();

                    debtorList = db.FinancialDocuments
                        .Where(f => f.User_ID == user.usr_ID &&
                                    f.Debtore != 0 &&
                                    f.DataDocument >= startDate &&
                                    f.DataDocument <= endDate)
                        .OrderBy(f => f.DataDocument)
                        .ToList();
                }
            }
            @{long val111 = (long)AVAL;

            }

            @foreach (var item in creditorList)
            {
                // جمع تجمعی
                val111 += (long)item.Creditor;

                <tr>
                    <td colspan="10" CLASS="Ri To numbers">@item.Title</td>
                    <td colspan="10" CLASS="Ri To numbers">-----</td>
                    <td colspan="10" CLASS="Ri To numbers">@item.Creditor</td>
                    <td colspan="9" CLASS="Ri To numbers">@val111</td> <!-- ستون آخر = جمع تجمعی -->
