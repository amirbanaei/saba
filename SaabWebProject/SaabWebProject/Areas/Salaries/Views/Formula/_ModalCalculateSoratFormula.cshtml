@model SaabWebProject.Models.ViewModels.Salaries.Formula.SoratSalaryDetailControllerVM



<div class="row">

    @if (Model.Detail.Keys.First() == 0)
    {

        <div class="col-1">
            <svg class="w-6 h-6 NotAcceptedSvg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 40 40" stroke-width="1" stroke="currentColor" style="color:red">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>

        </div>
        <div class="col-10">
            @Model.Detail.Values.First();
        </div>
    }
    else
    {
        foreach (var item in Model.Detail)
        {
            if (item.Key == 1)
            {
                <div class="col-10">
                    وضعیت دوره
                </div>
                if (item.Value == "False")
                {
                    <div class="col-1">
                        <svg class="w-6 h-6 NotAcceptedSvg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 40 40" stroke-width="1" stroke="currentColor" style="color:red">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>

                    </div>
                }
                else
                {
                    <div class="col-1">
                        <svg class="w-6 h-6 AcceptedSvg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 40 40" stroke-width="1.5" stroke="currentColor" style="color:green">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                }
            }
            if (item.Key == 2)
            {
                <div class="col-10">
                    وضعیت تثبیت دوره ماه قبل
                </div>
                if (item.Value == "False")
                {
                    <div class="col-1">
                        <svg class="w-6 h-6 NotAcceptedSvg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 40 40" stroke-width="1" stroke="currentColor" style="color:red">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>

                    </div>
                }
                else
                {
                    <div class="col-1">
                        <svg class="w-6 h-6 AcceptedSvg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 40 40" stroke-width="1.5" stroke="currentColor" style="color:green">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                }
            }
            if (item.Key == 3)
            {
                <div class="col-10">
                    وضعیت ثبت دوره ماه جاری
                </div>
                if (item.Value == "False")
                {
                    <div class="col-1">
                        <svg class="w-6 h-6 NotAcceptedSvg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 40 40" stroke-width="1" stroke="currentColor" style="color:red">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>

                    </div>
                }
                else
                {
                    <div class="col-1">
                        <svg class="w-6 h-6 AcceptedSvg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 40 40" stroke-width="1.5" stroke="currentColor" style="color:green">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                }
            }
            if (item.Key == 4)
            {
                <div class="col-10">
                    وضعیت تایید دوره ماه جاری
                </div>
                if (item.Value == "False")
                {
                    <div class="col-1">
                        <svg class="w-6 h-6 NotAcceptedSvg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 40 40" stroke-width="1" stroke="currentColor" style="color:red">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>

                    </div>
                }
                else
                {
                    <div class="col-1">
                        <svg class="w-6 h-6 AcceptedSvg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 40 40" stroke-width="1.5" stroke="currentColor" style="color:green">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>

                }
            }
        }
    }
</div>
<div class="row">
    <div class="col-xl-9">

    </div>
    <div class="col-xl-2">
        <div class="form-group mb-3">
            <button type="button" id="Taeed" class="btn form-control buttonGeneral" style="margin-top:30px;display:none">
                <i class="fa fa-calculator fa-fw me-1 VecGeneral"></i>
                <span class="bGeneral-text">محاسبه</span>
                
            </button>

        </div>
    </div>
</div>
<script>
     $(document).ready(function () {

        if ($("svg").hasClass("NotAcceptedSvg") == false) {
            $("#Taeed").css('display','block')
        }

     })
       $("#Taeed").click(function () {

            var year = $("#year");
            var month = $("#course");
                   var Pyman_ID = $("#select_peyman");


    if (year.val().length == 0) {
            Toast.fire({
                icon: 'warning',
                background: '#35434A',
                color: 'white',
                title: "لطفا سال را انتخاب کنید !!"
            });
        $("#buttons").css("display","none");
        }
        else {
        $("#buttons").css("display","block");
            document.getElementById("loading-message").style.display = "block";
            $.ajax({
                url: "@Url.Action("CalculateSorat", "Formula",new {area="Salaries"})",
                type: "Post",
               
                 data: { Pyman_ID: Pyman_ID.val(), Year: year.val(), Month: month.val() },
                success: function (res) {
                    document.getElementById("loading-message").style.display = "none";
                    console.log(res);
                    $('#modalLgDetail').modal('hide');
                    $("#BodyCalc").html(res);

                },
                error: function (res) {
                    console.log(res);

                    document.getElementById("loading-message").style.display = "none";
                    Toast.fire({
                        icon: 'error',
                        background: '#35434A',
                        color: 'white',
                        title: "عملیات  با خطا مواجه شد"
                    });
                    return false;
                }
            })

        }




    });
</script>

