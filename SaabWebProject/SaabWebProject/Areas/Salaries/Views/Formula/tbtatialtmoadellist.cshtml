        var isChecked = document.getElementById("selectAllMamur_" + columnId).checked;

        // اگر هیچ چک‌باکسی پیدا نشد، پیام را در کنسول چاپ کنید
        if (checkboxes.length === 0) {
            console.log("No visible checkboxes found for columnId: ", columnId);
        } else {
            // چک یا لغو انتخاب فقط چک‌باکس‌های قابل مشاهده
            checkboxes.each(function () {
                this.checked = isChecked;
            });
