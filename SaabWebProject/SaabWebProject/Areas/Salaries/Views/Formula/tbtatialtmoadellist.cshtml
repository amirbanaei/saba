<script>
    $(document).ready(function () {
        function calculateKhales(row) {
            var rozmonth = parseInt(row.find('input[data-field="rozmonth"]').val()) || 0;
            var friday = parseInt(row.find('input[data-field="friday"]').val()) || 0;
            var notfriday = parseInt(row.find('input[data-field="notfriday"]').val()) || 0;
            var ghas = parseInt(row.find('input[data-field="ghas"]').val()) || 0;

            var khales = rozmonth - (friday + notfriday + ghas);
            row.find('input[data-field="khales"]').val(khales >= 0 ? khales : 0);
        }

        // هر بار که مقدار یکی از فیلدها تغییر کند، khales را محاسبه کن
        $(document).on('input', '.calc-field', function () {
            var row = $(this).closest('tr');
            calculateKhales(row);
        });

        // وقتی روی دکمه ثبت کلیک شود، داده‌ها را جمع‌آوری و ارسال کن
        $("#savabtn123123").click(function () {
            var rows = [];

            $(".task-list-rowEM2").each(function (index) {
                var row = $(this);
                var rowData = {
                    month: index + 1,
                    rozmonth: parseInt(row.find('input[data-field="rozmonth"]').val()) || 0,
                    friday: parseInt(row.find('input[data-field="friday"]').val()) || 0,
                    notfriday: parseInt(row.find('input[data-field="notfriday"]').val()) || 0,
                    ghas: parseInt(row.find('input[data-field="ghas"]').val()) || 0,
                    khales: parseInt(row.find('input[data-field="khales"]').val()) || 0,
                    year: parseInt($("#Year2").val()) || new Date().getFullYear()
                };
                rows.push(rowData);
            });

            $.ajax({
                url: '@Url.Action("tbtatialtmoadelcreat", "Formula", new { area = "Salaries" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(rows),
                success: function (response) {
                    alert("ثبت با موفقیت انجام شد.");
                },
                error: function () {
                    alert("خطایی در ثبت اطلاعات رخ داد.");
                }
            });
        });
    });
</script>


<script>
    var
        filtersEM2 = {
            filter20: null,
            filter30: null,
            filter31: null,
            filter32: null,
            filter33: null,
            filter34: null,
            filter35: null,

        };
    function updateFiltersEM2() {
        $('.task-list-rowEM2').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filtersEM2).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filtersEM2[filter] && (filtersEM2[filter] != 'None') && (filtersEM2[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filtersEM2[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilterEM2(filterName) {
        filtersEM2[filterName] = this.value;
        updateFiltersEM2();
    }

    // Assigned User Dropdown Filter
    $('#filter20-filter').on('input', function () {
        changeFilterEM2.call(this, 'filter20');
    });
    $('#filter30-filter').on('input', function () {
        changeFilterEM2.call(this, 'filter30');
    });
    $('#filter31-filter').on('input', function () {
        changeFilterEM2.call(this, 'filter31');
    });
    $('#filter32-filter').on('input', function () {
        changeFilterEM2.call(this, 'filter32');
    });
    $('#filter33-filter').on('input', function () {
        changeFilterEM2.call(this, 'filter33');
    });
    $('#filter34-filter').on('input', function () {
        changeFilterEM2.call(this, 'filter34');
    });
    $('#filter35-filter').on('input', function () {
        changeFilterEM2.call(this, 'filter35');
    });
    //$('#filter30-filter').on('input', function () {
    //    changeFilterEM2.call(this, 'filter30');
    //});

</script>
