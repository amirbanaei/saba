<style>
    div {
        border: 1px solid black;
        border-collapse: collapse;
        max-width: 100%;
        /*padding: 10px;*/
    }
    /*----------------------border -> L R T D------------------------*/
    .Le {
        border-left: 1px solid black;
    }

    .Ri {
        border-right: 1px solid black;
    }

    .To {
        border-top: 1px solid black;
    }

    .Bo {
        border-bottom: 1px solid black;
    }
    /*---------------------------------------------------------------*/
    th, td {
        border-collapse: collapse;
        /*-----------------------------*/
        padding-top: 2px;
        padding-bottom: 2px;
        width: 5.26%;
    }
    /*---------------------------------------------------------------*/
    table {
        /*------------border-----------*/
        /*border: 1px solid black;*/
        border-collapse: collapse;
        /*-----------------------------*/
        font-size: 6px;
        text-align: center;
        font-family: serif;
    }
    /*---------------------------------------------------------------*/
    th {
        font-size: 6px;
        font-weight: bold;
    }

    .titel_01 {
        font-size: 6px;
        font-weight: bold;
        background-color: rgba(190, 206, 218, 0.15);
    }

    .titel_02 {
        font-size: 6px;
        font-weight: bold;
        text-align: right;
    }

    .verT01 {
        font-size: 6px;
        transform: rotate(180deg);
        writing-mode: vertical-lr;
        /*text-orientation: mixed;*/
    }

    .description {
        font-size: 6px;
        font-family: serif;
        text-align: right;
        text-align: justify;
        vertical-align: 0px;
    }

    .header {
        font-size: 6px;
        font-weight: bold;
        /*padding: 8px;*/
    }

    .footer {
        font-size: 6px;
        font-weight: bold;
        padding: 20px;
    }
    /*---------------------------------------------------------------*/
    @@media print {
        #printPageButton {
            display: none; /* برای عدم نمایش دکمه پرینت*/
            padding: 0;
        }
    }
    /*---------------------------------------------------------------*/

    @{
        var x = 0;
        var x1 = 0;
        var x2 = 0;
        var x3 = 0;
        var x4 = 0;
        var x5 = 0;
        var x6 = 0;
