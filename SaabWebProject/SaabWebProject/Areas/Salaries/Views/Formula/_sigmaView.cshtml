@model List<SaabWebProject.Areas.Contracts.Models.Classes.ListOfMoalefeha>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" type="text/css" />
<div>
    <div class="row">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-12">
                    مولفه دستمزدی
                </div>
                <div class="col-md-12" style="margin-top:10px !important;">
                    <select class="form-control" id="moalefedastmozdi">
                        @foreach (var item in Model)
                        {
                            <option value="@item.Type _ @item.ID">@item.variablePersianName</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-6">
            شروع
        </div>
        <div class="col-md-6">
            پایان
        </div>
    </div>
    <div class="row">
        <div class="col-md-2" style="margin-top: 10px;">
            <select id="start_sigma" class="form-control">
                @{
                    System.Globalization.PersianCalendar c = new System.Globalization.PersianCalendar();

                    for (var i = 5; i >= 1; i--)
                    {
                        var s = DateTime.Now.AddYears(-i);
                        <option value="@c.GetYear(s)">@c.GetYear(s)</option>
                    }
                    <option selected value="@c.GetYear(DateTime.Now)">@c.GetYear(DateTime.Now)</option>
                    for (var i = 1; i < 5; i++)
                    {
                        var s = DateTime.Now.AddYears(i);
                        <option value="@c.GetYear(s)">@c.GetYear(s)</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2" style="margin-top: 10px;">
            <select id="start_sigma_month" class="form-control">
                @{
                    for (var i = 1; i <= 12; i++)
                    {
                        if (c.GetMonth(DateTime.Now) == i)
                        {
                            <option selected value="@c.GetMonth(DateTime.Now)">@c.GetMonth(DateTime.Now)</option>

                        }
                        else
                        {
                            <option value="@i">@i</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-2" style="margin-top: 10px;">
            <select id="start_sigma_day" class="form-control">
                @{
                    for (var i = 1; i <= 31; i++)
                    {
                        if (c.GetDayOfMonth(DateTime.Now) == i)
                        {
                            <option selected value="@c.GetDayOfMonth(DateTime.Now)">@c.GetDayOfMonth(DateTime.Now)</option>

                        }
                        else
                        {
                            <option value="@i">@i</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-2" style="margin-top: 10px;">
            <select id="end_sigma" class="form-control">
                @{
                    for (var i = 5; i >= 1; i--)
                    {
                        var s = DateTime.Now.AddYears(-i);
                        <option value="@c.GetYear(s)">@c.GetYear(s)</option>
                    }
                    <option selected value="@c.GetYear(DateTime.Now)">@c.GetYear(DateTime.Now)</option>
                    for (var i = 1; i < 5; i++)
                    {
                        var s = DateTime.Now.AddYears(i);
                        <option value="@c.GetYear(s)">@c.GetYear(s)</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2" style="margin-top: 10px;">
            <select id="end_sigma_month" class="form-control">
                @{
                    for (var i = 1; i <= 12; i++)
                    {
                        if (c.GetMonth(DateTime.Now) == i)
                        {
                            <option selected value="@c.GetMonth(DateTime.Now)">@c.GetMonth(DateTime.Now)</option>

                        }
                        else
                        {
                            <option value="@i">@i</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-2" style="margin-top: 10px;">
            <select id="end_sigma_day" class="form-control">
                @{
                    for (var i = 1; i <= 31; i++)
                    {
                        if (c.GetDayOfMonth(DateTime.Now) == i)
                        {
                            <option selected value="@c.GetDayOfMonth(DateTime.Now)">@c.GetDayOfMonth(DateTime.Now)</option>

                        }
                        else
                        {
                            <option value="@i">@i</option>
                        }
                    }
                }
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12" style="margin-top:10px;">
            <input type="button" value="ذخیره" class="btn btn-outline-success" id="saveSigma" style="float:left;" />
        </div>
    </div>
</div>
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js" type="text/javascript"></script>
<script>
    $("#moalefedastmozdi").picker({ search: true });
    $("#start_sigma").picker();
    $("#start_sigma_month").picker();
    $("#start_sigma_day").picker();
    $("#end_sigma").picker();
    $("#end_sigma_month").picker();
    $("#end_sigma_day").picker();
