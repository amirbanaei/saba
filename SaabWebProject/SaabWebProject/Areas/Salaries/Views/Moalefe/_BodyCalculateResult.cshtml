@model List<SaabWebProject.Models.ViewModels.Salaries.Formula.FishDetail>
<div class="border rounded">
    <div class="card-body" style="height: 328px">
        <div class="table-responsive" style="height: 300px">
            <table class="table mb-0">
                <thead>
                    <tr style="text-align: center">
                        <th scope="col">#</th>
                        <th scope="col">فیش حقوقی</th>
                        <th scope="col">نام و نام خانوادگی</th>
                        <th scope="col">کدملی</th>
                        @{
                            var cols = Model[0].Moalefe.ToList();
                            foreach (var item in cols)
                            {
                                <th scope="col">@item.MoalefeName</th>
                            }
                        }


                    </tr>
                </thead>
                <tbody>
                    @{
                        var counter = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr style="text-align: center">
                            <th scope="row">@counter</th>
                            <td style="cursor: pointer">
                                <i class="fa fa-eye"></i>
                            </td>
                            <td>@item.Users.FullName</td>
                            <td>@item.Users.usr_NationalCode</td>
                            @foreach (var item1 in item.Moalefe.ToList())
                            {
                                <td>@item1.MoalefeValue</td>
                            }
                        </tr>
                        counter++;
                    }


                </tbody>
            </table>
        </div>
    </div>

</div>