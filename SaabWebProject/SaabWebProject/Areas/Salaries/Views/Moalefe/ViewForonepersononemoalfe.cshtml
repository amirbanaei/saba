
@model SaabWebProject.Models.ViewModels.Contracts.Function.FunctionModel2



@{
    ViewBag.Title = "GetDataFromExcel_Moalefe";
    Layout = null;
}
<style>

    th {
        width: 50%;
    }

    .view {
        overflow: auto;
        white-space: nowrap; /* متن در یک خط افقی نمایش داده می‌شود */
    }

    table {
        min-width: 100%; /* عرض جدول حداقل برابر با عرض محتوای آن است */
    }

    .hed {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 3;
    }

    .users {
        position: sticky;
        right: 0;
        text-align: center;
        z-index: 3;
        background-color: black !important;
    }

    .modal2 {
        display: none;
        position: absolute; /* Change this from fixed */
        z-index: 1000; /* Adjust z-index as needed */
        left: 0;
        top: 0;
        width: 58%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
    }

    .modal-content2 {
        background-color: black;
        position: relative; /* Add relative positioning */
        margin: 15% auto;
        padding: 20px;
        border: 4px solid aqua;
        border-radius: 30px;
        width: 100%;
        max-height: 100%;
        overflow-y: auto;
    }


    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .fade-in {
        animation: fadeIn 1s ease-in-out; /* Adjust duration and timing function as needed */
    }

    /* Keyframes for the fade-in animation */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.9); /* You can also use translate, depending on the desired effect */
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>

<div>
    <div>اطلاعات</div>

    <div class="row">
        <label class="col-xl-2 mt-3">نام پیمان:</label>
        <div class="col-xl-4 mt-3 ">
            <input class=" form-control "  id="py2" value="@Model.SabtHeader.PeymanName" />
        </div>
        <label class="col-xl-2 mt-3">نام بسته :</label>
        <div class="col-xl-4 mt-3">
            <input class=" form-control "  id="baste2" value="@Model.SabtHeader.BastehName" />
        </div>
    </div>
    <div class="row">
        <label class="col-xl-2 mt-3">سال</label>
        <div class="col-xl-4 mt-3">
            <input class=" form-control " id="year"  value="@Model.SabtHeader.MoalfeVal_Year" />
        </div>
        <label class="col-xl-2 mt-3">ماه :</label>
        <div class="col-xl-4 mt-3 ">
            <input class=" form-control  " id="month"  value="@Model.SabtHeader.MoalfeVal_Month" />
        </div>
    </div>
    <div class="row">
        <label class="col-xl-2" style="display:none;">از تاریخ </label>
        <input class="col-xl-4  " style="display:none;" id="FromDate" value="@Model.SabtHeader.FromDate" />

        <label class="col-xl-2" style="display:none;">تا تاریخ  :</label>
        <input class="col-xl-4 " style="display:none;" id="ToDate" value="@Model.SabtHeader.ToDate" />
    </div>
</div>

<div id="myModal2" class="modal2" style="margin-left: 20% !important; height: 300px;">
    <div class="modal-content2">
        <div class="row">
