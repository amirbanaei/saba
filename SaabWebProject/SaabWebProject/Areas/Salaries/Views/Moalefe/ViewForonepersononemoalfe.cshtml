        </div>
        <div id="ss">

        </div>

    </div>
</div>
<div class="view row"style="margin-top:10px">

    <div class=" col-xl-2"></div>
    <div class="view col-xl-8 " style="height:100px">
        <table class="table table-hover text-nowrap">
            <thead>
                <tr class="how">
                    @{
                        var uniqueTitles = new List<string>();
                        var uniqueTitles2 = new List<string>();

                    }
                    <th class="hed" scope="col">نام کاربری</th>
                    @foreach (var item2 in Model.UsersMoalefe2.ToList())
                    {
                        foreach (var item3 in item2.listMoalefe.ToList())
                        {
                            var title = item3.MoalefeTitle;
                            if (!uniqueTitles.Contains(title))
                            {
                                uniqueTitles.Add(title);
                                <th class="a hed" scope="col" data-title="@{
    if (title.Length > 10)
    {
        title = title.Substring(0, 10);
    }
    @title
}">@title</th>
}
}
}
                </tr>
            </thead>
            <tbody>
                @foreach (var item2 in Model.UsersMoalefe2.ToList())
                {
                    uniqueTitles2.Clear(); // پاک کردن لیست در هر حلقه جدید
                    <tr class="hoverable">
                        <th data-personalcode="@item2.PersonalCode" class="users table-dark" scope="row">
                            @{
                                var fullName = item2.FullName;
                                if (fullName.Split(' ').Length > 5)
                                {
                                    fullName = string.Join(" ", fullName.Split(' ').Take(10));
                                }
                            }
                            @fullName
                        </th>
                        @foreach (var item3 in item2.listMoalefe.ToList())
                        {
                            var title = item3.MoalefeTitle;
                            if (!uniqueTitles2.Contains(title))
                            {
                                uniqueTitles2.Add(title);
                                <td>
                                    <input class="moalefe-value form-control"  data-personalcode="@item2.PersonalCode - @item3.Moalefenum -@item3.MoalefeTitle" data-title="@item3.MoalefeTitle - @item2.PersonalCode - @item3.Moalefenum " data-Moalefenum="@item3.Moalefenum" value="@item3.MoalefeValue" title="@item3.MoalefeTitle - @item3.Moalefenum" />
                                </td>
                            }
                        }
                    </tr>
                }

            </tbody>
        </table>
    </div>
