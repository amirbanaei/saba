@model List<SaabWebProject.Models.DomainModels.tbEquipmentBunch>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
@{
    Layout = null;
}

<select class="form-select selectabzar" id="selectabzar" name="selectabzar">
    <option hidden value="Select">انتخاب مورد</option>
    @foreach (var item in Model.ToList())
    {
        <option value="@item.Eqpbnch_ID">@item.Eqpbnch_Name</option>
    }
</select>

<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>



<script>
    $(document).ready(function () {
        $("#selectabzar").picker({ search: true });

    });
</script>
