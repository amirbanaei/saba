    <script>

    function formatNumber(input) {
        var value = input.value;

        // حذف تمام غیر اعداد
        value = value.replace(/\D/g, '');

        // فرمت سه رقمی جدا شده با کاما
        value = value.replace(/\B(?=(\d{3})+(?!\d))/g, ',');

        // مقدار جدید را به input برگردانید
        input.value = value;
    }

