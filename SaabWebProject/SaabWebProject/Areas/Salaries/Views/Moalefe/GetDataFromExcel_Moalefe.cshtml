<script>
$("#btnCreate1").click(function () {
    var Filters = {
        Filters: [] // تعریف لیستی برای اطلاعات فیلترها
    };

    // جمع‌آوری اطلاعات از فیلدهای ورودی
    Filters.Month = $('#month').val();
    Filters.Year = $('#year').val();
    Filters.Basteh = $('#baste').val();
    Filters.Peyman = $('#py').val();
    Filters.FromDate = $('#FromDate').val();
    Filters.ToDate = $('#ToDate').val();

    // تعریف یک لیست برای UsersMoalefe
    Filters.UsersMoalefe = [];

    $('.users').each(function (i, obj) {
        var personalcode = $(this).data("personalcode");
        var userMoalefe = {
            PersonalCode: personalcode,
            FullName: $(this).text(),
            listMoalefe: []
        };

        $(".moalefe-title[data-personalcode='" + personalcode + "']").each(function (i, element) {
            var title = $(element).data("title");
            var value = $(".moalefe-value[data-personalcode='" + personalcode + "'][data-title='" + title + "']").val();

            var moalefeInfo = {
                MoalefeTitle: title,
                MoalefeValue: value
            };

            // اضافه کردن هر moalefeInfo به لیست معلفه‌ها در userMoalefe
            userMoalefe.listMoalefe.push(moalefeInfo);
        });

        // اضافه کردن userMoalefe به لیست UsersMoalefe
        Filters.UsersMoalefe.push(userMoalefe);
    });

    // ارسال درخواست AJAX به سرور
    sendAjax('@Url.Action("send", "Moalefe", new { area = "Salaries" })', Filters);
});

function sendAjax(url, data) {
    console.log(url);

    $.ajax({
        beforeSend: function () {
            document.getElementById("loading-message").style.display = "block";
        },
        url: url,
        data: { Filters: data },
        type: "POST",
        dataType: "html",
        success: function (resp) {
            console.log(resp);
            document.getElementById("loading-message").style.display = "none";
            if (resp == "true") {
                alert("با موفقیت ثبت شد");
                console.log("After alert, before reload");
                location.reload();
                console.log("After reload");
            } else {
                alert("در ثبت دچار خطا شده ایم! لطفاً بعداً تلاش نمائید");
            }
        },
        error: function (resp) {
            document.getElementById("loading-message").style.display = "none";
            alert("درخواه مشکلی پیش آمده است.");
            console.log(resp);
        }
    });
}





</script>