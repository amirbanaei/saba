<script>
    function addValue() {
        // Get the current values
        var totalValue = parseFloat($("#totalInput").val().replace(/,/g, '')) || 0;
        var bestankarValue = parseFloat($("#SectionInstallmentInputs").find('[id^="bestankar_"]').last().val().replace(/,/g, '')) || 0;
        var bedehkarValue = parseFloat($("#SectionInstallmentInputs").find('[id^="bedehkar_"]').last().val()) || 0;

        // Add the values
        var result = totalValue + bestankarValue - bedehkarValue;
        var formattedResult = result.toLocaleString('en');

        // Update the total input with the formatted result
        $("#totalInput").val(formattedResult);
        // Update the total input
        //$("#totalInput").val(result);

        // تنظیم مقدار جدید در المان des
        updateDescription();
    }

    function subtractValue() {
        // Get the current values
        var totalValue = parseFloat($("#totalInput").val().replace(/,/g, '')) || 0;
        var bestankarValue = parseFloat($("#SectionInstallmentInputs").find('[id^="bestankar_"]').last().val().replace(/,/g, '')) || 0;
        var bedehkarValue = parseFloat($("#SectionInstallmentInputs").find('[id^="bedehkar_"]').last().val()) || 0;
        console.log(bestankarValue);
        // Subtract the values
        var result = totalValue - bestankarValue + bedehkarValue;
        var formattedResult = result.toLocaleString('en');

        // Update the total input with the formatted result
        $("#totalInput").val(formattedResult);
        // Update the total input
        //$("#totalInput").val(result);

        // تنظیم مقدار جدید در المان des
        updateDescription();
    }

