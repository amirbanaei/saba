<script>
    $(document).ready(function () {
        // Get the initial value from the totalInput field
        var initialValue = parseFloat($("#totalInput").val().replace(/,/g, '')) || 0;

        // Format the initial value with commas
        var formattedValue = initialValue.toLocaleString('en');

        // Set the formatted value back to the input
        $("#totalInput").val(formattedValue);
    });
    var idd55 = $('#value_radif').val();
    var idd25 = $('#select_peyman2').val();
    $("#table22").load('@Url.Content("/Statments/Statment/tablesorat")?id=' + idd55 + '&fkpymn=' + idd25);


    var nodesLength = 0; // Declare outside the function to maintain its value
    function plusInputInstallmentManually(e) {
        var a = 1;
        nodesLength++;
        a++;


        $("#SectionInstallmentInputs").append(`
            <div id="row_${nodesLength}" class="row">
                <div class="col-md-12 col-xl-5">
                    <label class="form-label"> شرح </label>
                    <textarea class="form-control " style="height: 34px;" id="bedehkar_${nodesLength}"></textarea>
                </div>
                <div class="col-md-12 col-xl-2">
                    <label class="form-label">  مقدار (ریال) </label>
                    <input class="form-control installmentAmountInputManually" oninput="formatCurrency(this)" id="bestankar_${nodesLength}" style=""/>
                </div>
                <div class="col-xl-2 ">
                    <label class="form-label">نوع عملیات</label>
                    <select class="form-select"id="bed_${nodesLength}" data-row="${nodesLength}">
                         <option value="0">کسر</option>
                         <option value="1">افزودن</option>
                    </select>
                </div>
                <div class="col-xl-2" >
                    <button class="btn buttonsabt form-control" onclick="addValue1(this)">
                         <i class="fa fa-thumbs-up fa-fw me-1 VecGeneral"></i>
                         <span class="bSabt-text"> اعمال</span> 
                    </button>
                </div>
                <div class="col-xl-1">
                     <button type="button" class="btn buttonGeneralMins form-control close" aria-label="Close" onclick="removeRow('row_${nodesLength}')">
                     <i class="fa fa-multiply VecGeneral" ></i>
                     </button>
                </div>
          </div>
`);


    }
    $(".deleteBtn[data-row-id='" + nodesLength + "']").on("click", function () {
        var rowId = $(this).data("row-id");
        nodesLength--;
        // Remove the entire row with the corresponding ID
        $("#row_" + rowId).remove();
    });
    function removeRow(rowId) {
        // Find the row element with the given ID
        var row = document.getElementById(rowId);

        // Check if the row exists
        if (row) {
            // Remove the row
            row.remove();
            nodesLength--;
        } else {
            console.error("Row with ID " + rowId + " does not exist.");
        }
    }
    function formatCurrency(input) {
        // Remove any non-numeric characters except for the decimal point
        let value = input.value.replace(/,/g, '');

        // Convert to number and format with commas as thousands separators
        value = Number(value).toLocaleString('en');

        // Set the formatted value back to the input
        input.value = value;
    }


    


    $().on('hidden.bs.modal', function () {
        $(this).find('form')[0].reset();
        location.reload();
    });
</script>
