@section Scripts{
    <script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>
    <script>
        $.each($("#select_peyman"), function (index, item) {
            $("#select_peyman").attr("id", "select_peyman_");
            $('#select_peyman_').attr("multiple", "multiple");
            $('#select_peyman_').picker({ search: true });
            $('#select_peyman_').on('sp-change', function () { });
        });
    </script>
    <script>

        $("#btnCalculateGhatei").click(function () {


            var year = $("#YearGh").val();
            var month = $("#MonthGh ").val();

            if ($("#CourseGh").val() == 0) {
                alert("لطفا دوره را انتخاب کنید");
            }
            else if ($("#MonthGh").val() == 0) {
                alert("لطفا ماه را انتخاب کنید");
            }
            else if ($("#YearGh").val() == 0) {
                alert("لطفا سال را انتخاب کنید");
            }

            else {

                $.ajax({
                    url: "@Url.Action("EjraMohasebatSuratVaziyat", "Statment", new { area = "Statments" })",
                    type: "Post",
                    dataType: "html",
                    data: { month: month, year: year },
                    success: function (res) {

                        document.getElementById("loading-message").style.display = "none";
                        $("#big_modal_body").html(res)
                        $("#modalLg").modal('show')

                    },
                    error: function (res) {
                        console.log(res);

                        document.getElementById("loading-message").style.display = "none";
                        Toast.fire({
                            icon: 'error',
                            background: '#35434A',
                            color: 'white',
                            title: "عملیات  با خطا مواجه شد"
                        });
                        return false;
                    }
                });
            }
        });

    </script>
    <script>

        $("#btnCalculateAzmayeshi").click(function () {
            var PeymanArr = [];
            $.each($("#select_peyman_").val().toString().split(","), function (index, item) {
                if (item !== "") {
                    if (item != 'Select') {
                        PeymanArr.push(item);
                        console.log(item);
                    }
                }
            });
            var year = $("#YearAz").val();
            var month = $("#MonthAz ").val();

            if ($("#select_peyman_").val() == 'Select') {
                alert("لطفا پیمان ها را انتخاب کنید");
            }
            else if ($("#CourseAz").val() == 0) {
                alert("لطفا دوره را انتخاب کنید");
            }
            else if ($("#MonthAz").val() == 0) {
                alert("لطفا ماه را انتخاب کنید");
            }
            else if ($("#YearAz").val() == 0) {
                alert("لطفا سال را انتخاب کنید");
            }

            else {
                $.ajax({
                    url: "@Url.Action("EjraMohasebatSuratVaziyat_Azemayeshi", "Statment", new { area = "Statments" })",
                    type: "Post",
                    dataType: "html",
                    data: { Fkpym: PeymanArr, month: month, year: year },
                    success: function (res) {
                        document.getElementById("loading-message").style.display = "none";
                        $("#big_modal_body").html(res)
                        $("#modalLg").modal('show')

                    },
                    error: function (res) {
                        console.log(res);

                        document.getElementById("loading-message").style.display = "none";
                        Toast.fire({
                            icon: 'error',
                            background: '#35434A',
                            color: 'white',
                            title: "عملیات  با خطا مواجه شد"
                        });
                        return false;
                    }
                });
            }
        });

    </script>
}







