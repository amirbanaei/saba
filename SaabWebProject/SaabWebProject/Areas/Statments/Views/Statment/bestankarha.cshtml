<script>
    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#myModal20").addClass("fade-in"); // Add the fade-in class
            $("#myModal20").css("display", "block");
        });

        $(".close").click(function () {
            $("#myModal20").removeClass("fade-in"); // Remove the fade-in class
            $("#myModal20").css("display", "none");
        });

        $(window).click(function (event) {
            if (event.target == $("#myModal20")[0]) {
                $("#myModal20").removeClass("fade-in"); // Remove the fade-in class
                $("#myModal20").css("display", "none");
            }
        });
    });</script>
