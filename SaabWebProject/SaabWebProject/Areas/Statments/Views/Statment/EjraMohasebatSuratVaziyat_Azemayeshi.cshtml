            <div class="col-xl-10"></div>
            <div class="col-xl-2">
                <button id="btnCalculateAZ" type="button" class="btn form-control buttonGeneral">
                    <i class="fa fa-calculator fa-fw me-1 VecGeneral"></i>
                    <span class="bGeneral-text">محاسبه</span>
                </button>
            </div>

        </div>
    }

