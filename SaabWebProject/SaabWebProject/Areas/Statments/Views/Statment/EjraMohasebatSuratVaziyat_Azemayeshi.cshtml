<script>
    var delay = 1000; // زمان تأخیر به میلی ثانیه
    function showNextDiv(ClassNameI) {
        // نمایش div با استفاده از شناسه
        document.getElementById(ClassNameI).style.display = "flex";
    }

    var divs = document.querySelectorAll("[ClassI_I]");
    var i = 0;
    var id;
    divs.forEach(div => {
        console.log(divs[i].classList[1])
        id = div.getAttribute("ClassI_I");
        setTimeout(showNextDiv.bind(null, id), (i + 1) * delay);
        i++
    });
</script>
<script>

    $("#btnCalculateAZ").click(function () {
        $(".loader").css('display', 'block');

            var PeymanArr = [];
            $.each($("#select_peyman_").val().toString().split(","), function (index, item) {
                if (item !== "") {
                    if (item != 'Select') {
                        PeymanArr.push(item);
                    }
                }
            });

            var Year = $("#YearAz").val();
            var Month = $("#MonthAz ").val();
            var Course = $("#CourseAz").val();
            var Pyman_IDs = PeymanArr
            console.log(Year)
            console.log(Month)
            console.log(Course)
            console.log(Pyman_IDs)

            if ($("#select_peyman_").val() == 0) {
                alert("لطفا ردیف اعتباری را انتخاب کنید");
            }
            else if ($("#YearAZ").val() == 0) {
                alert("لطفا شماره صورت وضعیت را انتخاب کنید");
            }

            else {

                $.ajax({

                    url: "@Url.Action("viewforsabtsonahaei", "Formula", new { area = "Salaries" })",
                    type: "Post",
                    dataType: "html",
                    data: { year: Year, month: Month, number_sorat: Course, fkpy: Pyman_IDs },
                    success: function (res) {
                        document.getElementById("loading-message").style.display = "none";
                        if (res == "True") {
                            $(".loader").css('display', 'none');

                            alert("با موفقیت ثبت شد")
                            location.reload();

                        }
                        //$("#big_modal_body").html(res)
                        //$("#modalLg").modal('show')

                    },
                    error: function (res) {
                        $(".loader").css('display', 'none');

                        console.log(res);

                        document.getElementById("loading-message").style.display = "none";
                        Toast.fire({
                            icon: 'error',
                            background: '#35434A',
                            color: 'white',
                            title: "عملیات  با خطا مواجه شد"
                        });
                        return false;
                    }
                });
            }
        });

</script>
