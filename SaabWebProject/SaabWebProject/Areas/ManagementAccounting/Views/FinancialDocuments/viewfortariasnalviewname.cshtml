
@using SaabWebProject.Models.DomainModels;
@{
    Layout = null;
    SaabEntities db = new SaabEntities();

}
@model IEnumerable<SaabWebProject.Models.DomainModels.dbAsnadcratsher>
@{
    foreach (var item in Model)
    {
        if (item.codeghtesadi == null)
        {
            <option value="@item.ID" data-html="0">@item.nameshr</option>

        }
        else
        {
            <option value="@item.ID" data-html="@item.codeghtesadi">@item.nameshr</option>

        }
    }
}


