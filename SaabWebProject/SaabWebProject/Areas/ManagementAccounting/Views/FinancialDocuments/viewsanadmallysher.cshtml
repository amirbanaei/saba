// روی دکمه کلیک کنید
$("#createMoalefeButtonModal").click(function () {
    // مقدار اولیه را از کاربر می‌پرسیم
    Swal.fire({
        title: 'لطفاً مقدار مورد نظر را وارد کنید',
        input: 'text',
        inputPlaceholder: 'مقدار را اینجا وارد کنید...',
        showCancelButton: true,
        confirmButtonText: 'ارسال',
        cancelButtonText: 'لغو',
        background: 'rgb(29,40,52)',
        inputValidator: (value) => {
            if (!value) {
                return 'لطفاً مقداری وارد کنید!';
            }
        }
    }).then((result) => {
        if (result.isConfirmed) {
            // اگر کاربر مقدار را وارد کرد
            let userInput = result.value;
            console.log("مقدار ورودی کاربر: ", userInput);

            // گرفتن مقادیر دیگر از ورودی‌ها
            var sanadValue = $("#sanad3455").val();
            var sanadValueyear = $("#datepickerFromEn_Eq1244534").val();

            // انجام درخواست AJAX
            $("#big_modal_body1").load(
                '@Url.Content("/ManagementAccounting/FinancialDocuments/viewmodalsanadmallyybbynumber")?id='
                + encodeURIComponent(userInput)
                + '&tarighh='
                + sanadValueyear
                + '&userInput=' // ارسال مقدار ورودی کاربر
                + encodeURIComponent(userInput)
            );
        }
    });
});


