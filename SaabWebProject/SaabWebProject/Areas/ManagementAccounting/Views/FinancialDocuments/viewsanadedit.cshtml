<script>
    $(document).ready(function () {
        // مقدارهای قبلی برای بررسی تغییرات
        let previousSumkol1 = "";
        let previousSumkol2 = "";
        let previousSumkol3 = "";
        let previousSumkol4 = "";
        let previousSumkol = "";

        function updateValues() {
            // گرفتن مقادیر فعلی اینپوت‌ها
            const currentSumkol1 = document.getElementById("sumkol1").value;
            const currentSumkol2 = document.getElementById("sumkol2").value;
            const currentSumkol3 = document.getElementById("sumkol3").value;
            const currentSumkol4 = document.getElementById("sumkol4").value;
            const currentSumkol = document.getElementById("sumkol").value;

            if (currentSumkol1 !== previousSumkol1) {
                previousSumkol1 = currentSumkol1; // به‌روزرسانی مقدار قبلی
                document.getElementById("mablaghAvaliyeE").value = currentSumkol1;
            }
            if (currentSumkol2 !== previousSumkol2) {
                previousSumkol2 = currentSumkol2; // به‌روزرسانی مقدار قبلی
                document.getElementById("mablaghTakhfifE").value = currentSumkol2;
            }

            if (currentSumkol3 !== previousSumkol3) {
                previousSumkol3 = currentSumkol3; // به‌روزرسانی مقدار قبلی
                document.getElementById("mablaghbaTakhfifE").value = currentSumkol3;
            }

            // بررسی تغییر در مقدار sumkol4
            if (currentSumkol4 !== previousSumkol4) {
                previousSumkol4 = currentSumkol4; // به‌روزرسانی مقدار قبلی
                document.getElementById("mlaghArzeshAfzooE").value = currentSumkol4;
            }
            if (currentSumkol !== previousSumkol) {
                previousSumkol = currentSumkol; // به‌روزرسانی مقدار قبلی
                document.getElementById("mablaghNahaeiE").value = currentSumkol;
            }
        }

        // اجرای بررسی مقادیر به صورت دوره‌ای (هر 200 میلی‌ثانیه)
        setInterval(updateValues, 200);

        // مقداردهی اولیه
        updateValues();
    });
</script>
