


@{
    Layout = null;
}
@model IEnumerable<SaabWebProject.Models.DomainModels.dbAsnaduplaodfilmozoh>
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
<div class="card">
    <div class="table-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("فعالیت")
                            </th>
                            
                            <th>
                                @Html.DisplayName("شرح ")
                            </th>






                        </tr>



                    </thead>
                    <tbody style="text-align:center">

                        @if (Model != null)
                        {

                            var i = 0;
                            foreach (var item in Model)
                            {
                                if (item != null)
                                {


                                    i++;
                                    <tr>
                                        <td>
                                            <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                                <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <div class="dropdown-menu">
                                                    <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item edit2" id="Edit_@item.ID">ویرایش</a>
                                                    <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item Details2" id="Detail_@item.ID">جزئیات</a>
                                                    <a class="dropdown-item Delete" id="Delete_@item.ID">حذف</a>


                                                </div>
                                            </div>
                                        </td>
                                        
                                        @if (item.TItel != null)
                                        {

                                            <td>
                                                @if (item.TItel.Length > 40)
                                                {
                                                    <span title="@item.TItel">@item.TItel.Substring(0, 40)...</span>
                                                }
                                                else
                                                {
                                                    @item.TItel
                                                }


                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                            </td>
                                        }

                                    </tr>
                                }

                            }

                            // Your foreach loop code here
                        }

                    </tbody>

                </table>
            </div>
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script>
    $(".edit2").click(function () {
        var idd = $(this).attr("id").split("_")[1];
        console.log(idd);
        $("#big_modal_body1").load('@Url.Content("/Budget/CreditLine/Edit_CreateCreditIndiactors")?id='+idd);
    });
      $(".Details2").click(function () {
        var idd = $(this).attr("id").split("_")[1];
        console.log(idd);
        $("#big_modal_body1").load('@Url.Content("/Budget/CreditLine/Dtail_CreateCreditIndiactors")?id='+idd);
    });


