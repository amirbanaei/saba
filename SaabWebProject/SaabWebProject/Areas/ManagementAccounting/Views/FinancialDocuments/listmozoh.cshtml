             var idd = $(this).attr("id").split("_")[1];
              console.log(idd);
             // $("#big_modal_body").load('@Url.Content("/installments/installmentsDelete")')?ReffrenceSaveID='+idd);
             ajax('@Url.Content("/installments/installmentsDelete")');
    });*@

</script>