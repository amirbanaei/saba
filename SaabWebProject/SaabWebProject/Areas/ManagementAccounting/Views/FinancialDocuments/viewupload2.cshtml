<script>
    // Convert Gregorian date to jaali in the table
    var tds = document.querySelectorAll("[cont-date]");
    var valueD, id, target;
    var options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    cont = 1
    tds.forEach(td => {
        valueD = new Date(td.textContent).toLocaleDateString('fa-IR-u-nu-latn', options).replace(',', '').replace(" ", "");
        valueD = valueD.slice(0, 10) + " " + td.textContent.slice(10, 30)
        id = td.getAttribute("cont-date");
        target = document.getElementById(id);
        target.textContent = valueD;
        let row = document.querySelector('.task-list-row.dateS_' + cont);
        row.setAttribute('data-filter01', valueD);
        cont += 1
    });

</script>
<script>
    jalaliDatepicker.startWatch({
        time: true,
        days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
        persianDigits: true,
        autoClose: true,
        autocomplete: true,
        showCloseBtn: true,
        showEmptyBtn: false,
        showCloseBtn: true,
        zIndex: 100000,
    });
    //-----------------------------------------------------------------
    var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
    for (var i = 0; i < inputs.length; i++) {
        inputs[i].addEventListener("jdp:change", function (e) {
            var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
            var date = this.value.replace(' ', '').slice(0, 10).split('/');
            date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]),)
            // If it was empty
            if (!this.value) {
                date = "";
            }
            // If it was only history
            else if (this.value.replace(' ', '').length < 11) {
                date = date.gy + '-' + date.gm + '-' + date.gd
            }
            // If it was the date and time
            else {
                date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30)
            }
            miladiInput.value = date
            var weekDay = getDayOfWeek(document.querySelector("#datepickerFromEn_usr").value.slice(0, 10))
            document.querySelector("#weekDay").value = weekDay
        });
    }
    for (var i = 0; i < inputs.length; i++) {
        inputs[i].addEventListener("jdp:change", function (e) {
            var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
            var date = this.value.replace(' ', '').slice(0, 10).split('/');
            date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]),)
            // If it was empty
            if (!this.value) {
                date = "";
            }
            // If it was only history
            else if (this.value.replace(' ', '').length < 11) {
