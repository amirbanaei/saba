@using SaabWebProject.Models.Classes;
@{
    Layout = null;
}
@model IEnumerable<SaabWebProject.Models.DomainModels.FinancialDocuments>

<style>
    #datepickerFrom_Eq, #bestankar, #bedehkar, #datepickerTo_Eq {
        border-image: linear-gradient(to right, #323949, #5FC8CC, #323949) 1 !important;
    }

    #bestankar {
        border-image: linear-gradient(to right, #323949, #5FC8CC, #323949) 1 !important;
    }

    .modal2 {
        display: none;
        position: absolute; /* Change this from fixed */
        z-index: 1000; /* Adjust z-index as needed */
        left: 0;
        top: 0;
        width: 65%;
        height: auto;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
    }

    .modal-content2 {
        background-color: black;
        position: relative; /* Add relative positioning */
        /*  margin: 15% auto;*/
        padding: 20px;
        border: 4px solid aqua;
        border-radius: 30px;
        width: 100%;
        max-height: 100%;
        overflow-y: auto;
    }

    .modal3 {
        display: none;
        position: absolute; /* Change this from fixed */
        z-index: 1000; /* Adjust z-index as needed */
        left: 0;
        top: 0;
        width: 65%;
        height: auto;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
    }

    .modal-content3 {
        background-color: black;
        position: relative; /* Add relative positioning */
        /*  margin: 15% auto;*/
        padding: 20px;
        border: 4px solid aqua;
        border-radius: 30px;
        width: 100%;
        max-height: 100%;
        overflow-y: auto;
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .fade-in {
        animation: fadeIn 1s ease-in-out; /* Adjust duration and timing function as needed */
    }
</style>
@foreach (var item in Model)
{


    <div class="row">

        <div class="col-xl-2">
            <div class="form-group mb-3">

                @*@if (istruu)
                {*@
                <label class="form-label"> نام کاربر  </label>
                @if (item.Peyman_ID == null)
                {
                    <input class="form-control bestankar-input" id="bestankar1" value="@item.tbUsers.FullName" />


                }
                else
                {
                    <input class="form-control bestankar-input" id="bestankar1" value="@item.tbPeymanContracts.pec_BriefTitle" />

                }


            </div>
        </div>   @if (item.Peyman_ID != null)

        {

            <div class="col-xl-2">
                @*@if (istruu)
                {*@
                <label class="form-label">  ردیف اعتباری  </label>
                @*//}*@
                <input class="form-control bestankar-input" id="bestankar1" value="@item.tbCreditIndicators.Title" />
            </div>
            }
            <div class="col-xl-2">
                @*@if (istruu)
                {*@
                <label class="form-label">  بستانکار (ریال)  </label>
                @*//}*@
                <input class="form-control bestankar-input" id="bestankar1" value="@String.Format("{0:N0}", item.Creditor)" />
            </div>

            <div class="col-xl-2">
                @*@if (istruu)
                {*@
                <label class="form-label">  بدهکار (ریال)  </label>
                @*//    istruu = false;
                //}*@
                <input class="form-control bedehkar-input" id="bedehkar1" value="@String.Format("{0:N0}",item.Debtore)" />
            </div>
            <div class="col-xl-2">
                @*@if (istruu)
                {*@
                <label class="form-label">  شرح  </label>
                @*//    istruu = false;
                //}*@
                <input class="form-control bedehkar-input" id="bedehkar1" value="@item.Title" />
            </div>
            @*<div class="col-xl-1">
                <button class="form-label  click form-control" style="margin-top: 30px; width: 70px; background-image: linear-gradient(#56e0fa, #055ad7); " id="click_@item.ID"> <i class="bi bi-eye-fill"></i>  </button>
            </div>*@
            <div class="col-xl-1">
                <button class=" btn click2 form-control buttonGeneralPlus" id="click_@item.ID"> <i class="bi bi-pen fa-fw me-1 VecGeneral"></i> </button>
            </div>
            <div class="col-xl-1">
                <button class=" btn click3 form-control buttonGeneralMins" id="click_@item.ID"> <i class="bi bi-trash fa-fw me-1 VecGeneral"></i></button>
            </div>
        </div>
}
<div id="myModal2" class="modal2" style="margin-left:25% !important;">
    <div class="modal-content2">
        <div class="row">
            <i class="close fa fa-window-close"></i>
        </div>
        <div id="ss">

        </div>


    </div>
</div>
<div id="myModal3" class="modal3" style="margin-left:25% !important;">
    <div class="modal-content3">
        <div class="row">
            <i class="close fa fa-window-close"></i>
        </div>

        <div id="ss2">

        </div>

    </div>
</div>

<script>
    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#myModal2").addClass("fade-in"); // Add the fade-in class
            $("#myModal2").css("display", "block");
        });

        $(".close").click(function () {
            $("#myModal2").removeClass("fade-in"); // Remove the fade-in class
            $("#myModal2").css("display", "none");
        });

        $(window).click(function (event) {
            if (event.target == $("#myModal2")[0]) {
                $("#myModal2").removeClass("fade-in"); // Remove the fade-in class
                $("#myModal2").css("display", "none");
            }
        });
    });</script>
<script>
    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#myModal3").addClass("fade-in"); // Add the fade-in class
            $("#myModal3").css("display", "block");
        });

        $(".close").click(function () {
            $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
            $("#myModal3").css("display", "none");
        });

        $(window).click(function (event) {
            if (event.target == $("#myModal3")[0]) {
                $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
                $("#myModal3").css("display", "none");
            }
        });
    });</script>
<script>
                $(".click3").click(function () {
        var idd = $(this).attr("id").split("_")[1];

     /*document.getElementById("loading-message").style.display = "block";*/





     Swal.fire({
         title: 'آیا از حدف مطمئن هستید؟',
         icon: 'question',
         showCancelButton: true,
         background: 'rgb(29,40,52)',
         color: 'white',
         confirmButtonColor: '#3085d6',
         cancelButtonColor: '#d33',
         confirmButtonText: 'بله ',
         cancelButtonText: 'خیر'
     }).then((result) => {

         if (result.isConfirmed == true) {
             $(".loader").css('display', 'block');
               $.ajax({
        url: '@Url.Action("Deletfkfin", "FinancialDocuments", new { area = "ManagementAccounting" })',
        data: { ID: idd },
        type: "Post",
        dataType: "html",
        success: function (resp) {
            $("#loading-message").css("display", "none");
            if (resp == "True") {
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با موفقیت حذف شد"
                }).then(() => {
                    location.reload();
                });
            } else {
                Toast.fire({
                    icon: 'error',
                    background: '#35434A',
                    color: 'white',
                    title: "قادر به حذف  نیستید"
                }).then(() => {
                });
            }

        },
        error: function (resp2) {
            $("#loading-message").css("display", "none");
            Toast.fire({
                icon: 'error',
                background: '#35434A',
                color: 'white',
                title: "حذف  با خطا مواجه شده است "
            }).then(() => {
                location.reload();
            });
        }
    });
         }

     });







      });


</script>
