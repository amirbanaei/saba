<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $("#SubmitRadifEtebari").click(function () {
          
        var titel = $("#Description ").val();
        $("#loading-circle .loadingText1").text("لطفا منتظر نمایش اطلاعات بمانید ...");
        $("#loading-circle").css("display", "flex");
                if ($("#Description").val() == '') {
                alert("لطفا پیمان ها را انتخاب کنید");
            }
             
            else {
                $.ajax({
                    url: "@Url.Action("createmozoh", "FinancialDocuments", new { area = "ManagementAccounting" })",
                    type: "Post",
                    dataType: "html",
                    data: { titel: titel },
                    success: function (res) {
                        if (res == "True") {
                            $("#loading-circle").css("display", "none");
                            alert("با موفقیت ثبت شد");
                            location.reload();

                        }
                        else {
                            $("#loading-circle").css("display", "none");
                            alert(res);
                        }

                    },
                    error: function (res) {
                        console.log(res);

                        document.getElementById("loading-message").style.display = "none";
                        Toast.fire({
                            icon: 'error',
                            background: '#35434A',
                            color: 'white',
                            title: "عملیات  با خطا مواجه شد"
                        });
                        return false;
                    }
                });
            }
        });
    $(document).ready(function () {
        $("#Description").keydown(function (e) {
            $("#paragraph").text("در حال تایپ ....");
        });

        $("#Description").keyup(function (e) {

            setInterval(function () {
                $("#paragraph").text("");
            }, 3000);
        });
    });


</script>
<script>
