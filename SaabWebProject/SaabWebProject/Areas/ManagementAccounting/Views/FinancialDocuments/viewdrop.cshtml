<script>

    $(document).ready(function () {



        $("#saveMergedButton").click(function () {
            //=========================================================================================================
            const myTable = document.querySelector(".table"); // یا هر متغیر دیگه‌ای

            const cellData = [];

            if (myTable) {
                const rows = myTable.rows;

                let colTracker = 0; // برای شمارش ستون‌ها با توجه به مرج‌ها

                for (let i = 0; i < rows.length; i++) {
                    const cells = rows[i].cells;

                    for (let j = 0; j < cells.length; j++) {
                        const cell = cells[j];

                        // بررسی مرج شدن (colspan و rowspan)
                        const rowspan = cell.rowSpan || 1;
                        const colspan = cell.colSpan || 1;

                        // فقط برای سلول‌های اصلی که مرج شده‌اند اطلاعات رو ثبت می‌کنیم
                        if (rowspan > 1 || colspan > 1) {
                            // افزایش شمارش برای سلول‌هایی که مرج شدن
                            j += colspan - 1;
                            colTracker += colspan - 1;
                        }

                        // بررسی محتوای داخلی برای استایل مثل font-size
                        const inner = cell.querySelector("*"); // چک کردن اگر داخلش عنصر دیگه‌ای هست
                        const innerStyle = inner ? window.getComputedStyle(inner) : null;
                        const outerStyle = window.getComputedStyle(cell);

                        // استخراج متن از محتوای داخلی (مثلاً <div>) یا خود سلول
                        const text = inner ? inner.innerText.trim() : cell.innerText.trim();

                        // ذخیره اطلاعات فقط برای سلول واقعی
                        cellData.push({
                            rowIndex: i,
                            colIndex: colTracker,
                            text: text,
                            rowspan: rowspan,
                            colspan: colspan,
                            classList: Array.from(cell.classList),
                            inlineStyle: cell.getAttribute("style"),
                            computedStyle: {
                                color: outerStyle.color,
                                backgroundColor: outerStyle.backgroundColor,
                                fontSize: innerStyle ? innerStyle.fontSize : outerStyle.fontSize,
                                fontWeight: innerStyle ? innerStyle.fontWeight : outerStyle.fontWeight,
                                fontFamily: innerStyle ? innerStyle.fontFamily : outerStyle.fontFamily,
                                textAlign: outerStyle.textAlign,
                                verticalAlign: outerStyle.verticalAlign,
                                border: outerStyle.border,
                                padding: outerStyle.padding,
                                display: outerStyle.display,
                                visibility: outerStyle.visibility,
                                borderTop: outerStyle.borderTop,
                                borderBottom: outerStyle.borderBottom,
                                borderLeft: outerStyle.borderLeft,
                                borderRight: outerStyle.borderRight
                            }
                        });

                        // افزایش شمارنده‌ی ستون با در نظر گرفتن colspan
                        colTracker += colspan;
                    }
                }

                console.log("---------------------------------------------------------------");
                console.log(cellData);
                console.log("---------------------------------------------------------------");

            } else {
                console.warn("جدول پیدا نشد.");
            }

        //=========================================================================================================
            let formId = 1; // مقدار FK_Form1 (باید مقدار واقعی را از دیتابیس دریافت کنید)
            saveMergedData(formId);
        });

    });

    function saveMergedData(formId) {
        let mergedDataString = JSON.stringify(mergedData); // تبدیل به رشته JSON
        console.log(mergedDataString);
        $.ajax({
            url: "/ManagementAccounting/FinancialDocuments/SaveMergedData",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({
                FK_Form1: formId, // مقدار کلید خارجی
                MERGEE: mergedDataString // ارسال مقدار مرج شده
            }),
            success: function (response) {
                if (response.success) {
                    alert("داده‌های مرج شده با موفقیت ذخیره شدند!");
                } else {
                    alert("خطا در ذخیره داده‌ها: " + response.message);
                }
            },
            error: function (error) {
                console.error("خطا در ذخیره داده‌ها:", error);
            }
        });
    }

    document.getElementById("removeInnerBorders").addEventListener("click", function () {
        let selectedCells = Array.from(document.querySelectorAll(".selected"));

        selectedCells.forEach(cell => {
            let row = cell.parentElement.rowIndex;
            let col = cell.cellIndex;

            selectedCells.forEach(otherCell => {
                let otherRow = otherCell.parentElement.rowIndex;
                let otherCol = otherCell.cellIndex;

                if (row === otherRow && col === otherCol - 1) {
                    // اگر دو سلول کنار هم در یک سطر هستند
                    cell.style.borderLeft = "none";
                    otherCell.style.borderRight = "none";
                }

                if (col === otherCol && row === otherRow + 1) {
                    // اگر دو سلول روی هم قرار دارند
                    cell.style.borderTop = "none";
                    otherCell.style.borderBottom = "none";
                }
            });
        });
    });



