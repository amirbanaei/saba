    $(document).on("click", "td", function () {
        if ($(this).hasClass("selected")) {
            $(this).removeClass("selected");
            selectedCells = selectedCells.filter(cell => cell !== this);
        } else {
            $(this).addClass("selected");
            selectedCells.push(this);
        }
    });
    $("#unmergeCells").click(function () {
        if (selectedCells.length !== 1) {
            alert("لطفاً یک سلول ادغام‌شده را انتخاب کنید.");
            return;
        }

        let cell = selectedCells[0];
        let rowspan = parseInt($(cell).attr("rowspan")) || 1;
        let colspan = parseInt($(cell).attr("colspan")) || 1;

        if (rowspan === 1 && colspan === 1) {
            alert("این سلول ادغام نشده است.");
            return;
        }

        let tableCols = parseInt($("#colsInput").val());
        let cellId = parseInt($(cell).attr("data-id"));
        let minRow = Math.floor((cellId - 1) / tableCols);
        let minCol = (cellId - 1) % tableCols;
        let cellContent = $(cell).html();

        // ایجاد سلول‌های جدید قبل از حذف ویژگی‌های ادغام
        for (let row = minRow; row < minRow + rowspan; row++) {
            for (let col = minCol; col < minCol + colspan; col++) {
                if (row === minRow && col === minCol) {
                    continue; // اولین سلول را نگه میداریم
                }

                let newCellId = (row * tableCols) + col + 1;
                let newCell = $("<td class='drop-target'></td>")
                    .attr("data-id", newCellId)
                    .attr("title", "ستون: " + String.fromCharCode(65 + col) + " ردیف: " + (row + 1));

                // پیدا کردن محل مناسب برای درج سلول جدید
                let currentRow = Math.floor((newCellId - 1) / tableCols);
                let currentRowFirstCell = (currentRow * tableCols) + 1;
                let currentRowLastCell = currentRowFirstCell + tableCols - 1;

                // پیدا کردن نزدیک‌ترین سلول موجود در همان ردیف
                let inserted = false;
                for (let i = newCellId; i <= currentRowLastCell; i++) {
                    let existingCell = $("td[data-id='" + i + "']");
                    if (existingCell.length) {
                        existingCell.before(newCell);
                        inserted = true;
                        break;
                    }
                }

                // اگر هیچ سلولی در ردیف پیدا نشد، به آخر ردیف اضافه کن
                if (!inserted) {
                    let rowElement = $("tr").eq(row);
                    rowElement.append(newCell);
                }
            }
        }

        // حذف ویژگی‌های ادغام از سلول اصلی
        $(cell).removeAttr("rowspan").removeAttr("colspan");
        mergedData = mergedData.filter(item => item.mergedCellId !== cellId);
        console.log("Updated Merged Data:", mergedData);

        selectedCells = [];
        $("td").removeClass("selected");
    });
