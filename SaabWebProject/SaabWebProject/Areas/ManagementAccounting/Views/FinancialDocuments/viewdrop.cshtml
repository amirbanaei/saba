    // دریافت استایل‌های جدول
    $("#getTableStyles").click(function () {
        let tableStyles = {};

        // بررسی همه سلول‌های جدول
        $("td").each(function () {
            let cellId = $(this).attr("data-id");
            let styles = {
                cell: {
                    width: $(this).css("width"),
                    height: $(this).css("height"),
                    backgroundColor: $(this).css("background-color"),
                    border: $(this).css("border"),
                    position: $(this).css("position")
                }
            };

            // بررسی المان‌های draggable داخل سلول
            let draggable = $(this).find(".draggable");
            if (draggable.length) {
                styles.draggable = {
                    fontSize: draggable.css("font-size"),
                    position: draggable.css("position"),
                    left: draggable.css("left"),
                    right: draggable.css("right"),
                    textAlign: draggable.css("text-align"),
                    content: draggable.text()
                };
            }

            // ذخیره ویژگی‌های ادغام سلول‌ها
            let colspan = $(this).attr("colspan");
            let rowspan = $(this).attr("rowspan");
            if (colspan) styles.cell.colspan = colspan;
            if (rowspan) styles.cell.rowspan = rowspan;

            tableStyles[cellId] = styles;
        });

        // ذخیره استایل‌ها در متغیر전역 برای استفاده بعدی
        window.tableStyles = tableStyles;

        console.log("استایل‌های جدول:", tableStyles);
        return tableStyles;
    });


