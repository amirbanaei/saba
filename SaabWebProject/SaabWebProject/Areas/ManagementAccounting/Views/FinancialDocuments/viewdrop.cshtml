    function mergeCellsOnLoad() {
        // مرج کردن سلول‌ها بر اساس داده‌های ذخیره شده در mergedData
        mergedData.forEach(data => {
            let firstCell = $(`td[data-id='${data.mergedCellId}']`); // پیدا کردن اولین سلول مرج‌شده

            // اعمال ویژگی‌های rowspan و colspan
            firstCell.attr("rowspan", data.rowspan).attr("colspan", data.colspan).addClass("merged").text(data.mergedText);

            // حذف سلول‌های دیگر در این مجموعه که باید مرج شوند
            data.mergedIds.forEach(cellId => {
                if (cellId !== data.mergedCellId) {
                    $(`td[data-id='${cellId}']`).remove(); // حذف سلول‌های غیر از سلول اول
                }
            });
        });
    }
    // اعمال داده‌های مرج‌شده روی جدول
    function applyMergedCells(mergedData) {
        mergedData.forEach(data => {
            let firstCell = $(`td[data-id='${data.mergedCellId}']`);

            firstCell.attr("rowspan", data.rowspan)
                .attr("colspan", data.colspan)
                .addClass("merged")
                .text(data.mergedText);

            data.mergedIds.forEach(cellId => {
                if (cellId !== data.mergedCellId) {
                    $(`td[data-id='${cellId}']`).remove();
                }
            });
        });
    }
    function loadMergedData(formId) {
        $.ajax({
            url: "/ManagementAccounting/FinancialDocuments/GetMergedData?formId=" + formId,
            type: "GET",
            success: function (response) {
                if (response.success) {
                    let newMergedData = response.mergedData; // نیازی به JSON.parse نیست
                    console.log("داده‌های دریافت شده:", newMergedData);

                    // اضافه کردن داده‌های جدید بدون جایگزین کردن داده‌های قبلی
                    mergedData = [...mergedData, ...newMergedData];
                    console.log("داده‌های ترکیب شده:", mergedData);

                    // اعمال داده‌های جدید روی جدول
                    applyMergedCells(newMergedData);
                } else {
                    console.warn("هیچ داده‌ای برای این فرم وجود ندارد.");
                }
            },
            error: function (error) {
                console.error("خطا در دریافت داده‌های مرج شده:", error);
            }
        });
    }


    function columnToIndex(colName) {
        let index = 0;
        for (let i = 0; i < colName.length; i++) {
            index = index * 26 + (colName.charCodeAt(i) - 64);
        }
        return index - 1; // برای همخوانی با ایندکس‌های صفرمحور
    }

    $("#FontSize").change(function () {
        let fontSize = $(this).val();

        if (fontSize) { // اگر یک مقدار انتخاب شده باشد
            selectedCells.forEach(cell => {
                $(cell).find(".draggable").css("font-size", fontSize + "px");
            });
        }
    });
    // تعریف آرایه برای ذخیره تغییرات سلول‌ها
    let cellChanges = [];

    // تابع برای ذخیره تغییرات سلول
    function saveCellChanges(cell) {
        let cellInfo = {
            cellNames: [], // آرایه برای ذخیره نام تمام سلول‌های ادغام شده
            fontSize: $(cell).find(".draggable").css("font-size"), // اندازه فونت
            isMerged: $(cell).hasClass("merged"), // وضعیت ادغام سلول
            size: {
                width: $(cell).width(), // عرض سلول
                height: $(cell).height() // ارتفاع سلول
            }
        };

        // اگر سلول ادغام شده است
        if ($(cell).hasClass("merged")) {
            // دریافت محدوده سلول‌های ادغام شده
            let colspan = $(cell).attr("colspan") || 1;
            let rowspan = $(cell).attr("rowspan") || 1;

            let startCell = getCellName(cell);
            let startCol = columnToIndex(startCell.replace(/[0-9]/g, '')) + 1;
            let startRow = parseInt(startCell.replace(/[A-Z]/g, ''));

            // اضافه کردن نام تمام سلول‌های محدوده ادغام شده
            for (let i = 0; i < rowspan; i++) {
                for (let j = 0; j < colspan; j++) {
                    let currentCol = indexToColumn(startCol + j);
                    let currentRow = startRow + i;
                    cellInfo.cellNames.push(currentCol + currentRow);
                }
            }
        } else {
            // اگر سلول ادغام نشده است، فقط نام همان سلول را اضافه می‌کنیم
            cellInfo.cellNames.push(getCellName(cell));
        }

        // بررسی وجود سلول در آرایه و به‌روزرسانی یا اضافه کردن
        let existingIndex = cellChanges.findIndex(item =>
            item.cellNames[0] === cellInfo.cellNames[0]
        );
        if (existingIndex !== -1) {
            cellChanges[existingIndex] = cellInfo;
        } else {
            cellChanges.push(cellInfo);
        }

        console.log("تغییرات ذخیره شده:", cellChanges);
    }

    // تابع کمکی برای دریافت نام سلول
    function getCellName(cell) {
        let $cell = $(cell);
        let colIndex = $cell.index() + 1;
        let rowIndex = $cell.parent().index() + 1;
        return indexToColumn(colIndex) + rowIndex;
    }

    // تابع کمکی برای تبدیل شماره ستون به حروف
    function indexToColumn(index) {
        let column = '';
        while (index > 0) {
            let remainder = (index - 1) % 26;
            column = String.fromCharCode(65 + remainder) + column;
            index = Math.floor((index - 1) / 26);
        }
        return column;
    }

    // اضافه کردن فراخوانی تابع به رویداد تغییر اندازه فونت
    $("#addFontSize").click(function () {
