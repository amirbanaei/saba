    // Merge Cells
    $("#mergeCells").click(function () {
        if (selectedCells.length < 2) {
            alert("حداقل دو سلول را انتخاب کنید!");
            return;
        }

        let tableCols = parseInt($("#colsInput").val()); // تعداد ستون‌ها از ورودی
        let minRow = Infinity, maxRow = -Infinity, minCol = Infinity, maxCol = -Infinity;
        let selectedCellIds = [];

        // محاسبه حداقل و حداکثر ردیف‌ها و ستون‌ها
        selectedCells.forEach(cell => {
            let cellId = parseInt($(cell).attr("data-id"));
            let row = Math.floor((cellId - 1) / tableCols); // محاسبه ردیف
            let col = (cellId - 1) % tableCols; // محاسبه ستون
            selectedCellIds.push(cellId); // ذخیره data-id

            minRow = Math.min(minRow, row);
            maxRow = Math.max(maxRow, row);
            minCol = Math.min(minCol, col);
            maxCol = Math.max(maxCol, col);
        });
        let firstCellId = (minRow * tableCols) + minCol + 1; // محاسبه data-id اولین سلول مرج‌شده

        // انتخاب اولین سلول برای اعمال ویژگی‌های rowspan و colspan
        let firstCell = $(`td[data-id='${(minRow * tableCols) + minCol + 1}']`);
        let mergedText = selectedCells.map(cell => $(cell).text()).join(" "); // ترکیب متن تمام سلول‌ها

        // تعیین rowspan و colspan برای سلول اول
        let rowspan = maxRow - minRow + 1;
        let colspan = maxCol - minCol + 1;

        // ذخیره اطلاعات مرج شده
        let mergedKey = `R${minRow + 1}C${minCol + 1}`;  // کلید برای شناسه مرج شده
        let mergedCellNames = selectedCells.map(cell => {
            let cellId = parseInt($(cell).attr("data-id"));
            let row = Math.floor((cellId - 1) / tableCols); // محاسبه ردیف
            let col = (cellId - 1) % tableCols; // محاسبه ستون
            return getColumnName(col) + (row + 1);  // نام سلول
        });

        // ذخیره داده‌های مرج‌شده
        mergedData.push({
            mergedCell: getColumnName(minCol) + (minRow + 1), // نام سلول جدید
            mergedWith: mergedCellNames.join(", "),
            mergedIds: selectedCellIds,
            rowspan: rowspan, // مقدار rowspan اضافه شد
            colspan: colspan,
            mergedCellId: firstCellId, // data-id سلول اصلی
            // ذخیره data-id سلول‌ها

            // سلول‌هایی که مرج شده‌اند
        });

        // اعمال ویژگی‌های rowspan و colspan به اولین سلول
        firstCell.attr("rowspan", rowspan).attr("colspan", colspan).addClass("merged").text(mergedText);

        // حذف سلول‌های دیگر که در ادغام حضور دارند
        selectedCells.forEach(cell => {
            let cellId = parseInt($(cell).attr("data-id"));
            let row = Math.floor((cellId - 1) / tableCols); // محاسبه ردیف
            let col = (cellId - 1) % tableCols; // محاسبه ستون

            // حذف سلول‌های غیر از اولین سلول ادغام‌شده
            if (!(row === minRow && col === minCol)) {
                $(cell).remove();
            }
        });

        // خالی کردن لیست انتخاب‌شده‌ها و برداشتن کلاس selected از تمامی سلول‌ها
        selectedCells = [];
        $("td").removeClass("selected");

        // نمایش اطلاعات مرج شده در کنسول
        console.log("Merged Data:", mergedData);

        // حالا mergedData آماده ارسال به دیتابیس است
        // ارسال به دیتابیس می‌تواند در اینجا انجام شود
        // مثلا ارسال به یک API
        sendMergedDataToDatabase(mergedData);
    });


    let formulas = []; // ذخیره‌ی فرمول‌ها و سلول‌های مرتبط

    $("#calculate").click(function () {
        var formula = $("#formulaInput").val().trim();
        var targetCell = $("#targetCellInput").val().trim();

        if (formula !== "" && targetCell !== "") {
            var result = evaluateFormula(formula);
            $("td[data-id='" + cellNameToIndex(targetCell) + "']").text(result);
            $("#result").text("نتیجه: " + result);

            // ذخیره فرمول و سلول مقصد
            formulas.push({ cell: targetCell, formula: formula });

            console.log("فرمول‌های ذخیره‌شده:", formulas); // نمایش در کنسول
        } else {
            alert("لطفاً فرمول و سلول مقصد را وارد کنید.");
        }
    });

    // تابع برای نمایش تمام فرمول‌های ذخیره‌شده
    function showFormulas() {
        console.log("تمام فرمول‌های ذخیره‌شده:", formulas);
        alert(JSON.stringify(formulas, null, 2)); // نمایش فرمول‌ها در قالب JSON
    }
    function cellNameToIndex(cellName) {
        var col = cellName.match(/[A-Za-z]+/)[0]; // استخراج حروف برای ستون
        var row = parseInt(cellName.match(/[0-9]+/)[0]) - 1; // استخراج شماره ردیف
        var colIndex = columnToIndex(col); // تبدیل نام ستون به ایندکس

        return row * $("#colsInput").val() + colIndex + 1;
    }



    function evaluateFormula(formula) {
        // تبدیل `if(x, y, z)` به `x ? y : z`
        formula = formula.replace(/([A-Z]+)(\d+)/g, function (match, col, row) {
            var colIndex = columnToIndex(col);
            var cellValue = $("td[data-id='" + ((row - 1) * $("#colsInput").val() + colIndex + 1) + "']").text();
            return cellValue ? parseFloat(cellValue) : 0;
        });

        formula = formula.replace(/if\(([^,]+),\s*([^,]+),\s*([^,]+)\)/g, "$1 ? $2 : $3");

        // تبدیل `sqrt(x)` به `Math.sqrt(x)`
        formula = formula.replace(/sqrt\(([^)]+)\)/g, "Math.sqrt($1)");

        // تبدیل `log(x)` به `Math.log(x)`
        formula = formula.replace(/log\(([^)]+)\)/g, "Math.log($1)");

        // اصلاح برای برخورد با پرانتزهای اضافی
        formula = formula.replace(/(\d+)\s*\+\s*\(\d+\s*\+\s*\d+\)/g, "($1 + ($2))");

        // اصلاح برای پردازش تو در تو if
        formula = formula.replace(/if\(([^,]+),\s*([^,]+),\s*([^,]+)\)/g, "($1) ? ($2) : ($3)");
        try {
            return eval(formula);
        } catch (e) {
            return "خطا در فرمول!";
        }
    }

    $(document).ready(function () {
        let formId = 1; // مقدار واقعی FK_Form1 از دیتابیس دریافت شود

        // تعداد سطرها و ستون‌ها را از ورودی‌ها می‌گیریم
        $("#rowsInput").val(32);
        $("#colsInput").val(30);
        // در صورتی که ورودی خالی باشد مقدار پیش‌فرض 20
        createTable(32, 30);

        loadMergedData(formId);

        // ایجاد جدول

        // بعد از ساخت جدول، باید سلول‌های مرج‌شده را اعمال کنیم
            mergeCellsOnLoad();
