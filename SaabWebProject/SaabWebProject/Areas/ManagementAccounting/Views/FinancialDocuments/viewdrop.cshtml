@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "جدول با قابلیت Drag & Drop و Merge";

}
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />

<style>

    table {
        /*        width: 100%;
        margin: 20px auto;
        border-collapse: collapse;
        text-align: center;*/
    }

    th, td {
        padding: 15px;
        cursor: pointer;
        padding: 15px !important;
    }

    td {
        border: 1px dashed #687278;
    }



    .draggable {
        padding: 4px;
        border: 1px solid #007BFF;
        cursor: grab;
        border-radius: 5px;
        font-size: 12px;
        display: inline-block;
    }

    .drop-target {
        /*border: 2px dashed;*/
    }

    .dragging {
        opacity: 0.5;
    }

    .selected {
        background-color: #f080807a !important;
    }

    .highlight {
        background-color: #f0f8ff;
    }

    .merged {
        background-color: #d1ffd1;
    }

    /*---------------------------*/
    .form-control {
        margin-bottom: 0 !important;
    }

    .rowOption {
        display: flex;
        flex-wrap: nowrap;
    }

    .boxOption {
        display: flex;
        flex-wrap: nowrap;
        border-left: 1px dashed;
        align-items: center;
        justify-content: center;
    }

        .boxOption input {
            max-width: 62px;
            border-left: 1px dashed;
        }



    .boxBit {
        /*margin: 0px 4px;*/
        margin: 5px;
    }

        .boxBit i {
            font-size: 18px;
        }

    .tableH_Lock {
        max-height: 447px;
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }
</style>

