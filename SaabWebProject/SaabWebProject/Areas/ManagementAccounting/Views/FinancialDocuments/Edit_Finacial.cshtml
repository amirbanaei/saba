                     $("#Edit_SelectPeyman").picker({ search: true });
                     $("#Edit_SelectPeyman").picker('set', @Model.Peyman_ID);
                     var $elem = $('#Edit_SelectPeyman');
                                $elem.picker();
                                $elem.on('sp-change', function () {

                                });
                });
                $("#Edit_span_users").load('@Url.Content("/Users/Users/_GetAllUsers_Select")',function(){
                     $("#select_users").attr("id","Edit_selectusers");
                     $("#Edit_selectusers").picker({ search: true });
                     var user = @Model.User_ID;

                     $("#Edit_creditline").show();
                     $("#Edit_creditline").val(@Model.Creditlamdicatros_ID);
                     $("#Edit_Detailedtitle").hide();
                     $("#Edit_Detailedtitle").val(@Model.Detailedtitle_ID);
                     if(user != 0)
                     {
                         /*   alert("inje");*/
                          $("#Edit_selectusers").picker('set',user);
                          $("#Edit_creditline").hide();
                          $("#Edit_Detailedtitle").show();
                     }
                     var $elem = $('#Edit_selectusers');
                     $elem.picker();
                     $elem.on('sp-change', function () {
                        var typeVal = $('#Edit_selectusers').val();
                        if (typeVal == 'Select') {
                            $("#Edit_creditline").show();
                            $("#Edit_Detailedtitle").hide();
                        } else {
                            $("#Edit_Detailedtitle").show();
                            $("#Edit_creditline").hide();
                        }
                     });
                });
        });
</script>


