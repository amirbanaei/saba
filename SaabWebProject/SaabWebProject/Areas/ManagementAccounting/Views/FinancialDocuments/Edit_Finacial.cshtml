<script>
        var Toast = Swal.mixin({
            toast: true,
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });
        var fd = new FormData();
        function sendAjaxEdit(url2, fd2) {
            var debtorCreditValue = $("#Edit_pestenka").val();
            var resultString = debtorCreditValue.replace(/,/g, '');
            fd2.append("Creditor", resultString);
            var debtorCreditValue2 = $("#Edit_bdehkar").val();
            var resultString2 = debtorCreditValue2.replace(/,/g, '');
            fd2.append("ID",@Model.ID);
            fd2.append("Title", $("#Edit_Title").val());
            fd2.append("Debtore", resultString2);
            fd2.append("Peyman_ID", $("#Edit_SelectPeyman").val());
            var mod = $("#Edit_selectusers").val()
            if (mod == 'Select') {
                fd2.append("User_ID", null);
            }
            else {
                fd2.append("User_ID", mod);
            }
            var mod1 = $("#Edit_creditline").val()
            if (mod1 == 'Select') {
                fd2.append("Creditlamdicatros_ID", null);
            }
            else {
                fd2.append("Creditlamdicatros_ID", mod1);
            }
            var mod2 = $("#Edit_Detailedtitle").val()
            if (mod2 == 'Select') {
                fd2.append("Detailedtitle_ID", null);
            }
            else {
                fd2.append("Detailedtitle_ID", mod2);
            }
            fd2.append("DataDocument", $("#datepickerFromEn_Eq").val());
            console.log($("#datepickerFromEn_Eq").val());
            $.ajax({
                url: url2,
                type: 'POST',
                data: fd2,
                processData: false,
                contentType: false,
                success: function (resp1) {
                    console.log("okeye");
                    console.log(resp1);
                    $("#loading-message").css("display", "none");
                    fd = new FormData();
                    if (resp1 == "True") {
                        alert("با موفقیت ثبت شد");
                        location.reload();
                    }
                    else {
                        $("#loading-message").css("display", "none");
                        Toast.fire({
                            icon: 'success',
                            background: '#35434A',
                            color: 'white',
                            title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                        }).then(() => {
                            $("#loading-message").css("display", "none");
                        });
                    }

                },
                error: function (resp1) {
                    console.log(resp1);
                    console.log("Nokeye");
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });
                }
            });
        }
</script>

