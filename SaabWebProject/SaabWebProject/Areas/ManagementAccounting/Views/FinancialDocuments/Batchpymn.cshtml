function sendAjax3(url, data, files) {
    var formData = new FormData();

    // Adding files to FormData
    $.each(files, function (index, file) {
        formData.append('files', file);
    });

    // Adding other data as JSON string to FormData
    formData.append('Filters', JSON.stringify(data));
    console.log(formData);
    $.ajax({
        beforeSend: function () {
            $("#loading-message").show();
        },
        url: url,
        data: formData,
        type: "POST",
        contentType: false,
        processData: false,
        success: function (resp) {
            $("#loading-message").hide();
            if (resp === "True") {
                alert("با موفقیت ثبت شد");
            } else {
                alert("مبلغ‌های بیش از حد مجاز در قرارداد است");
            }
        },
        error: function () {
            $("#loading-message").hide();
            alert("درخواست با مشکل مواجه شد");
        }
    });
}


