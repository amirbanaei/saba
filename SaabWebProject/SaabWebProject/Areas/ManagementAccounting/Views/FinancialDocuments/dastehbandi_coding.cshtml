<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>نمایش نقاط و آدرس</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <style>
        body {
            margin: 0;
            display: flex;
            height: 100vh;
            font-family: sans-serif;
        }

        #map {
            flex: 1;
        }

        #panel {
            width: 350px;
            max-width: 40%;
            background: #fff;
            padding: 10px;
            overflow: auto;
            box-shadow: 0 0 8px rgba(0,0,0,0.2);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            margin-top: 10px;
        }

            table th, table td {
                border: 1px solid #ddd;
                padding: 6px;
                text-align: left;
            }

        tr:hover {
            background: #f0f0f0;
            cursor: pointer;
        }

        input {
            width: 80px;
            margin-right: 5px;
            margin-bottom: 5px;
        }
    </style>
</head>
<body>

    <div id="map"></div>
    <div id="panel">
        <h3>ورود نقاط (۴ مختصات)</h3>
        <form id="pointsForm">
            <div>
                <label>Lat1:</label><input type="text" id="lat1" required><br>
                <label>Lng1:</label><input type="text" id="lng1" required>
            </div>
            <div>
                <label>Lat2:</label><input type="text" id="lat2" required><br>
                <label>Lng2:</label><input type="text" id="lng2" required>
            </div>
            <div>
                <label>Lat3:</label><input type="text" id="lat3" required><br>
                <label>Lng3:</label><input type="text" id="lng3" required>
            </div>
            <div>
                <label>Lat4:</label><input type="text" id="lat4" required><br>
                <label>Lng4:</label><input type="text" id="lng4" required>
            </div>
            <button type="submit">نمایش روی نقشه</button>
        </form>

        <table id="pointsTable">
            <thead><tr><th>Lat</th><th>Lng</th><th>Address</th></tr></thead>
            <tbody></tbody>
        </table>
    </div>

    <script>
        const map = L.map('map').setView([35.6892, 51.3890], 5);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png").addTo(map);
        let drawnLayers = [];

        function clearDrawn() {
            drawnLayers.forEach(l => map.removeLayer(l));
            drawnLayers = [];
            document.querySelector('#pointsTable tbody').innerHTML = '';
        }

        async function reverseGeocode(lat, lng) {
            try {
                const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`;
                const res = await fetch(url);
                const data = await res.json();
                return data.display_name || 'نامعلوم';
            } catch {
                return 'نامعلوم';
            }
        }

        document.getElementById('pointsForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            clearDrawn();

            const points = [
                { Lat: parseFloat(document.getElementById('lat1').value), Lng: parseFloat(document.getElementById('lng1').value) },
                { Lat: parseFloat(document.getElementById('lat2').value), Lng: parseFloat(document.getElementById('lng2').value) },
                { Lat: parseFloat(document.getElementById('lat3').value), Lng: parseFloat(document.getElementById('lng3').value) },
                { Lat: parseFloat(document.getElementById('lat4').value), Lng: parseFloat(document.getElementById('lng4').value) },
            ];

            const tbody = document.querySelector('#pointsTable tbody');

            for (const p of points) {
                const marker = L.marker([p.Lat, p.Lng]).addTo(map);
                drawnLayers.push(marker);

                const address = await reverseGeocode(p.Lat, p.Lng);

                marker.bindPopup(`<b>Lat:</b> ${p.Lat}<br><b>Lng:</b> ${p.Lng}<br><b>Address:</b> ${address}`);

                const tr = document.createElement('tr');
                tr.innerHTML = `<td>${p.Lat}</td><td>${p.Lng}</td><td>${address}</td>`;
                tbody.appendChild(tr);

                tr.addEventListener('click', () => {
                    marker.openPopup();
                    map.setView([p.Lat, p.Lng], 15);
                });
            }

            // زوم روی تمام نقاط
            const group = L.featureGroup(drawnLayers);
            map.fitBounds(group.getBounds(), { padding: [40, 40] });
        });
    </script>

</body>
</html>

