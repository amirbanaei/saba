<script src="~/Scripts/sweetalert2.js" type="text/javascript"></script>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script>
        $(".EditUser").click(function () {
$("#big_modal_body").html(null);
        var id = $(this).attr("id").split('_')[1];


$("#big_modal_body").load('@Url.Content("/Users/Users/_EditUser")?id='+id);



    });
    var
        filters2 = {
            filter02: null,
            filter03: null,
            filter04: null,
            filter05: null,
            filter06: null,

        };

    function updateFilters2() {
        $('.task-list-row2').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters2).forEach(function (filter) {
                var filterData2 = self.data(filter);
                if (filters2[filter] && (filters2[filter] != 'None') && (filters2[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData2 && filterData2.toString().indexOf(filters2[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter2(filterName) {
        filters2[filterName] = this.value;
        updateFilters2();
    }

    // Assigned User Dropdown Filter

    $('#filter02-filter').on('input', function () {
        changeFilter2.call(this, 'filter02');
    });
    $('#filter03-filter').on('input', function () {
        changeFilter2.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilter2.call(this, 'filter04');
    });
    $('#filter05-filter').on('input', function () {
        changeFilter2.call(this, 'filter05');
    });
    $('#filter06-filter').on('input', function () {
        changeFilter2.call(this, 'filter06');
    });

</script>
