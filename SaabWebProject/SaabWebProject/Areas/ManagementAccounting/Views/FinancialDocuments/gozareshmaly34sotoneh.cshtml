@functions {
    private IHtmlString RenderRows(List<gozareshmally> items, long parentId, ref int rowNumber, int depth)
    {
        var html = new System.Text.StringBuilder();
        var children = items.Where(x => x.FK_ID == parentId).ToList();

        foreach (var item in children)
        {
            rowNumber++;
            string rowClass = $"depth-{depth}";

            html.AppendLine($"<tr class='{rowClass}'>");
            html.AppendLine($"<td>{rowNumber}</td>");
            html.AppendLine($"<td>{item.coding}</td>");
            html.AppendLine($"<td>{item.namecoding}</td>");
            html.AppendLine($"<td>{item.SUMBEDEHKAR:N0}</td>");
            html.AppendLine($"<td>{item.SUMBESTENKAR:N0}</td>");

            if (item.SUM < 0)
            {
                html.AppendLine($"<td>{Math.Abs(item.SUM):N0}</td>");
                html.AppendLine("<td>0</td>");
            }
            else
            {
                html.AppendLine("<td>0</td>");
                html.AppendLine($"<td>{item.SUM:N0}</td>");
            }

            html.AppendLine("</tr>");

            html.AppendLine(RenderRows(items, item.ID, ref rowNumber, depth + 1).ToHtmlString());
        }

        return new HtmlString(html.ToString());
    }
}
