// تابع برای نمایش پیام
function showAlert(message) {
    $("#alertMessage").text(message); // پیام را تنظیم می‌کنیم
    $("#alertBox").fadeIn(); // نمایش پیام
}

// تابع برای بستن پیام
function closeAlert() {
    $("#alertBox").fadeOut(); // مخفی کردن پیام
}

// تابع برای ارسال اطلاعات
function submitData() {
    var userInput = $("#documentNumber").val(); // گرفتن شماره سند وارد شده
    console.log($("#documentNumber").val())
    if (userInput !== "") {
        var id = $("#alertBox").data('id'); // دریافت شناسه سند ذخیره شده
        console.log($("#alertBox").data('id'))

        // ارسال درخواست به اکشن editnew با استفاده از AJAX
        $.ajax({
                        url: '@Url.Action("editnew", "FinancialDocuments", new { area = "ManagementAccounting" })', // استفاده از  برای ساخت URL

            type: 'POST',
            data: {
                id: id, // ارسال ID
                shomarehsanad: userInput // ارسال شماره سند وارد شده توسط کاربر
            },
            success: function (response) {
                if (response === "True") {
                    showAlert("عملیات موفقیت‌آمیز بود");
                } else {
                    showAlert("خطا در عملیات. لطفاً مجدداً تلاش کنید.");
                }
            },
            error: function () {
                showAlert("خطا در ارتباط با سرور. لطفاً اتصال اینترنت خود را بررسی کنید.");
            }
        });
    } else {
        showAlert("لطفاً شماره سند را وارد کنید!");
    }
}






