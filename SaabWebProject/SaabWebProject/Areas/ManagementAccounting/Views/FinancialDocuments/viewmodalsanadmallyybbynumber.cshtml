    $(document).ready(function () {
        // مقدارهای قبلی برای بررسی تغییرات
        let previousSumkol2 = "";
        let previousSumkol4 = "";

        function updateValues() {
            // گرفتن مقادیر فعلی اینپوت‌ها
            const currentSumkol2 = document.getElementById("sumkol2").value;
            const currentSumkol4 = document.getElementById("sumkol4").value;

            // بررسی تغییر در مقدار sumkol2
            if (currentSumkol2 !== previousSumkol2) {
                previousSumkol2 = currentSumkol2; // به‌روزرسانی مقدار قبلی
                document.getElementById("bedehkarKol").value = currentSumkol2;
            }

            // بررسی تغییر در مقدار sumkol4
            if (currentSumkol4 !== previousSumkol4) {
                previousSumkol4 = currentSumkol4; // به‌روزرسانی مقدار قبلی
                document.getElementById("bestankarKol").value = currentSumkol4;
            }
        }

        // اجرای بررسی مقادیر به صورت دوره‌ای (هر 200 میلی‌ثانیه)
        setInterval(updateValues, 200);

        // مقداردهی اولیه
        updateValues();
    });
