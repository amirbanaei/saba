@* تابع تغییرات ویو هنگام تغییر مقدار عنوان گزارش *@
<script>
    $("#select_ReportType").on('sp-change', function () {
        switch ($(this).val()) {
            case "1":
                $("#div_users").css("display", "none");
                $("#div_fromPersonelCode").css("display", "none");
                $("#div_toPersonelCode").css("display", "none");
                $("#div_Peyman").css("display", "block");
                $("#div_fromPeymanCode").css("display", "block");
                $("#div_toPeymanCode").css("display", "block");
                $("#div_markazHazine").css("display", "none");
                $("#div_TitleAqsat").css("display", "none");
                $("#div_TitleMarkazHazine").css("display", "none");
                break;
            case "2":
                $("#div_users").css("display", "none");
                $("#div_fromPersonelCode").css("display", "none");
                $("#div_toPersonelCode").css("display", "none");
                $("#div_Peyman").css("display", "block");
                $("#div_fromPeymanCode").css("display", "block");
                $("#div_toPeymanCode").css("display", "block");
                $("#div_markazHazine").css("display", "none");
                $("#div_TitleAqsat").css("display", "none");
                $("#div_TitleMarkazHazine").css("display", "none");
                break;
            case "3":
                $("#div_users").css("display", "block");
                $("#div_fromPersonelCode").css("display", "block");
                $("#div_toPersonelCode").css("display", "block");
                $("#div_Peyman").css("display", "block");
                $("#div_fromPeymanCode").css("display", "block");
                $("#div_toPeymanCode").css("display", "block");
                $("#div_markazHazine").css("display", "none");
                $("#div_TitleAqsat").css("display", "block");
                $("#div_TitleMarkazHazine").css("display", "none");
                break;
            case "4":
                $("#div_users").css("display", "block");
                $("#div_fromPersonelCode").css("display", "block");
                $("#div_toPersonelCode").css("display", "block");
                $("#div_Peyman").css("display", "block");
                $("#div_fromPeymanCode").css("display", "block");
                $("#div_toPeymanCode").css("display", "block");
                $("#div_markazHazine").css("display", "block");
                $("#div_TitleAqsat").css("display", "none");
                $("#div_TitleMarkazHazine").css("display", "block");
                break;
            case "5":
                //alert("dfnsd");
                $("#div_users").css("display", "block");
                $("#div_fromPersonelCode").css("display", "block");
                $("#div_toPersonelCode").css("display", "block");
                $("#div_Peyman").css("display", "none");
                $("#div_fromPeymanCode").css("display", "none");
                $("#div_toPeymanCode").css("display", "none");
                $("#div_markazHazine").css("display", "none");
                $("#div_TitleAqsat").css("display", "none");
                $("#div_TitleMarkazHazine").css("display", "none");
                break;
            default:
                $("#div_users").css("display", "block");
                $("#div_fromPersonelCode").css("display", "block");
                $("#div_toPersonelCode").css("display", "block");
                $("#div_Peyman").css("display", "block");
                $("#div_fromPeymanCode").css("display", "block");
                $("#div_toPeymanCode").css("display", "block");
                $("#div_markazHazine").css("display", "block");
                $("#div_TitleAqsat").css("display", "none");
                $("#div_TitleMarkazHazine").css("display", "none");
        }

    });
</script>
