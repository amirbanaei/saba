@{
    Layout = null;
}
@model List<SaabWebProject.Models.DomainModels.dbAsnadDastehband2>
<input type="file" value="" id="input_file" style="display:none;" />
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
<style>
    .tableH_Lock {
        max-height: 410px;
        /*height: 260px;*/
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0px !important;
    }

    thead th {
        vertical-align: middle;
    }
</style>

<div class="card">
    <div class="table-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive tableH_Lock ">
                <div class="row">
                    @foreach (var it in Model)
                    {

                        <div class="col-xl-4">
                            <label class="form-label"> نام زیر مجموعه </label>
                            <input class="form-control" id="@it.ID" value="@it.Titrl" />
                        </div>
                        <div class="col-xl-2">
                            <label class="form-label">  کد زیر مجموعه </label>
                            <input class="form-control" id="@it.ID" value="@it.COD" />
                        </div>

                    }
                </div>

            </div>

        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
