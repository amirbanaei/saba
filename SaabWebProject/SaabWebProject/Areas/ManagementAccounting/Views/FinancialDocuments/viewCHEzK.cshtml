    function sendAjax14(url2, fd2) {
        const formData = new FormData();
        formData.append("nohesab", fd2.nohesab);

        $.ajax({
            url: url2,
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                $("#loading-circle").css("display", "none");
                console.log(res);
                if (res === "True") {
                    alert("با موفقیت ثبت شد");
                    location.reload();
                }
            },
            error: function (res) {
                $("#loading-circle").css("display", "none");
                console.log(res);
