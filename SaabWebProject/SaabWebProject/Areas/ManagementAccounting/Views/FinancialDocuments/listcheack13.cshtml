<script src="~/Scripts/sweetalert2.js" type="text/javascript"></script>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script>
        $(".EditUser").click(function () {
$("#big_modal_body").html(null);
        var id = $(this).attr("id").split('_')[1];


$("#big_modal_body").load('@Url.Content("/Users/Users/_EditUser")?id='+id);



    });
    var
        filters = {
            //filter01: null,
            filter07: null,
            filter08: null,
            filter09: null,

            //filter09: null, filter05: null,
            //filter06: null,

        };

    function updateFilters3() {
        $('.task-list-row3').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter3(filterName) {
        filters[filterName] = this.value;
        updateFilters3();
    }

    // Assigned User Dropdown Filter
    $('#filter07-filter').on('input', function () {
        changeFilter3.call(this, 'filter07');
    });
    $('#filter08-filter').on('input', function () {
        changeFilter3.call(this, 'filter08');
    });
    $('#filter09-filter').on('input', function () {
        changeFilter3.call(this, 'filter09');
    });
    $('#filter10-filter').on('input', function () {
        changeFilter3.call(this, 'filter10');
    });

</script>
