@using SaabWebProject.Models.DomainModels;

@{
    ViewBag.TitleLargModal = " کاربران مجاز";
    Layout = null;
    SaabEntities db = new SaabEntities();

}
<link href="~/MyStyles/MyStyle.css" rel="stylesheet" />
@model SaabWebProject.Models.DomainModels.tbAdamAdam


@using (Html.BeginForm())
{

    <div id="formControls">

        <div class="card">
            <div class="card-body pb-2">
                <form>
                    <div class="row">

                        <div class="col-xl-7">
                            <div class="form-group mb-3">
                                <label class="form-label"> افراد مجاز </label>
                                <span id="div_users13456"></span>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-xl-11">

                        </div>
                        <div class="col-xl-1" style="margin-top:30px;">
                            <div class="form-group mb-3">
                                <button id="btnCreate234" type="button" class="btn form-control buttonsabt">
                                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                                    <span class="bSabt-text">ثبت</span>
                                </button>
                            </div>
                        </div>
                    </div>


                </form>
            </div>

            <div class="card-arrow">
                <div class="card-arrow-top-left"></div>
                <div class="card-arrow-top-right"></div>
                <div class="card-arrow-bottom-left"></div>
                <div class="card-arrow-bottom-right"></div>
            </div>
        </div>
    </div>
}
@{

    //var fi = db.tbReffrenceSaveLevel.Where(p => p.ID == Model.ID).FirstOrDefault();
    var t = db.tbAdamAdam.Where(p => p.Name == Model.Name).ToList();
}
<script>
    $("#div_users13456").load('@Url.Content("/../Users/Users/editafrad2")', function () {
             $("#select_users1111").attr("id", "users122");
             $("#users122").picker({ search: true });
             $("#users122").picker();
             $('#users122').picker({ search: true });

            var myArray = [];

            @foreach (var d in t)
            {
                @:myArray.push(@d.nam);
            }

             myArray.forEach((x) => $("#users122").picker('set', x));
        });

</script>
<script>
    var fd = new FormData();
    var Obj_fd = new Object();

$("#btnCreate234").click(function () {
    console.log("Button clicked");

    var users = $("#users122").val();
    var things = [];

    // Ensure users is treated as an array
    if (!Array.isArray(users)) {
        users = [users]; // Convert single value to array
    }

    for (let i = 0; i < users.length; i++) {
        var obj = {};
        obj.nam = users[i];
        obj.Name = "@Html.Raw(Json.Encode(Model.Name))"; // Ensure proper string handling
        things.push(obj);
    }

    console.log(things);
    things = JSON.stringify({ 'things': things });

    sendAjax1234('@Url.Action("ebatat_Edit", "FinancialDocuments", new { area = "ManagementAccounting" })', things);
});

</script>
<script>
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
</script>
<script>
    function sendAjax1234(url, things) {
        $("#loading-message").css("display", "block");
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            // dataType: 'json',
            type: 'POST',
            url: url,
            data: things,
            success: function (resp1) {
                console.log(resp1);
                $("#loading-message").css("display", "none");

                if (resp1 == "True") {
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "اطلاعات با موفقیت ذخیره شد"
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });


                }

            },
            error: function (resp1) {
                console.log(resp1);

                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });


    }


</script>
