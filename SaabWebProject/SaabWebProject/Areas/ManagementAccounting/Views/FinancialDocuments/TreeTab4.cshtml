<script>
    function submitData() {
        // نمایش پیام لودینگ
        $("#loading-circle .loadingText1").text('لطفا منتظر ثبت  اطلاعات بمانید ...');
        $("#loading-circle").css("display", "flex");

        // جمع‌آوری داده‌ها به صورت جداگانه
        var dataToSend = {};

        // گرفتن وضعیت هر چک‌باکس به طور جداگانه
        var monthChecked = $("#defaultRadio1").prop("checked");
        var yearChecked = $("#defaultRadio2").prop("checked");
        var legalChecked = $("#defaultRadio3").prop("checked");
        var realChecked = $("#defaultRadio4").prop("checked");
        var descriptionChecked = $("#defaultRadio5").prop("checked");
        var unitChecked = $("#defaultRadio6").prop("checked");
        var projectChecked = $("#defaultRadio7").prop("checked");
        var DAyChecked = $("#defaultRadio8").prop("checked");
        var shomarehnameh = $("#defaultRadio9").prop("checked");

        var timestartChecked = $("#defaultRadio10").prop("checked");
        var timeendChecked = $("#defaultRadio11").prop("checked");
        var timerepetChecked = $("#defaultRadio12").prop("checked");
        var timetamdidChecked = $("#defaultRadio13").prop("checked");
        var mablaghChecked = $("#defaultRadio10").prop("checked");
        var mozohChecked = $("#defaultRadio10").prop("checked");

        // گرفتن مقدار alertMessage01
        var alertMessage = $("#alertMessage01").text(); // مقدار متن داخل h4

        // ارسال داده‌ها برای هر چک‌باکس و alertMessage به صورت مجزا
        $.ajax({
            url: '/Contracts/DefFacilitiesEquipment/creatnew', // آدرس اکشن کنترلر
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                "monthChecked": monthChecked,
                "yearChecked": yearChecked,
                "legalChecked": legalChecked,
                "realChecked": realChecked,
                "descriptionChecked": descriptionChecked,
                "unitChecked": unitChecked,
                "projectChecked": projectChecked,
                "alertMessage": alertMessage,
                "DAyChecked": DAyChecked,
                "shomarehnameh": shomarehnameh,
                "timestartChecked": timestartChecked,
                "timeendChecked": timeendChecked,
                "timerepetChecked": timerepetChecked,
                "timetamdidChecked": timetamdidChecked,
                "mablaghChecked": mablaghChecked,
                "mozohChecked": mozohChecked




                // ارسال مقدار alertMessage01
            }), // ارسال به صورت JSON
            success: function (response) {
                if (response === "true") {
                    $("#loading-circle").css("display", "none"); // پنهان کردن لودینگ
                    alert("با موفقیت ثبت شد");
                    location.reload();
                } else {
                    $("#loading-circle").css("display", "none"); // پنهان کردن لودینگ
                    alert("خطا در ثبت داده‌ها");
                }
            },
            error: function (error) {
                console.error("Error updating record:", error);
            }
        });
    }


    $(".dot3").on('click', function () {
        console.log("11111111");
        // نمایش prompt برای گرفتن شماره سند در div
        showAlert("");

        // ذخیره کردن شناسه سند برای استفاده بعدی
        $("#alertBox01").data('id', 'btnSave01');
    });

    function showAlert(message) {
        $("#alertMessage01").text(message); // پیام را تنظیم می‌کنیم
        $("#alertBox01").fadeIn(); // نمایش پیام
    }

    // تابع برای بستن پیام
    function closeAlert() {
        $(".alert-box").fadeOut(); // مخفی کردن پیام
    }
</script>
