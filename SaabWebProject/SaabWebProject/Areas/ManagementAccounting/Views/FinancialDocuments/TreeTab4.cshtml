        const toggleButton = item.querySelector('.buttonGeneralTree');
        toggleButton.textContent = submenu.classList.contains('open') ? '+' : '-';
    }

    $("#btnSaveContract222").click(function () {
        // جمع‌آوری داده‌ها
        var dataList = []; // ایجاد یک آرایه برای ذخیره تمام داده‌ها
        $("input.trssse2").each(function () {
            var bindValue = $(this).data("bind"); // مقدار data-bind
            var containerValue = $(this).data("container"); // مقدار data-container
            var inputValue = $(this).val(); // مقدار ورودی
            console.log(inputValue); // برای بررسی داده‌ها در کنسول
            console.log(containerValue); // برای بررسی داده‌ها در کنسول
            console.log(bindValue); // برای بررسی داده‌ها در کنسول

            if (inputValue) { // اگر ورودی پر شده است
                dataList.push({
                    bind: bindValue,
                    container: containerValue,
                    name: inputValue
                });
            }
        });

        if (dataList.length > 0) {
            updateDatabase3(dataList);
            console.log(dataList); // برای بررسی داده‌ها در کنسول
        }
    });

    function updateDatabase3(dataList) {
        $.ajax({
            url: '/ManagementAccounting/FinancialDocuments/viewasnadduplad', // آدرس اکشن کنترلر شما
            method: 'POST',
            data: JSON.stringify(dataList), // ارسال آرایه به سرور
            contentType: 'application/json',
            success: function (response) {
                console.log("Record updated successfully.");
                if (response == "true") {
                    alert("با موفقیت ثبت شد");
                    location.reload();
                }
            },
            error: function (error) {
                console.error("Error updating record:", error);
            }
        });
    }

</script>


