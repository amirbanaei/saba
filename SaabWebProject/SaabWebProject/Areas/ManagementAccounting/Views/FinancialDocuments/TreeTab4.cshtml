                      <i class="bi bi-three-dots-vertical Details2 dot3" data-bs-toggle="modal" style="color:green" data-bs-target="#modalLg1" data-container="${outId.replace('L-', '').replace(/-/g, '')}" id="Detail_${outId.replace('L-', '').replace(/-/g, '')}"></i>


