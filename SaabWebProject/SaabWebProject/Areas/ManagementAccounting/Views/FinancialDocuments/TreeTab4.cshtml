<script>

function addSubmenu(parentId) {
    function generateZeros(count) {
        return '0'.repeat(count);
    }

    // دریافت محدودیت‌ها
    const limitList = [@string.Join(",", db.dbAsnadtress1.Select(x => x.ragham))]; // محدودیت هر سطح
    const limitNum = [@string.Join(",", db.dbAsnadtress1.Select(x => x.start))]; // شروع شماره‌گذاری

    const parentElement = document.getElementById(parentId);
    const submenuContainer = parentElement.querySelector('.submenu');
    const currentLevel = parentId === "L" ? 0 : (parentId.split('-').length - 1); // سطح جاری

    const limit = ((10 ** limitList[currentLevel]) - 1) - limitNum[currentLevel] + 1; // محدودیت تعداد زیرآیتم‌ها
    const startNumber = limitNum[currentLevel]; // شروع شماره‌گذاری

    const submenuCount = submenuContainer.children.length; // تعداد زیرمنوهای فعلی

    if (submenuCount < limit) {
        // تعیین شماره بعدی برای زیرآیتم
        const paddedIndex = (startNumber + submenuCount).toString().padStart(`${limit}`.length, '0'); // شماره‌گذاری با صفر
        const newItemId = `${parentId}-${paddedIndex}`; // آیدی جدید

        // ساخت شناسه برای زیرآیتم
        let code = '';
        let outId = '';
        for (let i of limitList.slice(currentLevel + 1)) {
            code += "-" + generateZeros(i);
        }
        outId = `${newItemId}${code}`;

        // پردازش شناسه والد
        const parentElementId = parentElement.id;  // والد (parent) کنونی
        let outId2 = `${parentElementId}${code}`;

        const parentElementId2 = parentElementId.replace('L-', '').replace(/-/g, '');
        const SD = outId2.replace('L-', '').replace(/-/g, '');
        const SD1 = outId.replace('L-', '').replace(/-/g, '');

        const lengthDifference = SD1.length - SD.length;
        let outId2Updated = outId2;
        let outId2Updated2 = SD;

        if (lengthDifference > 0) {
            outId2Updated += '0'.repeat(lengthDifference);
        }

        if (lengthDifference > 0) {
            outId2Updated2 += '0'.repeat(lengthDifference);
