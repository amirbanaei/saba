    function createTable(rows, cols) {


        if (rows > 0 && cols > 0) {
            table = $("<table></table>");
            var thead = $("<thead><tr></tr></thead>");
            for (let i = 0; i < cols; i++) {
                thead.find("tr").append("<th>" + getColumnName(i) + "</th>");
            }
            table.append(thead);

            var tbody = $("<tbody></tbody>");
            for (let i = 0; i < rows; i++) {
                var row = $("<tr></tr>");
                for (let j = 0; j < cols; j++) {
                    var cell = $("<td class='drop-target'></td>").attr("data-id", (i * cols) + j + 1);
                    cell.attr("title", "ستون: " + getColumnName(j) + " ردیف: " + (i + 1));
                    row.append(cell);
                }
                tbody.append(row);
            }
            table.append(tbody);
            $(".table-container").html(table);
        } else {
            alert("لطفاً مقدار صحیح وارد کنید.");
        }


    }


    $("#createTable").click(function () {
        var rows = $("#rowsInput").val();
        var cols = $("#colsInput").val();
        if (rows > 0 && cols > 0) {
            table = $("<table class='table table-hover text-nowrap'></table>");
            var thead = $("<thead><tr></tr></thead>");
            for (let i = 0; i < cols; i++) {
                thead.find("tr").append("<th>" + getColumnName(i) + "</th>");
            }
            table.append(thead);

            var tbody = $("<tbody></tbody>");
            for (let i = 0; i < rows; i++) {
                var row = $("<tr></tr>");
                for (let j = 0; j < cols; j++) {
                    var cell = $("<td class='drop-target'></td>").attr("data-id", (i * cols) + j + 1);
                    cell.attr("title", "ستون: " + getColumnName(j) + " ردیف: " + (i + 1));
                    row.append(cell);
                }
                tbody.append(row);
            }
            table.append(tbody);
            $(".table-container").html(table);
        } else {
            alert("لطفاً مقدار صحیح وارد کنید.");
        }
    });

    $("#addText").click(function () {
        var text = $("#textInput").val().trim();
        if (text !== "") {
            var newText = $("<div class='draggable'></div>").text(text);
            newText.attr("draggable", "true");
            $("#addLaw").append(newText);
            $("#textInput").val("");
        }
    });

    $(document).on("dragstart", ".draggable", function () { $(this).addClass("dragging"); });
    $(document).on("dragend", ".draggable", function () { $(this).removeClass("dragging"); });

    $(document).on("dragover", ".drop-target", function (e) { e.preventDefault(); $(this).addClass("highlight"); });
    $(document).on("dragleave", ".drop-target", function () { $(this).removeClass("highlight"); });

    $(document).on("drop", ".drop-target", function (e) {
        e.preventDefault();
        var draggedElement = $(".dragging");
        $(this).append(draggedElement);
        $(this).removeClass("highlight");
    });
    let mergedCells = {};

    //$(document).on("click", "td", function () {
    //    if ($(this).hasClass("selected")) {
    //        $(this).removeClass("selected");
    //        selectedCells = selectedCells.filter(cell => cell !== this);
    //    } else {
    //        $(this).addClass("selected");
    //        selectedCells.push(this);
    //    }
    //});
    $(document).on("click", "td", function () {
        if ($(this).hasClass("selected")) {
            $(this).removeClass("selected");
            selectedCells = selectedCells.filter(cell => cell !== this);
        } else {
            $(this).addClass("selected");
            selectedCells.push(this);
        }
    });
    $("#unmergeCells").click(function () {
        if (selectedCells.length !== 1) {
            alert("لطفاً یک سلول ادغام‌شده را انتخاب کنید.");
            return;
        }

        let cell = selectedCells[0];
        let rowspan = $(cell).attr("rowspan");
        let colspan = $(cell).attr("colspan");

        if (!rowspan && !colspan) {
            alert("این سلول ادغام نشده است.");
            return;
        }

        // دریافت اطلاعات مربوط به محدوده سلول‌های مرج‌شده
        let tableCols = $("#colsInput").val();
        let cellId = parseInt($(cell).attr("data-id"));
        let minRow = Math.floor((cellId - 1) / tableCols);
        let minCol = (cellId - 1) % tableCols;

        // حذف ویژگی‌های rowspan و colspan
        $(cell).removeAttr("rowspan").removeAttr("colspan");

        // بازسازی سلول‌های جداگانه در محدوده
        for (let row = minRow; row < minRow + parseInt(rowspan); row++) {
            for (let col = minCol; col < minCol + parseInt(colspan); col++) {
                // ایجاد سلول جدید در جدول
                let newCell = $("<td class='drop-target'></td>").attr("data-id", (row * tableCols) + col + 1);
                newCell.attr("title", "ستون: " + String.fromCharCode(65 + col) + " ردیف: " + (row + 1));
                newCell.text($(cell).text());

                // جایگزینی سلول ادغام‌شده با سلول‌های جدید
                let targetCell = $("td[data-id='" + ((row) * tableCols + col + 1) + "']");
                targetCell.replaceWith(newCell);
            }
        }

        // حذف محتوای سلول ادغام‌شده
        $(cell).remove();

        selectedCells = [];
        $("td").removeClass("selected");
    });

    let mergedData = [
        {
            mergedCell: "I24",                // نام سلول مرج‌شده
            mergedCellId: 469,                // شناسه سلول مرج‌شده
            mergedIds: [469, 490, 470, 489],  // شناسه‌های سلول‌های مرج‌شده
            mergedWith: "I24, J25, J24, I25", // سلول‌هایی که با آن مرج شده‌اند
            rowspan: 2,                       // تعداد سطرهایی که سلول مرج‌شده در آن قرار دارد
            colspan: 2,                       // تعداد ستونی که سلول مرج‌شده در آن قرار دارد
            mergedText: "Some merged text"    // متنی که از سلول‌های مرج‌شده ترکیب می‌شود
        },
        {
            mergedCell: "E29",                // نام سلول مرج‌شده
            mergedCellId: 565,                // شناسه سلول مرج‌شده
            mergedIds: [565, 566, 567],       // شناسه‌های سلول‌های مرج‌شده
            mergedWith: "E29, F29, G29",      // سلول‌هایی که با آن مرج شده‌اند
            rowspan: 1,                       // تعداد سطرهایی که سلول مرج‌شده در آن قرار دارد
            colspan: 3,                       // تعداد ستونی که سلول مرج‌شده در آن قرار دارد
            mergedText: "Another merged text" // متنی که از سلول‌های مرج‌شده ترکیب می‌شود
        }
    ];
    // Merge Cells
    $("#mergeCells").click(function () {
        if (selectedCells.length < 2) {
            alert("حداقل دو سلول را انتخاب کنید!");
            return;
        }

        let tableCols = parseInt($("#colsInput").val()); // تعداد ستون‌ها از ورودی
        let minRow = Infinity, maxRow = -Infinity, minCol = Infinity, maxCol = -Infinity;
        let selectedCellIds = [];

        // محاسبه حداقل و حداکثر ردیف‌ها و ستون‌ها
        selectedCells.forEach(cell => {
            let cellId = parseInt($(cell).attr("data-id"));
            let row = Math.floor((cellId - 1) / tableCols); // محاسبه ردیف
            let col = (cellId - 1) % tableCols; // محاسبه ستون
            selectedCellIds.push(cellId); // ذخیره data-id

            minRow = Math.min(minRow, row);
            maxRow = Math.max(maxRow, row);
            minCol = Math.min(minCol, col);
            maxCol = Math.max(maxCol, col);
        });
        let firstCellId = (minRow * tableCols) + minCol + 1; // محاسبه data-id اولین سلول مرج‌شده

        // انتخاب اولین سلول برای اعمال ویژگی‌های rowspan و colspan
        let firstCell = $(`td[data-id='${(minRow * tableCols) + minCol + 1}']`);
        let mergedText = selectedCells.map(cell => $(cell).text()).join(" "); // ترکیب متن تمام سلول‌ها

        // تعیین rowspan و colspan برای سلول اول
        let rowspan = maxRow - minRow + 1;
        let colspan = maxCol - minCol + 1;

        // ذخیره اطلاعات مرج شده
        let mergedKey = `R${minRow + 1}C${minCol + 1}`;  // کلید برای شناسه مرج شده
        let mergedCellNames = selectedCells.map(cell => {
            let cellId = parseInt($(cell).attr("data-id"));
            let row = Math.floor((cellId - 1) / tableCols); // محاسبه ردیف
            let col = (cellId - 1) % tableCols; // محاسبه ستون
            return getColumnName(col) + (row + 1);  // نام سلول
        });

        // ذخیره داده‌های مرج‌شده
        mergedData.push({
            mergedCell: getColumnName(minCol) + (minRow + 1), // نام سلول جدید
            mergedWith: mergedCellNames.join(", "),
            mergedIds: selectedCellIds,
            mergedCellId: firstCellId, // data-id سلول اصلی
            // ذخیره data-id سلول‌ها

            // سلول‌هایی که مرج شده‌اند
        });

        // اعمال ویژگی‌های rowspan و colspan به اولین سلول
        firstCell.attr("rowspan", rowspan).attr("colspan", colspan).addClass("merged").text(mergedText);

        // حذف سلول‌های دیگر که در ادغام حضور دارند
        selectedCells.forEach(cell => {
            let cellId = parseInt($(cell).attr("data-id"));
            let row = Math.floor((cellId - 1) / tableCols); // محاسبه ردیف
            let col = (cellId - 1) % tableCols; // محاسبه ستون

            // حذف سلول‌های غیر از اولین سلول ادغام‌شده
            if (!(row === minRow && col === minCol)) {
                $(cell).remove();
            }
        });

        // خالی کردن لیست انتخاب‌شده‌ها و برداشتن کلاس selected از تمامی سلول‌ها
        selectedCells = [];
        $("td").removeClass("selected");

        // نمایش اطلاعات مرج شده در کنسول
        console.log("Merged Data:", mergedData);

        // حالا mergedData آماده ارسال به دیتابیس است
        // ارسال به دیتابیس می‌تواند در اینجا انجام شود
        // مثلا ارسال به یک API
        sendMergedDataToDatabase(mergedData);
    });


    let formulas = []; // ذخیره‌ی فرمول‌ها و سلول‌های مرتبط

    $("#calculate").click(function () {
        var formula = $("#formulaInput").val().trim();
        var targetCell = $("#targetCellInput").val().trim();

        if (formula !== "" && targetCell !== "") {
            var result = evaluateFormula(formula);
            $("td[data-id='" + cellNameToIndex(targetCell) + "']").text(result);
            $("#result").text("نتیجه: " + result);

            // ذخیره فرمول و سلول مقصد
            formulas.push({ cell: targetCell, formula: formula });

            console.log("فرمول‌های ذخیره‌شده:", formulas); // نمایش در کنسول
        } else {
            alert("لطفاً فرمول و سلول مقصد را وارد کنید.");
        }
    });

    // تابع برای نمایش تمام فرمول‌های ذخیره‌شده
    function showFormulas() {
        console.log("تمام فرمول‌های ذخیره‌شده:", formulas);
        alert(JSON.stringify(formulas, null, 2)); // نمایش فرمول‌ها در قالب JSON
    }
    function cellNameToIndex(cellName) {
        var col = cellName.match(/[A-Za-z]+/)[0]; // استخراج حروف برای ستون
        var row = parseInt(cellName.match(/[0-9]+/)[0]) - 1; // استخراج شماره ردیف
        var colIndex = columnToIndex(col); // تبدیل نام ستون به ایندکس

        return row * $("#colsInput").val() + colIndex + 1;
    }


   
    function evaluateFormula(formula) {
        // تبدیل `if(x, y, z)` به `x ? y : z`
        formula = formula.replace(/([A-Z]+)(\d+)/g, function (match, col, row) {
            var colIndex = columnToIndex(col);
            var cellValue = $("td[data-id='" + ((row - 1) * $("#colsInput").val() + colIndex + 1) + "']").text();
            return cellValue ? parseFloat(cellValue) : 0;
        });

        formula = formula.replace(/if\(([^,]+),\s*([^,]+),\s*([^,]+)\)/g, "$1 ? $2 : $3");

        // تبدیل `sqrt(x)` به `Math.sqrt(x)`
        formula = formula.replace(/sqrt\(([^)]+)\)/g, "Math.sqrt($1)");

        // تبدیل `log(x)` به `Math.log(x)`
        formula = formula.replace(/log\(([^)]+)\)/g, "Math.log($1)");

        // اصلاح برای برخورد با پرانتزهای اضافی
        formula = formula.replace(/(\d+)\s*\+\s*\(\d+\s*\+\s*\d+\)/g, "($1 + ($2))");

        // اصلاح برای پردازش تو در تو if
        formula = formula.replace(/if\(([^,]+),\s*([^,]+),\s*([^,]+)\)/g, "($1) ? ($2) : ($3)");
        try {
            return eval(formula);
        } catch (e) {
            return "خطا در فرمول!";
        }
    }


function columnToIndex(colName) {
    let index = 0;
    for (let i = 0; i < colName.length; i++) {
        index = index * 26 + (colName.charCodeAt(i) - 64);
    }
    return index - 1; // برای همخوانی با ایندکس‌های صفرمحور
}


  
