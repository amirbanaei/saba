@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "جدول با قابلیت Drag & Drop و Merge";

}
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />

<style>

    table {
        /*        width: 100%;
        margin: 20px auto;
        border-collapse: collapse;
        text-align: center;*/
    }

    th, td {
        padding: 15px;
        cursor: pointer;
        padding: 15px !important;
    }

    td {
        border: 1px dashed #687278;
    }



    .draggable {
        padding: 4px;
        border: 1px solid #007BFF;
        cursor: grab;
        border-radius: 5px;
        font-size: 12px;
        display: inline-block;
    }

    .drop-target {
        /*border: 2px dashed;*/
    }

    .dragging {
        opacity: 0.5;
    }

    .selected {
        background-color: #f080807a !important;
    }

    .highlight {
        background-color: #f0f8ff;
    }

    .merged {
        background-color: #d1ffd1;
    }

    /*---------------------------*/
    .form-control {
        margin-bottom: 0 !important;
    }

    .rowOption {
        display: flex;
        flex-wrap: nowrap;
    }

    .boxOption {
        display: flex;
        flex-wrap: nowrap;
        border-left: 1px dashed;
        align-items: center;
        justify-content: center;
    }

        .boxOption input {
            max-width: 62px;
            border-left: 1px dashed;
        }

    .boxBit {
        /*margin: 0px 4px;*/
        margin: 5px;
    }

        .boxBit i {
            font-size: 18px;
        }

    .tableH_Lock {
        max-height: 447px;
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }
</style>

<div class="tab-content">
    <div class="rowOption">
        <div class="boxOption">
            <input class="form-control boxBit" type="number" id="rowsInput" placeholder="- - - -" min="1" title="تعداد سطر">
            <input class="form-control boxBit" type="number" id="colsInput" placeholder="| | | |" min="1" title="تعداد ستون">
            <button class="boxBit form-control buttonGeneralPlus" id="createTable" title="ایجاد جدول">
                <i class="bi bi-table"></i>
            </button>
        </div>
        <div class="boxOption">
            <input class="form-control boxBit" type="number" id="hideRowInput" placeholder="- - - -" min="1" title="شماره ردیف">
            <button class="boxBit form-control buttonGeneralPlus" id="hideRow" title="مخفی کردن ردیف">
                <i class="bi bi-eye-slash"></i>
            </button>
            <button class="boxBit form-control buttonGeneralPlus" id="showRow" title="ظاهر کردن ردیف">
                <i class="bi bi-eye"></i>
            </button>
        </div>

        <div class="boxOption">
            <input class="form-control boxBit" type="number" id="hideColInput" placeholder="| | | |" min="1" title="شماره ستون">
            <button class="boxBit form-control buttonGeneralPlus" id="hideCol" title="مخفی کردن ستون">
                <i class="bi bi-eye-slash"></i>
            </button>
            <button class="boxBit form-control buttonGeneralPlus" id="showCol" title="ظاهر کردن ستون">
                <i class="bi bi-eye"></i>
            </button>
        </div>

        <div class="boxOption">
            <button class="boxBit form-control buttonGeneralPlus" id="mergeCells" title="ادغام سلول‌های">
                <i class="fa fa-grip-lines"></i>
            </button>
            <button class="boxBit form-control buttonGeneralPlus" id="unmergeCells" title="جدا کردن سلول‌ها">
                <i class="fa fa-grip"></i>
            </button>
            <button class="boxBit form-control buttonGeneralPlus" id="removeInnerBorders" title="حذف بردر داخلی">
                <i class="bi bi-file-x" style="rotate:90deg;"></i>
            </button>
        </div>
        <div class="boxOption">
            <input class="form-control boxBit" type="number" id="textInput" placeholder="متن را وارد کنید" min="1" title="متن را وارد کنید">
            <button class="boxBit form-control buttonGeneralPlus" id="addText" title="افزودن">
                <i class="bi bi-plus-square-dotted"></i>
            </button>
        </div>
        <div class="boxOption1">
            <div class="boxBit" id="addLaw"></div>
        </div>
    </div>


    <div class="card mt-3 mb-3" style="width: 100%">
        <div class="table-content p-4">
            <div class="table-container table-responsive tableH_Lock">
            </div>
        </div>
        <div class="card-arrow">
            <div class="card-arrow-top-left"></div>
            <div class="card-arrow-top-right"></div>
            <div class="card-arrow-bottom-left"></div>
            <div class="card-arrow-bottom-right"></div>
        </div>
    </div>



    <div class="row">
        <div class="col-xl-3">
            <input class="boxBit form-control" type="text" id="formulaInput" placeholder="فرمول (مثلاً A1+B2 یا sqrt(A2) یا log(A3))">

        </div>
        <div class="col-xl-3">
            <input class="boxBit form-control" type="text" id="targetCellInput" placeholder="سلول مقصد (مثلاً A4)">

        </div>
        <div class="col-xl-1">
            <button class="boxBit form-control buttonGeneralPlus" id="calculate" title="افزودن">
                <i class="bi bi-calculator"></i>
            </button>
        </div>

        <p id="result"></p>
    </div>
</div>


<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Scripts/sweetalert2.js"></script>
<script>
    document.getElementById("removeInnerBorders").addEventListener("click", function () {
        let selectedCells = Array.from(document.querySelectorAll(".selected"));

        selectedCells.forEach(cell => {
            let row = cell.parentElement.rowIndex;
            let col = cell.cellIndex;

            selectedCells.forEach(otherCell => {
                let otherRow = otherCell.parentElement.rowIndex;
                let otherCol = otherCell.cellIndex;

                if (row === otherRow && col === otherCol - 1) {
                    // اگر دو سلول کنار هم در یک سطر هستند
                    cell.style.borderLeft = "none";
                    otherCell.style.borderRight = "none";
                }

                if (col === otherCol && row === otherRow + 1) {
                    // اگر دو سلول روی هم قرار دارند
                    cell.style.borderTop = "none";
                    otherCell.style.borderBottom = "none";
                }
            });
        });
    });



    // برای نمایش دوباره ردیف‌ها
    $("#showRow").click(function () {
        var rowNumber = $("#hideRowInput").val();
        if (rowNumber > 0 && rowNumber <= table.find("tbody tr").length) {
            var row = table.find("tbody tr").eq(rowNumber - 1); // شماره ردیف را با ایندکس تطبیق می‌دهیم
            row.css("display", "table-row"); // نمایش دوباره ردیف
        } else {
            alert("لطفاً شماره ردیف صحیح وارد کنید.");
        }
    });

    // برای نمایش دوباره ستون‌ها
    $("#showCol").click(function () {
        var colNumber = $("#hideColInput").val();
        if (colNumber > 0 && colNumber <= table.find("thead th").length) {
            // نمایش دوباره تمامی سلول‌های آن ستون
            table.find("tbody tr").each(function () {
                $(this).find("td").eq(colNumber - 1).css("display", "table-cell");
            });
            table.find("thead th").eq(colNumber - 1).css("display", "table-cell"); // نمایش دوباره هدر ستون
        } else {
            alert("لطفاً شماره ستون صحیح وارد کنید.");
        }
    });

    $("#hideRow").click(function () {
        var rowNumber = $("#hideRowInput").val();
        if (rowNumber > 0 && rowNumber <= table.find("tbody tr").length) {
            var row = table.find("tbody tr").eq(rowNumber - 1); // شماره ردیف را با ایندکس تطبیق می‌دهیم
            row.css("display", "none"); // مخفی کردن ردیف
        } else {
            alert("لطفاً شماره ردیف صحیح وارد کنید.");
        }
    });

    $("#hideCol").click(function () {
        var colNumber = $("#hideColInput").val();
        if (colNumber > 0 && colNumber <= table.find("thead th").length) {
            // مخفی کردن تمامی سلول‌های آن ستون
            table.find("tbody tr").each(function () {
                $(this).find("td").eq(colNumber - 1).css("display", "none");
            });
            table.find("thead th").eq(colNumber - 1).css("display", "none"); // مخفی کردن هدر ستون
        } else {
            alert("لطفاً شماره ستون صحیح وارد کنید.");
        }
    });

    let table;
    let selectedCells = [];
    function getColumnName(index) {
        let columnName = '';
        while (index >= 0) {
            columnName = String.fromCharCode(index % 26 + 65) + columnName;
            index = Math.floor(index / 26) - 1;
        }
        return columnName;
    }


