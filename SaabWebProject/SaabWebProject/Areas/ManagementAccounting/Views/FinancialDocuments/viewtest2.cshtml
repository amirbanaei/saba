    //            for (let j = 0; j < cols; j++) {
    //                var cell = $("<td class='drop-target'></td>").attr("data-id", (i * cols) + j + 1);
    //                cell.attr("title", "ستون: " + getColumnName(j) + " ردیف: " + (i + 1));
