<script>
    var counter = 1;
    $("#btn_SaveMovaqat").click(function () {
        if ($("#input_Darsad").val() > 100 || $("#input_Darsad").val() < 0) {
            alert("لطفا درصد را صحیح وارد نمایید");
        } else if ($("#select_Moalefe").val() == 0) {
            alert("لطفا مولفه  را انتخاب نمایید");
        } else if ($("#input_Darsad").val().trim().lenght == 0) {
            alert("لطفا درصد را وارد نمایید");
        } else {
            var tbodyRef = document.getElementById('table_First').getElementsByTagName('tbody')[0];
            //ردیف
            // Insert a row at the end of table
            var newRow = tbodyRef.insertRow();
            // Insert a cell at the end of the row
            var newCell = newRow.insertCell();
            // Append a text node to the cell
            var newText = document.createTextNode(counter);
            newCell.appendChild(newText);
            //پیمان
            // Insert a cell at the end of the row
            var newCell = newRow.insertCell();
            // Append a text node to the cell
            var newText = document.createTextNode($("#select_Moalefe option:selected").text());
            newCell.appendChild(newText);
            //دیگر سلول ها 7 تا
            var newCell = newRow.insertCell();

            // Insert a cell at the end of the row

            var newText = document.createTextNode($("#input_Darsad").val());
            newCell.appendChild(newText);

            var newCell = newRow.insertCell();
            var z = document.createElement('span');
            z.innerHTML = '<a class="text-success up" id="link_priority"><i class="fa fa-arrow-circle-up"></i></a><a class="text-danger down"><i class="fa fa-arrow-circle-down"></i></a>';
            newCell.appendChild(z);
            counter++;

        }
    });
</script>
