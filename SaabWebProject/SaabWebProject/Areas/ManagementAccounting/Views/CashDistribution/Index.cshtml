@*جدول تقسیم وجه*@
<script>

    var counter = 1;
    $("#peyman2").load('@Url.Content("/../Contracts/Peyman/_GetAllListPeymans_Select")',function(){
           $("#select_peyman").attr("id", "select_peyman1");
            var $elem = $('#select_peyman1');
            $elem.picker();
            $elem.on('sp-change', function(){


              var tbodyRef = document.getElementById('firstTable').getElementsByTagName('tbody')[0];
                 //ردیف
                // Insert a row at the end of table
                var newRow = tbodyRef.insertRow();
                // Insert a cell at the end of the row
                var newCell = newRow.insertCell();
                // Append a text node to the cell
                var newText = document.createTextNode(counter);
                newCell.appendChild(newText);
              //پیمان
                // Insert a cell at the end of the row
                var newCell = newRow.insertCell();
                // Append a text node to the cell
                var newText = document.createTextNode($("#select_peyman1 option:selected").text());
                newCell.appendChild(newText);
              //دیگر سلول ها 7 تا

                // Insert a cell at the end of the row
                var z = document.createElement('span');
                z.innerHTML = '<input class="form-control price" \>';
                var newCell = newRow.insertCell();
                newCell.appendChild(z);

                var z = document.createElement('span');
                z.innerHTML = '<input class="form-control price" \>';
                var newCell = newRow.insertCell();
               newCell.appendChild(z);

                var z = document.createElement('span');
                z.innerHTML = '<input class="form-control price" \>';
                var newCell = newRow.insertCell();
                newCell.appendChild(z);

                var z = document.createElement('span');
                z.innerHTML = '<input class="form-control price" \>';
                var newCell = newRow.insertCell();
                newCell.appendChild(z);

                var z = document.createElement('span');
                z.innerHTML = '<input class="form-control price" \>';
                var newCell = newRow.insertCell();
                newCell.appendChild(z);

                var z = document.createElement('span');
                z.innerHTML = '<input class="form-control price" \>';
                var newCell = newRow.insertCell();
                newCell.appendChild(z);

                var z = document.createElement('span');
                z.innerHTML = '<input class="form-control price" \>';
                var newCell = newRow.insertCell();
                newCell.appendChild(z);
                counter++;

                $(".price").on("keyup",function () {
                    var amount = $(this).val().replace(/[\D\s\._\-]+/g, "");
                    amount = amount ? parseInt(amount, 10) : 0;
                    $(this).val(function () {
                        return ( amount === 0 ) ? "" : amount.toLocaleString("en-US");
                    });
                    var totalValue = 0 ;
                    $.each( $(".price"), function(index, item) {
                      var amount = $(this).val().replace(/[\D\s\._\-]+/g, "");
                      totalValue += amount ? parseInt(amount, 10) : 0;

                  });
                    $("#totalPrice").text(( totalValue === 0 ) ? "" : totalValue.toLocaleString("en-US"));
                });

       });
     });

</script>

@*تخصیص وجه*@
<script>
    var counter1 = 1;
        $("#peyman1").load('@Url.Content("/../Contracts/Peyman/_GetAllListPeymans_Select")',function(){
           $("#select_peyman").attr("id", "select_peyman2");
            var $elem = $('#select_peyman2');
            $elem.picker();
            $elem.on('sp-change', function(){

              var tbodyRef = document.getElementById('mytable').getElementsByTagName('tbody')[0];
                 //ردیف
                // Insert a row at the end of table
                var newRow = tbodyRef.insertRow();
                // Insert a cell at the end of the row
                var newCell = newRow.insertCell();
                // Append a text node to the cell
                var newText = document.createTextNode(counter1);
                newCell.appendChild(newText);
              //پیمان
                // Insert a cell at the end of the row
                var newCell = newRow.insertCell();
                // Append a text node to the cell
                var newText = document.createTextNode($("#select_peyman2 option:selected").text());
                newCell.appendChild(newText);
              //دیگر سلول ها 2 تا
                var z = document.createElement('span');
                z.innerHTML = '<input class="form-control darsad" id="darsad_'+counter1+'" \>';
                var newCell = newRow.insertCell();
                newCell.appendChild(z);

                var z = document.createElement('span');
                z.innerHTML = '<input class="form-control darsadPrice" id="darsadPrice_'+counter1+'" \>';
                var newCell = newRow.insertCell();
                newCell.appendChild(z);

                counter1++;

                $(".darsad").on("keyup",function () {
                    var amount = $("#TotalPriceForTakhsis").val().replace(/[\D\s\._\-]+/g, "");
                    amount = amount ? parseInt(amount, 10) : 0;
                    var rowprice = (amount) * ($(this).val()) / 100 ;
                    var id = $(this).attr("id").split("_")[1];
                    $("#darsadPrice_"+id).val(( rowprice === 0 ) ? "" : rowprice.toLocaleString("en-US"));
                    var totalvalue = 0 ;
                    $.each( $(".darsadPrice"), function(index, item) {
                      var amount = $(this).val().replace(/[\D\s\._\-]+/g, "");
                      amount = amount ? parseInt(amount, 10) : 0;
                      totalvalue += amount;
                        $("#totalprice_takhsis").text(( totalvalue === 0 ) ? "" : totalvalue.toLocaleString("en-US"));
                  });
                });

            });
       });

</script>

@* سه رقم جدا کردن *@
<script>

    $(function () {
        $.each($(".number"), function (index, item) {

            var amount = $(this).val().replace(/[\D\s\._\-]+/g, "");
            amount = amount ? parseInt(amount, 10) : 0;
            $(this).val(function () {
                return (amount === 0) ? "" : amount.toLocaleString("en-US");
            });
        });

    });



    $(".number").on("keyup", function () {
        var amount = $(this).val().replace(/[\D\s\._\-]+/g, "");
        amount = amount ? parseInt(amount, 10) : 0;
        $(this).val(function () {
            return (amount === 0) ? "" : amount.toLocaleString("en-US");
        });
    });
</script>