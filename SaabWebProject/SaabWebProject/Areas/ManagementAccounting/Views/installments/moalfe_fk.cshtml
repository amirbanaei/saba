@model List<SaabWebProject.Models.DomainModels.tbContractMoalefeDastmozdi>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
@{
    Layout = null;
}

<select class="form-select select_peyman" id="select_moalfe" name="select_peyman">
    <option hidden value="0">انتخاب کنید</option>
    @foreach (var item in Model.ToList())
    {
        <option value="@item.md_ID">@item.md_Title</option>
    }
</select>

<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>



<script>
    $(document).ready(function () {
        $("#select_moalfe").picker({ search: true });
    });
</script>