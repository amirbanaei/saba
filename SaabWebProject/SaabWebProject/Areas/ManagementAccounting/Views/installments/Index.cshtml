<style>
    input[type="checkbox"] {
        margin-bottom: 0 !important;
    }
</style>
<div class="tab-content">
    <div class="d-flex align-items-center ">
        <p class="m-0" style="line-height:70px">نحوه درخواست: </p>
        <div class="wrapper mx-3" style="box-shadow: none !important;">
            <input class="Option_PeKa" type="radio" name="UserOrPeyman" id="option-1" value="User" checked>
            <input class="Option_PeKa" type="radio" name="UserOrPeyman" id="option-2" value="Peyman">
            <label for="option-1" class="option option-1">
                <div class="dot"></div>
                <span>کاربر</span>
            </label>
            <label for="option-2" class="option option-2">
                <div class="dot"></div>
                <span>پیمان</span>
            </label>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-6" style="display:none">
            <label class="form-label ">پیمان</label>


            @Html.Action("_GetAllListPeymans_Select", "Peyman", new { area = "Contracts" })

        </div>
        <div class="col-xl-4">
            <label class="form-label">کاربر</label>


            @Html.Action("_GetAllUsers_Select", "Users", new { area = "Users" })

        </div>
        <div class="col-xl-2">
            <label class="form-label"> مبلغ کل (ریال) </label>

            <input class="form-control AmountInput control " id="totalAmountInput" name="totalAmountInput" type="text" maxlength="15" />
            @*<textarea class="form-control AmountInput" id="totalAmountInput" name="totalAmountInput" maxlength="15"></textarea>
                <input class="form-control AmountInput" id="totalAmountInput" />*@
        </div>
        <div class="col-xl-2">
            <label class="form-label"> نوع محاسبه </label>

            @Html.Action("typeOfCalculate", "installments", new { area = "ManagementAccounting" })
        </div>
        <div class="col-xl-2" id="SectionNumberOfInstallment" style="display:none;">

            <label class="form-label"> تعداد اقساط ماهانه </label>
            <input class="form-control control AmountInput" id="numberOfInstallment" name="numberOfInstallment" type="number" min="1" max="6" value="1" />
        </div>
    </div>

    <div class="row">
        <div class="col-xl-2">
            <label class="form-label">ماه</label>

            <select id="month2" name="month_pr" class="form-select ">
                @*<option value="0" hidden>انتخاب ماه</option>*@
                @{
                    for (var i = 1; i <= 12; i++)
                    {
                        <option selected="selected" value="@i">@i </option>
                    }
                }
                <option selected="selected" value="0" hidden>انتخاب ماه</option>
            </select>
        </div>
        <div class="col-xl-2">
            <label class="form-label">سال</label>

            <div>
                <select id="years" name="year_Eq" class="form-select">
                    @{
                        System.Globalization.PersianCalendar cs2 = new System.Globalization.PersianCalendar();

                        for (var i = 4; i >= 0; i--)
                        {
                            var s = DateTime.Now.AddYears(-i + 2);
                            <option selected="selected" value="@cs2.GetYear(s)">@cs2.GetYear(s)</option>
                        }
                    }
                    <option selected="selected" hidden value="0">انتخاب سال </option>

                </select>
            </div>

        </div>
        <div class="col-xl-6">
            <label class="form-label">نام   </label>
            @Html.Action("moalfe_fk", "installments", new { area = "ManagementAccounting" })
        </div>

    </div>
    <div class="row">
        <div class="col-xl-10">
