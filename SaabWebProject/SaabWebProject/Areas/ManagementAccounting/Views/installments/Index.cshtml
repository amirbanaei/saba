<script>

    @* click on plus the Input Installment *@
    function plusInputInstallmentManually(e) {
        var a = 1;
        var nodes = document.querySelectorAll('.installmentAmountInputManually');
        var nodesLength=parseInt(nodes.length)
        var last = nodes[nodesLength - 1];
        if (last.value<1) {
            var Toast = Swal.mixin({
                toast: true,
          /*      position: 'top-start',*/
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });
            Toast.fire({
                icon: 'warning',
                background: '#35434A',
                color: 'white',
                title: "اقساط ماه گذشته را تکمیل کنید"
