    function sendAjax22(url2, fd2) {
        // Get the selected radio button value
        var selectedValue = $('input[type=radio][name=UserOrPeyman]:checked').val();
        var typee = $("#select_TypeOfCalculate").val();
        // Append the appropriate data based on the selected value

