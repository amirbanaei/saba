                 }
            </select>
        </div>
        <div  class="col-xl-5"><div/>`
        )
    }

    @* Changed Input Installment *@
    function InputInstallmentManuallyChange(e) {
        let btns = document.querySelectorAll(".installmentAmountInputManually")
        let sum = 0;
        btns.forEach((btn) => {
            if (btn.value == "") {
                btn.value = 0;
            }
            sum += parseInt(NumberWithOutComma(btn.value));
        })
        let disabledBu = document.querySelector("#btnPlusInput"); /*->-[1402/08/16]-|KH|-*/
        let totalAmount = $("#TAmountManually").val();
        let totalAmount2 = totalAmount - sum;
        if (totalAmount2 < 0) {
            alert("مبلغ وارد شده بیشتر از حد مجاز است.")
            console.log(totalAmount2)
            /*------------------------------------------------[1402/08/16]-|KH|-*/
            e.value = $("#inputTotalManuallyInstall").val();
            $("#inputTotalManuallyInstall").val(0)
            //----------------------------------------------
            disabledBu.disabled = true // غیر فعال کردن لید پلاس
            /*-------------------------------------------------------------|KH|-*/
            return false;
        }
        /*------------------------------------------------[1402/08/16]-|KH|-*/
        if (totalAmount2 > 0) {
            disabledBu.disabled = false; // فعال کردن لید پلاس
        }
        else {
            disabledBu.disabled = true // غیر فعال کردن لید پلاس
        }
        /*-------------------------------------------------------------|KH|-*/
        $("#inputTotalManuallyInstall").val(NumberWithComma(totalAmount2))
    }

    function InsManuRemainingClicked(e) {
        let disabledBu = document.querySelector("#btnPlusInput");
        var nodes = document.querySelectorAll('.installmentAmountInputManually');
        var last = nodes[nodes.length - 1];
        let lastVal = parseInt(NumberWithOutComma(last.value));
        if (lastVal > 0) {
            lastVal += parseInt(NumberWithOutComma($("#inputTotalManuallyInstall").val()));
            last.value = NumberWithComma(lastVal);
            /*------------------------------------------------[1402/08/16]-|KH|-*/
            disabledBu.disabled = true // غیر فعال کردن لید پلاس
            /*-------------------------------------------------------------|KH|-*/
        }
        else {
            last.value = $("#inputTotalManuallyInstall").val();
            /*------------------------------------------------[1402/08/16]-|KH|-*/
            disabledBu.disabled = true // غیر فعال کردن لید پلاس
            /*-------------------------------------------------------------|KH|-*/
        }
        $("#inputTotalManuallyInstall").val(0);
    }
</script>

@* Inputs Gets Comma On Changing *@
<script>

    $(".inputForInstallment").on("keydown", function (event) {
        const BACKSPACE_KEY = 8
        const _colonPositions = [3, 7, 11, 15, 19]
        const _newValue = $(this).val().trim()
        const _currentPosition = _newValue.length
        if (event.keyCode !== BACKSPACE_KEY) {
            if (_colonPositions.some(position => position === _currentPosition)) {
                $(".inputForInstallment").val(_newValue.concat(','))
            }
        }
    })

    $(".AmountInput").on("keyup", function (event) {

        // کاربر متنی انتخابی انتخاب میکند
        var selection = window.getSelection().toString();
        if (selection !== '') {
            return;
        }

        // زمانی که جهت ها کلیک میشوند
        if ($.inArray(event.keyCode, [38, 40, 37, 39]) !== -1) {
            return;
        }

        var $this = $(this);

        // گرفتن مقدار
        var input = $this.val();

        var input = input.replace(/[\D\s\._\-]+/g, "");
        input = input ? parseInt(input, 10) : 0;

        $this.val(function () {
            return (input === 0) ? "" : input.toLocaleString("en-US");
        });
    });

    function inputAddCommaLive(event) {
        var selection = window.getSelection().toString();
        if (selection !== '') {
            return;
        }
        if ($.inArray(event.keyCode, [38, 40, 37, 39]) !== -1) {
            return;
        }
        var $this = $(event);
        var input = $this.val();
        var input = input.replace(/[\D\s\._\-]+/g, "");
        input = input ? parseInt(input, 10) : 0;
        $this.val(function () {
            return (input === 0) ? "" : input.toLocaleString("en-US");
        });
    }
</script>

