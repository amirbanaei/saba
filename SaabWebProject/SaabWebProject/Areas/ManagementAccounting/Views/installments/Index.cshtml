        </div>
        <div class="col-xl-2 " >
            <label class="form-label">سال</label>
            <select id="Year_`+ nodesLength +`"name="year_Eq" class="form-select">
                 @{

                     for (var i = 4; i >= 0; i--)
                     {
                         var s = DateTime.Now.AddYears(-i + 2);
                         <option selected="selected" value="@cs2.GetYear(s)">@cs2.GetYear(s)</option>
                     }
                 }
             </select>
        </div>
        <div class="col-xl-2">
            <label class="form-label">ماه</label>
            <select id="Month_`+ nodesLength +`" name="month_Eq" class="form-select">
                 @{
                     for (var i = 1; i <= 12; i++)
                     {
                         <option selected="selected" value="@i">@i</option>
