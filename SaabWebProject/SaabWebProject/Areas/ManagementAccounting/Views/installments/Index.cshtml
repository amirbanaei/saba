@* کلیک بر روی محاسبه اقساط *@
<script>

    // Number WithOut Comma
    var NumberWithOutComma = (str) => str.split(',').join('');

    // Number With Comma
    var NumberWithComma = (value) => value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");

    // محاسبه اقساط
    function ShowInstallments1() {

        let select_TypeOfCalculate = $('#select_TypeOfCalculate').val()

        if (select_TypeOfCalculate > 2 || select_TypeOfCalculate < 1) {
            alert("لطفا نوع محاسبه را انتخاب کنید.")
            return false;
        }

        // محاسبه دستی
        else if (select_TypeOfCalculate == 1) {
            let totalAmountInput = $("#totalAmountInput").val();
            totalAmountInput = NumberWithOutComma(totalAmountInput);
            let InputNumberOfInstallment = $("#numberOfInstallment");
            var num = parseFloat(InputNumberOfInstallment.val());
            let inputSection = $("#SectionInstallmentInputs")

            if (totalAmountInput <= 0) {
                alert("لطفا مبلغ را وارد کنید.")
                InputNumberOfInstallment.val("");
                inputSection.empty();
                return false;
            }
            //if (num > 6) {
            //    InputNumberOfInstallment.val(6);
            //    num = 6;
            //}
            if (num < 1) {
                InputNumberOfInstallment.val(1);
                num = 1;
            }
            inputSection.empty();
            installmentMoney = totalAmountInput / num;

            $.ajax({
                //beforeSend: function () {
                //    document.getElementById("loading-message").style.display = "block";
                //},
                url: "../../ManagementAccounting/installments/InstallmentManually",
                type: "get",
                data: { totalAmountInput: totalAmountInput },
                success: function (result) {
                    $("#SectionInstallmentInputs").html(result)
