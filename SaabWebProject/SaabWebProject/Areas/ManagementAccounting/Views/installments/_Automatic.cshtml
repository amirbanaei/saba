<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<link href="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.style.css" rel="stylesheet" />
<style>
    .days > tr > td {
        color: white !important;
    }

    .mds-bootstrap-persian-datetime-picker-popover {
        background: #1d2834;
        font-family: var(--bs-body-font-family);
    }

    .select-year-box {
        background-color: #1d2834 !important;
    }

    .popover-header {
        background-color: #1d2834 !important;
        color: white !important;
    }
</style>

<h5>ثبت خودکار اقساط</h5>
<div class="row" style="margin-top:20px">
    <div class="col-xl-3">
        <div class="form-group mb-3">
            <label class="form-label">مبلغ کل (ریال)</label>
            <input class="form-control" />
        </div>
    </div>
    <div class="col-xl-3">
        <div class=" form-group mb-12">
            <div class="col-xl-12">
                <label class="form-label">تاریخ شروع اقساط</label>

            </div>

            <div class="col-xl-12" style="margin-top:8px">
                <input class="form-control" id="datepickerFrom_Eq" />
                <input class="form-control" type="hidden" id="datepickerFromEn_Eq" />
            </div>
        </div>
    </div>
</div>
<div class="row" style="margin-top:20px">
    <div class="col-xl-10">

        <div class="table-responsive">
            <table class="table table-hover text-nowrap">
                <thead>
                    <tr style="text-align:center;margin:auto">
                        <th>
                            @Html.DisplayName("شماره قسط")
                        </th>
                        <th style="width:60%">
                            @Html.DisplayName("تاریخ (خودکار)")
                        </th>
                        <th>
                            @Html.DisplayName("مبلغ ( ریال)")
                        </th>
                    


                    </tr>

                </thead>
                <tbody>


                    <tr style="text-align:center;">


                        <td> <span>1</span></td>

                        <td></td>
                        <td></td>
                        <td></td>


                    </tr>

                    <tr style="text-align:center;">


                        <td> <span>2</span></td>

                        <td></td>
                        <td></td>
                        <td></td>


                    </tr>

                    <tr style="text-align:center;">


                        <td> <span>3</span></td>

                        <td></td>
                        <td></td>
                        <td></td>


                    </tr>

                    <tr style="text-align:center;">


                        <td> <span>4</span></td>

                        <td></td>
                        <td></td>
                        <td></td>


                    </tr>

                    <tr style="text-align:center;">


                        <td> <span>5</span></td>

                        <td></td>
                        <td></td>
                        <td></td>


                    </tr>

                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="row" style="margin-top:20px">
    <div class="col-xl-3">
        <label class="form-control">جمع</label>
        <input class="form-control" />
    </div>
    <div class="col-xl-3">
      
    </div>
    <div class="col-xl-3">
        
    </div>
    <div class="col-xl-3">
            <button class="btn buttonsabt form-control">
                <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                <span class="bSabt-text">ثبت</span>
            </button>
    </div>
</div>
    @section Scripts{
        @*<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
        <script src="~/Scripts/jquery-ui.js"></script>
        <script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>*@
        <script>

            $(function () {


                $('#year_Eq').picker({ search: true });
                $('#month_Eq').picker({ search: true });

                $('#datepickerFrom_Eq').MdPersianDateTimePicker({
                    targetTextSelector: '#datepickerFrom_Eq',
                    targetDateSelector: '#datepickerFromEn_Eq',
                    dateFormat: 'yyyy-MM-dd',
                    isGregorian: false,
                    enableTimePicker: true,
                    disableBeforeToday: false
                });

                $('#datepickerTo_Eq').MdPersianDateTimePicker({
                    targetTextSelector: '#datepickerTo_Eq',
                    targetDateSelector: '#datepickerToEn_Eq',
                    dateFormat: 'yyyy-MM-dd',
                    isGregorian: false,
                    enableTimePicker: true,
                    disableBeforeToday: false
                });

            });
        </script>



    }
