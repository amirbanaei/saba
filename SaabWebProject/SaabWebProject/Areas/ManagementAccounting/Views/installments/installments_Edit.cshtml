@* کلیک بر روی محاسبه اقساط *@
<script>

    // Number WithOut Comma
    var NumberWithOutComma = (str) => str.split(',').join('');

    // Number With Comma
    var NumberWithComma = (value) => value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");

    // محاسبه اقساط
    function ShowInstallments1_edit() {

        let select_TypeOfCalculate_edit = $('#select_TypeOfCalculate_edit').val()

        if (select_TypeOfCalculate_edit > 2 || select_TypeOfCalculate_edit < 1) {
            alert("لطفا نوع محاسبه را انتخاب کنید.")
            return false;
        }

        // محاسبه دستی
        else if (select_TypeOfCalculate_edit == 1) {
            let totalAmountInput_edit = $("#totalAmountInput_edit").val();
            totalAmountInput_edit = NumberWithOutComma(totalAmountInput_edit);
            let InputnumberOfInstallment_edit = $("#numberOfInstallment_edit");
            var num = parseFloat(InputnumberOfInstallment_edit.val());
            let inputSection = $("#SectionInstallmentInputs_edit")

            if (totalAmountInput_edit <= 0) {
                alert("لطفا مبلغ را وارد کنید.")
                InputnumberOfInstallment_edit.val("");
                inputSection.empty();
                return false;
            }
            if (num > 6) {
                InputnumberOfInstallment_edit.val(6);
                num = 6;
            }
            else if (num < 1) {
                InputnumberOfInstallment_edit.val(1);
                num = 1;
            }
            inputSection.empty();
            installmentMoney = totalAmountInput_edit / num;

            $.ajax({
                //beforeSend: function () {
                //    document.getElementById("loading-message").style.display = "block";
                //},
                url: "../../ManagementAccounting/installments/InstallmentManually2",
                type: "get",
                data: { totalAmountInput: totalAmountInput_edit },
                success: function (result) {
                    $("#SectionInstallmentInputs_edit").html(result)
                    $("#inputTotalManuallyInstall").val(NumberWithComma($("#inputTotalManuallyInstall").val()))

                }
            });

        }
        // محاسبه خودکار
        else if (select_TypeOfCalculate_edit == 2) {

            let totalAmountInput_edit = $("#totalAmountInput_edit").val();
            totalAmountInput_edit = NumberWithOutComma(totalAmountInput_edit)
            let InputnumberOfInstallment_edit = $("#numberOfInstallment_edit");
            var num = parseFloat(InputnumberOfInstallment_edit.val());
            let inputSection = $("#SectionInstallmentInputs_edit")

            if (totalAmountInput_edit <= 0) {
                alert("لطفا مبلغ را وارد کنید.")
                InputnumberOfInstallment_edit.val("");
                inputSection.empty();
                return false;
            }
            //if (num > 6) {
            //    InputnumberOfInstallment_edit.val(6);
            //    num = 6;
            //}
            if (num < 1) {
                InputnumberOfInstallment_edit.val(1);
                num = 1;
            }
            inputSection.empty();
            console.log(num);
            installmentMoney = totalAmountInput_edit / num;
            var month = parseInt($('#years2').val(), 10);
            var month3 = month;

            var t = parseInt($('#month3').val(), 10); // Convert to integer

            for (let i = 1; i <= num; i++) {
                // first
                var index = t;
                console.log($('#years2').val());
                var month2 = month;
                if (t === 12) {
                    index = 1;
                    month2 += 1; // Increment the value of month2;
                }
                if (i == 1) {
                    $("#SectionInstallmentInputs_edit").append(`
                            <div class="row">
                                <div class=" col-md-5 ">
                                    <div class="row">
                                        <div class="col-xl-1" style="width: 6%; padding-top: 6px;">
                                              <span></span>
                                        </div>
                                        <div class="col-xl-11" style="width:94%">
                                            <label class="form-label"> مبلغ قسط (ریال) ماه `+ i + ` </label>
                                            <input class="form-control control  installmentAmountInput_edit " id=installmentInput_`+ i + ` value=` + installmentMoney + ` disabled />
                                        </div>
                                    </div>
