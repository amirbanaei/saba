        $("#inputTotalManuallyInstall").val(0);
    }
</script>


@* Inputs Gets Comma On Changing *@
<script>

    $(".inputForInstallment").on("keydown", function (event) {
        const BACKSPACE_KEY = 8
        const _colonPositions = [3, 7, 11, 15, 19]
        const _newValue = $(this).val().trim()
        const _currentPosition = _newValue.length
        if (event.keyCode !== BACKSPACE_KEY) {
            if (_colonPositions.some(position => position === _currentPosition)) {
                $(".inputForInstallment").val(_newValue.concat(','))
            }
        }
    })

    $(".AmountInput").on("keyup", function (event) {

        // کاربر متنی انتخابی انتخاب میکند
        var selection = window.getSelection().toString();
        if (selection !== '') {
            return;
        }

        // زمانی که جهت ها کلیک میشوند
        if ($.inArray(event.keyCode, [38, 40, 37, 39]) !== -1) {
            return;
        }

        var $this = $(this);

        // گرفتن مقدار
        var input = $this.val();

        var input = input.replace(/[\D\s\._\-]+/g, "");
        input = input ? parseInt(input, 10) : 0;

        $this.val(function () {
            return (input === 0) ? "" : input.toLocaleString("en-US");
        });
    });

    function inputAddCommaLive(event) {
        var selection = window.getSelection().toString();
        if (selection !== '') {
            return;
        }
        if ($.inArray(event.keyCode, [38, 40, 37, 39]) !== -1) {
            return;
        }
        var $this = $(event);
        var input = $this.val();
        var input = input.replace(/[\D\s\._\-]+/g, "");
        input = input ? parseInt(input, 10) : 0;
        $this.val(function () {
            return (input === 0) ? "" : input.toLocaleString("en-US");
        });
    }
</script>

