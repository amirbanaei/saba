@{
    Layout = null;
}
@model IEnumerable<SaabWebProject.Models.DomainModels.tbinstallments>
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
<style>

    .tableH_Lock {
        max-height: 260px;
        /*height: 260px;*/
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0px !important;
        min-width: 100px;
    }

    thead th {
        vertical-align: middle;
    }
</style>
<div class="card">
    <div class="table-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive tableH_Lock">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("فعالیت")
                            </th>
                            <th>
                                @Html.DisplayName("#")
                            </th>
                            <th>
                                @Html.DisplayName("کاربرحقوقی")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter01-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("کاربرحقیقی ")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter02-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("پیوست مدرک")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("مبلغ کل")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter04-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("تعداد اقساط ")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter05-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("سال ")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter06-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("ماه ")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter07-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("شرح")
                            </th>
                        </tr>
                    </thead>
                    <tbody style="text-align:center">

                        @if (Model != null)
                        {

                            var i = 0;
                            string karbarHoghoghi = "";
                            string karbarHaghighi = "";
                            string peyvastemadrak = "";
                            string tedadaghsat = "";
                            foreach (var item in Model)
                            {
                                if (item != null)
                                {
                                    i++;
                                    if (item.Peyman_ID != null)
                                    {
                                        karbarHoghoghi = item.tbPeymanContracts.pec_BriefTitle;
                                    }
                                    else
                                    {
                                        karbarHoghoghi = "---";
                                    }
                                    //==================================
                                    if (item.User_ID != null)
                                    {
                                        karbarHaghighi = item.tbUsers.FullName;
                                    }
                                    else
                                    {
                                        karbarHaghighi = "---";
                                    }
                                    //==================================
                                    if (item.File_SystemName != null)
                                    {
                                        peyvastemadrak = "دانلود";
                                    }
                                    else
                                    {
                                        peyvastemadrak = "ذخیره نشده";

                                    }
                                    //==================================


                                    switch (item.Calculation_type)
                                    {
                                        case false:
                                            tedadaghsat = "خودکار";
                                            break;
                                        case true:
                                            tedadaghsat = "دستی";
                                            break;

                                    }


                                    //==================================
                                    <tr class="task-list-row"
                                        data-filter01="@karbarHoghoghi"
                                        data-filter02="@karbarHaghighi"
                                        data-filter03="@peyvastemadrak"
                                        data-filter04="@string.Format("{0:N0}", item.Total_Amount)"
                                        data-filter05="@tedadaghsat"
                                        data-filter06="@item.Year"
                                        data-filter07="@item.Month">
                                        <td>
                                            <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                                <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <div class="dropdown-menu">
                                                    @if (item.For_Fish != true)
                                                    {
                                                        <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item edit" id="Edit_@item.installment_ID">ویرایش</a>
                                                        <a class="dropdown-item Delete" id="Delete_@item.installment_ID">حذف</a>

                                                    }
                                                    <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item Details" id="Detail_@item.installment_ID">جزئیات</a>


                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @i
                                        </td>
                                        <td>@karbarHoghoghi</td>
                                        <td>@karbarHaghighi</td>
                                        @if (item.File_SystemName != null)
                                        {
                                            <td style="color:green">
                                                <a target="_blank" href="~/Areas/ManagementAccounting/Contents/installmentAttachmentsFile/@item.File_SystemName">
                                                    دانلود
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>ذخیره نشده</td>
                                        }
                                        <td>@string.Format("{0:N0}", item.Total_Amount)</td>
                                        <td>@tedadaghsat</td>
                                        <td>@item.Year</td>
                                        <td>@item.Month</td>
                                        <td>
                                            @if (item.Title.Length > 40)
                                            {
                                                <span title="@item.Title">@item.Title.Substring(0, 40)...</span>
                                            }
                                            else
                                            {
                                                @item.Title
                                            }
                                        </td>

                                    </tr>
                                }
                                else
                                {
                                    i++;
                                    <tr>
                                        <td>
                                            <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                                <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <div class="dropdown-menu">
                                                    <a data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item edit" id="Edit_@item.installment_ID">ویرایش</a>
                                                    <a data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item Details">جزئیات</a>
                                                    <a class="dropdown-item Delete" id="Delete_@item.installment_ID">حذف</a>


                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @i
                                        </td>
                                        <td>
                                        </td>
                                        @item.tbPeymanContracts.pec_Title
                                        <td>
                                        </td>
                                        @item.tbUsers.FullName


                                        @if (item.File_SystemName != null)
                                        {
                                            <td style="color:green">
                                                <a target="_blank" href="~/Areas/ManagementAccounting/Contents/RegistrationDucumentAttachmentsFile/@item.File_SystemName">
                                                    دانلود
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>ذخیره نشده</td>
                                        }


                                        <td>
                                            @string.Format("{0:N0}", item.Total_Amount)

                                        </td>
                                        <td>

                                            @item.Title
                                        </td>
                                        <td>
                                            @switch (item.Calculation_type)
                                            {
                                                case false:
                                                    @Html.DisplayName("خودکار")
                                                    break;
                                                case true:
                                                    @Html.DisplayName("دستی")
                                                    break;

                                            }

                                        </td>

                                    </tr>
                                }
                            }

                            // Your foreach loop code here
                        }

                    </tbody>

                </table>
            </div>
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script>

    var
        filters = {
            filter01: null,
            filter02: null,
            filter03: null,
            filter04: null,
            filter05: null,
            filter06: null,
            filter07: null,
        };

    function updateFilters() {
        $('.task-list-row').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter(filterName) {
        filters[filterName] = this.value;
        updateFilters();
    }

    // Assigned User Dropdown Filter
    $('#filter01-filter').on('input', function () {
        changeFilter.call(this, 'filter01');
    });
    $('#filter02-filter').on('input', function () {
        changeFilter.call(this, 'filter02');
    });
    $('#filter03-filter').on('input', function () {
        changeFilter.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilter.call(this, 'filter04');
    });
    $('#filter05-filter').on('input', function () {
        changeFilter.call(this, 'filter05');
    });
    $('#filter06-filter').on('input', function () {
        changeFilter.call(this, 'filter06');
    });
    $('#filter07-filter').on('input', function () {
        changeFilter.call(this, 'filter07');
    });



</script>
