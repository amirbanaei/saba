    function sendAjax111(url, data) {
        console.log(url);

        $.ajax({
            beforeSend: function () {
                document.getElementById("loading-message").style.display = "block";
            },
            url: url,
            data: data,
            type: "POST",
            dataType: "html",
            success: function (resp) {
                console.log(resp);
                document.getElementById("loading-message").style.display = "none";
                if (resp == "True") {
                    alert("با موفقیت ثبت شد");
                    location.reload();
                }

                else {
                    alert("resp")
                }
            },
            error: function (resp) {
                document.getElementById("loading-message").style.display = "none";
                alert("دچار مشکل شده است ");
                console.log(resp);
            }
        });
    }
</script>