
@{
    ViewBag.TitleLargModal = "مدیریت اخبار";
    Layout = null;
}
<script src="~/Assets/js/jalalidatepicker.min.js"></script>
<link href="~/Assets/css/jalalidatepicker.min.css" rel="stylesheet" />
<link href="~/MyStyles/jalalidatepicker.css" rel="stylesheet" />
<div id="" class="mb-5">

    <div class="card">
        <div class="card-body pb-2">
            <div class="row">
                <div class="col-xl-3">
                    <label class="form-label"> جایگاه مورد نظر </label>
                    <select class="form-select">
                        <option style="color:black">انتخاب نمایید..</option>
                        <option style="color:black">جایگاه 1</option>
                        <option style="color:black">جایگاه 2</option>
                        <option style="color:black">جایگاه 3</option>
                        <option style="color:black">جایگاه 4</option>
                    </select>
                </div>
                <div class="col-xl-3">
                    <label class="form-label">از تاریخ </label>
                    @*<input class="form-control" id="" />*@


                    @*------------------------------------------------[1402/09/01]-|KH|-*@
                    <input data-jdp jdp-btn-close id="datepickerFromEn_pr" class="form-control pdate" name="datepickerFromEn_pr" >
                    @*-------------------------------------------------------------|KH|-*@
                </div>
                <div class="col-xl-3">
                    <label class="form-label"> تا تاریخ  </label>
                    @*<input class="form-control" />*@


                    @*------------------------------------------------[1402/09/01]-|KH|-*@
                    <input data-jdp jdp-btn-close id="datepickerToEn_pr" class="form-control pdate" name="datepickerToEn_pr" >
                    @*-------------------------------------------------------------|KH|-*@
                </div>
                <div class="col-xl-3">
                    <label class="form-label"> (ثانیه)زمان رفرش </label>
                    <input class="form-control" type="number" />
                </div>
            </div>

            <div class="row">
                <div class="col-xl-2" style="margin-top:30px">
                    <button id="btn_file" type="button" class=" form-control btn buttonGeneral">
                        <i class="bi bi-upload fa-fw me-1 VecGeneral"></i>
                        <span class="bGeneral-text">پیوست</span>
                    </button>
                </div>
            </div>
            <div class="row">
                <div class="col-xl-10" style="margin-top:4.5%">
                </div>
                <div class="col-xl-2">
                        <button id="savebtn" type="button" class="btn form-control buttonsabt">
                            <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                            <span class="bSabt-text">ثبت</span>
                        </button>
                </div>
            </div>
            <hr class="hr-bg" />
            <div class="row">
                <div class="table-responsive">
                    <table class="table table-hover" style="text-align:center;">
                        <thead class="table-dark">
                            <tr>
                                <td>جایگاه </td>
                                <td>نام عکس</td>
                                <td>فعال/غیرفعال </td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>حضرت زهرا</td>
                                <td><input type="checkbox" checked /></td>
                            </tr>
                            <tr>
                                <td>1</td>
                                <td>حضرت علی</td>
                                <td><input type="checkbox" checked /></td>

                            </tr>
                            <tr>
                                <td>1</td>
                                <td>سردار سلیمانی</td>
                                <td><input type="checkbox" checked /></td>

                            </tr>
                            <tr>
                                <td>2</td>
                                <td>اتاق شیشه ای</td>
                                <td><input type="checkbox" checked /></td>

                            </tr>
                            <tr>
                                <td>2</td>
                                <td>کارگزاری ها</td>
                                <td><input type="checkbox" checked /></td>

                            </tr>
                            <tr>
                                <td>2</td>
                                <td>یونیفرم خودرو ها</td>
                                <td><input type="checkbox" checked /></td>

                            </tr>
                            <tr>
                                <td>3</td>
                                <td>پرداخت عیدی</td>
                                <td><input type="checkbox" checked /></td>

                            </tr>
                            <tr>
                                <td>3</td>
                                <td>برترین رشد ها</td>
                                <td><input type="checkbox" checked /></td>

                            </tr>
                            <tr>
                                <td>3</td>
                                <td>جلسه هوشمند سازی عملیات ماموریت</td>
                                <td><input type="checkbox" checked /></td>

                            </tr>
                            <tr>
                                <td>4</td>
                                <td>زاد روزمهدی چشمی</td>
                                <td><input type="checkbox" checked /></td>

                            </tr>
                            <tr>
                                <td>4</td>
                                <td>زادروز مهدی چشمی</td>
                                <td><input type="checkbox" checked /></td>

                            </tr>
                            <tr>
                                <td>4</td>
                                <td>زادروز مهندس زنده دل</td>
                                <td><input type="checkbox" checked /></td>

                            </tr>
                        </tbody>

                    </table>
                </div>
            </div>
        </div>

    </div>

    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
@*------------------------------------------------[1402/09/01]-|KH|-*@
<script type="text/javascript">
    jalaliDatepicker.startWatch({
        //time: true,
        days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
        persianDigits: true,
        autoClose: true,
        autocomplete: true,
        // showCloseBtn:true,
        showEmptyBtn: false,
        showCloseBtn: true,
        zIndex: 1000000000,

    });
</script>
@*-------------------------------------------------------------|KH|-*@



