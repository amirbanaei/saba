                                    data-filter02=@it.dbrelatinperson.Count()>
                                    <td>
                                        <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                            <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <div class="dropdown-menu">
                                                @*<a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item edit" id="Edit_@item.ID">ویرایش</a>*@
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item Erja" id="Erja_@it.ID">ویرایش</a>
                                                @*<a class="dropdown-item Delete" id="Delete_@item.ID">حذف</a>*@
                                                @*<a data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item edit" id="Edit_@item.ID">ویرایش</a>*@


                                            </div>


                                        </div>
                                    </td>
                                    <td>@it.tbUsers.FullName</td>

                                    <td>@it.dbrelatinperson.Count()</td>
                                    <td>
                                        @if (cityvalue.Length > 40)
                                        {
                                            <span title="@cityvalue">@cityvalue.Substring(0, 40)...</span>
                                        }
                                        else
                                        {
                                            @cityvalue
                                        }
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>


        <div class="card-arrow">
            <div class="card-arrow-top-left"></div>
            <div class="card-arrow-top-right"></div>
            <div class="card-arrow-bottom-left"></div>
            <div class="card-arrow-bottom-right"></div>
        </div>
    </div>
</div>
<script src="~/Scripts/sweetalert2.js" type="text/javascript"></script>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
