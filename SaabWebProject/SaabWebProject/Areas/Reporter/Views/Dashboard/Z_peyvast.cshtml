
@{
    //ViewBag.Title = "نمایش لاگ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
<script src="~/Assets/js/jquery3.6.0.js"></script>
<script src="~/Assets/plugins/bootstrapTables/dist/bootstrap-table-locale-all.js"></script>
<script src="~/Assets/plugins/bootstrapTables/dist/bootstrap-table-locale-all.min.js"></script>
<script src="~/Assets/plugins/bootstrapTables/dist/bootstrap-table.js"></script>
<script src="~/Assets/plugins/bootstrapTables/dist/bootstrap-table.min.js"></script>
