<script>
    $(document).on("click", ".btn-load", function () {

        var btn = $(this);
        var tabPane = btn.closest(".tab-pane");        // تب فعلی را پیدا می‌کنیم
        var url = tabPane.data("url");                 // url از data-url
        var container = tabPane.find(".tab-content-holder");

        // مخفی کردن دکمه
        btn.closest(".row").hide();

        // نمایش متن لودینگ
        container.append("<div style='color:aqua;' class='loading-text mt-3'>در حال بارگذاری...</div>");

        $.ajax({
            url: url,
            type: "GET",
            success: function (data) {
                // حذف متن لودینگ
                container.find(".loading-text").remove();

                // قرار دادن محتوا
                container.append(data);
            },
            error: function () {
                container.find(".loading-text").text("خطا در بارگذاری! دوباره تلاش کنید.");

                // دوباره دکمه را نشان بدهیم
                btn.closest(".row").show();
            }
        });
    });


</script>



