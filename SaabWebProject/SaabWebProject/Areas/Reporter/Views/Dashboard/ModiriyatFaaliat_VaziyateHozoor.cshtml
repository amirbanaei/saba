                </td>
                <td colspan="1">
                    <select class="form-select " style="margin-bottom: 0px !important;">
                        <option value="1">غیبت</option>
                        <option value="2">مرخصی استحقاقی</option>
                        <option value="3"> مرخصی استعلاجی</option>
                        <option value="4"> ماموریت کاری</option>
                    </select>
                </td>
                <td colspan="1">
                    <input class="form-control" type="text" data-jdp="" data-jdp-only-time="">
                </td>
                <td colspan="1">
                    <input class="form-control " type="text" data-jdp="" data-jdp-only-time="" style="margin-bottom: 0px !important;">
                </td>
                <td colspan="1">
                        <select class="form-select " style="margin-bottom: 0px !important;">
                        <option value="1">غیبت</option>
                        <option value="2">مرخصی استحقاقی</option>
                        <option value="3"> مرخصی استعلاجی</option>
                        <option value="4"> ماموریت کاری</option>
                    </select>
                </td>
                </tr>

        `);
        jalaliDatepicker.startWatch({
            time: false,
            days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
            persianDigits: true,
            autoClose: true,
            //autocomplete: true,
            showCloseBtn: true,
            showEmptyBtn: false,
            showCloseBtn: true,
            zIndex: 100000,
        });

        //-----------------------------------------------------------------
        $(document).ready(function () {
            var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
            for (var i = 0; i < inputs.length; i++) {
                inputs[i].addEventListener("jdp:change", function (e) {
                    console.log(111111)
                    var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                    var date = this.value.replace(' ', '').slice(0, 10).split('/');
                    date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]),)
                    // If it was empty
                    if (!this.value) {
                        date = "";
                    }
                    // If it was only history
                    else if (this.value.replace(' ', '').length < 11) {
                        date = date.gy + '-' + date.gm + '-' + date.gd
                    }
                    // If it was the date and time
                    else {
                        date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30)
                    }
                    miladiInput.value = date

                });
            }
        });

    }
</script>
