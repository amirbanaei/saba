<script>

$("#btnSaveContract").click(function () {
    var userIds = [];        // فرض می‌کنیم ID کاربران در جدولی باشد که باید اضافه کنیم
    var dates = [];
    var startTimes1 = [];
    var endTimes1 = [];
    var typeNotWork1s = [];
    var startTimes2 = [];
    var endTimes2 = [];
    var typeNotWork2s = [];
    var PeymanArr = [];
    $.each($("#users").val().toString().split(","), function (index, item) {
        if (item !== "") {
            if (item != 'Select') {
                PeymanArr.push(item);
                console.log(item);

    // پیمایش بر روی ردیف‌های جدول و جمع‌آوری داده‌ها
    $("#tableVaziyat tbody tr").each(function () {
        var row = $(this);
        userIds.push(item); // به فرض که یک انتخابگر کاربر دارید

        // اضافه کردن شناسه کاربر به آرایه (می‌توانید از طریق هر روشی شناسه کاربر را بگیرید)
        //userIds.push($("#users").val()); // به فرض که یک انتخابگر کاربر دارید

        // جمع‌آوری داده‌ها برای هر فیلد
        dates.push(row.find("input[data-Hozoor]").val());
        startTimes1.push(row.find("input[type='text']").eq(0).val());
        endTimes1.push(row.find("input[type='text']").eq(1).val());
        typeNotWork1s.push(row.find("select").eq(0).val());
        startTimes2.push(row.find("input[type='text']").eq(2).val());
        endTimes2.push(row.find("input[type='text']").eq(3).val());
        typeNotWork2s.push(row.find("select").eq(1).val());
    });
            }
        }
    });
    // آماده کردن داده‌ها برای ارسال به سرور
    var data = {
        userId: userIds,
        Date: dates,
        StartTime1: startTimes1,
        EndTime1: endTimes1,
        TypeNotWork1: typeNotWork1s,
        StartTime2: startTimes2,
        EndTime2: endTimes2,
        TypeNotWork2: typeNotWork2s
    };
    console.log(data);

    //console.log(data);

    // فراخوانی AJAX برای ارسال داده‌ها به سمت سرور
    $.ajax({
        url: '@Url.Action("SaveVaziyat", "Orders", new { area = "Setting" })',  // مسیر درست برای کنترلر
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),  // تبدیل داده‌ها به JSON برای ارسال
        success: function (response) {
            if (response.success) {
                alert("Data saved successfully!");
            } else {
                alert("Error saving data!");
            }
        },
        error: function () {
            alert("Error saving data!");
        }
    });
});

</script>
