                        @foreach (var shift in db.dbvaziathozor.ToList())
                        {
                            string name = "";
                            string elat1 = "مشخص نیست"; // Default value
                            string elat2 = "مشخص نیست"; // Default value

                            TimeSpan? totalTimeDifference1 = TimeSpan.Zero;
                            TimeSpan? totalTimeDifference2 = TimeSpan.Zero;
                            TimeSpan? totalTimeDifference3 = TimeSpan.Zero;

                            // Process shifts for level_time == 1

                            if (shift.start_clock.HasValue && shift.end_clock.HasValue && shift.level_time == 1)
                            {
                                totalTimeDifference1 += (shift.end_clock - shift.start_clock);
                                if (shift.end_clock != null)
                                {
                                    totalTimeDifference3 += (shift.end_clock - shift.start_clock);

                                }
                                if (shift.end_clock2 != null)
                                {
                                    totalTimeDifference3 += (shift.end_clock2 - shift.start_clock2);

                                }
                                totalTimeDifference2 += (shift.end_clock2 - shift.start_clock2);
                            }
                            if (shift.end_clock != null)
                            {
                                switch (shift.type_notwork)
                                {
                                    case 1: elat1 = "غیبت"; break;
                                    case 2: elat1 = "مرخصی استحقاقی"; break;
                                    case 3: elat1 = "مرخصی استعلاجی"; break;
                                    case 4: elat1 = "ماموریت کاری"; break;
                                    default: elat1 = "مشخص نیست"; break;
                                }
                            }

                            if (totalTimeDifference1 == TimeSpan.Zero)
                            {
                                elat1 = "";
                            }
                            name = shift.tbUsers.FullName; // Set user's name


                            // Process shifts for level_time == 2

                            //if (shift.start_clock2.HasValue && shift.end_clock2.HasValue && shift.level_time == 2)
                            //{
                            //    totalTimeDifference2 += (shift.end_clock2 - shift.start_clock2);
                            //    totalTimeDifference3 += (shift.end_clock2 - shift.start_clock2);
                            //}
                            if (shift.end_clock2 != null)
                            {
                                switch (shift.type_notwork2)
                                {
                                    case 1: elat2 = "غیبت"; break;
                                    case 2: elat2 = "مرخصی استحقاقی"; break;
                                    case 3: elat2 = "مرخصی استعلاجی"; break;
                                    case 4: elat2 = "ماموریت کاری"; break;
                                    default: elat2 = "مشخص نیست"; break;
                                }
                            }


                            if (totalTimeDifference2 == TimeSpan.Zero)
                            {
                                elat2 = "";
                            }
                            if (shift.end_clock2 == null)
                            {
                                elat2 = "";

                            }
                            if (shift.end_clock == null)
                            {
                                elat1 = "";

                            }

                            name = shift.tbUsers.FullName; // Set user's name (if not already set)

                            II++;

                            <tr class="task-list-row dateS_@II"
                                data-filter01=@name"
                                data-filter02=""
                                data-filter03="@totalTimeDifference1"
                                data-filter04="@elat1
                                data-filter05="@totalTimeDifference2"
                                data-filter06="@elat2"
                                data-filter07="@totalTimeDifference3"
                                >

                                <td colspan="1" rowspan="1">

                                    <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                        <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                            <i class="fa fa-edit"></i>
                                        </a>
