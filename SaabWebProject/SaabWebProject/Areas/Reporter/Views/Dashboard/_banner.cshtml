            letter-spacing: 0.1em;
            font-size: 6px;
            margin-top: 3px;
        }

        .part1 {
            width: 33%
        }

        #clock {
            left: 0px;
            right: 0px;
            top: 24px;
            border-radius: 15px;
        }

        #large-header {
            margin-top: 8px;
            margin-bottom: -10px;
        }
    }

    @@media screen and (min-width: 801px) and (max-width: 1200px) {


        .time {
            letter-spacing: 0.05em;
            font-size: 23px;
            /*padding: 5px 0;*/
        }

        .date, .dateJ {
            letter-spacing: 0.1em;
            font-size: 12px;
            margin-top: 7px;
        }

        .part1 {
            width: 33%
        }

        #clock {
            left: 0px;
            right: 0px;
            /*top: 20px;*/
            border-radius: 15px;
        }

        #large-header {
            margin-top: 48px;
            margin-bottom: -10px;
        }
