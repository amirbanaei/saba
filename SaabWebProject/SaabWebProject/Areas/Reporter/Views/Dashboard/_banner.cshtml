        width: 91%;
        height: 33.3333%;
    }

    #txtMi {
        font-size: 3.7vw;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        transform: translateY(100%);
        font-family: 'A EntezareZohoor B3';
        width: 76.5%;
        margin-right: 12.5%;
        height: 33.3333%;
    }

    #txtDo {
        font-size: 2.2vw;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        margin-top: 4px;
        font-family: 'A EntezareZohoor B3';
        margin-right: 4.7%;
        width: 91%;
        transform: translateY(194%);
