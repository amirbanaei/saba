}



<style>
    .app-footer {
        display: none;
    }

    .hljs-container {
        padding: 0;
    }

    .card {
        --bs-border-color-rgb: #ffffff03;
    }

    .notShow {
        display: none !important;
    }

    .bodyDashbord {
        background: none !important;
        backdrop-filter: none !important;
        border-radius: unset !important;
    }
</style>
<style>
    .card .card-arrow-bottom-left:before, .card .card-arrow-bottom-right:before, .card .card-arrow-top-left:before, .card .card-arrow-top-right:before {
        content: "";
        position: absolute;
        width: 2px;
        height: 8px;
        background: aqua;
        opacity: .75;
    }

    .card .card-arrow-bottom-left:after, .card .card-arrow-bottom-right:after, .card .card-arrow-top-left:after, .card .card-arrow-top-right:after {
        content: "";
        position: absolute;
        width: 10px;
        height: 2px;
        background: aqua;
    }
</style>
<style>
    p {
        margin: 0;
        padding: 0;
    }

    #clock {
        font-family: monospace;
        text-align: center;
        position: absolute;
        left: 0px;
        right: 0px;
        top: 35px;
        color: var(--bs-app-sidebar-menu-link-color);
        text-shadow: 0 0 20px rgb(135 135 135), 0 0 20px rgba(10, 175, 230, 0);
        border-radius: 15px;
        /*border: solid 2px #ffffff50;*/
        /*background: linear-gradient(#199b9400, #033f3300) padding-box, linear-gradient(to bottom, #7bf1f529, #3cd0a500) border-box;*/
        margin-top: -35px;
        background: var(--bs-app-theme-panel-bg);
        backdrop-filter: blur(5px);
    }

    .time {
        letter-spacing: 0.05em;
        font-size: 37px;
        /*padding: 5px 0;*/
    }

    .date, .dateJ {
        letter-spacing: 0.1em;
        font-size: 20px;
        margin-top: 14px;
    }

    .text {
        letter-spacing: 0.1em;
        font-size: 12px;
        padding: 20px 0 0;
    }

    .ClockCover {
        height: 83%;
        position: absolute;
        width: 99%;
        /* background: var(--bs-app-theme-panel-bg); */
        backdrop-filter: blur(0px);
        border-radius: 12px;
        margin-right: .7%;
        top: 9%;
        right: -0.2%;
    }
</style> <!--clock-->
<style>
