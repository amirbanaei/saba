<style>
    /* Your existing styles */

    .modalGeneral {
        display: none;
        position: absolute; /* Change this from fixed */
        z-index: 1000; /* Adjust z-index as needed */
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        transition: all 0.5s ease-in-out;
        width: max-content;
    }

    .modal-contentGeneral {
        background: var( --bs-app-theme-Dasboard-bg);
        /* background: linear-gradient(#075950f0, #0229217d) padding-box, linear-gradient(to bottom, #3acacfcf, #0b7556bf); */
        position: relative;
        margin: 15% auto;
        padding: 25px;
        border: 2px solid #00ffff1f;
        border-radius: 15px;
        width: 100%;
        max-height: 100%;
        animation: modal-animation 1s ease-in-out;
        box-shadow: 0 0rem 0.3rem var(--bs-inverse-modal-rgb);
        backdrop-filter: blur(5px)
    }

    .row > .close {
        position: absolute;
        width: 23.5%;
        border: 1px solid;
        padding: 3px 5px;
        padding-top: 4px;
        margin-right: -41px;
        background: var(--bs-app-theme-panel-bg);
        border-radius: 30px 15px 15px 30px;
        margin-top: 10px;
        border: 2px solid #00ffff1f;
        backdrop-filter: blur(9px)
        /*z-index: 1;*/
    }


    @@keyframes modal-animation {
        from {
            transform: scale(0);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .closeGeneral {
        color: #36a9e1;
        float: right;
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 2px;
    }

        .closeGeneral:hover,
        .closeGeneral:focus {
            color: aqua;
            text-decoration: none;
            cursor: pointer;
        }


    @@media only screen and (min-width : 1700px) {
        .modelsatr1 {
            font-size: 26px !important;
        }

        .childsatr2 {
            font-size: 24px !important;
        }

        @@media only screen and (min-width :2700px) {
            .modelsatr1 {
                font-size: 40px !important;
            }

            .childsatr2 {
                font-size: 40px !important;
            }
        }

        @@media only screen and (min-width : 4098px) {
            .modelsatr1 {
                font-size: 48px !important;
            }

            .childsatr2 {
                font-size: 48px !important;
            }
        }

        @@media only screen and (max-width : 1093px) {
            .modal-contentGeneral {
                background: var(--bs-dashboard-modal-bg);
                position: relative; /* Add relative positioning */
                border: 4px solid aqua;
                border-radius: 30px;
                width: 100%;
                max-height: 100%;
                overflow-y: auto;
                margin-top: 0%;
            }
        }
</style>
