<script>
    $('#btnSaveCompany222').click(function () {
        var PeymanArr = [];
        var userId = []; // آی‌دی کاربر انتخاب شده
        var days = [];
        var morningStarts = [];
        var morningEnds = [];
        var afternoonStarts = [];
        var afternoonEnds = [];
        var nightStarts = [];
        var nightEnds = [];

    


    // برای هر ردیف (هر روز) جدول
    $('table.tableDate tbody tr').each(function () {
        var day = $(this).find('td').first().text().trim(); // دریافت نام روز

        // دریافت داده‌ها و اگر خالی بود مقدار "00:00" را قرار می‌دهیم
        var morningStart = $(this).find('td:eq(1) input').val() || "00:00"; // شروع صبح
        var morningEnd = $(this).find('td:eq(2) input').val() || "00:00";   // پایان صبح

        var afternoonStart = $(this).find('td:eq(3) input').val() || "00:00"; // شروع عصر
        var afternoonEnd = $(this).find('td:eq(4) input').val() || "00:00";   // پایان عصر

        var nightStart = $(this).find('td:eq(5) input').val() || "00:00";  // شروع شب
        var nightEnd = $(this).find('td:eq(6) input').val() || "00:00";    // پایان شب

        // اضافه کردن داده‌ها به آرایه‌ها
        userId.push(@id);
        days.push(day);
        morningStarts.push(morningStart);
        morningEnds.push(morningEnd);
        afternoonStarts.push(afternoonStart);
        afternoonEnds.push(afternoonEnd);
        nightStarts.push(nightStart);
        nightEnds.push(nightEnd);
    });
          
    console.log(nightEnds);
    // ارسال داده‌ها به سرور با استفاده از AJAX
    $.ajax({
        url: '@Url.Action("SaveUserSchedule", "Orders", new { area = "Setting" })', // آدرس صحیح اکشن
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            userId: userId,
            days: days,
            morningStarts: morningStarts,
            morningEnds: morningEnds,
            afternoonStarts: afternoonStarts,
            afternoonEnds: afternoonEnds,
            nightStarts: nightStarts,
            nightEnds: nightEnds
        }), // داده‌ها را به JSON تبدیل می‌کنیم
        success: function (response) {
            if (response.success) {
                Swal.fire('موفقیت', 'اطلاعات با موفقیت ذخیره شد!', 'success');
                document.location.reload();
            } else {
                Swal.fire('خطا', 'خطایی رخ داده است: ' + response.message, 'error');
            }
        },
        error: function (xhr, status, error) {
            Swal.fire('خطا', 'خطا در ارسال داده‌ها: ' + error, 'error');
        }
    });
});



</script>
