<script>
    var
        filtersEM = {
            filter11: null,
            filter12: null,

        };

    function updateFiltersEM() {
        $('.task-list-rowEM').hide().filter(function () {
            var self = $(this),
                result = true; // not guilty until proven guilty

            Object.keys(filtersEM).forEach(function (filter) {
                if (filtersEM[filter] && (filtersEM[filter] != 'None') && (filtersEM[filter] != 'همه')) {
                    // تطبیق جزئی (contains) به جای تطبیق کامل
                    result = result && self.data(filter).indexOf(filtersEM[filter]) !== -1;
                }
            });

            return result;
        }).show();
    }

    function changeFilterEM(filterName) {
        filtersEM[filterName] = this.value;
        updateFiltersEM();
    }

    $('#filter11-filter').on('input', function () {
        changeFilterEM.call(this, 'filter11');
    });
    $('#filter12-filter').on('input', function () {
        changeFilterEM.call(this, 'filter12');
    });

</script>
