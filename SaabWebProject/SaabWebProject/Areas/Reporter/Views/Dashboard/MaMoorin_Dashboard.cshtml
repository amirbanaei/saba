@{
    var id = Model.FirstOrDefault()?.tbUsers.usr_ID ?? 0;
    var month = Model.FirstOrDefault()?.mlfval_Month ?? 0;
    var yr = Model.FirstOrDefault()?.mlfval_Year ?? 0;
    var dataSeries = new List<decimal>();
    var categories = new List<string>();
    var persianMonths = new Dictionary<int, string>
    {
        {1, "فروردین"},
        {2, "اردیبهشت"},
        {3, "خرداد"},
        {4, "تیر"},
        {5, "مرداد"},
        {6, "شهریور"},
        {7, "مهر"},
        {8, "آبان"},
        {9, "آذر"},
        {10, "دی"},
        {11, "بهمن"},
        {12, "اسفند"}
    };

    foreach (var it in db.tbMoalefeValueFish.Where(p => p.FK_User == id && p.mlfvlfsh_Month <= month && p.mlfvlfsh_Year == yr&&p.tbContractMoalefeDastmozdi.md_Title== "خالص قابل دریافت (ریال)"))
    {
        dataSeries.Add((decimal)it.mlfvlfsh_Value);
        if (persianMonths.ContainsKey((int)it.mlfvlfsh_Month))
        {
            categories.Add(persianMonths[(int)it.mlfvlfsh_Month]);
        }
        else
        {
            categories.Add(it.mlfvlfsh_Month.ToString()); // به عنوان پیش‌فرض، عدد ماه را اضافه کنید اگر در دیکشنری نباشد
        }
    }

}
