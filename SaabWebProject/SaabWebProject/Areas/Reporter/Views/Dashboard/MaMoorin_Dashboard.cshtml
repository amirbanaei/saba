    }

    .NotAcceptedSvg {
        width: 20px;
        color: #ff5c00;
    }

    .AcceptedSvg {
        width: 20px;
        color: #90e2ee;
    }

    .card {
        --bs-border-color: #ffffff03;
    }

    .notShow, notShowFooter {
        display: none !important;
    }

