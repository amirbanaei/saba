            height: 220,
            type: 'area',
            zoom: {
                enabled: false
            }
        },
        colors: ["#4c98fa"],
        fill: {
            type: "gradient",
            gradient: {
                shadeIntensity: 1,
                inverseColors: false,
                opacityFrom: 0.5,
                opacityTo: 0,
                stops: [0, 90, 100]
            }
        },
        markers: {
