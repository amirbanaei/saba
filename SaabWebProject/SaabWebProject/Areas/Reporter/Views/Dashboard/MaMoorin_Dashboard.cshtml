        border-radius: 13px !important;
        opacity: 0.99 !important;
        /*margin-top: -82px;*/
    }

    .btnEYE {
        padding-right: 10px !important;
        padding-left: 10px !important;
        padding-top: 2px !important;
        padding-bottom: 0px !important;
        border-radius: 7px !important;
    }

    .cotrolStyle {
        border-radius: 10px !important;
        padding: 2px !important;
        margin-left: 0px !important;
        margin-bottom: -4px !important;
        backdrop-filter: blur(10px);
        background: var(--bs-dashboard-bg);
        height: 100%;
        display: flex;
    }

        .cotrolStyle:hover {
            /*border:1px solid #0082ac*/
            box-shadow: 0 0 10px 0 #66fffd96, 0 0 10px 0 #64cdfd8f;
        }
    /*----------------------------*/

    .coMargin-box {
        margin-bottom: 8px
    }

    .coMargin-top {
        margin: 8px 8px 0px 8px
    }

    .coMargin-Mid {
        margin: 0px 8px 0px 8px;
    }

    .coMargin-Bot {
        margin: 0px 8px 8px 8px
    }
    /*----------------------------*/
    .yCheck {
        color: #8fe58c;
        font-size: 10px;
        margin-top: 6px;
    }

    .nCheck {
        color: #fc5b00;
        font-size: 10px;
        margin-top: 6px;
    }
    /*----------------------------*/
    .AcceptedSvg, .fa-eye, .bi-download {
        color: #95ee90 !important;
    }
</style>

<style>
    /*-------------------------------*/
    /* حاشیه های دور نمودار ها */
    .apexcharts-bar-area {
        stroke: #ffffff59;
    }
    /*-------------------------------*/
    /* خط های افقی پشت نمودار */
