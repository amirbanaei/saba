@using SaabWebProject.Models.DomainModels;

@{
    //ViewBag.Title = "";
    ViewBag.Title = "تعریف موظفی";
    Layout = "~/Views/Shared/_Layout.cshtml";
    SaabEntities db = new SaabEntities();

}
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />



<div class="tab-content">

    <div class="row">
        <div class="col-xl-11"></div>
        <div class="col-xl-1">
            <a href="#" id="createMoalefeButtonModal" class="btn form-control buttonGeneral" data-bs-toggle="modal" data-bs-target="#modalLg1" style="">
                <i class="VecGeneral fa fa-plus-circle fa-fw me-1"></i>
                <span class="bGeneral-text">تعریف اسناد</span>
            </a>
        </div>
    </div>

    <div class="card">
        <div class="table-content p-4">
            <div class="tab-pane fade show active" id="allTab">
                <div class="table-responsive">
                    <table class="table table-hover text-nowrap">
                        <thead>
                            <tr>
                                <th>فعالیت</th>
                                <th>نام کاربر</th>
                                <th>ساعت کارکرد در هفته</th>
                                <th style="border-bottom-left-radius: 10px !important">تعداد روز تعطیل در هفته</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var userGroup in db.dbtarifmovazaf.GroupBy(s => s.FK_usr).ToList())
                            {
                                string name = "";
                                int shiftCount = 0;
                                TimeSpan? totalTimeDifference = TimeSpan.Zero; // مقدار اولیه برای تفاوت زمانی

                                // شمارش تعداد شیفت‌هایی که کارمند در آن‌ها کار کرده است

                                foreach (var userGroup22 in db.dbtarifmovazaf.Where(s => s.FK_usr == userGroup.Key).GroupBy(s => s.day).ToList())
                                {
                                    if (userGroup22.Any(s => s.parttime == 1 && s.start_clock == TimeSpan.Zero)) // شیفت صبح
                                    {
                                        if (userGroup22.Any(s => s.parttime == 2 && s.start_clock == TimeSpan.Zero)) // شیفت عصر
                                        {
                                            if (userGroup22.Any(s => s.parttime == 3 && s.start_clock == TimeSpan.Zero)) // شیفت شب
                                            {
                                                shiftCount++;

                                            }
                                        }
                                    }

                                }

                                // محاسبه تفاوت زمانی قبل از ورود به حلقه
                                foreach (var shift in userGroup)
                                {
                                    var startTime = shift.start_clock;
                                    var endTime = shift.end_clock;

                                    // محاسبه تفاوت زمانی برای هر شیفت و جمع‌کردن آن به تفاوت کلی
                                    if (startTime.HasValue && endTime.HasValue)
                                    {
                                        totalTimeDifference += (endTime - startTime);
                                    }

                                    name = shift.tbUsers.FullName;

                                }

                                // اینجا نتیجه تفاوت زمانی جمع‌شده را نمایش می‌دهیم
                                <tr>
                                    <td colspan="1" rowspan="1">

                                        <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                            <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <div class="dropdown-menu">
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item edit" id="Edit_@userGroup.Key ">حذف</a>
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item Details" id="Detail_@userGroup.Key">جزئیات</a>
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item Erja" id="Erja_@userGroup.Key">ارجا</a>


                                            </div>
                                        </div>
                                    </td>

                                    <td colspan="1" rowspan="1">
                                        @userGroup.First().tbUsers.FullName <!-- نمایش نام کارمند -->
                                    </td>

                                

                                    <td colspan="1" rowspan="1">
                                        @if (totalTimeDifference.HasValue)
                                        {
                                            // محاسبه ساعات و دقیقه‌ها
                                            var totalHours = Math.Floor(totalTimeDifference.Value.TotalHours); // کل ساعات
                                            var totalMinutes = totalTimeDifference.Value.Minutes; // دقیقه‌ها

                                            // نمایش ساعت‌ها و دقیقه‌ها
                                            @(totalHours.ToString("00") + ":" + totalMinutes.ToString("00"))
                                        }
                                        else
                                        {
                                            <text>00:00</text>
                                        }
                                    </td>

                                    <td colspan="1" rowspan="1">
                                        @shiftCount <!-- نمایش تعداد شیفت‌هایی که کارمند در آن روز کار کرده است -->
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>

        </div>


        <div class="card-arrow">
            <div class="card-arrow-top-left"></div>
            <div class="card-arrow-top-right"></div>
            <div class="card-arrow-bottom-left"></div>
            <div class="card-arrow-bottom-right"></div>
        </div>
    </div>

</div>





<script src="~/Scripts/sweetalert2.js" type="text/javascript"></script>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
