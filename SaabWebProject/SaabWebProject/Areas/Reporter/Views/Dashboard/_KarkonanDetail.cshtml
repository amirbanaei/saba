</tr>
<tr>
    <td class="TableTH1" colspan="1" rowspan="1">ذخیره پاداش/جریمه: </td>
    <td class="TableTD1 numbers" colspan="1" rowspan="1">@Model.Where(p => p.tbContractMoalefeDastmozdi.md_Title == "پیشخوان-مامورین-مانده پاداش و جرایم").Select(p => p.mlfval_Value).FirstOrDefault()</td>
    <td class="TableTH2" colspan="1" rowspan="1">جمع تراز: </td>
    <td class="TableTD2 numbers" colspan="1" rowspan="1">
        @{ int x = Convert.ToInt32(Model.Where(p => p.tbContractMoalefeDastmozdi.md_Title == "پیشخوان-مامورین-مانده مطالبات").Select(p => p.mlfval_Value).FirstOrDefault());
            int y = Convert.ToInt32(Model.Where(p => p.tbContractMoalefeDastmozdi.md_Title == "پیشخوان-مامورین-مانده ذخایر").Select(p => p.mlfval_Value).FirstOrDefault());
            int z = Convert.ToInt32(Model.Where(p => p.tbContractMoalefeDastmozdi.md_Title == "پیشخوان-مامورین-مانده اقساط").Select(p => p.mlfval_Value).FirstOrDefault());
            int l = Convert.ToInt32(Model.Where(p => p.tbContractMoalefeDastmozdi.md_Title == "پیشخوان-مامورین-مانده پاداش و جرایم").Select(p => p.mlfval_Value).FirstOrDefault());
            int f = Convert.ToInt32(@Model.Where(p => p.tbContractMoalefeDastmozdi.md_Title == "پیشخوان-مامورین-مانده مشارکت").Select(p => p.mlfval_Value).FirstOrDefault());
        }

        @if (Convert.ToInt32(x + y + z + f + l) > 0)
        {
            <div class="d-flex justify-content-end align-items-center" style="margin-bottom:-20px">
                بستانکار
                <span class="mx-2 number" style="color:#90e2ee;font-size:15px">
                    @Convert.ToInt32(x + y + z + l + f)
                </span>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-end align-items-center" style="margin-bottom:-20px">
                <span class="mx-2 number" style="color:#90e2ee;font-size:11px">
                    @Convert.ToInt32(Convert.ToInt32(x + y + z + l + f) * -1)
                </span>
            </div>
        }
    </td>
</tr>
<tr>
    <td class="TableTH1" colspan="1" rowspan="1">حداکثر :</td>
    <td class="TableTD1 numbers" colspan="1" rowspan="1">@Model.Where(p => p.tbContractMoalefeDastmozdi.md_Title == "پیشخوان-مامورین-حداکثر").Select(p => p.mlfval_Value).FirstOrDefault() </td>
    <td class="TableTH2" colspan="1" rowspan="1">متوسط :</td>
    <td class="TableTD2 numbers" colspan="1" rowspan="1">@Model.Where(p => p.tbContractMoalefeDastmozdi.md_Title == "پیشخوان-مامورین-متوسط").Select(p => p.mlfval_Value).FirstOrDefault() </td>
</tr>
<tr>
