<script>
    function countSymbols() {
        const table = document.getElementById('myTable');
        const rows = table.rows;
        const checkmark1 = '✓'; // نماد تیک که باید شمارش شود
        const checkmark2 = '*'; // نماد تیک که باید شمارش شود

        let counts1 = Array(13).fill(0);
        let counts2 = Array(13).fill(0);
        // get
        for (let i = 4; i < rows.length - 1; i++) {
            for (let j = 3; j < 13 + 3; j++) {

                if (rows[i].cells[j].textContent.trim() === checkmark1 | (rows[i].cells[j].textContent.trim() != checkmark2 & rows[i].cells[j].textContent.trim() != "")) {
                    console.log(rows[i].cells[j].textContent.trim() + "---" + i + "---" + j)

                    counts1[j - 3]++;
                } else if (rows[i].cells[j].textContent.trim() === checkmark2) {

                    counts2[j - 3]++;
                }
            }
        }

        // show

        var out;
        for (let j = 0; j < counts1.length; j++) {
            console.log(j)
            thElement = document.querySelector(`th.clTick_${j}`);
            thElement.textContent = counts1[j];
            if (j == 9) {
                document.querySelector("span.clTick_9").innerHTML = counts1[j];
            }
            if (j < 9) {
                thElement = document.querySelector(`th.clStar_${j}`);
                thElement.textContent = counts2[j];
            }
        }
    }

    countSymbols();
</script>
