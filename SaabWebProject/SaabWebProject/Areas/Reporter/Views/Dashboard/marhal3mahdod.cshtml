<script>
    var
        filtersTD = {
            filter13: null,
        };

    function updateFiltersTD() {
        $('.task-list-rowTD').hide().filter(function () {
            var self = $(this),
                result = true; // not guilty until proven guilty

            Object.keys(filtersTD).forEach(function (filter) {
                if (filtersTD[filter] && (filtersTD[filter] != 'None') && (filtersTD[filter] != 'همه')) {
                    // تطبیق جزئی (contains) به جای تطبیق کامل
                    result = result && self.data(filter).indexOf(filtersTD[filter]) !== -1;
                }
            });

            return result;
        }).show();
    }

    function changeFilterTD(filterName) {
        filtersTD[filterName] = this.value;
        updateFiltersTD();
    }

    $('#filter13-filter').on('input', function () {
        changeFilterTD.call(this, 'filter13');
    });

</script>
<script>

    $("#btnSaveContract222").click(function () {
        // جمع‌آوری داده‌ها
        var dataList = []; // ایجاد یک آرایه برای ذخیره تمام داده‌ها

        $("input.form-control222").each(function () {
            var inputId = $(this).attr("id");
            var value = $(this).val();

            if (value) { // اگر ورودی پر شده است
                var parts = inputId.split('_'); // تقسیم ID به اجزا
                var type = parts[0];   // مثلا 'fardi'
                // ID رکورد در دیتابیس
                dataList.push({

                    name: value
                });
                // ارسال داده‌ها به سرور
            }
        });
        if (dataList.length > 0) {
            updateDatabase3(dataList);
            console.log(dataList);
        }
    });
    function updateDatabase3(dataList) {
        $.ajax({
            url: '/Reporter/Dashboard/UpdateRecordmarhel3', // آدرس اکشن کنترلر شما
            method: 'POST',
            data: JSON.stringify(dataList), // ارسال آرایه به سرور

            contentType: 'application/json',
            success: function (response) {
                console.log("Record updated successfully.");
                if (response == "true") {
                    alert("با موفقیت ثبت شد");
                    location.reload();

                }
            },
            error: function (error) {
                console.error("Error updating record:", error);
            }
        });
    }


