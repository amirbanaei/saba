<script>
    $("#btnSaveEs1").click(function () {
        console.log("dsajd;s");

        // جمع‌آوری داده‌ها
        var dataList = [];
        var dataList2 = []; // ایجاد یک آرایه برای ذخیره تمام داده‌ها
        // ایجاد یک آرایه برای ذخیره تمام داده‌ها
        dataList.push({
            saatezafeh: removeCommas($("#saatezafeh").val()),
            sode: removeCommas($("#sode").val()),
            kosorat: removeCommas($("#kosorat").val()),
            abzar: removeCommas($("#abzar").val()),
            ayab: removeCommas($("#ayab").val()),
            ezafeh: removeCommas($("#ezafeh").val()),
            ghalse: removeCommas($("#ghalse").val()),
            egareh: removeCommas($("#egareh").val()),
            FK_name:@Model.ID            // Corrected to .val()
        });
        $("input.form-control3f343").each(function () {
            var inputId = $(this).attr("id");
            var value = $(this).val();

            if (value) { // اگر ورودی پر شده است
                var parts = inputId.split('_'); // تقسیم ID به اجزا
                var type = parts[0];   // مثلا 'fardi'
                var phase = parts[1];  // مثلا 'takfaz'
                var area = parts[2];   // مثلا 'shahri'
                var id = parts[3];     // ID رکورد در دیتابیس
                dataList2.push({
                    id: id,
                    type: type,
                    phase: phase,
                    area: area,
                    value: value
                });
                // ارسال داده‌ها به سرور
            }
        });
        if (dataList.length > 0) {
            updateDatabase(dataList);
            console.log(dataList);
        }
    });
    function updateDatabase(dataList) {
        $.ajax({
            url: '/Reporter/Dashboard/UpdateRecord6', // آدرس اکشن کنترلر شما
            method: 'POST',
            data: JSON.stringify(dataList), // ارسال آرایه به سرور

            contentType: 'application/json',
            success: function (response) {
                console.log("Record updated successfully.");
                if (response == "true") {
                    alert("با موفقیت ثبت شد");
                    location.reload();

                }
            },
            error: function (error) {
                console.error("Error updating record:", error);
            }
        });
    }

</script>