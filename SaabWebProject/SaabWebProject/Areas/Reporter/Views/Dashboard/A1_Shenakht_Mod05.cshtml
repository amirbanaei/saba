<script>

    function formatNumberWithCommas(number) {
        return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    // Function to remove commas from a formatted number
    function removeCommas(number) {
        return number.replace(/,/g, '');
    }

    // Apply the formatting to all relevant input fields
    $('input.form-control').on('input', function () {
        var value = $(this).val();
        value = removeCommas(value); // Remove existing commas
        if ($.isNumeric(value)) {
            $(this).val(formatNumberWithCommas(value)); // Format with commas
        }
    });
    $('input.form-control').each(function () {
        var value = $(this).val();
        if ($.isNumeric(value)) {
            $(this).val(formatNumberWithCommas(value)); // اعمال فرمت
        }
    });

    $(document).ready(function () {
        // انتخاب همه فیلدهای ورودی به جز فیلد جمع کل
        var inputFields = $('#table_First41 input').not('.sumAll');

        // تابعی برای محاسبه جمع
        function calculateSum() {
            var sum = 0;
            inputFields.each(function () {
                var value = parseFloat($(this).val().replace(/,/g, '')); // حذف کاماها و تبدیل به عدد
                if (!isNaN(value)) {
                    sum += value;
                }
            });
            $('#table_First41 .sumAll').val(sum.toLocaleString('en')); // افزودن کاماها و نمایش جمع
        }

        // اجرای تابع هنگام تغییر هر فیلد ورودی
        inputFields.on('input', calculateSum);

        // اجرای اولیه تابع برای محاسبه مقدار اولیه جمع
        calculateSum();
    });

</script>


