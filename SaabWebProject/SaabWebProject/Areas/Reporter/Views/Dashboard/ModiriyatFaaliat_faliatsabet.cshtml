<script src="~/Scripts/sweetalert2.js" type="text/javascript"></script>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script src="~/Assets/plugins/BootstrapPersianDateTimePicker/src/jquery.md.bootstrap.datetimepicker.js"></script>

<script>
            $("#div_users1").load('@Url.Content("/../Users/Users/usrfaliatsabt")', function () {
            $("#select_users1").attr("id", "users");
            $("#users").picker({ search: true });
            $("#users").picker();
            $('#users').picker({ search: true });
            });
        jalaliDatepicker.startWatch({
            time: false,
            days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
            persianDigits: true,
            autoClose: true,
            autocomplete: true,
            // showCloseBtn:true,
            showEmptyBtn: false,

            showCloseBtn: true,
            zIndex: 100000,

        });
        //-----------------------------------------------------------------
        var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
        for (var i = 0; i < inputs.length; i++) {
            inputs[i].addEventListener("jdp:change", function (e) {
                var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                var date = this.value.replace(' ', '').slice(0, 10).split('/');
                date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]),)
                // If it was empty
                if (!this.value) {
                    date = "";
                }
                // If it was only history
                else if (this.value.replace(' ', '').length < 11) {
                    date = date.gy + '-' + date.gm + '-' + date.gd
                }
                // If it was the date and time
                else {
                    date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30)
                }
                miladiInput.value = date
            });
        }
</script>
<script>
    $("#div_users2").load('@Url.Content("/../Reporter/Dashboard/ModiriyatFaaliat_day")', function () {
            $("#select_users2").attr("id", "days");
        $("#days").picker({ search: true });
        $("#days").picker();
        $('#days').picker({ search: true });
            });






    $("#btnSaveContract").click(function () {
        var userIds = [];  // لیست شناسه کاربران
        var dates = [];
        var fromdat = null;
        var todat = null;
        var time = null;
        var sharh = null;
        // پیمایش کاربرها از انتخابگر
        $.each($("#users").val().toString().split(","), function (index, userId) {
            if (userId && userId !== 'Select') {
                userIds.push(userId);

            }
        });
        $.each($("#days").val().toString().split(","), function (index, date) {
            if (date && date !== 'Select') {
                // اضافه کردن شناسه کاربر و تاریخ به آرایه‌ها
                dates.push(date);
            }
        });
        // استخراج مقادیر از فیلدها
        fromdat = $("#miladi_date1").val();
        todat = $("#miladi_date2").val();
        time = $("#valuetime").val();
        sharh = $("#sharh").val();
        // ساختن داده‌ها برای ارسال به سرور
        var data = {
            userId: userIds,
            Date: dates,
            DataDocument: fromdat,
            DataDocument2: todat,
            time: time,
            titl: sharh
        };

        console.log(data);

        // فراخوانی AJAX برای ارسال داده‌ها به سمت سرور
        $.ajax({
            url: '@Url.Action("creat", "Orders", new { area = "Setting" })',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (response) {
                if (response.success) {
                    alert("Data saved successfully!");
                } else {
                    alert("Error saving data!");
                }
            },
            error: function () {
                alert("Error saving data!");
            }
        });
    });


    </script>
