<script>

function addSubmenu(parentId) {
    function generateZeros(count) {
        return '0'.repeat(count);
    }

    // دریافت محدودیت‌ها
    const limitList = [@string.Join(",", db.dbAsnadtress1.Select(x => x.ragham))]; // محدودیت هر سطح
    const limitNum = [@string.Join(",", db.dbAsnadtress1.Select(x => x.start))]; // شروع شماره‌گذاری

    const parentElement = document.getElementById(parentId);
    const submenuContainer = parentElement.querySelector('.submenu');
    const currentLevel = parentId === "L" ? 0 : (parentId.split('-').length - 1); // سطح جاری

    const limit = ((10 ** limitList[currentLevel]) - 1) - limitNum[currentLevel] + 1; // محدودیت تعداد زیرآیتم‌ها
    const startNumber = limitNum[currentLevel]; // شروع شماره‌گذاری

    const submenuCount = submenuContainer.children.length; // تعداد زیرمنوهای فعلی

    if (submenuCount < limit) {
        // تعیین شماره بعدی برای زیرآیتم
        const paddedIndex = (startNumber + submenuCount).toString().padStart(`${limit}`.length, '0'); // شماره‌گذاری با صفر
        const newItemId = `${parentId}-${paddedIndex}`; // آیدی جدید

        // ساخت شناسه برای زیرآیتم
        let code = '';
        let outId = '';
        for (let i of limitList.slice(currentLevel + 1)) {
            code += "-" + generateZeros(i);
        }
        outId = `${newItemId}${code}`;

        // پردازش شناسه والد
        const parentElementId = parentElement.id;  // والد (parent) کنونی
        let outId2 = `${parentElementId}${code}`;

        const parentElementId2 = parentElementId.replace('L-', '').replace(/-/g, '');
        const SD = outId2.replace('L-', '').replace(/-/g, '');
        const SD1 = outId.replace('L-', '').replace(/-/g, '');

        const lengthDifference = SD1.length - SD.length;
        let outId2Updated = outId2;
        let outId2Updated2 = SD;

        if (lengthDifference > 0) {
            outId2Updated += '0'.repeat(lengthDifference);
        }

        if (lengthDifference > 0) {
            outId2Updated2 += '0'.repeat(lengthDifference);
        }

        const newSubmenuItem = document.createElement('li');
        newSubmenuItem.className = 'menu-itemTree';
        newSubmenuItem.classList.add('menu-itemTree', 'class2', 'class3');
        newSubmenuItem.id = newItemId;

        var item = outId.replace('L-', '').replace(/-/g, '');
        console.log(item);

        // ارسال درخواست AJAX برای دریافت نام از سرور
        $.ajax({
            url: '/ManagementAccounting/FinancialDocuments/viewasnadmaly454y', // آدرس اکشن کنترلر شما
            method: 'POST',
            data: JSON.stringify({ name: item }), // ارسال داده به صورت JSON
            contentType: 'application/json',  // تنظیم contentType به صورت JSON
            success: function (response) {
                console.log("Record updated successfully.");
                // پس از دریافت پاسخ، فیلد ورودی را با مقدار جدید پر کنید
                const namee = response; // پاسخ از سرور
                newSubmenuItem.innerHTML = `
                    <div>
                        <div class="Lin1"></div>
                        <div class="Lin2"></div>
                        <button class="buttonGeneralPlus" onclick="clickmeno('${newItemId}')" title="افزودن شماره حساب">
                            <i class="fa fa-plus-circle fa-fw me-1 VecGeneral"></i>
                        </button>
                    </div>
      <div class="menue3">
          <input type="text" id="${outId.replace(/-/g, '')}" data-bind="${outId2Updated2}"
             value="${namee}" data-container="${outId.replace('L-', '').replace(/-/g, '')}"
              class="trssse2" placeholder="آیتم ${outId.replace('L-', '').replace(/-/g, '')}"title="${outId.replace('L-', '').replace(/-/g, '')}_${namee}">
                      <i class="bi bi-three-dots-vertical Details2 dot3" data-bs-toggle="modal" style="color:green" data-bind="${outId2Updated2}" data-bs-target="#modalLg1" data-container="${outId.replace('L-', '').replace(/-/g, '')}" id="Detail_${outId.replace('L-', '').replace(/-/g, '')}"></i>


      </div>
                    <button class="buttonGeneralTree" onclick="toggleSubmenu('${newItemId}')">-</button>
                    <ul class="submenu"></ul>
                `;
                submenuContainer.appendChild(newSubmenuItem);
                                                $(".Details2").click(function () {
    var idd = $(this).attr("id").split("_")[1];
    console.log(idd);
    var bindValue = $(this).data("bind");

                                                    $("#big_modal_body1").load('@Url.Content("/ManagementAccounting/FinancialDocuments/getinfdastehbandi")?id1=' + idd + '&bindValue=' + bindValue);
});

            },
            error: function (error) {
                console.error("Error updating record:", error);
                alert("مشکلی در ارسال درخواست به سرور پیش آمده است.");
            }
        });
    } else {
        if (isNaN(limit)) {
            alert(`تعداد سقف سطوح انتخابی پر شده است`);
        } else {
            alert(`حداکثر تعداد آیتم‌ها در این سطح (${limit}) است.`);
        }
    }
}




