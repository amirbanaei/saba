<script>

    $(document).ready(function () {

        $(".DT").on("click", function () {
            var startContainer = $("#ButtonB");
            startContainer.empty();


            // دریافت عنوان گزارش از tooltip
            var reportTitle = $(this).find(".tooltipB").text().trim();

            var inputsContainer = $("#inputsT");

            // پاک کردن محتویات قبلی دایو inputsT
            inputsContainer.empty();


            // بررسی عنوان گزارش و ایجاد اینپوت‌های مناسب
            switch (reportTitle) {
                case "فیش حقوقی":
                    startContainer.append(`
                     <style>
                        .location-arrow{
                            top: 24%;
                            left: 22%;
                            display: block;
                        }
                     </style>
                     <button class="startT form-control" id="btnShowSR" data-bs-toggle="modal" data-bs-target="#modalLg">تولید گزارش</button>
                    `);
                     inputsContainer.append(`
                        <div class="col-xl-12 col-md-12 col-sm-12 col-12">
                            <label class="form-label">کاربر حقیقی</label>
                            <span id="users"></span>
                        </div>


                    `);
                    //================================================================================
                    $("#users").load('@Url.Content("/Users/Users/_GetAllUsers_Select")', function () {
                        $('#select_users').attr("id", "UserID");
                    });

                    //================================================================================
                   inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">ماه</label>
                            <select class="form-select my_Select" id="Month">
                            <option value="0">انتخاب مورد</option>
                            <option value="1">فروردین</option>
                            <option value="2">اردیبهشت</option>
                            <option value="3">خرداد</option>
                            <option value="4">تیر</option>
                            <option value="5">مرداد</option>
                            <option value="6">شهریور</option>
                            <option value="7">مهر</option>
                            <option value="8">آبان</option>
                            <option value="9">آذر</option>
                            <option value="10">دی</option>
                            <option value="11">بهمن</option>
                            <option value="12">اسفند</option>
                        </select>
                        </div>
                    `);
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">سال</label>
                              <select class="form-select" id="Year">
                                <option value="0">انتخاب کنید</option>

                                @{
                                    System.Globalization.PersianCalendar cs2 = new System.Globalization.PersianCalendar();
                                    int currentYear = cs2.GetYear(DateTime.Now);

                                    for (var i = 4; i >= 0; i--)
                                    {
                                        var s = DateTime.Now.AddYears(-i);

                                        <option value="@cs2.GetYear(s)">@cs2.GetYear(s)</option>
                                    }
                                }
                            </select>
                        </div>
                    `);

                    var Toast = Swal.mixin({
                        toast: true,
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        didOpen: (toast) => {
                            toast.addEventListener('mouseenter', Swal.stopTimer)
                            toast.addEventListener('mouseleave', Swal.resumeTimer)
                        }
                    });
                    function sendAjax26799(url2, fd2) {
                        console.log($("#UserID").val());
                        console.log($("#Month").val());
                        fd2.append("UserID", $("#UserID").val());
                        fd2.append("Year", $("#Year").val());
                        fd2.append("Month", $("#Month").val());

                        //============================================[loading...]
                        $("#loading-circle .loadingText1").text('لطفا منتظر نمایش "فیش حقوقی" بمانید ...');
                        $("#loading-circle").css("display", "flex");
                        //============================================[loading...]


                        $.ajax({
                            url: url2,
                            type: 'POST',
                            data: fd2,
                            processData: false,
                            contentType: false,
                            success: function (resp1) {

                                // دریافتی از بک‌اند را در المان با کلاس myTable نمایش دهید

                                if (resp1 == "0") {
                                    $("#loading-circle").css("display", "none");

                                    Toast.fire({
                                        icon: 'error',
                                        background: '#35434A',
                                        color: 'white',
                                        title: "مجوز نمایش فیش صادر نشده است"
                                    }).then(() => {

                                    });
                                }
                                else if (resp1 == "-1") {
                                    $("#loading-circle").css("display", "none");
                                    Toast.fire({
                                        icon: 'error',
                                        background: '#35434A',
                                        color: 'white',
                                        title: "فیشی برای این کاربر در این ماه محاسبه نشده است"
                                    }).then(() => {

                                    });
                                }
                                else if (resp1 == "-2") {
                                    $("#loading-circle").css("display", "none");
                                    Toast.fire({
                                        icon: 'error',
                                        background: '#35434A',
                                        color: 'white',
                                        title: "در نمایش فیش خطایی رخ داده است"
                                    }).then(() => {

                                    });
                                }
                                else {
                                    $("#loading-circle").css("display", "none");
                                    fd = new FormData();
                                    // $(".mytableSR").html(resp1);
                                    $("#big_modal_body").html(resp1)
                                    // $("#modalLg").modal('show')
                                }

                            },
                            error: function (resp1) {
                                console.log(resp1);
                                console.log("Nokeye");
                                $("#loading-circle").css("display", "none");
                                Toast.fire({
                                    icon: 'success',
                                    background: '#35434A',
                                    color: 'white',
                                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                                }).then(() => {

                                });
                            }
                        });
                    }
                    //================================================================================

                       var fd = new FormData();
                        //----------------------------------------------------------------
                    $("#btnShowSR").click(function () {
                        console.log($("#UserID").val());
                        console.log($("#Month").val());

                            if ($("#UserID").val() == 0) {
                                alert("لطفا مولفه را انتخاب کنید");
                            }
                            else if ($("#Month").val() == 0) {
                                alert("لطفا ماه را انتخاب کنید");
                            }
                            else if ($("#Year").val() == 0) {
                                alert("لطفا سال را انتخاب کنید");
                            }

                            else {

                                sendAjax26799('@Url.Action("ShowFish", "Formula", new { area = "Salaries" })', fd);
                           };
                     });
                    //================================================================================
                    break;
                //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
                //|--------------------------[      لیست تامین اجتماعی    ]--------------------------|
                //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
                case "لیست تامین اجتماعی":
                    startContainer.append(`
                     <style>
                        .location-arrow{
                            top: 47%;
                            left: 42.8%;
                            display: block;
                        }
                     </style>
                        <button id="generateReport" class="startT form-control">تولید گزارش</button>
                        <form id="downloadForm" method="GET" action="@Url.Action("bemeh", "Orders", new { area = "Setting" })" style="display: none;">
                            <input type="hidden" name="year" id="yearInput">
                            <input type="hidden" name="month_usr" id="monthInput">
                            <input type="hidden" name="compain" id="compainInput">
                        </form>
                    `);
                    //================================================================================

                    document.getElementById('generateReport').addEventListener('click', function (e) {

                        e.preventDefault();

                        // مقداردهی مقادیر به فیلدهای فرم
                        document.getElementById('yearInput').value = document.getElementById('year_usr').value;
                        document.getElementById('monthInput').value = document.getElementById('month_usr').value;
                        document.getElementById('compainInput').value = document.getElementById('compain').value;


                        if ($("#compain").val() == -1) {
                            alert("پیمان مورد نظر را انتخاب نمایید");
                        } else if ($("#year_usr").val() == 0) {
                            alert("سال مورد نظر را انتخاب نمایید");
                        } else if ($("#month_usr").val() == 0) {
                            console.log($("#month_usr").val());
                            alert("ماه مورد نظر را انتخاب نمایید");
                        } else {
                        // ارسال فرم برای دانلود فایل




                            //============================================[loading...]
                            $("#loading-circle .loadingText1").text('لطفا منتظر دانلود " لیست تامین اجتماعی" بمانید ...');
                            $("#loading-circle").css("display", "flex");
                            //============================================[loading...]

                            document.getElementById('downloadForm').submit();

                            //============================================[loading...]
                            setTimeout(() => {

                                $("#loading-circle").css("display", "none");

                            }, 5000); // مخفی کردن لودینگ بعد از 5 ثانیه (در صورت عدم بازگشت پاسخ از سرور)
                            //============================================[loading...]
                        }
                    });

                    //================================================================================
                    inputsContainer.append(`
                        <div class="col-xl-12 col-md-12 col-sm-12 col-12">
                            <label class="form-label">پیمان</label>
                            <div id="month-content"></div>
                        </div>
                    `);
                    //================================================================================
                        $.ajax({
                            url: '@Url.Action("GetAllCompanies345", "Peyman", new { area = "Contracts" })',
                            type: 'GET',
                            success: function (data) {
                                $("#month-content").html(data);
                            },
                            error: function () {
                                console.error("Error loading content");
                            }
                        });
                    //================================================================================
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">سال</label>
                            <select class="form-select" id="year_usr">
                        <option value="0">انتخاب کنید</option>

                        @{
                            for (var i = 4; i >= 0; i--)
                            {
                                var s = DateTime.Now.AddYears(-i);

                                <option value="@cs2.GetYear(s)">@cs2.GetYear(s)</option>
                            }
                        }
                    </select>
                        </div>
                    `);
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">ماه</label>
                            <select class="form-select" id="month_usr">
                                <option value="0">انتخاب کنید  </option>
                                <option value="1">فروردین </option>
                                <option value="2">اردیبهشت</option>
                                <option value="3">خرداد</option>
                                <option value="4">تیر</option>
                                <option value="5">مرداد</option>
                                <option value="6">شهریور</option>
                                <option value="7">مهر</option>
                                <option value="8">آبان</option>
                                <option value="9">آذر</option>
                                <option value="10">دی</option>
                                <option value="11">بهمن</option>
                                <option value="12">اسفند</option>
                            </select>
                        </div>
                    `);
                    //================================================================================

                    //================================================================================
                    break;
                //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
                //|--------------------------[     لیست مالیات حقوقی      ]--------------------------|
                //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
                case "لیست مالیات حقوقی":
                    startContainer.append(`
