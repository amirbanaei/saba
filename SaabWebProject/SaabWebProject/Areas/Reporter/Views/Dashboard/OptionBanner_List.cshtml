@using SaabWebProject.Models.Classes;
@*@model IEnumerable<SaabWebProject.Models.DomainModels.tbBannerSlider>*@
@using SaabWebProject.Models.DomainModels;
@{
    SaabEntities db = new SaabEntities();
}

@{
    ViewBag.Title = "تنظیمات فروش";
    Layout = null;
}
<style>

    .tableH_Lock {
        max-height: 533px;
        /*height: 533px;*/
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0px !important;
    }

    thead th {
        vertical-align: middle;
    }
</style>
<style>
    .ImgBannerList {
        width: 172px;
        border-radius: 5px;
        height: 100px
    }

    .ListText {
        position: absolute;
        color: #8c9098;
        width: 100%;
        word-wrap: break-word; /* اطمینان از شکستن کلمات طولانی */
        white-space: normal; /* اطمینان از مدیریت درست فضای سفید */
    }

        .ListText > div {
            text-align: center;
            word-wrap: break-word; /* اطمینان از شکستن کلمات طولانی */
            white-space: normal; /* اطمینان از مدیریت درست فضای سفید */
        }

    #myOutUpL {
        font-size: .22rem;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        margin-top: 0px;
        font-family: 'A EntezareZohoor B3';
        margin-right: 4.7%;
        width: 91%;
        height: 33.3333%;
    }

    #myOutMiL {
        font-size: .35rem;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        transform: translateY(34px);
        font-family: 'A EntezareZohoor B3';
        width: 73%;
        margin-right: 13.5%;
        height: 33.3333%;
    }

    #myOutDoL {
        font-size: .22rem;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        margin-top: 0px;
        font-family: 'A EntezareZohoor B3';
        margin-right: 4.7%;
        width: 91%;
        transform: translateY(70px);
        height: 33.3333%;
    }
</style>
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
<div class="card p-2">
    <div class="table-responsive tableH_Lock">
        <table class="table table-hover text-nowrap">
            <thead>

                <tr style="text-align:center">
                    <th width="03%">فعالیت</th>
                    <th width="03%">#</th>
                    <th width="16%">تصویر</th>
                    <th width="10%">
                        از تاریخ
                        <input type="text" id="filter01-filter" class="inputFilter form-control" placeholder="">
                    </th>
                    <th width="10%">
                        تا تاریخ
                        <input type="text" id="filter02-filter" class="inputFilter form-control" placeholder="">
                    </th>
                    <th width="55%">
                        متن اصلی
                        <div class="inputWithFilterIcon">
                            <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">
                            <span><i class="fas fa-filter"></i></span>
                        </div>
                    </th>
                    <th width="03%">وضعیت</th>
                </tr>

            </thead>
            <tbody>
                @{
                    var items = db.tbBannerSlider.ToList();
                }
                @if (db.tbBannerSlider.ToList() != null)
                {
                    var i = 0;
                    string TextImg = "";
                    foreach (var item in items)
                    {
                        i++;
                        if (item.TextCenter != "null")
                        {
                            TextImg = @item.TextCenter;
                        }
                        else
                        {
                            TextImg = "پیشفرض";
                        }
                        <tr class="task-list-row dateS_@i dateE_@i"
                            data-filter01=""
                            data-filter02=""
                            data-filter03="@TextImg">
                            @*-------------------------------------------------[1]-*@
                            <td>
                                <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                    <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <div class="dropdown-menu">
                                        <a data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item edit" id="Edit_@item.ID">ویرایش</a>
                                        @if (item.IsActive != null && (bool)item.IsActive)
                                        {
                                            <a data-bs-toggle="modal" style="cursor:pointer" class="dropdown-item" onclick="DeActiveBanner('@Url.Action("DeActiveBanner", "Dashboard", new { area = "Reporter" })',this,false)" id="U_@item.ID">غیرفعال کردن</a>
                                        }
                                        else
                                        {
                                            <a data-bs-toggle="modal" style="cursor:pointer" class="dropdown-item" onclick="DeActiveBanner('@Url.Action("DeActiveBanner", "Dashboard", new { area = "Reporter" })',this,true)" id="U_@item.ID">فعال کردن</a>
                                        }
                                        @if (item.ColorTop != "null")
                                        {
                                            <a class="dropdown-item Delete" id="Delete_@item.ID">حذف</a>
                                        }

                                    </div>
                                </div>
                            </td>
                            @*-------------------------------------------------[2]-*@
                            <td>@i</td>
                            @*-------------------------------------------------[3]-*@
                            <td>
                                <div class="row">
                                    @if (item.ColorCenter != "null")
                                    {

                                        <div class="col-xl-12 " style="position:relative;    padding: 0px;">
                                            <div class="ListText" style="position: absolute; color: #8c9098 ; width: 100%; height:100%">
                                                <div id="myOutUpL" style="position: absolute; color: @item.ColorTop !important">@item.TextTop</div>
                                                <div id="myOutMiL" style="position: absolute; color:@item.ColorCenter !important">@item.TextCenter</div>
                                                <div id="myOutDoL" style="position: absolute; color:@item.ColorDown !important">@item.TextDown</div>
                                            </div>
                                            <img id="image-p" class="ImgBannerList" src="/Areas/Reporter/Content/BannerImages/@item.ImgDir" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-xl-12 " style="position:relative;    padding: 0px;">
                                            <img id="image-p" class="ImgBannerList" src="/Areas/Reporter/Content/BannerImages/@item.ImgDir" />
                                        </div>
                                    }

                                </div>
                            </td>
                            @*-------------------------------------------------[4]-*@
                            <td cont-date1="dateS_@i" cont-date="dateS_@i" hidden>@item.StartDate</td>
                            <td id="dateS_@i"></td>
                            @*-------------------------------------------------[5]-*@
                            <td cont-date2="dateE_@i" cont-date="dateE_@i" hidden>@item.EndDate</td>
                            <td id="dateE_@i"></td>
                            @*-------------------------------------------------[6]-*@
                            <td>@TextImg</td>
                            @*----------------------------------------------------*@
                            <td>
                                @if ((bool)item.IsActive == true)
                                {
                                    <i class="far fa-lg fa-fw me-2 fa-check-square" style="color:green"></i>
                                }
                                else
                                {
                                    <i class="far fa-lg fa-fw me-2 fa-window-close" style="color:red"></i>
                                }
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/sweetalert2.js"></script>
<script>
    // Convert Gregorian date to jaali in the table
    var tds = document.querySelectorAll("[cont-date1]");
    var valueD, id, target;
    var options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    cont = 1
    tds.forEach(td => {
        valueD = new Date(td.textContent).toLocaleDateString('fa-IR-u-nu-latn', options).replace(',', '').replace(" ", "");
        valueD = valueD.slice(0, 10) + " " + td.textContent.slice(10, 30)
        id = td.getAttribute("cont-date1");
        target = document.getElementById(id);
        target.textContent = valueD;
        let row = document.querySelector('.task-list-row.dateS_' + cont);
        row.setAttribute('data-filter01', valueD);
        cont += 1
    });
    // Convert Gregorian date to jaali in the table
    tds = document.querySelectorAll("[cont-date2]");
    valueD, id, target;
    options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    cont = 1
    tds.forEach(td => {
        valueD = new Date(td.textContent).toLocaleDateString('fa-IR-u-nu-latn', options).replace(',', '').replace(" ", "");
        valueD = valueD.slice(0, 10) + " " + td.textContent.slice(10, 30)
        id = td.getAttribute("cont-date2");
        target = document.getElementById(id);
        target.textContent = valueD;
        let row = document.querySelector('.task-list-row.dateS_' + cont);
        row.setAttribute('data-filter02', valueD);
        cont += 1
    });

</script>
<script>

    var
        filters = {
            filter01: null,
            filter02: null,
            filter03: null,
        };

    function updateFilters() {
        $('.task-list-row').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter(filterName) {
        filters[filterName] = this.value;
        updateFilters();
    }

    // Assigned User Dropdown Filter
    $('#filter01-filter').on('input', function () {
        changeFilter.call(this, 'filter01');
    });
    $('#filter02-filter').on('input', function () {
        changeFilter.call(this, 'filter02');
    });
    $('#filter03-filter').on('input', function () {
        changeFilter.call(this, 'filter03');
    });


</script>
<script>
    // Convert Gregorian date to jaali in the table
    var tds = document.querySelectorAll("[cont-date]");
    var valueD, id, target;
    var options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    tds.forEach(td => {
        valueD = new Date(td.textContent).toLocaleDateString('fa-IR-u-nu-latn', options).replace(',', '').replace(" ", "");
        valueD = valueD.slice(0, 10)
        id = td.getAttribute("cont-date");
        target = document.getElementById(id);
        target.textContent = valueD;
    });
</script>
<script>
    $(".edit").click(function () {
        var idd = $(this).attr("id").split("_")[1];
        console.log(idd);

        var url = "/Reporter/Dashboard/GetId_Banner?id=" + idd;
        $("#big_modal_body").load(url);
    });
</script>
<script>
    $(".Delete").click(function () {
        var idd = $(this).attr("id").split("_")[1];

         Swal.fire({
             title: 'آیا از حذف مطمئن هستید؟',
             icon: 'question',
             showCancelButton: true,
             background: 'rgb(29,40,52)',
             color: 'white',
             confirmButtonColor: '#3085d6',
             cancelButtonColor: '#d33',
             confirmButtonText: 'بله ',
             cancelButtonText: 'خیر'
         }).then((result) => {
             console.log(result.isConfirmed)

         if (result.isConfirmed == true) {
               $(".loader").css('display', 'block');
               $.ajax({
               url: '@Url.Action("DeletBannerList", "Dashboard", new { area = "Reporter" })',
               data: { ID: idd },
               type: "Post",
               dataType: "html",
               success: function (resp) {
                    $("#loading-message").css("display", "none");
                   if (resp == "True") {
                       Swal.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با موفقیت حذف شد"
                        }).then(() => { location.reload();
                     });
                    } else {
                       Swal.fire({
                            icon: 'error',
                            background: '#35434A',
                            color: 'white',
                            title: "قادر به حذف  نیستید"
                        }).then(() => {
                        });
                    }

               },
               error: function (resp2) {
                   $("#loading-message").css("display", "none");
                   Toast.fire({
                       icon: 'error',
                       background: '#35434A',
                       color: 'white',
                       title: "حذف  با خطا مواجه شده است "
                   }).then(() => {location.reload();
                   });
               }
         });
         }

     });
      });
</script>
<script>
    /// DeActive Or Active a Business
    function DeActiveBanner(url, input, status) {

        var state = "غیرفعال";
        if (status) {
            state = "فعال";
        }

        Swal.fire({
            title: 'آیا مطمئن هستید؟',
            text: "این بنر  " + state + " می شود",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'بله, ' + state + ' کن!',
            cancelButtonText: '' + state + ' نکن'
        }).then((result) => {
            if (result.isConfirmed) {

                var id = $(input).attr('id').split('_')[1];
                input.setAttribute('title', state);
                $.ajax({
                    beforeSend: function () {
                        document.getElementById("loading-message").style.display = "block";
                    },
                    url: url,
                    type: "get",
                    data: { id: id },
                    dataType: "html",
                    success: function (res) {
                        document.getElementById("loading-message").style.display = "none";
                        if (res === "False") {
                            Swal.fire({
                                icon: 'error',
                                confirmButtonText: 'باشه',
                                title: 'خطا',
                                text: 'برنامه با خطا مواجه شد',
                            });
                            return false;
                        }
                        Swal.fire({
                            icon: 'success',
                            confirmButtonText: 'باشه',
                            title: '' + state + ' شد ',
                            text: 'بنر مورد نظر ' + state + ' شد',
                        }).then(function () {
                            document.location.reload();
                        });
                    },
                    error: function () {
                        document.getElementById("loading-message").style.display = "none";
                        Toast.fire({
                            icon: 'error',
                            background: '#35434A',
                            color: 'white',
                            title: "عملیات با خطا مواجه شد لطفا بعدا تلاش کنید"
                        });
                    }
                });
            }
        });
    }

</script>
