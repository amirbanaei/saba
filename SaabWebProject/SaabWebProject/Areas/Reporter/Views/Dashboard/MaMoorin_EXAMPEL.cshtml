<script>
    var monthYearSelect1 = document.getElementById('monthYearSelect1');
    var monthYearSelect2 = document.getElementById('monthYearSelect2');
    var buttonContainer = document.getElementById('buttonContainer');

    // Function to generate options for the month and year select elements
    function generateMonthYearOptions(selectElement) {
        var persianMonths = [
            'فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور',
            'مهر', 'آبان', 'آذر', 'دی', 'بهمن', 'اسفند'
        ];

        for (var year = 1401; year <= 1410; year++) {
            for (var month = 0; month < persianMonths.length; month++) {
                var option = document.createElement('option');
                option.value = year + '-' + month;
                option.textContent = persianMonths[month] + ' ' + year;
                selectElement.appendChild(option);
            }
        }
    }

    // Generate options for the month and year select elements
    generateMonthYearOptions(monthYearSelect1);
    generateMonthYearOptions(monthYearSelect2);

    // Event listener to handle the select change
    monthYearSelect1.addEventListener('change', generateButtons);
    monthYearSelect2.addEventListener('change', generateButtons);

    // Function to generate buttons
    function generateButtons() {
        var selectedValue1 = monthYearSelect1.value;
        var selectedValue2 = monthYearSelect2.value;
        var selectedParts1 = selectedValue1.split('-');
        var selectedParts2 = selectedValue2.split('-');
        var year1 = parseInt(selectedParts1[0]);
        var month1 = parseInt(selectedParts1[1]);
        var year2 = parseInt(selectedParts2[0]);
        var month2 = parseInt(selectedParts2[1]);
        var persianMonths = [
            'فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور',
            'مهر', 'آبان', 'آذر', 'دی', 'بهمن', 'اسفند'
        ];

        var distance = Math.abs((year2 - year1) * 12 + month2 - month1);
        buttonContainer.innerHTML = '';

        if (distance > 5) {
            var errorText = document.createElement('p');
            errorText.textContent = 'باز زمان انتخاب شما باید حداکثر 6 ماه باشد ';
            buttonContainer.appendChild(errorText);
        } else {
            for (var i = 0; i <= distance; i++) {
                var currentYear = year1 + Math.floor((month1 + i) / 12);
                var currentMonth = (month1 + i) % 12;

                var columnDiv = document.createElement('div');
                columnDiv.classList.add('col-xl-2');

                var button = document.createElement('button');
                var anchor = document.createElement('a');
                anchor.style.fontSize = '10px';
                anchor.style.color = 'black';
                anchor.style.textDecoration = 'none';
                anchor.textContent = persianMonths[currentMonth] + ' ' + currentYear;
                anchor.className = "download";
                button.classList.add('small-button', 'cool');

                button.appendChild(anchor);
                columnDiv.appendChild(button);

                buttonContainer.appendChild(columnDiv);

                $(".download").on('click', function () {
                    console.log("dfsdfdsf");
                    var yearmonth = $(this).text();
                    var yearmonthsplited = yearmonth.split(' ');
                    var month = yearmonthsplited[0];
                    var yr = yearmonthsplited[1];

                    if (month == "آذر") {
                         month = "09";

                     }
                    if (month== "دی") {
                         month = "10";

                      }
                    if (month == "بهمن") {
                         month = "11";

                     }
                    if (month == "اسفند") {
                       month = "12";

                     }
                    if (month == "فروردین") {
                       month = "01";

                     }
                    if (month== "اردیبهشت") {
                        month = "02";

                     }
                    if (month == "خرداد") {
                         month = "03";

                     }
                    if (month == "تیر") {
                         month = "04";

                     }
                    if (month == "مرداد") {
                        month = "05";

                     }
                    if (month == "شهریور") {
                         month = "06";

                     }
                    if (month == "مهر") {
                        month = "07";

                     }
                    if (month == "آبان") {
                        month = "08";

                    }
                    var obj = new Object;
                    obj = { year: yr, month: month, personelCode: -1, peyman: 19 };
                    console.log(obj);
        $.ajax({
            url: '@Url.Action("DownloadFish", "Salary", new { area = "Salaries" })',
            data: { year: yr, month: month, personelCode: -1, peyman: 19 },
                type: "Post",
                dataType: "html",
                 success: function (resp) {




                     if (resp == "0") {

                        Toast.fire({
                            icon: 'error',
                            background: '#35434A',
                            color: 'white',
                            title: "فیشی برای این ماه وجود ندارد"
                        }).then(() => {

                        });
                }
                     else {
                           var link = '@Url.Action("DownloadFish", "Salary", new { area = "Salaries", year = "7", month = "8", personelCode = "13", peyman = "15" })'


                         link = link.replace("7", yr);
                        link = link.replace("8", month);
                        link = link.replace("13", -1);
                        link = link.replace("15", 19);
                        link = link.replace("amp;", "");
                        link = link.replace("amp;", "");
                        link = link.replace("amp;", "");
                        link = link.replace("amp;", "");

                        window.location = link;

                     }
                   },
                   error: function (resp2) {

                   }
                    });
                });
            }
        }
    }
