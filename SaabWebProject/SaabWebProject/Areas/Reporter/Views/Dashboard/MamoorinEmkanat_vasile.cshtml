</div>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Scripts/sweetalert2.js"></script>
<script>
    $(document).ready(function () {
        let lastChecked;
        document.querySelectorAll('input[type="radio"]').forEach(radio => {
            radio.addEventListener('click', function () {
                if (lastChecked === this) {
                    this.checked = false;
                    lastChecked = null;
                } else {
                    lastChecked = this;
                }
            });
        });
    });

</script>
<script>
    function selectAllRadios(type) {
        const radios = document.querySelectorAll('.form-check-input.' + type);
        const tr = document.querySelectorAll('tr.vasile');
        console.log(tr[0])
        console.log(radios)
        let allChecked = true;

        // Check if all radios are already checked
        var cont = 0;
        radios.forEach(function (radio) {
            if (!radio.checked) {
                if (window.getComputedStyle(tr[cont]).display != 'none') {
                    allChecked = false;
                }

            }
            cont += 1
        });
        var cont = 0;
        // If all are checked, uncheck all, otherwise check all
        radios.forEach(function (radio) {

            if (window.getComputedStyle(tr[cont]).display != 'none') {
                radio.checked = !allChecked;
            }
            cont += 1
        });

        // Uncheck the header radio button if it's already checked and all radios are now unchecked
        const headerRadio = document.querySelector('#selectAll' + type.charAt(0).toUpperCase() + type.slice(1));
        console.log(headerRadio)
        if (allChecked) {
            headerRadio.checked = false;
        } else {
            headerRadio.checked = true;
        }
    }
</script>
<script>
    $(document).ready(function () {
    const centralSelector = document.getElementById('centralSelector');
    const dependentSelectors = document.querySelectorAll('.dependentSelector');
    const tr = document.querySelectorAll('tr.vasile');
    centralSelector.addEventListener('change', function () {
        const selectedValue = centralSelector.value;
        var cont = 0;
        dependentSelectors.forEach(function (selector) {
            if (window.getComputedStyle(tr[cont]).display != 'none') {
                selector.value = selectedValue;
            }
            cont += 1
        });
    });
    });
</script>
