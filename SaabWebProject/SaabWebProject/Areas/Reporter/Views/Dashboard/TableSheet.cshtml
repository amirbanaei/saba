<script>
    $('#savebtn').on('click', function () {
        // دریافت تمام شیت‌ها
        let data = luckysheet.getAllSheets();
        console.log(data);

        // کار با شیت اول
        var sheet = data[0];
        var sheetData = sheet.data; // داده‌های سلول‌ها
        var config = sheet.config || {};
        var borderInfo = config.borderInfo || [];
        var mergeInfo = config.merge || {};
        var rowlen = config.rowlen || {}; // ارتفاع ردیف‌ها
        var columnlen = config.columnlen || {}; // عرض ستون‌ها

        if (!sheetData) {
            alert("دیتایی موجود نیست.");
            return;
        }

        // نقشه برای رد شدن از سلول‌های ادغام‌شده
        const skipMap = {};

        // محاسبه عرض ستون‌ها
        let totalWidth = 0;
        let colWidths = [];
        const defaultColWidth = 73; // عرض پیش‌فرض در صورتی که columnlen مقدار نداشته باشه
        const numCols = sheetData[0].length; // تعداد ستون‌ها

        // استخراج عرض ستون‌ها از config.columnlen
        for (let colIndex = 0; colIndex < numCols; colIndex++) {
            let colWidth = columnlen[colIndex] ? parseInt(columnlen[colIndex]) : defaultColWidth;
            colWidths.push(colWidth);
            totalWidth += colWidth;
        }

        // لاگ کردن عرض‌ها برای دیباگ
        console.log("Column Widths:", colWidths);
        console.log("Total Width:", totalWidth);
        console.log("Column Length Data:", columnlen);

        // شروع تولید جدول HTML
        var tableHTML = '<table class="tableModal" style="width:100%; border-collapse: collapse; direction: ltr;">';

        // تولید بدنه جدول
        sheetData.forEach(function (row, rowIndex) {
            if (!row) return;
            let rowHeight = rowlen[rowIndex] ? parseInt(rowlen[rowIndex]) : 30; // ارتفاع پیش‌فرض 30px
            tableHTML += '<tr style="height:' + rowHeight + 'px;">';

            row.forEach(function (cell, colIndex) {
                const cellKey = `${rowIndex}_${colIndex}`;
                if (skipMap[cellKey]) return;

                let rowspan = 1;
                let colspan = 1;
                let styles = '';
                let value = (cell && cell.v != null) ? cell.v : '';
                let formula = (cell && cell.f) ? cell.f : ''; // فرمول
                let rotationStyle = ''; // جدید: استایل چرخش

                // دیباگ برای بررسی وجود bl
                if (cell && cell.bl) {
                    console.log(`Cell [${rowIndex}, ${colIndex}] is bold:`, cell.bl);
                }

                // پردازش ادغام‌ها
                const mergeKey = Object.keys(mergeInfo).find(key => {
                    const item = mergeInfo[key];
                    return item.r === rowIndex && item.c === colIndex;
                });

                if (mergeKey) {
                    const merge = mergeInfo[mergeKey];
                    rowspan = merge.rs;
                    colspan = merge.cs;

                    for (let r = rowIndex; r < rowIndex + rowspan; r++) {
                        for (let c = colIndex; c < colIndex + colspan; c++) {
                            if (r === rowIndex && c === colIndex) continue;
                            skipMap[`${r}_${c}`] = true;
                        }
                    }
                }

                // پردازش استایل‌های سلول
                if (cell) {
                    if (cell.bg) styles += `background-color:${cell.bg};`;
                    if (cell.fc) styles += `color:${cell.fc};`;
                    if (cell.fs) styles += `font-size:${cell.fs}px;`;
                    // اعمال بولد با اولویت بالا
                    if (cell.bl) styles += 'font-weight:bold !important;';
                    if (cell.it) styles += 'font-style:italic;';
                    if (cell.un) styles += 'text-decoration:underline;';
                    // ترازبندی افقی
                    if (cell.ht) {
                        if (cell.ht === '0') styles += 'text-align:center;';
                        else if (cell.ht === '1') styles += 'text-align:left;';
                        else if (cell.ht === '2') styles += 'text-align:right;';
  
                    }
                    // ترازبندی عمودی
                    if (cell.vt) {
                        if (cell.vt === '0') styles += 'vertical-align:middle;';
                        else if (cell.vt === '1') styles += 'vertical-align:top;';
                        else if (cell.vt === '2') styles += 'vertical-align:bottom;';
                    }
                    // قالب‌بندی عدد
                    if (cell.ct && cell.ct.fa) {
                        if (cell.ct.fa.includes('#,##0')) {
                            if (typeof value === 'number') {
                                value = value.toLocaleString('en-US');
                            }
                        } else if (cell.ct.fa.includes('0.00')) {
                            if (typeof value === 'number') {
                                value = value.toFixed(2);
                            }
                        }
                    }
                    var DegR=[0,-45,45,-180,-90,90]
                    //================================================
                    // جدید: پردازش چرخش
                    if (cell.tr) {
                        rotationStyle += `rotate: ${DegR[cell.tr]}deg;justify-self:left;`
                        if (cell.ht === '0') {
                            rotationStyle += `rotate: ${DegR[cell.tr]}deg;justify-self:center;`
                        } else if (cell.ht === '1') {
                            rotationStyle += `rotate: ${DegR[cell.tr]}deg;justify-self:left;`
                        } else if (cell.ht === '2') {
                            rotationStyle += `rotate: ${DegR[cell.tr]} deg; justify-self:right;`
                        }
                         
                    }
                    //================================================ 

                }

                // پردازش بردرها
                let borderStyle = '';
                borderInfo.forEach(function (border) {
                    if (border.range && Array.isArray(border.range)) {
                        border.range.forEach(function (rangeItem) {
                            if (
                                rowIndex >= rangeItem.row[0] &&
                                rowIndex <= rangeItem.row[1] &&
                                colIndex >= rangeItem.column[0] &&
                                colIndex <= rangeItem.column[1]
                            ) {
                                const color = border.color || '#000';
                                const width = 1;
                                const solid = `${width}px solid ${color};`;

                                switch (border.borderType) {
                                    case 'border-all':
                                        borderStyle += `border:${solid}`;
                                        break;
                                    case 'border-outside':
                                        if (rowIndex === rangeItem.row[0]) borderStyle += `border-top:${solid}`;
                                        if (rowIndex === rangeItem.row[1]) borderStyle += `border-bottom:${solid}`;
                                        if (colIndex === rangeItem.column[0]) borderStyle += `border-left:${solid}`;
                                        if (colIndex === rangeItem.column[1]) borderStyle += `border-right:${solid}`;
                                        break;
                                    case 'border-horizontal':
                                        borderStyle += `border-top:${solid} border-bottom:${solid}`;
                                        break;
                                    case 'border-vertical':
                                        borderStyle += `border-left:${solid} border-right:${solid}`;
                                        break;
                                    case 'border-left':
                                        borderStyle += `border-left:${solid}`;
                                        break;
                                    case 'border-right':
                                        borderStyle += `border-right:${solid}`;
                                        break;
                                    case 'border-top':
                                        borderStyle += `border-top:${solid}`;
                                        break;
                                    case 'border-bottom':
                                        borderStyle += `border-bottom:${solid}`;
                                        break;
                                    case 'border-none':
                                        borderStyle += 'border:none;';
                                        break;
                                }
                            }
                        });
                    }
                });

                // تنظیم عرض سلول (برای سلول‌های ادغام‌شده، عرض کل را محاسبه می‌کنیم)
                let colWidth = 0;
                if (colspan > 1) {
                    // اگر سلول ادغام‌شده است، عرض کل ستون‌های ادغام‌شده را جمع می‌کنیم
                    for (let i = colIndex; i < colIndex + colspan; i++) {
                        colWidth += colWidths[i] || defaultColWidth;
                    }
                } else {
                    colWidth = colWidths[colIndex] || defaultColWidth;
                }
                //colWidth = colWidth + 'px';

                // تولید محتوای سلول با چرخش
                let content = value;
                if (rotationStyle) {
                    content = `<div style="${rotationStyle}">${value}</div>`;
                } else {
                    content = `<div style="">${value}</div>`
                }

                // تولید تگ td
                tableHTML += `<td style="width:${colWidth * 100 / totalWidth}%; padding:4px; ${styles}${borderStyle}"` +
                    (cell && cell.f ? ` data-formula="${cell.f}"` : '') +
                    (rowspan > 1 ? ` rowspan="${rowspan}"` : '') +
                    (colspan > 1 ? ` colspan="${colspan}"` : '') +
                    '>' + content + '</td>';
            });
            tableHTML += '</tr>';
        });

        tableHTML += '</table>';

        // افزودن جدول به مودال
        $('#big_modal_body').html(tableHTML);
    });
</script>


