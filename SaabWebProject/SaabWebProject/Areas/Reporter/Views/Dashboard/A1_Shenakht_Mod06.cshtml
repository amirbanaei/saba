<script>
    var eueuValue = 6;

    var eueuValue2 = 88;
    var eueuValue3 = 6;

    am4core.ready(function () {
        // Themes begin
        am4core.useTheme(am4themes_animated);
        // Themes end

        var chartP = am4core.create("chartdiv", am4charts.PieChart3D);
        chartP.hiddenState.properties.opacity = 1; // this creates initial fade-in

        chartP.data = [
            {
                country: "تورم",
                litres: eueuValue3,
                color: am4core.color("#52d3d8")

            },
            {
                country: "کمبود",
                litres: eueuValue,
                color: am4core.color("#1679ab")
            },
            {
                country: "کل نیروی",
                litres: eueuValue2,

                color: am4core.color("#38419d")

            }
        ];

        chartP.innerRadius = am4core.percent(40);
        chartP.depth = 20; // عمق ثابت برای تمام بخش‌ها
        chartP.angle = 40;
        chartP.startAngle = 450; // شروع از بالای چارت
        chartP.endAngle = 450 + 360; // نمایش کامل چارت
        chartP.legend = new am4charts.Legend();
        chartP.legend.disabled = true;

        var seriesP = chartP.series.push(new am4charts.PieSeries3D());
        seriesP.dataFields.value = "litres";
        seriesP.dataFields.category = "country";
        seriesP.slices.template.propertyFields.fill = "color";
        seriesP.slices.template.cornerRadius = 20;

        seriesP.tooltip.getFillFromObject = false;
        seriesP.tooltip.background.fill = am4core.color("transparent");
        seriesP.tooltip.background.strokeOpacity = 0;
        seriesP.tooltip.disabled = true;

        seriesP.labels.template.fill = am4core.color("#888");
        //seriesP.labels.template.fontSize = 12;
        //seriesP.labels.template.fontWeight = "bold";
        /*        seriesP.labels.template.fontFamily = "BNazanin";*/
        seriesP.labels.template.adapter.add("rotation", function (rotation, target) {
            return 0;
        });

        seriesP.labels.template.adapter.add("radius", function (radius, target) {
            return -20;
        });

        //seriesP.labels.template.adapter.add("radiusChange", function (radiusChange, target) {
        //    return -50;
        //});

        seriesP.ticks.template.stroke = am4core.color("#888");
        seriesP.ticks.template.strokeWidth = 2;
        seriesP.labels.template.bent = true;
        seriesP.labels.template.padding(0, 0, 0, 0);

    }); // end am4core.ready()
</script>