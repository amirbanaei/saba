        colors: ["#4c98fa", "#00b379"],
        fill: {
            type: "gradient",
            gradient: {
                shadeIntensity: 1,
                inverseColors: false,
                opacityFrom: 0.5,
                opacityTo: 0,
                stops: [0, 90, 100]
            }
        },
        markers: {
            size: 4,
        },
        dataLabels: {
            enabled: false
        },
        stroke: {
            curve: 'straight',
            width: 3
        },
        grid: {},
        xaxis: {
            categories: [
                'موجود', 'ایده آل', 'شرایط بهینه', 'دیجبران کمبودهای وضع موجود',
            ],
        }
    };

    var chart = new ApexCharts(document.querySelector("#chartdiv123"), options);
    chart.render();
</script>
