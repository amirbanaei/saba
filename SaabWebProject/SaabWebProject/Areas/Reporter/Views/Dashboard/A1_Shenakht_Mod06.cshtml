<script>
    var options = {
        series: [
            {
                name: 'سناریو اول :جذب و استخدام نیروی جدید: ',
                data: [@Model.Condition1_mojod, @Model.Condition1_edehal, @Model.Condition1_beheneh, @Model.Condition1_jobran]
