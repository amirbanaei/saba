<script>
        // Function to format numbers with commas
        function formatNumberWithCommas(number) {
            return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        // Function to remove commas from a formatted number
        function removeCommas(number) {
            return number.replace(/,/g, '');
        }

        // Apply the formatting to all relevant input fields
        $('input.form-control2').on('input', function () {
            var value = $(this).val();
            value = removeCommas(value); // Remove existing commas
            if ($.isNumeric(value)) {
                $(this).val(formatNumberWithCommas(value)); // Format with commas
            }
        });
    $('input.form-control100').on('input', function () {
        var value = $(this).val();
        value = removeCommas(value); // Remove existing commas
        if ($.isNumeric(value)) {
            $(this).val(formatNumberWithCommas(value)); // Format with commas
        }
    });
    $('input.form-control100').each(function () {
        var value = $(this).val();
        if ($.isNumeric(value)) {
            $(this).val(formatNumberWithCommas(value)); // اعمال فرمت
        }
    });

    $('input.form-control2').each(function () {
        var value = $(this).val();
        if ($.isNumeric(value)) {
            $(this).val(formatNumberWithCommas(value)); // اعمال فرمت
        }
    });
    $("#btn_SaveMovaqat2").click(function () {
        // جمع‌آوری داده‌ها
        var dataList = []; // ایجاد یک آرایه برای ذخیره تمام داده‌ها
        var id3 =@Model.ID;
        $("input.form-control2").each(function () {
            var inputId = $(this).attr("id");
            var value = $(this).val();
            value = removeCommas(value); // Remove commas before sending to the server

            if (value) { // اگر ورودی پر شده است
                var parts = inputId.split('_'); // تقسیم ID به اجزا
                var type = parts[0];   // مثلا 'fardi'
                var phase = parts[1];  // مثلا 'takfaz'
                var area = parts[2];   // مثلا 'shahri'
                var id = parts[3];     // ID رکورد در دیتابیس
                dataList.push({
                    id: id,
                    type: type,
                    phase: phase,
                    area: area,
                    value: value,
                    ghragtdemandi: null,

                    ghragtrostaei: null,
                    ghragtshahri: null
                });
