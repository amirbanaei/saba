@model SaabWebProject.Models.ViewModels.Contracts.Function.Marhale4ViewModel

@{
    Layout = null;
}

<style>
    .tableH_Lock {
        max-height: 364px;
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0 !important;
        min-width: 100px;
    }

    .RadioFilter {
        margin-bottom: 0 !important;
    }

    thead th {
        vertical-align: middle;
    }
</style>

<div class="card">
    <div class="table-content p-4">
        <div class="table-responsive tableH_Lock">

            <table class="table table-hover text-nowrap">

                <!-- HEADER -->
                <thead>
                    <tr>

                        <th>
                            نام و نام خانوادگی
                            <div>
                                <input type="text" id="filter08-filter" class="form-control inputFilter">
                            </div>
                        </th>

                        <th>
                            پیمان
                            <div>
                                <input type="text" id="filter09-filter" class="form-control inputFilter">
                            </div>
                        </th>

                        <th>
                            شهرستان
                            <div>
                                <input type="text" id="filter10-filter" class="form-control inputFilter">
                            </div>
                        </th>

                        @foreach (var mh in Model.Marhale3)
                        {
                            <th>
                                @mh.name
                                <div class="form-check">
                                    <input type="radio"
                                           class="form-check-input RadioFilter"
                                           id="selectAllMamur_@mh.ID"
                                           onclick="selectAllRadios('mamur', @mh.ID)" />
                                </div>
                            </th>
                        }

                    </tr>
                </thead>

                <!-- BODY -->
                <tbody>

                    @{
                        foreach (var user in Model.Users)
                        {
                            var city = Model.Cities.FirstOrDefault(c => c.ID == user.usr_City_Dutysystem)?.Name ?? "وصل نیست";

                            var peyman =
                                Model.UserPeymans
                                    .FirstOrDefault(x => x.FK_User_ID == user.usr_ID)
                                    ?.tbPeymanContracts?.pec_Title
                                ?? "وصل نیست";

                            <tr class="vasile task-list-row2"
                                data-filter08="@user.FullName"
                                data-filter09="@peyman"
                                data-filter10="@city">

                                <td>@user.FullName</td>
                                <td>@peyman</td>
                                <td>@city</td>

                                @foreach (var mh in Model.Marhale3)
                                {
                                    var val = Model.Values.FirstOrDefault(v =>
                                        v.FK_usr == user.usr_ID &&
                                        v.FK_name == mh.ID
                                    );

                                    var isChecked = (val != null && val.Position == true);

                                    <td>
                                        <input type="radio"
                                               class="form-check-input mamur form-control44334 RadioFilter"
                                               name="checkRow_@user.usr_ID"
                                               data-bind="@mh.ID"
                                               data-keyboard="@user.usr_ID"
                                               data-column="@mh.ID"
                                               @(isChecked ? "checked" : "") />
                                    </td>
                                }

                            </tr>
                        }
                    }
                </tbody>

            </table>

        </div>
    </div>
</div>

<!-- Save Button -->
<div class="row mt-3">
    <div class="col-xl-11"></div>
    <div class="col-xl-1">
        <button id="btnSaveEsmahdod2" type="button" class="btn form-control buttonsabt">
            <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
            <span class="bSabt-text">ثبت</span>
        </button>
    </div>
</div>

<script src="~/Scripts/jquery-3.3.1.js"></script>

