<script src="~/Scripts/jquery-3.3.1.js"></script>

<script>

    var filters = {
        filter08: null,
        filter09: null,
        filter10: null
    };

    function updateFilters4() {
        $('.task-list-row2').hide().filter(function () {
            var self = $(this), ok = true;

            Object.keys(filters).forEach(f => {
                if (filters[f]) ok = ok && self.data(f).indexOf(filters[f]) !== -1;
            });

            return ok;
        }).show();
    }

    $('#filter08-filter').on('input', function () { filters.filter08 = this.value; updateFilters4(); });
    $('#filter09-filter').on('input', function () { filters.filter09 = this.value; updateFilters4(); });
    $('#filter10-filter').on('input', function () { filters.filter10 = this.value; updateFilters4(); });

    function selectAllRadios(type, colId) {
        const rows = document.querySelectorAll("tr.vasile");
        const radios = document.querySelectorAll(`.${type}[data-column="${colId}"]`);

        let allChecked = true;

        radios.forEach((r, i) => {
            if (!r.checked && rows[i].style.display !== "none")
                allChecked = false;
        });

        radios.forEach((r, i) => {
            if (rows[i].style.display !== "none")
                r.checked = !allChecked;
        });

        document.querySelector(`#selectAllMamur_${colId}`).checked = !allChecked;
    }

    $("#btnSaveEsmahdod2").click(function () {

        var list = [];

        $("input.mamur").each(function () {
            list.push({
                FK_usr: $(this).data("keyboard"),
                FK_name: $(this).data("bind"),
                Position: $(this).is(":checked")
            });
        });

        $.ajax({
            url: '/Reporter/Dashboard/UpdateRecordmahdodat3',
            type: 'POST',
            data: JSON.stringify({ modelList: list }),
            contentType: 'application/json; charset=utf-8',

            beforeSend: function () {

                // نمایش لودینگ خطی سایت
                document.getElementById("loading-circle").style.display = "block";

                $("#btnSaveEsmahdod2").prop("disabled", true);
            },

            success: function (r) {

                if (r === "true") {
                    alert("با موفقیت ثبت شد");
                    //location.reload();
                }

            },

            error: function (err) {
                console.log(err);
                alert("خطا در ثبت اطلاعات");
            },

            complete: function () {

                // مخفی کردن لودینگ
                document.getElementById("loading-circle").style.display = "none";

                $("#btnSaveEsmahdod2").prop("disabled", false);

            }

        });

    });



</script>
