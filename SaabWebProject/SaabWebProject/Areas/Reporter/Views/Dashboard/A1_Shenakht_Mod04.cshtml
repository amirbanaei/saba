<script>
    function Geeks() {
        var table = document.getElementById("table_First04");
        var rowCount = table.rows.length;
        console.log(rowCount)
        if (rowCount > 5) {
            table.deleteRow(rowCount - 1);
        }
    }
</script>


<script>
    var counter = 1;
    $("#btn_SaveMovaqat").click(function () {
        var tbodyRef = document.getElementById('table_First04').getElementsByTagName('tbody')[0];
        var newRow = tbodyRef.insertRow();

        var newCell = newRow.insertCell();
        newCell.colSpan = 2
        newCell.classList = [""]
        var newInput = document.createElement("input");
        newInput.classList = ["form-control numbers"]
        newInput.style = "margin-bottom: 0 !important;"
        newCell.appendChild(newInput);

        var newCell = newRow.insertCell();
        newCell.colSpan = 1
        var newInput = document.createElement("input");
        newInput.classList = ["form-control "]
        newInput.style = "margin-bottom: 0 !important;"
        newCell.appendChild(newInput);

        var newCell = newRow.insertCell();
        newCell.colSpan = 2
        var newInput = document.createElement("input");
        newInput.classList = ["form-control numbers"]
        newInput.style = "margin-bottom: 0 !important;"
        newCell.appendChild(newInput);

        var newCell = newRow.insertCell();
        newCell.colSpan = 3
        var newInput = document.createElement("input");
        newInput.classList = ["form-control numbers"]
        newInput.style = "margin-bottom: 0 !important;"
        newCell.appendChild(newInput);



        counter++;


    });
</script>

<script>
    $("#btnSaveContract").click(function () {
        console.log("dsajd;s");

        // جمع‌آوری داده‌ها
        var dataList = [];

        $("input.form-control10").each(function () {
            var inputId = $(this).attr("id");
            var value = $(this).val();
            console.log(inputId);
            console.log(value);

            if (value) { // اگر ورودی پر شده است
                // مثلا 'shahri'
                var id = inputId;     // ID رکورد در دیتابیس
                dataList.push({
                    ID: id,
                    Name: "df",
                    Title: "ds",
                    FK_name: 1,
                    vahed: "dsf",
                    value: value
                });
                // ارسال داده‌ها به سرور
            }
        });
        if (dataList.length > 0) {
            updateDatabase(dataList);
            console.log(dataList);
        }
    });
    function updateDatabase(dataList) {
        $.ajax({
            url: '/Reporter/Dashboard/UpdateRecord7', // آدرس اکشن کنترلر شما
            method: 'POST',
            data: JSON.stringify(dataList), // ارسال آرایه به سرور

            contentType: 'application/json',
            success: function (response) {
                console.log("Record updated successfully.");
                if (response == "true") {
                    alert("با موفقیت ثبت شد");
                    location.reload();

                }
            },
            error: function (error) {
                console.error("Error updating record:", error);
            }
        });
    }

</script>