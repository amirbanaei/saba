                                </th>
                                <th style="border-bottom-left-radius: 10px !important">
                                    تعداد روز تعطیل در هفته
                                    <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var userGroup in db.dbtarifmovazaf.GroupBy(s => s.FK_usr).ToList())
                            {
                                string name = "";
                                int shiftCount = 0;
                                string clock1 = "";
                                TimeSpan? totalTimeDifference = TimeSpan.Zero; // مقدار اولیه برای تفاوت زمانی

                                // شمارش تعداد شیفت‌هایی که کارمند در آن‌ها کار کرده است

                                foreach (var userGroup22 in db.dbtarifmovazaf.Where(s => s.FK_usr == userGroup.Key).GroupBy(s => s.day).ToList())
                                {
                                    if (userGroup22.Any(s => s.parttime == 1 && s.start_clock == TimeSpan.Zero)) // شیفت صبح
                                    {
                                        if (userGroup22.Any(s => s.parttime == 2 && s.start_clock == TimeSpan.Zero)) // شیفت عصر
                                        {
                                            if (userGroup22.Any(s => s.parttime == 3 && s.start_clock == TimeSpan.Zero)) // شیفت شب
                                            {
                                                shiftCount++;

                                            }
                                        }
                                    }

                                }

                                // محاسبه تفاوت زمانی قبل از ورود به حلقه
                                foreach (var shift in userGroup)
                                {
                                    var startTime = shift.start_clock;
                                    var endTime = shift.end_clock;

                                    // محاسبه تفاوت زمانی برای هر شیفت و جمع‌کردن آن به تفاوت کلی
                                    if (startTime.HasValue && endTime.HasValue)
                                    {
                                        totalTimeDifference += (endTime - startTime);
                                    }

                                    name = shift.tbUsers.FullName;

                                }
                                if (totalTimeDifference.HasValue)
                                {
                                    // محاسبه ساعات و دقیقه‌ها
                                    var totalHours = Math.Floor(totalTimeDifference.Value.TotalHours); // کل ساعات
                                    var totalMinutes = totalTimeDifference.Value.Minutes; // دقیقه‌ها

                                    // نمایش ساعت‌ها و دقیقه‌ها
                                    clock1 = (totalHours.ToString("00") + ":" + totalMinutes.ToString("00"));
                                }
                                else
                                {
                                    clock1 = "00:00";
                                }
                                // اینجا نتیجه تفاوت زمانی جمع‌شده را نمایش می‌دهیم
                                <tr class="task-list-row "
                                    data-filter01="@userGroup.First().tbUsers.FullName"
                                    data-filter02="@clock1"
                                    data-filter03=" @shiftCount ">

                                    <td colspan="1" rowspan="1">

                                        <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                            <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <div class="dropdown-menu">
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item edit" id="Edit_@userGroup.Key ">حذف</a>
                                                <a data-bs-toggle="modal" data-bs-target="#modalLg1" class="dropdown-item Erja" id="Erja_@userGroup.Key">ویرایش</a>

                                            </div>
                                        </div>
                                    </td>

                                    <td colspan="1" rowspan="1">
                                        @userGroup.First().tbUsers.FullName <!-- نمایش نام کارمند -->
                                    </td>



                                    <td colspan="1" rowspan="1">
                                        @clock1
                                    </td>

                                    <td colspan="1" rowspan="1">
                                        @shiftCount <!-- نمایش تعداد شیفت‌هایی که کارمند در آن روز کار کرده است -->
                                    </td>
                                </tr>
                            }
