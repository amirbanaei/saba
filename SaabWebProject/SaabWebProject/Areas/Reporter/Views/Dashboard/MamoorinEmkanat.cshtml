<script>

    var
        filters = {
            user: null,
            //status: null,
            //milestone: null,
            //priority: null,
            //tags: null
        };

    function updateFilters() {
        $('.task-list-row').hide().filter(function () {
            var
                self = $(this),
                result = true; // not guilty until proven guilty

            Object.keys(filters).forEach(function (filter) {
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    result = result && filters[filter] === self.data(filter);
                }
            });

            return result;
        }).show();
    }

    function changeFilter(filterName) {
        filters[filterName] = this.value;
        updateFilters();
    }

    // Assigned User Dropdown Filter
    $('#assigned-user-filter').on('change', function () {
        changeFilter.call(this, 'user');
    });


           // برای زمانی که مودال باز می‌شود و محتوای آن بارگذاری می‌شود
$("#btnVirayeshVasile").click(function () {
    $("#big_modal_body1").load('@Url.Content("~/Reporter/Dashboard/MamoorinEmkanat_vasile")', function () {
        // پس از بارگذاری محتوای مودال، فیلترها را دوباره اعمال کنید
        updateFilters();
    });
});
</script>


