        });
        document.getElementById('ColorCenter').addEventListener('change', function () {
            const pElementMi = document.getElementById("myOutMi");
            pElementMi.style.color = this.value;
        });
        document.getElementById('ColorDown').addEventListener('change', function () {
            const pElementDo = document.getElementById("myOutDo");
            pElementDo.style.color = this.value;
        });
    });
</script>
<script>
