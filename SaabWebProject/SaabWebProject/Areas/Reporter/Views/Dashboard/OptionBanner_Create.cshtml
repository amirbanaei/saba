<script>

    $('input[type=radio][name=radiobutton_img]').change(function () {
        const imagePreview2 = document.getElementById('image-preview2');

        if (this.value == 'w') {
            imagePreview2.src = "/Areas/Reporter/Content/BannerImages/w.jpg";
        }
        else if (this.value == 'h') {
            imagePreview2.src = "/Areas/Reporter/Content/BannerImages/h.jpg";
        }
        else if (this.value == 'b') {
            imagePreview2.src = "/Areas/Reporter/Content/BannerImages/b.jpg";
        }
    });
</script>
<script>
    $('input[type=radio][name=DefaultOrManual]').change(function () {

        if (this.value == 'Default') {
            $("#Default").show()
            $("#Manual").hide()
        }
        else if (this.value == 'Manual') {
            $("#Default").hide()
            $("#Manual").show()
        }
    });
</script>

