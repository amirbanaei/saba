<div class="tab-pane fade show active" id="allTab">
    <div class="table-responsive">
        <table class="table table-hover" style="text-align:center;">
            <thead class="table-dark">
                <tr>
                    <td>ردیف</td>
                    @*<td>عنوان</td>*@
                    <td>شرح</td>
                    <td>تاریخ</td>
                    <td>ثبت کننده</td>
                    <td>پیوست</td>
                    <td>دیده شده</td>

                </tr>
            </thead>
            <tbody>
                @{ var counter = 0;}
                @foreach (var item in Model.Where(p => p.FK_isr2 != null))
                {
                    string name = "";
                    var find = db.tbUsers.Where(p => p.usr_ID == item.FK_isr2).FirstOrDefault();
                    if (find != null)
                    {
                        name = find.FullName;
                    }
                    counter++;
                    <tr>
                        @if (counter == 1)
                        {
                            <td class="first" id="first_@item.ID">@counter</td>
                        }
                        else
                        {
                            <td>@counter</td>

                        }

                        <td>@item.Title</td>
                        @{
                            PersianCalendar persianCalendar = new PersianCalendar();
                            string persianDate = "";

                            if (item.DataDocument != null)
                            {
                                DateTime dateTime = item.DataDocument.Value;
                                persianDate = persianCalendar.GetYear(dateTime) + "/" +
                                              persianCalendar.GetMonth(dateTime).ToString("00") + "/" +
                                              persianCalendar.GetDayOfMonth(dateTime).ToString("00");
                            }
                        }
                        <td >
                            @persianDate
                        </td>
                        <td>@name</td>
                        @if (item.File_RealName != null)
                        {
                            <td><a target="_blank" href="~/Areas/ManagementAccounting/Contents/RegistrationDucumentAttachmentsFile/@item.File_SystemName">دانلود</a></td>
                        }
                        else
                        {
                            <td>
                                ندارد
                            </td>
                        }
                        @if (item.notseee != 1)
                        {
                            <td><i style="color:green" class="bi bi-eye-fill text-theme"></i></td>
                        }
                        else
                        {
                            <td><i style="color:red" class="bi bi-eye-slash-fill text-theme"></i></td>

                        }
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>
