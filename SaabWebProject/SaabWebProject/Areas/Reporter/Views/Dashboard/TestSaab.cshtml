<script>
    const image = document.querySelector('.BaseImgStart');
    const button = document.querySelector('.EjrayeMohasebe');

    // وقتی روی تصویر کلیک می‌شود
    image.addEventListener('click', function () {
        button.classList.add('btnS'); // اضافه کردن کلاس آبی به دکمه
    });
</script>