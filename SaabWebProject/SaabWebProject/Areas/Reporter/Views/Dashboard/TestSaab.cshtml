        background: #011947;
        border-radius: 35%;
    }

    .btn:hover,
    img:hover + .btn {
        border: 2px solid #00FFB7;
        box-shadow: 0 0px 3px #00FFB7;
        background:linear-gradient(165deg, rgba(37, 219, 0, .35) -11%, rgba(121, 235, 128, 0) 93%, rgba(205, 251, 255, 0) 100%)
    }


    
    .btnS {
        display: grid;
        place-content: center;
        color: white;
        text-shadow: 0 1px 0 #000;
        --border-angle: 0turn;
        --main-bg: conic-gradient(from var(--border-angle), #011947, #011947 5%, #011947 60%, #011947 95%);
        border: solid 5px transparent;
        --gradient-border: conic-gradient(from var(--border-angle), transparent 25%, #00FFB7 99%, transparent);
        background: var(--main-bg) padding-box, var(--gradient-border) border-box, var(--main-bg) border-box;
        background-position: center center;
        animation: bg-spin 3s linear infinite;
    }

    @@keyframes bg-spin {
        to {
            --border-angle: 1turn;
        }
    }

    @@property --border-angle {
        syntax: "<angle>";
        inherits: true;
        initial-value: 0turn;
    }
    
</style>

