<script>

    date = document.getElementById("StartDateE").value.replace(" ", "")
    valueD = new Date(date.slice(0, 10)).toLocaleDateString('fa-IR-u-nu-latn', { year: 'numeric', month: '2-digit', day: '2-digit' })
    valueD = valueD + " " + date.slice(10, 30)
    document.getElementById("StartDateE_Eq").value = valueD

    date = document.getElementById("EndDateE").value.replace(" ", "")
    valueD = new Date(date.slice(0, 10)).toLocaleDateString('fa-IR-u-nu-latn', { year: 'numeric', month: '2-digit', day: '2-digit' })
    valueD = valueD + " " + date.slice(10, 30)
    document.getElementById("EndDateE_Eq").value = valueD

    //-----------------------------------------------------------------
    var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
    for (var i = 0; i < inputs.length; i++) {
        inputs[i].addEventListener("jdp:change", function (e) {
            var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
            var date = this.value.replace(' ', '').slice(0, 10).split('/');
            date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]),)
            // If it was empty
            if (!this.value) {
                date = "";
            }
            // If it was only history
            else if (this.value.replace(' ', '').length < 11) {
                date = date.gy + '-' + date.gm + '-' + date.gd
            }
            // If it was the date and time
            else {
                date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30)
            }
            miladiInput.value = date
        });
    }
</script>

<script>
    $(document).ready(function () {
        document.getElementById('ColorTopE').addEventListener('change', function () {
            const pElementUp = document.getElementById("myOutUpE");
            pElementUp.style.color = this.value;
        });
        document.getElementById('ColorCenterE').addEventListener('change', function () {
            const pElementMi = document.getElementById("myOutMiE");
            pElementMi.style.color = this.value;
        });
        document.getElementById('ColorDownE').addEventListener('change', function () {
            const pElementDo = document.getElementById("myOutDoE");
            pElementDo.style.color = this.value;
        });
    });
</script>
<script>
