@using System.Globalization
@{
    // چک کردن مقدار تاریخ
    var gregorianDate = Model.Dtatime;
    string persianDate = "";
    string persianDate2 = "";

    if (gregorianDate.HasValue)
    {
        // ایجاد شی PersianCalendar
        PersianCalendar persianCalendar = new PersianCalendar();

        // تبدیل تاریخ میلادی به شمسی
        int year = persianCalendar.GetYear(gregorianDate.Value);
        int month = persianCalendar.GetMonth(gregorianDate.Value);
        int day = persianCalendar.GetDayOfMonth(gregorianDate.Value);

        persianDate = $"{year}/{month:D2}/{day:D2}";
        persianDate2 = gregorianDate.Value.ToString("yyyy/MM/dd");

    }
}

