    .DT:hover, .DT:hover .tooltipB, .DT:hover .tooltipB::before {
        color: #ffffff;
    }

    .tooltipB {
        position: absolute;
        top: 0;
        font-size: 14px;
        padding: 10px;
        border-radius: 100px;
        box-shadow: 0 10px 10px rgba(0, 0, 0, 0.1);
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        width: 152%;
        left: -102%;
        background: #000000 !important;
        color: #1dff9c !important;
        font-weight: bold;
        text-align: center;
        filter: drop-shadow(2px 4px 6px black);
        border: 2px solid #1ffc9b;
        width: 330%;
    }

    .titelT {
        position: absolute;
        top: 3%;
        right: 1%;
        background: radial-gradient(circle, rgb(1 39 109) 35%, rgb(0 52 153) 100%);
        font-size: 33px;
        font-weight: bold;
        padding: 10px 33px;
        border-radius: 100px;
    }


    @@media (min-width: 576px) {
        .DT:hover .tooltipB {
            font-size: 6px;
            border: 1.5px solid;
            padding: 7px 5px;
