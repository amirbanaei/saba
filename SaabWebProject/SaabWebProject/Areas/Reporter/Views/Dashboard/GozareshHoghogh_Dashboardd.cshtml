<script>

    $(document).ready(function () {

        $(".DT").on("click", function () {

            // دریافت عنوان گزارش از tooltip
            var reportTitle = $(this).find(".tooltipB").text().trim();
            var inputsContainer = $("#inputsT");

            // پاک کردن محتویات قبلی دایو inputsT
            inputsContainer.empty();

            // بررسی عنوان گزارش و ایجاد اینپوت‌های مناسب
            switch (reportTitle) {
                case "فیش حقوقی":
                   inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">ماه</label>
                            <select class="form-select my_Select" id="Month">
                            <option value="0">انتخاب مورد</option>
                            <option value="1">فروردین</option>
                            <option value="2">اردیبهشت</option>
                            <option value="3">خرداد</option>
                            <option value="4">تیر</option>
                            <option value="5">مرداد</option>
                            <option value="6">شهریور</option>
                            <option value="7">مهر</option>
                            <option value="8">آبان</option>
                            <option value="9">آذر</option>
                            <option value="10">دی</option>
                            <option value="11">بهمن</option>
                            <option value="12">اسفند</option>
                        </select>
                        </div>
                    `);
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">سال</label>
                              <select class="form-select" id="Year">
                                <option value="0">انتخاب کنید</option>

                                @{
                                    System.Globalization.PersianCalendar cs2 = new System.Globalization.PersianCalendar();
                                    int currentYear = cs2.GetYear(DateTime.Now);

                                    for (var i = 4; i >= 0; i--)
                                    {
                                        var s = DateTime.Now.AddYears(-i);

                                        <option value="@cs2.GetYear(s)">@cs2.GetYear(s)</option>
                                    }
                                }
                            </select>
                        </div>
                    `);
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">کاربر حقیقی</label>
                            <span id="users"></span>
                        </div>
                    `);

                    break;
                case "لیست مالیات حقوقی":
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">ماه</label>
                            <input type="text" class="form-control" placeholder="شماره سند" />
                        </div>
                    `);
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">سال</label>
                            <input type="text" class="form-control" />
                        </div>
                    `);
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">پیمان</label>
                            <input type="text" class="form-control"  />
                        </div>
                    `);
                    break;
                case "لیست تامین اجتماعی":
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">ماه</label>
                            <input type="text" class="form-control" placeholder="شماره سند" />
                        </div>
                    `);
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">سال</label>
                            <input type="text" class="form-control" />
                        </div>
                    `);
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">پیمان</label>
                            <input type="text" class="form-control"  />
                        </div>
                    `);
                    break;
                case "لیست بانک":
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">ماه</label>
                            <input type="text" class="form-control" placeholder="شماره سند" />
                        </div>
                    `);
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">سال</label>
                            <input type="text" class="form-control" />
                        </div>
                    `);
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">پیمان</label>
                            <input type="text" class="form-control"  />
                        </div>
                    `);
                    break;
                case "لیست هایلو":
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">ماه</label>
                            <input type="text" class="form-control" placeholder="شماره سند" />
                        </div>
                    `);
                    inputsContainer.append(`
                        <div class="col-xl-6 col-md-6 col-sm-6 col-6">
                            <label class="form-label">سال</label>
                            <input type="text" class="form-control" />
                        </div>
                    `);

                    break;
                default:
                    $(document).ready(function () {
                        // رویداد کلیک برای دکمه‌ها با کلاس DT
                        $(".Disable").on("click", function () {
                            const Toast = Swal.mixin({
                                toast: true,
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true,
                                didOpen: (toast) => {
                                    toast.addEventListener('mouseenter', Swal.stopTimer)
                                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                                }
                            });
                            // استفاده از SweetAlert2
                            //Swal.fire({
                            //    title: "اخطار!",
                            //    text: "دسترسی به این گزارش مقدور نمی‌باشد. لطفا با مدیر سامانه تماس بگیرید.",
                            //    icon: "warning", // آیکون به warning تغییر داده شد
                            //    confirmButtonText: "باشه",
                            //    confirmButtonColor: "#f27474", // رنگ دکمه مناسب اخطار
                            //});
                            Toast.fire({
                                icon: 'warning',
                                background: '#35434A',
                                color: 'white',
                                title: "دسترسی به این گزارش مقدور نمی‌باشد. لطفا با مدیر سامانه تماس بگیرید."
                            });
                        });
                    });
            }
        });

    document.addEventListener('DOMContentLoaded', function () {
      $("#users").load('@Url.Content("/Users/Users/_GetAllUsers_Select")',function(){
          $('#select_users').attr("id","UserID");

        });
    });



    });

</script>
