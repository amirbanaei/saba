@model SaabWebProject.Models.DomainModels.tbUnitParameter

<div class="row">
    @using (Html.BeginForm("_EditVahed", "Moalefe", FormMethod.Post))
    {
        <input type="hidden" value="@Model.unt_ID" name="unt_ID" />
        <div class="col-md-12">
            <label class="form-label">واحد</label>
            <input class="form-control" type="text" name="unt_Name" value="@Model.unt_Name" placeholder="عنوان واحد را وارد کنید ..." />
        </div>
        <hr />
        <div class="row">
            <div class="col-xl-11"></div>
            <div class="col-xl-1">
                <button type="submit" class="btn form-control buttonsabt">
                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                    <span class="bSabt-text">ثبت</span>
                </button>
            </div>
        </div>
    }
</div>
