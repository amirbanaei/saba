      function DownloadExcel() {









          $.ajax({
              beforeSend: function () {
                  document.getElementById("loading-circle").style.display = "block";
              },
              @*url: '@Url.Action("ExportMoalefeExcel4", "Moalefe", new { area = "Salaries" })',*@
              type: 'GET',
              dataType: 'html',


              success: function (res) {
                  document.getElementById("loading-circle").style.display = "none";
            window.location = '@Url.Action("ExportMoalefeExcel4", "Moalefe", new { area = "Salaries" })';
              },
              error: function (res) {
                  alart("fdslsfdk")
                  console.log(res);
              }
          });
      }




  var Toast = Swal.mixin({
      toast: true,
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true,
      didOpen: (toast) => {
          toast.addEventListener('mouseenter', Swal.stopTimer)
          toast.addEventListener('mouseleave', Swal.resumeTimer)
      }
  });
         $("input[name='MyExcelStream']").change(function () {
       var file = this.files[0];
       var ext = file.name.split('.')[1];
       if (ext == "xlsx" || ext == "xls") {

           var  obj = new FormData();

           obj.append("MyExcelStream", file);

           console.log(file);
           $.ajax({
           beforeSend:function (){
                   document.getElementById("loading-circle").style.display = "block";
           },
                url: "@Url.Action("ImportExcel_AddFish", "Admin", new { area = "Setting" })",
              type: "post",
              contentType: false,
              data: obj,
              processData: false,
              cache: false,
              success: function (res) {
                  document.getElementById("loading-circle").style.display = "none";
                  Swal.fire({
                      icon: 'success',
                      background: 'rgb(29,40,52)',
                      color: 'white',
                      confirmButtonText: 'باشه',
                      title: 'آپلود اکسل',
                      text: res,
                  });

              },
              error: function (res) {
                  console.log(res);
              }
          });
       }
       else {

           Swal.fire({
               icon: 'warning',
               background: 'rgb(29,40,52)',
               color: 'white',
               confirmButtonText: 'باشه',
               title: 'نوع فایل',
               text: 'لطفا فایلی با پسوند اکسل وارد کنید',
           });
           return false;
       }

   });
   /// Open Dialog File
   function ShowDialogFile() {
       $("input[name='MyExcelStream']").val(null);
       $("input[name='MyExcelStream']").click();
   }






    function ControllyPanel() {
        //console.log($('#select_moalefe').val())
        //console.log($("#ControllyMoalefe1").val())
        var arguments = {}
        arguments.moalefe = $('#select_moalefe').val()
        arguments.CotrollyMoalefe = $("#ControllyMoalefe1").val()

        $.ajax({
            type: "Post",
            url: '/MoalefeDastMozdi/PanelControlly_Submit',
            dataType: 'text',
            contentType: 'application/json',
            traditional: true,
            data: JSON.stringify(arguments),
            success: function (data) {
                $("#Error").html(data);
                console.log($("#Error"))
                if (data == "1") {
                    alert('اطلاعات ثبت شد')
                    window.location.reload();
                }
            },
            error: (error) => {
                console.log(error);
            }
        });
    }
    function PeymanControlly() {
        var arguments2 = {}
        arguments2.peyman = $('#select_Peymans').val()
        arguments2.CotrollyMoalefe = $("#ControllyMoalefe2").val()

        $.ajax({
            type: "Post",
            url: '/MoalefeDastMozdi/PeymanControlly_Submit',
            dataType: 'text',
            contentType: 'application/json',
            traditional: true,
            data: JSON.stringify(arguments2),
            success: function (data) {
                $("#Error").html(data);
                console.log($("#Error"))
                if (data == "1") {
                    alert('اطلاعات ثبت شد')
                    window.location.reload();
                }
            },
            error: (error) => {
                console.log(error);
            }
        });
    }

</script>

<script>

    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
    $("#SabtVahed").click(function () {

        var res = "@TempData["response"]";

    if (res == "True"){
        document.getElementById("loading-circle").style.display = "none";
        Toast.fire({
             icon: 'success',
             background: '#35434A',
             color: 'white',
             title: "اطلاعات با موفقیت ذخیره شد"
         });
    }
    if (res == "False"){
        document.getElementById("loading-circle").style.display = "none";
            Toast.fire({
                 icon: 'warning',
                 background: '#35434A',
                 color: 'white',
                 title: "اطلاعات ذخیره نشد"
            });

        }
        if (res == "NULL") {
            document.getElementById("loading-circle").style.display = "none";
            Toast.fire({
                icon: 'warning',
                background: '#35434A',
                color: 'white',
                title: " فیلد را پر کنید"
            });
        }
        })

</script>

