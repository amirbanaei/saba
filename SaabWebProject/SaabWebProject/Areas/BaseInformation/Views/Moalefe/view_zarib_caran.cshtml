<script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Scripts/popper.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>
<script>
    $(document).ready(function () {
        $("#selecthazfpymn").picker({ search: true });
        $("#citys").picker({ search: true });

    });
    $(document).ready(function () {
        $('#btnhazf').click(function () {
            var codPersonal = $('#numbersoart').val();
            //var year = $('#year_Eq111').val();
            var citys = $('#citys').val();
            var valuemoadel = $('#selecthazfpymn').val();

            //if (year == "0" || month == "0") {
            //    alert('لطفاً همه فیلدها را انتخاب کنید.');
            //    return;
            //}

            var url = `/BaseInformation/Moalefe/create_sabt?citys=${citys}&codPersonal=${codPersonal}&value=${valuemoadel}`;

            $.ajax({
                type: 'GET',
                url: url,
                success: function (response) {
                    if (response === "TRue") {
                        alert('عملیات موفق بود.');
                    } else {
                        alert('پاسخ: ' + response);
                    }
                },
                error: function (xhr, status, error) {
                    alert('خطا در انجام درخواست.');
                }
            });
        });
    });
</script>