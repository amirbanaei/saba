}
<div class="row">
    <div class="col-xl-2">
        <div class="row">
            <div class="col-xl-12">
                <label class="form-label">
                    ضریب بدهی

                </label>

            </div>
            <div class="col-xl-12">
                <input class="form-control" id="numbersoart" value="0" />
            </div>
        </div>

    </div>
    <div class="col-xl-4">
        <label class="form-label">نام مولفه </label>

        <select class="form-select select_peymanhazf" id="selecthazfpymn" name="selecthazf">
            <option hidden value="Select">انتخاب مورد</option>
            @foreach (var item in db.tbContractMoalefeDastmozdi.ToList())
            {
                <option value="@item.md_ID"> @item.md_Title</option>
            }
        </select>

    </div>
    <div class="col-xl-4">
        <label class="form-label">نام شهرستان  </label>

        <select class="form-select select_peymanhazf" id="citys" name="selecthazf">
            <option hidden value="Select">انتخاب مورد</option>
            @foreach (var item in db.tbCities.ToList())
            {
                <option value="@item.ID"> @item.Name</option>


            }
        </select>

    </div>
