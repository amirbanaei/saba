<script type="text/javascript">
    jalaliDatepicker.startWatch({
        time: true,
        days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
        persianDigits: true,
        autoClose: true,
        autocomplete: true,
        // showCloseBtn:true,
        showEmptyBtn: false,
        showCloseBtn: true,
        zIndex: 100000,
    });
    var valueD
    var date

    // convert miladi to jalali
    date = document.getElementById("datepickerFromEn_Eq").value.replace(" ", "")
    valueD = new Date(date.slice(0, 10)).toLocaleDateString('fa-IR-u-nu-latn', { year: 'numeric', month: '2-digit', day: '2-digit' })
    valueD = valueD + " " + date.slice(10, 30)
    document.getElementById("datepickerFrom_Eq").value = valueD

    date = document.getElementById("datepickerToEn_Eq").value.replace(" ", "")
    valueD = new Date(date.slice(0, 10)).toLocaleDateString('fa-IR-u-nu-latn', { year: 'numeric', month: '2-digit', day: '2-digit' })
    valueD = valueD + " " + date.slice(10, 30)
    document.getElementById("datepickerTo_Eq").value = valueD


    var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
    for (var i = 0; i < inputs.length; i++) {
        inputs[i].addEventListener("jdp:change", function (e) {
            var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
            var date = this.value.replace(' ', '').slice(0, 10).split('/');
            date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]),)
            // If it was empty
            if (!this.value) {
                date = "";
            }
            // If it was only history
            else if (this.value.replace(' ', '').length < 11) {
                date = date.gy + '-' + date.gm + '-' + date.gd
            }
            // If it was the date and time
            else {
                date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30)
            }
            miladiInput.value = date
        });
    }
</script>
