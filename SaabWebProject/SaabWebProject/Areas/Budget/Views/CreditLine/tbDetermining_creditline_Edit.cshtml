</script>


<script>
        $("#btnCreate12").click(function () {
                     var Filters  = [];
            if ($("#bestankar").val() == 0) {
                alert("لطفا عنوان را انتخاب نمائید");
            }
            if (($("#creditline").val() == 0))
                 {
                alert("لطفا عنوان را وارد  نمائید");
            }
               if (($("#select_peyman1").val() == null))
                 {
                alert("لطفا پیمان را انتخاب نمائید");
               }

              if (($("#datepickerFrom_Eq").val() == 0))
                 {
                alert("لطفا تاریخ  را انتخاب نمائید");
            }
              else {

                  var obj = new Object();
                  obj.Pyman_ID = $("#select_peyman1").val();

                  obj.FK_creditline = $("#creditline").val();
                  var creditorCreditValue = $("#bestankar").val();
                  var resultString2 = creditorCreditValue.replace(/,/g, '');
                  var debtorCreditValue = $("#bedehkar").val();
                  var resultString = debtorCreditValue.replace(/,/g, '');

                  obj.Creditorcredit = resultString2;
                  obj.Debtorcredit = resultString;
                  obj.Starttime = $("#datepickerFromEn_Eq").val();
                  obj.Endtime = $("#datepickerToEn_Eq").val();
                  obj.Determining_creditline_ID = $("#idd").val();


                  Filters.push(obj);
                   console.log(Filters);
                  sendAjax('@Url.Action("tbDetermining_creditline_Edit2", "CreditLine",new { area = "Budget" })', Filters);
                  //location.reload();

                }
              ;

        });
        function sendAjax(url, data) {
                console.log(url);

                $.ajax({
                    beforeSend: function () {
                        document.getElementById("loading-message").style.display = "block";
                    },
                    url: url,
                    data: { Filters: data },
                    type: "POST",
                    dataType: "html",
                    success: function (resp) {
                        console.log(resp);
                        document.getElementById("loading-message").style.display = "none";
                        if (resp == "True") {
                            alert("با موفقیت ثبت شد");
                        } else {
                            alert("مبلغ های های بستانکارهای شما بیش از حد مجاز در قرار داد است");
                        }
                    },
                    error: function (resp) {
                        document.getElementById("loading-message").style.display = "none";
                        alert("دچار مشکل شده است ");
                        console.log(resp);
                    }
                });
            }
</script>
