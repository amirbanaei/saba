@model IEnumerable<SaabWebProject.Models.DomainModels.tbCreditIndicators>

@{


    var counter = 1;
    foreach (var item in Model)
    {
        <tr style="text-align:center;">
            <td>
                <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                    <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                        <i class="fa fa-edit"></i>
                    </a>
                    <div class="dropdown-menu">
                        <a data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item edit2" id="Edit_@item.ID">ویرایش</a>
                        <a data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item Details"id="Edit_@item.ID">جزئیات</a>
                        <a class="dropdown-item Delete" id="Delete_@item.ID">حذف</a>


                    </div>
                </div>
            </td>
            <td> <span>@counter</span></td>
            <td>@item.Title</td>
            <td>@item.Description</td>
        </tr>
        counter++;
    }


}


