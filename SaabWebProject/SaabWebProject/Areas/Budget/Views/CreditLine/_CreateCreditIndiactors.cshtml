@{
    Layout = null;
}


<div class="row">
    <div class="col-xl-3">
        <label class="form-label"> عنوان  </label>
        <input class="form-control" id="Title" />
    </div>
    <div class="col-xl-9">
        <label class="form-label"> شرح  </label>
        <input class="form-control" id="Description" />
    </div>
</div>
<div class="col-md-12">
    <p class="text-danger" id="paragraph"></p>
</div>
<div class="row">
    <div class="col-xl-11"></div>
    <div class="col-xl-1" >
        <button class="btn form-control buttonsabt" id="SubmitRadifEtebari">
            <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
            <span class="bSabt-text">ثبت</span>
        </button>
    </div>
</div>

<div id="eee" class="mt-10px">

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        $("#Description").keydown(function (e) {
            $("#paragraph").text("در حال تایپ ....");
        });

        $("#Description").keyup(function (e) {
        
            setInterval(function () {
                $("#paragraph").text("");
            }, 3000);
        });
    });


</script>
<script>
    $(document).ready(function () {
        $("#Title").keydown(function (e) {
            $("#paragraph").text("در حال تایپ ....");
        });

        $("#Title").keyup(function (e) {

            setInterval(function () {
                $("#paragraph").text("");
            }, 1000);
        });
    });
</script>
<script>
        $("#eee").load('@Url.Content("/Budget/CreditLine/_ListAllCreateCreditIndicators")');
</script>
