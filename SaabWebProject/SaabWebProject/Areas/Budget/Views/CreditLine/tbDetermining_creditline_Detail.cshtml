@{
    ViewBag.Title = "جزئیات";
    Layout = null;
}
<link href="~/MyStyles/buttonstyle.css" rel="stylesheet" />
@model IEnumerable<SaabWebProject.Models.DomainModels.tbDetermining_creditline>
<link href="~/MyStyles/inputstyleandformstyle.css" rel="stylesheet" />

<style>
    .modal-lg, .modal-xl {
        margin-top: 8px !important;
        max-width: 80% !important;
    }
</style>
<style>


    .modal2 {
        display: none;
        position: absolute; /* Change this from fixed */
        z-index: 1000; /* Adjust z-index as needed */
        left: 0;
        top: 0;
        width: 65%;
        height: auto;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
    }

    .modal-content2 {
        background-color: black;
        position: relative; /* Add relative positioning */
        /*  margin: 15% auto;*/
        padding: 20px;
        border: 4px solid aqua;
        border-radius: 30px;
        width: 100%;
        max-height: 100%;
        overflow-y: auto;
    }

    .modal3 {
        display: none;
        position: absolute; /* Change this from fixed */
        z-index: 1000; /* Adjust z-index as needed */
        left: 0;
        top: 0;
        width: 65%;
        height: auto;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
    }

    .modal-content3 {
        background-color: black;
        position: relative; /* Add relative positioning */
        /*  margin: 15% auto;*/
        padding: 20px;
        border: 4px solid aqua;
        border-radius: 30px;
        width: 100%;
        max-height: 100%;
        overflow-y: auto;
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .fade-in {
        animation: fadeIn 1s ease-in-out; /* Adjust duration and timing function as needed */
    }
</style>
@{
    var isFirstItem = true;
    var istruu = true;
}
@foreach (var item in Model)
{
    if (isFirstItem)
    {
        <div class="row">
            <div class="col-xl-6">
                <div class="form-group mb-3">
                    <label class="form-label"> پیمان  </label>

                    <select class="form-select" id="select_peyman12">
                        <option value="@item.Pyman_ID">@item.tbPeymanContracts.pec_BriefTitle</option>
                    </select>
                </div>
            </div>
            <div class="col-xl-6"></div>
        </div>
        isFirstItem = false; // Set isFirstItem to false after the first iteration
    }




    <div class="row">

        <div class="col-xl-2">
            <div class="form-group mb-3">
                @*@if (istruu)
                    {*@
                <label class="form-label"> ردیف اعتباری  </label>

                <select class="form-select" id="creditline1">
                    <option value="@item.FK_creditline">@item.tbCreditIndicators.Title</option>
                </select>
            </div>
        </div>
        <div class="col-xl-2">
            @*@if (istruu)
                {*@
            <label class="form-label">  بستانکار (ریال)  </label>
            @*//}*@
            <input class="form-control bestankar-input" id="bestankar1" value="@item.Creditorcredit" />
        </div>

        <div class="col-xl-2">
            @*@if (istruu)
                {*@
            <label class="form-label">  بدهکار (ریال)  </label>
            @*//    istruu = false;
                //}*@
            <input class="form-control bedehkar-input" id="bedehkar1" value="@item.Debtorcredit" />
        </div>
        <div class="col-xl-1">
            <button class="click btn buttonGeneralPlus form-control "  id="click_@item.Determining_creditline_ID">
            <i class="fa fa-eye VecGeneral" style="font-size:1rem"></i>  </button>
        </div>
        <div class="col-xl-1">
            <button class="click2 btn buttonGeneralPlus form-control"  id="click_@item.Determining_creditline_ID">
            <i class="fa fa-pen VecGeneral" style="font-size:1rem"></i> </button>
        </div>
        <div class="col-xl-1">
            <button class="click3 btn buttonGeneralMins form-control"  id="click_@item.Determining_creditline_ID">
            <i class="fa fa-trash VecGeneral" style="font-size:1rem"></i></button>
        </div>
    </div>

}
<div id="myModal2" class="modal2" style="margin-left:25% !important;">
    <div class="modal-content2">
        <div class="row">
            <i class="close fa fa-window-close"></i>
        </div>
        <div id="ss">

        </div>


    </div>
</div>
<div id="myModal3" class="modal3" style="margin-left:25% !important;">
    <div class="modal-content3">
        <div class="row">
            <i class="close fa fa-window-close"></i>
        </div>

        <div id="ss2">

        </div>

    </div>
</div>

<script>
    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#myModal2").addClass("fade-in"); // Add the fade-in class
            $("#myModal2").css("display", "block");
        });

        $(".close").click(function () {
            $("#myModal2").removeClass("fade-in"); // Remove the fade-in class
            $("#myModal2").css("display", "none");
        });

        $(window).click(function (event) {
            if (event.target == $("#myModal2")[0]) {
                $("#myModal2").removeClass("fade-in"); // Remove the fade-in class
                $("#myModal2").css("display", "none");
            }
        });
    });</script>
<script>
    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#myModal3").addClass("fade-in"); // Add the fade-in class
            $("#myModal3").css("display", "block");
        });

        $(".close").click(function () {
            $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
            $("#myModal3").css("display", "none");
        });

        $(window).click(function (event) {
            if (event.target == $("#myModal3")[0]) {
                $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
                $("#myModal3").css("display", "none");
            }
        });
    });</script>
<script>
                $(".click3").click(function () {
        var idd = $(this).attr("id").split("_")[1];

     /*document.getElementById("loading-message").style.display = "block";*/





     Swal.fire({
         title: 'آیا از حدف مطمئن هستید؟',
         icon: 'question',
         showCancelButton: true,
         background: 'rgb(29,40,52)',
         color: 'white',
         confirmButtonColor: '#3085d6',
         cancelButtonColor: '#d33',
         confirmButtonText: 'بله ',
         cancelButtonText: 'خیر'
     }).then((result) => {

         if (result.isConfirmed == true) {
             $(".loader").css('display', 'block');
               $.ajax({
        url: '@Url.Action("DeleteEquipment", "CreditLine", new { area = "Budget" })',
        data: { ID: idd },
        type: "Post",
        dataType: "html",
        success: function (resp) {
            $("#loading-message").css("display", "none");
            if (resp == "True") {
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با موفقیت حذف شد"
                }).then(() => {
                    location.reload();
                });
            } else {
                Toast.fire({
                    icon: 'error',
                    background: '#35434A',
                    color: 'white',
                    title: "قادر به حذف  نیستید"
                }).then(() => {
                });
            }

        },
        error: function (resp2) {
            $("#loading-message").css("display", "none");
            Toast.fire({
                icon: 'error',
                background: '#35434A',
                color: 'white',
                title: "حذف  با خطا مواجه شده است "
            }).then(() => {
                location.reload();
            });
        }
    });
         }

     });







      });


</script>
<script>

    $(".click").click(function () {
        $("#myModal2").addClass("fade-in"); // Add the fade-in class
        $("#myModal2").css("display", "block");
        var idd = $(this).attr("id").split("_")[1];
        console.log(idd);
        $("#ss").load('@Url.Content("/Budget/CreditLine/detail_gharadad")?id='+idd);
    });




           $(".click2").click(function () {
        $("#myModal3").addClass("fade-in"); // Add the fade-in class
        $("#myModal3").css("display", "block");
        var idd = $(this).attr("id").split("_")[1];
        console.log(idd);
        $("#ss2").load('@Url.Content("/Budget/CreditLine/tbDetermining_creditline_Edit")?id='+idd);
       });
        $(document).ready(function () {
            var bestankarInput = $(".bestankar-input");

            bestankarInput.each(function () {
                var value = $(this).val();
                var formattedValue = formatNumber(value); // تابع formatNumber باید تعریف شود
                $(this).val(formattedValue);
            });
        });

        // تابع جدا کردن سه رقم سه رقم
        function formatNumber(number) {
            return number.replace(/\B(?=(\d{3})+(?!\d))/g, ",");

        }

</script>
<script>
    $(document).ready(function () {
        var bestankarInput = $(".bedehkar-input");

        bestankarInput.each(function () {
            var value = $(this).val();
            var formattedValue = formatNumber(value); // تابع formatNumber باید تعریف شود
            $(this).val(formattedValue);
        });
    });

    // تابع جدا کردن سه رقم سه رقم
    function formatNumber(number) {
        return number.replace(/\B(?=(\d{3})+(?!\d))/g, ",");

    }

</script>
