<script>
    $("#select_peyman1").picker({ search: true });
    var nodesLength = 0; // Declare outside the function to maintain its value
    function plusInputInstallmentManually(e) {
        var a = 1;
        nodesLength++;
        a++;


        $("#SectionInstallmentInputs").append(`
            <div id="row_${nodesLength}" class="row">
                <div class="col-md-12 col-xl-6">
                        <label class="form-label"> ردیف اعتباری </label>
                        <select class="form-select installmentAmountInputManually" id="creditline_${nodesLength}">
                            <option>انتخاب کنید</option>
                            @Html.Action("_ListAllCreditIndicatior", "CreditLine", new { area = "Budget" })
                        </select>
                </div>
                <div class="col-md-12 col-xl-2">
                    <label class="form-label">  بستانکار (ریال) </label>
                    <input class="form-control" oninput="formatCurrency(this)" id="bestankar_${nodesLength}" />
                </div>
                <div class="col-md-12 col-xl-2">
                    <label class="form-label">  بدهکار (ریال) </label>
                    <input class="form-control" oninput="formatCurrency(this)" id="bedehkar_${nodesLength}" />
                </div>
                <div class="col-xl-1"></div>
                <div class="col-xl-1">
                     <button type="button" class="btn buttonGeneralMins form-control"  onclick="removeRow('row_${nodesLength}')">
                        <i class="fa fa-multiply fa-fw me-1  VecGeneral"></i>
                     </button>
                </div>
            </div>
`);
        $(`#creditline_${nodesLength}`).picker({ search: true });


    }



















    $(".deleteBtn[data-row-id='" + nodesLength + "']").on("click", function () {
        var rowId = $(this).data("row-id");
        nodesLength--;
        // Remove the entire row with the corresponding ID
        $("#row_" + rowId).remove();
    });


    function removeRow(rowId) {
        // Find the row element with the given ID
        var row = document.getElementById(rowId);

        // Check if the row exists
        if (row) {
            // Remove the row
            row.remove();
            nodesLength--;
        } else {
            console.error("Row with ID " + rowId + " does not exist.");
        }
    }


    $().on('hidden.bs.modal', function () {
        $(this).find('form')[0].reset();
        location.reload();
    });
</script>

