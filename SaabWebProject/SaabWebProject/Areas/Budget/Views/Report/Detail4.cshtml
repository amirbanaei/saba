@{ Layout = null; }
@using SaabWebProject.Models.DomainModels;

@{
    ViewBag.TitleLargModal = "اضافه کردن مشتری";
    SaabEntities db = new SaabEntities();

}
@model IEnumerable<SaabWebProject.Models.DomainModels.tbDetermining_creditline>
<div class="card">
    <div class="tab-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("#")
                            </th>
                            <th>
                                @Html.DisplayName("پیمان")
                            </th>
                            <th>
                                @Html.DisplayName("ردیف")
                            </th>
                            <th>
                                @Html.DisplayName("اعتبار")
                            </th>
                            <th>
                                @Html.DisplayName("کسورات")
                            </th>
                            <th>
                                @Html.DisplayName("تاریخ")
                            </th>
                            <th>
                                @Html.DisplayName("مانده")
                            </th>
                        </tr>
                    </thead>
                    <tbody style="text-align:center">
                        @{
                            var i = 0;
                        }

                        @foreach (var it in Model)
                        {
                            var y = true;
                            var i3 = 0;
                            var ttt = it.Creditorcredit;

                            var tyy = db.FinancialDocuments.Where(p => p.Peyman_ID == it.Pyman_ID && p.Creditlamdicatros_ID == it.FK_creditline).ToList();

                            for (var i2 = 0; i2 < tyy.Count() + 1; i2++)
                            {
                                i++; i3++;
                                <tr>
                                    <td>
                                        @i
                                    </td>
                                    <td>
                                        @it.tbPeymanContracts.pec_Title
                                    </td>
                                    <td>
                                        @it.tbCreditIndicators.Title
                                    </td>

                                    @if (i3 == 1)
                                    {
                                        <td>@string.Format("{0:N0}", it.Creditorcredit)</td>
                                    }
                                    else
                                    {
                                        <td>----</td>
                                    }

                                    @if (i3 != 1)
                                    {
                                        <td>@string.Format("{0:N0}", tyy[i2 - 1].Creditor)</td>
                                        ttt -= (int)tyy[i2 - 1].Creditor;
                                    }
                                    else
                                    {
                                        <td>----</td>
                                    }
                                    @if (i3 != 1)
                                    {
                                        @*<td>@tyy[i2 - 1].DataDocument</td>*@
                                        <td cont-date="dateS_@i2-1" hidden>@tyy[i2 - 1].DataDocument.ToString("MM/dd/yyyy ")</td>
                                        <td id="dateS_@i2-1"></td>
                                    }
                                    else
                                    {
                                        <td>----</td>
                                    }

                                    @if (i3 != 1)
                                    {
                                        <td>@string.Format("{0:N0}", ttt)</td>
                                    }
                                    else
                                    {
                                        <td>----</td>
                                    }


                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
    


@*<label class="form-label">مانده </label>
    <input value="@Model.lesssum" />*@
        </div>
    </div>




<div class="card-arrow">
    <div class="card-arrow-top-left"></div>
    <div class="card-arrow-top-right"></div>
    <div class="card-arrow-bottom-left"></div>
    <div class="card-arrow-bottom-right"></div>
</div>
</div>
<script>
    // Convert Gregorian date to jaali in the table
    var tds = document.querySelectorAll("[cont-date]");
    var valueD, id, target;
    var options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    tds.forEach(td => {
        valueD = new Date(td.textContent).toLocaleDateString('fa-IR-u-nu-latn', options).replace(',', '').replace(" ", "");
        valueD = valueD.slice(0, 10) + " " + td.textContent.slice(10, 30)
        id = td.getAttribute("cont-date");
        target = document.getElementById(id);
        target.textContent = valueD;
    });
</script>