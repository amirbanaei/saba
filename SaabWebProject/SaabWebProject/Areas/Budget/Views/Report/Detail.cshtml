@{ Layout = null; }

@model SaabWebProject.Models.ViewModels.Budget.Reporter.Reportradif

<div class="card">
    <div class="tab-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("#")
                            </th>
                            <th>
                                @Html.DisplayName("اعتبار")
                            </th>
                            <th>
                                @Html.DisplayName("کسورات")
                            </th>
                            <th>
                                @Html.DisplayName("تاریخ")
                            </th>
                        </tr>
                    </thead>
                    <tbody style="text-align:center">

                        @if (Model != null && Model.creator.Count > 0 && Model.less.Count > 0 && Model.time.Count > 0)
                        {
                            var rowCount = Model.time.Count; // Assuming all lists have the same count

                            for (var i = 0; i < rowCount+1; i++)
                            {
                                <tr>
                                    <td>
                                        @i
                                    </td>


                                    @if (i == 0)
                                    {
                                        <td>
                                            @string.Format("{0:N0}",Model.creator[i])
                                        </td>
                                    }
                                    else
                                    {
                                        <td>... </td>
                                    }



                                    @if (i == 0)
                                    {
                                        <td>... </td>

                                    }
                                    else
                                    {
                                <td>@string.Format("{0:N0}",Model.less[i - 1]) </td>

                                    }



                                    @if (i == 0)
                                    {
                                        <td>... </td>
                                    }
                                    else
                                    {


                                        <td cont-date="dateS_@i" hidden>@Model.time[i - 1].ToString("MM/dd/yyyy ")</td>
                                        <td id="dateS_@i"></td>

                                      

                                    }

                                </tr>
                            }
                        }

                    </tbody>
                </table>
            </div>

            <label class="form-label">مانده </label>
            <input class="form-control"style="width:30%" value="@string.Format("{0:N0}",Model.lesssum)" />
        </div>
    </div>




<div class="card-arrow">
    <div class="card-arrow-top-left"></div>
    <div class="card-arrow-top-right"></div>
    <div class="card-arrow-bottom-left"></div>
    <div class="card-arrow-bottom-right"></div>
</div>
</div>
<script>
    // Convert Gregorian date to jaali in the table
    var tds = document.querySelectorAll("[cont-date]");
    var valueD, id, target;
    var options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    tds.forEach(td => {
        valueD = new Date(td.textContent).toLocaleDateString('fa-IR-u-nu-latn', options).replace(',', '').replace(" ", "");
        valueD = valueD.slice(0, 10) + " " + td.textContent.slice(10, 30)
        id = td.getAttribute("cont-date");
        target = document.getElementById(id);
        target.textContent = valueD;
    });
</script>
