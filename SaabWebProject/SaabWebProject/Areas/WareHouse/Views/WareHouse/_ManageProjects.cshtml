@model SaabWebProject.Models.DomainModels.tbCommodityProject

<div class="card mt-3" style="width: 100%">
    <div class="tab-content p-2 pt-4">
        <div class="row">
            <div class="col-lg-4">
                <div class="form-group mb-3">
                    <label class="form-label"> کد پروژه </label>
                    <input class="form-control" id="ProjectCodeE" name="ProjectCode" value="@Model.ProjectCode" />
                </div>
            </div>
            <div class="col-lg-3">
                <div class="form-group mb-3">
                    <label class="form-label"> مبلغ کل  </label>
                    <input class="form-control" id="Totalnumber1" value="@Model.Totalnumber" />
                </div>
            </div>
            <div class="col-lg-5">
                <div class="form-group mb-3">
                    <label class="form-label"> نام پروژه</label>
                    <input class="form-control" id="ProjectTitleE" name="ProjectTitle" value="@Model.ProjectTitle" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6">
                <div class="form-group mb-3">
                    <div class="form-group mb-3" id="SectionCityEdit">
                        <label class="form-label"> شهرستان /امور </label>
                        <div id="sectionCities"></div>
                        @Html.Action("_Cities_Select", "Users", new { area = "Users" })
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="form-group mb-3">
                    <label class="form-label"> تاریخ تعریف پروژه کالایی </label>
                    <div class="col-xl-12">
                        <input class="form-control" id="datepickerFrom_EqEdit" />
                        <input class="form-control" type="hidden" id="datepickerFromEn_EqEdit" value="@Model.DateOfDefinitionCommodityProject" />
                    </div>
                    @*<input class="form-control" />*@
                </div>
            </div>

        </div>


        <div class="">
            <div class="form-group mb-3">
                @*<label class="form-label"> نام پیمان</label>
                    @Html.Action("_GetPeymanContractsSelectEdit", "WareHouse", new { area = "WareHouse", id = Model.ProjectCode })*@
                <label class="form-label">  پیمان </label>
                <div id="sectionPeymanEdit"></div>
            </div>
        </div>
    </div>
</div>

<input class="d-none" value="@Model.ProjectCode" id="ProjectCode1" />
<div class="row mt-4">
    <div class="col-xl-10"></div>
    <div class="col-xl-1">
        <button type="button" class="btn form-control buttonsabt" id="btnCreate2">
            <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
            <span class="bSabt-text">ثبت</span>
        </button>
    </div>
    <div class="col-xl-1">
        <button class="btn form-control uploadSummery1 buttonGeneral" >
            <i class="bi bi-upload fa-fw me-1 VecGeneral"></i>
            <span class="bGeneral-text">بارگذاری پیوست</span>
        </button>
        <input id="summery_file1" style="display:none" type="file" class="form-control" value="" />
    </div>
</div>
@if (Model.File_RealName!=null)
{
<input style="display:none"id="Fill" value="@Model.File_SystemName"/>
