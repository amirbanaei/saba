<script>

        function EnableProject(e) {
            var argumentEnableProject = {}
            argumentEnableProject.id = e.id;
            $.ajax({
                type: "Post",
                url: "@Url.Action("EnableProject","WareHouse")",
                dataType: 'text',
                contentType: 'application/json',
                traditional: true,
                data: JSON.stringify(argumentEnableProject),
                success: function (data) {
                    window.location.reload();
                },
                error: function () {
                    alert(-1)
                }
            });
        }
        function DisableProject(e) {
            var argumentDisableProject = {}
            argumentDisableProject.id = e.id;
            $.ajax({
                type: "Post",
                url: "@Url.Action("DisableProject","WareHouse")",
                dataType: 'text',
                contentType: 'application/json',
                traditional: true,
                data: JSON.stringify(argumentDisableProject),
                success: function (data) {
                    window.location.reload();
                },
                error: function () {
                    alert(-1)
                }
            });
        }
</script>
