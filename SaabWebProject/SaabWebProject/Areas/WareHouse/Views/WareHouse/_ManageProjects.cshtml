<script>
    function SubmitProjectEdit() {

        var dataO = {
            ProjectCode: $("#ProjectCodeE").val(),
            ProjectTitle: $("#ProjectTitleE").val(),
            FK_PeymanContracts: $("#select_peymanEdit").val(),
            City_Id: $("#citiesEdit").val(),
            DateOfDefinitionCommodityProject: $("#DateOfDefinitionCommodityProjectE").val(),
            FK_PeymanContracts: $("#select_peymanEdit").val(),
            ProjectCode1: $("#ProjectCode1").val()
        };
        var json = JSON.stringify(dataO);
        $.ajax({
            type: "POST",
            url: "/WareHouse/WareHouse/_ManageProjects",
            data: json,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (msg) {
                alert('In Ajax');
            }
        });
    }
</script>

@* DatePicker *@
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>

<script>
    $(function () {
  
        $('#datepickerFrom_EqEdit').MdPersianDateTimePicker({
            targetTextSelector: '#datepickerFrom_EqEdit',
            targetDateSelector: '#datepickerFromEn_EqEdit',
            dateFormat: 'yyyy-MM-dd',
            isGregorian: false,
            enableTimePicker: true,
            disableBeforeToday: false
        });

        $('#datepickerTo_EqEdit').MdPersianDateTimePicker({
            targetTextSelector: '#datepickerTo_EqEdit',
            targetDateSelector: '#datepickerToEn_EqEdit',
            dateFormat: 'yyyy-MM-dd',
            isGregorian: false,
            enableTimePicker: true,
            disableBeforeToday: false
        });

    });

</script>



<script>



    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
    var fd = new FormData();
    function sendAjax2(url2, fd2) {



        fd2.append("FK_PeymanContracts", $("#select_moalefePeymanEdit").val());

        fd2.append("ProjectCode", $("#ProjectCodeE").val());
        fd2.append("City_Id", $("#citiesEdit").val());
        fd2.append("DateOfDefinitionCommodityProject", $("#datepickerFromEn_EqEdit").val());
        fd2.append("ProjectTitle", $("#ProjectTitleE").val());


        fd2.append("Totalnumber", $("#Totalnumber1").val());
         fd2.append("Id", $("#iddd").val());
        fd2.append("File_SystemName", $("#Fill").val());
            fd2.append("File_RealName", $("#Fillll").val());

        console.log(fd2);

        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                console.log("okeye");
                console.log(resp1);
                $("#loading-message").css("display", "none");
                fd = new FormData();
                if (resp1 == "True") {
                    alert("با موفقیت ثبت شد");
                    location.reload();
                }
                else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });


                }

            },
            error: function (resp1) {
                console.log(resp1);
                console.log("Nokeye");
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });
    }
</script>


