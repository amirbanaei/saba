@{ Layout = null;}
@model IEnumerable<SaabWebProject.Models.DomainModels.tbsaveSoratBasteh>
<div class="card">
    <div class="table-content p-4" id="TaedKarkardKarbaran">
        <div class="row">
            <div class="col-xl-12">
                <div class="form-group mb-12">
                    <div class="table-responsive">
                        <table class="table table-hover text-nowrap">
                            <thead>
                                <tr style="text-align:center;margin:auto">
                                    <th>
                                        @Html.DisplayName("عملیات")
                                    </th>
                                    <th>
                                        @Html.DisplayName("ردیف")
                                    </th>
                                    <th>
                                        @Html.DisplayName("پیمان")
                                    </th>
                                    <th>
                                        @Html.DisplayName("بسته")
                                    </th>
                                    <th>
                                        @Html.DisplayName("ماه")
                                    </th>
                                    <th>
                                        @Html.DisplayName("سال")
                                    </th>
                                    <th>
                                        @Html.DisplayName(" کاربر")
                                    </th>
                                    <th>
                                        @Html.DisplayName(" نقش بارگزاری کننده ")
                                    </th>

                                </tr>

                            </thead>
                            <tbody>
                                @{ int cont = 0;}
                                @foreach (var item in Model.Where(s=>s.tbSoratSavefromExcelMoalfe.Any(t=>t.Month!=null)).ToList())
                                {
                                    cont++;

                                    <tr style="text-align:center;">
                                        <td>
                                            <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                                <a href="#" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <div class="dropdown-menu">
                                                    <a style="cursor:pointer" data-bs-toggle="modal" data-bs-target="#modalLg" class="dropdown-item showFunctionSorat" id="showFunction_@item.ID">
                                                        مشاهده
                                                    </a>
                                                </div>

                                            </div>
                                        </td>


                                        <td>@cont</td>
                                        <td>@item.tbPeymanContracts.pec_Title</td>
                                        <td>@item.tbReffrenceSaveLevel.Title</td>
                                        <td>
                                            @{
                                                var monthNumber = item.tbSoratSavefromExcelMoalfe.FirstOrDefault().Month;
                                                string monthName;

                                                switch (monthNumber)
                                                {
                                                    case 1:
                                                        monthName = "فروردین";
                                                        break;
                                                    case 2:
                                                        monthName = "اردیبهشت";
                                                        break;
                                                    case 3:
                                                        monthName = "خرداد";
                                                        break;
                                                    case 4:
                                                        monthName = "تیر";
                                                        break;
                                                    case 5:
                                                        monthName = "مرداد";
                                                        break;
                                                    case 6:
                                                        monthName = "شهریور";
                                                        break;
                                                    case 7:
                                                        monthName = "مهر";
                                                        break;
                                                    case 8:
                                                        monthName = "آبان";
                                                        break;
                                                    case 9:
                                                        monthName = "آذر";
                                                        break;
                                                    case 10:
                                                        monthName = "دی";
                                                        break;
                                                    case 11:
                                                        monthName = "بهمن";
                                                        break;
                                                    case 12:
                                                        monthName = "اسفند";
                                                        break;
                                                    default:
                                                        monthName = "نامشخص";
                                                        break;
                                                }
                                            }
                                            @monthName
                                        </td>


                                        <td>@item.tbSoratSavefromExcelMoalfe.FirstOrDefault().Year</td>



                                        <td>@item.tbUsers.FullName</td>
                                        @if (item.Final_Accept == true)
                                        {

                                            <td>تایید کننده نهایی</td>
                                        }
                                        else if (item.For_Accept == true)
                                        {
                                            <td>تایید کننده </td>

                                        }
                                        else
                                        {
                                            <td>ثبت کننده </td>

                                        }


                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
    @*<div class="modal fade" id="modalLg">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-body" id="ModalFunction">

                    </div>
                </div>
            </div>
        </div>*@
