
@{
    ViewBag.Title = "افزودن کالا ها";
    Layout = null;
}

<div class="mb-5">
    <div class="card">
        <div class="card-body pb-2">
            <div class="row">
                <div class="col-xl-3">
                    <div class="form-group mb-3">
                        <label class="form-label"> پیمان </label>
                        @Html.Action("_GetAllListPeymans_SingleSelect", "Peyman", new { area = "Contracts" })

                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group mb-3">
                        <label class="form-label"> کدپروژه </label>
                        <input class="form-control" id="ProjectCode" />
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group mb-3">
                        <label class="form-label"> شهرستان /امور </label>
                        @Html.Action("_Cities_Select", "Users", new { area = "Users" })
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group mb-3">
                        <label class="form-label"> تاریخ تعریف پروژه کالایی </label>
                        <div class="col-xl-12">
                            <input class="form-control" id="datepickerFrom_Eq" />
                            <input class="form-control" type="hidden" id="datepickerFromEn_Eq" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xl-3">
                    <div class="form-group mb-3">
                        <label class="form-label"> مبلغ کل  </label>
                        <input class="form-control" id="Totalnumber" />
                    </div>
                </div>
                <div class="col-xl-9">
                    <label class="form-label"> عنوان پروژه  </label>
                    <input class="form-control" id="ProjectTitle" />
                </div>


            </div>



            <div class="row" style="margin-top:20px">
                <style>
                    .cssss:before {
                        content: '';
                        position: absolute;
                        top: 0;
                        right: 0;
                        bottom: 0;
                        left: 0;
                        z-index: -1;
                        margin: -2px;
                        border-radius: inherit;
                        background: linear-gradient(to bottom, #7bf1f5, #2559ad);
                    }
                </style>
                <div class="col-xl-5"></div>

                <div class="col-xl-2">

                    <button class="btn btn-outline-theme buttonsabt" id="btnCreate1">
                        <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                        <span class="bSabt-text">ثبت</span>
                    </button>
                </div>

                <div class="col-xl-5">
                    <button class="btn form-control uploadSummery1 buttonGeneral" style="float:left;">
                        <i class="bi bi-upload fa-fw me-1 VecGeneral"></i>
                        <span class="bGeneral-text">بارگذاری پیوست</span>
                        
                    </button>
                    <input id="summery_file1" style="display:none" type="file" class="form-control" value="" />
                </div>

            </div>
        </div>
    </div>

    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>


</div>


    <script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>

    @* DatePicker *@
    <script>

        $(function () {
            $('#year_Eq').picker({ search: true });
            $('#month_Eq').picker({ search: true });

            $('#datepickerFrom_Eq').MdPersianDateTimePicker({
                targetTextSelector: '#datepickerFrom_Eq',
                targetDateSelector: '#datepickerFromEn_Eq',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: true,
                disableBeforeToday: false
            });

            $('#datepickerTo_Eq').MdPersianDateTimePicker({
                targetTextSelector: '#datepickerTo_Eq',
                targetDateSelector: '#datepickerToEn_Eq',
                dateFormat: 'yyyy-MM-dd',
                isGregorian: false,
                enableTimePicker: true,
                disableBeforeToday: false
            });

        });

    </script>

    @* submitCommodityProject *@
    <script>
    function submitCommodityProject() {
        var arguments = {};
        arguments.Peymans = $("#select_peyman").val();
        arguments.ProjectCode = $("#ProjectCode").val();
        arguments.City_Id = $("#cities").val();
        arguments.DateOfDefinitionCommodityProject = $("#datepickerFromEn_Eq").val();
        arguments.ProjectTitle = $("#ProjectTitle").val();

        document.getElementById("loading-message").style.display = "block";
        $.ajax({
            type: "Post",
            url: "@Url.Action("SubmitCommodityProject","WareHouse")",
            dataType: 'text',
            contentType: 'application/json',
            traditional: true,
            data: JSON.stringify(arguments),
            success: function (data) {
                document.getElementById("loading-message").style.display = "none";
                if (data == "1") {
                    alert('اطلاعات ثبت شد')
                    window.location.reload();
                }
            },
            error: (error) => {
                console.log(error);
            }
        });
    }
    </script>



