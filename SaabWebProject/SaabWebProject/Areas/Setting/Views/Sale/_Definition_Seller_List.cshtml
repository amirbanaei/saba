@using SaabWebProject.Models.DomainModels;
@{
    SaabEntities db = new SaabEntities();
}
@{
    Layout = null;
}

<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
<script src="/Assets/js/jalalidatepicker.min.js"></script>
<link href="/Assets/css/jalalidatepicker.min.css" rel="stylesheet">
<script src="/Assets/js/jalaali.min.js"></script>
<link href="/MyStyles/jalalidatepicker.css" rel="stylesheet">
<style>
    table {
        margin: 0 auto; /* sets the left and right margins to auto */
        text-align: center; /* aligns the text content of the table to the center */
    }

    .disabled {
        pointer-events: none;
        opacity: 0.3; /* می‌توانید از opacity نیز برای نمایش غیرفعال استفاده کنید */
    }
</style>
        @{
            var Tr = db.tbSetting_Sell_Create.ToList().Count;
        }
<div class="card">
    <div class="card-body">
        @if (Tr == 0)
        {
            <table style="width: 100%;margin-top: 4px;" class="table table-hover text-nowrap @(Tr != 0 ? "" : "disabled")">
                <thead>
                    <tr>
                        <td rowspan="01" colspan="02">
                            <img id="image-preview" alt="عکس آپلود شده" src="~/Areas/Setting/Images/AdminImages/picture.png"
                                 style=" border-radius: 119px;margin-bottom: 14px;
                                    background: linear-gradient(#0d3244, #0d3244) padding-box, linear-gradient(to bottom, #7bf1f5, #3cd0a5) border-box;
                                    border: 3px solid transparent; " height="185" width="185">
                        </td>
                    </tr>
                    <tr>
                        <td rowspan="01" colspan="02">-</td>
                    </tr>
                    <tr>
                        <td rowspan="01" colspan="02">-</td>
                    </tr>
                    <tr>
                        <td rowspan="01" colspan="02">-</td>
                    </tr>
                    <tr>
                        <td rowspan="01" colspan="02">-</td>
                    </tr>
                    <tr>
                        <td rowspan="01" colspan="02">-</td>
                    </tr>
                    <tr>
                        <td rowspan="01" colspan="02">-</td>
                    </tr>

                </thead>
            </table>
            <hr />
            <div class="row">
                <div class="col-xl-10"></div>
                <div class="col-xl-1">
                    <button data-bs-toggle="modal" data-bs-target="#modalLg1" class="btn form-control buttonGeneral @(Tr != 0 ? "" : "disabled")" id="btnEdite">
                        <i class="fa fa-edit fa-fw me-1 VecGeneral"></i>
                        <span class="bGeneral-text">ویرایش</span>
                        
                    </button>
                </div>
            </div>
        }
        else
        {
            var item = db.tbSetting_Sell_Create.ToList();

            <table style="width: 100%;margin-top: 4px;" class="table table-hover text-nowrap @(item.Count != 0 ? "" : "disabled")">
                <thead>
                    @*<tr>
                        <th rowspan="01" colspan="01">عنوان</th>
                            <th rowspan="01" colspan="02">توضیحات</th>
                    </tr>*@
                    <tr>
                        @*<th rowspan="01" colspan="01">عکس</th>*@
                        <td rowspan="01" colspan="02">
                            <img id="image-preview" alt="عکس آپلود شده" src="~/Areas/Setting/Images/AdminImages/@(item[0].UserImage != null ? item[0].UserImage : "picture.png")"
                                 style=" border-radius: 119px;margin-bottom: 14px;
                                    background: linear-gradient(#0d3244, #0d3244) padding-box, linear-gradient(to bottom, #7bf1f5, #3cd0a5) border-box;
                                    border: 3px solid transparent; " height="185" width="185">
                        </td>
                    </tr>
                    <tr>
                        @*<th rowspan="01" colspan="01">نام کاربری</th>*@
                        <td rowspan="01" colspan="02">@(item.Count != 0 ? item[0].UserName : "-")</td>
                    </tr>
                    <tr>
                        @*<th rowspan="01" colspan="01">عنوان کاربر</th>*@
                        <td rowspan="01" colspan="02">@(item.Count != 0 ? item[0].UserTitle : "-")</td>
                    </tr>
                    <tr>
                        @*<th rowspan="01" colspan="01">نام نرم افزار</th>*@
                        <td rowspan="01" colspan="02">@(item.Count != 0 ? item[0].NameSoftwar : "-")</td>
                    </tr>
                    <tr>
                        @*<th rowspan="01" colspan="01">ورژن نرم افزار</th>*@
                        <td rowspan="01" colspan="02">@(item.Count != 0 ? item[0].VersionSoftwar : "-")</td>
                    </tr>
                    <tr>
                        @*<th rowspan="01" colspan="01">از تاریخ</th>*@
                        @if (item.Count != 0)
                        {
                            <td cont-date="dateS_" hidden>@item[0].DateSell.ToString()</td>
                            <td rowspan="01" colspan="02" id="dateS_"></td>
                        }
                        else
                        {
                            <td rowspan="01" colspan="02">-</td>
                        }
                    </tr>
                    <tr>
                        @*<th rowspan="01" colspan="01">تا تاریخ</th>*@
                        @if (item.Count != 0)
                        {
                            <td cont-date="dateT_" hidden>@item[0].DateSuport.ToString()</td>
                            <td rowspan="01" colspan="02" id="dateT_"></td>
                        }
                        else
                        {
                            <td rowspan="01" colspan="02">-</td>
                        }
                    </tr>

                </thead>
            </table>
            <hr />
            <div class="row">
                <div class="col-xl-9"></div>
                <div class="col-xl-3">
                    <button data-bs-toggle="modal" data-bs-target="#modalLg1" class="btn form-control buttonGeneral @(item.Count != 0 ? "" : "disabled")" id="btnEdite">
                        <i class="fa fa-edit fa-fw me-1 VecGeneral"></i>
                        <span class="bGeneral-text">ویرایش</span>
                    </button>
                </div>
            </div>
        }


    </div>
    <!-- arrow -->
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>

</div>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Scripts/popper.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script>
    $("#btnEdite").click(function () {
          $("#big_modal_body1").load( '@Url.Content("/Sale/_Definition_Seller_Update")');
    });

</script>
<script>  
    // Convert Gregorian date to jaali in the table
    var tds = document.querySelectorAll("[cont-date]");
    var valueD, id, target;
    var options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    tds.forEach(td => {
        valueD = new Date(td.textContent).toLocaleDateString('fa-IR-u-nu-latn', options).replace(',', '').replace(" ", "");
        valueD = valueD.slice(0, 10)
        id = td.getAttribute("cont-date");
        target = document.getElementById(id);
        target.textContent = valueD;
    });
</script>