@* Submit *@
<script>
    let arguments = {};
    $("#btnSubmitCard3").click(function () {
        arguments.peymanCount = $('#peymanCount').val()
        arguments.rightUsersCount = $('#rightUsersCount').val()
        arguments.legalUsersCount = $('#legalUsersCount').val()
        arguments.termination_date = $('#datepickerFromEn_Eq').val()
        arguments.work_geography = $('#work_geography').val()
        arguments.Latitude = $('#input_Latitude').val()
        arguments.Longitude = $('#input_Longitude').val()
        arguments.Maximum_inactivity_time = $('#Maximum_inactivity_time').val()
        arguments.MacAddress = $('#MacAddress').val()

        $.ajax({
            type: "Post",
            url: '/Sale/SubmitCard3',
            dataType: 'text',
            contentType: 'application/json',
            traditional: true,
            data: JSON.stringify(arguments),
            success: function (data) {
                $("#Error").html(data);
                console.log($("#Error"))
                if (data == "1") {
                    alert('اطلاعات ثبت شد')
                    window.location.reload();
                }
            },
            error: (error) => {
                console.log(error);
            }
        });
    });
</script>