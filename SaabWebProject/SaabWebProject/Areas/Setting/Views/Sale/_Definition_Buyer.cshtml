<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<div class="card Show1" style="margin-top:10px;">
    <div class="card-body">
        <div class="row">
            <div class="col-xl-9">
                <label class="form-label">نام خریدار</label>
                @Html.Action("_PartialListCompaniesInDropDown", "Company", new { area = "Users" })
            </div>
            <div class="col-xl-2"></div>
            <div class="col-xl-1">
                <button class="btn form-control buttonGeneral" id="btn_Image">
                    <i class="bi bi-upload fa-fw me-1 VecGeneral"></i>
                    <span class="bGeneral-text">بارگذاری آرم</span>

                </button>
                <input class="form-control " type="file" id="Image" style="display:none" />
            </div>

        </div>
            <hr />
            <div class="row">
                <div class="col-xl-11">
                </div>
                <div class="col-xl-1">
                    @*<input class="btn form-control buttonsabt" type="button" value="ثبت" />*@
                    <button class="btn form-control buttonsabt" id="">
                        <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                        <span class="bSabt-text">ثبت</span>
                    </button>
                </div>
            </div>
    </div>
    <!-- arrow -->
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<div class="card Show2" style="margin-top:10px; display:none" >
    <div class="card-body">
            <div class="row">
                <table class="table table-hover text-nowrap">
                    <tr>
                        <th rowspan="01" colspan="01">مدیر عامل : </th>
                        <td rowspan="01" colspan="02">مهدی تقوائی حسین زاده</td>
                        <td rowspan="01" colspan="01">
                            <img id="image-preview1" alt="عکس آپلود شده" src="~/Areas/Setting/Images/AdminImages/picture.png"
                                 style=" border-radius: 119px;margin-bottom: 14px;
                                    background: linear-gradient(#0d3244, #0d3244) padding-box, linear-gradient(to bottom, #7bf1f5, #3cd0a5) border-box;
                                    border: 3px solid transparent; " height="140" width="140">
                        </td>
                    </tr>
                    <tr>
                        <th rowspan="01" colspan="01">شرکت : </th>
                        <td rowspan="01" colspan="02">خدمات فنی و مهندسی نویان بهینه</td>
                        <td rowspan="01" colspan="01">
                            <img id="image-preview2" alt="عکس آپلود شده" src="~/Areas/Setting/Images/AdminImages/picture.png"
                                 style=" border-radius: 119px;margin-bottom: 14px;
                                    background: linear-gradient(#0d3244, #0d3244) padding-box, linear-gradient(to bottom, #7bf1f5, #3cd0a5) border-box;
                                    border: 3px solid transparent; " height="140" width="140">
                        </td>
                    </tr>
                </table>
            </div>
            <div class="row">
                <hr />
                <div class="col-xl-10">
                </div>
                <div class="col-xl-2">
                    @*<input class="btn form-control buttonsabt" type="button" id ="EditeBut2"value="ویرایش" />*@
                    <button class="btn form-control buttonGeneral" id="EditeBut2">
                        <i class="fa fa-edit fa-fw me-1 VecGeneral"></i>
                        <span class="bSabt-text">ویرایش</span>
                    </button>
                </div>
            </div>
    </div>
    <!-- arrow -->
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script>
    $('#companies').picker({ search: true });
</script>
<script>
    $("#btn_Image").click(function () {
        console.log("hello");
        $("#Image").click();
    })
</script>