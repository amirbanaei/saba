<script>
    jalaliDatepicker.startWatch({
        time: true,
        days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
        persianDigits: true,
        autoClose: true,
        //autocomplete: true,
        showCloseBtn: true,
        showEmptyBtn: false,
        showCloseBtn: true,
        zIndex: 100000,
    });
    //-----------------------------------------------------------------
    var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
    for (var i = 0; i < inputs.length; i++) {
        inputs[i].addEventListener("jdp:change", function (e) {
            var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
            var date = this.value.replace(' ', '').slice(0, 10).split('/');
            date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]),)
            // If it was empty
            if (!this.value) {
                date = "";
            }
            // If it was only history
            else if (this.value.replace(' ', '').length < 11) {
                date = date.gy + '-' + date.gm + '-' + date.gd
            }
            // If it was the date and time
            else {
                date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30)
            }
            miladiInput.value = date
        });
    }
</script>
@*چک تکراری بودن پسورد به صورت برخط*@
<script>
    document.getElementById('Password01_R').addEventListener('input', function () {
        var password = document.getElementById('Password01').value;
        var confirmPassword = this.value;

        var errorMessageElement = document.getElementById('error-message01');

        if (password !== confirmPassword) {
            errorMessageElement.textContent = 'پسورد و تکرار پسورد با هم مغایرت دارند.';
        } else {
            errorMessageElement.textContent = '';
        }
    });
    document.getElementById('Password02_R').addEventListener('input', function () {
        var password = document.getElementById('Password02').value;
        var confirmPassword = this.value;

        var errorMessageElement = document.getElementById('error-message02');

        if (password !== confirmPassword) {
            errorMessageElement.textContent = 'پسورد و تکرار پسورد با هم مغایرت دارند.';
        } else {
            errorMessageElement.textContent = '';
        }
    });
</script>
<script>
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
    function sendAjax2(url2, fd2) {

        fd2.append("UserName", $("#UserName").val());
        fd2.append("UserTitle", $("#UserTitle").val());
        fd2.append("Password1", $("#Password01").val());
        fd2.append("Password2", $("#Password02").val());
        fd2.append("NameSoftwar", $("#NameSoftwar").val());
        fd2.append("VersionSoftwar", $("#VersionSoftwar").val());
        fd2.append("DateSell", $("#DateSell").val());
        fd2.append("DateSuport", $("#DateSuport").val());


        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                console.log("okeye");
                console.log(resp1);
                $("#loading-message").css("display", "none");
                fd = new FormData();
                if (resp1 == "True") {
                    alert("با موفقیت ثبت شد");
                    location.reload();
                }
                else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });
                }

            },
            error: function (resp1) {
                console.log(resp1);
                console.log("Nokeye");
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });
    }
</script>
<script>
        var fd = new FormData();
            //------------------------------------------------------------
            //برای نمایش تصویر
            const imageInput = document.getElementById('image-input');
            const uploadButton = document.getElementById('upload-button');
            const imagePreview = document.getElementById('image-preview');

            uploadButton.addEventListener('click', () => {
                imageInput.click();
            });

            imageInput.addEventListener('change', () => {
                if (imageInput.files.length === 0) {
                    return;
                }

            const file = imageInput.files[0];
            const reader = new FileReader();

                reader.onload = () => {
                imagePreview.src = reader.result;
                };
            console.log(file)
            fd.append("files", file);
            reader.readAsDataURL(file);
            });
        //----------------------------------------------------------------
        $("#btnSave").click(function () {
            if ($("#UserName").val().length < 10) {
                alert("نام کار بری حد اقل 10 کاراکتر باید باشد");
            }
            else if ($("#UserTitle").val() == '') {
                alert("لطفا 'عنوان کاربر' را وارد کنید");
            }
            else if ($("#Password01").val() == '' || $("#Password01_R").val() == '') {
                alert("لطفا 'کلمه عبور 1' را وارد کنید");
            }
            else if ($("#Password02").val() == '' || $("#Password02_R").val() == '') {
                alert("لطفا 'کلمه عبور 2' را وارد کنید");
            }
            else if ( $("#Password01").val() != $("#Password01_R").val()) {
                alert("کلمه عبور 1 و تکرار کلمه عبور 1 با هم تطابق ندارد");
            }
            else if ($("#Password02").val() != $("#Password02_R").val()) {
                alert("کلمه عبور 2 و تکرار کلمه عبور 2 با هم تطابق ندارد");
            }
            else if ($("#NameSoftwar").val() == '') {
                alert("لطفا 'نام نرم افزار' را وارد کنید");
            }
            else if ($("#VersionSoftwar").val() == '') {
                alert("لطفا 'نسخه نرم افزار' را وارد کنید");
            }
            else if ($("#DateSell").val() == '') {
                alert("لطفا 'از تاریخ' را وارد کنید");
            }
            else if ($("#DateSuport").val() == '') {
                alert("لطفا 'تا تاریخ' را وارد کنید");
            }
           else {
               console.log($("#datepickerFromEn_Eq1").val());
             sendAjax2('@Url.Action("UploadAttachmentFile", "Sale", new { area = "Setting" })', fd);
           };
    });

</script>

