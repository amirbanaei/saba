<div class="card p-4" style="z-index:12 !important">

    <div class="row">
        <div class="col-xl-3">
            <label class="form-label">نام مدیر سیستم</label>
            @*<p class="card-text">مدیر مورد نظر را انتخاب کنید</p>*@
            @Html.Action("_PartialViewUsersListWithSearch", "Users", new { area = "Users" })
        </div>
        <div class="col-xl-3">
            <label class="form-label">سطح دسترسی</label>
            <input class="form-control" type="button" value="تعیین سطح دسترسی" style="width:100%" />
        </div>
        <div class="col-xl-4"></div>
        <div class="col-xl-1">
            <button class="btn form-control buttonGeneral" id="btn_Image">
                <i class="fa fa-image fa-fw me-1 VecGeneral"></i>
                <span class="bGeneral-text">انتخاب عکس</span>
            </button>
            <input class="form-control" type="file" title="انتخاب عکس" id="Image" style="display:none;" />
        </div>
        <div class="col-xl-1">
            @*<input class="btn btn-outline-success buttonsabt" type="button" value="ثبت" />*@
            <button class="btn form-control buttonsabt" id="">
                <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                <span class="bSabt-text">ثبت</span>
            </button>
        </div>
    </div>

    <!-- arrow -->
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<div class="card p-4" style="margin-top:10px;">

    <div class="row">
        <div class="col-xl-3">
            <label class="form-label">تغییر کلمه عبور</label>
            <input class="form-control" type="text" placeholder="کلمه عبور جدید وارد کنید" />
        </div>
        <div class="col-xl-3">
            <label class="form-label">تکرار کلمه عبور</label>
            <input class="form-control" type="text" placeholder="کلمه عبور جدید مجدد را وارد کنید" />
        </div>
        <div class="col-xl-3">
            <label class="form-label">رمز پیامک شده</label>
            <input class="form-control" type="text" placeholder="رمز پیامک شده را وارد کنید" />
        </div>
        <div class="col-xl-2"></div>
        <div class="col-xl-1">
            @*<input class="btn btn-outline-success buttonsabt" type="button" value="ثبت" />*@
            <button class="btn form-control buttonsabt" id="">
                <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                <span class="bSabt-text">ثبت</span>
            </button>
        </div>
    </div>
    <!-- arrow -->
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script>
    $("#btn_Image").click(function () {
        $("#Image").click();
    });
</script>