
@{
    ViewBag.Title = "تنظیمات فروش";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<link href="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.style.css" rel="stylesheet" />
<link href="~/Content/setting.css" rel="stylesheet" />


<div class="">
    <ul class="nav nav-tabs nav-tabs-v2 ps-4 pe-4">
        <li class="nav-item me-3">
            <a href="#Definition_Seller" class="nav-link active" data-bs-toggle="pill">
                <button class=" nav-btn">تعریف فروشنده</button>
            </a>
        </li>
        <li class="nav-item me-3">
            <a href="#Definition_buyer" class="nav-link" data-bs-toggle="pill">
                <button class=" nav-btn">تعریف خریدار</button>
            </a>
        </li>
        <li class="nav-item me-3">
            <a href="#Definition_System_Administrator" class="nav-link" data-bs-toggle="pill">
                <button class=" nav-btn">تعریف مدیر سیستم</button>
            </a>
        </li>
        <li class="nav-item me-3">
            <a href="#Scope_Product_Activity" class="nav-link " data-bs-toggle="pill">
                <button class=" nav-btn">دامنه فعالیت محصول</button>
            </a>
        </li>

    </ul>
    <div class="tab-content p-2">
        <div class="tab-pane fade show active" id="Definition_Seller">
            @Html.Action("_Definition_Seller2")
        </div>
        <div class="tab-pane fade" id="Definition_buyer">
            @Html.Action("_Definition_Buyer")
        </div>
        <div class="tab-pane fade" id="Definition_System_Administrator">
            @Html.Action("_Definition_System_Administrator")
        </div>
        <div class="tab-pane fade" id="Scope_Product_Activity">
            @Html.Action("_Scope_Product_Activity")
        </div>

    </div>
    <!-- arrow -->

</div>

@section Scripts{
    <script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>

}
