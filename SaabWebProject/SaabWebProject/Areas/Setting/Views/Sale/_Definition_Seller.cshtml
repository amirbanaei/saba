@* Image Change *@
<script>
    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $("#imgPreviewAdmin").attr('src', e.target.result);
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    $("#Image").change(function () {
        //console.log('4')
        readURL(this);
    })
</script>

@* Submit UserName & Pic *@
<script>
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
    $('input[name=Admin_FirstSectionBtn]').click(() => {
        var fileUpload = $("#Image").get(0);
        var files = fileUpload.files;
        var fileData = new FormData();

        if (files[0]) {
            fileData.append(files[0].name, files[0]);
        }

        fileData.append('username', $("#username").val());
        $.ajax({
            url: '/Sale/_Definition_Seller_Changes',
            type: "POST",
            contentType: false,
            processData: false,
            data: fileData,
            success: function (result) {
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "اطلاعات با موفقیت ذخیره شد"
                });
            },
            error: function (err) {
                Toast.fire({
                    icon: 'warning',
                    background: '#35434A',
                    color: 'white',
                    title: "ذخیره اطلاعات با مشکل مواجه شد"
                });
            }
        });
    })

    function massageSent1(e) {
        e.disabled = true;
        let btn = document.createElement("button");
        btn.innerHTML = "ثبت";
        btn.classList.add('btn', 'btn-outline-success');
        btn.setAttribute("name", "submitBtnPas1");
        document.getElementById("submitBtnPas1Par").appendChild(btn);

        $('button[name=submitBtnPas1]').click(() => {

            var id1 = $("#pass1").val();
            var id2 = $("#pass1_R").val();
            if (id1 != id2) {
                Toast.fire({
                    icon: 'warning',
                    background: '#35434A',
                    color: 'white',
                    title: "تکرار رمز عبور مغایرت دارد"
                })
                return false;
            }
            arguments.pass1 = $('#pass1').val()
            $.ajax({
                type: "Post",
                url: '/Sale/_Definition_Seller_ChangesPass1',
                dataType: 'text',
                contentType: 'application/json',
                traditional: true,
                data: JSON.stringify(arguments),
                success: function (data) {
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "اطلاعات با موفقیت ذخیره شد"
                    });
                },
                error: (error) => {
                    Toast.fire({
                        icon: 'warning',
                        background: '#35434A',
                        color: 'white',
                        title: "ذخیره اطلاعات با مشکل مواجه شد"
                    });
                }
            });
        })
    }

    function massageSent2(e) {
        e.disabled = true;
        let btn = document.createElement("button");
        btn.innerHTML = "ثبت";
        btn.classList.add('btn', 'btn-outline-success');
        btn.setAttribute("name", "submitBtnPas2");
        document.getElementById("submitBtnPas2Par").appendChild(btn);

        $('button[name=submitBtnPas2]').click(() => {
            var id1 = $("#pass2").val();
            var id2 = $("#pass2_R").val();
            if (id1 != id2) {
                Toast.fire({
                    icon: 'warning',
                    background: '#35434A',
                    color: 'white',
                    title: "تکرار رمز عبور مغایرت دارد"
                })
                return false;
            }
            arguments.pass2 = $('#pass2').val()
            $.ajax({
                type: "Post",
                url: '/Sale/_Definition_Seller_ChangesPass2',
                dataType: 'text',
                contentType: 'application/json',
                traditional: true,
                data: JSON.stringify(arguments),
                success: function (data) {
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "اطلاعات با موفقیت ذخیره شد"
                    });
                },
                error: (error) => {
                    Toast.fire({
                        icon: 'warning',
