                            <p class="card-text">@*شما با نام کابری احمد حسین زاده وارد شده اید*@</p>
                            @*@if (Model.userName != null)*@
                            @if (Model != null)
                            {
                                @*<input class="form-control" id="username" type="text" value="@Model.userName" placeholder="نام کاربری جدید را وارد کنید" />*@

                            }
                            else
                            {
                                <input class="form-control" id="username" type="text" value="" placeholder="نام کاربری جدید را وارد کنید" />

                            }
                            <div class="invalid-feedback">این فیلد مورد نیاز است !</div>

                        </div>
                        <div class="col-md-12 col-lg-2 col-sm-12">
                            <h5 class="card-title">بارگزاری عکس</h5>
                            <p class="card-text">@*لطفا تصویر مورد نظر خود را انتخاب کنید*@</p>
                            <button class="btn form-control buttonGeneral" id="btn_image">
                                <i class="fa fa-image fa-fw me-1 VecGeneral"></i>
                                <span class="bGeneral-text"> انتخاب عکس</span>
                               
                            </button>
                            @*@if (@Model.Picture != null)*@
                            @if (@Model != null)
                            {
                                <img id="imgPreviewAdmin" class="thumbnail rounded-2 mt-1 d-none" style="max-width:131px;max-height:131px;border: 2px solid #65c096;" src="~/Areas/Setting/Images/AdminImages/@Model.Picture" />

                            }
                            else
                            {
                                <img id="imgPreviewAdmin" class="thumbnail rounded-2 mt-1 d-none" style="max-width:131px;max-height:131px;border: 2px solid #65c096;" src="" />

                            }

                            <button class="btn-theme d-flex align-items-center justify-content-center w-100 my-1 rounded-2" style="height:20px" onclick="ImgShow(this)">
                                <svg xmlns="http://www.w3.org/2000/svg" style="width:15px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                </svg>
                            </button>
                            @*<img id="imgPreviewAdmin" class="thumbnail" style="max-width:131px;max-height:131px;" src="~/Areas/Setting/Images/AdminImages/@Model.Picture" />*@
                            <div class="form-group">
                                <div class="col-md-10">
                                    <input class="form-control" id="Image" name="Image" type="file" title="انتخاب عکس" style="display:none" />
                                </div>
                            </div>
                            @*<button class="btn btn-theme form-control" id="btn_image">انتخاب عکس</button>*@
                            <div class="invalid-feedback">این فیلد مورد نیاز است !</div>
                        </div>
                        <div class="col-md-12 col-lg-4 col-sm-12">
                            @*<h5 class="card-title">ثبت تغییرات</h5>*@
                            <p class="card-text">@*در نهایت تغییرات را اعمال کنید*@</p>
                            <input class="btn btn-outline-success mt-3 mx-3" id="Save" type="button" name="Admin_FirstSectionBtn" value="ثبت نهایی" />
                            <div class="invalid-feedback">این فیلد مورد نیاز است !</div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- arrow -->
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>

