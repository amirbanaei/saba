    }

</script>

@* Image Show *@
<script>
    function ImgShow(e) {
        $("#imgPreviewAdmin").removeClass('d-none');
        e.classList.add('d-none');
    }
</script>

@* Map *@
<script src="~/Scripts/setting.js"></script>
<script>
    var mapPopup = document.getElementById("mapPopup");
    var mapPopupContent = document.getElementById("mapPopupContent");
    var mapOverlay = new ol.Overlay({
        element: mapPopup
    });
    var map = new ol.Map({
        controls: ol.control.defaults({ attribution: false, zoom: false, rotate: false }),
        layers: [
            new ol.layer.Tile({
                source: new ol.source.OSM({ crossOrigin: null })
            })
        ],
        overlays: [mapOverlay],
        view: new ol.View({
            projection: 'EPSG:4326',
            center: [59.563286245879056, 36.30022467182867],
            zoom: 12
        })
    });

    map.loaded = true;
    setTimeout(function () {
        map.setTarget(document.getElementById('mapContainer'));
    }, 2000);

    var zoomSlider = new ol.control.ZoomSlider();
    map.addControl(zoomSlider);

    map.on("singleclick", function (e) {
        var coordinate = e.coordinate;

        mapPopupContent.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>`;

        $("#input_Latitude").val(e.coordinate[0])
        $("#input_Longitude").val(e.coordinate[1])

        mapOverlay.setPosition(coordinate);
    })

    $('#mapContainer1').css('opacity', '0');
    setTimeout(() => {
        $("#mapContainer").hide()
        $("#mapbtn").prop("disabled", false);
    }, "3000");
</script>