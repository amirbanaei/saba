<script>
    $(document).ready(function () {
        const checkbox1 = document.getElementById('defaultRadio1');
        const div1 = document.querySelector('.D1');
        const checkbox2 = document.getElementById('defaultRadio2');
        const div2 = document.querySelector('.D2');
        const div3 = document.getElementById("D3");

        checkbox1.addEventListener('change', () => {
            if (checkbox1.checked) {
                div1.style.display = 'flex';
            } else {
                div1.style.display = 'none';
            }
        });

        checkbox2.addEventListener('change', () => {
            if (checkbox2.checked) {
                div2.style.display = 'flex';
            } else {
                div2.style.display = 'none';
            }
        });
    });
    //----------------------------------------------------------------------------------
    function toggleD3() {
        if ($("#defaultRadio1").is(":checked") || $("#defaultRadio2").is(":checked")) {
            $("#D3").show();
        } else {
            $("#D3").hide();
        }
    }
</script>
<script>
    // Convert Gregorian date to jaali in the table
    var inputs = document.querySelectorAll("[cont-date]");
    var valueD, id, target;
    var options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' };
    inputs.forEach(input => {
        valueD = new Date(input.value).toLocaleDateString('fa-IR-u-nu-latn', options).replace(',', '').replace(" ", "");
        console.log(valueD)
        valueD = valueD.slice(0, 10) + ' ' + valueD.slice(10, 30)
        id = input.getAttribute("cont-date");
        target = document.getElementById(id);
        target.value = valueD;
    });
</script>
<script>

    //-----------------------------------------------------------------
    var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
    for (var i = 0; i < inputs.length; i++) {
        console.log('data-jdp-miladi-input')
        inputs[i].addEventListener("jdp:change", function (e) {
            var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
            var date = this.value.replace(' ', '').slice(0, 10).split('/');
            date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]),)
            // If it was empty
            if (!this.value) {
                date = "";
            }
            // If it was only history
            else if (this.value.replace(' ', '').length < 11) {
                date = date.gy + '-' + date.gm + '-' + date.gd
            }
            // If it was the date and time
            else {
                date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30)
            }
            miladiInput.value = date
        });
    }
</script>
@*چک تکراری بودن پسورد به صورت برخط*@
<script>
    document.getElementById('Password01_R1').addEventListener('input', function () {
        var password = document.getElementById('Password011').value;
        var confirmPassword = this.value;

        var errorMessageElement = document.getElementById('error-message011');

        if (password !== confirmPassword) {
            errorMessageElement.textContent = 'پسورد و تکرار پسورد با هم مغایرت دارند.';
        } else {
            errorMessageElement.textContent = '';
        }
    });
</script>
<script>
    var Toast = Swal.mixin({
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
        function sendAjaxEdit(url2, fd2) {

            fd2.append("UserName", "@item[0].UserName");
            fd2.append("UserTitle", "@item[0].UserTitle");
            if (document.getElementById("defaultRadio2").checked) {
                fd2.append("Password1", $("#Password011").val());
                fd2.append("Password2", $("#Password021").val());
            }
            else {
                fd2.append("Password1", "@item[0].Password1");
                fd2.append("Password2", "@item[0].Password2");
            }

            fd2.append("NameSoftwar", $("#NameSoftwar1").val());
            fd2.append("VersionSoftwar", $("#VersionSoftwar1").val());

            if (document.getElementById("defaultRadio1").checked) {
                fd2.append("DateSell", $("#DateSell1").val());
                fd2.append("DateSuport", $("#DateSuport1").val());
            }
            else {
                fd2.append("DateSell", "@item[0].DateSell");
                fd2.append("DateSuport", "@item[0].DateSuport");
            }

            fd2.append("ID", "@item[0].ID");


        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                console.log("okeye");
                console.log(resp1);
                $("#loading-message").css("display", "none");
                fd = new FormData();
                if (resp1 == "True") {
                    alert("با موفقیت ثبت شد");
                    location.reload();
                }
                else {
                    $("#loading-message").css("display", "none");
                    Toast.fire({
                        icon: 'success',
                        background: '#35434A',
                        color: 'white',
                        title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                    }).then(() => {
                        $("#loading-message").css("display", "none");
                    });
                }

            },
            error: function (resp1) {
                console.log(resp1);
                console.log("Nokeye");
                $("#loading-message").css("display", "none");
                Toast.fire({
                    icon: 'success',
                    background: '#35434A',
                    color: 'white',
                    title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                }).then(() => {
                    $("#loading-message").css("display", "none");
                });
            }
        });
    }
</script>

