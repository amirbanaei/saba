@model bool?


<div class="row">

        @if (Model != true)
        {
            <div class="col-xl-6">
                <input class="form-check-input" name="radiobutton_1" type="radio" value="" id="IsVisible" />
           
                <label class="form-check-label" for="defaultRadio1">مجوز نمایش دارد</label>
            </div>
        }
        else
        {
            <div class="col-xl-6">
                <input class="form-check-input" name="radiobutton_1" checked type="radio" value="" id="IsVisible" />
         
                <label class="form-check-label" for="defaultRadio1">مجوز نمایش دارد</label>
            </div>

        }


        @if (Model != true)
        {
            <div class="col-xl-6">
                <input class="form-check-input" name="radiobutton_1" checked type="radio" value="" id="NotVisible" />
            
                <label class="form-check-label" for="defaultRadio1">مجوز نمایش ندارد</label>
            </div>
        }
        else
        {
            <div class="col-xl-6">
                <input class="form-check-input" name="radiobutton_1" type="radio" value="" id="NotVisible" />
           
                <label class="form-check-label" for="defaultRadio1">مجوز نمایش ندارد</label>
            </div>
        }
</div>




<script>
    let IsVisible = false;

    $('#IsVisible').click(function () {
        if ($('#IsVisible').is(':checked')) {
            alert("salam")
            IsVisible = true; 
        }
        else {
            IsVisible = false;
        }
    });
    $('#NotVisible').click(function () {
        if ($('#NotVisible').is(':checked')) {

            IsVisible = false;

        }
        else {
            IsVisible = true;
        }
    });
</script>