@model List<SaabWebProject.Models.DomainModels.tbCaranSettings>
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
@{
    Layout = null;
}
<div class="card" style="margin-top:10px">
    <div class="table-content p-2">
        <div class="table-responsive">
            <table class="table table-card" style="text-align:center;">

                <thead>
                    <tr>
                        <th>نام مولفه</th>
                        <th>حداقل</th>
                        <th>حداکثر</th>
                        <th>مقدار معیار</th>
                        <th>استاندارد</th>
                        <th>حد پذیرش</th>
                        <th>سرانه ایاب و ذهاب</th>
                        <th>آستانه شروع پاداش</th>
                        <th>سرانه پاداش</th>
                        <th>آستانه شروع جریمه</th>
                        <th>سرانه جریمه</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <input type="hidden" id="MoalefeData_@item.CaranS_ID" value="@item.FK_Moalefe_ID" />

                            <td>
                                @item.tbContractMoalefeDastmozdi.md_Title
                            </td>

                            <td id="CaraMinData_@item.CaranS_ID">@item.CaranMin</td>
                            <td id="CaraMaxData_@item.CaranS_ID">@item.CaranMax</td>
                            <td id="CaranCriterionData_@item.CaranS_ID">@item.CaranCriterion</td>
                            <td id="CaranStandardData_@item.CaranS_ID">@item.CaranStandard</td>
                            <td id="CaranAcceptLimitData_@item.CaranS_ID">@item.CaranAcceptLimit</td>
                            <td id="CaranAyabOZahab_@item.CaranS_ID">@item.CaranAyabOZahab</td>
                            <td id="CaranAstaneShoroPadash_@item.CaranS_ID">@item.CaranAstaneShoroPadash</td>
                            <td id="CaranSaranePadash_@item.CaranS_ID">@item.CaranSaranePadash</td>
                            <td id="CaranAstaneShoroJarime_@item.CaranS_ID">@item.CaranAstaneShoroJarime</td>
                            <td id="CaranSaraneJarime_@item.CaranS_ID">@item.CaranSaraneJarime</td>

                            <td class="editcaran" style="cursor:pointer" id="@item.CaranS_ID"><i class="fas fa-lg fa-fw me-2 fa-edit"></i></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>