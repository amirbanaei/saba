<script>
        $("#btnCreate1").click(function () {
            var Filters = [];
            if ($("#titleSelect").val() == 0) {
                alert("لطفا عنوان را انتخاب نمائید");
            } else {
                
            $('.Resons_rows').each(function (i, obj) {
                var id = $(this).attr("id").split("_")[1];
                var obj = new Object();
                if ($("#Reason_" + id).val().trim().length == 0) {
                    alert("لطفا علت را در سطر " + id + "بیان فرمائید");
                } else {
                    
                obj.Reason = $("#Reason_" + id).val();
                obj.TitleNumber = $("#titleSelect").val();
                obj.Description = $("#Description_" + id).val();
                Filters.push(obj);
                }
              });

              sendAjax('@Url.Action("DefaultReasons_Add", "Admin", new { area = "Setting" })', Filters);
            }
    });

    function sendAjax(url, data) {
                console.log(url);

                $.ajax({
                    beforeSend: function () {
                        document.getElementById("loading-message").style.display = "block";
                    },
                    url: url,
                    data: { Filters: data },
                    type: "POST",
                    dataType: "html",
                    success: function (resp) {
                        console.log(resp);
                        document.getElementById("loading-message").style.display = "none";
                        if (resp == "True") {
                            alert("با موفقیت ثبت شد");
                        } else {
                            alert("در ثبت دچار خطا شده ایم ! لطفا بعدا تلاش نمائید")
                        }
                    },
                    error: function (resp) {
                        document.getElementById("loading-message").style.display = "none";
                        alert("دچار مشکل شده است ");
                        console.log(resp);
                    }
                });
            }
</script>