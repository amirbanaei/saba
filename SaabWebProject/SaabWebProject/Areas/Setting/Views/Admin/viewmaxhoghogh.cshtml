
@using SaabWebProject.Models.Classes;
@{
    Layout = null;
}
@model IEnumerable<SaabWebProject.Models.DomainModels.tbMaxPayForMonth>

<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
<style>

    .tableH_Lock {
        max-height: 472px;
        /*height: 472px;*/
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0px !important;
    }

    thead th {
        vertical-align: middle;
    }
</style>

<div class="card">
    <div class="table-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive tableH_Lock">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th>
                                @Html.DisplayName("#")
                            </th>
                            <th>
                                @Html.DisplayName("کاربر حقوقی")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter01-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("مقدار ماکسیمم حقوق")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter02-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("مقدار باقی مانده ماه قبل")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("ماه")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter04-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("سال")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter05-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                        </tr>



                    </thead>
                    <tbody style="text-align:center">

                        @if (Model != null)
                        {

                            var i = 0;
                            foreach (var item in Model)
                            {
                                if (item != null)
                                {


                                    i++;
                                    <tr class="task-list-row"
                                        data-filter01="@item.tbUsers.FullName"
                                        data-filter02="@String.Format("{0:N0}", item.Value)"
                                        data-filter03="@String.Format("{0:N0}", item.RemainValue)"
                                        data-filter04="@item.Month"
                                        data-filter05="@item.Year">

                                        <td>
                                            @i
                                        </td>


                                        <td>
                                            @item.tbUsers.FullName
                                        </td>

                                        <td>
                                            @String.Format("{0:N0}", item.Value)
                                        </td>

                                        <td>
                                            @String.Format("{0:N0}", item.RemainValue)
                                        </td>
                                        <td>
                                            @item.Month
                                        </td>
                                        <td>
                                            @item.Year
                                        </td>

                                    </tr>
                                }
                                else
                                {
                                    i++;
                                    <tr>

                                        <td>
                                            @i
                                        </td>


                                        <td>
                                            @item.tbUsers.FullName
                                        </td>

                                        <td>
                                            @item.Value
                                        </td>

                                        <td>
                                            @item.RemainValue
                                        </td>
                                        <td>
                                            @item.Month
                                        </td>
                                        <td>
                                            @item.Year
                                        </td>



                                    </tr>
                                }
                            }

                            // Your foreach loop code here
                        }

                    </tbody>

                </table>
            </div>
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script>

    var
        filters = {
            filter01: null,
            filter02: null,
            filter03: null,
            filter04: null,
            filter05: null,
        };

    function updateFilters() {
        $('.task-list-row').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter(filterName) {
        filters[filterName] = this.value;
        updateFilters();
    }

    // Assigned User Dropdown Filter
    $('#filter01-filter').on('input', function () {
        changeFilter.call(this, 'filter01');
    });
    $('#filter02-filter').on('input', function () {
        changeFilter.call(this, 'filter02');
    });
    $('#filter03-filter').on('input', function () {
        changeFilter.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilter.call(this, 'filter04');
    });
    $('#filter05-filter').on('input', function () {
        changeFilter.call(this, 'filter05');
    });


</script>
