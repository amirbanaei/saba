
@{
    ViewBag.Title = "تنظیمات تولید و نمایش داده";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
   

    .popover-header {
        background-color: #1d2834 !important;
        color: white !important;
    }
</style>
<div class="card">
    <ul class="nav nav-pills mb-3">
        <li class="nav-item me-3"><a href="#Definition_Formula" class="nav-link active" data-bs-toggle="pill">تعریف ساختاره</a></li>
        <li class="nav-item me-3"><a href="#ForumMaker" class="nav-link" data-bs-toggle="pill">فرم ساز</a></li>
        <li class="nav-item me-3"><a href="#SetReports" class="nav-link" data-bs-toggle="pill">تنظیم گزارش ها</a></li>
    

    </ul>
    <div class="tab-content p-4">
        <div class="tab-pane fade show active" id="Definition_Formula" style="height:auto">
            @Html.Action("_Definition_Formula")
        </div>
        <div class="tab-pane fade show" id="ForumMaker">
            @Html.Action("ForumMaker")
        </div>
       
    </div>
    

    <!-- arrow -->
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>

