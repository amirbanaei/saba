document.getElementById("btnInsert").addEventListener("click",function(){

if(!validateRequired()){
alert("فیلدهای الزامی را پر کنید");
return;
}

let data=buildDataList();

if(!data) return;

if(navigator.onLine){

fetch('/Setting/Orders/InsertErjaSabtUsr1',{
method:'POST',
headers:{'Content-Type':'application/json'},
body:JSON.stringify(data)
})
.then(r=>{

if(!r.ok) throw new Error("خطا در ارسال");

return r.json();

})
.then(res=>{

if(res.success)
alert("✅ ثبت شد");
else
alert(res.error);

})
.catch(()=>{

saveOffline(data,'/Setting/Orders/InsertErjaSabtUsr1');
alert("💾 آفلاین ذخیره شد");

});

}
else{

saveOffline(data,'/Setting/Orders/InsertErjaSabtUsr1');
alert("💾 آفلاین ذخیره شد");

}

});

window.addEventListener("online",function(){
syncOffline();
});

document.addEventListener("change",function(e){

if(e.target.matches(".dependency-control"))
evaluateDependencies(true);

});

document.addEventListener("DOMContentLoaded",function(){

evaluateDependencies(false);

jalaliDatepicker.startWatch({
autoClose:true,
showCloseBtn:true,
zIndex:100000
});

document.querySelectorAll("[data-jdp-miladi-input]").forEach(inp=>{

inp.addEventListener("jdp:change",function(){

let miladiInput=document.getElementById(this.getAttribute("data-jdp-miladi-input"));

if(!this.value){
miladiInput.value="";
return;
}

let d=this.value.replace(' ','').slice(0,10).split('/');

let g=jalaali.toGregorian(+d[0],+d[1],+d[2]);

miladiInput.value=g.gy+"-"+g.gm+"-"+g.gd;

});

});

});

document.querySelectorAll(".number").forEach(i=>{

i.addEventListener("input",function(){

let v=this.value.replace(/\D/g,"");

this.value=v?v.replace(/\B(?=(\d{3})+(?!\d))/g,","):"";

});

});

</script>
