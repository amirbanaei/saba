
@model SaabWebProject.Models.ViewModels.Contracts.Function.FunctionModel
@using SaabWebProject.Models.DomainModels;
@using System.Globalization

@{
    SaabEntities db = new SaabEntities();
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row" style="background-color: var(--bs-tab-content-bg); border-radius:8px;padding:10px;border:1px solid white">

    @{
        long IDID = 0;
        long FK_us = 0;
        long vaziat = 0;
        long vaziat2 = 0;
    }

    <div class="row" style="display:flex;flex-direction:column;gap:15px">

        <div class="col-xl-3">

            <select class="form-select" id="select_peyman">
                <option hidden>انتخاب مورد</option>

                @foreach (var item in Model.erja_like_link)
                {
                    <option value="@item.erja_like.ID">@item.value</option>
                }

            </select>

        </div>


        @foreach (var item in Model.erja_omomi_edit)
        {

            var findval = db.erja_sabt_usr
            .FirstOrDefault(s => s.FK_usr == FK_us && s.FK_omomi == IDID && s.FK_erja_omomi_edit == item.ID && s.vaziat == vaziat2);

            var dependencies = db.erja_omomi_edit_link_link
            .Where(d => d.FK_erja_omomi_edit == item.ID && d.active == 1)
            .ToList();

            var hasDependency = dependencies.Any();

            string parentIds = "";
            string parentValues = "";

            if (hasDependency)
            {
                parentIds = string.Join(",", dependencies.Select(d => d.FK_erja_omomi_edit_2));
                parentValues = string.Join(",", dependencies.Select(d => d.number));
            }

            var initialStyle = hasDependency ? "display:none" : "";

            <div class="dependency-item"
                 style="@initialStyle"
                 data-parent-ids="@parentIds"
                 data-parent-values="@parentValues">

                @if (item.Type == 0)
                {

                    bool isChecked = findval != null && findval.value_cheek == true;

                    <div class="form-check">

                        <input type="checkbox"
                               id="@item.ID"
                               class="form-check-input dependency-control @(item.asli==1?"required-check":"")"
                               @(isChecked ? "checked" : "")>


                        <label>@item.Nam @(item.asli==1?"*":"")</label>

                    </div>

                }

                @if (item.Type == 1)
                {

                    <div class="col-xl-4">

                        <label>@item.Nam @(item.asli==1?"*":"")</label>

                        @if (item.Model == 0)
                        {

                            <input id="@item.ID"
                                   value="@(findval?.value_str??"")"
                                   class="form-control dependency-control @(item.asli==1?"required-field":"")">

                        }

                        else if (item.Model == 1)
                        {

                            <input id="@item.ID"
                                   value="@(findval?.value_int!=null?string.Format("{0:N0}",findval.value_int):"")"
                                   class="form-control number dependency-control @(item.asli==1?"required-field":"")">

                        }

                        else if (item.Model == 2)
                        {

                            string shamsi = "";

                            if (findval?.value_time != null)
                            {
                                var pc = new PersianCalendar();
                                var miladi = Convert.ToDateTime(findval.value_time);

                                shamsi = $"{pc.GetYear(miladi):0000}/{pc.GetMonth(miladi):00}/{pc.GetDayOfMonth(miladi):00}";
                            }

                            <input data-jdp
                                   data-jdp-miladi-input="miladi_@item.ID"
                                   id="@item.ID"
                                   value="@shamsi"
                                   class="form-control pdate dependency-control @(item.asli==1?"required-field":"")">

                            <input type="hidden" id="miladi_@item.ID" value="@findval?.value_time">

                        }

                        else
                        {

                            <select id="@item.ID"
                                    class="form-select dependency-control select-int @(item.asli==1?"required-field":"")">

                                <option value="-1">انتخاب کنید</option>

                                @foreach (var it in db.erja_omomi_edit_link.Where(s => s.FK_erja_omomi_edit == item.ID))
                                {
                                    <option value="@it.numeber" @(findval?.value_int == it.numeber ? "selected" : "")>@it.value</option>
                                }

                            </select>

                        }

                    </div>

                }

                @if (item.Type == 4)
                {

                    <div class="col-xl-4">

                        <label>@item.Nam @(item.asli==1?"*":"")</label>

                        <select id="@item.ID"
                                class="form-select dependency-control select-int @(item.asli==1?"required-field":"")">

                            <option value="-1">انتخاب کنید</option>

                            @foreach (var it in db.erja_omomi_edit_link.Where(s => s.FK_erja_omomi_edit == item.ID))
                            {
                                <option value="@it.numeber" @(findval?.value_int == it.numeber ? "selected" : "")>@it.value</option>
                            }

                        </select>

                    </div>

                }

            </div>

        }

    </div>

</div>


@if (vaziat != 3)
{
    <button id="btnInsert" class="btn btn-success">ثبت اطلاعات</button>
}


<script src="~/Scripts/jquery-3.3.1.js"></script>
