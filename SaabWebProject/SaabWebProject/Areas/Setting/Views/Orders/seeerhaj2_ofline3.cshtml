<script>
    $(document).ready(function () {
        $("#select_peyman").picker({ search: true });

    });
</script>

<script>

function isVisible(el){
return el && el.offsetParent!==null;
}

function getValue(ctrl){

if(ctrl.type==="checkbox") return ctrl.checked?"1":"0";

if(ctrl.classList.contains("number"))
return ctrl.value.replace(/,/g,'');

return ctrl.value?ctrl.value.trim():"";

}

function clearValues(wrapper){

wrapper.querySelectorAll("input,select").forEach(el=>{

if(el.type==="hidden") return;

if(el.type==="checkbox") el.checked=false;
else if(el.tagName==="SELECT") el.value="-1";
else el.value="";

});

}

function setState(wrapper,show,clear){

wrapper.style.display=show?"":"none";

if(!show && clear) clearValues(wrapper);

}

function evaluateDependencies(clear=true){

let changed=true;
let guard=0;

while(changed && guard<10){

changed=false;
guard++;

document.querySelectorAll(".dependency-item").forEach(w=>{

const ids=w.dataset.parentIds;
const vals=w.dataset.parentValues;

let show=true;

if(ids){

let idArr=ids.split(",");
let valArr=vals.split(",");

for(let i=0;i<idArr.length;i++){

let p=document.getElementById(idArr[i]);

if(!p || !isVisible(p)){
show=false;
break;
}

let v=getValue(p);

if(valArr[i]!=""){

if(v!=valArr[i]){
show=false;
break;
}

}else{

if(p.type==="checkbox" && !p.checked){
show=false;
break;
}

if(!v || v=="-1"){
show=false;
break;
}

}

}

}

let visible=w.style.display!=="none";

if(visible!==show){

setState(w,show,clear);
changed=true;

}

});

}

}

function validateRequired(){

let ok=true;

document.querySelectorAll(".required-field").forEach(el=>{

if(!isVisible(el)) return;

if(el.tagName==="SELECT"){

if(el.value=="-1"){
el.style.border="2px solid red";
ok=false;
}else el.style.border="";
}

else{

if(!el.value){
el.style.border="2px solid red";
ok=false;
}else el.style.border="";
}

});

document.querySelectorAll(".required-check").forEach(el=>{

if(!isVisible(el)) return;

if(!el.checked){
el.parentElement.style.color="red";
ok=false;
}else el.parentElement.style.color="";
});

return ok;

}

function buildDataList(){

const list=[];

let peyman=$("#select_peyman").val();

if(!peyman){
alert("لطفا مورد را انتخاب کنید");
return null;
}

document.querySelectorAll(".dependency-control").forEach(el=>{

if(el.offsetParent===null) return;

let obj={};

obj.FK_erja_omomi_edit=parseInt(el.id);

if(el.type==="checkbox"){

obj.value_cheek=el.checked;

}

else if(el.classList.contains("pdate")){

let hiddenId=el.getAttribute("data-jdp-miladi-input");
let miladi=document.getElementById(hiddenId);

obj.value_time=miladi?miladi.value:null;

}

else if(el.classList.contains("number")){

obj.value_int=el.value?parseInt(el.value.replace(/,/g,'')):null;

}

else if(el.classList.contains("select-int")){

obj.value_int=(el.value && el.value!="-1")?parseInt(el.value):null;

}

else{

obj.value_str=el.value?el.value.trim():null;

}

obj.FK_omomi=parseInt(peyman);
obj.unic="";
obj.vaziat=@vaziat;

list.push(obj);

});

return list;

}

function saveOffline(data,url){

let p=JSON.parse(localStorage.getItem("pendingErja")||"[]");

p.push({url:url,data:data,time:new Date().toISOString()});

localStorage.setItem("pendingErja",JSON.stringify(p));

}
    async function syncOffline() {

        let p = JSON.parse(localStorage.getItem("pendingErja") || "[]");

        if (p.length === 0) return;

        let remain = [];
        let successCount = 0;

        for (let item of p) {

            try {

                let r = await fetch(item.url, {
                    method: "POST",
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(item.data)
                });

                if (r.ok) {
                    successCount++;
                } else {
                    remain.push(item);
                }

            } catch {
                remain.push(item);
            }

        }

        localStorage.setItem("pendingErja", JSON.stringify(remain));

        if (successCount > 0) {
            alert("✅ " + successCount + " مورد آفلاین با موفقیت ارسال و ذخیره شد");
        }

        if (remain.length > 0) {
            console.warn(remain.length + " مورد هنوز ارسال نشده است");
        }

    }

