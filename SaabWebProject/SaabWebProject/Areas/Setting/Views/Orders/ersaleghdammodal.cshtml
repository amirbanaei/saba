    <script>
        jalaliDatepicker.startWatch();
        $("#form-job13 button[type=submit]").click(function (e) {
            e.preventDefault();

            let form = $("#form-job13");
            let actionUrl = $(this).data("action"); // آدرسی که توی data-action گذاشتیم
            let taghsit = $("#taghsitBedehi").val();
            $("#taghsitBedehi").val(taghsit.replace(/,/g, "")); // حذف ویرگول

            $.ajax({
                url: actionUrl,
                type: "POST",
                data: form.serialize(),
                success: function (res) {
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert(res.message);
                        location.reload();
                    }
                },
                error: function () {
                    alert("خطایی رخ داد، لطفاً دوباره تلاش کنید.");
                    location.reload();
                }
            });
        });

    </script>

