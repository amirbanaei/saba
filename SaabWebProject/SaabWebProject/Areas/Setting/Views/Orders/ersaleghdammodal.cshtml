    <script>
        jalaliDatepicker.startWatch({
            time: false,
            days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
            persianDigits: true,
            autoClose: true,
            autocomplete: true,
            showEmptyBtn: false,
            showCloseBtn: true,
            zIndex: 100000,
        });

        var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
        for (var i = 0; i < inputs.length; i++) {
            inputs[i].addEventListener("jdp:change", function (e) {
                var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                var date = this.value.replace(' ', '').slice(0, 10).split('/');
                date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]));
                if (!this.value) {
                    date = "";
                } else if (this.value.replace(' ', '').length < 11) {
                    date = date.gy + '-' + date.gm + '-' + date.gd;
                } else {
                    date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30);
                }
                miladiInput.value = date;
            });
        }

    </script>

    <script>
 

        const input = document.getElementById("taghsitBedehi");

        input.addEventListener("input", function (e) {
            // حذف هر چیزی غیر از عدد
            let value = this.value.replace(/\D/g, "");

            // فرمت سه‌تا سه‌تا جدا کن
            value = value.replace(/\B(?=(\d{3})+(?!\d))/g, ",");

            this.value = value;
        });
    </script>

    <script>
        // چک‌باکس‌های اصلی
        const darbBasteh = document.getElementById("darbBasteh");
        const mamanet = document.getElementById("mamanetAzAnjamKar");

        // چک‌باکس‌هایی که باید غیرفعال بشن
        const disableCheckboxes = [
            "moghayratFazBaAmper",
            "dastkariDarKontor",
            "kontorKharabAst",
            "barghGheyrMojazAzShabakeh"
        ].map(id => document.getElementById(id));

        function toggleDisable() {
            const shouldDisable = darbBasteh.checked || mamanet.checked; // OR منطقی
            disableCheckboxes.forEach(cb => {
                cb.disabled = shouldDisable;
                if (shouldDisable) cb.checked = false; // تیک‌ها رو هم پاک کن
            });
        }

        darbBasteh.addEventListener("change", toggleDisable);
        mamanet.addEventListener("change", toggleDisable);
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // چک‌باکس‌های اصلی
            const darbBasteh = document.getElementById("darbBasteh");
            const mamanet = document.getElementById("mamanetAzAnjamKar");

            // چک‌باکس‌هایی که باید غیرفعال بشن
            const disableCheckboxes = [
                "moghayratFazBaAmper",
                "dastkariDarKontor",
                "kontorKharabAst",
                "barghGheyrMojazAzShabakeh"
            ].map(id => document.getElementById(id));

            function toggleDisable() {
                const shouldDisable = darbBasteh.checked || mamanet.checked;
                disableCheckboxes.forEach(cb => {
                    cb.disabled = shouldDisable;
                    if (shouldDisable) cb.checked = false;
                });
            }

            // اجرا روی لود اولیه
            toggleDisable();

            // اجرا روی تغییرات
            darbBasteh.addEventListener("change", toggleDisable);
            mamanet.addEventListener("change", toggleDisable);
        });
    </script>

</body>
