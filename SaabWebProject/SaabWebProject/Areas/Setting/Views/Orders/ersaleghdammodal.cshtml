<script>
    // وقتی صفحه بارگذاری شد، تاریخ میلادی را به شمسی تبدیل کن
    window.addEventListener("DOMContentLoaded", function () {

        var input = document.getElementById("datepickerFrom_shw1");
        var miladi = input.value;
        if (miladi) {
            var parts = miladi.split('/'); // yyyy/MM/dd
            var gYear = parseInt(parts[0]);
            var gMonth = parseInt(parts[1]);
            var gDay = parseInt(parts[2]);

            // تبدیل میلادی به شمسی با jalaali.js
            var j = jalaali.toJalaali(gYear, gMonth, gDay);
            input.value = j.jy + '/' + String(j.jm).padStart(2, '0') + '/' + String(j.jd).padStart(2, '0');
        }
    });

    // وقتی کاربر تاریخ را تغییر داد، hidden input را آپدیت کن
    var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
    inputs.forEach(function (el) {
        el.addEventListener("jdp:change", function () {
            var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
            if (!this.value) {
                miladiInput.value = "";
                return;
            }
            var parts = this.value.split('/');
            var g = jalaali.toGregorian(parseInt(parts[0]), parseInt(parts[1]), parseInt(parts[2]));
            miladiInput.value = g.gy + '-' + g.gm + '-' + g.gd;
        });
    });

</script>
