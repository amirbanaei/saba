<script>
    $(document).ready(function () {
        $("#NAMDOREH").picker({ search: true });

    });
</script>
<script>

$("#dwn").click(function () {
    const NAMDOREH = document.getElementById("NAMDOREH")?.value;

    if (!NAMDOREH) {
        alert("لطفاً نام دوره را وارد کنید.");
        return;
    }

    $.ajax({
        beforeSend: function () {
            document.getElementById("loading-message").style.display = "block";
        },
        type: 'GET',
        dataType: 'html',
        success: function (res) {
            if (res === "False") {
                alert("برای این ماه و این سال این بسته تایید نهایی شده است");
                window.location.reload();
            } else {
                document.getElementById("loading-message").style.display = "none";
                const urlBase = '@Url.Action("EXCEL_GOZARESHONEARZYABI", "Orders", new { area = "Setting" })';
                window.location = urlBase + '?NAMDOREH=' + encodeURIComponent(NAMDOREH);
            }
        },
        error: function (res) {
            alert("خطا در ارتباط با سرور");
            console.log(res);
        }
    });
});
</script>
