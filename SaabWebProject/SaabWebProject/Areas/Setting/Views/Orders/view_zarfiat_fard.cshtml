@using SaabWebProject.Models.DomainModels;

@{
    ViewBag.Title = "ظرفیت افراد ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    SaabEntities db = new SaabEntities();
}

<div class="row">

    <div class="col-xl-4">
        <label class="form-label">نام کاربر</label>
        <select class="form-select select_peymanhazf" id="selecthazfpymn" name="selecthazf">
            <option hidden value="0">انتخاب مورد</option>
            @foreach (var item in db.tbUsers.ToList())
            {
                <option value="@item.usr_ID">@item.FullName _ @item.usr_Personal_ID</option>
            }
        </select>
    </div>

    <div class="col-xl-4">
        <label class="form-label">شغل کاربر</label>
        <select class="form-select valujob" id="valujob" name="valujob">
            <option value="1">عادی</option>
            <option value="2">دیماندی</option>
            <option value="3">سایر</option>

        </select>
    </div>
    <div class="col-xl-4">
        <label class="form-label">وضعیت  کاربر</label>
        <select class="form-select vaziatperson" id="vaziatperson" name="vaziatperson">
            <option value="1">فعال</option>
            <option value="2">غیر فعال</option>
        </select>
    </div>
    <div class="col-xl-2">
        <label class="form-label">کد منطقه 1</label>
        <input class="form-control" id="numbersoart1" value="0" />
    </div>

    <div class="col-xl-2">
        <label class="form-label">کد منطقه 2</label>
        <input class="form-control" id="numbersoart2" value="0" />
    </div>

    <div class="col-xl-2">
        <label class="form-label">کد منطقه 3</label>
        <input class="form-control" id="numbersoart3" value="0" />
    </div>

    <div class="col-xl-2">
        <label class="form-label">کد منطقه 4</label>
        <input class="form-control" id="numbersoart4" value="0" />
    </div>

    <div class="col-xl-2">
        <label class="form-label">کد منطقه 5</label>
        <input class="form-control" id="numbersoart5" value="0" />
    </div>

    <div class="col-xl-2">
        <label class="form-label">کد منطقه 6</label>
        <input class="form-control" id="numbersoart6" value="0" />
    </div>

</div>

<div class="row mt-3">
    <div class="col-xl-11"></div>
    <div class="col-xl-1">
        <button class="btn form-control buttonGeneral" id="btnhazf" type="button">
