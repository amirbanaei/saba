<script>
    $(document).ready(function () {
                                $("#upload10").click(function () {





      $("#summery_file10").click();

        });
       fd3 = new FormData();

$("#summery_file10").change(function (e) {
             $.each(e.target.files, function (index, file) {
                 fd3.append("MyExcelStream", file);
             });

    sendAjax14('@Url.Action("Import_excel_zarfiat", "Orders", new { area = "Setting" })', fd3);
});

        function sendAjax14(url2, fd2) {

            document.getElementById("loading-circle").style.display = "block";


    $.ajax({
        url: url2,
        type: 'POST',
        data: fd2,
        processData: false,
        contentType: false,
        success: function (res) {
            document.getElementById("loading-circle").style.display = "none";

            $("#loading-message").css("display", "none");
            fd = new FormData();
            console.log(res);
            console.log("jj");

            if (res == "True") {
                alert("با موفقیت ثبت شد ");
            //    location.reload();
            }
                   @*$("#table_div").load('@Url.Content("../defFacilitiesEquipment/_ListEquipmentMoalefeValue")');*@



        },
        error: function (res) {
            $("#loading-message").css("display", "none");
            console.log(res);
            console.log("jj");
            Toast.fire({
                icon: 'success',
                background: '#35434A',
                color: 'white',
                title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
            }).then(() => {
                $("#loading-message").css("display", "none");
            });
        }
    });
}
        $("#selecthazfpymn").picker({ search: true });

        $('#btnhazf').click(function () {

            var fkusr = $('#selecthazfpymn').val();
            var job = $('#valujob').val();

            var mantagheh1 = $('#numbersoart1').val() || 0;
            var mantagheh2 = $('#numbersoart2').val() || 0;
            var mantagheh3 = $('#numbersoart3').val() || 0;
            var mantagheh4 = $('#numbersoart4').val() || 0;
            var mantagheh5 = $('#numbersoart5').val() || 0;
            var mantagheh6 = $('#numbersoart6').val() || 0;
            var vaziatperson = $('#vaziatperson').val() || 0;

            if (fkusr == "0" || fkusr == null || fkusr == "") {
                alert('لطفاً کاربر را انتخاب کنید.');
                return;
            }

            var url = '/Setting/Orders/create_sabt'
                + '?fkusr=' + fkusr
                + '&job=' + job
                + '&mantagheh1=' + mantagheh1
                + '&mantagheh2=' + mantagheh2
                + '&mantagheh3=' + mantagheh3
                + '&mantagheh4=' + mantagheh4
                + '&mantagheh5=' + mantagheh5
                + '&vaziatperson=' + vaziatperson

                + '&mantagheh6=' + mantagheh6;

            $.ajax({
                type: 'GET',
                url: url,
                success: function (response) {
                    if (response === "TRue") {
                        alert('عملیات موفق بود.');
                    } else {
                        alert('پاسخ: ' + response);
                    }
                },
                error: function () {
                    alert('خطا در انجام درخواست.');
                }
            });
        });
    });
</script>
