<script>
    $("#loadExcelFromServer11").click(function () {

    $.ajax({
        url: '@Url.Action("CopySheetValues", "Orders", new { area = "Setting" })',
        type: 'GET',
        success: function (res) {

            if (!res.success) {
                alert(res.message);
                return;
            }

            generateTable(res.data);
        },
        error: function () {
            alert("خطا در دریافت فایل");
        }
    });

});
$("#loadExcelFromServer").click(function () {

    $.ajax({
        url: '@Url.Action("PreviewExcelFromServer", "Orders", new { area = "Setting" })',
        type: 'GET',
        success: function (res) {

            if (!res.success) {
                alert(res.message);
                return;
            }

            generateTable(res.data);
        },
        error: function () {
            alert("خطا در دریافت فایل");
        }
    });

});

function generateTable(data) {

    var html = "<table class='table table-bordered table-striped'>";

    for (var i = 0; i < data.length; i++) {

        html += "<tr>";

        for (var j = 0; j < data[i].length; j++) {

            if (i == 0)
                html += "<th>" + (data[i][j] ?? "") + "</th>";
            else
                html += "<td>" + (data[i][j] ?? "") + "</td>";
        }

        html += "</tr>";
    }

    html += "</table>";

    $("#excelPreviewContainer").html(html);
}

</script>

<script>

    $("#previewExcel").click(function () {
        $("#excelPreviewInput").click();
    });

    $("#excelPreviewInput").change(function (e) {

        var file = e.target.files[0];
        if (!file) return;

        var reader = new FileReader();

        reader.onload = function (e) {

            var data = new Uint8Array(e.target.result);
            var workbook = XLSX.read(data, { type: 'array' });

            var firstSheet = workbook.Sheets[workbook.SheetNames[0]];

            var excelData = XLSX.utils.sheet_to_json(firstSheet, { header: 1 });

            generateTable(excelData);
        };

        reader.readAsArrayBuffer(file);
    });

    function generateTable(data) {

        var html = "<table class='table table-bordered table-striped'>";

        for (var i = 0; i < data.length; i++) {

            html += "<tr>";

            for (var j = 0; j < data[i].length; j++) {

                if (i == 0)
                    html += "<th>" + (data[i][j] ?? "") + "</th>";
                else
                    html += "<td>" + (data[i][j] ?? "") + "</td>";
            }

            html += "</tr>";
        }

        html += "</table>";

        $("#excelPreviewContainer").html(html);
    }

</script>

