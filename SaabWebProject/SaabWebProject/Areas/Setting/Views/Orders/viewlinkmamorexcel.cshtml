<script>




    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#myModal3").addClass("fade-in"); // Add the fade-in class
            $("#myModal3").css("display", "block");
        });

        $(".close").click(function () {
            $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
            $("#myModal3").css("display", "none");
            location.reload();
        });

        $(window).click(function (event) {
            if (event.target == $("#myModal3")[0]) {
                $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
                $("#myModal3").css("display", "none");
            }
        });
    });
    var obj = new FormData();
    $("input[name='MyExcelStream']").change(function () {
    var file = this.files[0];
    var ext = file.name.split('.').pop().toLowerCase();
        document.getElementById("loading-circle").style.display = "block";

    if (ext === "xlsx" || ext === "xls") {
        //var obj = new FormData();
        obj.append("MyExcelStream", file);

        $.ajax({
            url: "@Url.Action("PreviewExcel", "Orders", new { area = "Setting" })",
            type: "post",
            contentType: false,
            data: obj,
            processData: false,
            success: function (res) {
                document.getElementById("loading-circle").style.display = "none";

                if (res.success) {
                    // ساخت جدول برای نمایش رکوردها
                    // ساخت جدول برای نمایش رکوردها
                    var html = "<div style='max-height:400px; overflow-y:auto;'>" +  // 👈 قاب اسکرول
                        "<table class='table table-bordered' style='background-color:black; color:white;'>" +
                        "<thead><tr>" +
                        "<th>unic</th><th>شغل</th><th>کد پرسنلی</th><th>نام و نام خانوادگی</th><th>ماه</th><th>سال</th>" +
                        "</tr></thead><tbody>";

                    res.preview.forEach(function (r) {
                        html += "<tr>" +
                            "<td>" + r.unic + "</td>" +
                            "<td>" + r.Job + "</td>" +
                            "<td>" + r.FK_usr + "</td>" +
                            "<td>" + r.FullName + "</td>" +
                            "<td>" + r.month + "</td>" +
                            "<td>" + r.year + "</td>" +
                            "</tr>";
                    });

                    html += "</tbody></table></div>"; // 👈 بسته شدن قاب اسکرول


                    // نمایش داخل SweetAlert
                    Swal.fire({
                        title: "پیش‌نمایش 30 رکورد اول",
                        html: html,
                        width: "800px",
                        showCancelButton: true,
                        confirmButtonText: "تأیید و ذخیره",
                        cancelButtonText: "لغو"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // 📌 اگر کاربر تایید کرد، همون فایل رو دوباره برای اکشن اصلی بفرست
                            var obj2 = new FormData();
                            obj2.append("MyExcelStream", file);
                            document.getElementById("loading-circle").style.display = "block";

                            $.ajax({
                                url: "@Url.Action("createmarhaleh1editlonkmamor", "Orders", new { area = "Setting" })",
                                type: "post",
                                contentType: false,
                                data: obj2,
                                processData: false,
                                success: function (res2) {
                                    document.getElementById("loading-circle").style.display = "none";
                                    var data = JSON.parse(res2);

                                    if (data.success) {
                                        // ساخت جدول 30 رکورد آخر
                                        var html = "<div style='max-height:400px; overflow-y:auto;'>" +
                                            "<table class='table table-bordered' style='background-color:black; color:white;'>" +
                                            "<thead><tr>" +
                                            "<th>unic</th><th>کد پرسنلی</th><th>نام و نام خانوادگی</th><th>ماه</th><th>سال</th>" +
                                            "</tr></thead><tbody>";

                                        data.lastRecords.forEach(function (r) {
                                            html += "<tr>" +
                                                "<td>" + r.unic + "</td>" +
                                                "<td>" + r.PersonalID + "</td>" +
                                                "<td>" + r.FullName + "</td>" +
                                                "<td>" + r.month + "</td>" +
                                                "<td>" + r.year + "</td>" +
                                                "</tr>";
                                        });

                                        html += "</tbody></table></div>";

                                        Swal.fire({
                                            title: data.message,
                                            html: html,
                                            width: "800px",
                                            icon: "success"
                                        });
                                    } else {
                                        Swal.fire("خطا", data.message, "error");
                                    }
                                },

                                error: function (err) {
                                    document.getElementById("loading-circle").style.display = "none";

                                    Swal.fire("خطا", err.responseText, "error");
                                }
                            });
                        }
                    });
                } else {
                    Swal.fire("خطا", res.message, "error");
                }
            }
        });
    } else {
        Swal.fire("خطا", "فقط فایل اکسل قابل قبول است", "warning");
    }
});

