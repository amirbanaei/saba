
@{
    ViewBag.Title = "گزارش";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>GozareshVosoolVaMamoorin</title>
    <style>
        .calendar-box {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 6px;
        }

        .day {
            background: #2b3b50;
            width: 31px;
            height: 35px;
            color: white;
            text-align: center;
            align-content: center;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.2s;
            border: 0px solid white;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            margin: 2px;
        }

            .day:hover {
                background: #3e506a;
                transform: scale(1.05);
            }

            /* روز انتخاب شده توسط کاربر */
            .day.selected {
                background: #078F00;
            }

            /* روزهای ثبت شده */
            .day.registered {
                border-width: 1px;
                border-color: #078F00;
                color: white;
            }

        .tableH_Lock {
            max-height: 533px;
            /*height: 533px;*/
        }

        thead {
            position: sticky;
            top: 0;
            text-align: center;
            z-index: 2;
        }

        .inputFilter {
            margin-bottom: 0px !important;
        }

        thead th {
            vertical-align: middle;
        }
    </style>
</head>
<body>
    <ul class="nav nav-tabs nav-tabs-v2 ps-4 pe-4" id="pills-tab" style="margin-bottom:30px">
        <li class="nav-item me-3">
            <a href="#page1" class="nav-link active" data-bs-toggle="tab">
                <button class=" nav-btn">گزارش وصول </button>
            </a>
        </li>
        <li class="nav-item me-3">
            <a href="#page2" class="nav-link " data-bs-toggle="tab">
                <button class=" nav-btn">سایر عملکرد مامورین</button>
            </a>
        </li>
    </ul>
    <div class="tab-content p-2">
        <div class="tab-pane show active" id="page1">
            <div class="card">
                <div class="card-body pb-2">
                    <div class="row" style="margin-top:10px;">
                        <div class="col-xl-2">
                            <div class="form-group mb-3">
                                <label class="form-label">ماه</label>
                                <select class="form-select my_Select" id="Month">
                                    <option value="0">انتخاب کنید..</option>
                                    <option value="1">فروردین</option>
                                    <option value="2">اردیبهشت</option>
                                    <option value="3">خرداد</option>
                                    <option value="4">تیر</option>
                                    <option value="5">مرداد</option>
                                    <option value="6">شهریور</option>
                                    <option value="7">مهر</option>
                                    <option value="8">آبان</option>
                                    <option value="9">آذر</option>
                                    <option value="10">دی</option>
                                    <option value="11">بهمن</option>
                                    <option value="12">اسفند</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-xl-2">
                            <label class="form-label">سال</label>
                            <select id="Year" name="year_Eq" class="form-select">
                                <option value="0">انتخاب کنید</option>
                                @{
                                    System.Globalization.PersianCalendar cs2 = new System.Globalization.PersianCalendar();
                                    int currentYear = cs2.GetYear(DateTime.Now);
                                    for (var i = 4; i >= 0; i--)
                                    {
                                        var s = DateTime.Now.AddYears(-i);
                                        <option value="@cs2.GetYear(s)">@cs2.GetYear(s)</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-xl-2" id="dayInputContainer" style="position:relative; display:none;">
                            <label class="form-label">روز</label>
                            <input id="DayInput" class="form-control" readonly />
                            <div id="calendarDiv" style="display:none; padding:0px; position:absolute; top:100%; left:0; z-index:1000;">
                                <div class="form-control" style="border-width: 2px; border-color: var(--bs-border-input-color); border-radius:8px; padding:5px;">
                                    <div class="calendar-box"></div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-1"></div>

                        <div class="col-xl-1">
                            <button id="MoshahedehJadval" type="button" class="btn form-control buttonsabt">
                                <i class="bi bi-eye fa-fw me-1 VecGeneral"></i>
                                <span class="bSabt-text">مشاهده</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-arrow">
                    <div class="card-arrow-top-left"></div>
                    <div class="card-arrow-top-right"></div>
                    <div class="card-arrow-bottom-left"></div>
                    <div class="card-arrow-bottom-right"></div>
                </div>
            </div>
            <div class="table-responsive tableH_Lock" style="margin-top:10px; display:none;">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">

                            <th>
                                @Html.DisplayName("بدهی مشترک از (ریال)")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter01-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("بدهی مشترک تا (ریال)")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter02-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("نوع اشتراک")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("استاندارد انجام کار در روز (مطابق کارسنجی)")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter04-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("تعداد کار ارجاع شده ")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter05-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("مبلغ ارجاع شده (ریال)")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter06-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("تعداد وصول انجام شده")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter07-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("مبلغ وصول شده (ریال)")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter08-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("معادل کار")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter09-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int counter = 0;}
                        @if (Model != null)
                        {

                            foreach (var item in Model)
                            {
                                <tr class="task-list-row ">

                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
            <link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
            <script src="~/Scripts/jquery-ui.js"></script>
            <script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
            <script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
            <script src="~/Scripts/jquery-ui.js"></script>
            <script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>
            <script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
            <script src="~/Scripts/jquery-ui.js"></script>
            <script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>
            <script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
            <script src="~/Assets/plugins/apexcharts/dist/apexcharts.min.js"></script>
            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
            <script>
    const monthSelect = $('#Month');
    const yearSelect = $('#Year');
    const dayInput = $('#DayInput');
    const dayInputContainer = $('#dayInputContainer');
    const calendarDiv = $('#calendarDiv');
    const calendarBox = calendarDiv.find('.calendar-box');

    const btnMoshahedeh = $('#MoshahedehJadval');
    const tableContainer = $('.tableH_Lock');

    let registeredDays = [];

    function checkMonthYear() {
        if (monthSelect.val() !== "0" && yearSelect.val() !== "0") {
            console.log("dssdad");

            dayInputContainer.show();

            // AJAX call به بک‌اند
            $.ajax({
                url: '@Url.Action("GetRegisteredDays", "Orders", new { area = "Setting" })',
                type: 'POST',
                data: {
                    Month: monthSelect.val(),
                    Year: yearSelect.val()
                },
                success: function (data) {
                    registeredDays = data;
                    generateCalendar();
                },
                error: function (err) {
                    console.error("خطا در دریافت روزهای ثبت شده:", err);
                    registeredDays = [];
                    generateCalendar();
                }
            });

        } else {
            dayInputContainer.hide();
            calendarDiv.hide();
            dayInput.val('');
        }
    }

    monthSelect.on('change', checkMonthYear);
    yearSelect.on('change', checkMonthYear);

    dayInput.on('click', function () {
        calendarDiv.show();
        generateCalendar();
    });

    function generateCalendar() {
        calendarBox.html('');
        for (let i = 1; i <= 30; i++) {
            const d = $('<div>').addClass('day').text(i);

            if (registeredDays.includes(i)) {
                d.addClass('registered').on('click', function () {
                    dayInput.val(`${yearSelect.val()}/${monthSelect.val()}/${i}`);
                    calendarDiv.hide();
                });
            } else {
                d.css({
                    opacity: 0.3,
                    cursor: 'not-allowed',
                    pointerEvents: 'none'
                });
            }

            calendarBox.append(d);
        }
    }
btnMoshahedeh.on('click', function () {
    if (monthSelect.val() !== "0" && yearSelect.val() !== "0" && dayInput.val() !== "") {
        $.ajax({
            url: '@Url.Action("GetReportData", "Orders", new { area = "Setting" })',
            type: 'POST',
            data: {
                Month: monthSelect.val(),
                Year: yearSelect.val(),
                Day: dayInput.val().split('/')[2] // استخراج روز
            },
            success: function(data) {
                // پاک کردن tbody
                tableContainer.find('tbody').html('');

                // ایجاد ردیف‌ها
                data.forEach(function(item) {
                    const row = `<tr class="task-list-row">
                        <td>${item.startvalue.toLocaleString()}</td>
                        <td>${item.endvalue.toLocaleString()}</td>
                        <td>${item.type}</td>
                        <td>${item.estandard.toLocaleString()}</td>
                        <td>${item.count.toLocaleString()}</td>
                        <td>${item.sum_vosol.toLocaleString()}</td>
                        <td>${item.count.toLocaleString()}</td>
                        <td>${item.sum_vosol.toLocaleString()}</td>
                        <td>${item.vosol_equivalent.toLocaleString()}</td>
                    </tr>`;
                    tableContainer.find('tbody').append(row);
                });

                tableContainer.show();
            },
            error: function(err) {
                console.error("خطا در دریافت داده‌ها:", err);
            }
        });
    } else {
        alert("لطفاً ماه، سال و روز را انتخاب کنید.");
    }
});



    $(document).on('click', function (event) {
        if (!dayInputContainer.is(event.target) && dayInputContainer.has(event.target).length === 0) {
            calendarDiv.hide();
        }
    });
            </script>












        </div>
        <div class="tab-pane" id="page2">
            <div class="table-responsive tableH_Lock" style="margin-top:10px;">
                <table class="table table-hover text-nowrap">
