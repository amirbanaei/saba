<script>
    function updateSum() {
        let sum = 0;
        $(".vazn-input").each(function () {
            let val = parseFloat($(this).val()) || 0;
            sum += val;
        });

        $("#sumVazn").text(sum);

        if (sum > 100) {
            $("#sumVazn").css("color", "red");
        } else {
            $("#sumVazn").css("color", "green");
        }

        return sum;
    }

    $(document).on("input", ".vazn-input", function () {
        updateSum();
    });

    // محاسبه اولیه جمع
    $(document).ready(function () {
        updateSum();
    });

    // ذخیره همه با دکمه
    // ذخیره همه با دکمه
    $("#saveAll").click(function () {
        let sum = updateSum();
        if (sum > 100) {
            Swal.fire({
                icon: 'error',
                title: 'خطا',
                text: 'جمع درصدها نباید بیشتر از 100 شود!',
                confirmButtonText: 'باشه'
            });
            return;
        }

        let data = [];
        $(".vazn-input").each(function () {
            let id = $(this).data("id");
            let name = $(this).data("name");
            let vazn = $(this).val();
            let del = $(`.del-checkbox[data-id='${id}']`).is(":checked"); // گرفتن وضعیت چک‌باکس

            data.push({
                ID: id,
                Name: name,
                Vazn: vazn,
                Del: del
            });
        });

        $.ajax({
            url: '/Setting/Orders/SaveAllVazn',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (res) {
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'موفقیت',
                        text: 'همه موارد ذخیره شد',
                        confirmButtonText: 'باشه'
                    });
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'هشدار',
                        text: res.message,
                        confirmButtonText: 'باشه'
                    });
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'خطا',
                    text: 'خطا در ارسال اطلاعات',
                    confirmButtonText: 'باشه'
                });
            }
        });
    });

</script>
<script>

    var
        filters = {
            filter01: null,
            filter02: null,
            filter03: null,
            filter04: null,
            filter05: null,
            filter06: null,
        };

    function updateFilters() {
        $('.task-list-row').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter(filterName) {
        filters[filterName] = this.value;
        updateFilters();
    }

    // Assigned User Dropdown Filter
    $('#filter01-filter').on('input', function () {
        changeFilter.call(this, 'filter01');
    });
    $('#filter02-filter').on('input', function () {
        changeFilter.call(this, 'filter02');
    });
    $('#filter03-filter').on('input', function () {
        changeFilter.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilter.call(this, 'filter04');
    });
    $('#filter05-filter').on('input', function () {
        changeFilter.call(this, 'filter05');
    });
    $('#filter06-filter').on('input', function () {
        changeFilter.call(this, 'filter06');
    });


</script>
