    <style>
        div.form-control {
            border-width: 2px;
            border-color: rgb(0, 163, 250);
            border-radius: 8px;
            height: 100%;
            background-color: rgb(8, 45, 89);
        }

        .row {
            height: 300px;
        }

        .part-title {
            background-color: #007bff;
            text-align: center;
            align-content: center;
            align-items: baseline;
            padding: 2px 5px 5px 5px;
            border-radius: 5px;
            margin-top: 3px;
        }

        .part-body {
            display: flex;
            flex-direction: column;
            background-color: #007bff;
            height: 84%;
            margin-top: 10px;
            border-radius: 5px;
        }

        .part-body-row {
            display: flex;
            flex-direction: row;
            gap: 10px;
            padding: 5px;
            height: calc(100%/3);
        }

            .part-body-row:first-child {
                height: 60%;
            }



        .part-body-data {
            width: calc(100% / 4);
            text-align: center;
            padding: 2px;
            align-content: center;
            /*            border: 1px solid white;*/
            background-color: rgb(8, 45, 89);
            border-radius: 5px;
        }

