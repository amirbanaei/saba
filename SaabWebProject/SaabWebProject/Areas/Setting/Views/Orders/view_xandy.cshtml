            { name: 'خط دیتا', data: data, color: 'blue' },   // خط وسط
            { name: 'حد پایین', data: lower, color: 'green' }          // خط پایین
        ],
        stroke: { curve: 'smooth', width: 1 },  // حالت خمیدگی خطوط و ضخامت آنها
        fill: { type: 'solid', opacity: 0.3 },  // پر شدن خطوط با رنگ (opacity برای شفافیت)
        xaxis: {
            categories: ['فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور', 'مهر'], // لیبل‌های محور X
