                }
            },
            axisBorder: { show: false },  // نمایش/عدم نمایش خط پایین محور X
            axisTicks: { show: false }    // نمایش/عدم نمایش تیک‌های محور X
        },
        yaxis: {
            labels: {
                style: {
                    colors: '#ffffff',              // رنگ لیبل‌های Y
