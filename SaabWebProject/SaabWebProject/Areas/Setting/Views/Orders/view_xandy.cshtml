@*@{
            ViewBag.Title = "Go to Location";
        }

        <h2>Go to Google Maps</h2>

        <form id="mapForm" onsubmit="goToMap(); return false;">
            <label>Latitude:</label>
            <input type="text" id="lat" placeholder="مثلاً 35.6892" required />
            <br />
            <label>Longitude:</label>
            <input type="text" id="lng" placeholder="مثلاً 51.3890" required />
            <br />
            <button type="submit">Go to Location</button>
        </form>

        <script>
        function goToMap() {
            var lat = document.getElementById('lat').value;
            var lng = document.getElementById('lng').value;

            if(lat && lng){
                var url = 'https://www.google.com/maps?q=' + encodeURIComponent(lat) + ',' + encodeURIComponent(lng);
                window.location.href = url;
            } else {
                alert("لطفاً هر دو مختصات را وارد کنید!");
            }
        }
        </script>
    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="utf-8" />
        <title>Nearest GIS Points (Real Road Distance) - Fixed</title>

        <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

        <style>
            body {
                margin: 0;
                display: flex;
                height: 100vh;
                font-family: sans-serif;
            }

            #map {
                flex: 1;
            }

            #panel {
                width: 360px;
                max-width: 40%;
                background: #fff;
                box-shadow: 0 0 8px rgba(0,0,0,0.2);
                padding: 10px;
                overflow: auto;
            }

            #status {
                margin-bottom: 10px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

                table th, table td {
                    border: 1px solid #ddd;
                    padding: 6px;
                    text-align: left;
                }

            .small {
                font-size: 12px;
                color: #555;
            }
        </style>
    </head>

    <body>
        <div id="map"></div>
        <div id="panel">
            <div id="status">وضعیت: آماده‌سازی...</div>
            <button id="startBtn">شروع محاسبه نزدیک‌ترین‌ها (OSRM)</button>
            <div id="resultsArea"></div>
        </div>

        <script>
            // نقاط همراه با ID
            const points = [
                { id: 1, coord: [25.291758665247, 60.644739160469] },
                { id: 2, coord: [29.471318870585, 60.833265659744] },
                { id: 3, coord: [26.653929924558, 61.691340853247] },
                { id: 4, coord: [30.807520001728, 61.37862000121] },
                { id: 5, coord: [28.916195924233, 61.320723151251] },
                { id: 6, coord: [26.577004747149, 59.635116070763] },
                { id: 7, coord: [26.200244034918, 60.629287118288] },
                { id: 8, coord: [27.447302619348, 59.579367260692] },
                { id: 9, coord: [28.261787634321, 61.487407249933] },
                { id: 10, coord: [27.254310730197, 62.027496371141] },
                { id: 11, coord: [25.743364943877, 59.761214560754] },
                { id: 12, coord: [27.1261939999, 61.688211000383] },
                { id: 13, coord: [27.23871184813, 62.048361504739] },
                { id: 14, coord: [29.4914312262468, 60.7806446403265] }
            ];

            const map = L.map('map').setView([27.5, 60.5], 6);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png").addTo(map);

            // markers initial
            const markers = {};
            const bounds = [];
            points.forEach(p => {
                const m = L.marker(p.coord).addTo(map)
                    .bindPopup(`ID: ${p.id}`);
                markers[p.id] = m;
                bounds.push(p.coord);
            });
            map.fitBounds(bounds, { padding: [40, 40] });

            // ساده اما مقاوم: try/catch و بازگشت null در صورت خطا
            async function getRouteDistance(p1, p2) {
                const url =
                    `https://router.project-osrm.org/route/v1/driving/` +
                    `${p1[1]},${p1[0]};${p2[1]},${p2[0]}?overview=full&geometries=geojson`;

                try {
                    const res = await fetch(url);
                    if (!res.ok) {
                        console.warn('OSRM non-ok response:', res.status);
                        return null;
                    }
                    const data = await res.json();
                    if (!data.routes || data.routes.length === 0) return null;
                    return {
                        distance: data.routes[0].distance, // meters
                        geometry: data.routes[0].geometry
                    };
                } catch (err) {
                    console.warn('OSRM fetch error:', err);
                    return null;
                }
            }

            // asyncPool کوچک برای محدود کردن concurrency (maxConcurrent)
            // from: common async pool pattern
            async function asyncPool(iterable, workerFn, maxConcurrent = 4) {
                const ret = [];
                const executing = [];
                for (const item of iterable) {
                    const p = Promise.resolve().then(() => workerFn(item));
                    ret.push(p);
                    executing.push(p);
                    const clean = () => {
                        const idx = executing.indexOf(p);
                        if (idx > -1) executing.splice(idx, 1);
                    };
                    p.then(clean).catch(clean);
                    if (executing.length >= maxConcurrent) {
                        await Promise.race(executing);
                    }
                }
                return Promise.all(ret);
            }

            // محاسبه نزدیک‌ترین برای یک نقطه با محدودیت همزمانی برای درخواست‌ها
            async function findNearestForPoint(p, others, progressCallback) {
                // worker for a single target q
                const tasks = others.map(q => {
                    return async () => {
                        const route = await getRouteDistance(p.coord, q.coord);
                        if (progressCallback) progressCallback(p.id);
                        return { q, route };
                    };
                });

                // run with pool: max concurrent = 4
                const results = await asyncPool(tasks, fn => fn(), 4);

                // filter valid routes
                const valid = results.filter(r => r.route && typeof r.route.distance === 'number');

                if (valid.length === 0) return null;

                // pick minimum
                valid.sort((a, b) => a.route.distance - b.route.distance);
                const best = valid[0];
                return {
                    from: p.id,
                    to: best.q.id,
                    distanceMeters: best.route.distance,
                    geometry: best.route.geometry
                };
            }

            // محاسبه برای همه با نمایش پیشرفت
            async function calculateNearestForAll(onProgress) {
                const results = [];
                let completed = 0;
                for (const p of points) {
                    onProgress && onProgress({ type: 'start-point', id: p.id, completed });
                    const others = points.filter(x => x.id !== p.id);
                    const res = await findNearestForPoint(p, others, (pid) => {
                        // optional per-request progress - can be noisy
                    });
                    completed++;
                    onProgress && onProgress({ type: 'done-point', id: p.id, index: completed });
                    if (res) results.push(res);
                    else results.push({ from: p.id, to: null, distanceMeters: null, geometry: null });
                }
                return results;
            }

            // مدیریت UI و رسم نتایج
            let drawnLayers = [];
            function clearDrawn() {
                drawnLayers.forEach(l => map.removeLayer(l));
                drawnLayers = [];
            }

            //function renderResults(results) {
            //    clearDrawn();
            //    const area = document.getElementById('resultsArea');
            //    area.innerHTML = '';

            //    const tbl = document.createElement('table');
            //    tbl.innerHTML = `<thead><tr><th>From</th><th>To</th><th>Distance (km)</th></tr></thead>`;
            //    const tbody = document.createElement('tbody');

            //    results.forEach(r => {
            //        const tr = document.createElement('tr');
            //        const distKm = r.distanceMeters != null ? (r.distanceMeters / 1000).toFixed(2) : '-';
            //        tr.innerHTML = `<td>${r.from}</td><td>${r.to || '-'}</td><td>${distKm}</td>`;
            //        tbody.appendChild(tr);

            //        // popup update for marker
            //        const m = markers[r.from];
            //        if (m) {
            //            const popupText = `ID: ${r.from}<br>نزدیک‌ترین: ${r.to || '-'}<br>فاصله واقعی: ${distKm}`;
            //            m.bindPopup(popupText);
            //        }

            //        // draw line if geometry exists
            //        if (r.geometry) {
            //            const line = L.geoJSON(r.geometry, { color: 'red', weight: 3, opacity: 0.8 }).addTo(map);
            //            drawnLayers.push(line);
            //        }
            //    });

            //    tbl.appendChild(tbody);
            //    area.appendChild(tbl);

            //    console.log('Nearest results:', results);
            //    document.getElementById('status').innerText = 'پایان: نتایج در جدول نمایش داده شد و مسیرها روی نقشه رسم شدند.';
            //}

            // UI handlers
            const startBtn = document.getElementById('startBtn');
            const statusEl = document.getElementById('status');

            startBtn.addEventListener('click', async () => {
                startBtn.disabled = true;
                statusEl.innerText = 'در حال محاسبه... هر درخواست ممکن است چند ثانیه طول بکشد. لطفاً صبور باش (حداکثر concurrency=4).';
                try {
                    const results = await calculateNearestForAll(({ type, id, index, completed }) => {
                        if (type === 'start-point') {
                            statusEl.innerText = `در حال محاسبه نزدیک‌ترین برای نقطه ${id} ... (${completed} تکمیل شده)`;
                        } else if (type === 'done-point') {
                            statusEl.innerText = `پیشرفت: ${index} از ${points.length} تکمیل شد`;
                        }
                    });
                    renderResults(results);
                } catch (err) {
                    console.error(err);
                    statusEl.innerText = 'خطا هنگام محاسبه. کنسول را بررسی کنید.';
                } finally {
                    startBtn.disabled = false;
                }
            });

            document.getElementById('status').innerText = 'آماده. برای شروع روی دکمه کلیک کن.';






            function renderResults(results) {
                clearDrawn();
                const area = document.getElementById('resultsArea');
                area.innerHTML = '';

                const tbl = document.createElement('table');
                tbl.innerHTML = `<thead><tr><th>From</th><th>To</th><th>Distance (km)</th></tr></thead>`;
                const tbody = document.createElement('tbody');

                results.forEach(r => {
                    const tr = document.createElement('tr');
                    const distKm = r.distanceMeters != null ? (r.distanceMeters / 1000).toFixed(2) : '-';
                    tr.innerHTML = `<td>${r.from}</td><td>${r.to || '-'}</td><td>${distKm}</td>`;
                    tbody.appendChild(tr);

                    // popup update for marker
                    const m = markers[r.from];
                    if (m) {
                        const popupText = `ID: ${r.from}<br>نزدیک‌ترین: ${r.to || '-'}<br>فاصله واقعی: ${distKm}`;
                        m.bindPopup(popupText);
                    }

                    // draw line if geometry exists
                    if (r.geometry) {
                        const line = L.geoJSON(r.geometry, { color: 'red', weight: 3, opacity: 0.8 });
                        line.addTo(map);
                        drawnLayers.push(line);

                        // اضافه کردن امکان کلیک روی ردیف برای نمایش مسیر
                        tr.style.cursor = 'pointer';
                        tr.addEventListener('click', () => {
                            clearDrawn(); // پاک کردن مسیرهای قبلی
                            line.addTo(map); // رسم مسیر انتخاب شده
                            map.fitBounds(line.getBounds(), { padding: [40, 40] });
                        });
                    }
                });

                tbl.appendChild(tbody);
                area.appendChild(tbl);

                console.log('Nearest results:', results);
                document.getElementById('status').innerText = 'پایان: نتایج در جدول نمایش داده شد و مسیرها روی نقشه رسم شدند.';
            }

        </script>

    </body>
