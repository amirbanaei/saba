            axisBorder: { show: false },  // خط کنار محور Y
            axisTicks: { show: false }    // تیک‌های محور Y
        },
        tooltip: { enabled: false },  // نمایش/عدم نمایش پنجره اطلاعات هاور
        legend: { show: false },      // نمایش/عدم نمایش legend (راهنمای رنگ خطوط)
