        path.setAttribute('d', '');         // مسیر اولیه خالی
        path.setAttribute('fill', 'red'); // رنگ پر شدن (می‌تونی تغییرش بدی)
        path.setAttribute('opacity', '1'); // شفافیت رنگ (0 تا 1)
        svg.appendChild(path);

        // تابع برای بروزرسانی مسیر هنگام تغییر یا رندر
        function updatePath() {
            var upperPoints = chart.w.globals.seriesCords[0]; // مختصات خط بالا
