    </div>

    <script>
        const map = L.map('map').setView([27.5, 60.5], 6);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png").addTo(map);

        let drawnLayers = [];
        function clearDrawn() { drawnLayers.forEach(l => map.removeLayer(l)); drawnLayers = []; }

        function renderResults(data) {
            clearDrawn();
            const area = document.getElementById('resultsArea');
            area.innerHTML = '';

            const tbl = document.createElement('table');
            tbl.innerHTML = `<thead>
            <tr>
                <th>From</th>
                <th>Nearest (ID / Distance / Address)</th>
                <th>Farthest (ID / Distance / Address)</th>
            </tr>
        </thead>`;
            const tbody = document.createElement('tbody');

            data.forEach(r => {
                const tr = document.createElement('tr');

                const nearestText = r.NearestTo ? `${r.NearestTo} / ${(r.NearestDistance / 1000).toFixed(2)} km / ${r.NearestAddress}` : '-';
                const farthestText = r.FarthestTo ? `${r.FarthestTo} / ${(r.FarthestDistance / 1000).toFixed(2)} km / ${r.FarthestAddress}` : '-';

                tr.innerHTML = `<td>${r.From}</td><td>${nearestText}</td><td>${farthestText}</td>`;
                tbody.appendChild(tr);

                // رسم مسیر نزدیک‌ترین
                if (r.NearestTo && r.NearestDistance) {
                    const line = L.geoJSON(r.NearestGeometry || null, { color: 'green', weight: 3, opacity: 0.7 });
                    if (line) { line.addTo(map); drawnLayers.push(line); }

                    tr.addEventListener('click', () => {
                        clearDrawn();
                        if (line) { line.addTo(map); map.fitBounds(line.getBounds(), { padding: [40, 40] }); }
                    });
                }

                // رسم مسیر دورترین
                if (r.FarthestTo && r.FarthestDistance) {
                    const lineFar = L.geoJSON(r.FarthestGeometry || null, { color: 'red', weight: 3, opacity: 0.7 });
                    if (lineFar) drawnLayers.push(lineFar);

                    tr.addEventListener('click', () => {
                        clearDrawn();
                        if (lineFar) { lineFar.addTo(map); map.fitBounds(lineFar.getBounds(), { padding: [40, 40] }); }
                    });
                }
            });

            tbl.appendChild(tbody);
            area.appendChild(tbl);
            document.getElementById('status').innerText = 'نتایج بارگذاری شد.';
        }

        // فراخوانی کنترلر MVC
        async function fetchNearestPoints() {
            document.getElementById('status').innerText = 'در حال دریافت نتایج...';
            try {
                const res = await fetch('/Setting/seegozaresh/NearestPoints');
                const data = await res.json();
                renderResults(data);
            } catch (err) {
                console.error(err);
                document.getElementById('status').innerText = 'خطا در دریافت نتایج!';
            }
        }

        document.getElementById('startBtn').addEventListener('click', fetchNearestPoints);
    </script>

</body>
