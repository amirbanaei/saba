                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("اولویت")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter02-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th>
                                @Html.DisplayName("شرح")
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>
                                </div>
                            </th>
                            <th></th>

                        </tr>
                    </thead>


                    <tbody>
                        @foreach (var item in Model.Ticket_motaghazi1)
                        {
                            <tr style="text-align:center">
                                <td class="row-index">
                                </td>
                                <td>
                                    @{
                                        string onvan = item.OnvanDarkhast == 1 ? "رفع باگ" :
                                                       item.OnvanDarkhast == 2 ? "رفع خطا" :
                                                       item.OnvanDarkhast == 3 ? "بهبود خدمات" :
                                                       item.OnvanDarkhast == 4 ? "تولید گزارش جدید" :
                                                       item.OnvanDarkhast == 5 ? "نیاز به راهنمای" :
                                                       item.OnvanDarkhast == 6 ? "سایر" :
                                                       "نامشخص";
                                    }
                                    @onvan
                                </td>
                                <td>
                                    @{
                                        string olaviyat = item.Olaviat == 1 ? "اضطراری" :
                                                          item.Olaviat == 2 ? "بالا" :
                                                          item.Olaviat == 3 ? "متوسط" :
                                                          item.Olaviat == 4 ? "پایین" :
                                                          "نامشخص";
                                    }
                                    @olaviyat
                                </td>

                                <td class="limit-cell">
                                    @item.Sharh
                                </td>
                                <td>
                                    <button class="btn-modal-table" data-id="@item.ID">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                </td>
                            </tr>
                        }
                    </tbody>





                </table>
            </div>


        </div>
        <div class="row">
            <div class="col-xl-11"></div>
            <div class="col-xl-1">
                <button id="SabtOlaveat" type="button" class="btn form-control buttonsabt">
                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                    <span class="bSabt-text">ثبت اولویت</span>
                </button>
            </div>

        </div>
        @*<div class="card">
                <div class="card-body pb-2">

                </div>
                <div class="card-arrow">
                    <div class="card-arrow-top-left"></div>
                    <div class="card-arrow-top-right"></div>
                    <div class="card-arrow-bottom-left"></div>
                    <div class="card-arrow-bottom-right"></div>
                </div>
            </div>*@
    </div>
    <div id="mymodal3" class="modal3">
        <div class="modal-content2">
            <i class="close-icon fa fa-window-close"></i>
            <div id="ss"></div>
        </div>
    </div>

    <link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-3.3.1.js"></script>
    <script src="~/Scripts/Sortable.min.js"></script>


    <script>
/* ===== تنظیمات ===== */
var disableDrag = @Html.Raw(Json.Encode(Model.Ticket_TimBarnamenervisi4?.Select(s => s.DarDastorKar).FirstOrDefault() ?? false));
var priorityList = [];     // لیست اولویت‌ها
let firstDragDone = false; // برای نمایش اعداد بعد از اولین درگ

/* ===== شماره‌گذاری ردیف‌ها ===== */
function updateRowNumbers() {
    document.querySelectorAll("table tbody tr").forEach((tr, index) => {
        tr.querySelector(".row-index").innerText = index + 1;
    });
}

/* ===== ساخت لیست اولویت‌ها ===== */
function buildPriorityList() {
    priorityList = [];

    document.querySelectorAll("table tbody tr").forEach((tr, index) => {
        let id = tr.querySelector(".btn-modal-table").dataset.id;

        priorityList.push({
            FK_Ticket_Motaghazi1: id,
            priority: index + 1
        });
    });

    console.log("Priority List:", priorityList);
}

/* ===== راه‌اندازی Sortable ===== */
document.addEventListener("DOMContentLoaded", function () {

    var tbody = document.querySelector("table tbody");

    var sortable = Sortable.create(tbody, {
        animation: 150,
        disabled: disableDrag, // ✅ الان درست کار می‌کنه
        ghostClass: "sortable-ghost",
        chosenClass: "sortable-chosen",
        dragClass: "sortable-drag",

        onEnd: function () {
            // بعد از اولین درگ، شماره‌ها نمایش داده می‌شن
            if (!firstDragDone) {
                updateRowNumbers();
                firstDragDone = true;
            } else {
                updateRowNumbers();
            }

            // ساخت لیست اولویت‌ها
            buildPriorityList();
        }
    });

});
    </script>





    <script>
        function updateRowNumbers() {
            document.querySelectorAll("table tbody tr").forEach((tr, index) => {
                tr.querySelector(".row-index").innerText = index + 1;
            });
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const maxLength = 35;

            document.querySelectorAll(".limit-cell").forEach(cell => {

                // فقط یک بار متن کامل رو ذخیره کن
                if (!cell.dataset.fullText) {
                    cell.dataset.fullText = cell.innerText.trim();
                }

                const fullText = cell.dataset.fullText;

                if (fullText.length > maxLength) {
                    cell.innerText = fullText.substring(0, maxLength) + "...";
                }

                let tooltip = null;

                cell.addEventListener("mouseenter", function () {

                    if (fullText.length <= maxLength) return;

                    tooltip = document.createElement("div");
                    tooltip.className = "limit-tooltip";
                    tooltip.innerText = fullText;
                    document.body.appendChild(tooltip);

                    const rect = cell.getBoundingClientRect();

                    tooltip.style.left = rect.left + window.scrollX + "px";
                    tooltip.style.top =
                        rect.top + window.scrollY - tooltip.offsetHeight + 35 + "px";

                    tooltip.style.display = "block";
                });

                cell.addEventListener("mouseleave", function () {
                    if (tooltip) {
                        tooltip.remove();
                        tooltip = null;
                    }
                });
            });

        });

    </script>
    <script>

$(document).ready(function () {

    // وقتی روی هر سلول یا دکمه click2 کلیک شد، مودال باز بشه
    $(".btn-modal-table").click(function () {
        var $this = $(this);

        // موقعیت المان کلیک‌شده
        var offset = $this.offset();
        var elementHeight = $this.outerHeight();
        $("#hiddenID").val(idd);
        // نمایش مودال
        $("#mymodal3")
            .addClass("fade-in")
            .css({
                "display": "block",
                "position": "absolute",   // لازم
                "top": offset.top - elementHeight - 100 + "px", // ۵px فاصله پایین المان
            });

        // گرفتن data-id یا هر چیزی که نیاز داری
        var idd = $this.data("id");
        console.log("Clicked ID:", idd);

        // لود محتوا
        $("#ss").load('@Url.Content("/Setting/Orders/modal_BarnameRizi")?id=' + idd);
    });

    // بستن مودال با آیکون
    $(".close-icon").click(function () {
        $("#mymodal3").fadeOut();
    });

    // بستن مودال وقتی روی بک‌گراند کلیک شد
    $("#mymodal3").click(function (e) {
        if (e.target === this) {
            $(this).fadeOut();
        }
    });
});
$(document).ready(function () {
    $("#expandButton2").click(function () {
        $("#mymodal3").addClass("fade-in"); // Add the fade-in class
        $("#mymodal3").css("display", "block");
    });

    $(".close").click(function () {
        $("#mymodal3").removeClass("fade-in"); // Remove the fade-in class
        $("#mymodal3").css("display", "none");
        //location.reload();
    });

    $(window).click(function (event) {
        if (event.target == $("#mymodal3")[0]) {
            $("#mymodal3").removeClass("fade-in"); // Remove the fade-in class
            $("#mymodal3").css("display", "none");
        }
    });
})
// بستن مودال با آیکون
$(".close-icon").click(function () {
    $("#mymodal3").fadeOut(200, function () {
        location.reload();
    });
});

// بستن مودال با کلیک روی بک‌گراند
$("#mymodal3").click(function (e) {
    if (e.target === this) {
        $(this).fadeOut(200, function () {
            location.reload();
        });
    }
});

    </script>

</body>
</html>
<script>
    $("#SabtOlaveat").click(function () {

        if (priorityList.length === 0) {
            alert("هیچ اولویتی تغییر نکرده است");
            return;
        }

        $.ajax({
            url: '/Setting/Orders/SaveOlaviat',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                olaviatList: priorityList
            }),
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            }
        });
    });


</script>





