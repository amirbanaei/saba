    function addRow() {

        let index = $(".dynamic-row").length + 1;

        let newRow = `
        <div class="row dynamic-row mb-2">

            <div class="col-xl-3">
                <label class="form-label lbl-onvan">عنوان فیلد ${index}</label>
                <select class="form-select select_peyman1 sel-onvan"
                        name="select_peyman[]">
                    <option hidden value="Select">انتخاب مورد</option>
                    @foreach (var item in db.dbergharel_4_4.ToList())
                    {
                        <option value="@item.ID">@item.name</option>
                    }
                </select>
            </div>

            <div class="col-xl-3">
                <label class="form-label lbl-user">کاربر ${index}</label>
                <select class="form-select peyman-search sel-user"
                        name="select_users[]">
                    <option value="0">انتخاب کنید</option>
                    @foreach (var item in db.dbergharel4_5.ToList())
                    {
                        <option value="@item.FK_dbergharel2">@item.dbergha2.name ✅</option>
                    }
                </select>
            </div>

            <div class="col-xl-2">
                <label class="form-label lbl-op">علامت ${index}</label>
                <select class="form-select select_peyman sel-op"
                        name="SelectPeyman[]">
                    <option hidden></option>
                    <option value="1">-</option>
                    <option value="2">+</option>
                    <option value="3">*</option>
                    <option value="4">/</option>                <option value="5">=</option>
<option value="7">></option>
<option value="9"><</option>
                <option value="7">>=</option>
<option value="10">=<</option>
                    <option value="6">B</option>
                </select>
            </div>

            <div class="col-xl-2">
                <label class="form-label lbl-val">مقدار ${index}</label>
                <input class="form-control inp-val" />
            </div>

            <div class="col-xl-1">
                <label class="form-label lbl-num">عدد ${index}</label>
                <input class="form-control inp-num" />
            </div>

            <div class="col-xl-1"> <button type="button" class="btn form-control buttonsabt removeRow "> <i class="bi bi-x-circle fa-fw me-1 VecGeneral"></i> <span class="bSabt-text">افزودن</span> </button> </div>

        </div>
        `;

        $("#container5").append(newRow);
        reIndexRows(); // بعد از افزودن مرتب کن
    }

    // مرتب‌سازی شماره‌ها و id ها
    function reIndexRows() {
        $(".dynamic-row").each(function (i) {
            let idx = i + 1;

            $(this).find(".lbl-onvan").text("عنوان فیلد " + idx);
            $(this).find(".lbl-user").text("کاربر " + idx);
            $(this).find(".lbl-op").text("علامت " + idx);
            $(this).find(".lbl-val").text("مقدار " + idx);
            $(this).find(".lbl-num").text("عدد " + idx);

            $(this).find(".sel-onvan").attr("id", "select_peyman_" + idx);
            $(this).find(".sel-user").attr("id", "select_users_" + idx);
            $(this).find(".sel-op").attr("id", "SelectPeyman_" + idx);
            $(this).find(".inp-val").attr("id", "meghdar_" + idx);
            $(this).find(".inp-num").attr("id", "Olaveat_" + idx);
        });
    }

    // افزودن ردیف
    $(document).on("click", ".addFirstRow", function () {
        addRow();
    });

    // حذف ردیف
    $(document).on("click", ".removeRow", function () {
        $(this).closest(".dynamic-row").remove();
        reIndexRows(); // بعد از حذف هم مرتب کن
    });
</script>




<script>
    $("#sabt-tab1").on("click", function () {

    let rowsData = [];

    $("#rowsContainer .dynamic-row").each(function () {

        let row = {
            FK_gozaresh1: $(this).find(".select_peyman1").val(),
            FK_name: $(this).find(".peyman-search").val(),
            alamat: $(this).find(".select_peyman").val()
        };

        rowsData.push(row);
    });

    let finalData = {
        UserId: @Model.usrID,
        Rows: rowsData,
        Val1:0,
        Val2: 0,
        Val3:0
    };

    $.ajax({
        url: "/Setting/Orders/SaveOlaviat1218Calc_olaviat",
        type: "POST",
        data: JSON.stringify(finalData),
        contentType: "application/json",
        success: function (res) {
            alert("ثبت با موفقیت انجام شد");
        },
        error: function () {
            alert("خطا در ثبت اطلاعات");
        }
    });
});

let rowIndex = 0;

// تابع افزودن ردیف جدید
function addNewRow() {
    // بررسی اینکه آیا در هیچ ردیفی وضعیت برابر ۶ است
    let hasVazeat6 = false;
    $("#rowsContainer .dynamic-row").each(function () {
        let vazeatVal = $(this).find(".select_peyman").val();
        if (vazeatVal === "6" || vazeatVal === "7" || vazeatVal === "8" || vazeatVal === "10" || vazeatVal === "5" || vazeatVal === "9") {
            hasVazeat6 = true;
            return false; // خروج از حلقه
        }
    });

    if (hasVazeat6) {
        alert("شما در این حالت نمی‌توانید ردیف جدیدی اضافه کنید!");
        return;
    }

    rowIndex++;

    let newRow = `
