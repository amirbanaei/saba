<script>
$("#sabt-tab5").on("click", function () {

    let items = [];

    // 🔹 ردیف‌های داینامیک
    $(".dynamic-row").each(function () {

        let row = $(this);

        let item = {
            FK_gozaresh1: row.find(".sel-onvan").val(),
            FK_name: row.find(".sel-user").val(),
            Alamat: row.find(".sel-op").val(),
            Val1: row.find(".inp-val").val(),
            Olaviat: row.find(".inp-num").val()
        };

        if (item.FK_gozaresh1 && item.FK_name && item.Alamat) {
            items.push(item);
        }
    });

    // 🔹 ردیف اول (ثابت)
    let firstItem = {
        FK_gozaresh1: $("#onvan-tab5-1").val(),
        FK_name: $("#karbar-tab5-1").val(),
        Alamat: $("#vazeat-tab4-1").val(),
        Val1: $("#meghdar5-1").val(),
        Olaviat: $("#Olaveat5-1").val()
    };

    if (firstItem.FK_gozaresh1 && firstItem.FK_name && firstItem.Alamat) {
        items.push(firstItem);
    }

    // 🔴 اعتبارسنجی
    if (items.length === 0) {
        alert("حداقل یک ردیف معتبر وارد کنید");
        return;
    }

    let data = {
        UserId: @Model.usrID,
        Items: items
    };

    $.ajax({
        url: "/Setting/Orders/SaveOlaviatTab5",
        type: "POST",
        data: JSON.stringify(data),
        contentType: "application/json",
        success: function (res) {
            if (res.success) {
                alert("ثبت اطلاعات با موفقیت انجام شد");
            } else {
                alert(res.message);
            }
        },
        error: function () {
            alert("خطا در ارتباط با سرور");
        }
    });
});


    $("#sabt-tab3").on("click", function () {

