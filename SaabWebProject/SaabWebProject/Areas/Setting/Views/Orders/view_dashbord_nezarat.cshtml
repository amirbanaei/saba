    var waitList = Model.listmode1.Where(t => !string.Equals(t.name, "استان")).Select(x => x.count_0).ToList();   // در حال انتظار
    var sendList = Model.listmode1.Where(t => !string.Equals(t.name, "استان")).Select(x => x.count_1).ToList();   // در حال ارسال
    var doneList = Model.listmode1.Where(t => !string.Equals(t.name, "استان")).Select(x => x.count_2).ToList();   // تکمیل شده
    var delelist = Model.listmode1.Where(t => !string.Equals(t.name, "استان")).Select(x => x.count_3).ToList();   // تکمیل شده

}
