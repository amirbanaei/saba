    <script>
        var options = {
            series: [
                { name: 'حد انتظار تلفات', data: [70000, 0] },
                { name: 'درصد تلفات فعلی', data: [0, 25000] },
                { name: 'بدهی اولیه', data: [0, 10000] }
            ],

            chart: {
                type: 'bar',
                height: '100%', // بهتره عدد ثابت بدی یا تو ریسپانسیو عوضش کنی
                stacked: true,
                fontFamily: 'inherit',
                toolbar: { show: false }
            },

            plotOptions: {
                bar: {
                    horizontal: true,
                    barHeight: '50%',
                    borderRadiusApplication: 'end',
                    dataLabels: {
                        position: 'start'
                    }
                }
            },

            xaxis: {
                categories: ['حد انتظار تلفات', 'درصد تلفات فعلی'],
                labels: {
                    style: { colors: '#fff', fontSize: '12px' }
                },
                axisBorder: { show: true, color: '#fff' },
                axisTicks: { show: false },
            },

            yaxis: {
                labels: {
                    show: false,
                    style: { colors: '#fff', fontSize: '10px' },
                    offsetX: -60, // مقدار منفی زیاد توی موبایل اذیت می‌کرد، کمش کردم
                },
                axisBorder: { show: true, color: '#fff' },
                axisTicks: { show: false },
            },

            grid: { borderColor: '#1b7a7a66', strokeDashArray: 2 },

            dataLabels: {
                enabled: true,
                style: { colors: ['#fff'], fontSize: '12px' },
                formatter: val => val ? val.toLocaleString() : '', // سه رقم سه رقم جدا می‌کنه
                offsetY: -25,

                textAnchor: 'start'
            },

            tooltip: { theme: 'dark' },

            fill: { opacity: 1 },

            colors: ['#006f81', '#008541', '#b14900'],

            legend: {
                position: 'right',
                horizontalAlign: 'left',
                offsetX: 10,
                labels: { colors: '#fff' },
            },

            // --- بخش جادویی ریسپانسیو ---
            responsive: [
                {
                    breakpoint: 600,
                    options: {
                        chart: {
                            height: '100%'
                        },
                        plotOptions: {
                            bar: {
                                horizontal: false, // توی موبایل عمودی بشه که فضا باز بشه
                                columnWidth: '55%'
                            }
                        },
                        dataLabels: {

                            style: { colors: ['#fff'], fontSize: '8px' },
                            formatter: val => val ? val.toLocaleString() : '', // سه رقم سه رقم جدا می‌کنه
                            offsetY: 10,
                            offsetX: 14,

                            textAnchor: 'center'
                        },
                        legend: {
                            position: 'bottom',
                            offsetX: 0,
                            offsetY: 5,
                            show: false,
                        },
                        yaxis: {
                            labels: {
                                offsetX: -20,
                                style: { colors: ['#fff'], fontSize: '10px' }
                            }
                        },
                        xaxis: {
                            labels: {

                                rotate: -45, // کج کردن متن برای جا شدن بیشتر
                                style: { fontSize: '8px' },
                                offsetY: -5
                            }
                        }
                    }
                }
            ]
        };

        var chart = new ApexCharts(document.querySelector("#chart3"), options);
        chart.render();
    </script>
