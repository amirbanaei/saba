        .part-Pie-Bar {
            width: 100%;
            height: 300px;
            display: flex;
            flex-direction: row;
            gap: 1px;
        }

            .part-Pie-Bar div {
                width: 50%;
                height: 100%;
                display: flex;
            }


        .title-vosool {
            display: flex;
            flex-direction: column;
            width: 20%;
            height: 100%;
        }

            .title-vosool div {
                height: 50%;
                width: 100%;
                display: flex;
                justify-content: center;
            }

        .meghdar {
            font-size: 40px;
        }

        .onvan {
            padding-top: 25px;
        }

        .txt-Taghsim {
            width: 100%;
            height: 30px;
            display: flex;
            flex-direction: row;
            font-size: 12px;
            gap: 10px;
            padding: 10px 20px;
            align-content: center;
        }

        .form-select, .form-control {
            margin-bottom: 10px !important;
        }

        .custom-table {
            width: 30%;
            height: 100%;
            padding: 5px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .custom-table-part1 {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .custom-table-rows {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: row;
            /*            gap:5px;*/
        }

        .custom-table-rows2 {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            /*            gap:5px;*/
        }

        .custom-table-rows .custom-table-rows-parts {
            width: 50%;
            height: 100%;
            border-radius: 10px;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .custom-table-rows2 .custom-table-rows-parts {
            width: 100%;
            /*            height: 100%;*/
            border-radius: 10px;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .custom-table-rows .custom-table-rows-parts:nth-child(1) {
            background-color: var(--color-tr);
            border-radius: 0px 10px 10px 0px;
            border: 1px solid #009595cc;
        }

        .custom-table-rows .custom-table-rows-parts:nth-child(2) {
            background-color: #00ffff2e;
            border-radius: 10px 0px 0px 10px;
            cursor: pointer;
            color: aqua;
        }

        .custom-table-rows2 .custom-table-rows-parts:nth-child(1) {
            background-color: var(--color-tr);
            border-radius: 10px 10px 0px 0px;
            border: 1px solid #009595cc;
            height: 40%;
        }

        .custom-table-rows2 .custom-table-rows-parts:nth-child(2) {
            background-color: #00ffff2e;
            border-radius: 0px 0px 10px 10px;
            cursor: pointer;
            color: aqua;
            height: 60%;
            font-size: 18px;
        }

        .custom-table-part2 {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
    </style>
</head>
@{
    var cities = Model.listmode1
