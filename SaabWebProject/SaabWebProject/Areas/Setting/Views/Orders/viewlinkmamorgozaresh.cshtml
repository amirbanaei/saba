<style>
    /* برای جدول پیش‌نمایش */
    .table-preivew {
        width: 100%;
        min-width: 1000px; /* حداقل عرض برای موبایل */
        border-collapse: collapse;
        /*table-layout: fixed;*/ /* مهم: عرض ستون‌ها ثابت می‌ماند */
    }

        .table-preivew th,
        .table-preivew td {
            padding: 5px 8px;
            text-align: center;
            white-space: nowrap; /* جلوگیری از شکست خط */
            overflow: hidden;
            text-overflow: ellipsis; /* اگر خیلی طولانی بود ... اضافه می‌کند */
            border: 1px solid #fff;
        }

    /* قاب اسکرول */
    .table-wrapper {
        overflow-x: auto;
        overflow-y: auto;
        max-height: 400px;
    }

    .modal-lg, .modal-xl {
        margin-top: 8px !important;
        max-width: 80% !important;
    }

    .modal-content {
        /*width:121% !important;
        padding: 0 !important;
        margin:-2px;*/
    }
</style>
<style>


