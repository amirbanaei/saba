<script>




    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#myModal3").addClass("fade-in"); // Add the fade-in class
            $("#myModal3").css("display", "block");
        });

        $(".close").click(function () {
            $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
            $("#myModal3").css("display", "none");
            location.reload();
        });

        $(window).click(function (event) {
            if (event.target == $("#myModal3")[0]) {
                $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
                $("#myModal3").css("display", "none");
            }
        });
    });
$("input[name='MyExcelStream']").change(function () {
    var file = this.files[0];
    var ext = file.name.split('.').pop().toLowerCase();
    document.getElementById("loading-circle").style.display = "block";

    if (ext === "xlsx" || ext === "xls") {
        var obj = new FormData();
        obj.append("MyExcelStream", file);
        obj.append("year", $("#YearAz").val());
        obj.append("month", $("#MonthAz").val());
        obj.append("job", $("#select_peyman").val());

        var url2 = '@Url.Action("PreviewExcel", "Orders", new { area = "Setting" })';

        $.ajax({
            url: url2,
            type: "POST",
            contentType: false,
            processData: false,
            data: obj,
            success: function (res) {
                document.getElementById("loading-circle").style.display = "none";

                var data = (typeof res === "string") ? JSON.parse(res) : res;

                if (data.success) {
                    var html = "<div class='table-wrapper'><table class='table table-bordered table-preivew' style='background-color:black; color:white;'><thead><tr>" +
                        "<th>unic</th><th>شغل</th><th>کد پرسنلی</th><th>نام و نام خانوادگی</th><th>ستون E</th>";

                    var extraColumns = [];
                    if (data.preview && data.preview.length > 0) {
                        extraColumns = Object.keys(data.preview[0].ExtraColumns || {});
                        extraColumns.forEach(function (col) {
                            html += "<th>" + col + "</th>";
                        });
                    }

                    html += "<th>ماه</th><th>سال</th></tr></thead><tbody>";

                    var hasEmptyE = false; // 🔹 چک کردن ستون E خالی

                    if (data.preview) {
                        data.preview.forEach(function (r) {
                            var valueE = r.ValueE || "";
                            if (!valueE.trim()) hasEmptyE = true;

                            html += "<tr>" +
                                "<td>" + r.unic + "</td>" +
                                "<td>" + r.Job + "</td>" +
                                "<td>" + r.FK_usr + "</td>" +
                                "<td>" + r.FullName + "</td>" +
                                "<td>" + (valueE || "<span style='color:red'>خالی</span>") + "</td>";

                            extraColumns.forEach(function (col) {
                                html += "<td>" + (r.ExtraColumns[col] || "") + "</td>";
                            });

                            html += "<td>" + (r.month || "") + "</td>" +
                                "<td>" + (r.year || "") + "</td>" +
                                "</tr>";
                        });
                    }

                    html += "</tbody></table></div>";

                    if (hasEmptyE) {
                        Swal.fire({
                            title: "خطا",
                            html: html + "<p style='color:red'>ستون عنوان عملیات  خالی است. لطفا قبل از ذخیره تکمیل کنید.</p>",
                            width: "1000px",
                            showCancelButton: true,
                            showConfirmButton: false,
                            cancelButtonText: "لغو"
                        });
                        return;
                    }

                    // اگر همه پر بود
                    Swal.fire({
                        title: "پیش‌نمایش 5000 رکورد اول",
                        html: html,
                        width: "1000px",
                        showCancelButton: true,
                        confirmButtonText: "تأیید و ذخیره",
                        cancelButtonText: "لغو"
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            var obj2 = new FormData();
                            obj2.append("MyExcelStream", file);
                            obj2.append("year", $("#YearAz").val());
                            obj2.append("month", $("#MonthAz").val());
                            obj2.append("job", $("#select_peyman").val());

                            document.getElementById("loading-circle").style.display = "block";

                            $.ajax({
                                url: '@Url.Action("createmarhaleh1editlonkmamor", "Orders", new { area = "Setting" })',
                                type: "POST",
                                contentType: false,
                                processData: false,
                                data: obj2,
                                success: function (res2) {
                                    document.getElementById("loading-circle").style.display = "none";
                                    var result2 = (typeof res2 === "string") ? JSON.parse(res2) : res2;

                                    if (result2.success) {
                                        var html2 = "<div style='max-height:400px; overflow-y:auto;'><table class='table table-bordered' style='background-color:black; color:white;'><thead><tr>" +
                                            "<th>unic</th><th>کد پرسنلی</th><th>نام و نام خانوادگی</th><th>ماه</th><th>سال</th></tr></thead><tbody>";

                                        result2.lastRecords.forEach(function (r) {
                                            html2 += "<tr>" +
                                                "<td>" + r.unic + "</td>" +
                                                "<td>" + r.PersonalID + "</td>" +
                                                "<td>" + r.FullName + "</td>" +
                                                "<td>" + r.month + "</td>" +
                                                "<td>" + r.year + "</td>" +
                                                "</tr>";
                                        });

                                        html2 += "</tbody></table></div>";

                                        Swal.fire({
                                            title: result2.message,
                                            html: html2,
                                            icon: "success"
                                        });
                                    } else {
                                        Swal.fire("خطا", result2.message, "error");
                                    }
                                },
                                error: function (err) {
                                    document.getElementById("loading-circle").style.display = "none";
                                    Swal.fire("خطا", err.responseText, "error");
                                }
                            });
                        }
                    });
                } else {
                    Swal.fire("خطا", data.message, "error");
                }
            },
            error: function (err) {
                document.getElementById("loading-circle").style.display = "none";
                Swal.fire("خطا", err.responseText, "error");
            }
        });
    } else {
        Swal.fire("خطا", "فقط فایل اکسل قابل قبول است", "warning");
        document.getElementById("loading-circle").style.display = "none";
    }
});




