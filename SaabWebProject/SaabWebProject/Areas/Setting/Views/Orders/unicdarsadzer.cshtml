<script>
    function updateSumzer() {
        let sum = 0;
        $(".olavait-input").each(function () {
            let val = parseFloat($(this).val()) || 0;
            sum += val;
        });

        $("#sumVaznzer").text(sum);

        if (sum > 100) {
            $("#sumVaznzer").css("color", "red");
        } else {
            $("#sumVaznzer").css("color", "green");
        }

        return sum;
    }

    $(document).on("input", ".olavait-input", function () {
        updateSumzer();
    });

    // محاسبه اولیه جمع
    $(document).ready(function () {
        updateSumzer();
    });

    // ذخیره همه با دکمه
    $("#saveAllzer").click(function () {
        let sum = updateSumzer();
        if (sum > 100) {
            alert("جمع درصدها نباید بیشتر از 100 شود!");
            return;
        }
let data = [];
let FK_dbergha2 = @IDD; // اینجا مقدار ریزور میاد

$(".olavait-input").each(function () {
    let id = $(this).data("id");
    let name = $(this).data("name");
    let vazn = $(this).val();
    let del = $(`.del-checkbox2[data-id='${id}']`).is(":checked"); // گرفتن وضعیت چک‌باکس

    data.push({
        ID: id,
        Name: name,
        Vazn: vazn,
        Del: del,
        FK_dbergha2: FK_dbergha2 // اینم اضافه شد
    });
});

        $.ajax({
            url: '/Setting/Orders/SaveAllVaznolaviat',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (res) {
                if (res.success) {
                    alert("همه موارد ذخیره شد");
                } else {
                    alert("خطا: " + res.message);
                }
            },
            error: function () {
                alert("خطا در ارسال اطلاعات");
            }
        });
    });
</script>
<script>

    var
        filters = {
          
            filter02: null,
            filter03: null,
            filter04: null,
            filter05: null,
            filter06: null,
        };

    function updateFilters() {
        $('.task-list-row').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter(filterName) {
        filters[filterName] = this.value;
        updateFilters();
    }

    // Assigned User Dropdown Filter

    $('#filter02-filter').on('input', function () {
        changeFilter.call(this, 'filter02');
    });
    $('#filter03-filter').on('input', function () {
        changeFilter.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilter.call(this, 'filter04');
    });
    $('#filter05-filter').on('input', function () {
        changeFilter.call(this, 'filter05');
    });
    $('#filter06-filter').on('input', function () {
        changeFilter.call(this, 'filter06');
    });


</script>
