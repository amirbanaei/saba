@{
    ViewBag.Title = "نقشه راه گزارش ها";
    Layout = null;
}
@model SaabWebProject.Models.ViewModels.Contracts.Function.FunctionModel

<!DOCTYPE html>

<html>
<head>

    <meta name="viewport" content="width=device-width" />
    <title>NaghsheRah</title>
    <style>
        p {
            margin-bottom: 0px !important;
        }


        .cls-1 {
            fill: #1d2734;
            stroke-width: 9.04px;
        }

        .cls-1, .cls-2 {
            stroke-miterlimit: 10;
        }

        .cls-1, .cls-3 {
            stroke: #2af4db;
        }

        .cls-2 {
            stroke: #293b46;
            stroke-width: 25px;
        }

        .cls-2, .cls-3 {
            fill: none;
        }

        .cls-3 {
            stroke-dasharray: 0 0 0 0 0 0 0 8 0 8 0 8;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-width: 2px;
        }

        .cls-4 {
            fill: #2af4db;
            stroke-width: 0px;
        }

        .Naghshe {
            height: 600px;
            position: relative;
            display: flex;
            justify-content: center;
        }

        .circle {
            position: absolute;
            top: 0;
            left: 0;
            background-color: #1d2734;
            height: 50px;
            width: 50px;
            border-radius: 50%;
            box-shadow: inset 0 0 16px 0px #00ffff, 0px 0px 5px 1px #00ffff;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10000;
        }


        .red {
            box-shadow: inset 0 0 16px 0px #ff0000, 0px 0px 5px 1px #ff0000;
        }

        .green {
            box-shadow: inset 0 0 16px 0px #04ff00, 0px 0px 5px 1px #00ff37;
        }

        .yellow {
            box-shadow: inset 0 0 16px 0px #ff9900, 0px 0px 5px 1px #ff9900;
        }

        .circle i {
            font-size: 20px;
            color: white;
        }

        .box {
            position: absolute;
            display: flex;
            flex-direction: column;
            height: fit-content;
            width: 215px !important;
            z-index: 1000;
            justify-content: center;
            border-radius: 15px;
            border: 1px dashed aqua;
            overflow: hidden;
            padding: 10px;
            top: -80px;
            right: -75px;
        }



        .body-box {
            width: 100%;
            height: 100%;
            justify-content: center;
            display: flex;
            flex-direction: column;
        }

            .body-box p {
                color: white;
                width: 100%;
            }

        .box2 {
            position: absolute;
            display: flex;
            flex-direction: column;
            height: 119px;
            width: 206px !important;
            z-index: 1000;
            justify-content: center;
            border-radius: 15px;
            border: 1px dashed aqua;
        }

        .title-box2 {
            margin: auto;
            position: absolute;
            top: -20px;
            right: 40%;
            width: 40px;
            height: 40px;
            border-radius: 99%;
            background: #1d2734;
            justify-content: center;
            display: flex;
            align-items: center;
            border: 1px dashed aqua;
        }

            .title-box2 i {
                font-size: 20px;
                color: white;
            }

        .body-box2 {
            width: 100%;
            height: 100%;
            justify-content: center;
            display: flex;
        }

        b {
            color: aqua;
            font-weight: bold;
        }
    </style>
</head>
