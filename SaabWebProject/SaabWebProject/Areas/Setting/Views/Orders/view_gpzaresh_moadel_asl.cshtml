    <script>

$(document).ready(function() {
    // تمام کدهای شما که از $ استفاده می‌کنند اینجا قرار می‌گیرد
    $("#dwn").click(function () {
        var fromDate = $("#astime").val();
        var toDate   = $("#tatime").val();
        var day1 = $("#countday").val();
        var day2 = $("#countday1").val();

        if (!fromDate || !toDate) {
            alert("لطفاً بازه تاریخ را انتخاب کنید");
            return;
        }

        window.location =
            '@Url.Action("Excel_gozaresh_asli", "Orders", new { area = "Setting" })'
        + '?fromDate=' + fromDate
        + '&day1=' + day1
        + '&day2=' + day2
            + '&toDate=' + toDate;
    });


});
    </script>
