<style>
    /* استایل ساده برای مودال پاپ‌آپ */
    .custom-modal {
        position: absolute; /* جایابی با js انجام می‌شود */
        z-index: 9999;
        display: none;
        min-width: 260px;
        max-width: 90vw;
        /*  border-radius: 8px;*/
        overflow: visible;
        transform-origin: top left;
    }

    .custom-modal-inner {
        background-color: transparent; /* رنگ دلخواه */
        color: #fff;
        border-radius: 8px;
        box-sizing: border-box;
    }

    /* محتوای لود شده */
    .modal-content {
        max-height: 60vh;
        overflow: auto;
    }

    /* دکمه بستن */
    .modal-close {
        position: absolute;
        top: -20px;
        right: 20px;
        background: var(--bs-tab-content-bg);
        border: none;
        color: aqua;
        font-size: 22px;
        cursor: pointer;
        line-height: 1;
        border-radius: 5px;
        border: 1px solid aqua;
        transition: .3s;
    }

        .modal-close:hover {
            border-color: red;
            color: red;
        }

    /* انیمیشن نمایشی */
    .custom-modal.fade-in {
        animation: modalIn 160ms ease-out;
    }

    @@keyframes modalIn {
        from {
            opacity: 0;
            transform: scale(0.98);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>
