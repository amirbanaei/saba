    <script>
        function renderChart(chartSelector, seriesData) {
            var isMobile = window.innerWidth <= 768;

            var options = {
                chart: {
                    type: 'line',
                    height: '100%',
                    toolbar: { show: false },
                    fontFamily: 'inherit',
                },

                series: seriesData,  // 🔹 داده‌ها از خارج تابع می‌آیند

                stroke: {
                    width: 3,
                    curve: 'smooth'
                },

                xaxis: {
                    categories: ["شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه"],
                    labels: {
                        style: {
                            fontFamily: 'inherit',
                            colors: '#fff',
                            fontSize: isMobile ? '8px' : '12px'
                        }
                    },
                    axisTicks: { show: false }
                },

                yaxis: {
                    labels: {
                        offsetX: -20,
                        style: {
                            fontFamily: 'inherit',
                            colors: '#fff',
                            fontSize: isMobile ? '8px' : '12px'
                        }
                    },
                    axisBorder: { show: true, color: "#ccc", width: 1, offsetX: 19 }
                },

                legend: {
                    show: false,
                    labels: {
                        fontFamily: 'inherit',
                        colors: '#fff',
                        fontSize: isMobile ? '8px' : '12px'
                    }
                },

                tooltip: { theme: 'dark' },
                markers: { size: 4, strokeWidth: 2 }
            };

            var chart = new ApexCharts(document.querySelector(chartSelector), options);
            chart.render();
        }

        // رندر سه نمودار با داده‌های متفاوت
        renderChart("#field1-part2-chart", [
            { name: "وصول شده", data: [10, 25, 18, 17, 28, 40, 35], color: "#1E90FF" },
            { name: "حد انتظار", data: [5, 15, 20, 25, 28, 32, 37], color: "#9c9c9c" }
        ]);

        renderChart("#field2-part2-chart", [
            { name: "وصول شده", data: [8, 12, 20, 28, 15, 25, 30], color: "#1E90FF" },
            { name: "حد انتظار", data: [2, 10, 18, 12, 20, 22, 18], color: "#9c9c9c" }
        ]);

        renderChart("#field3-part2-chart", [
            { name: "وصول شده", data: [15, 20, 25, 30, 22, 28, 35], color: "#1E90FF" },
            { name: "حد انتظار", data: [10, 12, 20, 25, 18, 22, 27], color: "#9c9c9c" }
        ]);
    </script>

    <script>
  $(function () {
    // آدرس پایه برای load (Razor Url.Action)
    var loadUrl = '@Url.Action("sabteghdam", "Orders", new { area = "Setting" })';

    // تابع کمکی برای قرارگیری مودال و جلوگیری از خارج شدن از صفحه
    function placeModal($modal, targetOffset, targetHeight) {
      var left = targetOffset.left;
      var top = targetOffset.top + targetHeight + 5; // 5px فاصله
      // اندازه‌ها
      var modalWidth = $modal.outerWidth();
      var modalHeight = $modal.outerHeight();
      var winWidth = $(window).width();
      var winHeight = $(window).height();
      var scrollTop = $(window).scrollTop();

      // اگر مودال از راست صفحه بیرون زد آن را به چپ ببریم
      if (left + modalWidth > winWidth - 10) {
        left = Math.max(10, winWidth - modalWidth - 10);
      }
      // اگر مودال از پایین viewport بیرون زد آن را بالاتر قرار بده (روی سطر بالا)
      if ((top - scrollTop) + modalHeight > winHeight) {
        // قرار دادن بالای المان (اگر جا داشته باشد)
        var altTop = targetOffset.top - modalHeight - 5;
        if (altTop > 10) top = altTop;
        else top = Math.max(10 + scrollTop, winHeight - modalHeight - 10 + scrollTop);
      }

      $modal.css({
        left: left + "px",
        top: top + "px",
        position: "absolute"
      });
    }

    // باز شدن مودال موقع کلیک روی هر المان با کلاس .click
    $(document).on("click", ".click", function (e) {
      e.stopPropagation(); // جلوگیری از بابل شدن تا handler کلی سمت داکیومنت تداخل نکند
      var $this = $(this);

      // خواندن data-id یا اگر نبود از متن المان استفاده کن
      var idd = $this.data("id");
      if (!idd && $this.attr("href")) {
        // اگر المان لینک دارد شاید id در کوئری‌استرینگ باشد
        var href = $this.attr("href");
        var m = href.match(/[?&]id=([^&]+)/);
        if (m) idd = decodeURIComponent(m[1]);
      }
      if (!idd) {
        // fallback: متن المان
        idd = $.trim($this.text());
      }

      console.log("Clicked ID:", idd);

      var offset = $this.offset();
      var elementHeight = $this.outerHeight();

      var $modal = $("#mymodal3");
      // نمایش مودال (ابتدا نمایش موقت برای محاسبه ابعاد)
      $modal.addClass("fade-in").css({
        display: "block",
        left: 0,
        top: 0,
        position: "absolute",
        opacity: 1
      });

      // قرارگیری درست مودال نسبت به المان و جلوگیری از overflow
      placeModal($modal, offset, elementHeight);

      // لود محتوا (استفاده از encodeURIComponent)
      var safeUrl = loadUrl + "?id=" + encodeURIComponent(idd);
      $("#ss").html('<div style="padding:12px">در حال بارگذاری...</div>'); // پیام موقت
      $("#ss").load(safeUrl, function (response, status, xhr) {
        if (status === "error") {
          $("#ss").html('<div style="padding:12px;color:#ffdcdc">خطا در بارگذاری محتوا.</div>');
          console.error("Load error:", xhr.status, xhr.statusText, safeUrl);
        } else {
          // بعد از لود شدن ممکنه اندازه مودال تغییر کنه؛ باز جایابی کن
          setTimeout(function () {
            placeModal($modal, offset, elementHeight);
          }, 60);
        }
      });
    });

    // بستن مودال با کلیک روی دکمه بستن
    $(document).on("click", "#mymodal3 .modal-close", function (e) {
      e.stopPropagation();
      $("#mymodal3").hide().removeClass("fade-in");
    });

    // بستن مودال با کلیک بیرون از آن
    $(document).on("click", function (e) {
      var $modal = $("#mymodal3");
      if ($modal.is(":visible")) {
        // اگر کلیک شده داخل مودال نبود، مودال را ببند
        if ($(e.target).closest("#mymodal3").length === 0) {
          $modal.hide().removeClass("fade-in");
        }
      }
    });

    // وقتی صفحه اسکرول یا resize شد، اگر مودال باز است دوباره جایابی کن
    $(window).on("resize scroll", function () {
      var $modal = $("#mymodal3");
      if ($modal.is(":visible")) {
        // سعی کن المان هدف را از attribute ذخیره‌شده پیدا کنی؛
        // اگر پیدا نشد کلا مودال رو ببند
        var lastTarget = $modal.data("lastTarget");
        if (lastTarget && $(lastTarget).length) {
          placeModal($modal, $(lastTarget).offset(), $(lastTarget).outerHeight());
        } else {
          // امن: مودال را ببند یا جایابی ساده
          $modal.hide().removeClass("fade-in");
        }
      }
    });

  });
    </script>


</body>
