

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
@using System.Globalization

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ModiriatStedad</title>

    <style>
        @@media (max-width: 768px) {
            /* ستون اول ثابت */
            .sticky-col {
                position: sticky;
                right: 0; /* ستون سمت چپ */
                background: #fff; /* پس‌زمینه ثابت */
                z-index: 2000; /* زیر هدر، بالاتر از بقیه سلول‌ها */
                min-width: 120px; /* جلوگیری از قاطی شدن متن */
            }
            /* هدر ستون اول بالاتر از سلول‌ها */
            .sticky-col-header {
                z-index: 3;
            }

            table {
                overflow-x: auto !important;
            }



            .title {
                padding-right: 0 !important;
                flex-direction: column !important;
                gap: 10px !important;
            }

            .title-page {
                display: none !important;
            }

            .lebel-title {
                font-size: 10px;
                margin-right: 10px;
            }

            #SaatKhateme, #SaatShoroo {
                width: 80px;
            }
        }




        input[type="radio"] {
            margin-bottom: 0 !important;
            margin-top: 4px;
        }

        .time-input {
            margin-bottom: 0 !important;
            width: 100px;
            margin: auto;
        }

        .select-eyb {
            margin-top: 5px !important;
            margin-bottom: 5px !important;
            width: 100px;
            margin: auto;
        }

        .inputWithFilterIcon {
            width: 100px;
            margin: auto;
        }


        .TextCenter {
            align-content: center;
            align-items: center;
            justify-content: center;
            border-left: 1px solid white;
        }



        tbody tr td:first-child {
            border-top-right-radius: 0px !important;
            border-bottom-right-radius: 0px !important;
            border-left: 1px solid white;
            border-bottom: 1px solid white !important;
        }

        .position {
            position: relative;
            overflow: hidden;
            border-radius: 10px !important;
        }

        .title-page {
            display: flex;
            height: 100%;
            width: 220px;
            background: var(--bs-Meno-color);
            align-content: center;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            padding: 0px !important;
        }

        .title {
            border-width: 2px;
            margin-bottom: 50px;
            display: flex;
            gap: 20px;
            padding-right: 900px;
        }

            .title div {
                display: flex;
                gap: 5px;
                align-content: center;
                align-items: baseline;
            }

        .thwidth {
            width: 60px;
        }
    </style>

</head>
<body>
    <div class="tab-content" id="pills-tabContent" style="padding:20px; background:#f7f7f7;">

        <div class="row">
            <div class="col-xl-12">

                <div class="form-control title position " style="padding:0 !important;">
                    <div class="title-page">
                        <label class="lebel-title">استعداد خودرو</label>
                    </div>
                </div>
            </div>

        </div>

        <div class="row">
            <div class="col-xl-2">

                <label class="form-label">تاریخ ثبت</label>
                <input data-jdp jdp-btn-close data-jdp-miladi-input="miladi_date1" id="datepickerFrom_shw1" class="form-control pdate" name="datepickerFrom_shw1">
                <input id="miladi_date1" type="hidden" />
            </div>
            <div class="col-xl-1">
                <a href="#" class="btn form-control buttonGeneral" id="Sendnamayesh">
                    <i class="bi bi-plus-circle fa-fw me-1 VecGeneral"></i>
                    <span class="bGeneral-text">نمایش</span>
                </a>
            </div>
        </div>

        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive tableH_Lock">

            </div>
        </div>



    </div>


    <script src="~/Assets/js/jalalidatepicker.min.js"></script>
    <link href="~/Assets/css/jalalidatepicker.min.css" rel="stylesheet" />
    <script src="~/Assets/js/jalaali.min.js"></script>
    <link href="~/MyStyles/jalalidatepicker.css" rel="stylesheet" />








    @*جدیدا رو اینجا بزن*@



    <script>
        jalaliDatepicker.startWatch({
            time: false,
            days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
            persianDigits: true,
            autoClose: true,
            autocomplete: true,
            showEmptyBtn: false,
            showCloseBtn: true,
            zIndex: 100000,
        });

        var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
        for (var i = 0; i < inputs.length; i++) {
            inputs[i].addEventListener("jdp:change", function (e) {
                var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                var date = this.value.replace(' ', '').slice(0, 10).split('/');
                date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]));
                if (!this.value) {
                    date = "";
                } else if (this.value.replace(' ', '').length < 11) {
                    date = date.gy + '-' + date.gm + '-' + date.gd;
                } else {
                    date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30);
                }
                miladiInput.value = date;
            });
        }

    </script>

    <script>
document.addEventListener("DOMContentLoaded", function () {

    // 🔹 وقتی دکمه نمایش کلیک میشه
    $(document).on("click", "#Sendnamayesh", function (e) {
        e.preventDefault();

        const selectedDate = $("#miladi_date1").val();
        if (!selectedDate) {
            alert("لطفاً تاریخ را انتخاب کنید.");
            return;
        }

        fetch('@Url.Action("viewestedadghodro", "Orders")?date=' + selectedDate, {
            method: "GET",
            headers: { "X-Requested-With": "XMLHttpRequest" }
        })
        .then(response => response.text())
        .then(html => {
            $(".tableH_Lock").html(html);
        })
        .catch(error => console.error("خطا در بارگذاری جدول:", error));
    });

    // 🔹 وقتی دکمه ثبت کلیک میشه (event delegation)
$(document).on("click", "#Send", function (e) {
    e.preventDefault();
    e.stopImmediatePropagation();

    const $btn = $(this);
    $btn.prop("disabled", true);

    const rows = document.querySelectorAll("tbody tr");
    const items = [];
    const tarikhSabt = document.getElementById("miladi_date1").value;

    rows.forEach(row => {
        const usrId = parseInt(row.dataset.userid);
        const VaziatHozor = row.querySelector('input[name^="btn1_"]:checked')?.value || null;
        const SaatShoro = row.querySelector('input[name^="start_"]')?.value || null;
        const SaatKhateme = row.querySelector('input[name^="end_"]')?.value || null;
        const Kilometr = parseFloat(row.querySelector('.kilometr-input')?.value) || null;
        const NoeAmaliat = row.querySelector('.select-eyb')?.selectedIndex || null;
        const VaziatKhodro = row.querySelector('input[name^="btn2_"]:checked')?.value || null;
        const NoeEyb = row.querySelector('.select-noaeyb')?.value || null;
        const Sharh = row.querySelector('td:last-child input')?.value || null;

        if (usrId) {
            const hasData =
                VaziatHozor !== null ||
                VaziatKhodro !== null ||
                (Kilometr !== null && !isNaN(Kilometr)) ||
                (Sharh && Sharh.trim() !== "") ||
                (SaatShoro && SaatShoro.trim() !== "") ||
                (SaatKhateme && SaatKhateme.trim() !== "");

            if (hasData) {
                items.push({
                    FK_: usrId,
                    VaziatHozor,
                    Kilometr,
                    NoeAmaliat,
                    VaziatKhodro,
                    NoeEyb,
                    Sharh,
                    SaatShoro,
                    SaatKhateme,
                    TarikhSabt: tarikhSabt
                });
            }
        }
    });

    if (items.length === 0) {
        alert("هیچ داده‌ای برای ثبت وجود ندارد.");
        $btn.prop("disabled", false);
        return;
    }

    fetch('@Url.Action("SaveEstedadKhodro", "Orders")', {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
        },
        body: JSON.stringify(items)
    })
    .then(res => res.json())
    .then(data => {
        if (data.success)
            alert(data.message);
        else
            alert("خطا در ثبت داده‌ها");
    })
    .catch(err => console.error(err))
    .finally(() => {
        $btn.prop("disabled", false);
    });
});


    $(document).ready(function () {

        // 🔹 تغییر وضعیت فیلدهای سطر بر اساس btn1_
        $(document).on("change", 'input[type="radio"][name^="btn1_"]', function () {
            const row = this.closest('tr');
            const startInput = row.querySelector('input[name^="start_"]');
            const endInput = row.querySelector('input[name^="end_"]');
            const kilometrInput = row.querySelector('.kilometr-input');
            const btn2Radios = row.querySelectorAll('input[type="radio"][name^="btn2_"]');
            const noetypeSelect = row.querySelector('select.select-noaeyb');
            const noeAmaliatSelect = row.querySelector('select.select-eyb'); // نوع عملیات
            const sharhInput = row.querySelector('#Sharh'); // فیلد شرح

            if (this.value === "1" && this.checked) {
                // 🔹 غیرقابل ویرایش ولی مقادیر حفظ شوند
                if (startInput) { startInput.disabled = true; startInput.style.opacity = '.5'; }
                if (endInput) { endInput.disabled = true; endInput.style.opacity = '.5'; }
                if (kilometrInput) { kilometrInput.disabled = true; kilometrInput.style.opacity = '.5'; }
                if (btn2Radios.length > 0) { btn2Radios.forEach(r => r.disabled = true); }
                if (noetypeSelect) { noetypeSelect.disabled = true; noetypeSelect.style.opacity = '.5'; }
                if (noeAmaliatSelect) { noeAmaliatSelect.disabled = true; noeAmaliatSelect.style.opacity = '.5'; }
                if (sharhInput) { sharhInput.disabled = true; sharhInput.style.opacity = '.5'; }
            }

            else if (this.value === "2" && this.checked) {
                // 🔹 فعال کردن همه فیلدها
                if (startInput) { startInput.disabled = false; startInput.style.opacity = '1'; }
                if (endInput) { endInput.disabled = false; endInput.style.opacity = '1'; }
                if (kilometrInput) { kilometrInput.disabled = false; kilometrInput.style.opacity = '1'; }
                if (btn2Radios.length > 0) { btn2Radios.forEach(r => r.disabled = false); }
                if (noetypeSelect) { noetypeSelect.disabled = false; noetypeSelect.style.opacity = '1'; }
                if (noeAmaliatSelect) { noeAmaliatSelect.disabled = false; noeAmaliatSelect.style.opacity = '1'; }
                if (sharhInput) { sharhInput.disabled = false; sharhInput.style.opacity = '1'; }
            }
        });

        // 🔹 تغییر نوع عیب خودرو بر اساس btn2_
        $(document).on("change", 'input[type="radio"][name^="btn2_"]', function () {
            const row = this.closest('tr');
            const noetypeSelect = row.querySelector('select.select-noaeyb');

            if (!noetypeSelect) return;

            if (this.value === "8" && this.checked) {
                noetypeSelect.disabled = false;
                noetypeSelect.style.opacity = '1';
            } else {
                noetypeSelect.disabled = true;
                noetypeSelect.style.opacity = '.5';
            }
        });

        // 🔹 وقتی ساعت شروع و خاتمه پر شدن، رادیو 2 انتخاب بشه
        $(document).on("input change", 'input[name^="start_"], input[name^="end_"]', function () {
            const row = this.closest('tr');
            const startInput = row.querySelector('input[name^="start_"]');
            const endInput = row.querySelector('input[name^="end_"]');
            const radio2 = row.querySelector('input[type="radio"][name^="btn1_"][value="2"]');

            if (startInput && endInput && radio2) {
                const hasStart = startInput.value.trim() !== "";
                const hasEnd = endInput.value.trim() !== "";

                if (hasStart && hasEnd) {
                    radio2.checked = true;
                    $(radio2).trigger("change"); // برای فعال شدن فیلدها
                }
            }
        });

        // 🔹 اگه رادیو 2 انتخاب شد ولی ساعت‌ها پر نبودن، خطا بده



        // 🔹 وضعیت اولیه هنگام لود صفحه
        $('input[type="radio"][name^="btn1_"]:checked').trigger("change");
        $('input[type="radio"][name^="btn2_"]:checked').trigger("change");
    });


});
    </script>




</body>
</html>
