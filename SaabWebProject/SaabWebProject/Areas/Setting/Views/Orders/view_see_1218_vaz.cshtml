        <p>درصد نهایی : @Model.percent9 %</p>*@

</head>
@{
    decimal maxHeight = 50m;
    decimal h1 = maxHeight;
    decimal h2 = (Model.percent6 / 100m) * maxHeight;
    decimal h3 = (Model.percent7 / 100m) * maxHeight;
    decimal h4 = (Model.percent8 / 100m) * maxHeight;
    //decimal h5 = (Model.percent5 / 100m) * maxHeight;
    decimal h9 = (Model.percent9 / 100m) * maxHeight;

    decimal h12 = (Model.percent12 / 100m) * h9;
    decimal h13 = (Model.percent13 / 100m) * h9;
    if (Model.percent13 < 25 || Model.percent12 < 25)
    {
        if (Model.percent13 > Model.percent12)
        {
            h12 = (25 / 100m) * h9;
            h13 = (75 / 100m) * h9;
        }
        else
        {
            h12 = (75 / 100m) * h9;
            h13 = (25 / 100m) * h9;

        }
    }

}

