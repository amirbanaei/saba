<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>nemoodarjadid</title>
    <style>

        :root {
            --water-color: dodgerblue;
        }

        .container-col {
            margin-bottom: 15vh;
            width: 100%;
            height: fit-content;
            display: flex;
            justify-content: center;
            flex-direction: row-reverse;
            gap: 1vh;
            transform: translateZ(0); /* Hardware acceleration */
        }

        .leader-line {
            will-change: transform !important;
        }

        .cols-start-txt {
            align-items: start !important;
            padding-top: 1vh !important;
        }

        .cols {
            position: relative;
            background-color: #004f9d;
            border-radius: 1vh 1vh 1vh 1vh;
            width: 28vh;
            align-items: center;
            justify-content: center;
            display: flex;
        }

        .water-level1 {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: var(--water-color);
            border-radius: 1vh 1vh 0vh 1vh;
            transition: height 1s ease;
        }

        .water-level2 {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            background-color: #004f9d;
            border-radius: 1vh 1vh 0 0;
            transition: height 1s ease;
        }

        .arrow-right-simple {
            position: absolute;
            right: -2.5vh;
            top: 5vh;
            width: 0;
            height: 0;
            border-top: 15px solid transparent;
            border-bottom: 15px solid transparent;
            border-left: 25px solid var(--water-color);
            display: inline-block;
            z-index: 10;
        }

        .cols .cols-txt {
            position: absolute;
            z-index: 1;
            height: fit-content;
            width: 50vh;
            justify-content: center;
            text-align: center;
        }

        .cols-txt p {
            margin: 0px !important;
            font-size: 1.5vh;
            color: white;
            font-weight: bold;
        }

        .boxs {
            position: absolute;
            bottom: -14vh;
            right: -10.5vh;
            width: 20vh;
            height: fit-content;
            display: flex;
            justify-content: center;
            border: 1px solid aqua;
            border-radius: 10px;
            color: white;
            padding: 1vh;
            font-size: 1.5vh;
            word-break: break-word;
            overflow-wrap: break-word;
            overflow: hidden;
            text-align: start;
        }

            .boxs .boxs-txt {
                height: fit-content;
                width: fit-content;
                justify-content: center;
                text-align: center;
            }

        .boxs-txt p {
            margin: 0px !important;
            font-size: 1.2vh;
            color: white;
        }

        .start-line {
            position: absolute;
            display: flex;
            width: 6vh;
            height: 1vh;
            bottom: -1vh;
            right: -5vh;
            background-color: var(--water-color);
        }

        .mid-line {
            position: absolute;
            display: flex;
            width: 1vh;
            height: 1vh;
            background-color: var(--water-color);
            bottom: -1vh;
            right: -1vh;
        }

        .lastpart {
            transition: .2s;
        }

            .lastpart:hover {
                background-color: #0064c7;
                cursor: pointer;
            }

        .parttop {
            height: 50%;
            width: 28vh;
            border-radius: 1vh 1vh 0vh 0vh;
            display: flex;
            justify-content: center;
        }

        .partbottom {
            height: 50%;
            display: flex;
            justify-content: center;
            width: 20vh;
            border-radius: 0vh 0vh 1vh 1vh;
        }
    </style>
