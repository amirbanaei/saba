<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ModiriatStedad</title>

    <style>
        @@media (max-width: 768px) {
            .sticky-col {
                position: sticky;
                right: 0;
                background: #fff;
                z-index: 2000;
                min-width: 120px;
            }

            .sticky-col-header {
                z-index: 3;
            }

            table {
                overflow-x: auto !important;
            }

            .title {
                padding-right: 0 !important;
                flex-direction: column !important;
                gap: 10px !important;
            }

            .title-page {
                display: none !important;
            }

            .lebel-title {
                font-size: 10px;
                margin-right: 10px;
            }

            #SaatKhateme, #SaatShoroo {
                width: 80px;
            }
        }

        input[type="radio"] {
            margin-bottom: 0 !important;
            margin-top: 4px;
        }

        .time-input {
            margin-bottom: 0 !important;
            width: 100px;
            margin: auto;
        }

        .inputWithFilterIcon {
            width: 100px;
            margin: auto;
        }

        .TextCenter {
            align-content: center;
            align-items: center;
            justify-content: center;
            border-left: 1px solid white;
        }

        tbody tr td:first-child {
            border-top-right-radius: 0px !important;
            border-bottom-right-radius: 0px !important;
            border-left: 1px solid white;
            border-bottom: 1px solid white !important;
        }

        .position {
            position: relative;
            overflow: hidden;
            border-radius: 10px !important;
        }

        .title-page {
            display: flex;
            height: 100%;
            width: 200px;
            background: var(--bs-Meno-color);
            align-content: center;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            padding: 0px !important;
        }

        .title {
            border-width: 2px;
            margin-bottom: 50px;
            display: flex;
            gap: 20px;
            padding-right: 900px;
        }

            .title div {
                display: flex;
                gap: 5px;
                align-content: center;
                align-items: baseline;
            }

        .thwidth {
            width: 60px;
        }

        thead {
            position: sticky;
            top: 0;
        }
    </style>
</head>
