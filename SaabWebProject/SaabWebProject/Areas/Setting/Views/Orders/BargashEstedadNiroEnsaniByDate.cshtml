    <script>
        var
            filters123677 = {
                filter01: null,
                filter02: null,
                filter03: null,
                filter04: null,
                filter05: null,
                filter06: null,
                filter07: null,
                filter08: null,
                filter09: null,
                filter10: null,
              
            };
        function updateFilters60() {
            $('.task-list-row234234').hide().filter(function () {
                var self = $(this),
                    result = true; // not guilty until proven guilty

                Object.keys(filters123677).forEach(function (filter) {
                    if (filters123677[filter] && (filters123677[filter] != 'None') && (filters123677[filter] != 'همه')) {
                        // تطبیق جزئی (contains) به جای تطبیق کامل
                        result = result && self.data(filter).indexOf(filters123677[filter]) !== -1;
                    }
                });

                return result;
            }).show();
        }

        function changeFilter600(filterName) {
            filters123677[filterName] = this.value;
            updateFilters60();
        } $('#filter05-filter').on('input', function () {
            changeFilter600.call(this, 'filter05');
        });
    </script>

