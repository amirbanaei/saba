    @*======================================مودال ثبت اولویت====================================*@
    <script>

    $(document).ready(function () {

        // وقتی روی هر سلول یا دکمه click2 کلیک شد، مودال باز بشه
        $(".click2").click(function () {
            var $this = $(this);

            // موقعیت المان کلیک‌شده
            var offset = $this.offset();
            var elementHeight = $this.outerHeight();
            $("#hiddenID").val(idd);
            // نمایش مودال
            $("#mymodal3")
                .addClass("fade-in")
                .css({
                    "display": "block",
                    "position": "absolute",   // لازم
                    "top": offset.top - elementHeight - 100 + "px", // ۵px فاصله پایین المان
                });

            // گرفتن data-id یا هر چیزی که نیاز داری
            var idd = $this.data("id");
            console.log("Clicked ID:", idd);
                         @*$("#ss").load('@Url.Content("/Setting/Orders/modal_Olaveat1218_SayerShoroot_sahrt")?id=' + idd);*@
            $("#ss").load('@Url.Content("/Setting/Orders/modal_Olaveat1218_SayerShoroot2_edit")?id=' + idd);

            // لود محتوا
            @*$("#ss").load('@Url.Content("/Setting/Orders/modal_Olaveat1218_SayerShoroot2")?id=' + idd);*@
        });

        // بستن مودال با آیکون
        $(".close-icon").click(function () {
            $("#mymodal3").fadeOut();
        });

        // بستن مودال وقتی روی بک‌گراند کلیک شد
        $("#mymodal3").click(function (e) {
            if (e.target === this) {
                $(this).fadeOut();
            }
        });

    });
    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#mymodal3").addClass("fade-in"); // Add the fade-in class
            $("#mymodal3").css("display", "block");
        });

        $(".close").click(function () {
            $("#mymodal3").removeClass("fade-in"); // Remove the fade-in class
            $("#mymodal3").css("display", "none");
            location.reload();
        });

        $(window).click(function (event) {
            if (event.target == $("#mymodal3")[0]) {
                $("#mymodal3").removeClass("fade-in"); // Remove the fade-in class
                $("#mymodal3").css("display", "none");
            }
        });
    })
    // بستن مودال با آیکون
    $(".close-icon").click(function () {
        $("#mymodal3").fadeOut(200, function () {
            location.reload();
        });
    });

    // بستن مودال با کلیک روی بک‌گراند
    $("#mymodal3").click(function (e) {
        if (e.target === this) {
            $(this).fadeOut(200, function () {
                location.reload();
            });
        }
    });

    </script>
