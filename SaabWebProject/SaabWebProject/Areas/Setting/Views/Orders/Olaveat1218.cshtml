    @*======================================مودال برگشت اولویت====================================*@










    <script>
        $("#SayerShoroot").click(function () {

            let order = [];
            $("#drag-wrapper .drag").each(function () {
                order.push($(this).data("id"));
            });

            let checkboxStates = [];
            $("#drag-wrapper .drag").each(function () {
                checkboxStates.push({
                    id: $(this).data("id"),
                    vaziat: $(this).find(".chk-item").is(":checked") ? 1 : 0
                });
            });

            $.ajax({
                url: "/Setting/Orders/SaveNahayeOlaviat1218",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ order: order, checkboxStates: checkboxStates }),
                success: function (msg) {
                    alert("با موفقیت ذخیره شد ✔");
                },
                error: function () {
                    alert("خطا در ذخیره اطلاعات ❌");
                }
            });
        });

    </script>











