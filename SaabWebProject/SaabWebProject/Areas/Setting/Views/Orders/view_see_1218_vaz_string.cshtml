            border-radius: 10px 10px 0px 0px;
            height: 30px;
            transition: .2s;
        }

            .BtnCloseAG i {
                transition: .2s;
            }

            .BtnCloseAG:hover {
                border-color: red;
                box-shadow: inset 0 0 10px red;
            }

                .BtnCloseAG:hover i {
                    color: red;
                }

        .highlight-selected {
            outline: 5px solid yellow;
            outline-offset: -3px;
            border-radius: 8px;
            animation: blink 1.2s infinite;
        }

        @@keyframes blink {
            0% {
                outline-color: yellow;
            }

            50% {
                outline-color: orange;
            }

            100% {
                outline-color: yellow;
            }
        }

