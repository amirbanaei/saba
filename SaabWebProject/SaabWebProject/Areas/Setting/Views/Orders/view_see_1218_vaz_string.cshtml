    <script>
        let allLines = [];

        $(document).ready(function () {
            function createLine(from, to) {
                const line = new LeaderLine(from, to, {
                    color: 'var(--water-color)',
                    size: 8,
                    endPlug: 'arrow2',
                    endPlugSize: 0.4,
                    startSocket: 'bottom',
                    endSocket: 'top',
                    path: 'straight'
                });
                allLines.push(line);
                return line;
            }

            // خطوط خاص هر ستون
            createLine(document.querySelector('.line1'), document.querySelector('.boxs.line1'));
            createLine(document.querySelector('.line2'), document.querySelector('.boxs.line2'));
            createLine(document.querySelector('.line3'), document.querySelector('.boxs.line3'));
            createLine(document.querySelector('.line4'), document.querySelector('.boxs.line4'));
            createLine(document.querySelector('.line5'), document.querySelector('.boxs.line5'));

            // MutationObserver برای انیمیشن آب
            const observer = new MutationObserver(() => {
                setTimeout(() => allLines.forEach(l => l.position()), 1100);
            });
            observer.observe(document.querySelector('.water-level1'), { attributes: true });

            // Ultra-safe resize handler
            let resizeTimer;
            const updateAll = () => {
                allLines.forEach(line => {
                    try { line.position(); } catch (e) { }
                });
            };

            $(window).on('resize zoom orientationchange', () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(updateAll, 150);
            });

            // هر 2 ثانیه چک اضافی (برای safety)
            setInterval(updateAll, 1000);
        });
    </script>

