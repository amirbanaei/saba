








@{
    ViewBag.Title = "موجودی ابزار کار و لوازم ایمنی";

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
@using System.Globalization

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ModiriatStedad</title>

    <style>
        @@media (max-width: 768px) {
            /* ستون اول ثابت */
            .sticky-col {
                position: sticky;
                right: -5px; /* ستون سمت چپ */
                background: #fff; /* پس‌زمینه ثابت */
                z-index: 2000; /* زیر هدر، بالاتر از بقیه سلول‌ها */
                min-width: 120px; /* جلوگیری از قاطی شدن متن */
            }
            /* هدر ستون اول بالاتر از سلول‌ها */
            .sticky-col-header {
                z-index: 3;
            }

            table {
                overflow-x: auto !important;
            }



            .title {
                padding-right: 0 !important;
                flex-direction: column !important;
                gap: 10px !important;
            }

            .title-page {
                display: none !important;
            }

            .lebel-title {
                font-size: 10px;
                margin-right: 10px;
            }

            #SaatKhateme, #SaatShoroo {
                width: 80px;
            }
        }


        .TextCenter {
            align-content: center;
            align-items: center;
            justify-content: center;
            border-left: 1px solid white;
        }



        tbody tr td:first-child {
            border-top-right-radius: 0px !important;
            border-bottom-right-radius: 0px !important;
            border-left: 1px solid white;
            border-bottom: 1px solid white !important;
        }

        .position {
            position: relative;
            overflow: hidden;
            border-radius: 10px !important;
        }

        .title-page {
            display: flex;
            height: 100%;
            width: 260px;
            background: var(--bs-Meno-color);
            align-content: center;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            padding: 0px !important;
        }

        .title {
            border-width: 2px;
            margin-bottom: 50px;
            display: flex;
            gap: 20px;
            padding-right: 900px;
        }

            .title div {
                display: flex;
                gap: 5px;
                align-content: center;
                align-items: baseline;
            }

        td input {
            margin: 0 !important;
            width: 200px;
        }


        .TdInput {
            width: 50px;
            text-align: center;
        }

        .thwidth {
            width: 100px;
        }
    </style>

</head>
<body>
    <div class="tab-content" id="pills-tabContent" style="padding:20px; background:#f7f7f7;">

    
        <div class="row">
            <div class="col-xl-2">

                <label class="form-label">تاریخ</label>
                <input data-jdp jdp-btn-close data-jdp-miladi-input="miladi_date1" id="datepickerFrom_shw1" class="form-control pdate" name="datepickerFrom_shw1">
                <input id="miladi_date1" type="hidden" />

            </div>
            <div class="col-xl-1">
                <a href="#" class="btn form-control buttonGeneral" id="Sendnamayesh">
                    <i class="bi bi-plus-circle fa-fw me-1 VecGeneral"></i>
                    <span class="bGeneral-text">نمایش</span>
                </a>
            </div>
        </div>


        <hr />


        <div id="resultArea"><!-- اینجا جدول PartialView میاد --></div>


    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Assets/js/jalalidatepicker.min.js"></script>
    <link href="~/Assets/css/jalalidatepicker.min.css" rel="stylesheet" />
    <script src="~/Assets/js/jalaali.min.js"></script>
    <link href="~/MyStyles/jalalidatepicker.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-3.3.1.min.js"></script>
    <script>
        jalaliDatepicker.startWatch({
            time: false,
            days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
            persianDigits: true,
            autoClose: true,
            autocomplete: true,
            showEmptyBtn: false,
            showCloseBtn: true,
            zIndex: 100000,
        });

        var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
        for (var i = 0; i < inputs.length; i++) {
            inputs[i].addEventListener("jdp:change", function (e) {
                var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                var date = this.value.replace(' ', '').slice(0, 10).split('/');
                date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]));
                if (!this.value) {
                    date = "";
                } else if (this.value.replace(' ', '').length < 11) {
                    date = date.gy + '-' + date.gm + '-' + date.gd;
                } else {
                    date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30);
                }
                miladiInput.value = date;
            });
        }

    </script>





    <script>

        $(document).ready(function () {
    $("#Sendnamayesh").click(function (e) {
        e.preventDefault();
        var date = $("#miladi_date1").val();

        if (!date) {
            alert("لطفا تاریخ را انتخاب کنید");
            return;
        }

        $.ajax({
            url: '@Url.Action("BargashAbzarEstedadByDate", "Orders")',
            type: 'GET',
            data: { date: date },
            success: function (html) {
                $("#resultArea").html(html); // جدول بیاد
            },
            error: function () {
                alert("خطا در دریافت اطلاعات");
            }
        });
    });
});


    </script>





</body>
</html>



