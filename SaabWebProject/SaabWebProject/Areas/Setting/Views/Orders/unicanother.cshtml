    });
        }
        $(document).on("click", "#downloadFish", function () {



            window.location.href =
                "/Setting/Orders/ExportUnicanother";
        });
    let subCount = 0;
    document.getElementById("addSubBtn").addEventListener("click", function() {
        subCount++;
        const div = document.createElement("div");
        div.className = "sub-item border p-2 mt-2";

        div.innerHTML = `
            <div class="row">
                <div class="col-md-3">
                    <label>انتخاب فیلد</label>
                    <select class="form-control form-select fk_dbergha2">
                        @foreach(var item in db.dbergha2) {
                            <option value="@item.ID">@item.name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label>شماره</label>
                    <input type="number" min="1" max="10000000" class="form-control shomareh" />
                </div>


                <div class="col-md-2">
                    <label>حرف 3</label>
                    <select class="form-control form-select letter3">
                        <option value="">-</option>
                        @foreach(var l in letters) {
                            <option value="@l">@l</option>
                        }
                    </select>
                </div>
                  <div class="col-md-2">
      <label>حرف 2</label>
      <select class="form-control form-select letter2">
          <option value="">-</option>
          @foreach(var l in letters) {
              <option value="@l">@l</option>
          }
      </select>
  </div>
                 <div class="col-md-2">
     <label>حرف 1</label>
     <select class="form-control form-select letter1">
         <option value="">-</option>
         @foreach(var l in letters) {
             <option value="@l">@l</option>
         }
     </select>
 </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="button" class="btn btn-danger" onclick="this.closest('.sub-item').remove()">X</button>
                </div>
            </div>`;
        document.getElementById("subContainer").appendChild(div);
    });

    // ارسال فرم
    document.getElementById("unicForm").addEventListener("submit", function (e) {
        e.preventDefault();

        const formData = {
            FK_namegozarwsh: document.getElementById("FK_namegozarwsh").value,
            Type: document.getElementById("type").value,
            Start: document.getElementById("start").value,
            Unic: document.getElementById("unic").value,
            radifstart: document.getElementById("radifstart").value,

            dberganametanble2_2: document.getElementById("dberganametanble2_2").value,
            Details: []
        };

        document.querySelectorAll(".sub-item").forEach(el => {
            const fk_dbergha2 = el.querySelector(".fk_dbergha2").value;
            const shomareh = el.querySelector(".shomareh").value;

            // ترکیب سه selector
            let letters = [];
            const l1 = el.querySelector(".letter1").value;
            const l2 = el.querySelector(".letter2").value;
            const l3 = el.querySelector(".letter3").value;
            if (l1) letters.push(l1);
            if (l2) letters.push(l2);
            if (l3) letters.push(l3);

            const onvan = letters.join("");

            formData.Details.push({
                FK_dbergha2: fk_dbergha2,
                Shomareh: shomareh,
                Onvan: onvan
            });
        });

        fetch('/Setting/Orders/SaveReport', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json;charset=utf-8' },
            body: JSON.stringify(formData)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert("اطلاعات ذخیره شد");
                location.reload();
            } else {
                alert("Error: " + data.message);
            }
        })
        .catch(err => {
            console.error(err);
            alert("Unexpected error occurred.");
        });
    });

    </script>
}
