@using SaabWebProject.Models.DomainModels;

@{
    SaabEntities db = new SaabEntities();
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var letters = Enumerable.Range('A', 26).Select(x => ((char)x).ToString()).ToList();
}

<div class="form-container">
    <h2>تعریف فیلد های مورد نظر در گزارش ورودی</h2>

    <form id="unicForm">
        <div class="row">
            <div class="col-md-3">
                <label>انتخاب نام جدول</label>
                <select class="form-control form-select FK_namegozarwsh" id="FK_namegozarwsh">
                    @foreach (var item in db.dbergharel_4_4)
                    {
                        <option value="@item.ID">@item.name</option>
                    }
                </select>
            </div>
            @*<div class="col-md-3">
                <label>نام گزارش</label>
                <input type="text" id="namegozaresh" class="form-control" />
            </div>*@
            <div class="col-md-2">
                <label>نوع گزارش گیری</label>
                <select class="form-control form-select type" id="type">

                    <option value="1">روزانه</option>
                    <option value="2">تاریخ</option>
                    <option value="3">ازتاریخ تا تاریخ </option>
                    <option value="4">ماهانه</option>
                    <option value="5">ماه / سال</option>
                    <option value="6">فصل </option>
                    <option value="7">دوره </option>

                </select>
                @*<input type="number" id="type" class="form-control" />*@
            </div>
            <div class="col-md-2">
                <label>انتخاب نام جدول</label>
                <select class="form-control form-select dberganametanble2_2" id="dberganametanble2_2">
                    @foreach (var item in db.dberganametanble2_2)
                    {
                        <option value="@item.ID">@item.nametable</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label>شماره ردیف فیلد مرجع </label>
                <input type="text" id="radifstart" class="form-control" />
            </div>
            <div class="col-md-2">
                <label>شماره شیت شروع</label>
                <input type="number" id="start" class="form-control" />
            </div>
            <div class="col-md-3">
                <label>نام ستون شروع </label>
                <input type="text" id="unic" class="form-control" />
            </div>
            <div class="col-xl-1">
                <a href="#" class=" btn form-control buttonGeneral" id="downloadFish">
                    <i class="bi bi-download  fa-fw me-1 VecGeneral"></i>
                    <span class="bGeneral-text"> دانلود فایل نمونه</span>
                </a>
            </div>            <div class="col-xl-1">
                <a class="btn form-control buttonGeneral" id="upload10" style="font-size:10px;margin-bottom:10px;">
                    <i class="bi bi-upload fa-fw me-1 VecGeneral"></i>
                    <span class="bGeneral-text"> بارگزای اکسل</span>
                </a>
            </div>
        </div>
        <input id="summery_file10" style="display:none" type="file" class="form-control" value="" />
        <input id="summery_file11" style="display:none" type="file" class="form-control" value="" />
        <input id="summery_file112" style="display:none" type="file" class="form-control" value="" />
        <hr />
        <div id="subContainer"></div>

        <button type="button" id="addSubBtn" class="btn btn-success mt-2">+</button>
        <button type="submit" class="btn btn-primary mt-2">ثبت</button>
    </form>
</div>

@section scripts {
    <script>
        $("#upload10").click(function () {





            $("#summery_file10").click();

        });
       fd3 = new FormData();

$("#summery_file10").change(function (e) {
             $.each(e.target.files, function (index, file) {
                 fd3.append("MyExcelStream", file);
             });
    //var jobId = document.getElementById("pestenka").value; // مقدار input

/*    fd3.append("jobId", jobId);*/

    sendAjax14('@Url.Action("ImportExcel_Unicanother", "Orders", new { area = "Setting" })', fd3);
});
    
