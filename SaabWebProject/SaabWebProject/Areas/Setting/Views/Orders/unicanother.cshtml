            document.getElementById("loading-circle").style.display = "block";


    $.ajax({
        url: url2,
        type: 'POST',
        data: fd2,
        processData: false,
        contentType: false,
        success: function (res) {
            document.getElementById("loading-circle").style.display = "none";

            $("#loading-message").css("display", "none");
            fd = new FormData();
            console.log(res);
            console.log("jj");

            if (res == "True") {
                alert("با موفقیت ثبت شد ");
            //    location.reload();
            }
                   @*$("#table_div").load('@Url.Content("../defFacilitiesEquipment/_ListEquipmentMoalefeValue")');*@



        },
        error: function (res) {
            $("#loading-message").css("display", "none");
            console.log(res);
            console.log("jj");
            Toast.fire({
                icon: 'success',
