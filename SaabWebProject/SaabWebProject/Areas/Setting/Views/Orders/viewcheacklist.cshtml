<style>
    .hidden {
        display: none;
    }

    .section {
        margin: 15px 0;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    label {
        margin-left: 5px;
    }

    /* برای هر گزینه (چک/رادیو + متن) */
    .checkbox-item {
        display: inline-flex;
        align-items: center;
        margin-right: 15px;
        margin-bottom: 5px;
    }

    .cheeckkk {
        margin-bottom: 0px !important;
        margin-left: 8px
    }
    /* در موبایل هر گزینه یک خط */
    @@media (max-width: 600px) {
        .checkbox-item {
            display: flex;
            width: 100%;
        }
    }

    .report-item {
        margin-bottom: 15px;
    }

        .report-item strong {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }

    .report-options {
        display: flex;
        flex-wrap: wrap;
    }
</style>
<style>
    .modal-lg, .modal-xl {
        margin-top: 8px !important;
        max-width: 80% !important;
    }

    .modal-content {
        /*width:121% !important;
        padding: 0 !important;
        margin:-2px;*/
    }
</style>
<style>


    .modal2 {
        display: none;
        position: absolute; /* Change this from fixed */
        z-index: 1000; /* Adjust z-index as needed */
        left: 0;
        top: 0;
        width: 100%;
        height: auto;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
    }

    .modal-content2 {
        background-color: black;
        position: relative; /* Add relative positioning */
        /*  margin: 15% auto;*/
        padding: 20px;
        border: 4px solid aqua;
        border-radius: 30px;
        width: 100%;
        max-height: 100%;
        overflow-y: auto;
    }

    .modal3 {
        display: none;
        position: absolute; /* Change this from fixed */
        z-index: 1000; /* Adjust z-index as needed */
        left: 0;
        top: 0;
        width: 65%;
        height: auto;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
    }

    @@media (max-width: 768px) {
        .modal3 {
            left: -73px;
            width: 103% !important;
        }

        .modal-content3 {
            width: 121% !important;
            /*padding: 0 !important;
        margin:-2px;*/
        }
    }


    .modal-content3 {
        background-color: black;
        position: relative; /* Add relative positioning */
        /*  margin: 15% auto;*/
        padding: 20px;
        border: 4px solid aqua;
        border-radius: 30px;
        width: 100%;
        max-height: 100%;
        overflow-y: auto;
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .fade-in {
        animation: fadeIn 1s ease-in-out; /* Adjust duration and timing function as needed */
    }
</style>
