<!DOCTYPE html>
<style>

    @@media (max-width: 768px) {
        .nav-item {
            width: 55px !important; /* مثلاً کوچیک‌تر */
            font-size: 12px; /* اگه خواستی متن هم کوچیک بشه */
        }

        .radio-box {
            width: 99% !important;
            gap: 3.9px !important;
        }

        .radio-back {
            width: 52px !important;
            /*                height: 20px;
            display: flex;
            justify-content: center;
            border: 1px solid #06c7c9;
            border-top: none;
            cursor: pointer;
            border-radius: 0px 0px 10px 10px;*/
        }

        .text-information {
            font-size: 10px !important;
        }

        .btn-small {
            /*            transform:scale(.8);*/
            width: 20px !important;
            height: 20px !important;
        }

            .btn-small i {
                font-size: 10px;
                /*            padding:3px;*/
            }

        .title-hidden {
            align-items: end;
        }

        .text-title {
            font-size: 8px !important;
            width: 115px;
            height: 17px;
        }

        .title-hidden div:nth-child(2) label:nth-child(1) {
            margin-left: 0px !important;
        }

        .NumberCenter {
            width: 51px !important;
            margin-left: 3px;
        }

        .radio-text {
            margin-top: 5px !important;
            font-size: 8px !important;
        }
    }


    .modal3 {
        display: none;
        position: absolute;
        z-index: 1000;
        top: 100px !important;
        width: 100%;
        height: 300px;
        /* background-color: rgba(0, 0, 0, 0.4); */
        padding: 10px;
        right: 0;
    }

    .modal-content2 {
        background-color: transparent;
        backdrop-filter: blur(5px);
        position: relative; /* Add relative positioning */
        /*        margin: 15% auto;*/
        padding: 20px;
        border: 4px solid #00CAFC;
        border-radius: 10px;
        width: 100%;
        max-height: 100%;
        overflow-y: auto;
    }


    .close {
        color: #00CAFC;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: darkred;
            text-decoration: none;
            cursor: pointer;
        }

    .div-label {
        width: fit-content;
        margin-right: 20px !important;
    }

    .form-control {
        border-width: 2px;
    }

    /*        دیو مشخصات*/
    .Md {
        border: none;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        /*            gap: 10px;*/
        background-color: #135078;
    }

    .CMv {
        display: flex;
        flex-direction: row;
        gap: 20px;
        width: 100%;
        align-items: baseline;
    }

    .Mv {
        display: flex;
        /*          border:1px solid white;*/
        width: fit-content;
        height: 20px;
        font-size: 14px;
    }

    .row {
        margin-bottom: 20px;
    }


    .title-hidden {
        display: flex;
        flex-direction: row;
        gap: 2px;
    }

        .title-hidden div:nth-child(2) label:nth-child(1) {
            margin-left: 260px;
        }
    /*        .title-hidden div:nth-child(2) label:nth-child(2) {
    }*/

    .hidden-box {
        margin-top: 20px;
    }

    .hidden {
        display: flex;
        flex-direction: column;
        padding: 0px;
        border-radius: 8px;
        padding: 10px;
        gap: 10px;
        width: 100%;
    }

    .part-hidden {
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 5px;
        align-items: center;
    }

    .btn-small {
        /*            transform:scale(.8);*/
        width: 30px;
        height: 30px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        background: linear-gradient(129deg, rgba(29, 29, 27, 1) 0%, rgba(29, 113, 184, 1) 53%, rgba(54, 169, 225, 1) 100%);
        border: none;
        border-radius: 8px;
        padding: 3px;
    }

        .btn-small i {
            font-size: 14px;
            /*            padding:3px;*/
        }


    .form-check-input {
        /*            transform: scale(.6);*/
        margin: 0 !important;
    }

    .text-title {
        font-size: 14px;
    }

    .text-padding {
        width: 120px;
    }



    .text-small {
        font-size: 7px;
    }

    .btn-margin {
        /*            margin-right :20px;*/
    }


    input[type="radio"] {
        outline: none !important;
        box-shadow: none !important;
    }

        input[type="radio"]:focus {
            outline: none !important;
            box-shadow: none !important;
        }

        input[type="radio"]:focus-visible {
            outline: none !important;
            box-shadow: none !important;
        }



    .radio-box {
        width: 100%;
        display: flex;
        justify-content: center;
        /*            padding:5px;*/
        gap: 2px;
    }

    .radioha {
        margin-bottom: 0px !important;
        cursor: pointer;
        border-radius: 10px !important;
    }

    .radio-back {
        width: 98px;
        height: fit-content;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-top: 5px;
        cursor: pointer;
        border-radius: 0px 0px 10px 10px;
    }

        .radio-back:hover {
            border: 1px solid #06c7c9;
            border-top: none;
        }

    .radio-text {
        margin: 0;
        text-align: center;
    }

    .nav-item {
        width: 100px;
        text-align: center;
    }

    .tab-content {
        padding-top: 0px;
    }

    .NumberCenter {
        display: flex;
        justify-content: center;
        width: 98px;
    }
</style>
