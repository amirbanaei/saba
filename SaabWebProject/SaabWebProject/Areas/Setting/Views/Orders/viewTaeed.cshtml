            document.querySelectorAll('.toggle-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const selectedRadio = document.querySelector('input[name="tabradio"]:checked');

                    // ✅ بررسی انتخاب رادیو
                    if (!selectedRadio) {
                        alert("لطفاً یکی از گزینه‌های بالا را انتخاب کنید.");
                        return;
                    }

                    const val = selectedRadio.value;

                    const routes = {
                        "2": "/Setting/Orders/viewEntezar",
                        "3": "/Setting/Orders/viewErsal",
                        "4": "/Setting/Orders/viewTaeed"
                    };

                    if (routes[val]) {
                        // گرفتن عدد شغل از id دکمه
                        const btnId = btn.querySelector('svg')?.id; // مثل "Layer_3"
                        if (!btnId) {
                            alert("کد شغل پیدا نشد!");
                            return;
                        }

                        // فقط عدد آخر id (کد شغل)
                        const jobId = btnId.replace(/\D/g, ""); // حذف همه کاراکترهای غیرعددی

                        // نمایش برای تست (اختیاری)
                        console.log(`${routes[val]}?jobId=${jobId}`);

                        // انتقال به اکشن با پارامتر jobId
                        window.location.href = `${routes[val]}?jobId=${jobId}`;
                    }
                });
