<script>
    $(document).on("click", "#Sabt-BarnameRizi", function () {

        var data = {
            FK_Ticket_it_2: $("#TicketItId").val(),
            FK_Ticket_Motaghazi1: $("#TicketItId2").val(),
            Olaviat: $("#OlaveatDarkhast").val(),
            ZaroratAnjam: $("#Zaroorat").val(),
            SayerTozihat: $("#Sayer-BarnameRizi").val()
        };

        $.ajax({
            url: '@Url.Action("SaveBarnameRizi", "Orders")',
            type: 'POST',
            data: data,
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                } else {
                    alert(res.message);
                }
            },
            error: function () {
                alert("خطا در ارتباط با سرور");
            }
        });
    });
</script>







