<script>
    $("#upload10").click(function () {
        $("#summery_file10").click();
    });

    $("#summery_file10").change(function (e) {
        var file = e.target.files[0];
        if (!file) return;

        var vaz = $("#vaz").val();
        if (vaz == "0") {
            alert("لطفا نوع را انتخاب کنید.");
            return;
        }

        var fd3 = new FormData();
        fd3.append("MyExcelStream", file);
        fd3.append("vaz", vaz);

        sendAjax14('@Url.Action("Import_excel_reghtankar", "Orders", new { area = "Setting" })', fd3);
    });

    function sendAjax14(url2, fd2) {
        document.getElementById("loading-circle").style.display = "block";

        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (res) {
                document.getElementById("loading-circle").style.display = "none";
                $("#loading-message").css("display", "none");

                if (res == "True") {
                    alert("با موفقیت ثبت شد");
                } else {
                    alert(res);
                }
            },
            error: function (res) {
                document.getElementById("loading-circle").style.display = "none";
                $("#loading-message").css("display", "none");
                alert("با خطا مواجه شده است، لطفا بعدا تلاش فرمایید");
            }
        });
    }
    $("#btnDownload").click(function (e) {
    e.preventDefault(); // جلوگیری از رفتار پیش‌فرض لینک

    var vaz = $("#vaz").val();
    if (vaz == "0") {
        alert("لطفا نوع سرستون را انتخاب کنید.");
        return;
    }

    // آدرس پایه را از سمت سرور می‌گیریم
    var baseUrl = '@Url.Action("ExportAddMoalevosol", "Orders", new { area = "Setting" })';

    // آدرس نهایی را با پارامتر جدید می‌سازیم
    var finalUrl = baseUrl + "?vaz=" + vaz;

    // هدایت کاربر به لینک دانلود
    window.location.href = finalUrl;
});

</script>
