@using SaabWebProject.Models.DomainModels;

@{

    ViewBag.Title = "ارجاع وصول توسط امور";
    Layout = "~/Views/Shared/_Layout.cshtml";
    SaabEntities db = new SaabEntities();

}
@if (ViewBag.PerPersonAmount != null)
{
    <div style="margin-bottom:15px; background-color:black">
        با عنایت به راه اندازی سیستم ارجاع متمرکز و با توجه به مصوبه ستاد درخصوص تعیین بخشی از ظرفیت وصول هفتگی مامورین توسط امورات محترم (درصورت صلاحدید امور)، لطفا درصورت نیاز لیست اشتراکهای مورد نظر این هفته مامور را در فایل زیر بارگزاری نمایید. لازم بذکر است سقف قابل ارجاع توسط امور برای هر مامور مشخص شده است و درصورتیکه مبلغ بیشتر از این مقدار باشد بارگزاری فایل امکانپذیر نخواهد بود. خاطرنشان می سازد مابقی ظرفیت هفتگی هر مامور توسط سیستم ارجاع بصورت مکانیزه تعیین خواهد شد و درصورت عدم ارجاع توسط امور کل ظرفیت مامور بصورت مکانیزه ارجاع خواهد شد. همچنین دقت شود برای تکمیل اکسل فقط از مقادیر (اسامی مامورین) درج شده در شیت راهنما استفاده شود (کپی شود)، در غیراینصورت بارگزاری با خطا مواجه خواهد شد.

    </div>
}
@if (ViewBag.PerPersonAmount != null)
{ 
    <div class="alert alert-warning" style="margin-bottom:15px;">
        سقف مبلغ  قابل ارجاع امور برای هر یک مامور در این هفته مبلغ
        <strong>@string.Format("{0:N0}", ViewBag.PerPersonAmount)</strong> ریال
    </div>
}

