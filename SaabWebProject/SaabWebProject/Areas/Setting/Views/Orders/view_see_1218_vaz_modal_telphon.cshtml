    <script>
        let allLines2 = [];

        $(document).ready(function () {
            function createLine(from, to) {
                const line = new LeaderLine(from, to, {
                    color: 'var(--water-color)',
                    size: 8,
                    endPlug: 'arrow2',
                    endPlugSize: 0.4,
                    startSocket: 'bottom',
                    endSocket: 'top',
                    path: 'straight'
                });
                allLines.push(line);
                return line;
            }

            // خطوط خاص هر ستون
            createLine(document.querySelector('.khat1'));


            // MutationObserver برای انیمیشن آب
            const observer = new MutationObserver(() => {
                setTimeout(() => allLines.forEach(l => l.position()), 1100);
            });
            observer.observe(document.querySelector('.water-level1'), { attributes: true });

            // Ultra-safe resize handler
            let resizeTimer;
            const updateAll = () => {
                allLines.forEach(line => {
                    try { line.position(); } catch (e) { }
                });
            };

            $(window).on('resize zoom orientationchange', () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(updateAll, 150);
            });

            // هر 2 ثانیه چک اضافی (برای safety)
            setInterval(updateAll, 1000);
        });
    </script>
    <script>
        $(document).ready(function () {
            // ۸ متغیر - مقدار اولیه ۰ = legend نمایش، main مخفی
            let elem1 = 1, elem2 = 0, elem3 = 0, elem4 = 0,
                elem5 = 0, elem6 = 0, elem7 = 0, elem8 = 0;

            // تابع نمایش/مخفی بر اساس متغیرها
            function updateVisibility() {
                // elem1
                if (elem1 === 0) {
                    $('.legend-item').eq(0).show();
                    $('.rotate .cols-modal').eq(0).hide(); // اولین ستون rotate
                } else {
                    $('.legend-item').eq(0).hide();
                    $('.rotate .cols-modal').eq(0).show();
                }

                // elem2
                if (elem2 === 0) {
