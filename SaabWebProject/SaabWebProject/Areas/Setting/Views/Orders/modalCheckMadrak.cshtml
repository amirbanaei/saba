        data.FK_sabtdoreh = @Model.ID;

        // ارسال به اکشن
        $.ajax({
            type: "POST",
url: '@Url.Action("sabtmavaredemohem13", "Orders", new { area = "Setting" })',
            data: JSON.stringify([data]), // چون اکشن List<DocumentItemViewModel> می‌گیره
            contentType: "application/json; charset=utf-8",
            success: function (res) {
