                    alert("اطلاعات با موفقیت ثبت شد ✅");
                    location.reload();

                } else {
                    alert(" اطلاعات با موفقیت ثبت شد لطفا چک بفرمایید ✅");
                    location.reload();

                }
            },
            error: function (xhr) {
                alert("خطا در ثبت اطلاعات: " + xhr.responseText);
                console.log()
            }
        });
    });
</script>