            checkboxIds.push($(this).attr("id"));
        });

        data.checkboxIds = checkboxIds;
        // مرجع صادر کننده
        data.margaesaderkonande = $("#person-description2").val();

        // نمره ارزیابی
        data.nomrearzyabi = $("#person-description3").val();

        // شماره مدرک
        data.shomaremadrak = $("#person-description4").val();


        // دلایل (در صورت رد یا اصلاح)
        if (data.vaziat == 1) { // رد
            data.HalateRadShode = $("#tik").is(":checked") ? 1 : 0;
            data.SharhRad = $("#selectDiv select").val();
        } else if (data.vaziat == 2) { // اصلاح
            data.SharhRad = $(".edit input").val();
        }
        data.SharhRad = $("#SHARHHH").val();
        // اینا باید از کانتکست صفحه مقداردهی بشن (مثلا hidden field)
