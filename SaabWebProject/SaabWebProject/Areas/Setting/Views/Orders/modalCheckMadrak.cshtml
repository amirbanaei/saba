<script>
    const radios = document.getElementsByName('vaziat');

    radios.forEach(radio => {
        radio.addEventListener('change', function () {
            const allDivs = document.querySelectorAll('.accept, .reject, .edit'); // همه المان‌های قابل مدیریت

            allDivs.forEach(div => {
                // پیش‌فرض همه مخفی میشن
                div.style.display = 'none';

                // بررسی کلاس‌ها و مقدار وضعیت
                if (this.value === '0' && div.classList.contains('accept')) {
                    div.style.display = 'inline-block';
                }
                if (this.value === '1' && div.classList.contains('reject')) {
                    div.style.display = 'inline-block';
                }
                if (this.value === '2' && div.classList.contains('edit')) {
                    div.style.display = 'inline-block';
                }
            });
        });
    });

</script>






