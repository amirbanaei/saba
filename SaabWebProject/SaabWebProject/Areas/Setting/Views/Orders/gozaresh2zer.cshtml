<script>
    async function exportToPdfFromLuckysheet() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF('l', 'mm', 'a4'); // حالت افقی بهتره برای جدول

        for (let sheet of luckysheet.getAllSheets()) {
            const sheetData = sheet.data;
            if (!sheetData) continue;

            const headers = [];
            const rows = [];

            for (let r = 0; r < sheetData.length; r++) {
                const row = sheetData[r];
                const rowData = [];

                for (let c = 0; c < row.length; c++) {
                    const cell = row[c];
                    rowData.push(cell?.v || '');
                }

                if (r === 0) {
                    headers.push(...rowData);
                } else {
                    rows.push(rowData);
                }
            }

            doc.autoTable({
                head: [headers],
                body: rows,
                styles: { font: 'sans', fontSize: 10 },
                headStyles: { fillColor: [52, 152, 219] },
                theme: 'grid',
                margin: { top: 20 }
            });

            doc.addPage();
        }

        doc.save("گزارش-luckysheet.pdf");
    }
</script>

<script>
    let allSheets = [];

    function fetchAndAddSheetDynamic(apiUrl, sheetName) {
        fetch(apiUrl)
            .then(res => res.json())
            .then(pivotData => {
                if (!pivotData || pivotData.length === 0) {
                    alert("داده‌ای وجود ندارد.");
                    return;
                }
                console.log(pivotData);
                // استخراج کلیدهای ستون‌ها از کلیدهای شیء اول
                const firstRow = pivotData[0];
                const colNames = Object.keys(firstRow);
                console.log(firstRow);
                console.log(colNames);

                if (colNames.length < 2) {
                    alert("ساختار داده نامعتبر است.");
                    return;
                }

                const rowKey = colNames[0]; // کلید ردیف مثل: 'کد پرسنلی'
                const colKeys = colNames.slice(1); // بقیه کلیدها ستون‌های ماتریس‌اند
                console.log("rowKey" + rowKey);
                console.log("colKeys" + colKeys);
                const rowLabels = pivotData.map(r => r[rowKey]);
                const uniqueRows = [...new Set(rowLabels)];
                const uniqueCols = [...new Set(colKeys)];
                console.log("uniqueRows" + uniqueRows);
                console.log("uniqueCols" + uniqueCols);
                console.log("rowLabels" + rowLabels);


                const rowCount = uniqueRows.length + 1;
                const colCount = uniqueCols.length + 1;
                const data = Array.from({ length: rowCount }, () => Array(colCount).fill(null));

                // عنوان ردیف اول
                data[0][0] = { v: rowKey };

                // عناوین ستون‌ها
                for (let c = 0; c < uniqueCols.length; c++) {
                    data[0][c + 1] = { v: uniqueCols[c] };
                }

                // مقادیر ردیف‌ها + داده‌ها
                for (let r = 0; r < uniqueRows.length; r++) {
                    const rowLabel = uniqueRows[r];
                    data[r + 1][0] = { v: rowLabel };

                    // پیدا کردن ردیف اصلی
                    const rowData = pivotData.find(x => x[rowKey] === rowLabel);
                    if (!rowData) continue;

                    for (let c = 0; c < uniqueCols.length; c++) {
                        const colKey = uniqueCols[c];
                        const value = rowData[colKey];
                        data[r + 1][c + 1] = { v: value };
                    }
                }

                allSheets.push({
                    name: sheetName,
                    data: data
                });

                luckysheet.create({
                    container: 'luckysheet',
                    data: allSheets,
                    showtoolbar: true,
                    showinfobar: true,
                    showstatisticBar: true,
                    showSheetbar: true,
                    enableAddRow: true,
                    enableAddCol: true,
                    //===========
                    functionPlugin: true,
                    //===========

                });

                alert(`شیت "${sheetName}" اضافه شد.`);
            })
            .catch(err => {
                console.error("خطا:", err);
                alert("خطا در دریافت داده");
            });
    }

    // رویداد برای گزارش پویا
    document.getElementById('btn-fill-dynamic')?.addEventListener('click', () => {
        const reportId = document.getElementById('reportIdInput')?.value;
        if (!reportId) {
            alert("لطفاً شناسه گزارش را وارد کنید.");
            return;
        }
        fetchAndAddSheetDynamic(`/Salaries/Formula/GetPivotDataDynamic?reportId=${reportId}`, `Report_${reportId}`);
    });


</script>
<script>
    document.getElementById('btn-export-excel')?.addEventListener('click', () => {
        if (!allSheets.length) {
            alert("هیچ شیتی برای خروجی وجود ندارد.");
            return;
        }

        const wb = XLSX.utils.book_new();

        allSheets.forEach(sheet => {
            const rawData = sheet.data;
            const ws = {};
            const merges = [];

            for (let r = 0; r < rawData.length; r++) {
                for (let c = 0; c < rawData[r].length; c++) {
                    const cell = rawData[r][c];
                    if (!cell) continue;

                    const cellRef = XLSX.utils.encode_cell({ r, c });
                    const outCell = {};
                    let val = cell.v;

                    // تبدیل true/false (به صورت رشته یا بولی) به 1 و 0
                    if (typeof val === "string" && val.trim().toLowerCase() === "true") {
                        val = 1;
                    } else if (typeof val === "string" && val.trim().toLowerCase() === "false") {
                        val = 0;
                    } else if (val === true) {
                        val = 1;
                    } else if (val === false) {
                        val = 0;
                    }

                    // اگر فرمول بود
                    if (cell.f) {
                        outCell.f = cell.f;
                        if (!isNaN(val) && val !== "") {
                            outCell.v = parseFloat(val);
                            outCell.t = "n";
                        } else {
                            outCell.v = val;
                            outCell.t = "s";
                        }
                    } else if (!isNaN(val) && val !== "") {
                        outCell.v = parseFloat(val);
                        outCell.t = "n";
                    } else {
                        outCell.v = val;
                        outCell.t = "s";
                    }

                    // استایل‌ها
                    if (cell.bg || cell.fc || cell.bl || cell.it) {
                        outCell.s = {
                            fill: cell.bg
                                ? { patternType: "solid", fgColor: { rgb: cell.bg.replace("#", "") } }
                                : undefined,
                            font: {
                                bold: !!cell.bl,
                                italic: !!cell.it,
                                color: cell.fc ? { rgb: cell.fc.replace("#", "") } : undefined
                            },
                            alignment: {
                                horizontal: "center",
                                vertical: "center",
                                wrapText: true
                            }
                        };
                    }

                    ws[cellRef] = outCell;
                }
            }

            // مرج‌ها
            if (sheet.config?.merge) {
                for (const key in sheet.config.merge) {
                    const m = sheet.config.merge[key];
                    merges.push({
                        s: { r: m.r, c: m.c },
                        e: { r: m.r + m.rs - 1, c: m.c + m.cs - 1 }
                    });
                }
                ws["!merges"] = merges;
            }

            // محدوده شیت
            const range = XLSX.utils.encode_range({
                s: { r: 0, c: 0 },
                e: { r: rawData.length - 1, c: rawData[0]?.length - 1 || 0 }
            });
            ws["!ref"] = range;

            XLSX.utils.book_append_sheet(wb, ws, sheet.name);
        });

        XLSX.writeFile(wb, "PivotReports.xlsx");
    });

</script>

<script>
