<script>
    $(document).ready(function () {

        /* =========================================================
           0) HELPERS
        ========================================================= */

        function initPicker($scope) {
            $scope.find(".peyman-search").each(function () {
                if (!$(this).data("picker-initialized")) {
                    $(this).picker({ search: true });
                    $(this).data("picker-initialized", true);
                }
            });
        }

        initPicker($(document));

        function formatNumberValue(value) {
            value = (value || "").replace(/[^0-9]/g, "");
            return value.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        function formatNumberInput(input) {
            input.value = formatNumberValue(input.value);
        }

        /* =========================================================
           1) TAB 3 : وضعیت نهایی
        ========================================================= */

        $("#sabt-tab3").on("click", function () {
            let data = {
                UserId: parseInt("@Model.usrID"),
                FK_gozaresh1: $("#onvan1-tab3").val(),
                FK_name: $("#karbar1-tab3").val(),
                Mablagh: ($("#mablagh-tab3").val() || "").replace(/,/g, ""),
                Alamat: $("#vazeat-tab3").val()
            };

            if (!data.FK_gozaresh1 || !data.FK_name || !data.Mablagh || !data.Alamat) {
                alert("لطفا همه فیلدها را تکمیل کنید");
                return;
            }

            $.ajax({
                url: "/Setting/Orders/SaveOlaviatTab3",
                type: "POST",
                data: JSON.stringify(data),
                contentType: "application/json",
                success: function (res) {
                    if (res.success) {
                        alert("ثبت شرط مبلغ با موفقیت انجام شد");
                    } else {
                        alert(res.message || "خطا در ثبت اطلاعات");
                    }
                },
                error: function () {
                    alert("خطا در ثبت اطلاعات");
                }
            });
        });

        /* =========================================================
           2) TAB 2 : باشد / نباشد
        ========================================================= */

        $("#sabt-tab2").on("click", function () {
            let data = {
                UserId: parseInt("@Model.usrID"),
                FK_gozaresh1: $("#onvan1-tab2").val(),
                FK_name: $("#karbar1-tab2").val(),
                Vazeat: $("#vazeat-tab2").val(),
                FK_gozaresh2: $("#onvan2-tab2").val(),
                FK_name2: $("#karbar2-tab2").val()
            };

            if (!data.FK_gozaresh1 || !data.FK_name || !data.Vazeat) {
                alert("لطفا همه فیلدهای ضروری را پر کنید");
                return;
            }

            $.ajax({
                url: "/Setting/Orders/SaveOlaviatTab2",
                type: "POST",
                data: JSON.stringify(data),
                contentType: "application/json",
                success: function (res) {
                    if (res.success) {
                        alert("ثبت با موفقیت انجام شد");
                    } else {
                        alert(res.message || "خطا در ثبت اطلاعات");
                    }
                },
                error: function () {
                    alert("خطا در ثبت اطلاعات");
                }
            });
        });

        /* =========================================================
           3) TAB 5 : ردیف‌های دارای مقدار و عدد
        ========================================================= */

        function reIndexTab5Rows() {
            $("#container5 .dynamic-row-tab5").each(function (i) {
                let idx = i + 1;

                $(this).find(".lbl-onvan").text("عنوان فیلد " + idx);
                $(this).find(".lbl-user").text("نام ستون " + idx);
                $(this).find(".lbl-op").text("علامت " + idx);
                $(this).find(".lbl-val").text("مقدار " + idx);
                $(this).find(".lbl-num").text("عدد " + idx);

                $(this).find(".sel-onvan").attr("id", "select_peyman_" + idx);
                $(this).find(".sel-user").attr("id", "select_users_" + idx);
                $(this).find(".sel-op").attr("id", "SelectPeyman_" + idx);
                $(this).find(".inp-val").attr("id", "meghdar_" + idx);
                $(this).find(".inp-num").attr("id", "Olaveat_" + idx);
            });
        }

        function addTab5Row() {
            let index = $("#container5 .dynamic-row-tab5").length + 1;

            let newRow = `
            <div class="row dynamic-row-tab5 mb-2">
                <div class="col-xl-3">
                    <label class="form-label lbl-onvan">عنوان فیلد ${index}</label>
                    <select class="form-select select_peyman1 sel-onvan" name="select_peyman[]">
