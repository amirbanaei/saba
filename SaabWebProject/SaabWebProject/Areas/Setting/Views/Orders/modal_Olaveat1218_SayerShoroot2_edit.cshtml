                    <select class="form-select select_peyman sel-op" name="SelectPeyman[]">
                        <option hidden></option>
                        <option value="1">-</option>
                        <option value="2">+</option>
                        <option value="3">*</option>
                        <option value="4">/</option>
                        <option value="5">=</option>
                        <option value="7">></option>
                        <option value="9"><</option>
                        <option value="8">>=</option>
                        <option value="10"><=</option>
                        <option value="6">B</option>
                    </select>
                </div>

                <div class="col-xl-2">
                    <label class="form-label lbl-val">مقدار ${index}</label>
                    <input class="form-control inp-val" />
                </div>

                <div class="col-xl-1">
                    <label class="form-label lbl-num">عدد ${index}</label>
                    <input class="form-control inp-num" />
                </div>

                <div class="col-xl-1 pt-4">
                    <button type="button" class="btn btn-danger form-control removeRowTab5">
                        <i class="bi bi-x-circle fa-fw me-1 VecGeneral"></i>
                        <span class="bSabt-text">حذف</span>
                    </button>
                </div>
            </div>`;

            $("#container5").append(newRow);
            initPicker($("#container5"));
            reIndexTab5Rows();
        }

        $(document).on("click", ".addFirstRow", function () {
            addTab5Row();
        });

        $(document).on("click", ".removeRowTab5", function () {
            $(this).closest(".dynamic-row-tab5").remove();
            reIndexTab5Rows();
        });

        /* =========================================================
           4) TAB 1 : محاسباتی + IF + جمع بندی نهایی
        ========================================================= */

        function addCalcRow() {
            let index = $("#rowsContainer .dynamic-row").length + 1;

            let rowHtml = `
            <div class="row dynamic-row mb-2 border-bottom pb-2">
                <div class="col-xl-4">
                    <label class="form-label lbl-onvan">عنوان فیلد ${index}</label>
                    <select class="form-select select_peyman1 sel-gozaresh">
                        <option hidden value="Select">انتخاب مورد</option>
                        @foreach (var item in db.dbergharel_4_4.ToList())
                        {
                            <option value="@item.ID">@item.name</option>
                        }
                    </select>
                </div>

                <div class="col-xl-4">
                    <label class="form-label lbl-user">نام ستون ${index}</label>
                    <select class="form-select peyman-search sel-name">
                        <option value="0">انتخاب کنید</option>
                        @foreach (var item in db.dbergharel4_5.ToList())
                        {
                            <option value="@item.FK_dbergharel2">@item.dbergha2.name ✅</option>
                        }
                    </select>
                </div>

                <div class="col-xl-2">
                    <label class="form-label lbl-op">علامت ${index}</label>
                    <select class="form-select sel-alamat">
                        <option hidden></option>
                        <option value="1">-</option>
                        <option value="2">+</option>
                        <option value="3">*</option>
                        <option value="4">/</option>
                        <option value="5">=</option>
                        <option value="7">></option>
                        <option value="9"><</option>
                        <option value="8">>=</option>
                        <option value="10"><=</option>
                        <option value="6">B</option>
                    </select>
                </div>

                <div class="col-xl-2 pt-4">
                    <button type="button" class="btn btn-danger btn-sm removeCalcRow w-100">
                        حذف
                    </button>
                </div>
            </div>`;

            $("#rowsContainer").append(rowHtml);
            initPicker($("#rowsContainer"));
            reIndexCalcRows();
        }

        function reIndexCalcRows() {
            $("#rowsContainer .dynamic-row").each(function (i) {
                let idx = i + 1;
                $(this).find(".lbl-onvan").text("عنوان فیلد " + idx);
                $(this).find(".lbl-user").text("نام ستون " + idx);
                $(this).find(".lbl-op").text("علامت " + idx);
            });
        }

        function addIfRow() {
            let ifIndex = $("#ifRowsContainer .if-row").length + 1;

            let ifHtml = `
            <div class="if-row mb-2 border-bottom pb-2">
                <div class="row">
                    <div class="col-xl-2">
                        <label class="small">منطق ${ifIndex}</label>
                        <select class="form-select sel-if-logic">
                            <option value="AND">AND</option>
                            <option value="OR">OR</option>
                            <option value="AND NOT">AND NOT</option>
                            <option value="OR NOT">OR NOT</option>
                        </select>
                    </div>
                    <div class="col-xl-3">
                        <label class="small">فیلد شرط ${ifIndex}</label>
                        <select class="form-select sel-if-gozaresh">
                            <option value="">انتخاب...</option>
                            @foreach (var item in db.dbergharel_4_4.ToList())
                            {
                                <option value="@item.ID">@item.name</option>
                            }
                        </select>
                    </div>
                    <div class="col-xl-3">
                        <label class="small">نام ستون ${ifIndex}</label>
                        <select class="form-select peyman-search sel-if-name">
                            <option value="">انتخاب...</option>
                            @foreach (var item in db.dbergharel4_5.ToList())
                            {
                                <option value="@item.FK_dbergharel2">@item.dbergha2.name ✅</option>
                            }
                        </select>
                    </div>
                    <div class="col-xl-2">
                        <label class="small">علامت ${ifIndex}</label>
                        <select class="form-select sel-if-alamat">
                            <option value="1">=</option>
                            <option value="2">!=</option>
                            <option value="3">></option>
                            <option value="4"><</option>
                            <option value="5">>=</option>
                            <option value="6"><=</option>
                        </select>
                    </div>
                    <div class="col-xl-1">
                        <label class="small">مقدار ${ifIndex}</label>
                        <input type="text" class="form-control sel-if-val" />
                    </div>
                    <div class="col-xl-1 pt-4">
                        <button type="button" class="btn btn-danger btn-sm removeIfRow">
                            حذف
                        </button>
                    </div>
                </div>
            </div>`;

            $("#ifRowsContainer").append(ifHtml);
            initPicker($("#ifRowsContainer"));
            reIndexIfRows();
        }

        function reIndexIfRows() {
            $("#ifRowsContainer .if-row").each(function (i) {
                let idx = i + 1;
                $(this).find(".small").eq(0).text("منطق " + idx);
                $(this).find(".small").eq(1).text("فیلد شرط " + idx);
                $(this).find(".small").eq(2).text("نام ستون " + idx);
                $(this).find(".small").eq(3).text("علامت " + idx);
                $(this).find(".small").eq(4).text("مقدار " + idx);
            });
        }

        $("#useIfCondition").on("change", function () {
            if ($(this).val() === "1") {
                $("#ifRowsContainer, #addIfRowBtn").slideDown();
                if ($("#ifRowsContainer .if-row").length === 0) {
                    addIfRow();
                }
            } else {
                $("#ifRowsContainer, #addIfRowBtn").slideUp();
            }
        });

        $("#addRowBtn").on("click", function () {
            let hasRestrictedOperator = false;

            $("#rowsContainer .dynamic-row").each(function () {
                let val = $(this).find(".sel-alamat").val();
                if (["5", "6", "7", "8", "9", "10"].includes(val)) {
                    hasRestrictedOperator = true;
                    return false;
                }
            });

            if (hasRestrictedOperator) {
                alert("شما در این حالت نمی‌توانید ردیف جدیدی اضافه کنید!");
                return;
            }

            addCalcRow();
        });

        $("#addIfRowBtn").on("click", function () {
            addIfRow();
        });

        $(document).on("click", ".removeCalcRow", function () {
            $(this).closest(".dynamic-row").remove();
            reIndexCalcRows();
        });

        $(document).on("click", ".removeIfRow", function () {
            $(this).closest(".if-row").remove();
            reIndexIfRows();
        });

        $(document).on("change", "#rowsContainer .sel-alamat", function () {
            let $changedRow = $(this).closest(".dynamic-row");
            let val = $(this).val();

            if (["5", "6", "7", "8", "9", "10"].includes(val)) {
                $changedRow.nextAll(".dynamic-row").remove();
                reIndexCalcRows();
                alert("شما در این حالت نمی‌توانید ردیف جدیدی اضافه کنید!");
            }
        });

        $("#finalSummaryBtn").on("click", function () {
            let rows = $("#rowsContainer .dynamic-row");

            if (rows.length === 0) {
                $("#finalSummaryContainer").hide().empty();
                alert("هیچ ردیفی برای جمع بندی وجود ندارد!");
                return;
            }

            let hasB = false;
            rows.each(function () {
                if ($(this).find(".sel-alamat").val() === "6") {
                    hasB = true;
                    return false;
                }
            });

            $("#finalSummaryContainer").empty();

            let summaryRow = '<div class="row mb-2">';
            if (hasB) {
                summaryRow += `
                    <div class="col-xl-3">
                        <label class="form-label">از این</label>
                        <input id="field1" type="text" class="form-control" placeholder="مقدار اول">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label">تا این</label>
                        <input id="field2" type="text" class="form-control" placeholder="مقدار دوم">
                    </div>
                `;
            } else {
                summaryRow += `
                    <div class="col-xl-3">
                        <label class="form-label">مساوی</label>
                        <input id="field3" type="text" class="form-control" placeholder="مقدار">
                    </div>
                `;
            }
            summaryRow += '</div>';

            $("#finalSummaryContainer").append(summaryRow).slideDown(400);
        });

        $("#sabt-tab1").on("click", function () {
            let rowsData = [];

            $("#rowsContainer .dynamic-row").each(function () {
                let row = {
                    FK_gozaresh1: $(this).find(".sel-gozaresh").val(),
                    FK_name: $(this).find(".sel-name").val(),
                    alamat: $(this).find(".sel-alamat").val()
                };

                if (row.FK_gozaresh1 && row.FK_gozaresh1 !== "Select") {
                    rowsData.push(row);
                }
            });

            let finalData = {
                UserId: parseInt("@Model.usrID"),
                Rows: rowsData,
                Val1: $("#field1").val() || "",
                Val2: $("#field2").val() || "",
                Val3: $("#field3").val() || ""
            };

            $.ajax({
                url: "/Setting/Orders/SaveOlaviat1218Calc",
                type: "POST",
                data: JSON.stringify(finalData),
                contentType: "application/json",
                success: function () {
                    alert("ثبت با موفقیت انجام شد");
                },
                error: function () {
                    alert("خطا در ثبت اطلاعات");
                }
            });
        });

        $("#sabt-tab12").on("click", function () {
            let rows = [];

            $("#rowsContainer .dynamic-row").each(function () {
                let gozaresh = $(this).find(".sel-gozaresh").val();
                let name = $(this).find(".sel-name").val();
                let alamat = $(this).find(".sel-alamat").val();

                if (gozaresh && gozaresh !== "Select") {
                    rows.push({
                        FK_gozaresh1: parseInt(gozaresh),
                        FK_name: parseInt(name || 0),
                        alamat: parseInt(alamat || 0)
                    });
                }
            });

            console.log("Rows count found: ", rows.length);
            console.log("Rows data: ", rows);

            if (rows.length === 0) {
                alert("هیچ ردیف محاسباتی معتبری یافت نشد. لطفا ردیف‌ها را پر کنید.");
                return;
            }

            let conditions = [];
            if ($("#useIfCondition").val() === "1") {
                $("#ifRowsContainer .if-row").each(function () {
                    let gozareshIf = $(this).find(".sel-if-gozaresh").val();
                    let nameIf = $(this).find(".sel-if-name").val();
                    let alamatIf = $(this).find(".sel-if-alamat").val();
                    let valueIf = $(this).find(".sel-if-val").val();

                    if (gozareshIf) {
                        conditions.push({
                            logic: $(this).find(".sel-if-logic").val(),
                            FK_gozaresh_if: parseInt(gozareshIf),
                            FK_name_if: parseInt(nameIf || 0),
                            alamat_if: parseInt(alamatIf || 0),
                            shart_value: valueIf || ""
                        });
                    }
                });
            }

            let data = {
                UserId: parseInt("@Model.usrID"),
                Rows: rows,
                IfConditions: conditions,
                IsIf: parseInt($("#useIfCondition").val() || 0),
                Val1: $("#field1").val() || "",
                Val2: $("#field2").val() || "",
                Val3: $("#field3").val() || ""
            };

            $.ajax({
                url: "/Setting/Orders/SaveOlaviat1218Calc2",
                type: "POST",
                data: JSON.stringify(data),
                contentType: "application/json",
                success: function (res) {
                    if (res.success) {
                        alert("تمامی اطلاعات با موفقیت ثبت شد");
                    } else {
                        alert("خطا از سرور: " + (res.message || ""));
                    }
                },
                error: function (err) {
                    alert("خطا در ارتباط با سرور");
                    console.error(err);
                }
            });
        });

        if ($("#rowsContainer .dynamic-row").length === 0) {
            addCalcRow();
        }

        if ($("#useIfCondition").val() === "1") {
            $("#ifRowsContainer, #addIfRowBtn").show();
            if ($("#ifRowsContainer .if-row").length === 0) {
                addIfRow();
            }
        } else {
            $("#ifRowsContainer, #addIfRowBtn").hide();
        }

        /* =========================================================
           5) LOAD DYNAMIC PEYMAN / USER
        ========================================================= */

        window.initPeymanSelect = function ($row) {
            $row.find(".peymans").load('@Url.Content("/../Setting/Orders/_GetAllListPeyman_gozaresh")', function () {
                let $select = $row.find("select.select_peyman");
                let $userInput = $row.find(".userinput");
                let $userDiv = $row.find(".UserOFPeyman");

                $select.off("change").on("change", function () {
                    let id = $(this).val();
                    $userInput.hide();
                    $userDiv.load('@Url.Content("/../Setting/Orders/_GetusersBaseOnarzyabiunics")?PeymanID=' + id);
                });
            });
        };

        /* =========================================================
           6) FORMAT NUMBER FIELDS
        ========================================================= */

        $(document).on("input", "#Mablagh1", function () {
            formatNumberInput(this);
        });

        $(document).on("input", "#Mablagh2", function () {
            formatNumberInput(this);
        });

        $(document).on("input", "#mablagh-tab3", function () {
            formatNumberInput(this);
        });

        /* =========================================================
           7) MODAL SUBMIT
        ========================================================= */

        $("#btnSubmitModal2").on("click", function () {
            var FK_olaviat = @Model.usrID;
            var input1 = $("#input1-SayerShoroot").val();
            var input2 = $("#input2-SayerShoroot").val();
            var FK_db2 = $("#select_peyman").val();
            var FK_db4_4 = $("#select_peyman22").val();
            var mablagh1_1 = ($("#Mablagh1").val() || "").replace(/,/g, '');
            var vaziat1 = $("#Alamat1").val();
            var mablagh1_2 = ($("#Mablagh2").val() || "").replace(/,/g, '');
            var vaziat2 = $("#Alamat2").val();

            $.ajax({
                url: '/Setting/Orders/SaveOlaviat1218Link',
                type: 'POST',
                data: {
                    FK_olaviat: FK_olaviat,
                    input1: input1,
                    input2: input2,
                    FK_db2: FK_db2,
                    mablagh1_1: mablagh1_1,
                    vaziat1: vaziat1,
                    mablagh1_2: mablagh1_2,
                    vaziat2: vaziat2,
                    FK_db4_4: FK_db4_4
                },
                success: function () {
                    alert("ثبت با موفقیت انجام شد");
                    $("#mymodal3").fadeOut();
                    location.reload();
                },
                error: function () {
                    alert("خطا در ثبت اطلاعات");
                }
            });
        });

    });
</script>
