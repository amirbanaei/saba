    <script>
$(document).ready(function () {

    $("#Send").click(function (e) {
        e.preventDefault(); // جلوگیری از رفتار پیش‌فرض لینک

        var data = [];

        $("table tbody tr").each(function () {
            var $tr = $(this);
            var id = $tr.data("id");

            var darAnbar = $tr.find("td:eq(2) input").val().trim();
            var nazdMamor = $tr.find("td:eq(3) input").val().trim();
            var sharh = $tr.find("td:eq(4) input").val().trim();
            var jam = $tr.find("td:eq(5) input").val().trim();

            // تبدیل خالی‌ها به null
            darAnbar = darAnbar === "" ? null : parseInt(darAnbar, 10);
            nazdMamor = nazdMamor === "" ? null : parseInt(nazdMamor, 10);
            jam = jam === "" ? null : parseInt(jam, 10);
            sharh = sharh === "" ? null : sharh;

            // فقط اگر حداقل یکی از مقادیر پر باشد
            if (darAnbar !== null || nazdMamor !== null || jam !== null || sharh !== null) {
                data.push({
                    Fk_TarifKalayeAsasi: parseInt(id),
                    darAnbar: darAnbar,
                    nazdMamor: nazdMamor,
                    sharh: sharh,
                    jam: jam,
                    TimeSabt: $("#miladi_date1").val()
                });
            }
        });

        if (data.length === 0) {
            alert("هیچ داده‌ای برای ثبت وجود ندارد!");
            return;
        }

        $.ajax({
            type: "POST",
            url: '@Url.Action("SaveKalaEstedad","Orders")',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify(data),
            success: function (response) {
                if (response.success) {
                    alert("✅ " + response.message);
                    location.reload();
                } else {
                    alert("❌ خطا: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("⚠️ خطای شبکه یا سرور: " + error);
            }
        });
    });

});
    </script>






