    <script>
        $(document).ready(function () {
            // گوش دادن به تغییر مقدار هر input با کلاس TdInput
            $(document).on("input", ".TdInput", function () {
                var $row = $(this).closest("tr"); // ردیف فعلی
                var sum = 0;

                // فقط چهار ستون اول عددی (از ستون ۳ تا ۶)
                $row.find("td:eq(2) input, td:eq(3) input").each(function () {
                    var val = $(this).val().replace(/[^0-9]/g, ""); // فقط عدد
                    $(this).val(val); // اصلاح مقدار ورودی
                    if (val) sum += parseInt(val, 10);
                });

                // نمایش جمع در ستون آخر (ستون ۸م)
                $row.find("td:last input").val(sum > 0 ? sum : "");
            });
        });
    </script>


