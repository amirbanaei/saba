
@{
    ViewBag.Title = "جدول وصول";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<style>
    th {
        background-color: var(--bs-table-th-bg) !important;
        border-right: 1px solid white;
        padding: 5px;
    }
</style>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>TableVosool</title>
    <link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
</head>
<body>
    <div class="tab-content" id="pills-tabContent">
        <div class="table-responsive tableH_Lock">
            <table class="table table-hover text-nowrap">
                <tr style="text-align:center">
                    <th colspan="3" style="border-top-right-radius: 8px; border: none; border-bottom: 1px solid white !important">
                        @Html.DisplayName("قرائت")
                    </th>
                    <th colspan="3" style="border-bottom:1px solid white !important">
                        @Html.DisplayName("ارزایابی(تهیه کروکی)")
                    </th>
                    <th colspan="4" style="border-bottom: 1px solid white !important">
                        @Html.DisplayName("مونتاژ و نصب کنتور ")
                    </th>
                    <th colspan="6" style="border-bottom: 1px solid white !important">
                        @Html.DisplayName("اصلاح و سرویس")

                    </th>
                    <th colspan="2" style="border-bottom: 1px solid white !important">
                        @Html.DisplayName("جمع آوری غیر مجاز")

                    </th>
                    <th colspan="1" rowspan="3" style="border-top-left-radius: 8px; border-bottom-left-radius: 8px; ">
                        @Html.DisplayName("وصول")

                    </th>

                </tr>

                <tr>
                    <th rowspan="2" style="border-radius: 0px !important; border: none; border-bottom-right-radius: 8px !important;">شهری</th>
                    <th rowspan="2">روستایی</th>
                    <th rowspan="2">خارج از محدوده</th>
                    <th rowspan="2">شهری</th>
                    <th rowspan="2">روستایی</th>
                    <th rowspan="2">خارج از محدوده</th>
                    <th>عادی</th>
                    <th>عادی</th>
                    <th>دیماند</th>
                    <th>دیماند</th>
                    <th>شهری</th>
                    <th>شهری</th>
                    <th>شهری</th>
                    <th>روستایی</th>
                    <th>روستایی</th>
                    <th>روستایی</th>
                    <th rowspan="2">عادی</th>
                    <th rowspan="2" style="border-radius:0px !important;">دیماند</th>


                </tr>
                <tr>
                    <th style="border-radius:0px !important;">شهری</th>
                    <th>روستایی</th>
                    <th>شهری</th>
                    <th>روستایی</th>
                    <th>تکفاز</th>
                    <th>سه فاز</th>
                    <th>دیماند</th>
                    <th>تکفاز</th>
                    <th>سه فاز</th>
                    <th style="border-radius:0px !important;">دیماند</th>

                </tr>

                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>

            </table>
        </div>
    </div>

</body>
</html>
