        alert("لطفاً ماه و سال را انتخاب کنید.");
        return;
    }

    $.ajax({
        url: '@Url.Action("SaveOrUpdate", "Orders", new { area = "Setting" })',
        type: "POST",
        data: { select_peyman: year, select_peyman22: usrID, select_peyman1: fild, name:@Model.usrID, string_name: sabteghdam },
        success: function (result) {
            document.getElementById("loading-circle").style.display = "none";
