    <style>
        .animate-lamp {
            animation: lamp 1s infinite;
        }

        @@keyframes lamp {
            0%,100% {
                text-shadow: 0 0px 0px aqua;
                font-size: 17px;
                color: white;
            }

            50% {
                text-shadow: 0 0px 10px aqua;
                color: aqua;
                font-size: 19px;
            }
        }

        .tableH_Lock {
            max-height: 472px;
            overflow: auto;
        }

        thead {
            position: sticky;
            top: 0;
            background: #1e1e1e;
            color: white;
            text-align: center;
        }

        th {
            width: calc(100%/3);
        }

            th:nth-child(1) {
                width: 80px !important;
            }

        td, th {
            padding: 6px;
            text-align: center;
        }

        tbody tr:nth-child(even) td .form-control {
            margin-bottom: 0px !important;
            background-color: transparent !important;
            text-align: center;
            border: 1px dashed white !important;
            color: white !important;
        }

        tbody tr:nth-child(odd) td .form-control {
            margin-bottom: 0px !important;
            background-color: transparent !important;
            text-align: center;
            border: 1px dashed aqua !important;
            color: aqua !important;
        }

        tbody tr:nth-child(even) td .form-control:focus {
            outline: none !important;
            border: 1px solid white !important;
            box-shadow: 0 0 0 black !important;
        }

        tbody tr:nth-child(odd) td .form-control:focus {
            outline: none !important;
            box-shadow: 0 0 0 black !important;
            border: 1px solid aqua !important;
        }

        .row {
            margin-top: 10px;
        }

        .inputWithFilterIcon {
            width: 80%;
            margin: auto;
        }

        .animate {
            animation: pishbini 1s infinite;
        }

        @@keyframes pishbini {
            100%,0%{
                box-shadow:0 0 0px aqua;
            }
            50%{
                box-shadow:0 0 25px aqua;
            }
        }
    </style>
    

