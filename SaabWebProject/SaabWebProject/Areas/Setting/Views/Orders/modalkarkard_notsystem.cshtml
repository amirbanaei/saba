        $(document).ready(function () {

            function formatThousandsInput1(el) {
                let v = el.value;
                if (!v) return;
                let op = "";
                if (v.startsWith(">=") || v.startsWith("<=")) { op = v.substring(0, 2); v = v.substring(2); }
                else if (v.startsWith(">") || v.startsWith("<") || v.startsWith("=")) { op = v.substring(0, 1); v = v.substring(1); }
                v = v.replace(/[^\d]/g, '');
                if (!v) { el.value = op; return; }
                v = parseInt(v, 10).toLocaleString('en-US');
                el.value = op + v;
            }

            $(document).on('input', '.dynamic-filter1', function () { formatThousandsInput1(this); });

            function parseNumberFilter1(expr, value) {
                if (!expr) return true;
                expr = expr.replace(/,/g, '').trim();
                let operator = null;
                if (expr.startsWith(">=")) operator = ">=";
                else if (expr.startsWith("<=")) operator = "<=";
                else if (expr.startsWith("!=")) operator = "!=";
                else if (expr.startsWith(">")) operator = ">";
                else if (expr.startsWith("<")) operator = "<";
                else if (expr.startsWith("=")) operator = "=";
                else operator = "=";

                let num = parseFloat(expr.replace(/^[<>!=]+/, ''));
                if (isNaN(num)) return true;

                value = (value || "0").toString().replace(/,/g, '');
                value = parseFloat(value) || 0;

                switch (operator) {
                    case ">=": return value >= num;
                    case "<=": return value <= num;
                    case ">": return value > num;
                    case "<": return value < num;
                    case "=": return value == num;
                    case "!=": return value != num;
                    default: return true;
                }
            }

            let filters = {};

            $('[data-filter1]').each(function () {
                filters[$(this).data('filter1')] = null;
            });

            $(document).on('input', '[data-filter1]', function () {
                let key = $(this).data('filter1');
                filters[key] = this.value;
                updateFilters1();
            });

            function updateFilters1() {
                $('.task-list-row1').each(function () {

                    let self = $(this);
                    let result = true;

                    Object.keys(filters).forEach(function (filter) {

                        let filterValue = filters[filter];
                        if (!filterValue) return;

                        let textValue = self.data(filter);

                        result = result && textValue &&
                            textValue.toString().toLowerCase()
                                .indexOf(filterValue.toLowerCase()) !== -1;
                    });

                    if (result) self.show();
                    else self.hide();
                });
            }
        });
