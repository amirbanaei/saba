                <input id="tatime" type="hidden" />
            </div>

            <div class="col-xl-1"></div>
            <div class="col-xl-1">
                <a href="#" class=" btn form-control buttonGeneral" id="dwn" onclick="DownloadExcel23() ">
                    <i class="bi bi-eye fa-fw me-1 VecGeneral"></i>
                    <span class="bGeneral-text">مشاهده</span>
