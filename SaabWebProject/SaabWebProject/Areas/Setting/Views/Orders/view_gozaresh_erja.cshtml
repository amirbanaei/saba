    <script src="@Url.Content("~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js")"></script>

    <script>
        jalaliDatepicker.startWatch({
            time: false,
            days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
            persianDigits: true,
            autoClose: true,
            autocomplete: true,
            showEmptyBtn: false,
            showCloseBtn: true,
            zIndex: 100000,
        });

        var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
        for (var i = 0; i < inputs.length; i++) {
            inputs[i].addEventListener("jdp:change", function (e) {
                var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                var date = this.value.replace(' ', '').slice(0, 10).split('/');
                date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]));
                if (!this.value) {
                    date = "";
                } else if (this.value.replace(' ', '').length < 11) {
                    date = date.gy + '-' + date.gm + '-' + date.gd;
                } else {
                    date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30);
                }
                miladiInput.value = date;
            });
        }
        var fd = new FormData();

    </script>
    <script>















$(document).ready(function() {
    // تمام کدهای شما که از $ استفاده می‌کنند اینجا قرار می‌گیرد
    $("#dwn").click(function () {
        var fromDate = $("#astime").val();
        var toDate   = $("#tatime").val();

        if (!fromDate || !toDate) {
            alert("لطفاً بازه تاریخ را انتخاب کنید");
            return;
        }

        window.location =
            '@Url.Action("SetDataExcel_Moalefe175411132", "Moalefe", new { area = "Salaries" })'
            + '?fromDate=' + fromDate
            + '&toDate=' + toDate;
    });


});






function UploadedFile(result) {
Toast.fire({
background: '#35434A',
color: 'white',
title: result
}).then(function () {
location.reload();
});
}
