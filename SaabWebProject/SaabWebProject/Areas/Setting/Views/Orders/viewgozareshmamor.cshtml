            <script>

                function sendAjax26799(url2, fd2) {
                    console.log($("#Month").val());
                    fd2.append("Year", $("#Year").val());
                    fd2.append("Month", $("#Month").val());
                    document.getElementById("loading-circle").style.display = "block";

                    $("#loading-circle .loadingText1").text("لطفا منتظر نمایش اطلاعات بمانید ...");
                    $("#loading-circle").css("display", "flex");
                    $.ajax({
                        url: url2,
                        type: 'POST',
                        data: fd2,
                        processData: false,
                        contentType: false,
                        success: function (resp1) {

                            // دریافتی از بک‌اند را در المان با کلاس myTable نمایش دهید

                            if (resp1 == "0") {

                                $("#loading-message").css("display", "none");
                                document.getElementById("loading-message").style.display = "none";
                                $("#loading-circle").css("display", "none");
                                alert("مجوز نمایش فیش صادر نشده است");
                                location.reload();

                            }
                            else if (resp1 == "-1") {


                                $("#loading-message").css("display", "none");
                                document.getElementById("loading-message").style.display = "none";
                                $("#loading-circle").css("display", "none");
                                alert("فیشی برای این کاربر در این ماه محاسبه نشده است");
                                location.reload();
                            }
                            else if (resp1 == "-2") {

                                $("#loading-message").css("display", "none");
                                document.getElementById("loading-message").style.display = "none";
                                $("#loading-circle").css("display", "none");
                                alert("در نمایش فیش خطایی رخ داده است");
                                location.reload();
                            }
                            else {
                                $("#loading-message").css("display", "none");
                                fd = new FormData();
                                document.getElementById("loading-message").style.display = "none";
                                $("#loading-circle").css("display", "none");
                                // $(".mytableSR").html(resp1);
                                $("#big_modal_body").html(resp1)
                                // $("#modalLg").modal('show')
                            }

                        },
                        error: function (resp1) {
                            console.log(resp1);
                            console.log("Nokeye");
                            $("#loading-message").css("display", "none");
                            Toast.fire({
                                icon: 'success',
                                background: '#35434A',
                                color: 'white',
                                title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
                            }).then(() => {
                                $("#loading-message").css("display", "none");
                            });
                        }
                    });
                }

            </script>
            <script>
    var fd = new FormData();
        //----------------------------------------------------------------
    $("#btnShowSR").click(function () {
        console.log($("#Month").val());


             if ($("#Month").val() == 0) {
                alert("لطفا ماه را انتخاب کنید");
            }
            else if ($("#Year").val() == 0) {
                alert("لطفا سال را انتخاب کنید");
            }

           else {
                sendAjax26799('@Url.Action("ShowFishmamor", "Formula", new { area = "Salaries" })', fd);
           };
     });
            </script>

            <script>
                jalaliDatepicker.startWatch({
                    time: false,
                    days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
                    persianDigits: true,
                    autoClose: true,
                    autocomplete: true,
                    showEmptyBtn: false,
                    showCloseBtn: true,
                    zIndex: 100000,
                });

                var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
                for (var i = 0; i < inputs.length; i++) {
                    inputs[i].addEventListener("jdp:change", function (e) {
                        var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                        var date = this.value.replace(' ', '').slice(0, 10).split('/');
                        date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]));
                        if (!this.value) {
                            date = "";
                        } else if (this.value.replace(' ', '').length < 11) {
                            date = date.gy + '-' + date.gm + '-' + date.gd;
                        } else {
                            date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30);
                        }
                        miladiInput.value = date;
                    });
                }

            </script>
