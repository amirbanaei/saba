<script>
    var fd = new FormData();

    $("#file-doreh").change(function (e) {
        $.each(e.target.files, function (index, file) {
            fd.append("files", file);
        });
    });
</script>
<script>
       $("#Send").click(function () {
           if ($("#file-doreh")[0].files.length === 0) {
               alert("لطفاً یک فایل انتخاب کنید.");
               return; // از ارسال جلوگیری می‌کنیم
           }
           fd.append("select_peyman", $("#select_peyman").val());
           fd.append("description1", $("#description1").val());
           console.log(fd);
               sendAjax('@Url.Action("Save1", "Orders", new { area = "Setting" })', fd);




       });
</script>
<script>

    function sendAjax(url2, fd2) {
        $("#loading-message").css("display", "block");

        $.ajax({
            url: url2,
            type: 'POST',
            data: fd2,
            processData: false,
            contentType: false,
            success: function (resp1) {
                $("#loading-message").css("display", "none");
                if (resp1 == "True") {
                    alert("باموفقیت ثبت شد ");

                    location.reload();

                } else {
                    alert(resp1);
                    location.reload();

                }
            },
            error: function (resp1) {
                alert(resp1);
                location.reload();

             
            }


        });
    }
</script>



<script>
    $(document).ready(function () {
