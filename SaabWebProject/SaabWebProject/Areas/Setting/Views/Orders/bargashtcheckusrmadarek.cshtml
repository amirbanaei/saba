    $(document).on("change", "input[name='vaziat']", function () {
        const value = $(this).val();
        $(".accept, .reject, .edit").hide(); // همه مخفی

        if (value === "0") $(".accept").show();
        if (value === "1") $(".reject").show();
        if (value === "2") $(".edit").show();
    });

</script>
