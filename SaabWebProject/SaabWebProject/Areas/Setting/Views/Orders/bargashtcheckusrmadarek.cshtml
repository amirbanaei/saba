<script>
         function DownloadExcel23(id) {
    document.getElementById("loading-circle").style.display = "block";

    $("#loading-circle .loadingText1").text("لطفا منتظر نمایش اطلاعات بمانید ...");
    $("#loading-circle").css("display", "flex");
    $("#myModal3").addClass("fade-in").css("display", "block");

    $("#ss2").load(
        '@Url.Content("/Setting/Orders/modalCheckMadrak")?id=' + id,
        function () {
            document.getElementById("loading-message").style.display = "none";
            $("#loading-circle").css("display", "none");
            $("#typegozarwsh11").picker({ search: true });
        }
    );
}


    $(document).ready(function () {
        $("#expandButton2").click(function () {
            $("#myModal3").addClass("fade-in"); // Add the fade-in class
            $("#myModal3").css("display", "block");
        });

        $(".close").click(function () {
            $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
            $("#myModal3").css("display", "none");
            $("#ss2").html(""); // پاک کردن محتوای قبلی

        });

        $(window).click(function (event) {
            if (event.target == $("#myModal3")[0]) {
                $("#myModal3").removeClass("fade-in"); // Remove the fade-in class
                $("#myModal3").css("display", "none");
            }
        });
    });

        var
            filters = {
                filter01: null,
                filter02: null,
                filter03: null,
                filter04: null,
                filter05: null,
            };

        function updateFilters() {
            $('.task-list-row').hide().filter(function () {
                var self = $(this),
                    result = true;

                Object.keys(filters).forEach(function (filter) {
                    var filterData = self.data(filter);
                    if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                        // تبدیل داده به رشته و بررسی مقدار
                        result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                    }
                });

                return result;
            }).show();
        }

        function changeFilter(filterName) {
            filters[filterName] = this.value;
            updateFilters();
        }

        // Assigned User Dropdown Filter
        $('#filter01-filter').on('input', function () {
            changeFilter.call(this, 'filter01');
        });
        $('#filter02-filter').on('input', function () {
            changeFilter.call(this, 'filter02');
        });
        $('#filter03-filter').on('input', function () {
            changeFilter.call(this, 'filter03');
        });
        $('#filter04-filter').on('input', function () {
            changeFilter.call(this, 'filter04');
        });
        $('#filter05-filter').on('input', function () {
            changeFilter.call(this, 'filter05');
        });
</script>


<script>
    function openModalCheckMadrak() {
        var modal = document.getElementById("modalCheckMadrak");
        modal.style.display = "block";
        modal.classList.add("fade-in");
    }

    function closeModalCheckMadrak() {
        document.getElementById("modalCheckMadrak").style.display = "none";
    }

    window.onclick = function (event) {
        var modal = document.getElementById("modalCheckMadrak");
        if (event.target === modal) {
            modal.style.display = "none";
        }
    }
    $(document).on("click", ".edit", function () {
        var id = $(this).attr("id").split("_")[1];
        DownloadExcel23(id);
    });

