    $(document).ready(function () {
        const container = document.getElementById("reportsContainer");
        const buttonWrapper = document.getElementById("finalButtonWrapper");
        const checkbox = document.getElementById("reportTrigger");
        // برای دکمه ثبت کلاس یا آی‌دی بذار، من اینجا با کلاس انتخابش کردم:
        const btnSabt = document.querySelector(".buttonsabt2");
        const STEP_DELAY = 1500;

        // ۱. متغیر کنترلی (۱ یعنی انیمیشن اجرا بشه، ۰ یعنی دکمه ثبت نشون داده بشه)
let checkStatus = @vaziat;

        // ۲. تابع اصلی برای مدیریت نمایش
        function updateUI() {
            if (checkbox.checked) {
                // حالت نمایش گزارش‌ها
                btnSabt.parentElement.style.display = "none"; // دکمه ثبت مخفی
                runReportAnimation();
            } else {
                // حالت نمایش دکمه ثبت
                btnSabt.parentElement.style.display = "block"; // دکمه ثبت ظاهر
                container.innerHTML = ""; // لیست گزارش‌ها پاک بشه
                buttonWrapper.classList.remove("show");
            }
        }

        // ۳. تابع اجرای انیمیشن
        function runReportAnimation() {
            container.innerHTML = "";
            buttonWrapper.classList.remove("show");

            reports.forEach((report, index) => {
                let iconClass = report.value === 1 ? "bi bi-check-circle" : (report.value === 2 ? "bi bi-x-circle" : "bi bi-clock");
                let iconColor = report.value === 1 ? "lawngreen" : (report.value === 2 ? "red" : "orange");

                const rowHtml = `
                <div class="row align-items-center" id="row-${index}">
                    <div class="loader">
                        <div class="inner one"></div>
                        <div class="inner two"></div>
                        <div class="inner three"></div>
                    </div>
                    <div class="content">
                        <div class="col-xl-1">
                            <i class="${iconClass}" style="color:${iconColor}"></i>
                        </div>
                        <div class="col-xl-3">
                            <p>${report.name}</p>
                        </div>
                    </div>
                </div>`;

                container.insertAdjacentHTML('beforeend', rowHtml);

                setTimeout(() => {
                    const currentRow = document.getElementById(`row-${index}`);
                    if (currentRow && checkbox.checked) {
                        currentRow.classList.add("show");

                        if (index === reports.length - 1 && reports.every(r => r.value === 1)) {
                            buttonWrapper.classList.add("show");
                        }
                    }
                }, STEP_DELAY * (index + 1));
            });
        }

        // ۴. تنظیم وضعیت اولیه بر اساس متغیر checkStatus
        checkbox.checked = (checkStatus === 1);
        updateUI();

        // ۵. گوش دادن به تغییرات دستی (اگر disabled نباشد)
        checkbox.addEventListener('change', updateUI);
    });
</script>
