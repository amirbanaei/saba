                    <div class="custom-table-rows-parts">درصد تلفات :</div>
                    <div class="custom-table-rows-parts">@cod1_intcod4_int100</div>
                </div>-->
                        @*<div class="custom-table-rows">
                        <div class="custom-table-rows-parts">انرژی تحویلی :</div>
                        <div class="custom-table-rows-parts">@Model.dashbord_talafat.FirstOrDefault();</div>
                    </div>*@
                        @*<div class="custom-table-rows">
