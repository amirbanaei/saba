    <script>
    var categories2 = @Html.Raw(Json.Encode(ViewBag.Categories2 ?? new List<string>()));
    var rawSeries = @Html.Raw(Json.Encode(ViewBag.Series2 ?? new List<object>()));

    if (rawSeries.length >= 3) {

        // ۱. ترکیب داده‌ها برای مرتب‌سازی همزمان
        var combinedData = categories2.map((cat, index) => {
            return {
                category: cat,
                val1403: rawSeries[0].data[index],
                val1404: rawSeries[1].data[index],
                weight: rawSeries[2].data[index]
            };
        });

        // ۲. سورت نزولی بر اساس وزن
        combinedData.sort((a, b) => b.weight - a.weight);

        // ۳. بازگرداندن داده‌ها به آرایه‌های اصلی
        categories2 = combinedData.map(item => item.category);
        rawSeries[0].data = combinedData.map(item => item.val1403);
        rawSeries[1].data = combinedData.map(item => item.val1404);
        rawSeries[2].data = combinedData.map(item => item.weight);

        // محاسبه سقف محور وزن (کمی بالاتر از بیشترین مقدار)
        var maxWeight = Math.max(...rawSeries[2].data) * 1.1;

        var options = {
            chart: {
                height: 300,
                width: '100%',
                type: 'line',
                toolbar: { show: false },
                fontFamily: 'inherit',
                zoom: { enabled: false }
            },
            plotOptions: {
                bar: { borderRadius: 4, borderRadiusApplication: 'end', borderRadiusWhenStacked: 'last', columnWidth: '80%' }
            },
            colors: ['#006f81', '#008541', '#b14900'],
            stroke: { width: [0, 0, 0], curve: 'smooth' },
            markers: { size: [0, 0, 6], strokeWidth: 2, hover: { size: 8 } },
            dataLabels: { enabled: false },
            xaxis: {
                categories: categories2,
                labels: { rotate: 45, rotateAlways: true, style: { colors: '#fff' } },
                axisTicks: { show: false }
            },
            yaxis: [
                {
                    seriesName: [rawSeries[0].name, rawSeries[1].name],
                    min: 0,
                    max: function(max) { return Math.ceil(max / 50) * 50; },
                    forceNiceScale: true,
                    labels: { offsetX: -10, style: { colors: '#fff' }, formatter: val => val.toFixed(1) + " %" },
                    title: { text: "درصد تلفات", style: { color: '#fff' } }
                },
                {
                    seriesName: rawSeries[2].name,
                    opposite: true,
                    min: 0,
                    max: maxWeight,
                    tickAmount: 4,
                    forceNiceScale: true,
                    labels: { offsetX: -20, style: { colors: '#fff' }, formatter: val => Math.round(val).toLocaleString() },
                    title: { text: "وزن تلفات", style: { color: '#fff' } }
                }
            ],
            series: [
                { name: rawSeries[0].name, type: "column", data: rawSeries[0].data, yAxisIndex: 0 },
                { name: rawSeries[1].name, type: "column", data: rawSeries[1].data, yAxisIndex: 0 },
                { name: rawSeries[2].name, type: "line", data: rawSeries[2].data, yAxisIndex: 1 }
            ],
            tooltip: {
                theme: 'dark',
                shared: true,
                intersect: false,
                y: {
                    formatter: function(val, { seriesIndex }) {
                        return (seriesIndex < 2) ? val.toFixed(2) + " %" : val.toLocaleString();
                    }
                }
            },
            legend: { labels: { colors: '#fff' } },
            grid: { borderColor: '#1b7a7a66', strokeDashArray: 2 }
        };

        var chart = new ApexCharts(document.querySelector("#chart2"), options);
        chart.render();
    }
    </script>   
