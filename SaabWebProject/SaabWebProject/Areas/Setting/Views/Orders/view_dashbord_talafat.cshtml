                            var cod13_int = Model.dashbord_talafat.Where(s => s.code == 13 && s.city == Model.unicc).OrderByDescending(s => s.ID).Select(t => t.avrage).FirstOrDefault();
                            var cod10_int = Model.dashbord_talafat.Where(s => s.code == 10 && s.city == Model.unicc).OrderByDescending(s => s.ID).Select(t => t.avrage).FirstOrDefault();
                            var cod14_int = Model.dashbord_talafat.Where(s => s.code == 14 && s.city == Model.unicc).OrderByDescending(s => s.ID).Select(t => t.avrage).FirstOrDefault();
                            var cod11_int = Model.dashbord_talafat.Where(s => s.code == 11 && s.city == Model.unicc).OrderByDescending(s => s.ID).Select(t => t.avrage).FirstOrDefault();
                            var cod15_int = Model.dashbord_talafat.Where(s => s.code == 15 && s.city == Model.unicc).OrderByDescending(s => s.ID).Select(t => t.avrage).FirstOrDefault();
                            var cod12_int = Model.dashbord_talafat.Where(s => s.code == 12 && s.city == Model.unicc).OrderByDescending(s => s.ID).Select(t => t.avrage).FirstOrDefault();
                            var cod16_int = Model.dashbord_talafat.Where(s => s.code == 16 && s.city == Model.unicc).OrderByDescending(s => s.ID).Select(t => t.avrage).FirstOrDefault();
                        }   <div class="custom-table-part1">
                            <div class="custom-table-rows2">
                                <div class="custom-table-rows-parts">درصد تلفات :</div>
                                <div class="custom-table-rows-parts">@(cod1_intcod4_int100?.ToString("0.0"))%</div>
                            </div>
                            <div class="custom-table-rows2">
                                <div class="custom-table-rows-parts">رتبه در تلفات :</div>
                                <div class="custom-table-rows-parts">@Model.dashbord_talafat.Where(s => s.code == 25 && s.city == Model.unicc).OrderByDescending(s => s.ID).Select(s => s.avrage).FirstOrDefault()</div>
                            </div>




                        </div>
                        <!--<div class="custom-table-part2">
                <div class="custom-table-rows">
                    <div class="custom-table-rows-parts">رتبه در تلفات :</div>
                    <div class="custom-table-rows-parts">@Model.dashbord_talafat.Where(s => s.code == 25 && s.city == Model.unicc).OrderByDescending(s => s.ID).Select(s => s.avrage).FirstOrDefault()</div>
                </div>
