
@using SaabWebProject.Models.DomainModels;

@{ SaabEntities db = new SaabEntities();

    ViewBag.Title = "تعریف شاخه و زیر شاخه";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>view_type_shaghs</title>
    <style>
        .tab-content {
            display: flex;
            flex-direction: row;
            gap: 1rem;
        }

        .part {
            padding:1rem;
            width: 50%;
            height: 35rem;
            border: .1rem solid aqua;
            border-radius: .5rem;
        }
    </style>
</head>
<body>
    <div class="tab-content">
        <div class="part" id="TarifShakhe">
            <div class="row">
                <div class="col-xl-6 ">
                    <label class="form-label" for="titleInput1">عنوان شاخه</label>
                    <input id="titleInput1" class="form-control" type="text" />
                </div>
                <div class="col-xl-1 col-2">
                    <button type="button" class="btn form-control buttonGeneral" id="Send1">
                        <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                        <span class="bGeneral-text">ثبت</span>
                    </button>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-xl-11 col-10"></div>

            </div>
            <div id="ListUsers">
                @Html.Action("view_shaghslist", "Orders", new { area = "Setting" })
            </div>
        </div>
        <div class="part" id="TariZirshakhe">
            @* ۱. توکن امنیتی اجباری *@
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-xl-4 ">
                    <label class="form-label" for="titleInput2">عنوان فرم</label>
                    <input id="titleInput2" class="form-control" type="text" />
                </div>
                <div class="col-xl-4">
                    <label class="form-label">نوع شاخه</label>

                    <select id="year_Eq11" name="year_Eq11" class="form-select">
                        <option value="0">انتخاب کنید</option>

                        @{


                            foreach (var it in db.otamasoin1_createshagheh.ToList())
                            {

                                <option value="@it.ID">@it.name</option>
                            }
                        }
                    </select>

                </div>
                <div class="col-xl-1 col-2">
                    <button type="button" class="btn form-control buttonGeneral" id="Send2">
                        <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                        <span class="bGeneral-text">ثبت</span>
                    </button>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-xl-11 col-10"></div>

            </div>
            <div id="ListUsers">
                @Html.Action("view_typelist", "Orders", new { area = "Setting" })
            </div>
        </div>
    </div>
    @*اسکریپت های تعریف شاخه*@
    <script>
     $(document).ready(function () {
         $("#Send1").on("click", function (e) {
             e.preventDefault();

             var titleVal = $("#titleInput1").val().trim();

             if (titleVal === "") {
                 alert("لطفاً ابتدا عنوان شاخه را وارد نمایید.");
                 return;
             }

             var $btn = $(this);
             $btn.prop("disabled", true);

             // استخراج توکن ضد جعل
             var token = $('input[name="__RequestVerificationToken"]').val();

             $.ajax({
                 // دقت کنید که آدرس با اسلش شروع شود یا از Url.Action استفاده شود
                 url: '@Url.Action("AddShagheh", "Orders", new { area = "Setting" })',
                 type: 'POST',
                 data: {
                     __RequestVerificationToken: token, // ارسال توکن
                     title: titleVal
                 },
                 success: function (response) {
                     if (response.success) {
                         alert(response.message);
                         $("#titleInput1").val("");
                     } else {
                         alert("خطا در ثبت: " + response.message);
                     }
                 },
                 error: function (xhr) {
                     console.error(xhr.responseText);
                     alert("خطا در برقراری ارتباط با سرور. وضعیت: " + xhr.status);
                 },
                 complete: function () {
                     $btn.prop("disabled", false);
                 }
             });
         });
     });
    </script>
    @*اسکریپت های تعریف زیر شاخه*@
    <script>
 $(document).ready(function () {
     $("#Send2").on("click", function (e) {
         e.preventDefault();

         var titleVal = $("#titleInput2").val().trim();
         var shaghehId = $("#year_Eq11").val(); // گرفتن مقدار سلکت باکس

         // اعتبارسنجی
         if (titleVal === "") {
             alert("لطفاً عنوان را وارد کنید.");
             return;
         }
         if (shaghehId == "0") {
             alert("لطفاً نوع شاخه را انتخاب کنید.");
             return;
         }

         var $btn = $(this);
         $btn.prop("disabled", true);

         var token = $('input[name="__RequestVerificationToken"]').val();

         $.ajax({
             // آدرس اکشن جدید
             url: '@Url.Action("AddCretType", "Orders", new { area = "Setting" })',
             type: 'POST',
             data: {
                 __RequestVerificationToken: token,
                 name: titleVal,
                 fkShagheh: shaghehId
             },
             success: function (response) {
                 if (response.success) {
                     alert(response.message);
                     $("#titleInput2").val("");
                     $("#year_Eq11").val("0"); // ریست کردن سلکت باکس
                 } else {
                     alert("خطا: " + response.message);
                 }
             },
             error: function (xhr) {
                 alert("خطا در برقراری ارتباط.");
             },
             complete: function () {
                 $btn.prop("disabled", false);
             }
         });
     });
 });
    </script>

</body>
</html>
