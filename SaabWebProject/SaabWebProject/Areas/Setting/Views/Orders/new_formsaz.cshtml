                    align-items: stretch;
                }


                    #FormContainer .row.image-row > .field-item {
                        height: 100%;
                    }


                    #FormContainer .row.image-row .image-upload-box {
                        width: 100%;
                        height: 100%;
                        min-height: 0;
                    }


                    #FormContainer .row.image-row .image-upload-placeholder {
                        width: 100%;
                        height: 100%;
                        min-height: 0;
                    }


                    #FormContainer .row.image-row .image-preview {
                        width: 100%;
                        height: 100%;
                    }
                /* =========================================================
                     CHECKBOX - LIQUID GLASS
                     ========================================================= */

                .form-check-input[type="checkbox"] {
                    appearance: none;
                    -webkit-appearance: none;
                    width: 1.5rem;
                    height: 1.5rem;
                    margin: 0 !important;
                    position: relative;
                    cursor: pointer;
                    border-radius: .45rem !important;
                    border: 1px solid rgba(255, 255, 255, .20) !important;
                    background: linear-gradient( 135deg, rgba(255, 255, 255, .08), rgba(255, 255, 255, .02) ) !important;
                    backdrop-filter: blur(10px) saturate(140%);
                    -webkit-backdrop-filter: blur(10px) saturate(140%);
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), inset 0 0 .5rem rgba(255,255,255,.025);
                    transition: .3s ease;
                }


                    /* Hover */

                    .form-check-input[type="checkbox"]:hover {
                        border-color: rgba(0, 255, 255, .55) !important;
                        background: linear-gradient( 135deg, rgba(0, 255, 255, .10), rgba(255, 255, 255, .025) ) !important;
                        box-shadow: inset 0 0 .5rem rgba(0,255,255,.06), 0 0 .5rem rgba(0,255,255,.04);
                    }


                    /* Checked */

                    .form-check-input[type="checkbox"]:checked {
                        border-color: rgba(0,255,255,.85) !important;
                        background: linear-gradient( 135deg, rgba(0,255,255,.22), rgba(0,255,255,.06) ) !important;
                        box-shadow: inset 0 0 .6rem rgba(0,255,255,.10), 0 0 .6rem rgba(0,255,255,.08);
                    }


                        /* تیک */

                        .form-check-input[type="checkbox"]:checked::after {
                            content: "";
                            position: absolute;
                            left: 50%;
                            top: 50%;
                            width: .4rem;
                            height: .75rem;
                            border: solid aqua;
                            border-width: 0 2px 2px 0;
                            transform: translate(-50%, -58%) rotate(45deg);
                            filter: drop-shadow(0 0 .3rem aqua);
                        }


                    /* Focus */

                    .form-check-input[type="checkbox"]:focus {
                        box-shadow: 0 0 0 .2rem rgba(0,255,255,.10), inset 0 0 .5rem rgba(0,255,255,.08) !important;
                        outline: none !important;
                    }


                    /* Active */

                    .form-check-input[type="checkbox"]:active {
                        transform: scale(.9);
                    }

                /* =========================================================
                     RADIO - LIQUID GLASS
                     ========================================================= */

                [data-bs-theme="dark"] .form-check-input[type="radio"] {
                    appearance: none;
                    -webkit-appearance: none;
                    width: 1.5rem;
                    height: 1.5rem;
                    margin: 0 !important;
                    position: relative;
                    cursor: pointer;
                    border-radius: 50% !important;
                    border: 1px solid rgba(255, 255, 255, .20) !important;
                    background: linear-gradient( 135deg, rgba(255, 255, 255, .08), rgba(255, 255, 255, .02) ) !important;
                    backdrop-filter: blur(10px) saturate(140%);
                    -webkit-backdrop-filter: blur(10px) saturate(140%);
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), inset 0 0 .5rem rgba(255,255,255,.025);
                    transition: border-color .3s ease, background .3s ease, box-shadow .3s ease, transform .2s ease;
                }


                    /* =========================================================
                     HOVER
                     ========================================================= */

                    [data-bs-theme="dark"] .form-check-input[type="radio"]:hover {
                        border-color: rgba(0,255,255,.55) !important;
                        background: linear-gradient( 135deg, rgba(0,255,255,.10), rgba(255,255,255,.025) ) !important;
                        box-shadow: inset 0 0 .5rem rgba(0,255,255,.06), 0 0 .5rem rgba(0,255,255,.04);
                    }


                /* =========================================================
                     CHECKED
                     ========================================================= */

                [data-bs-theme="dark"] .form-check-input:checked[type="radio"] {
                    border-color: rgba(0,255,255,.85) !important;
                    background: linear-gradient( 135deg, rgba(0,255,255,.16), rgba(0,255,255,.045) ) !important;
                    box-shadow: inset 0 0 .7rem rgba(0,255,255,.10), 0 0 .7rem rgba(0,255,255,.08);
                }


                    /* =========================================================
                     INNER DOT
                     ========================================================= */

                    [data-bs-theme="dark"] .form-check-input:checked[type="radio"]::after {
                        content: "";
                        position: absolute;
                        top: 50%;
                        left: 50%;
                        width: .65rem;
                        height: .65rem;
                        border-radius: 50%;
                        background: aqua;
                        transform: translate(-50%, -50%) scale(1);
                        box-shadow: 0 0 .45rem aqua, 0 0 .8rem rgba(0,255,255,.55);
                        animation: radioGlassPulse .3s ease;
                    }


                /* =========================================================
                     FOCUS
                     ========================================================= */

                [data-bs-theme="dark"] .form-check-input[type="radio"]:focus {
                    outline: none !important;
                    box-shadow: 0 0 0 .2rem rgba(0,255,255,.10), inset 0 0 .5rem rgba(0,255,255,.08) !important;
                }


                /* =========================================================
                     ACTIVE
                     ========================================================= */

                [data-bs-theme="dark"] .form-check-input[type="radio"]:active {
                    transform: scale(.9);
                }


                /* =========================================================
                     DISABLED
                     ========================================================= */

                [data-bs-theme="dark"] .form-check-input[type="radio"]:disabled {
                    opacity: .4;
                    cursor: not-allowed;
                    box-shadow: none;
                }


                /* =========================================================
                     ANIMATION
                     ========================================================= */

                @@keyframes radioGlassPulse {

                    0% {
                        transform: translate(-50%, -50%) scale(.3);
                        opacity: .3;
                    }

                    100% {
                        transform: translate(-50%, -50%) scale(1);
                        opacity: 1;
                    }
                }

                /* =========================================================
                     SELECT - LIQUID GLASS
                     ========================================================= */

                [data-bs-theme="dark"] .form-select {
                    width: 100%;
                    color: rgba(255,255,255,.92) !important;
                    border: 1px solid rgba(255,255,255,.14) !important;
                    border-radius: .55rem !important;
                    background-color: rgba(255,255,255,.035) !important;
                    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%2300ffff' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important;
                    background-repeat: no-repeat !important;
                    background-position: left .75rem center !important;
                    background-size: 1rem .75rem !important;
                    backdrop-filter: blur(12px) saturate(150%);
                    -webkit-backdrop-filter: blur(12px) saturate(150%);
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.10), inset 0 -1px 0 rgba(255,255,255,.02);
                    transition: border-color .3s ease, background-color .3s ease, box-shadow .3s ease, transform .2s ease;
                }


                    /* =========================================================
                     HOVER
                     ========================================================= */

                    [data-bs-theme="dark"] .form-select:hover {
                        border-color: rgba(0,255,255,.40) !important;
                        background-color: rgba(0,255,255,.055) !important;
                        box-shadow: inset 0 0 .6rem rgba(0,255,255,.05), 0 0 .5rem rgba(0,255,255,.03);
                    }


                    /* =========================================================
                     FOCUS
                     ========================================================= */

                    [data-bs-theme="dark"] .form-select:focus {
                        color: white !important;
                        border-color: rgba(0,255,255,.70) !important;
                        background-color: rgba(0,255,255,.065) !important;
                        outline: none !important;
                        box-shadow: 0 0 0 .2rem rgba(0,255,255,.08), inset 0 0 .7rem rgba(0,255,255,.06) !important;
                    }


                    /* =========================================================
                     OPTIONS
                     ========================================================= */

                    [data-bs-theme="dark"] .form-select option {
                        color: white;
                        background-color: #172125;
                    }


                    /* =========================================================
                     DISABLED
                     ========================================================= */

                    [data-bs-theme="dark"] .form-select:disabled {
                        opacity: .45;
                        cursor: not-allowed;
                        background-color: rgba(255,255,255,.02) !important;
                        border-color: rgba(255,255,255,.08) !important;
                    }

                /* =========================================
