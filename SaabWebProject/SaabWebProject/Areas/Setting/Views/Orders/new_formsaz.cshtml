        function loadSelectOptions(field) {

            const select = field.querySelector("select");
            const container =
                document.getElementById("selectOptionsContainer");

            if (!select || !container) {
                return;
            }

            container.innerHTML = "";

            Array.from(select.options).forEach(function (option) {

                // گزینه پیش‌فرض را وارد تنظیمات نکن
                if (option.value === "" || option.textContent === "انتخاب کنید..") {
                    return;
