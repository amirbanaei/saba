        function updateRequiredMark(field, required) {

            const label = field.querySelector("label");

            if (!label) {
                return;
            }

            let requiredMark =
                label.querySelector(".required-mark");

            if (required) {

                if (!requiredMark) {

                    requiredMark =
                        document.createElement("span");

                    requiredMark.className = "required-mark";
                    requiredMark.innerText = "*";

                    label.appendChild(requiredMark);
                }

            } else {

                if (requiredMark) {
                    requiredMark.remove();
                }

            }
        }

        function showFieldSettings(field) {

            selectedField = field;

            const type = field.dataset.fieldType;

            if (type === "file") {
                showAttachmentSettings(field);
                return;
            }

            if (type === "image") {
                showImageSettings(field);
                return;
            }
            const toolInfo = getFieldToolInfo(type);
            const label = field.querySelector("label");
            const input = field.querySelector("input");
            let currentMaxLength = "";

            if (type === "text") {

                currentMaxLength =
                    selectedField.dataset.maxLength || "";

            }
            const colClass = Array.from(field.classList)
                .find(c => c.startsWith("col-xl-"));

            const currentCol = colClass
                ? colClass.replace("col-xl-", "")
                : "4";

            const currentLabel = label
                ? label.innerText
                : "";

            const currentId = input
                ? input.id
                : "";

            const isRequired = input
                ? input.required
                : false;

            function initImagePart(field) {

                const imagePart =
                    field.querySelector(".image-part");

                if (!imagePart) {
                    return;
                }


                const fileInput =
                    imagePart.querySelector(".image-part-input");

                if (!fileInput) {
                    return;
                }


                // جلوگیری از ثبت چندباره Event
                if (field.dataset.imageInitialized === "true") {
                    return;
                }

                field.dataset.imageInitialized = "true";


                // =====================================================
                // کلیک روی باکس
                // =====================================================

                imagePart.addEventListener("click", function (e) {

                    if (
                        e.target.closest(".image-part-input")
                    ) {
                        return;
                    }


                    if (
                        imagePart.querySelector(
                            ".image-part-preview"
                        )
                    ) {
                        return;
                    }


                    fileInput.click();

                });


                // =====================================================
                // انتخاب تصویر
                // =====================================================

                fileInput.addEventListener(
                    "change",
                    function () {

                        const file =
                            this.files &&
                            this.files[0];


                        if (!file) {
                            return;
                        }


                        // ---------------------------------------------
                        // بررسی تصویر
                        // ---------------------------------------------

                        if (
                            !file.type.startsWith(
                                "image/"
                            )
                        ) {

                            alert(
                                "لطفاً یک فایل تصویری انتخاب کنید."
                            );

                            this.value = "";

                            return;
                        }


                        // ---------------------------------------------
                        // خواندن تصویر
                        // ---------------------------------------------

                        const reader =
                            new FileReader();


                        reader.onload =
                            function (e) {

                                const imageSrc =
                                    e.target.result;


                                // -----------------------------------------
                                // Group تصویر
                                // -----------------------------------------

                                const imageGroup =
                                    field.dataset.imageGroup;


                                if (!imageGroup) {

                                    showImagePart(
                                        field,
                                        imageSrc
                                    );

                                    return;
                                }


                                // -----------------------------------------
                                // پیدا کردن تمام قسمت‌های این تصویر
                                // -----------------------------------------

                                const imageParts =
                                    document.querySelectorAll(
                                        '[data-field-type="image-part"][data-image-group="' +
                                        imageGroup +
                                        '"]'
                                    );


                                // -----------------------------------------
                                // نمایش تصویر در تمام قسمت‌ها
                                // -----------------------------------------

                                imageParts.forEach(
                                    function (part) {

                                        showImagePart(
                                            part,
                                            imageSrc
                                        );

                                    }
                                );

                            };


                        reader.readAsDataURL(file);

                    }
                );
                imagePart.addEventListener(
                    "click",
                    function (e) {

                        const deleteButton =
                            e.target.closest(
                                ".image-part-delete"
                            );


                        if (!deleteButton) {
                            return;
                        }


                        e.preventDefault();
                        e.stopPropagation();


                        const imageGroup =
                            field.dataset.imageGroup;


                        if (!imageGroup) {
                            return;
                        }


                        if (
                            confirm(
                                "آیا از حذف این تصویر مطمئن هستید؟"
                            )
                        ) {

                            deleteImageGroup(
                                imageGroup
                            );

                        }

                    }
                );
            }
            function updateImagePartBorders(imageGroupId) {

                const fields =
                    Array.from(
                        document.querySelectorAll(
                            `[data-image-group="${imageGroupId}"]`
                        )
                    );


                if (!fields.length) {
                    return;
                }


                const rows =
                    fields.map(function (field) {

                        return parseInt(
                            field.dataset.imageRow
                        );

                    });


                const columns =
                    fields.map(function (field) {

                        return parseInt(
                            field.dataset.imageColumn
                        );

                    });


                const minRow =
                    Math.min(...rows);

                const maxRow =
                    Math.max(...rows);

                const minColumn =
                    Math.min(...columns);

                const maxColumn =
                    Math.max(...columns);


                fields.forEach(function (field) {

                    const imagePart =
                        field.querySelector(
                            ".image-part"
                        );


                    if (!imagePart) {
                        return;
                    }


                    const row =
                        parseInt(
                            field.dataset.imageRow
                        );


                    const column =
                        parseInt(
                            field.dataset.imageColumn
                        );


                    // =====================================================
                    // حذف Border قبلی
                    // =====================================================

                    imagePart.style.border =
                        "none";


                    // =====================================================
                    // Border بیرونی
                    // =====================================================

                    if (row === minRow) {

                        imagePart.style.borderTop =
                            ".1rem dashed aqua";

                    }


                    if (row === maxRow) {

                        imagePart.style.borderBottom =
                            ".1rem dashed aqua";

                    }


                    // RTL
                    if (column === minColumn) {

                        imagePart.style.borderRight =
                            ".1rem dashed aqua";

                    }


                    if (column === maxColumn) {

                        imagePart.style.borderLeft =
                            ".1rem dashed aqua";

                    }


                    // =====================================================
                    // Radius همیشه فعال باشد
                    // =====================================================

                    imagePart.style.borderTopLeftRadius =
                        "0";

                    imagePart.style.borderTopRightRadius =
                        "0";

                    imagePart.style.borderBottomLeftRadius =
                        "0";

                    imagePart.style.borderBottomRightRadius =
                        "0";


                    // =====================================================
                    // بالا راست
                    // =====================================================

                    if (
                        row === minRow &&
                        column === minColumn
                    ) {

                        imagePart.style.borderTopRightRadius =
                            ".8rem";

                    }


                    // =====================================================
                    // بالا چپ
                    // =====================================================

                    if (
                        row === minRow &&
                        column === maxColumn
                    ) {

                        imagePart.style.borderTopLeftRadius =
                            ".8rem";

                    }


                    // =====================================================
                    // پایین راست
                    // =====================================================

                    if (
                        row === maxRow &&
                        column === minColumn
                    ) {

                        imagePart.style.borderBottomRightRadius =
                            ".8rem";

                    }


                    // =====================================================
                    // پایین چپ
                    // =====================================================

                    if (
                        row === maxRow &&
                        column === maxColumn
                    ) {

                        imagePart.style.borderBottomLeftRadius =
                            ".8rem";

                    }

                });

            }
            function showImagePart(field, imageSrc) {

                const imagePart =
                    field.querySelector(".image-part");

                if (!imagePart) {
                    return;
                }


                const imageGroup =
                    field.dataset.imageGroup;

                if (!imageGroup) {
                    return;
                }


                // =====================================================
                // پیدا کردن تمام قسمت‌های این تصویر
                // =====================================================

                const groupFields =
                    document.querySelectorAll(
                        '[data-field-type="image-part"][data-image-group="' +
                        imageGroup +
                        '"]'
                    );


                let maxRow = 1;
                let maxColumn = 1;


                groupFields.forEach(function (item) {

                    const r =
                        parseInt(item.dataset.imageRow) || 1;

                    const c =
                        parseInt(item.dataset.imageColumn) || 1;


                    maxRow =
                        Math.max(maxRow, r);

                    maxColumn =
                        Math.max(maxColumn, c);

                });


                // =====================================================
                // موقعیت این قسمت
                // =====================================================

                const row =
                    parseInt(field.dataset.imageRow) || 1;

                const column =
                    parseInt(field.dataset.imageColumn) || 1;


                // =====================================================
                // اصلاح جهت ستون‌ها برای RTL
                // =====================================================

                const visualColumn =
                    maxColumn - column + 1;


                // =====================================================
                // ساخت تصویر
                // =====================================================

                imagePart.innerHTML = `

            <img
                src="${imageSrc}"
                class="image-part-preview"
                alt="تصویر"
            />

            <button
                type="button"
                class="image-part-delete"
                title="حذف تصویر">
                <i class="bi bi-trash"></i>
            </button>

`;


                const image =
                    imagePart.querySelector(
                        ".image-part-preview"
                    );


                if (!image) {
                    return;
                }


                // =====================================================
                // اندازه تصویر
                // =====================================================

                image.style.width =
                    (maxColumn * 100) + "%";

                image.style.height =
                    (maxRow * 100) + "%";


                // =====================================================
                // موقعیت تصویر
                // =====================================================

                const translateX =
                    -((visualColumn - 1) / maxColumn) * 100;

                const translateY =
                    -((row - 1) / maxRow) * 100;


                image.style.transform =
                    `translate(${translateX}%, ${translateY}%)`;


                image.style.position =
                    "absolute";

                image.style.left =
                    "0";

                image.style.top =
                    "0";

                image.style.maxWidth =
                    "none";

                image.style.maxHeight =
                    "none";

                image.style.objectFit =
                    "fill";


                imagePart.classList.add(
                    "has-image"
                );
                createImageGroupDeleteButton(
                    imageGroup
                );
                applyImageGroupRadius(imageGroup);
            }
            function createImageGroupDeleteButton(imageGroup) {

                const fields =
                    Array.from(
                        document.querySelectorAll(
                            '[data-field-type="image-part"][data-image-group="' +
                            imageGroup +
                            '"]'
                        )
                    );

                if (!fields.length) {
                    return;
                }


                // اگر قبلاً دکمه ساخته شده، دوباره نساز
                if (
                    document.querySelector(
                        '.image-group-delete[data-image-group="' +
                        imageGroup +
                        '"]'
                    )
                ) {
                    return;
                }


                // اولین قسمت تصویر
                const firstField =
                    fields[0];

                const imagePart =
                    firstField.querySelector(
                        ".image-part"
                    );

                if (!imagePart) {
                    return;
                }


                const deleteButton =
                    document.createElement("button");


                deleteButton.type =
                    "button";


                deleteButton.className =
                    "basic-btn basic-del";


                deleteButton.dataset.imageGroup =
                    imageGroup;


                deleteButton.title =
                    "حذف تصویر";


                deleteButton.innerHTML = `
                <i class="bi bi-trash"></i>
            `;


                imagePart.appendChild(
                    deleteButton
                );


                // =====================================================
                // کلیک حذف
                // =====================================================

                deleteButton.addEventListener(
                    "click",
                    function (e) {

                        e.preventDefault();

                        e.stopPropagation();


                        if (
                            !confirm(
                                "آیا از حذف این تصویر مطمئن هستید؟"
                            )
                        ) {
                            return;
                        }


                        deleteImageGroup(
                            imageGroup
                        );

                    }
                );

            }
            function deleteImageGroup(imageGroup) {

                if (!imageGroup) {
                    return;
                }


                const groupFields =
                    Array.from(
                        document.querySelectorAll(
                            `[data-field-type="image-part"][data-image-group="${imageGroup}"]`
                        )
                    );


                if (!groupFields.length) {
                    return;
                }


                groupFields.forEach(function (field, index) {

                    const imagePart =
                        field.querySelector(".image-part");


                    if (!imagePart) {
                        return;
                    }


                    // ---------------------------------------------
                    // پاک کردن فایل
                    // ---------------------------------------------

                    const fileInput =
                        field.querySelector(
                            ".image-part-input"
                        );


                    if (fileInput) {
                        fileInput.value = "";
                    }


                    // ---------------------------------------------
                    // پاک کردن تصویر
                    // ---------------------------------------------

                    imagePart.innerHTML = "";


                    imagePart.classList.remove(
                        "has-image"
                    );


                    imagePart.style.backgroundImage =
                        "none";


                    // ---------------------------------------------
                    // فقط اولین بخش Placeholder داشته باشد
                    // ---------------------------------------------

                    if (index === 0) {

                        imagePart.innerHTML = `

                        <div class="image-part-placeholder">

                            <i class="bi bi-cloud-arrow-up"></i>

                            <span>
                                انتخاب تصویر
                            </span>

                        </div>

                        <input
                            type="file"
                            class="image-part-input"
                            accept="image/*"
                            hidden />

                    `;

                    }

                });


                // ---------------------------------------------
                // Radius دوباره اعمال شود
                // ---------------------------------------------

                updateImagePartBorders(
                    imageGroup
                );


                // ---------------------------------------------
                // حذف دکمه حذف
                // ---------------------------------------------

                const deleteButton =
                    document.querySelector(
                        `.basic-btn.basic-del[data-image-group="${imageGroup}"]`
                    );


                if (deleteButton) {
                    deleteButton.remove();
                }

            }
            function applyImageGroupRadius(imageGroup) {

                const fields =
                    Array.from(
                        document.querySelectorAll(
                            '[data-field-type="image-part"][data-image-group="' +
                            imageGroup +
                            '"]'
                        )
                    );


                if (!fields.length) {
                    return;
                }


                // =====================================================
                // حذف Radius قبلی
                // =====================================================

                fields.forEach(function (field) {

                    const part =
                        field.querySelector(".image-part");

                    if (!part) {
                        return;
                    }

                    part.style.borderRadius = "0";

                });


                // =====================================================
                // پیدا کردن اولین و آخرین ردیف
                // =====================================================

                const rows =
                    fields.map(function (field) {

                        return parseInt(
                            field.dataset.imageRow
                        );

                    });


                const firstRow =
                    Math.min(...rows);

                const lastRow =
                    Math.max(...rows);


                // =====================================================
                // پیدا کردن اولین و آخرین ستون
                // =====================================================

                const columns =
                    fields.map(function (field) {

                        return parseInt(
                            field.dataset.imageColumn
                        );

                    });


                const firstColumn =
                    Math.min(...columns);

                const lastColumn =
                    Math.max(...columns);


                // =====================================================
                // اعمال Radius با توجه به RTL
                // =====================================================

                fields.forEach(function (field) {

                    const part =
                        field.querySelector(".image-part");

                    if (!part) {
                        return;
                    }


                    const row =
                        parseInt(
                            field.dataset.imageRow
                        );


                    const column =
                        parseInt(
                            field.dataset.imageColumn
                        );


                    // -------------------------------------------------
                    // بالا راست
                    // ستون اول در RTL
                    // -------------------------------------------------

                    if (
                        row === firstRow &&
                        column === firstColumn
                    ) {

                        part.style.borderTopRightRadius =
                            ".8rem";
                    }


                    // -------------------------------------------------
                    // بالا چپ
                    // ستون آخر در RTL
                    // -------------------------------------------------

                    if (
                        row === firstRow &&
                        column === lastColumn
                    ) {

                        part.style.borderTopLeftRadius =
                            ".8rem";
                    }


                    // -------------------------------------------------
                    // پایین راست
                    // ستون اول در RTL
                    // -------------------------------------------------

                    if (
                        row === lastRow &&
                        column === firstColumn
                    ) {

                        part.style.borderBottomRightRadius =
                            ".8rem";
                    }


                    // -------------------------------------------------
                    // پایین چپ
                    // ستون آخر در RTL
                    // -------------------------------------------------

                    if (
                        row === lastRow &&
                        column === lastColumn
                    ) {

                        part.style.borderBottomLeftRadius =
                            ".8rem";
                    }

                    const deleteButton =
                        document.querySelector(
                            '.image-group-delete[data-image-group="' +
                            imageGroup +
                            '"]'
                        );

                    if (deleteButton) {
                        deleteButton.remove();
                    }
                });

            }
