    <script>
        jalaliDatepicker.startWatch({
            time: false,
            days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
            persianDigits: true,
            autoClose: true,
            autocomplete: true,
            showEmptyBtn: false,
            showCloseBtn: true,
            zIndex: 100000,
        });

        var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
        for (var i = 0; i < inputs.length; i++) {
            inputs[i].addEventListener("jdp:change", function (e) {
                var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                var date = this.value.replace(' ', '').slice(0, 10).split('/');
                date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]));
                if (!this.value) {
                    date = "";
                } else if (this.value.replace(' ', '').length < 11) {
                    date = date.gy + '-' + date.gm + '-' + date.gd;
                } else {
                    date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30);
                }
                miladiInput.value = date;
            });
        }

    </script>

    <script>



        function getRowColumns(row) {

            let totalColumns = 0;

            row.querySelectorAll('[class*="col-xl-"]').forEach(function (col) {

                const classes = Array.from(col.classList);

                const xlClass = classes.find(c => c.startsWith("col-xl-"));

                if (xlClass) {
                    const value = parseInt(xlClass.replace("col-xl-", ""));

                    if (!isNaN(value)) {
                        totalColumns += value;
                    }
                }

            });

            return totalColumns;
        }

        const formRows = document.querySelectorAll("#FormContainer .row");

        function getNewItemColumns(type) {

            if (type === "text") {
                return 4;
            }

            if (type === "number") {
                return 4;
            }


            if (type === "image-part") {
                return 3;
            }


            if (type === "mobile") {
                return 4;
            }

            if (type === "landline") {
                return 4;
            }

            if (type === "table-insert") {
                return 12;
            }
            if (type === "table") {
                return 12;
            }

            if (type === "codemeli") {
                return 4;
            }

            if (type === "email") {
                return 4;
            }

            if (type === "select") {
                return 4;
            }

            if (type === "checkbox") {
                return 4;
            }

            if (type === "radio") {
                return 4;
            }

            if (type === "file") {
                return 12;
            }

            if (type === "textarea") {
                return 4;
            }

            if (type === "date") {
                return 4;
            }

            return 0;
        }
        // =========================
        // Tools Panel
        // =========================

        new Sortable(document.getElementById("ToolsList"), {

            group: {
                name: "form-builder",
                pull: "clone",
                put: false
            },

            sort: false,
            animation: 150,

            onStart: function () {

                formRows.forEach(function (row) {
                    row.classList.add("drag-active");
                });

            },

            onEnd: function () {

                formRows.forEach(function (row) {
                    row.classList.remove("drag-active");
                });

            }

        });



        // =========================
        // Form Rows
        // =========================

        formRows.forEach(function (row) {

            new Sortable(row, {

                group: {
                    name: "form-builder",
                    pull: false,
                    put: true
                },

                animation: 150,

                onAdd: function (evt) {

                    const item = evt.item;

                    // نوع ابزار
                    const type = item.dataset.type;

                    // ==========================================
                    // بررسی Row مخصوص تصویر
                    // ==========================================

                    // اگر این Row قبلاً به عنوان Row تصویر مشخص شده
                    if (row.classList.contains("image-row")) {

                        // فقط ابزار تصویر اجازه ورود دارد
                        if (type !== "image") {

                            alert("این ردیف مخصوص تصویر می‌باشد.");

                            item.remove();

                            return;
                        }

                        // اجازه اضافه شدن تصویر دوم را هم نمی‌دهیم
                        const existingImage = row.querySelector(
                            '[data-field-type="image"]'
                        );

                        if (existingImage) {

                            alert("این ردیف در حال حاضر دارای تصویر می‌باشد.");

                            item.remove();

                            return;
                        }
                    }

                    // ==========================================
                    // محدودیت عرض Row
                    // ==========================================

                    const currentColumns = getRowColumns(row);
                    const newColumns = getNewItemColumns(type);

                    if (currentColumns + newColumns > 12) {

                        alert("ردیف انتخابی پر است.");

                        item.remove();

                        return;
                    }

                    // ==========================================
                    // اگر ابزار تصویر است
                    // ==========================================

                    if (type === "image") {

                        // این Row را مخصوص تصویر می‌کنیم
                        row.classList.add("image-row");

                        // یک نشانه هم روی Row ذخیره می‌کنیم
                        row.dataset.imageOnly = "true";
                    }

                    if (currentColumns + newColumns > 12) {

                        alert("ردیف انتخابی پر است.");

                        item.remove();

                        return;
                    }
                    // =========================
                    // Text Box
                    // =========================

                    if (type === "text") {

                        item.outerHTML = `
                                                        <div class="col-xl-4 field-item" data-field-type="text">
                                                            <label class="form-label">تعریف نشده

                                                            </label>

                                                            <input class="form-control" id="" />
                                                        </div>
                                                    `;

                    }
                    // =========================
                    // number
                    // =========================
                    else if (type === "number") {

                        item.outerHTML = `
                                    <div class="col-xl-4 field-item"
                                         data-field-type="number"
                                         data-number-type="simple"
                                         data-thousand-separator="false"
                                         data-decimal-places="0">

                                        <label class="form-label">
                                            تعریف نشده
                                        </label>

                                        <input
                                            type="text"
                                            class="form-control number-only"
                                            id=""
                                            value=""
                                            style="margin-bottom:0px !important;" />

                                    </div>
                                `;
                    }

                    // =========================
                    // Image 2
                    // =========================
                    else if (type === "image-part") {

                        item.outerHTML = `
                                <div class="col-xl-4 field-item"
                                     data-field-type="image-part">

                                    <div class="image-part">

                                        <div class="image-part-placeholder">

                                            <i class="bi bi-cloud-arrow-up"></i>

                                            <span>
                                                انتخاب تصویر
                                            </span>

                                            <input type="file"
                                                   class="image-part-input"
                                                   accept="image/*"
                                                   hidden />

                                        </div>

                                    </div>

                                </div>
                            `;

                    }
                    // =========================
                    // Image Upload
                    // =========================

                    else if (type === "image") {

                        item.outerHTML = `
                                            <div class="col-xl-3 field-item"
                                                 data-field-type="image">

                                                <div class="image-upload-box">

                                                    <input type="file"
                                                           class="image-upload-input"
                                                           accept="image/*" />

                                                    <div class="image-upload-placeholder">

                                                        <div class="image-upload-icon">
                                                            <i class="bi bi-image"></i>
                                                        </div>

                                                        <div class="image-upload-text">

                                                            <div class="image-upload-title">
                                                                بارگذاری تصویر
                                                            </div>

                                                            <div class="image-upload-subtitle">
                                                                برای انتخاب تصویر کلیک کنید
                                                            </div>

                                                        </div>

                                                    </div>

                                                    <div class="image-preview">

                                                        <img src=""
                                                             alt="Preview" />

                                                        <button type="button"
                                                                class="basic-del image-remove-btn">

                                                            <i class="bi bi-trash"></i>

                                                        </button>

                                                    </div>

                                                </div>

                                            </div>
                                        `;

                    }

                    // =========================
                    // Table
                    // =========================

                    else if (type === "table") {

                        item.outerHTML = `
            <div class="col-xl-12 field-item"
                 data-field-type="table"
                 data-table-columns="3"
                 data-table-rows="3"
                 data-table-column-titles='["ستون ۱","ستون ۲","ستون ۳"]'
                 data-table-column-widths='["10","10","10"]'
                 data-table-row-titles='["ردیف ۱","ردیف ۲","ردیف ۳"]'>

                <label class="form-label">
                    تعریف نشده
                </label>

                <div class="table-field">

                    <table class="form-builder-table">

                        <thead>

                            <tr>

                                <!-- عنوان ردیف -->

                                <th
                                    class="table-row-header"
                                    data-column-index="row-title">
                                    عنوان
                                </th>

                                <!-- ستون ۱ -->

                                <th
                                    data-column-index="0"
                                    style="width: 10rem;">
                                    ستون ۱
                                </th>

                                <!-- ستون ۲ -->

                                <th
                                    data-column-index="1"
                                    style="width: 10rem;">
                                    ستون ۲
                                </th>

                                <!-- ستون ۳ -->

                                <th
                                    data-column-index="2"
                                    style="width: 10rem;">
                                    ستون ۳
                                </th>

                            </tr>

                        </thead>

                        <tbody>

        <!-- ردیف ۱ -->

        <tr>

            <th
                class="table-row-title-cell"
                data-row-index="0"
                data-column-index="row-title">
                ردیف ۱
            </th>

            <td
                class="table-value-cell"
                contenteditable="true"
                data-row-index="0"
                data-column-index="0">
            </td>

            <td
                class="table-value-cell"
                contenteditable="true"
                data-row-index="0"
                data-column-index="1">
            </td>

            <td
                class="table-value-cell"
                contenteditable="true"
                data-row-index="0"
                data-column-index="2">
            </td>

        </tr>


        <!-- ردیف ۲ -->

        <tr>

