
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "فرم ساز";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>FormSaz</title>
    <style>

                /* =========================================================
                          LIQUID GLASS - GLOBAL SYSTEM
                          ========================================================= */

                :root {
                    --glass-bg: rgba(255, 255, 255, 0.055);
                    --glass-bg-strong: rgba(255, 255, 255, 0.085);
                    --glass-bg-soft: rgba(0, 255, 255, 0.035);
                    --glass-border: rgba(255, 255, 255, 0.16);
                    --glass-border-bright: rgba(255, 255, 255, 0.28);
                    --glass-highlight: rgba(255, 255, 255, 0.18);
                    --glass-shadow: rgba(0, 0, 0, 0.28);
                    --aqua: #00ffff;
                    --aqua-soft: rgba(0, 255, 255, 0.12);
                    --aqua-faint: rgba(0, 255, 255, 0.055);
                    --danger: #ff4d6d;
                    --success: #32d583;
                    --glass-blur: 18px;
                    --glass-saturation: 150%;
                    --glass-radius: .75rem;
                    --glass-transition: .35s cubic-bezier(.22, .61, .36, 1);
                }


                /* =========================================================
                          RESET
                          ========================================================= */

                div {
                    padding: 0;
                    margin: 0;
                }

                hr {
                    margin: 0;
                }

                h4,
                h6,
                p,
                input[class="form-control"],
                input[type="checkbox"],
                input[type="radio"] {
                    margin: 0 !important;
                }


                /* =========================================================
                          BACKGROUND
                          ========================================================= */

                .tab-content {
                    position: relative;
                    background-image: url('/Areas/Setting/Images/AdminImages/geometric-abstract-3840x2160-23187.jpg') !important;
                    background-size: cover !important;
                    background-position: center;
                    background-attachment: fixed;
                }


                /* =========================================================
                     FORM LABEL - LIQUID GLASS
                     ========================================================= */

                .form-label {
                    display: block;
                    color: rgba(255,255,255,.88);
                    font-size: .7rem;
                    font-weight: 500;
                    border-radius: .45rem;
                    background-color: transparent;
                    margin-top: -1rem;
                    transition: .3s ease;
                }


                /* Hover Label */
                /*
                          #FormContainer .field-item:hover .form-label {
                              color: rgba(255,255,255,.98);
                              border-color: rgba(255,255,255,.14);
                              background: linear-gradient( 135deg, rgba(255,255,255,.075), rgba(255,255,255,.025) );
                          }*/


                /* =========================================================
                     FORM CONTROL - LIQUID GLASS
                     ========================================================= */
                input[class="form-control"],
                .form-control {
                    width: 100%;
                    color: rgba(255,255,255,.92) !important;
                    border: 1px solid rgba(255,255,255,.14) !important;
                    background-color: transparent !important;
                    border-radius: .55rem !important;
                    backdrop-filter: blur(12px) saturate(150%);
                    -webkit-backdrop-filter: blur(12px) saturate(150%);
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), inset 0 -1px 0 rgba(255,255,255,.025);
                    transition: border-color .3s ease, background .3s ease, box-shadow .3s ease, transform .3s ease;
                }


                    /* =========================================================
                     INPUT HOVER
                     ========================================================= */




                    /* =========================================================
                     INPUT FOCUS
                     ========================================================= */
                    input[class="form-control"]:focus,
                    .form-control:focus {
                        outline: none !important;
                        color: white !important;
                        background: linear-gradient( 135deg, rgba(0,255,255,.09), rgba(255,255,255,.035) ) !important;
                        border-color: rgba(0,255,255,.65) !important;
                        box-shadow: inset 0 0 .7rem rgba(0,255,255,.06), 0 0 .8rem rgba(0,255,255,.08) !important;
                        transform: translateY(-1px);
                    }


                    /* =========================================================
                     PLACEHOLDER
                     ========================================================= */

                    .form-control::placeholder {
                        color: rgba(255,255,255,.38) !important;
                    }


                    /* =========================================================
                     DISABLED
                     ========================================================= */

                    .form-control:disabled {
                        opacity: .5;
                        cursor: not-allowed;
                        background: rgba(255,255,255,.025) !important;
                        border-color: transparent !important;
                    }

                /* =========================================================
                          BOOTSTRAP COLUMNS
                          ========================================================= */

                .col-xl-1,
                .col-xl-2,
                .col-xl-3,
                .col-xl-4,
                .col-xl-5,
                .col-xl-6,
                .col-xl-7,
                .col-xl-8,
                .col-xl-9,
                .col-xl-10,
                .col-xl-11,
                .col-xl-12 {
                    position: relative !important;
                }


                /* =========================================================
                          MAIN CONTAINER
                          ========================================================= */

                #ContainerFormSaz {
                    display: flex;
                    flex-direction: row;
                    gap: .75rem;
                }


                /* =========================================================
                          LIQUID GLASS PANELS
                          ========================================================= */

                .KF {
                    position: relative;
                    height: 40rem;
                    border: 1px solid var(--glass-border) !important;
                    border-radius: var(--glass-radius);
                    overflow: hidden;
                    background: linear-gradient( 135deg, rgba(255,255,255,.085), rgba(255,255,255,.025) );
                    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
                    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.20), inset 0 -1px 0 rgba(255,255,255,.035), 0 12px 40px rgba(0,0,0,.22);
                    isolation: isolate;
                }


                    /* Liquid reflection */

                    .KF::before {
                        content: "";
                        position: absolute;
                        inset: 0;
                        pointer-events: none;
                        background: linear-gradient( 125deg, rgba(255,255,255,.14) 0%, rgba(255,255,255,.035) 18%, transparent 40%, transparent 70%, rgba(255,255,255,.045) 100% );
                        opacity: .8;
                        z-index: -1;
                    }


                    /* subtle glass glow */

                    .KF::after {
                        content: "";
                        position: absolute;
                        width: 18rem;
                        height: 18rem;
                        top: -10rem;
                        right: -8rem;
                        background: rgba(0,255,255,.06);
                        filter: blur(70px);
                        border-radius: 50%;
                        pointer-events: none;
                        z-index: -1;
                    }


                /* =========================================================
                          TOP BUTTON AREA
                          ========================================================= */

                #Btns-Top {
                    /*                 display: none;*/
                    height: fit-content;
                    margin: .5rem auto;
                    border-radius: 1vh;
                }


                /* =========================================================
                          PANEL WIDTHS
                          ========================================================= */

                #ToolsPanel {
                    width: 25%;
                }

                #form {
                    width: 50%;
                }

                #SettingPanel {
                    width: 25%;
                }


                /* =========================================================
                          FORM CONTAINER
                          ========================================================= */

                #FormContainer {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    gap: .6rem;
                    padding: 1rem;
                    width: 100%;
                    height: 35rem;
                    overflow-y: auto;
                }


                    /* =========================================================
                          FORM ROW - LIQUID GLASS
                          ========================================================= */

                    #FormContainer .row {
                        position: relative;
                        width: 100%;
                        height: fit-content;
                        /*                     min-height: 3.75rem;*/
                        padding: 1.2rem .8rem .5rem .8rem;
                        border-radius: .65rem;
                        background-color: transparent;
                        /*                                 border: 1px solid rgba(255,255,255,.075);*/
                        /*                                 background: linear-gradient( 135deg, rgba(255,255,255,.045), rgba(255,255,255,.015) );*/
                        /*                 backdrop-filter: blur(12px) saturate(140%);*/
                        /*                 -webkit-backdrop-filter: blur(12px) saturate(140%);*/
                        /*                 box-shadow: inset 0 1px 0 rgba(255,255,255,.08), inset 0 -1px 0 rgba(255,255,255,.02);*/
                        transition: var(--glass-transition);
                    }


                        #FormContainer .row:hover {
                            border-color: rgba(255,255,255,.14);
                            background: linear-gradient( 135deg, rgba(255,255,255,.065), rgba(255,255,255,.025) );
                            box-shadow: inset 0 1px 0 rgba(255,255,255,.13), 0 8px 25px rgba(0,0,0,.10);
                        }


                        /* =========================================================
                          DRAG ACTIVE
                          ========================================================= */

                        #FormContainer .row.drag-active {
                            border: 1px dashed var(--aqua);
                            box-shadow: inset 0 0 1rem rgba(0,255,255,.10), 0 0 1rem rgba(0,255,255,.08);
                            animation: rowBorderBlink 1s infinite;
                        }


                @@keyframes rowBorderBlink {

                    0%, 100% {
                        opacity: 1;
                    }

                    50% {
                        opacity: .45;
                    }
                }


                /* =========================================================
                          SETTINGS CONTAINER
                          ========================================================= */

                #SettingsContainer {
                    padding: 1rem;
                    display: flex;
                    flex-direction: column;
                    justify-content: flex-start;
                    align-items: start;
                    gap: 1.5rem;
                    width: 100%;
                    height: 35rem;
                    overflow-y: auto;
                }

                    #SettingsContainer .row {
                        width: 100%;
                    }


                #selectSettingsContainer {
                    width: 100%;
                    display: flex;
                    flex-direction: column;
                    padding-top: .5rem;
                    gap: 1.5rem;
                }


                /* =========================================================
                          TITLE
                          ========================================================= */

                .title {
                    position: relative;
                    display: flex;
                    flex-direction: row;
                    justify-content: space-between;
                    width: 100%;
                    height: 5rem;
                    padding: 1rem;
                    background: linear-gradient( 135deg, rgba(255,255,255,.075), rgba(255,255,255,.02) );
                    backdrop-filter: blur(15px) saturate(150%);
                    -webkit-backdrop-filter: blur(15px) saturate(150%);
                    border-bottom: 1px solid rgba(255,255,255,.08);
                    box-shadow: inset 0 -1px 0 rgba(255,255,255,.04);
                }


                .title-texts {
                    width: fit-content;
                    display: flex;
                    flex-direction: column;
                    gap: .5rem;
                }


                    .title-texts p {
                        font-size: .6rem;
                    }


                .title-icon i {
                    font-size: 2rem;
                    color: var(--aqua);
                    filter: drop-shadow( 0 0 .5rem rgba(0,255,255,.35) );
                }


                /* =========================================================
                          TOOLS LIST
                          ========================================================= */

                #ToolsList {
                    height: 35rem;
                    padding: 1rem;
                    display: flex;
                    flex-direction: column;
                    gap: .6rem;
                    overflow-y: auto;
                }


                /* =========================================================
                          TOOL
                          ========================================================= */

                .tool {
                    position: relative;
                    width: 100%;
                    height: 4rem;
                    padding: .8rem;
                    display: flex;
                    flex-direction: row;
                    align-items: center;
                    justify-content: space-between;
                    border-radius: .65rem;
                    border: 1px solid rgba(255,255,255,.10);
                    background: linear-gradient( 135deg, rgba(255,255,255,.065), rgba(255,255,255,.018) ) !important;
                    backdrop-filter: blur(14px) saturate(150%);
                    -webkit-backdrop-filter: blur(14px) saturate(150%);
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), inset 0 -1px 0 rgba(255,255,255,.025), 0 5px 20px rgba(0,0,0,.10);
                    transition: .35s;
                }


                    /* reflection */

                    .tool::before {
                        content: "";
                        position: absolute;
                        inset: 0;
                        background: linear-gradient( 120deg, rgba(255,255,255,.10), transparent 30%, transparent 70%, rgba(255,255,255,.035) );
                        pointer-events: none;
                    }


                    .tool:hover {
                        transform: translateY(-2px) scale(1.025);
                        border-color: rgba(0,255,255,.45);
                        background: linear-gradient( 135deg, rgba(0,255,255,.10), rgba(255,255,255,.035) ) !important;
                        box-shadow: inset 0 1px 0 rgba(255,255,255,.18), inset 0 0 1rem rgba(0,255,255,.045), 0 10px 30px rgba(0,0,0,.18), 0 0 .8rem rgba(0,255,255,.08);
                    }


                /* =========================================================
                          TOOL CONTENT
                          ========================================================= */

                .tool-1 {
                    display: flex;
                    flex-direction: row;
                    gap: .5rem;
                    position: relative;
                    z-index: 2;
                }


                .tool-icon {
                    width: 3rem;
                    height: 3rem;
                    min-width: 3rem;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: .55rem;
                    background: linear-gradient( 145deg, rgba(255,255,255,.12), rgba(255,255,255,.025) );
                    border: 1px solid rgba(255,255,255,.12);
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.16), inset 0 0 .6rem rgba(0,255,255,.035);
                }


                    .tool-icon i {
                        font-size: 1rem;
                        color: white;
                    }


                .tool-text {
                    display: flex;
                    flex-direction: column;
                    gap: .1rem;
                    justify-content: center;
                }


                    .tool-text p {
                        font-size: .6rem;
                    }


                .tool-handle {
                    position: relative;
                    z-index: 2;
                }


                    .tool-handle i {
                        font-size: 1.8rem;
                    }


                /* =========================================================
                          BUTTONS
                          ========================================================= */

                .btn {
                    position: relative;
                    background: linear-gradient( 135deg, rgba(255,255,255,.08), rgba(255,255,255,.025) );
                    padding: .5rem;
                    border-radius: .55rem;
                    border: 1px solid rgba(255,255,255,.14);
                    backdrop-filter: blur(10px) saturate(140%);
                    -webkit-backdrop-filter: blur(10px) saturate(140%);
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), 0 4px 15px rgba(0,0,0,.12);
                    transform: scale(1);
                    transition: var(--glass-transition);
                }


                    .btn:hover {
                        transform: translateY(-1px) scale(1.035);
                        border-color: rgba(0,255,255,.45);
                        box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 6px 20px rgba(0,0,0,.18);
                    }


                /* =========================================================
                          BASIC BUTTON
                          ========================================================= */

                .basic-btn {
                    width: 100%;
                    height: 2.15rem;
                    transition: var(--glass-transition);
                    border-radius: .55rem;
                    border: 1px solid rgba(255,255,255,.15);
                    font-size: .7rem;
                    background: linear-gradient( 135deg, rgba(255,255,255,.075), rgba(255,255,255,.025) );
                    backdrop-filter: blur(10px);
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.10);
                }


                    .basic-btn:hover {
                        transform: translateY(-1px) scale(1.025);
                        background: linear-gradient( 135deg, rgba(0,255,255,.12), rgba(255,255,255,.035) );
                        border-color: rgba(0,255,255,.65);
                        box-shadow: inset 0 0 .7rem rgba(0,255,255,.10), 0 0 .8rem rgba(0,255,255,.08);
                        color: var(--aqua);
                    }


                    .basic-btn:active {
                        transform: scale(.94);
                    }


                /* =========================================================
                          ADD BUTTON
                          ========================================================= */

                .basic-add:hover {
                    background: linear-gradient( 135deg, rgba(50,213,131,.10), rgba(255,255,255,.025) ) !important;
                    border-color: var(--success) !important;
                    box-shadow: inset 0 0 .7rem rgba(50,213,131,.10), 0 0 .8rem rgba(50,213,131,.08) !important;
                    color: var(--success) !important;
                }


                /* =========================================================
                          DELETE BUTTON
                          ========================================================= */

                .basic-del {
                    font-size: small !important;
                }


                    .basic-del:hover {
                        border-color: var(--danger) !important;
                        background: linear-gradient( 135deg, rgba(255,77,109,.12), rgba(255,255,255,.025) ) !important;
                        box-shadow: inset 0 0 .7rem rgba(255,77,109,.12), 0 0 .8rem rgba(255,77,109,.08) !important;
                        color: var(--danger) !important;
                    }


                /* =========================================================
                          APPLY / DELETE
                          ========================================================= */

                #btnApplyFieldSettings,
                #btnApplyImageSettings {
                    border-color: rgba(50,213,131,.6);
                }


                    #btnApplyFieldSettings:hover,
                    #btnApplyImageSettings:hover {
                        background: linear-gradient( 135deg, rgba(50,213,131,.13), rgba(255,255,255,.025) );
                        color: white;
                        box-shadow: inset 0 0 .5rem rgba(50,213,131,.15), 0 0 .8rem rgba(50,213,131,.08);
                    }


                #btnDeleteField,
                #btnDeleteImageField {
                    border-color: rgba(255,77,109,.6);
                }


                    #btnDeleteField:hover,
                    #btnDeleteImageField:hover {
                        background: linear-gradient( 135deg, rgba(255,77,109,.13), rgba(255,255,255,.025) );
                        color: white;
                        box-shadow: inset 0 0 .5rem rgba(255,77,109,.15), 0 0 .8rem rgba(255,77,109,.08);
                    }


                /* =========================================================
                          FIELD WIDTH
                          ========================================================= */

                .field-width-options {
                    padding: .5rem 0;
                    display: grid;
                    grid-template-columns: repeat(4, 1fr);
                    gap: .5rem;
                    width: 100%;
                }


                .field-width-option {
                    position: relative;
                    cursor: pointer;
                    margin: 0;
                }


                    .field-width-option input {
                        position: absolute;
                        opacity: 0;
                        pointer-events: none;
                    }


                    .field-width-option span {
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        height: 2.8rem;
                        border: 1px solid rgba(255,255,255,.12);
                        border-radius: .55rem;
                        background: linear-gradient( 135deg, rgba(255,255,255,.055), rgba(255,255,255,.018) );
                        backdrop-filter: blur(8px);
                        box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
                        transition: var(--glass-transition);
                        cursor: pointer;
                    }


                    .field-width-option:hover span {
                        border-color: rgba(0,255,255,.55);
                        background: rgba(0,255,255,.07);
                        box-shadow: inset 0 0 .5rem rgba(0,255,255,.08), 0 0 .6rem rgba(0,255,255,.05);
                    }


                    .field-width-option input:checked + span {
                        border-color: rgba(0,255,255,.75);
                        background: linear-gradient( 135deg, rgba(0,255,255,.12), rgba(255,255,255,.025) );
                        color: var(--aqua);
                        box-shadow: inset 0 0 .6rem rgba(0,255,255,.10), 0 0 .6rem rgba(0,255,255,.06);
                    }


                /* =========================================================
                          CHECKBOX
                          ========================================================= */

                .checkbox-setting {
                    --c-primary: aqua;
                    --c-primary-20: #00ffff55;
                    --c-primary-10: #00ffff1a;
                    --border-width: .1rem;
                    --t-base: .4s;
                    --t-fast: .2s;
                    --e-in: ease-in;
                    --e-out: cubic-bezier(.11,.29,.18,.98);
                }


                    .checkbox-setting .visuallyhidden {
                        border: 0;
                        clip: rect(0 0 0 0);
                        height: 1px;
                        margin: -1px;
                        overflow: hidden;
                        padding: 0;
                        position: absolute;
                        width: 1px;
                    }


                .checkbox-setting__label {
                    display: flex;
                    align-items: center;
                    width: fit-content;
                    color: white;
                    cursor: pointer;
                    user-select: none;
                }


                .checkbox-setting__symbol {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    position: relative;
                    width: 1.5rem;
                    height: 1.5rem;
                    margin-left: .6rem;
                    background: linear-gradient( 135deg, rgba(255,255,255,.09), rgba(255,255,255,.02) );
                    border: var(--border-width) solid var(--c-primary);
                    border-radius: .5rem;
                    backdrop-filter: blur(8px);
                    transition: box-shadow var(--t-base) var(--e-out), background-color var(--t-base);
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), 0 0 0 0 var(--c-primary-10);
                }


                .checkbox-setting .icon-checkbox {
                    width: 1rem;
                    height: 1rem;
                    fill: none;
                    stroke-width: 3;
                    stroke: var(--c-primary);
                    stroke-linecap: round;
                    stroke-linejoin: round;
                    stroke-miterlimit: 10;
                    display: inline-block;
                }


                    .checkbox-setting .icon-checkbox path {
                        stroke-dasharray: 30px, 31px;
                        stroke-dashoffset: 31px;
                        transition: stroke-dashoffset var(--t-fast) var(--e-in);
                    }


                .checkbox-setting__text {
                    font-size: .8rem;
                    margin: 0;
                }


                .checkbox-setting__label:hover
                .checkbox-setting__symbol {
                    box-shadow: 0 0 0 .25rem var(--c-primary-10), inset 0 0 .5rem rgba(0,255,255,.06);
                }


                .checkbox-setting__trigger:checked + .checkbox-setting__symbol {
                    background: linear-gradient( 135deg, rgba(0,255,255,.12), rgba(255,255,255,.025) );
                    box-shadow: 0 0 0 .25rem var(--c-primary-10), inset 0 0 .6rem rgba(0,255,255,.08);
                }


                    .checkbox-setting__trigger:checked + .checkbox-setting__symbol
                    .icon-checkbox
                    path {
                        transition: stroke-dashoffset var(--t-base) var(--e-out);
                        stroke-dashoffset: 0;
                    }


                .checkbox-setting__trigger:focus + .checkbox-setting__symbol {
                    box-shadow: 0 0 0 .25rem var(--c-primary-20);
                }


                /* =========================================================
                          RIPPLE
                          ========================================================= */

                .checkbox-setting__symbol::after {
                    content: "";
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    width: .25rem;
                    height: .25rem;
                    background-color: var(--c-primary-20);
                    opacity: 0;
                    border-radius: 50%;
                    transform: translate(-50%, -50%) scale(1);
                    transform-origin: 50% 50%;
                }


                .checkbox-setting__trigger:checked + .checkbox-setting__symbol::after {
                    animation: checkbox-setting-ripple 1.5s var(--e-out);
                }


                @@keyframes checkbox-setting-ripple {

                    from {
                        transform: translate(-50%, -50%) scale(0);
                        opacity: 1;
                    }

                    to {
                        opacity: 0;
                        transform: translate(-50%, -50%) scale(20);
                    }
                }


                /* =========================================================
                          REQUIRED
                          ========================================================= */

                .required-mark {
                    color: #ff4d6d;
                    margin-right: .25rem;
                    font-weight: bold;
                    text-shadow: 0 0 .5rem rgba(255,77,109,.35);
                }


                /* =========================================================
                          SCROLLBAR
                          ========================================================= */

                .scrollbar {
                    overflow-y: auto;
                    scrollbar-width: thin;
                    scrollbar-color: rgba(0,255,255,.55) transparent;
                }


                    .scrollbar::-webkit-scrollbar {
                        width: 6px;
                    }


                    .scrollbar::-webkit-scrollbar-track {
                        background: transparent;
                        border-radius: 10px;
                        margin: 8px 0;
                    }


                    .scrollbar::-webkit-scrollbar-thumb {
                        background: linear-gradient( 180deg, rgba(0,255,255,.75), rgba(0,180,180,.55) );
                        border-radius: 10px;
                        border: 1px solid transparent;
                        background-clip: padding-box;
                        min-height: 40px;
                        box-shadow: 0 2px 8px rgba(0,255,255,.18);
                    }


                        .scrollbar::-webkit-scrollbar-thumb:hover {
                            background: linear-gradient( 180deg, rgba(0,255,255,.95), rgba(0,218,218,.75) );
                            box-shadow: 0 3px 12px rgba(0,255,255,.30);
                        }


                /* =========================================================
                          FILE UPLOAD
                          ========================================================= */

                .file-upload-box {
                    position: relative;
                    width: 100%;
                    min-height: 8rem;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    box-sizing: border-box;
                    border: 1px dashed rgba(0,255,255,.40);
                    border-radius: .65rem;
                    background: linear-gradient( 135deg, rgba(255,255,255,.055), rgba(0,255,255,.035) );
                    backdrop-filter: blur(14px) saturate(140%);
                    -webkit-backdrop-filter: blur(14px) saturate(140%);
                    overflow: hidden;
                    transition: .3s ease;
                }


                    .file-upload-box:hover {
                        border-color: rgba(0,255,255,.75);
                        background: linear-gradient( 135deg, rgba(0,255,255,.08), rgba(255,255,255,.035) );
                        box-shadow: inset 0 0 .8rem rgba(0,255,255,.08), 0 0 1rem rgba(0,255,255,.06);
                    }


                .file-upload-input {
                    position: absolute;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    opacity: 0;
