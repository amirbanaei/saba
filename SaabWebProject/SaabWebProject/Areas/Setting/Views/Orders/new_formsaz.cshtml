        function applySelectOptions(field) {

            const select = field.querySelector("select");

            const container =
                document.getElementById("selectOptionsContainer");

            if (!select || !container) {
                return;
            }

            const optionInputs =
                container.querySelectorAll(".select-option-input");

            // گزینه فعلی انتخاب شود
            const currentValue = select.value;

            // پاک کردن گزینه‌های قبلی
            select.innerHTML = "";

            // گزینه پیش‌فرض
            const defaultOption = document.createElement("option");

            defaultOption.value = "";
            defaultOption.textContent = "انتخاب کنید..";

            select.appendChild(defaultOption);


            // اضافه کردن گزینه‌های جدید
            optionInputs.forEach(function (input, index) {

                const text = input.value.trim();

                if (!text) {
                    return;
                }

                const option = document.createElement("option");

                option.value = index + 1;
                option.textContent = text;

                select.appendChild(option);

            });


            // اگر مقدار قبلی هنوز وجود داشت، حفظش کن
            const exists = Array.from(select.options)
                .some(option => option.value === currentValue);

            if (exists) {
                select.value = currentValue;
            }

        }
