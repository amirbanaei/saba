        function generateFormDefinition() {

            const formContainer =
                document.getElementById("FormContainer");

            if (!formContainer) {
                return {
                    fields: []
                };
            }

            const fields = [];

            formContainer
                .querySelectorAll(".field-item")
                .forEach(function (field, index) {

                    const type =
                        field.dataset.fieldType || "";

                    const fieldData = {

                        index: index,

                        type: type,

                        title:
                            field.querySelector(".form-label")
                                ?.textContent
                                ?.trim() || "",

                        id:
                            field.id || "",

                        width:
                            getFieldWidth(field),

                        required:
                            field.dataset.required === "true"

                    };


                    // =====================================================
                    // تنظیمات اختصاصی جدول اینزرت
                    // =====================================================

                    if (type === "table-insert") {

                        let columnTitles = [];
                        let columnWidths = [];

                        try {

                            columnTitles =
                                JSON.parse(
                                    field.dataset.tableColumnTitles || "[]"
                                );

                        } catch (e) {

                            columnTitles = [];

                        }


                        try {

                            columnWidths =
                                JSON.parse(
                                    field.dataset.tableColumnWidths || "[]"
                                );

                        } catch (e) {

                            columnWidths = [];

                        }


                        fieldData.settings = {

                            columns:
                                parseInt(
                                    field.dataset.tableColumns
                                ) || columnTitles.length || 0,

                            columnTitles:
                                columnTitles,

                            columnWidths:
                                columnWidths

                        };

                    }
                    // =====================================================
                    // تنظیمات اختصاصی جدول معمولی
                    // =====================================================

                    if (type === "table") {

                        let columnTitles = [];
                        let columnWidths = [];
                        let rowTitles = [];

                        // -----------------------------------------
                        // عنوان ستون‌ها
                        // -----------------------------------------

                        try {

                            columnTitles =
                                JSON.parse(
                                    field.dataset.tableColumnTitles || "[]"
                                );

                        } catch (e) {

                            columnTitles = [];

                        }


                        // -----------------------------------------
                        // عرض ستون‌ها
                        // -----------------------------------------

                        try {

                            columnWidths =
                                JSON.parse(
                                    field.dataset.tableColumnWidths || "[]"
                                );

                        } catch (e) {

                            columnWidths = [];

                        }


                        // -----------------------------------------
                        // عنوان ردیف‌ها
                        // -----------------------------------------

                        try {

                            rowTitles =
                                JSON.parse(
                                    field.dataset.tableRowTitles || "[]"
                                );

                        } catch (e) {

                            rowTitles = [];

                        }


                        // -----------------------------------------
                        // اضافه کردن تنظیمات جدول
                        // -----------------------------------------

                        fieldData.settings = {

                            columns:
                                parseInt(
                                    field.dataset.tableColumns
                                ) || columnTitles.length || 0,

                            rows:
                                parseInt(
                                    field.dataset.tableRows
                                ) || rowTitles.length || 0,

                            columnTitles:
                                columnTitles,

                            columnWidths:
                                columnWidths,

                            rowTitles:
                                rowTitles

                        };

                    }
                    fields.push(fieldData);

                });

            return {

                version: 1,

                fields: fields

            };
        }
        function getFieldWidth(field) {

            const widthClass =
                Array.from(field.classList)
                    .find(function (className) {

                        return className.startsWith("col-xl-");

                    });

            if (!widthClass) {
                return 12;
            }

            return parseInt(
                widthClass.replace("col-xl-", "")
            ) || 12;
        }
        //ذخیره جیسون نهایی و فاقد مقدار
        let formDefinitionJSON = null;

        document
            .getElementById("btnTestJSON")
            .addEventListener("click", function () {

                // ساخت JSON از فرم فعلی
                formDefinitionJSON = generateFormDefinition();

                // پیام موفقیت
                alert("JSON با موفقیت ذخیره شد.");

                // نمایش JSON در Console
                console.log("Form JSON:", formDefinitionJSON);

            });
