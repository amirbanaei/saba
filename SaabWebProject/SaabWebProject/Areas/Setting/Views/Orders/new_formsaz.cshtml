                /* =========================================================
                          IMAGE UPLOAD
                          ========================================================= */

                .image-upload-box {
                    position: relative;
                    width: 100%;
                    height: 10rem;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    border: 1px dashed rgba(0,255,255,.40);
