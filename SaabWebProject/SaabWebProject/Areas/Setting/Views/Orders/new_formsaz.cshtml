        });
        //تصویر چند بخشی

















        function addFileToList(box, file) {

            const fileList =
                box.querySelector(".file-list");

            if (!fileList) {
                return;
            }


            const row =
                document.createElement("div");

            row.className = "file-item";


            row.innerHTML = `

                        <div class="file-item-icon">

                            <i class="${getFileIcon(file.name)}"></i>

                        </div>


                        <div class="file-item-info">

                            <div class="file-item-name"
                                 title="${file.name}">

                                ${file.name}

                            </div>

                            <div class="file-item-size">

                                ${formatFileSize(file.size)}

                            </div>

                        </div>


                        <div class="file-item-delete">

                            <button type="button"
                                    class="btn w-100 basic-btn basic-del">

                                <i class="bi bi-trash"></i>

                            </button>

                        </div>

                    `;


            // فایل را روی خود element ذخیره می‌کنیم
            row._file = file;


            fileList.appendChild(row);
        }
        function getFileIcon(fileName) {

            const extension =
                fileName
                    .split(".")
                    .pop()
                    .toLowerCase();


            // PDF
            if (extension === "pdf") {

                return "bi bi-file-earmark-pdf";

            }


            // Word
            if (
                extension === "doc" ||
                extension === "docx"
            ) {

                return "bi bi-file-earmark-word";

            }


            // Excel
            if (
                extension === "xls" ||
                extension === "xlsx"
            ) {

                return "bi bi-file-earmark-excel";

            }


            // PowerPoint
            if (
                extension === "ppt" ||
                extension === "pptx"
            ) {

                return "bi bi-file-earmark-ppt";

            }


            // Image
            if (
                extension === "jpg" ||
                extension === "jpeg" ||
                extension === "png" ||
                extension === "gif" ||
                extension === "webp"
            ) {

                return "bi bi-file-earmark-image";

            }


            // ZIP / RAR
            if (
                extension === "zip" ||
                extension === "rar" ||
                extension === "7z"
            ) {

                return "bi bi-file-earmark-zip";

            }


            // Default
            return "bi bi-file-earmark";
        }
        function formatFileSize(bytes) {

            if (bytes === 0) {
                return "0 KB";
            }


            const units = [
                "Bytes",
                "KB",
                "MB",
                "GB"
            ];


            const index =
                Math.floor(
                    Math.log(bytes) / Math.log(1024)
                );


            const size =
                bytes /
                Math.pow(1024, index);


            return (
                size.toFixed(
                    index === 0 ? 0 : 2
                )
                + " "
                + units[index]
            );
        }
        document.addEventListener("click", function (e) {

            const deleteButton =
                e.target.closest(
                    ".file-item-delete .basic-del"
                );


            if (!deleteButton) {
                return;
            }


            e.preventDefault();

            e.stopPropagation();


            const fileItem =
