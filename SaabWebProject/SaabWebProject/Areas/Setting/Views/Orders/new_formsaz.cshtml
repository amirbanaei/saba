                        backdrop-filter: blur(10px);
                        -webkit-backdrop-filter: blur(10px);
                        color: white;
                        transition: .3s ease;
                        cursor: pointer;
                    }


                    /* Hover */

                    .number-type-option:hover span {
                        border-color: aqua;
                        background-color: #00ffff0d;
                        box-shadow: inset 0 0 .4rem aqua, 0 0 .4rem #00ffff22;
                        color: aqua;
                        transform: scale(1.02);
                    }


                    /* Selected */

                    .number-type-option input:checked + span {
                        border-color: aqua;
                        background-color: #00ffff1a;
                        color: aqua;
                        box-shadow: inset 0 0 .5rem aqua, 0 0 .5rem #00ffff22;
                    }


                    /* Active */

                    .number-type-option:active span {
                        transform: scale(.97);
                    }

                #numberSimpleSettings {
                    display: flex;
                    flex-direction: column;
                    gap: 2rem;
                    width: 100%;
