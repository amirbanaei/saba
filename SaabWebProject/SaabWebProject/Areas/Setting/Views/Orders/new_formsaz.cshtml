                                width =
                                    window.getComputedStyle(
                                        th
                                    ).width;
                            }

                            let remValue = "";

                            // ==========================================
                            // اگر مقدار مستقیماً rem باشد
                            // ==========================================

                            if (
                                width &&
                                width.includes("rem")
                            ) {

                                remValue =
                                    parseFloat(width);
                            }

                            // ==========================================
                            // اگر مقدار px باشد
                            // تبدیل px به rem
                            // ==========================================

                            else if (
                                width &&
                                width.includes("px")
                            ) {

                                const pxValue =
                                    parseFloat(width);

                                const rootFontSize =
                                    parseFloat(
                                        window.getComputedStyle(
                                            document.documentElement
                                        ).fontSize
                                    );

                                if (
                                    !isNaN(pxValue) &&
                                    !isNaN(rootFontSize) &&
                                    rootFontSize > 0
                                ) {

                                    remValue =
                                        parseFloat(
                                            (
                                                pxValue /
                                                rootFontSize
                                            ).toFixed(2)
                                        );
                                }
                            }

                            // ==========================================
                            // اگر هیچ مقداری پیدا نشد
                            // ==========================================

                            if (
                                remValue === "" ||
                                isNaN(remValue)
                            ) {

                                remValue = 10;
                            }

                            currentColumnWidths.push(
                                remValue
                            );

                        }
                    );
                }


                // ==========================================
                // اگر عرض ذخیره شده داریم
                // اولویت با آن است
                // ==========================================

                let savedWidths = [];

                try {

                    savedWidths =
                        JSON.parse(
                            selectedField.dataset.tableColumnWidths || "[]"
                        );

                } catch (e) {

                    savedWidths = [];

                }


                // اگر مقدار ذخیره‌شده وجود دارد،
                // از آن استفاده کن

                if (
                    Array.isArray(savedWidths) &&
                    savedWidths.length > 0
                ) {

                    currentColumnWidths =
                        savedWidths;

                }


                // ==========================================
                // تنظیمات جدول
                // ==========================================

                document.getElementById(
                    "selectSettingsContainer"
                ).innerHTML = `

            <!-- ========================================= -->
            <!-- تعداد ستون -->
            <!-- ========================================= -->

            <div class="row">

                <div class="col-xl-12">

                    <label class="form-label">
                        تعداد ستون
                    </label>

                    <input
                        type="number"
                        class="form-control"
                        id="tableColumnCount"
                        min="1"
                        max="12"
                        value="${savedColumns}" />

                </div>

            </div>


            <!-- ========================================= -->
            <!-- عنوان ستون‌ها -->
            <!-- ========================================= -->

            <div class="row">

                <div class="col-xl-12">



                    <div
                        id="tableColumnTitles"
                        class="table-column-titles">
                    </div>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- تعداد ردیف -->
            <!-- ========================================= -->

            <div class="row">

                <div class="col-xl-12">

                    <label class="form-label">
                        تعداد ردیف
                    </label>

                    <input
                        type="number"
                        class="form-control"
                        id="tableRowCount"
                        min="1"
                        value="${savedRows}" />

                </div>

            </div>


            <!-- ========================================= -->
            <!-- عنوان ردیف‌ها -->
            <!-- ========================================= -->

            <div class="row">

                <div class="col-xl-12">

                    <label class="form-label">
                        عنوان ردیف‌ها
                    </label>

                    <div
                        id="tableRowTitles"
                        class="table-row-titles">
                    </div>

                </div>

            </div>

        `;


                // ==========================================
                // ساخت عنوان + عرض ستون‌ها
                // ==========================================

                generateTableColumnTitles(
                    savedColumns,
                    savedTitles,
                    currentColumnWidths
                );


                // ==========================================
                // ساخت عنوان ردیف‌ها
                // ==========================================

                generateTableRowTitles(
                    savedRows,
                    savedRowTitles
                );

            }
            const tableField =
                document.querySelector(
                    '[data-field-type="table"] .form-builder-table'
                );


            function updateNumberSettingsVisibility() {

                const selectedType =
                    document.querySelector(
                        'input[name="numberType"]:checked'
                    );

                const simpleSettings =
                    document.getElementById(
                        "numberSimpleSettings"
                    );

                if (!selectedType || !simpleSettings) {
                    return;
                }

                if (selectedType.value === "simple") {

                    simpleSettings.style.display = "flex";

                }
                else {

                    simpleSettings.style.display = "none";

                }

            }
            document
                .querySelectorAll('input[name="numberType"]')
                .forEach(function (radio) {

                    radio.addEventListener(
                        "change",
                        updateNumberSettingsVisibility
                    );

                });

            //تنظیمات جدول افزودن
            function generateTableInsertColumnTitles(
                count,
                savedTitles = [],
                savedWidths = []
            ) {

                const container =
                    document.getElementById(
                        "tableInsertColumnTitles"
                    );

                if (!container) {
                    return;
                }


                container.innerHTML = "";


                for (let i = 1; i <= count; i++) {

                    const savedTitle =
                        savedTitles[i - 1] || "";


                    const savedWidth =
                        savedWidths[i - 1] || "";


                    container.innerHTML += `

                <div class="row mb-3">

                    <div class="col-xl-6">

                        <label class="form-label">
                            عنوان ستون ${i}
                        </label>

                        <input
                            type="text"
                            class="form-control table-insert-column-title"
                            data-column-index="${i}"
                            value="${savedTitle}"
                            placeholder="عنوان ستون ${i}" />

                    </div>


                    <div class="col-xl-6">

                        <label class="form-label">
                            عرض ستون (rem)
                        </label>

                        <input
                            type="number"
                            class="form-control table-insert-column-width"
                            data-column-index="${i}"
                            value="${savedWidth}"
                            min="0"
                            step="0.1"
                            placeholder="مثلاً 12" />

                    </div>

                </div>

            `;
                }
            }
            document.addEventListener(
                "input",
                function (e) {

                    if (
                        e.target.id ===
                        "tableInsertColumnCount"
                    ) {

                        let count =
                            parseInt(e.target.value);


                        if (
                            isNaN(count) ||
                            count < 1
                        ) {

                            count = 1;

                        }


                        if (count > 12) {

                            count = 12;
                            e.target.value = 12;

                        }


                        const currentTitles = [];


                        document
                            .querySelectorAll(
                                ".table-insert-column-title"
                            )
                            .forEach(function (input) {

                                currentTitles.push(
                                    input.value
                                );

                            });


                        const currentWidths = [];


                        document
                            .querySelectorAll(
                                ".table-insert-column-width"
                            )
                            .forEach(function (input) {

                                currentWidths.push(
                                    input.value
                                );

                            });


                        generateTableInsertColumnTitles(
                            count,
                            currentTitles,
                            currentWidths
                        );

                    }

                }
            );
            //تنظیمات جدول

            function generateTableColumnTitles(
                count,
                savedTitles = [],
                savedWidths = []
            ) {

                const container =
                    document.getElementById(
                        "tableColumnTitles"
                    );

                if (!container) {
                    return;
                }

                container.innerHTML = "";


                for (let i = 1; i <= count; i++) {

                    const savedTitle =
                        savedTitles[i - 1] || "";


                    const savedWidth =
                        savedWidths[i - 1] || "";


                    container.innerHTML += `

                <div class="row mb-3">

                    <!-- عنوان ستون -->

                    <div class="col-xl-6">

                        <label class="form-label">
                            عنوان ستون ${i}
                        </label>

                        <input
                            type="text"
                            class="form-control table-column-title"
                            data-column-index="${i}"
                            value="${savedTitle}"
                            placeholder="عنوان ستون ${i}" />

                    </div>


                    <!-- عرض ستون -->

                    <div class="col-xl-6">

                        <label class="form-label">
                            عرض ستون (rem)
                        </label>

                        <input
                            type="number"
                            class="form-control table-column-width"
                            data-column-index="${i}"
                            value="${savedWidth}"
                            min="0"
                            step="0.1"
                            placeholder="مثلاً 12" />

                    </div>

                </div>

            `;
                }

            }
            function generateTableRowTitles(count, savedTitles = []) {

                const container =
                    document.getElementById("tableRowTitles");

                if (!container) {
                    return;
                }

                container.innerHTML = "";


                for (let i = 1; i <= count; i++) {

                    const savedTitle =
                        savedTitles[i - 1] || "";


                    container.innerHTML += `

                    <div class="row mb-2">

                        <div class="col-xl-12">



                            <input
                                type="text"
                                class="form-control table-row-title"
                                data-row-index="${i}"
                                value="${savedTitle}"
                                placeholder="عنوان ردیف ${i}" />

                        </div>

                    </div>

                `;
                }

            }

            // ==========================================
            // تغییر تعداد ستون
            // ==========================================
            document.addEventListener("input", function (e) {

                if (e.target.id === "tableColumnCount") {

                    let count =
                        parseInt(e.target.value);

                    if (isNaN(count) || count < 1) {
                        count = 1;
                    }

                    if (count > 12) {
                        count = 12;
                        e.target.value = 12;
                    }

                    const currentTitles = [];

                    document
                        .querySelectorAll(".table-column-title")
                        .forEach(function (input) {

                            currentTitles.push(
                                input.value
                            );

                        });

                    generateTableColumnTitles(
                        count,
                        currentTitles
                    );
                }

            });
            // ==========================================
            // تغییر تعداد ردیف
            // ==========================================

            document.addEventListener("input", function (e) {

                if (e.target.id === "tableRowCount") {

                    let count =
                        parseInt(e.target.value);

                    if (isNaN(count) || count < 1) {
                        count = 1;
                    }

                    const currentTitles = [];

                    document
                        .querySelectorAll(".table-row-title")
                        .forEach(function (input) {

                            currentTitles.push(
                                input.value
                            );

                        });

                    generateTableRowTitles(
                        count,
                        currentTitles
                    );

                }

            });
            document
                .getElementById("btnApplyFieldSettings")
                .addEventListener("click", function () {

                    if (
                        selectedField.dataset.fieldType ===
                        "table-insert"
                    ) {

                        const columnCountInput =
                            document.getElementById(
                                "tableInsertColumnCount"
                            );


                        const columnTitleInputs =
                            document.querySelectorAll(
                                ".table-insert-column-title"
                            );


                        const columnWidthInputs =
                            document.querySelectorAll(
                                ".table-insert-column-width"
                            );


                        let columnCount =
                            parseInt(
                                columnCountInput.value
                            );


                        if (
                            isNaN(columnCount) ||
                            columnCount < 1
                        ) {

                            alert(
                                "تعداد ستون را به صورت صحیح وارد کنید."
                            );

                            return;
                        }


                        if (columnCount > 12) {

                            alert(
                                "حداکثر تعداد ستون 12 می‌باشد."
                            );

                            return;
                        }


                        const columnTitles = [];


                        columnTitleInputs.forEach(
                            function (input, index) {

                                const title =
                                    input.value.trim();


                                columnTitles.push(
                                    title !== ""
                                        ? title
                                        : "ستون " + (index + 1)
                                );

                            }
                        );


                        const columnWidths = [];


                        columnWidthInputs.forEach(
                            function (input) {

                                let width =
                                    parseFloat(input.value);


                                if (
                                    isNaN(width) ||
                                    width <= 0
                                ) {

                                    width = 10;

                                }


                                columnWidths.push(
                                    width
                                );

                            }
                        );


                        const table =
                            selectedField.querySelector(
                                "table"
                            );


                        if (!table) {
                            return;
                        }


                        const thead =
                            table.querySelector("thead");


                        thead.innerHTML = "";


                        const headerRow =
                            document.createElement("tr");


                        for (
                            let i = 0;
                            i < columnCount;
                            i++
                        ) {

                            const th =
                                document.createElement("th");


                            th.textContent =
                                columnTitles[i];


                            th.dataset.columnIndex =
                                i;


                            th.style.width =
                                columnWidths[i] + "rem";


                            headerRow.appendChild(th);

                        }


                        thead.appendChild(headerRow);


                        // -----------------------------------------
                        // بازسازی Row اولیه
                        // -----------------------------------------

                        const tbody =
                            table.querySelector("tbody");


                        tbody.innerHTML = "";


                        const tr =
                            document.createElement("tr");


                        for (
                            let i = 0;
                            i < columnCount;
                            i++
                        ) {

                            const td =
                                document.createElement("td");


                            td.className =
                                "table-value-cell";


                            td.contentEditable =
                                "true";


                            td.dataset.rowIndex =
                                "0";


                            td.dataset.columnIndex =
                                i;


                            td.textContent =
                                "";


                            tr.appendChild(td);

                        }


                        tbody.appendChild(tr);


                        // -----------------------------------------
                        // ذخیره تنظیمات
                        // -----------------------------------------

                        selectedField.dataset.tableColumns =
                            columnCount;


                        selectedField.dataset.tableColumnTitles =
                            JSON.stringify(columnTitles);


                        selectedField.dataset.tableColumnWidths =
                            JSON.stringify(columnWidths);


                        alert(
                            "تنظیمات جدول اینزرت با موفقیت اعمال شد."
                        );


                        return;
                    }
                    // =====================================================
                    // تنظیمات ابزار متن
                    // =====================================================

                    if (selectedField.dataset.fieldType === "text") {

                        const maxLengthInput =
                            document.getElementById("settingMaxLength");

                        if (!maxLengthInput) {
                            return;
                        }

                        const maxLengthValue =
                            parseInt(maxLengthInput.value);

                        // اگر خالی بود
                        if (
                            isNaN(maxLengthValue) ||
                            maxLengthValue < 1
                        ) {

                            alert("حداکثر تعداد کاراکتر را به صورت صحیح وارد کنید.");

                            return;
                        }

                        // پیدا کردن Input داخل فیلد
                        const textInput =
                            selectedField.querySelector("input.form-control");

                        if (!textInput) {
                            return;
                        }

                        // اعمال محدودیت روی Input
                        textInput.setAttribute(
                            "maxlength",
                            maxLengthValue
                        );

                        // ذخیره مقدار روی خود Field
                        selectedField.dataset.maxLength =
                            maxLengthValue;

                    }
                    // =====================================================
                    // اگر ابزار جدول باشد
                    // =====================================================

                    if (selectedField.dataset.fieldType === "table") {

                        const columnCountInput =
                            document.getElementById("tableColumnCount");

                        const rowCountInput =
                            document.getElementById("tableRowCount");

                        const columnTitleInputs =
                            document.querySelectorAll(".table-column-title");

                        const rowTitleInputs =
                            document.querySelectorAll(".table-row-title");

                        // ---------------------------------------------
                        // تعداد ستون
                        // ---------------------------------------------

                        let columnCount =
                            parseInt(columnCountInput.value);

                        if (isNaN(columnCount) || columnCount < 1) {

                            alert("تعداد ستون را به صورت صحیح وارد کنید.");

                            return;
                        }

                        if (columnCount > 12) {

                            alert("حداکثر تعداد ستون 12 می‌باشد.");

                            return;
                        }


                        // ---------------------------------------------
                        // تعداد ردیف
                        // ---------------------------------------------

                        let rowCount =
                            parseInt(rowCountInput.value);

                        if (isNaN(rowCount) || rowCount < 1) {

                            alert("تعداد ردیف را به صورت صحیح وارد کنید.");

                            return;
                        }


                        // ---------------------------------------------
                        // عنوان ستون‌ها
                        // ---------------------------------------------

                        const columnTitles = [];

                        columnTitleInputs.forEach(function (input, index) {

                            const title = input.value.trim();

                            columnTitles.push(
                                title !== ""
                                    ? title
                                    : "ستون " + (index + 1)
                            );

                        });
                        // ---------------------------------------------
                        // عنوان و عرض ستون‌ها
                        // ---------------------------------------------

                        const columnWidthInputs =
                            document.querySelectorAll(
                                ".table-column-width"
                            );


                        const columnWidths = [];

                        columnWidthInputs.forEach(
                            function (input, index) {

                                let width =
                                    parseFloat(input.value);


                                // اگر مقدار نامعتبر بود
                                if (
                                    isNaN(width) ||
                                    width <= 0
                                ) {

                                    width = 10;

                                }


                                columnWidths.push(
                                    width
                                );

                            }
                        );
                        const rowTitles = [];

                        rowTitleInputs.forEach(function (input, index) {

                            const title =
                                input.value.trim();

                            rowTitles.push(
                                title !== ""
                                    ? title
                                    : "ردیف " + (index + 1)
                            );

                        });

                        // ---------------------------------------------
                        // پیدا کردن جدول
                        // ---------------------------------------------

                        let table =
                            selectedField.querySelector("table");


                        // اگر جدول وجود نداشت
                        if (!table) {

                            table = document.createElement("table");

                            table.className = "table form-builder-table";
                            selectedField.appendChild(table);
                        }


                        // ---------------------------------------------
                        // ساخت THEAD
                        // ---------------------------------------------

                        let thead =
                            table.querySelector("thead");

                        if (!thead) {

                            thead =
                                document.createElement("thead");

                            table.appendChild(thead);
                        }

                        thead.innerHTML = "";


                        const headerRow =
                            document.createElement("tr");


                        // ---------------------------------------------
                        // ستون ثابت عنوان ردیف
                        // ---------------------------------------------

                        const rowTitleHeader =
                            document.createElement("th");

                        rowTitleHeader.textContent =
                            "عنوان";

                        rowTitleHeader.dataset.columnIndex =
                            "row-title";

                        rowTitleHeader.className =
                            "table-row-header";

                        headerRow.appendChild(
                            rowTitleHeader
                        );


                        // ---------------------------------------------
                        // ساخت ستون‌های Header
                        // ---------------------------------------------

                        for (let i = 0; i < columnCount; i++) {

                            const th =
                                document.createElement("th");


                            // -----------------------------------------
                            // عنوان ستون
                            // -----------------------------------------

                            th.textContent =
                                columnTitles[i] ||
                                ("ستون " + (i + 1));


                            // -----------------------------------------
                            // شماره ستون
                            // -----------------------------------------

                            th.dataset.columnIndex =
                                i;


                            // -----------------------------------------
                            // عرض ستون
                            // -----------------------------------------

                            const width =
                                columnWidths[i];


                            if (
                                width &&
                                !isNaN(width)
                            ) {

                                th.style.width =
                                    width + "rem";
                            }


                            headerRow.appendChild(
                                th
                            );
                        }


                        // =====================================================
                        // اضافه کردن Header به THEAD
                        // =====================================================

                        thead.appendChild(
                            headerRow
                        );


                        // ---------------------------------------------
                        // ساخت TBODY
                        // ---------------------------------------------

                        let tbody =
                            table.querySelector("tbody");

                        tbody.innerHTML = "";


                        // ---------------------------------------------
                        // ساخت ردیف‌ها
                        // ---------------------------------------------

                        for (let i = 0; i < rowCount; i++) {

                            const tr =
                                document.createElement("tr");


                            // -----------------------------------------
                            // عنوان ردیف
                            // -----------------------------------------

                            const rowTitleTh =
                                document.createElement("th");

                            rowTitleTh.textContent =
                                rowTitles[i] ||
                                ("ردیف " + (i + 1));

                            rowTitleTh.dataset.rowIndex =
                                i;

                            rowTitleTh.dataset.columnIndex =
                                "row-title";

                            rowTitleTh.className =
                                "table-row-title-cell";

                            rowTitleTh.style.textAlign =
                                "center";


                            tr.appendChild(
                                rowTitleTh
                            );


                            // -----------------------------------------
                            // سلول‌های اصلی
                            // -----------------------------------------

                            for (let j = 0; j < columnCount; j++) {

                                const td =
                                    document.createElement("td");

                                td.className =
                                    "table-value-cell";

                                td.contentEditable =
                                    "true";

                                td.dataset.rowIndex =
                                    i;

                                td.dataset.columnIndex =
                                    j;

                                td.textContent =
                                    "";

                                tr.appendChild(
                                    td
                                );
                            }


                            tbody.appendChild(
                                tr
                            );
                        }

                        // ---------------------------------------------
                        // ذخیره تنظیمات روی خود Field
                        // ---------------------------------------------

                        selectedField.dataset.tableColumns =
                            columnCount;

                        selectedField.dataset.tableRows =
                            rowCount;

                        selectedField.dataset.tableColumnTitles =
                            JSON.stringify(columnTitles);

                        selectedField.dataset.tableColumnWidths =
                            JSON.stringify(columnWidths);

                        selectedField.dataset.tableRowTitles =
                            JSON.stringify(rowTitles);
                        // ---------------------------------------------
                        // اعمال عرض فیلد
                        // ---------------------------------------------

                        const selectedWidth =
                            document.querySelector(
                                'input[name="fieldWidth"]:checked'
                            );


                        if (selectedWidth) {

                            const newWidth =
                                selectedWidth.value;


                            const oldColClass =
                                Array.from(selectedField.classList)
                                    .find(c =>
                                        c.startsWith("col-xl-")
                                    );


                            if (oldColClass) {

                                selectedField.classList.remove(
                                    oldColClass
                                );
                            }


                            selectedField.classList.add(
                                "col-xl-" + newWidth
                            );
                        }


                        alert("تنظیمات جدول با موفقیت اعمال شد.");

                        return;
                    }
                    // =====================================================
                    // تنظیمات ابزار عددی
                    // =====================================================

                    if (selectedField.dataset.fieldType === "number") {

                        // =====================================================
                        // نوع عدد
                        // =====================================================

                        const selectedNumberType =
                            document.querySelector(
                                'input[name="numberType"]:checked'
                            );

                        if (!selectedNumberType) {

                            alert("لطفاً نوع عدد را انتخاب کنید.");

                            return;
                        }


                        const numberType =
                            selectedNumberType.value;


                        // =====================================================
                        // ذخیره نوع عدد روی Field
                        // =====================================================

                        selectedField.dataset.numberType =
                            numberType;


                        // =====================================================
                        // پیدا کردن Input عددی
                        // =====================================================

                        const numberInput =
                            selectedField.querySelector(
                                ".number-only"
                            );


                        if (!numberInput) {

                            console.error(
                                "Input با کلاس number-only پیدا نشد.",
                                selectedField
                            );

                            return;
                        }


                        // =====================================================
                        // تنظیمات عدد ساده
                        // =====================================================

                        if (numberType === "simple") {

                            // -------------------------------------------------
                            // پیدا کردن Input
                            // -------------------------------------------------

                            const numberInput =
                                selectedField.querySelector(
                                    "input.number-only"
                                );

                            if (!numberInput) {
                                return;
                            }


                            // -------------------------------------------------
                            // جداکننده هزارگان
                            // -------------------------------------------------

                            const separatorCheckbox =
                                document.getElementById(
                                    "settingNumberSeparator"
                                );

                            const useSeparator =
                                separatorCheckbox
                                    ? separatorCheckbox.checked
                                    : false;


                            // -------------------------------------------------
                            // تعداد رقم اعشار
                            // -------------------------------------------------

                            const selectedDecimalPlaces =
                                document.querySelector(
                                    'input[name="numberDecimalPlaces"]:checked'
                                );

                            const decimalPlaces =
                                selectedDecimalPlaces
                                    ? selectedDecimalPlaces.value
                                    : "0";


                            // -------------------------------------------------
                            // حداکثر تعداد کاراکتر
                            // -------------------------------------------------

                            const maxLengthInput =
                                document.getElementById(
                                    "settingNumberMaxLength"
                                );

                            const maxLength =
                                maxLengthInput
                                    ? parseInt(maxLengthInput.value)
                                    : 0;


                            // -------------------------------------------------
                            // ذخیره تنظیمات روی Field
                            // -------------------------------------------------

                            selectedField.dataset.thousandSeparator =
                                useSeparator ? "true" : "false";

                            selectedField.dataset.decimalPlaces =
                                decimalPlaces;


                            if (maxLength > 0) {

                                selectedField.dataset.maxLength =
                                    maxLength;

                            } else {

                                delete selectedField.dataset.maxLength;

