                input.value;


            // =====================================================
            // حذف جداکننده قبلی
            // =====================================================

            value =
                value.replace(/,/g, "");


            // =====================================================
            // فقط عدد و نقطه
            // =====================================================

            value =
                value.replace(/[^0-9.]/g, "");


            // =====================================================
            // فقط یک نقطه اعشار
            // =====================================================

            const firstDot =
                value.indexOf(".");


            if (firstDot !== -1) {

                value =
                    value.substring(0, firstDot + 1) +
                    value
                        .substring(firstDot + 1)
                        .replace(/\./g, "");

            }


            // =====================================================
            // جدا کردن قسمت صحیح و اعشار
            // =====================================================

            let parts =
                value.split(".");


            let integerPart =
                parts[0] || "";

            let decimalPart =
                parts[1] || "";


            // =====================================================
            // محدودیت تعداد رقم واقعی
            // =====================================================

            if (maxLength > 0) {

                const integerLength =
                    integerPart.length;


                const remaining =
                    maxLength - integerLength;


                if (remaining <= 0) {

                    decimalPart = "";

                }
                else if (decimalPart.length > remaining) {

                    decimalPart =
                        decimalPart.substring(
                            0,
                            remaining
                        );

                }

            }


            // =====================================================
            // محدودیت تعداد اعشار
            // =====================================================

            if (decimalPlaces === 0) {

                decimalPart = "";

            }
            else {

                decimalPart =
                    decimalPart.substring(
                        0,
                        decimalPlaces
                    );

            }


            // =====================================================
            // ساخت مجدد مقدار
            // =====================================================

            value =
                integerPart;


            if (
                decimalPlaces > 0 &&
                (
                    parts.length > 1 ||
                    decimalPart.length > 0
                )
            ) {

                value +=
                    "." + decimalPart;

            }


            // =====================================================
            // اعمال جداکننده هزارگان
            // =====================================================

            if (
                useSeparator &&
                integerPart !== ""
            ) {

                integerPart =
                    Number(integerPart)
                        .toLocaleString("en-US");


                value =
                    integerPart;


                if (
                    decimalPlaces > 0 &&
                    (
                        parts.length > 1 ||
                        decimalPart.length > 0
                    )
                ) {

                    value +=
                        "." + decimalPart;

                }

            }


            // =====================================================
            // قرار دادن مقدار نهایی
            // =====================================================

            input.value =
                value;
        }


        // =====================================================
        // کد ملی
        // =====================================================

        function handleNationalCode(input) {

            let value =
                input.value;


            // فقط عدد
            value =
                value.replace(/\D/g, "");


            // حداکثر 10 رقم
            value =
                value.substring(0, 10);


            // رقم اول باید 0 باشد
            if (value.length > 0 && value[0] !== "0") {

                value =
                    "0" + value;

            }


            // دوباره حداکثر 10 رقم
            value =
                value.substring(0, 10);


            input.value =
                value;
        }


        // =====================================================
        // شماره همراه
        // =====================================================

        function handleMobileNumber(input) {

            let value =
                input.value;


            // فقط عدد
            value =
                value.replace(/\D/g, "");


            // اگر چیزی وارد شده، باید با 09 شروع شود
            if (value.length > 0 && value[0] !== "0") {

                value =
                    "0" + value;

            }


            if (
                value.length >= 2 &&
                value.substring(0, 2) !== "09"
            ) {

                value =
                    "09" +
                    value.substring(2);

            }


            // حداکثر 11 رقم
            value =
                value.substring(0, 11);


            input.value =
                value;
        }


        // =====================================================
        // شماره ثابت
        // =====================================================

        function handleLandlineNumber(input) {

            let value =
                input.value;


            // فقط عدد
            value =
                value.replace(/\D/g, "");


            // باید با 0 شروع شود
            if (
                value.length > 0 &&
                value[0] !== "0"
            ) {

                value =
                    "0" + value;

            }


            // حداکثر 11 رقم
            value =
                value.substring(0, 11);


            input.value =
                value;
        }
        //ایمیل
        document.addEventListener("input", function (e) {

            if (!e.target.classList.contains("email-field")) {
                return;
            }

            let value = e.target.value;

            const atSymbol = String.fromCharCode(64);

            // فقط کاراکترهای مجاز
            value = value.replace(/[^a-zA-Z0-9\x40._-]/g, "");

            // فقط یک
            const firstAt = value.indexOf(atSymbol);

            if (firstAt !== -1) {

                const beforeAt = value.substring(0, firstAt);

                const afterAt = value
                    .substring(firstAt + 1)
                    .replace(new RegExp(atSymbol, "g"), "");

                value = beforeAt + atSymbol + afterAt;
            }

            // حداکثر 100 کاراکتر
            value = value.substring(0, 100);

            e.target.value = value;
        });

