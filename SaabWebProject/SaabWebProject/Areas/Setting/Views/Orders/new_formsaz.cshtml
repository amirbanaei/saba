        // =====================================================
        // ساخت JSON کامل فرم
        // =====================================================

        function generateFormJSON() {

            const formContainer =
                document.getElementById("FormContainer");

            if (!formContainer) {

                console.error("FormContainer پیدا نشد.");

                return null;
            }


            const formData = {
                fields: []
            };


            // =====================================================
            // پیدا کردن تمام Field ها
            // =====================================================

            const fields =
                formContainer.querySelectorAll(
                    ".field-item[data-field-type]"
                );


            fields.forEach(function (field, fieldIndex) {

                const type =
                    field.dataset.fieldType || "";


                // =================================================
                // عرض Field
                // =================================================

                const widthClass =
                    Array.from(field.classList)
                        .find(function (className) {

                            return className.startsWith("col-xl-");

                        });


                const width =
                    widthClass
                        ? parseInt(widthClass.replace("col-xl-", ""))
                        : null;


                // =================================================
                // عنوان
                // =================================================

                const label =
                    field.querySelector(".form-label");


                const title =
                    label
                        ? label.textContent.trim()
                        : "";


                // =================================================
                // Id
                // =================================================

                const id =
                    field.id ||
                    field.dataset.fieldId ||
                    "";


                // =================================================
                // اجباری
                // =================================================

                const required =
                    field.dataset.required === "true";


                // =================================================
                // ساخت اطلاعات پایه Field
                // =================================================

                const fieldData = {

                    index: fieldIndex,

                    type: type,

                    id: id,

                    title: title,

                    width: width,

                    required: required,

                    settings: {},

                    value: null

                };


                // =================================================
                // TEXT
                // =================================================

                if (type === "text") {

                    const input =
                        field.querySelector(
                            "input.form-control"
                        );


                    fieldData.settings.maxLength =
                        field.dataset.maxLength || null;


                    fieldData.value =
                        input
                            ? input.value
                            : "";

                }


                // =================================================
                // NUMBER
                // =================================================

                else if (type === "number") {

                    const input =
                        field.querySelector(
                            "input.number-only"
                        );


                    fieldData.settings.numberType =
                        field.dataset.numberType || "simple";


                    fieldData.settings.thousandSeparator =
                        field.dataset.thousandSeparator === "true";


                    fieldData.settings.decimalPlaces =
                        parseInt(
                            field.dataset.decimalPlaces || "0"
                        );


                    fieldData.settings.maxLength =
                        field.dataset.maxLength || null;


                    fieldData.value =
                        input
                            ? input.value
                            : "";

                }


                // =================================================
                // SELECT
                // =================================================

                else if (type === "select") {

                    const select =
                        field.querySelector("select");


                    fieldData.value =
                        select
                            ? select.value
                            : "";


                    fieldData.settings.options = [];


                    if (select) {

                        select
                            .querySelectorAll("option")
                            .forEach(function (option) {

                                fieldData.settings.options.push({

                                    value: option.value,

                                    text: option.textContent.trim(),

                                    selected: option.selected

                                });

                            });

                    }

                }


                // =================================================
                // TEXTAREA
                // =================================================

                else if (type === "textarea") {

                    const textarea =
                        field.querySelector("textarea");


                    fieldData.value =
                        textarea
                            ? textarea.value
                            : "";

                }


                // =================================================
                // CHECKBOX
                // =================================================

                else if (type === "checkbox") {

                    const checkbox =
                        field.querySelector(
                            'input[type="checkbox"]'
                        );


                    fieldData.value =
                        checkbox
                            ? checkbox.checked
                            : false;

                }


                // =================================================
                // RADIO
                // =================================================

                else if (type === "radio") {

                    const radio =
                        field.querySelector(
                            'input[type="radio"]'
                        );


                    fieldData.settings.name =
                        radio
                            ? radio.name
                            : "";


                    fieldData.value = null;


                    const checked =
                        field.querySelector(
                            'input[type="radio"]:checked'
                        );


                    if (checked) {

                        fieldData.value =
                            checked.value;

                    }

                }


                // =================================================
                // IMAGE PART
                // =================================================

                else if (type === "image-part") {

                    fieldData.settings.row =
                        field.dataset.imageRow || null;


                    fieldData.settings.column =
                        field.dataset.imageColumn || null;


                    fieldData.settings.part =
                        field.dataset.imagePart || null;


                    fieldData.settings.total =
                        field.dataset.imageTotal || null;


                    fieldData.settings.group =
                        field.dataset.imageGroup || null;


                    const image =
                        field.querySelector(
                            ".image-part img"
                        );


                    fieldData.value =
                        image
                            ? image.src
                            : null;

                }


                // =================================================
                // TABLE
                // =================================================

                else if (type === "table") {

                    fieldData.settings.columns =
                        parseInt(
                            field.dataset.tableColumns || "0"
                        );


                    fieldData.settings.rows =
                        parseInt(
                            field.dataset.tableRows || "0"
                        );


                    try {

                        fieldData.settings.columnTitles =
                            JSON.parse(
                                field.dataset.tableColumnTitles || "[]"
                            );

                    } catch (e) {

                        fieldData.settings.columnTitles = [];

                    }


                    try {

                        fieldData.settings.columnWidths =
                            JSON.parse(
                                field.dataset.tableColumnWidths || "[]"
                            );

                    } catch (e) {

                        fieldData.settings.columnWidths = [];

                    }


                    try {

                        fieldData.settings.rowTitles =
                            JSON.parse(
                                field.dataset.tableRowTitles || "[]"
                            );

                    } catch (e) {

                        fieldData.settings.rowTitles = [];

                    }


                    // ---------------------------------------------
                    // مقادیر سلول‌ها
                    // ---------------------------------------------

                    fieldData.value = [];


                    field
                        .querySelectorAll(
                            "tbody tr"
                        )
                        .forEach(function (row, rowIndex) {

                            const rowData = [];


                            row
                                .querySelectorAll(
                                    "td.table-value-cell"
                                )
                                .forEach(function (cell) {

                                    rowData.push(
                                        cell.textContent
                                    );

                                });


                            fieldData.value.push(
                                rowData
                            );

                        });

                }


                // =================================================
                // TABLE INSERT
                // =================================================

                else if (type === "table-insert") {

                    fieldData.settings.columns =
                        parseInt(
                            field.dataset.tableColumns || "0"
                        );


                    try {

                        fieldData.settings.columnTitles =
                            JSON.parse(
                                field.dataset.tableColumnTitles || "[]"
                            );

                    } catch (e) {

                        fieldData.settings.columnTitles = [];

                    }


                    try {

                        fieldData.settings.columnWidths =
                            JSON.parse(
                                field.dataset.tableColumnWidths || "[]"
                            );

                    } catch (e) {

                        fieldData.settings.columnWidths = [];

                    }


                    // ---------------------------------------------
                    // ردیف‌های جدول Insert
                    // ---------------------------------------------

                    fieldData.value = [];


                    field
                        .querySelectorAll(
                            "tbody tr"
                        )
                        .forEach(function (row, rowIndex) {

                            const rowData = [];


                            row
                                .querySelectorAll(
                                    "td.table-value-cell"
                                )
                                .forEach(function (cell) {

                                    rowData.push(
                                        cell.textContent
                                    );

                                });


                            fieldData.value.push(
                                rowData
                            );

                        });

                }


                // =================================================
                // ذخیره Field
                // =================================================

                formData.fields.push(
                    fieldData
                );

            });


            return formData;
        }
        document
            .getElementById("btnTestJSON")
            .addEventListener("click", function () {

                const json =
                    generateFormJSON();


                console.log(
