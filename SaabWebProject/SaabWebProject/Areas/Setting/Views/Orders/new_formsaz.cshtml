        function handleSimpleNumber(input, field) {

            const useSeparator =
                field.dataset.thousandSeparator === "true";

            const decimalPlaces =
                parseInt(
                    field.dataset.decimalPlaces || "0"
                );

            const maxLength =
                parseInt(
