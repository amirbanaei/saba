                        box-shadow: inset 0 0 .8rem rgba(0,255,255,.08), 0 0 1rem rgba(0,255,255,.06);
                    }


                .image-upload-input {
                    position: absolute;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    opacity: 0;
                    cursor: pointer;
                    z-index: 2;
                }


                .image-upload-placeholder {
                    width: 100%;
                    height: 100%;
                    display: flex;
                    flex-direction: row;
                    align-items: center;
                    justify-content: center;
                    gap: .7rem;
                    padding: .7rem;
                    pointer-events: none;
                    transition: .3s ease;
                }


                .image-upload-icon {
                    width: 2.5rem;
                    height: 2.5rem;
                    min-width: 2.5rem;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: .55rem;
                    color: aqua;
                    background: linear-gradient( 135deg, rgba(0,255,255,.12), rgba(255,255,255,.025) );
                    border: 1px solid rgba(0,255,255,.35);
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), inset 0 0 .6rem rgba(0,255,255,.05);
                }


                    .image-upload-icon i {
                        font-size: 1.2rem;
                    }


                .image-upload-text {
                    display: flex;
                    flex-direction: column;
                    gap: .15rem;
                }


                .image-upload-title {
                    font-size: .75rem;
                    font-weight: bold;
                    color: white;
                }


                .image-upload-subtitle {
                    font-size: .55rem;
                    color: rgba(255,255,255,.50);
                }


                /* =========================================================
                          IMAGE PREVIEW
                          ========================================================= */

                .image-preview {
                    position: absolute;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    display: none;
                    overflow: hidden;
                    background: rgba(0,0,0,.25);
                    backdrop-filter: blur(4px);
                    z-index: 6;
                }


                    .image-preview img {
                        width: 100%;
                        height: 100%;
                        display: block;
                        object-fit: cover;
                        object-position: center;
                        transition: .3s ease;
                    }


                    .image-preview::after {
                        content: "";
                        position: absolute;
                        inset: 0;
                        background: linear-gradient( to bottom, rgba(0,0,0,.25), transparent 35%, transparent 65%, rgba(0,0,0,.35) );
                        pointer-events: none;
                    }


                /* =========================================================
                          IMAGE REMOVE BUTTON
                          ========================================================= */

                .image-remove-btn {
