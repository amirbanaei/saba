<!-- ✅ جدول سوالات -->
<div class="card">
    <div class="table-responsive tableH_Lock">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive">
                <table class="table table-bordered text-center responsive-table">
                    <thead class="thead-dark">
                        <tr>
                            <th>سوال</th>
                            <th>گزینه‌ها</th>
                            <th>شرح</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.SoalList != null)
                        {
                            foreach (var item in Model.SoalList)
                            {
                                <tr>
                                    <td>
                                        @{
                                            var text = item.SoalText ?? "";
                                            int chunkSize = 17;
                                            var words = text.Split(' ');
                                            var line = "";

                                            foreach (var word in words)
                                            {
                                                if ((line + word).Length > chunkSize)
                                                {
                                                    <span>@line</span><br />
                                                    line = "";
                                                }

                                                line += (line == "" ? "" : " ") + word;
                                            }

                                            if (!string.IsNullOrEmpty(line))
                                            {
                                                <span>@line</span><br />
                                            }
                                        }
                                    </td>
                                    <td style="width:250px">
                                        @foreach (var goz in item.GozinehList)
                                        {
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="checkbox"
                                                       
                                                       @(goz.Selected ? "checked=\"checked\"" : "") disabled />

                                                <label class="form-check-label" for="gozineh_@goz.GozinehId">
                                                    @goz.GozinehText
                                                </label>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var text2 = item.SharhSoal ?? "";
                                            int chunkSize2 = 17;
                                            var words2 = text2.Split(' ');
                                            var line2 = "";

                                            foreach (var word in words2)
                                            {
                                                if ((line2 + word).Length > chunkSize2)
                                                {
                                                    <span>@line2</span><br />
                                                    line2 = "";
                                                }

                                                line2 += (line == "" ? "" : " ") + word;
                                            }

                                            if (!string.IsNullOrEmpty(line))
                                            {
                                                <span>@line2</span><br />
                                            }
                                        }
                                        @*<textarea name="sharh_@item.SoalId"
                                                  class="form-control"
                                                  rows="2"
                                                  style="resize: vertical; min-height: 60px;"
                                                  placeholder="توضیح..." disabled>@item.SharhSoal</textarea>*@
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

