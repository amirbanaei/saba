@model SaabWebProject.Models.ViewModels.Contracts.Function.FunctionModel
@using SaabWebProject.Models.DomainModels;


@{
    Layout = null;

    // محاسبه آمار سوال‌ها
    int totalQuestions2 = 0;
    int answeredQuestions2 = 0;

    if (Model?.SoalList != null)
    {
        totalQuestions2 = Model.SoalList.Count;
        foreach (var soal in Model.SoalList)
        {
            if (soal.GozinehList.Any(g => g.Selected))
            {
                answeredQuestions2++;
            }
        }
    }

    int unansweredQuestions2 = totalQuestions2 - answeredQuestions2;
}
