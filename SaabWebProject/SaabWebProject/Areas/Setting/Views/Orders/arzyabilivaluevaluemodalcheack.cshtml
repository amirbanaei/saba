<script>
    function updateStats() {
        const allQuestions = new Set();
        const answeredQuestions = new Set();

        $('input[type="radio"]').each(function () {
            const soalId = $(this).attr('name').replace("gozineh_", "");
            allQuestions.add(soalId);
            if ($(this).is(':checked')) {
                answeredQuestions.add(soalId);
            }
        });

        const total = allQuestions.size;
        const answered = answeredQuestions.size;
        const unanswered = total - answered;

        $('#totalQuestions').text(total);
        $('#answeredQuestions').text(answered);
        $('#unansweredQuestions').text(unanswered);
    }

    $(document).ready(function () {
        $('input[type="radio"]').on('change', function () {
            updateStats();
        });

        // اجرای اولیه آمار
        updateStats();
    });
    $(document).ready(function () {
        let lastChecked = {};

        $('input[type="radio"]').on('mousedown', function (e) {
            let name = $(this).attr('name');

            if (lastChecked[name] === this) {
                $(this).prop('checked', false);
                lastChecked[name] = null;
                e.preventDefault(); // جلوگیری از انتخاب دوباره
            } else {
                lastChecked[name] = this;
            }
        });
    });

</script>