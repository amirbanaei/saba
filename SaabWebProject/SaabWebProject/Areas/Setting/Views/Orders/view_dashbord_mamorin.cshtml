    <script>
    // ساخت آرایه‌ها بر اساس مدل Users
    var under25 = [];
    var between25_50 = [];
    var between50_75 = [];
    var between75_100 = [];
    var over100 = [];
    var total = [];

    @* حلقه روی Users از بک‌اند *@
    @foreach(var user in Model.Users)
    {
        <text>
            under25.push(@user.Values["Under25"]);
            between25_50.push(@user.Values["25_50"]);
            between50_75.push(@user.Values["50_75"]);
            between75_100.push(@user.Values["75_100"]);
            over100.push(@user.Values["Over100"]);
            total.push(@user.Values["Total"]);
        </text>
    }

    var options = {
        series: [{
            name: 'زیر ۲۵ درصد',
            type: 'column',
            data: under25
        }, {
            name: '25 تا 50 درصد',
            type: 'column',
            data: between25_50
        }, {
            name: '50تا 75 درصد',
            type: 'column',
            data: between50_75
        }, {
            name: '75 تا 100 درصد',
            type: 'column',
            data: between75_100
        }, {
            name: 'بالای ۱۰۰ درصد',
            type: 'column',
            data: over100
        }, {
            name: 'تعداد مامور',
            type: 'line',
            data: total
        }],
        chart: {
            height: 350,
            type: 'line',
            stacked: true,
            toolbar: { show: false },
            fontFamily: 'inherit',
            zoom: { enabled: false }
        },
        colors: ['#e63946', '#f4a261', '#e9c46a', '#2a9d8f', '#4caf50', '#601CE8'],
        stroke: {
            width: [0,0,0,0,0,0],
            curve: 'smooth'
        },
        markers: { size: 4, shape: "square", strokeColors: '#fff', strokeWidth:1, hover:{size:7} },
        plotOptions: { bar:{ horizontal:false, columnWidth:'55%', borderRadius:8, borderRadiusApplication:'end', borderRadiusWhenStacked:'last' } },
        dataLabels: { enabled:true, formatter: function(val){return val;}, hideOverflowingText:false, style:{ fontSize:'11px', fontFamily:'inherit', colors:['#fff'] }, background:{enabled:false}, dropShadow:{enabled:true, top:1, left:1, blur:1, color:'#000', opacity:0.45}, enabledOnSeries:[0,1,2,3,4] },
        grid:{ borderColor:'#1b7a7a66', strokeDashArray:3, xaxis:{lines:{show:false}}, yaxis:{lines:{show:true}} },
        yaxis: {
            show: true,
            min: 0,
            max: 100,
            tickAmount: 5,
            labels: {
                formatter: function (val) {
                    return val + "%";
                },
                style: { colors: '#fff' }
            }
        },        xaxis:{ categories: ['کارشناس ستادی', 'انبار داری', 'نماینده مقیم', 'ارزیاب', 'پلیس برق', 'نصب و اصلاح', 'متصدی مشترکین', 'وصول', 'قرائت'], labels:{ offsetY:0, style:{ colors:'#fff' } }, axisTicks:{show:false} },
        legend:{ position:'top', labels:{ colors:'#fff' } },
        tooltip:{ theme:'dark' },
        responsive:[{
            breakpoint:768,
            options:{
                chart:{ height:400 },
                plotOptions:{ bar:{ horizontal:false, columnWidth:'55%', borderRadius:2, borderRadiusApplication:'end', borderRadiusWhenStacked:'last' } },
                xaxis:{ labels:{ rotate:90, rotateAlways:true, minHeight:100, style:{ colors:'#fff', fontSize:'8px', fontFamily:'inherit' } }, axisTicks:{ show:false } },
                yaxis:{ labels:{ offsetX:-10, style:{ colors:'#fff', fontSize:'8px' } } },
                dataLabels:{ enabled:true, formatter:function(val){return val;}, hideOverflowingText:false, style:{ fontSize:'8px', fontFamily:'inherit', colors:['#fff'] }, background:{enabled:false}, dropShadow:{enabled:true, top:1, left:1, blur:1, color:'#000', opacity:0.45}, enabledOnSeries:[0,1,2,3,4] },
                legend:{ show:false, position:'bottom', fontSize:'12px' }
            }
        }]
    };

    var chart = new ApexCharts(document.querySelector("#chart1"), options);
    chart.render();
    </script>
