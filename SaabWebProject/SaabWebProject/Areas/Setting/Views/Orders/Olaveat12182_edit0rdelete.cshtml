<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Assets/plugins/BootstrapPersianDateTimePicker/dist/jquery.md.bootstrap.datetimepicker.js"></script>

<script>
    let rowIndex = @rowIndex;

    function initPicker($scope) {
        $scope.find(".peyman-search, .peyman-search3").each(function () {
            if (!$(this).data("picker-initialized")) {
                $(this).picker({ search: true });
                $(this).data("picker-initialized", true);
            }
        });
    }

    function reIndexIfRows() {
        $("#ifRowsContainer .if-row").each(function (i) {
            let idx = i + 1;
            $(this).find(".small").eq(0).text("منطق " + idx);
            $(this).find(".small").eq(1).text("فیلد شرط " + idx);
            $(this).find(".small").eq(2).text("نام ستون " + idx);
            $(this).find(".small").eq(3).text("علامت " + idx);
            $(this).find(".small").eq(4).text("مقدار " + idx);
        });
    }

    function addIfRow() {
        let ifIndex = $("#ifRowsContainer .if-row").length + 1;

        let ifHtml = `
        <div class="if-row mb-2 border-bottom pb-2">
            <div class="row">
                <div class="col-xl-2">
                    <label class="small">منطق ${ifIndex}</label>
                    <select class="form-select sel-if-logic">
                        <option value="AND">AND</option>
                        <option value="OR">OR</option>
                        <option value="AND NOT">AND NOT</option>
                        <option value="OR NOT">OR NOT</option>
                    </select>
                </div>

                <div class="col-xl-3">
                    <label class="small">فیلد شرط ${ifIndex}</label>
                    <select class="form-select sel-if-gozaresh">
                        <option value="">انتخاب...</option>
                        @foreach (var item in db.dbergharel_4_4.ToList())
                        {
                            <option value="@item.ID">@item.name</option>
                        }
                    </select>
                </div>

                <div class="col-xl-3">
                    <label class="small">نام ستون ${ifIndex}</label>
                    <select class="form-select peyman-search3 sel-if-name">
                        <option value="">انتخاب...</option>
                        @foreach (var item in db.dbergharel4_5.ToList())
                        {
                            <option value="@item.FK_dbergharel2">@item.dbergha2.name ✅</option>
                        }
                    </select>
                </div>

                <div class="col-xl-2">
                    <label class="small">علامت ${ifIndex}</label>
                    <select class="form-select sel-if-alamat">
                        <option value="1">=</option>
                        <option value="2">!=</option>
                        <option value="3">&gt;</option>
                        <option value="4">&lt;</option>
                        <option value="5">&gt;=</option>
                        <option value="6">&lt;=</option>
                    </select>
                </div>

                <div class="col-xl-1">
                    <label class="small">مقدار ${ifIndex}</label>
                    <input type="text" class="form-control sel-if-val" />
                </div>

                <div class="col-xl-1 pt-4">
                    <button type="button" class="btn btn-danger btn-sm removeIfRow">حذف</button>
                </div>
            </div>
        </div>`;

        let $newRow = $(ifHtml);
        $("#ifRowsContainer").append($newRow);
        initPicker($newRow);
        reIndexIfRows();
    }

    function addNewRow() {
        let hasLockedOperator = false;

        $("#rowsContainer .dynamic-row").each(function () {
            let vazeatVal = $(this).find(".select_peyman").val();
            if (vazeatVal === "6" || vazeatVal === "7" || vazeatVal === "8" || vazeatVal === "10" || vazeatVal === "5" || vazeatVal === "9") {
                hasLockedOperator = true;
                return false;
            }
        });

        if (hasLockedOperator) {
            alert("شما در این حالت نمی‌توانید ردیف جدیدی اضافه کنید!");
            return;
        }

        rowIndex++;

        let newRowHtml = `
        <div class="row dynamic-row mb-2" data-index="${rowIndex}">
            <div class="col-xl-3">
                <label class="form-label">عنوان فیلد</label>
                <select class="form-select select_peyman1" name="select_peyman${rowIndex}">
                    <option hidden value="Select">انتخاب مورد</option>
                    @foreach (var item in db.dbergharel_4_4.ToList())
                    {
                        <option value="@item.ID">@item.name</option>
                    }
                </select>
            </div>

            <div class="col-xl-3">
                <label class="form-label">نام ستون</label>
                <select class="form-select peyman-search" name="select_users${rowIndex}">
                    <option value="0">انتخاب کنید</option>
                    @foreach (var item in db.dbergharel4_5.ToList())
                    {
                        <option value="@item.FK_dbergharel2">@item.dbergha2.name ✅</option>
                    }
                </select>
            </div>

            <div class="col-xl-2">
                <label class="form-label">علامت</label>
                <select class="form-select select_peyman" name="SelectPeyman[${rowIndex}]">
                    <option hidden></option>
                    <option value="1">-</option>
                    <option value="2">+</option>
                    <option value="3">*</option>
                    <option value="4">/</option>
                    <option value="5">=</option>
                    <option value="6">B</option>
                    <option value="7">&gt;</option>
                    <option value="9">&lt;</option>
                    <option value="10">&lt;=</option>
                </select>
            </div>

            <div class="col-xl-2"></div>

            <div class="col-xl-1" style="margin-right: 35px;">
                <button type="button" class="btn form-control buttonsabt removeRow">
                    <i class="bi bi-x-circle fa-fw me-1 VecGeneral"></i>
                    <span class="bSabt-text">حذف</span>
                </button>
            </div>
        </div>`;

        let $newRow = $(newRowHtml);
        $("#rowsContainer").append($newRow);
        initPicker($newRow);
    }

    $(document).ready(function () {
        initPicker($(document));

        if ($("#rowsContainer .dynamic-row").length === 0) {
            addNewRow();
        }

        if ($("#useIfCondition").val() === "1") {
            $("#ifRowsContainer").show();
            $("#addIfRowBtn").show();

            setTimeout(function () {
                initPicker($("#ifRowsContainer"));
            }, 100);
        } else {
            $("#ifRowsContainer").hide();
            $("#addIfRowBtn").hide();
        }
    });

    $("#addRowBtn").on("click", function () {
        addNewRow();
    });

    $("#addIfRowBtn").on("click", function () {
        addIfRow();
    });

    $(document).on("click", ".removeRow", function () {
        $(this).closest(".dynamic-row").remove();
    });

    $(document).on("click", ".removeIfRow", function () {
        $(this).closest(".if-row").remove();
        reIndexIfRows();
    });

    $("#useIfCondition").on("change", function () {
        if ($(this).val() === "1") {
            $("#ifRowsContainer, #addIfRowBtn").slideDown(function () {
                initPicker($("#ifRowsContainer"));
            });

            if ($("#ifRowsContainer .if-row").length === 0) {
                addIfRow();
            }
        } else {
            $("#ifRowsContainer, #addIfRowBtn").slideUp();
        }
    });

    $(document).on("change", ".select_peyman", function () {
        let $changedRow = $(this).closest(".dynamic-row");
        let val = $(this).val();

        if (val === "6" || val === "7" || val === "8" || val === "10" || val === "5" || val === "9") {
            $changedRow.nextAll(".dynamic-row").remove();
            alert("شما در این حالت نمی‌توانید ردیف جدیدی اضافه کنید!");
        }
    });

    $("#finalSummaryBtn").on("click", function () {
        let rows = $("#rowsContainer .dynamic-row");

        if (rows.length === 0) {
            $("#finalSummaryContainer").hide();
            alert("هیچ ردیفی برای جمع بندی وجود ندارد!");
            return;
        }

        let hasVazeat6 = false;
        rows.each(function () {
            if ($(this).find(".select_peyman").val() === "6") {
                hasVazeat6 = true;
                return false;
            }
        });

        $("#finalSummaryContainer").empty();

        let summaryRow = '<div class="row mb-2">';
        if (hasVazeat6) {
            summaryRow += `
                <div class="col-xl-3">
                    <label class="form-label">از این</label>
                    <input id="field1" type="text" class="form-control" placeholder="مقدار اول">
                </div>
                <div class="col-xl-3">
                    <label class="form-label">تا این</label>
                    <input id="field2" type="text" class="form-control" placeholder="مقدار دوم">
                </div>
            `;
        } else {
            summaryRow += `
                <div class="col-xl-3">
                    <label class="form-label">مساوی</label>
                    <input id="field3" type="text" class="form-control" placeholder="مقدار">
                </div>
            `;
        }
        summaryRow += '</div>';

        $("#finalSummaryContainer").append(summaryRow).slideDown(400);
    });

    $("#sabt-tab1").on("click", function () {
        let rowsData = [];

        $("#rowsContainer .dynamic-row").each(function () {
            rowsData.push({
                FK_gozaresh1: $(this).find(".select_peyman1").val(),
                FK_name: $(this).find(".peyman-search").val(),
                alamat: $(this).find(".select_peyman").val()
            });
        });

        let ifRowsData = [];
        if ($("#useIfCondition").val() === "1") {
            $("#ifRowsContainer .if-row").each(function () {
                ifRowsData.push({
                    logic_if: $(this).find(".sel-if-logic").val(),
                    FK_gozaresh_if: $(this).find(".sel-if-gozaresh").val(),
                    FK_name_if: $(this).find(".sel-if-name").val(),
                    alamat_if: $(this).find(".sel-if-alamat").val(),
                    shart_value: $(this).find(".sel-if-val").val()
                });
            });
        }

        let finalData = {
            UserId: @modell.ID,
            Rows: rowsData,
            IfRows: ifRowsData,
            UseIfCondition: $("#useIfCondition").val(),
            Val1: $("#field1").val(),
            Val2: $("#field2").val(),
            Val3: $("#field3").val()
        };

        $.ajax({
            url: "/Setting/Orders/SaveOlaviat1218Calc",
            type: "POST",
            data: JSON.stringify(finalData),
            contentType: "application/json",
            success: function (res) {
                alert("ثبت با موفقیت انجام شد");
            },
            error: function () {
                alert("خطا در ثبت اطلاعات");
            }
        });
    });
</script>
