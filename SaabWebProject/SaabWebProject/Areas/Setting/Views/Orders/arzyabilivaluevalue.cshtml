    <!-- ✅ جدول سوالات -->
    <div class="card">
        <div class="table-responsive tableH_Lock">
            <div class="tab-pane fade show active" id="allTab">
                <div class="table-responsive">
                    <table class="table table-bordered text-center responsive-table">
                        <thead class="thead-dark">
                            <tr>
                                <th>سوال</th>
                                <th>گزینه‌ها</th>
                                <th>شرح</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.SoalList != null)
                            {
                                foreach (var item in Model.SoalList)
                                {
                                    <tr>
                                        <td>
                                            @{
                                                var text = item.SoalText ?? "";
                                                int chunkSize = 17;
                                                var words = text.Split(' ');
                                                var line = "";

                                                foreach (var word in words)
                                                {
                                                    if ((line + word).Length > chunkSize)
                                                    {
                                                        <span>@line</span><br />
                                                        line = "";
                                                    }

                                                    line += (line == "" ? "" : " ") + word;
                                                }

                                                if (!string.IsNullOrEmpty(line))
                                                {
                                                    <span>@line</span><br />
                                                }
                                            }
                                        </td>
                                        <td style="width:250px">
                                            @foreach (var goz in item.GozinehList)
                                            {
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio"
                                                           id="gozineh_@goz.GozinehId"
                                                           name="gozineh_@item.SoalId"
                                                           value="@goz.GozinehId"
                                                           @(goz.Selected ? "checked" : "") />

                                                    <label class="form-check-label" for="gozineh_@goz.GozinehId">
                                                        @goz.GozinehText
                                                    </label>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <label class="d-md-none font-weight-bold">شرح:</label>
                                            <textarea name="sharh_@item.SoalId"
                                                      class="form-control"
                                                      rows="2"
                                                      style="resize: vertical; min-height: 60px;"
                                                      placeholder="توضیح...">@item.SharhSoal</textarea>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
