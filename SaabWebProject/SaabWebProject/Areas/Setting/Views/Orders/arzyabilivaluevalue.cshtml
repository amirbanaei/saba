            display: none;
        }

        .responsive-table td textarea {
            width: 100% !important;
            margin-top: 8px;
            text-align: center;
        }

        .form-check-inline {
            display: inline-block !important;
            width: 32%;
            margin: 4px 1%;
            text-align: center;
        }

        .form-check-label {
            text-align: center;
            display: inline-block;
            width: auto;
        }

        .d-md-none {
            text-align: center;
            display: block;
        }
    }

    .form-check-input[type="radio"] {
        border-radius: 25px !important;
        height: 14px !important;
        width: 14px !important;
        vertical-align: middle;
    }

    .table td,
    .table th {
        vertical-align: middle;
        text-align: center;
    }

    .form-check-inline {
        text-align: center;
        margin: 5px;
    }

    .question-stats {
        text-align: center;
        margin: 20px 0;
        font-size: 1.1rem;
    }

    .tableH_Lock {
        max-height: 450px;
    }
</style>
