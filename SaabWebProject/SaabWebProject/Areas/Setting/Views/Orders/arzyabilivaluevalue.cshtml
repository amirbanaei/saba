            function sendData() {
                document.getElementById("loading-circle").style.display = "block";

                const dataToSend = [];

                // پیدا کردن همه سوال‌ها از روی textarea ها
                const allSharhTextareas = document.querySelectorAll('textarea[name^="sharh_"]');

                allSharhTextareas.forEach(sharhElement => {
                    const soalId = sharhElement.name.replace("sharh_", "");
                    const sharhText = sharhElement.value.trim();

                    // بررسی اینکه آیا گزینه‌ای انتخاب شده
                    const selectedRadio = document.querySelector(`input[name="gozineh_${soalId}"]:checked`);
                    const gozinehId = selectedRadio ? parseInt(selectedRadio.value) : null;

                    // اضافه کردن به لیست ارسال
                    dataToSend.push({
                        FK_usr: parseInt(FK_usr),
                        FK_doreh: parseInt(FK_doreh),
                        FK_soal: parseInt(soalId),
                        FK_gozeneh: gozinehId,
                        sharhsoal: sharhText
                    });
                });

                const payload = {
                    FK_usr: parseInt(FK_usr),
                    FK_doreh: parseInt(FK_doreh),
                    SabghehJob: sabghehJob,
                    PhonNumber: phonNumber,
                    Answers: dataToSend
                };

                fetch("/Setting/Orders/SaveUserDataAndAnswers", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: JSON.stringify(payload)
                })
                    .then(response => response.text())
                    .then(message => {
                        document.getElementById("loading-circle").style.display = "none";

                        Swal.fire({
                            icon: 'success',
                            title: 'موفق!',
                            text: message,
                            confirmButtonText: 'باشه'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload();
                            }
                        });
                    })
                    .catch(error => {
                        console.error("Error:", error);
                        Swal.fire({
                            icon: 'error',
                            title: 'خطا',
                            text: 'خطا در ثبت اطلاعات.',
                            confirmButtonText: 'باشه'
                        });
                    });
            }

        }
    </script>

    <script>
        function updateStats() {
            const allQuestions = new Set();
            const answeredQuestions = new Set();

            $('input[type="radio"]').each(function () {
                const soalId = $(this).attr('name').replace("gozineh_", "");
                allQuestions.add(soalId);
                if ($(this).is(':checked')) {
                    answeredQuestions.add(soalId);
                }
            });

            const total = allQuestions.size;
            const answered = answeredQuestions.size;
            const unanswered = total - answered;

            $('#totalQuestions').text(total);
            $('#answeredQuestions').text(answered);
            $('#unansweredQuestions').text(unanswered);
        }

        $(document).ready(function () {
            $('input[type="radio"]').on('change', function () {
                updateStats();
            });

            // اجرای اولیه آمار
            updateStats();
        });
        $(document).ready(function () {
            let lastChecked = {};

            $('input[type="radio"]').on('mousedown', function (e) {
                let name = $(this).attr('name');

                if (lastChecked[name] === this) {
                    $(this).prop('checked', false);
                    lastChecked[name] = null;
                    e.preventDefault(); // جلوگیری از انتخاب دوباره
                } else {
                    lastChecked[name] = this;
                }
            });
        });

    </script>
