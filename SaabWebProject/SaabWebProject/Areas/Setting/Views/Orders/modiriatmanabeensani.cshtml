    <script>
        jalaliDatepicker.startWatch({
            time: false,
            days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
            persianDigits: true,
            autoClose: true,
            autocomplete: true,
            showEmptyBtn: false,
            showCloseBtn: true,
            zIndex: 100000,
        });

        var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
        for (var i = 0; i < inputs.length; i++) {
            inputs[i].addEventListener("jdp:change", function (e) {
                var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                var date = this.value.replace(' ', '').slice(0, 10).split('/');
                date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]));
                if (!this.value) {
                    date = "";
                } else if (this.value.replace(' ', '').length < 11) {
                    date = date.gy + '-' + date.gm + '-' + date.gd;
                } else {
                    date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30);
                }
                miladiInput.value = date;
            });
        }

    </script>





    <script>
    $(document).ready(function () {

        // در شروع، مطمئن می‌شیم ناحیه‌ی نتیجه خالیه
        $("#resultArea").empty();

        // کلیک روی دکمه‌ی نمایش
        $("#Sendnamayesh").click(function (e) {
            e.preventDefault();

            var date = $("#miladi_date1").val();

            if (!date || date.trim() === "") {
                alert("لطفاً تاریخ را انتخاب کنید");
                return;
            }

            // نمایش وضعیت لودینگ
            $("#resultArea").html('<div style="text-align:center; padding:20px;">در حال بارگذاری...</div>');

            $.ajax({
                url: '@Url.Action("BargashEstedadNiroEnsaniByDate", "Orders")',
                type: 'GET',
                data: { date: date },
                success: function (response) {
                    $("#resultArea").html(response); // نمایش جدول برگردانده‌شده از اکشن
                },
                error: function (xhr, status, error) {
                    console.error("Ajax Error:", error);
                    $("#resultArea").html('<div style="color:red; text-align:center;">خطا در دریافت اطلاعات</div>');
                }
            });
        });

    });
    </script>





    @*جدیدا رو اینجا بزن*@






    <script>
        // ---------- helper: وضعیت یک ردیف را براساس رادیوی انتخاب‌شده تنظیم می‌کند ----------
        function updateRowState(row) {
            if (!row) return;
            const sharh = row.querySelector(".sharh-input");
            const saatShoroo = row.querySelector(".time-start");
            const saatKhateme = row.querySelector(".time-end");
            const saatVorood = row.querySelector(".time-entry");
            const saatKhorooj = row.querySelector(".time-exit");
            const selected = row.querySelector(".radioha:checked");
            const val = selected ? parseInt(selected.value, 10) : null;

            // ابتدا همه فیلدها را فعال کن
            [saatShoroo, saatKhateme, saatVorood, saatKhorooj].forEach(f => {
                if (f) { f.disabled = false; f.required = false; f.style.opacity = "1"; }
            });

            if (val === null) return;

            // اگر رادیو بین 1 تا 12 است
            if (val >= 1 && val <= 12) {
                // اگر فیلدها پر بودند، خالی‌شان کن
                [saatShoroo, saatKhateme, saatVorood, saatKhorooj].forEach(f => {
                    if (f && f.value.trim() !== "") {
                        f.value = "";
                    }
                });

                const r0 = row.querySelector(".radioha[value='0']");
                if (r0) { r0.checked = false; r0.dataset.wasChecked = "false"; }

                // غیر فعال کردن فیلدها
                [saatShoroo, saatKhateme, saatVorood, saatKhorooj].forEach(f => {
                    if (f) { f.disabled = true; f.required = false; f.style.opacity = "0.5"; }
                });
                return;
            }

            // اگر رادیو 13 انتخاب شد
            if (val === 13) {
                const r0 = row.querySelector(".radioha[value='0']");
                if (r0) {
                    r0.checked = true;
                    r0.dataset.wasChecked = "true";
                }

                if (saatShoroo) { saatShoroo.disabled = false; saatShoroo.required = true; saatShoroo.style.opacity = "1"; }
                if (saatKhateme) { saatKhateme.disabled = false; saatKhateme.required = true; saatKhateme.style.opacity = "1"; }
                if (saatVorood) { saatVorood.disabled = false; saatVorood.style.opacity = "1"; }
                if (saatKhorooj) { saatKhorooj.disabled = false; saatKhorooj.style.opacity = "1"; }
                return;
            }

            // اگر رادیو صفر انتخاب شد
            if (val === 0) {
                const sh = saatShoroo ? saatShoroo.value.trim() : "";
                const kh = saatKhateme ? saatKhateme.value.trim() : "";
                if (!sh && !kh) {
                    if (saatShoroo) { saatShoroo.disabled = true; saatShoroo.required = false; saatShoroo.style.opacity = "0.5"; }
                    if (saatKhateme) { saatKhateme.disabled = true; saatKhateme.required = false; saatKhateme.style.opacity = "0.5"; }
                    if (saatVorood) { saatVorood.disabled = false; saatVorood.required = false; saatVorood.style.opacity = "1"; }
                    if (saatKhorooj) { saatKhorooj.disabled = false; saatKhorooj.required = false; saatKhorooj.style.opacity = "1"; }
                } else if (sh && kh) {
                    if (saatVorood) { saatVorood.disabled = false; saatVorood.required = true; saatVorood.style.opacity = "1"; }
                    if (saatKhorooj) { saatKhorooj.disabled = false; saatKhorooj.required = true; saatKhorooj.style.opacity = "1"; }
                    if (saatShoroo) { saatShoroo.disabled = false; saatShoroo.required = true; saatShoroo.style.opacity = "1"; }
                    if (saatKhateme) { saatKhateme.disabled = false; saatKhateme.required = true; saatKhateme.style.opacity = "1"; }
                }
                return;
            }
        }

        // ---------- init ----------
        function initAttendancePartial() {
            document.querySelectorAll("tbody tr").forEach(row => {
                row.querySelectorAll(".hazer").forEach(r => r.dataset.wasChecked = (r.checked ? "true" : "false"));
                updateRowState(row);
                toggleSharhInput(row);
            });
        }

        // ---------- handlers ----------
        document.addEventListener("click", function (e) {
            if (!e.target.matches(".hazer")) return;
            const radio = e.target;
            const row = radio.closest("tr");
            if (radio.dataset.wasChecked === "true") {
                radio.checked = false;
                radio.dataset.wasChecked = "false";
                updateRowState(row);
            } else {
                row.querySelectorAll(".hazer").forEach(r => r.dataset.wasChecked = "false");
                radio.dataset.wasChecked = "true";
                updateRowState(row);
            }
            toggleSharhInput(row);
        });

        document.addEventListener("change", function (e) {
            if (!e.target.matches(".radioha")) return;
            const radio = e.target;
            const row = radio.closest("tr");
            if (radio.value && parseInt(radio.value, 10) >= 1 && parseInt(radio.value, 10) <= 9) {
                const r0 = row.querySelector(".radioha[value='0']");
                if (r0) { r0.checked = false; r0.dataset.wasChecked = "false"; }
            }
            updateRowState(row);
            toggleSharhInput(row);
        });

        document.addEventListener("DOMContentLoaded", function () {
            initAttendancePartial();
        });

        (function watchContainerForReplacements() {
            const container = document.getElementById("pills-tabContent");
            if (!container) return;
            const mo = new MutationObserver((mutations) => {
                for (const m of mutations) {
                    if (m.addedNodes && m.addedNodes.length) {
                        setTimeout(initAttendancePartial, 50);
                        break;
                    }
                }
            });
            mo.observe(container, { childList: true, subtree: true });
        })();

        // ---------- datepicker ----------
        jalaliDatepicker.startWatch({
            time: false,
            days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
            persianDigits: true,
            autoClose: true,
            autocomplete: true,
            showEmptyBtn: false,
            showCloseBtn: true,
            zIndex: 100000,
        });

        var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
        for (var i = 0; i < inputs.length; i++) {
            inputs[i].addEventListener("jdp:change", function (e) {
                var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                var date = this.value.replace(' ', '').slice(0, 10).split('/');
                date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]));
                if (!this.value) {
                    date = "";
                } else if (this.value.replace(' ', '').length < 11) {
                    date = date.gy + '-' + date.gm + '-' + date.gd;
                } else {
                    date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30);
                }
                miladiInput.value = date;
            });
        }

        // ---------- کنترل فیلد شرح ----------
        function toggleSharhInput(row) {
            if (!row) return;
            const sharh = row.querySelector('.sharh-input');
            if (!sharh) return;

            const checkedRadio = row.querySelector('.radioha:checked');

            if (checkedRadio && checkedRadio.value === '12') {
                // فعال در صورت انتخاب 12
                sharh.removeAttribute('disabled');
                sharh.style.opacity = "1";
                sharh.style.backgroundColor = '#ffffff';
            } else {
                // غیرفعال و خالی در سایر حالت‌ها
                if (sharh.value.trim() !== "") {
                    sharh.value = ""; // خالی کردن مقدار
                }
                sharh.setAttribute('disabled', 'disabled');
                sharh.style.opacity = "0.5";
                sharh.style.backgroundColor = '#e9ecef';
            }
        }

        // ---------- ارسال نهایی (در صورت نیاز اضافه می‌شود) ----------
    </script>





    <script>
$(document).on("click", "#Send", function (e) {
    e.preventDefault();

    const dateField = $("#miladi_date1").val()?.trim();
    if (!dateField) {
        alert("⚠️ لطفاً تاریخ را وارد کنید.");
        return;
    }

    const rows = $("tbody tr");
    const dataToSend = [];
    let isValid = true;

    rows.each(function () {
        const row = $(this);
        const userId = row.data("userid");
        const selectedRadio = row.find(".radioha:checked");
        const vaziat = selectedRadio.length ? parseInt(selectedRadio.val()) : null;

        const sharh = row.find('input.form-control[type="text"]').val()?.trim() || "";
        const saatShoro = row.find(".time-start").val()?.trim() || "";
        const saatKhateme = row.find(".time-end").val()?.trim() || "";
        const saatVorod = row.find(".time-entry").val()?.trim() || "";
        const saatKhorog = row.find(".time-exit").val()?.trim() || "";

        if (vaziat !== null) {
            if (vaziat === 13 && (!saatShoro || !saatKhateme || !saatVorod || !saatKhorog)) {
                alert(`لطفاً تمام ساعت‌های شروع، خاتمه، ورود و خروج را برای ${row.find("td:first").text()} وارد کنید.`);
                isValid = false;
                return false; // break loop
            }

            dataToSend.push({
                Fk_User: parseInt(userId),
                SaatShoro: saatShoro,
                SaatKhateme: saatKhateme,
                SaatVorod: saatVorod,
                SaatKhorog: saatKhorog,
                Vaziat: vaziat,
                TarikhSabt: dateField,
                Sharh: sharh
            });
        }
    });

    if (!isValid) return;
    if (dataToSend.length === 0) {
        alert("⚠️ هیچ ردیفی انتخاب نشده است!");
        return;
    }

    fetch("@Url.Action("SabtEstedadNiroEnsani", "Orders")", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() || ""
        },
        body: JSON.stringify(dataToSend)
    })
    .then(response => response.json())
    .then(result => {
        if (result === true || result.success) {
            alert("✅ ثبت اطلاعات با موفقیت انجام شد.");
            location.reload();
        } else {
            alert("❌ خطا در ثبت اطلاعات: " + (result.message || ""));
        }
    })
    .catch(err => {
        alert("❌ خطا در ارتباط با سرور: " + err);
    });
});
    </script>



