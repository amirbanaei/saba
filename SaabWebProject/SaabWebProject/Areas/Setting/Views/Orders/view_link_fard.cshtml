        function sendAjax14(url2, fd2) {

            document.getElementById("loading-circle").style.display = "block";


    $.ajax({
        url: url2,
        type: 'POST',
        data: fd2,
        processData: false,
        contentType: false,
        success: function (res) {
            document.getElementById("loading-circle").style.display = "none";

            $("#loading-message").css("display", "none");
            fd = new FormData();
            console.log(res);
            console.log("jj");

            if (res == "True") {
                $("#loading-circle").css("display", "none"); // پنهان کردن لودینگ

                alert("با موفقیت ثبت شد ");
                location.reload();
            }
                   @*$("#table_div").load('@Url.Content("../defFacilitiesEquipment/_ListEquipmentMoalefeValue")');*@
            else {
                alert(res);

            }


        },
        error: function (res) {
            $("#loading-message").css("display", "none");
            console.log(res);
            console.log("jj");
            Toast.fire({
                icon: 'success',
                background: '#35434A',
                color: 'white',
                title: "با خطا مواجه شده است ، لطفا بعدا تلاش فرمایید"
            }).then(() => {
                $("#loading-message").css("display", "none");
