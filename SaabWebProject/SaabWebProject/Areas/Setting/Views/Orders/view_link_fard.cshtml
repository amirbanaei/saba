    });
}
</script>
<script>
   $(function () {
    $("#myTable").load('@Url.Action("_PartialListPeymans", "Orders", new { area = "Setting" })');
});

$(document).ready(function() {
    $("#dwn").click(function () {
        var UserID = $("#UserID").val();
        var count = $("#count").val();
        var number = $("#number").val();
        //var day2 = $("#countday1").val();
        $("#loading-circle .loadingText1").text("لطفا منتظر نمایش اطلاعات بمانید ...");
        $("#loading-circle").css("display", "flex");
        //if (!UserID ) {
        //    alert("لطفاً بازه تاریخ را انتخاب کنید");
        //    return;
        //}

        $.ajax({
            url: '@Url.Action("sabt_edit_countcar", "Orders", new { area = "Setting" })',
            type: 'GET',
            data: {
                UserID: UserID,
                number: number,
                count: count,
            },
            success: function(response) {
                // اگر سرور "True" برگرداند، پیام موفقیت نشان داده می‌شود
                if (response === "True") {
                    $("#loading-circle").css("display", "none"); // پنهان کردن لودینگ

                    alert("عملیات با موفقیت انجام شد!");
                    location.reload();
                } else {
                    alert(response);
                }
            },
            error: function() {
                alert("خطا در ارتباط با سرور.");
            }
        });
    });
});

</script>

