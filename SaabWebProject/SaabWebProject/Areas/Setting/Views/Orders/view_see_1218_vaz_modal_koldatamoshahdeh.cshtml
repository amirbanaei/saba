// *** این کد فقط یک بار در کل صفحه Bind می‌شود ***
// و دیگر هرگز حتی با load() دوباره اجرا نمی‌شود.
$(document).ready(function() {
    // فقط یکبار اجرا شود
    function initBatchControls() {
        // حذف رویدادهای قبلی (ایمن‌تر)
        $(document)
            .off("change.batchInput", "#modalBatchInput")
            .off("click.batchPrev", "#batchPrev")
            .off("click.batchNext", "#batchNext");

        // تعریف رویدادهای جدید
        $(document).on("change.batchInput", "#modalBatchInput", function() {
            let val = parseInt($(this).val(), 10);
            if (isNaN(val) || val < 1) {
                val = 1;
                $(this).val(val);
            }
            loadBatch(val);
        });

        $(document).on("click.batchPrev", "#batchPrev", function() {
            let input = $("#modalBatchInput");
            let val = parseInt(input.val(), 10) || 1;
            if (val > 1) {
                val--;
                input.val(val);
                loadBatch(val);
            }
        });

        $(document).on("click.batchNext", "#batchNext", function() {
            let input = $("#modalBatchInput");
            let val = parseInt(input.val(), 10) || 1;
            val++;
            input.val(val);
            loadBatch(val);
        });
    }

    function loadBatch(batch) {
        var id = @ViewBag.Reason;
        $("#loading-circle").show();

        // فقط محتوای درونی را بارگذاری کن، نه کل اسکریپت‌ها
        $("#batchSection").load(
            "/Setting/Orders/view_see_1218_vaz_modal_koldatamoshahdeh?id=" + id + "&batch=" + batch + " #batchSection > *",
            function(response, status, xhr) {
                $("#loading-circle").hide();
                if (status === "error") {
                    console.log("خطا در load:", xhr.status, xhr.statusText);
                } else {
                    // بعد از بارگذاری، فقط فرمت‌سازی اعداد را انجام بده
                    formatNumbers();
                }
            }
        );
    }

    function formatNumbers() {
        document.querySelectorAll(".ragham").forEach(function(el) {
            let str = el.innerText.replace(/[^0-9]/g, "");
            if (str) {
                el.innerText = str.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            }
        });
    }

    // مقداردهی اولیه
    initBatchControls();
    formatNumbers();
});



