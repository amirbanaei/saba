@model IEnumerable<SaabWebProject.Models.DomainModels.tbTarifKalayeAsasi1>
@{
    ViewBag.Title = "تعریف کالای اساسی";

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
@using System.Globalization

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ModiriatStedad</title>

    <style>
        @@media (max-width: 768px) {
            /* ستون اول ثابت */
            .sticky-col {
                position: sticky;
                right: -5px; /* ستون سمت چپ */
                background: #fff; /* پس‌زمینه ثابت */
                z-index: 2000; /* زیر هدر، بالاتر از بقیه سلول‌ها */
                min-width: 120px; /* جلوگیری از قاطی شدن متن */
            }
            /* هدر ستون اول بالاتر از سلول‌ها */
            .sticky-col-header {
                z-index: 3;
            }

            table {
                overflow-x: auto !important;
            }



            .title {
                padding-right: 0 !important;
                flex-direction: column !important;
                gap: 10px !important;
            }

            .title-page {
                display: none !important;
            }

            .lebel-title {
                font-size: 10px;
                margin-right: 10px;
            }

            #SaatKhateme, #SaatShoroo {
                width: 80px;
            }
        }


        .TextCenter {
            align-content: center;
            align-items: center;
            justify-content: center;
            border-left: 1px solid white;
        }





        .position {
            position: relative;
            overflow: hidden;
            border-radius: 10px !important;
        }

        .title-page {
            /*            position: absolute;*/
            /*            right: 0;
            top: 0;*/
            display: flex;
            height: 100%;
            width: 188px;
            background: var(--bs-Meno-color);
            align-content: center;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            padding: 0px !important;
        }

        .title {
            border-width: 2px;
            margin-bottom: 50px;
            display: flex;
            gap: 20px;
            /*            padding-right: 900px;*/
        }

            .title div {
                display: flex;
                gap: 5px;
                align-content: center;
                align-items: baseline;
            }

        td input {
            margin: 0 !important;
            text-align: center;
        }
    </style>

</head>
<body>
    <div class="tab-content" id="pills-tabContent" style="padding:20px; background:#f7f7f7;">


 

        <div class="row">
            @*<div class="col-xl-2">

                    <label class="form-label">تاریخ ثبت</label>
                    <input data-jdp jdp-btn-close data-jdp-miladi-input="miladi_date1" id="datepickerFrom_shw1" class="form-control pdate" name="datepickerFrom_shw1">
                    <input id="miladi_date1" type="hidden" />
                </div>*@
            <div class="col-xl-2">
                <label class="form-label">عنوان</label>
                <input id="titleInput" class="form-control" type="text" />
            </div>
            <div class="col-xl-2">
                <label class="form-label">واحد شمارش</label>
                <input id="unitInput" class="form-control" type="text" />
            </div>
            <div class="col-xl-1"></div>
            <div class="col-xl-1">
                <a href="#" class=" btn form-control buttonGeneral" id="SendInput">
                    <i class="bi bi-plus-circle fa-fw me-1 VecGeneral"></i>
                    <span class="bGeneral-text">افزودن به جدول</span>
                </a>
            </div>

        </div>

        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive tableH_Lock">
                <table class="table table-hover" style="text-align:center; border-radius:10px; overflow:hidden;">
                    <thead>
                        <tr>
                            <th class=" sticky-col sticky-col-header" rowspan="2" style="border-bottom-right-radius:0px !important;">
                                عنوان
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter05-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>

                                </div>
                            </th>
                            <th class="" rowspan="2" style="border-bottom-right-radius:0px !important;">
                                واحد شمارش
                                <div class="inputWithFilterIcon">
                                    <input type="text" id="filter05-filter" class="inputFilter form-control" placeholder="">
                                    <span><i class="fas fa-filter"></i></span>

                                </div>
                            </th>


                        </tr>



                    </thead>
                    <tbody>
                        @{
                            var rowIndex = 0;
                        }
                        @foreach (var item in Model)
                        {
                            rowIndex++;
                            string groupName = $"attendance_{rowIndex}";

                            <tr>
                                <td class="sticky-col">@item.Name</td>
                                <td>@item.Vahed</td>





                            </tr>
                        }
                    </tbody>



                </table>
            </div>

        </div>

        <div class="row">
            <div class="col-xl-11"></div>
            <div class="col-xl-1">
                <a href="#" class=" btn form-control buttonGeneral" id="Send2">
                    <i class="bi bi-clipboard-check fa-fw me-1 VecGeneral"></i>
                    <span class="bGeneral-text">ثبت</span>
                </a>
            </div>
        </div>

    </div>
    <script src="~/Assets/js/jalalidatepicker.min.js"></script>
    <link href="~/Assets/css/jalalidatepicker.min.css" rel="stylesheet" />
    <script src="~/Assets/js/jalaali.min.js"></script>
    <link href="~/MyStyles/jalalidatepicker.css" rel="stylesheet" />
    <script>
        jalaliDatepicker.startWatch({
            time: false,
            days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
            persianDigits: true,
            autoClose: true,
            autocomplete: true,
            showEmptyBtn: false,
            showCloseBtn: true,
            zIndex: 100000,
        });

        var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
        for (var i = 0; i < inputs.length; i++) {
            inputs[i].addEventListener("jdp:change", function (e) {
                var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                var date = this.value.replace(' ', '').slice(0, 10).split('/');
                date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]));
                if (!this.value) {
                    date = "";
                } else if (this.value.replace(' ', '').length < 11) {
                    date = date.gy + '-' + date.gm + '-' + date.gd;
                } else {
                    date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30);
                }
                miladiInput.value = date;
            });
        }

    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("table tbody tr").forEach(function (row) {
                let inputs = row.querySelectorAll("td input"); // ستون‌های ۳ تا ۶

                inputs.forEach(function (input) {
                    // کنترل تایپ → فقط عدد
                    input.addEventListener("input", function (e) {
                        // حذف همه کاراکترهای غیرعددی
                        e.target.value = e.target.value.replace(/[^0-9]/g, "");

                        // محاسبه جمع
                        let sum = 0;
                        inputs.forEach(function (inp) {
                            let val = parseInt(inp.value, 10);
                            if (!isNaN(val)) sum += val;
                        });

                        // نمایش توی ستون آخر
                        row.querySelector("td:last-child").textContent =
                            sum > 0 ? sum : "";
                    });
                });
            });
        });
    </script>
    <!-- ... تمام محتوای HTML مثل جدول و فرم‌ها ... -->

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const tableBody = document.querySelector("table tbody");
            const addBtn = document.getElementById("SendInput");
            const titleInput = document.getElementById("titleInput");
            const unitInput = document.getElementById("unitInput");

            addBtn.onclick = () => {
                // مقادیر ورودی‌ها
                const title = titleInput.value.trim();
                const unit = unitInput.value.trim();

                // اگر خالی بودن → پیام بده و هیچ‌چیز به جدول اضافه نشه
                if (!title || !unit) {
                    alert("لطفاً همه فیلدها را پر کنید!");
                    return;
                }

                // ایجاد ردیف جدید و اضافه کردن به جدول
                const newRow = document.createElement("tr");
                newRow.innerHTML = `
                                <td class="sticky-col"> ${title}</td>
                                <td>${unit}</td>
                            `;
                tableBody.appendChild(newRow);

                // پاک کردن ورودی‌ها
                titleInput.value = "";
                unitInput.value = "";

                // پیام موفقیت
                alert("با موفقیت اضافه شد!");
            };
        });


    </script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
$(document).ready(function () {

    // ثبت نهایی → ارسال همه ردیف‌های جدول
    $("#Send2").click(function (e) {
        e.preventDefault();

        var data = [];
        $("table tbody tr").each(function () {
            var name = $(this).find("td:eq(0)").text().trim();
            var vahed = $(this).find("td:eq(1)").text().trim();

            if (name && vahed) {
                data.push({ Name: name, Vahed: vahed });
            }
        });

        if (data.length === 0) {
            alert("هیچ داده‌ای برای ثبت وجود ندارد!");
            return;
        }

        $.ajax({
            url: '@Url.Action("SaveKalaAsasi", "Orders")', // کنترلرت رو درست بذار
            type: "POST",
            data: JSON.stringify({ data: data }),
            contentType: "application/json; charset=utf-8",
            success: function (res) {
                if (res.success) {
                    alert("همه داده‌ها با موفقیت ذخیره شدند ✅");
                } else {
                    alert("خطا: " + res.error);
                }
            },
            error: function (xhr, status, error) {
                alert("خطای ارتباط با سرور: " + error);
            }
        });
    });

});

    </script>

</body>
</html>



