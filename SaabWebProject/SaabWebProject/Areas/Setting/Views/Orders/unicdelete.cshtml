<script>

function DownloadExcel23() {
    //var month = $("#Month2").val();
    var year = $("#select_peyman").val();

    document.getElementById("loading-circle").style.display = "block";

    if ( year == 0) {
        alert("لطفاً ماه و سال را انتخاب کنید.");
        return;
    }

    $.ajax({
        url: '@Url.Action("unicnzwrmagmoehdelete", "Orders", new { area = "Setting" })',
        type: "GET",
        data: { year: year},
        success: function (result) {
            document.getElementById("loading-circle").style.display = "none";

            $("#test2").html(result);
        },
        error: function () {
            alert("خطا در بارگذاری اطلاعات.");
        }
    });
}
</script>


