    <script>
$("#sabt").click(function () {

    var data = {
        ID: $("#TicketId").val(),
        OnvanDarkhast: $("#OnvanDarkhast").val(),
        Dalil: $("#Dalil").val(),
        Ellat: $("#Ellat").val(),
        Behbood: $("#Behbood").val(),
        Komak: $("#Komak").val(),
        Olaviyat: $("#Olaviyat").val(),
        Mohlat: $("#Mohlat").val(),
        Farayand: $("#Farayand").val()
    };

    if (
        data.OnvanDarkhast == "0" ||
        !data.Dalil.trim() ||
        !data.Ellat.trim() 
     
    ) {
        alert("⚠️ بعضی از فیلدها خالی هستند");
        return;
    }

    $.ajax({
        url: '@Url.Action("SabtTicket_motaghazi", "Orders")',
        type: 'POST',
        data: data,
        success: function (res) {
            alert(res.message);

            if (res.success) {

                // ✅ اینجا دقیقاً همین‌جا
                $("#TicketId").val(0);
                $("input, select").val("");

                location.reload(); // اگر نمی‌خوای ریفرش بشه، این خط رو حذف کن
            }
        },
        error: function () {
            alert("خطا در ارتباط با سرور");
        }
    });
});
    </script>


    <script>
    $(document).on("click", ".btn-delete", function () {

        var id = $(this).data("id");

        if (!confirm("آیا از حذف این تیکت مطمئن هستید؟")) return;

        $.ajax({
            url: '@Url.Action("DeleteTicket_motaghazi", "Orders")',
            type: 'POST',
            data: { id: id },
            success: function (res) {
                alert(res.message);
                if (res.success) {
                    location.reload();
                }
            },
            error: function () {
                alert("خطا در ارتباط با سرور");
            }
        });
    });
    </script>


</body>
</html>
