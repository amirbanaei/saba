    <script>

        var value1 = @value1; // مقدار اول
        var value2 = @value2; // مقدار دوم

        am4core.ready(function () {
            am4core.useTheme(am4themes_animated);

            var chartP2 = am4core.create("chartdiv2", am4charts.PieChart3D);
            chartP2.hiddenState.properties.opacity = 1;

            chartP2.data = [
                { category: "خالص پرداختی مامورین", litres: value2, color: am4core.color("#28a745") },
                { category: "اعتبار خالص پرداختی مامورین", litres: value1, color: am4core.color("#278BF5") }
            ];

            chartP2.innerRadius = am4core.percent(40);
            chartP2.depth = 20;
            chartP2.angle = 40;
            chartP2.startAngle = 450;
            chartP2.endAngle = 450 + 360;

            // Legend غیرفعال
            chartP2.legend = new am4charts.Legend();
            chartP2.legend.disabled = true;

            var seriesP2 = chartP2.series.push(new am4charts.PieSeries3D());
            seriesP2.dataFields.value = "litres";
            seriesP2.dataFields.category = "category";
            seriesP2.slices.template.propertyFields.fill = "color";
            seriesP2.slices.template.cornerRadius = 20;

            // حذف tooltip و برچسب های تعاملی
            seriesP2.tooltip.disabled = true;

            // متن‌ها سفید و کوچکتر
            seriesP2.labels.template.fill = am4core.color("#fff");
            seriesP2.labels.template.fontSize = 10; // 👈 سایز متن مقدارها
            seriesP2.labels.template.adapter.add("rotation", function (rotation, target) { return 0; });
            seriesP2.labels.template.adapter.add("radius", function (radius, target) { return -10; });
            seriesP2.labels.template.bent = true;
            seriesP2.labels.template.padding(0, 0, 0, 0);

            // خطوط برچسب سفید
            seriesP2.ticks.template.stroke = am4core.color("#fff");
            seriesP2.ticks.template.strokeWidth = 3;

            // حذف خطوط خارجی روی slices و گروه‌های اضافی
            seriesP2.slices.template.strokeWidth = 0;

            // Legend غیرفعال
            chartP2.legend = new am4charts.Legend();
            chartP2.legend.disabled = true;
        });
    </script>

