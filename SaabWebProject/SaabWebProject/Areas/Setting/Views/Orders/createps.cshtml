    <script>
// ساخت آرایه از داده‌های دیتابیس با Razor foreach
    var dataList = [
    @{
        var findusr1745 = db.dbergapishghan.Where(s => s.name == 51).OrderBy(t => t.vaziat).ToList();

    }
    @foreach (var item in findusr1745)
    {

        var result173 = db.dbergharelimsertfk1_7
                              .Where(s => s.valuunic == @unicc && s.FK_db2 == item.FK_gozaresh).OrderByDescending(t => t.ID)   // مرتب‌سازی روی خود جدول

                              .FirstOrDefault();
        if (result173 != null)
        {
                    @: { label: "@item.string_name", value: @result173.valueFK_db2 },

        }
        else
        {
                            @: { label: "@item.string_name", value:0 },

        }
    }
];

var realData = dataList.map(item => item.value);
var labels = dataList.map(item => item.label);

var total = realData.reduce((a, b) => a + b, 0);
var percentData = realData.map(val => val / total * 100);

// تولید رنگ‌های پویا
function generateColors(count) {
    let colors = [];
    for (let i = 0; i < count; i++) {
        let hue = Math.round((360 / count) * i);
        colors.push(`hsl(${hue}, 70%, 50%)`);
    }
    return colors;
}

var colors = generateColors(dataList.length);

    var options3 = {
        chart: {
            type: 'bar',
            height: '70%',
            fontFamily: 'var(--bs-body-font-family)',
            toolbar: { show: false }
        },
        plotOptions: {
            bar: {
                horizontal: false,
                borderRadius: 5,
                distributed: true,
                dataLabels: { position: 'top' }
            }
        },
        series: [{
            name: 'مقدار',
            data: percentData
        }],
        colors: colors,
        grid: { show: false, padding: { left: 10, right: 10, top: 10, bottom: 10 } },
        xaxis: {
            categories: labels,
            labels: {
                show: true,
                style: {
                    colors: '#fff',
                    fontFamily: 'var(--bs-body-font-family)',
                    fontSize: '10px' // 🖥️ دسکتاپ
                }
            },
            axisBorder: { show: false },
            axisTicks: { show: false }
        },
        yaxis: { labels: { show: false }, max: 100 },
        dataLabels: {
            enabled: true,
            textAnchor: 'middle',
            offsetY: -30,
            style: {
                colors: ['#fff'],
                fontFamily: 'var(--bs-body-font-family)',
                fontSize: '10px' // 🖥️ دسکتاپ
            },
            formatter: function (val, opts) {
                return realData[opts.dataPointIndex];
            }
        },
        legend: { show: false },
        tooltip: {
            y: {
                formatter: function (val, opts) {
                    return percentData[opts.dataPointIndex].toFixed(2) + '%';
                }
            }
        },

        // 📱 ریسپانسیو برای موبایل
        responsive: [
            {
                breakpoint: 768, // تبلت و موبایل
                options: {
