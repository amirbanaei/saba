    function getFileNameFromContentDisposition(headerValue) {
    if (!headerValue) return null;

    // حالت استاندارد: filename*=UTF-8''...
    var matchStar = headerValue.match(/filename\*\s*=\s*UTF-8''([^;]+)/i);
    if (matchStar && matchStar[1]) return decodeURIComponent(matchStar[1]);

    // حالت قدیمی: filename="..."
    var match = headerValue.match(/filename\s*=\s*"?([^"]+)"?/i);
    if (match && match[1]) return match[1];

    return null;
}

function downloadReport2() {
    var year = document.getElementById('year_hk').value;
    var month = document.getElementById('month_hk').value;

    if (year == "0" || month == "0") {
        alert("لطفاً سال و ماه را انتخاب کنید.");
        return;
    }

    document.getElementById("loading-circle").style.display = "block";

    var url = '@Url.Action("gozaresh_mashaglen", "Orders", new { area = "Setting" })' +
              '?year=' + encodeURIComponent(year) +
              '&month_usr=' + encodeURIComponent(month);

    var xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.responseType = 'blob';

    xhr.onload = function () {
        document.getElementById("loading-circle").style.display = "none";

        if (xhr.status === 200) {
            var cd = xhr.getResponseHeader("Content-Disposition");
            var fileName = getFileNameFromContentDisposition(cd) || "Report.xlsx";

            var blob = xhr.response;
            var downloadUrl = window.URL.createObjectURL(blob);

            var a = document.createElement("a");
            a.href = downloadUrl;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            a.remove();

            setTimeout(function () {
                window.URL.revokeObjectURL(downloadUrl);
            }, 1000);
        } else {
            alert("خطا در دانلود فایل");
        }
    };

    xhr.onerror = function () {
        document.getElementById("loading-circle").style.display = "none";
        alert("خطای شبکه.");
    };

    xhr.send();
}

