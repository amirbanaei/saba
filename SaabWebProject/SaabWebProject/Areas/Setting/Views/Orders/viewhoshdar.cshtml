<script>
    $(document).ready(function () {
        // پنهان‌سازی/نمایش بر اساس مقدار اولیه
        function toggleDateInputs() {
            if ($('#toggleDateInputs').is(':checked')) {
                $('#dateInputsContainer').slideDown();
            } else {
                $('#dateInputsContainer').slideUp();
            }
        }

        // اجرا در لود
        toggleDateInputs();

        // اجرا در تغییر مقدار چک‌باکس
        $('#toggleDateInputs').on('change', function () {
            toggleDateInputs();
        });
    });
</script>

