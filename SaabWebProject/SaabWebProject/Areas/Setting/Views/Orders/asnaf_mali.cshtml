    @*نمودار دایره ای*@
    <script>
        var chart;

        function updateChart() {
            const statusLabels = [
                "وصول کامل", "تقسیط", "قطع", "مهلت (پیگیری مجدد)",
                "ادعای قبض اشتباه (پیگیری مجدد)", "اصلاح شماره تماس (پیگیری مجدد)",
                "پرونده حقوقی (پیگیری مجدد)", "نیاز به پیگیری ستاد",
                "عدم پاسخگویی تلفنی", "عدم تماس یا اعلام مسئول پیگیری"
            ];

            let stats = {};
            statusLabels.forEach(label => {
                stats[label] = 0; // فقط مجموع ارجاع
            });

            let totalErja = 0;

            // جمع کردن ارجاع برای هر سطر visible
            $('.task-list-row:visible').each(function () {
                let status = $(this).data('filter06');
                let erja = parseFloat($(this).data('erja').toString().replace(/,/g, '')) || 0;

                if (status && stats.hasOwnProperty(status)) {
                    stats[status] += erja;
                    totalErja += erja;
                }
            });

            // حالا داده نهایی = سهم هر وضعیت از کل
            let finalData = statusLabels.map(label => {
                if (totalErja === 0) return 0;
                return parseFloat((stats[label] / totalErja).toFixed(4));
            });

            if (chart) {
                chart.updateOptions({
                    series: finalData,
                    labels: statusLabels
                });
            } else {
                var options = {
                    chart: {
                        type: 'pie',
                        height: '100%',
                        width: '100%',
                        foreColor: '#fff',
                        fontFamily: 'inherit',
                        toolbar: { show: false }
                    },
                    //colors: ['#e63946', '#f4a261', '#e9c46a', '#2a9d8f', '#4caf50', '#601CE8', '#00E396', '#FEB019', '#FF4560', '#33B2DF'],
                    colors : [
                        "#44cc8d", // وصول کامل
                        "#eeba0b", // تقسیط
                        "#42a5f5", // قطع
                        "#4D4D4D", // مهلت
                        "#B3B3B3", // ادعای قبض اشتباه
                        "#808080", // اصلاح شماره تماس
                        "#5d5a5a", // پرونده حقوقی
                        "#666666", // نیاز به پیگیری ستاد
                        "#999999", // عدم پاسخگویی تلفنی
                        "#333333"  // عدم تماس یا اعلام مسئول پیگیری
                    ],
                    series: finalData,
                    labels: statusLabels,
                    stroke: {
                        show: true,
                        width: 1,
                        colors: ['#1b7a7a']
                    },
                    dataLabels: {
                        enabled: true,
                        formatter: function (val, opts) {
                            // val حالا درصد نیست، سهم از کل
                            let realVal = opts.w.config.series[opts.seriesIndex];
                            return realVal === 0 ? '' : (realVal * 100).toFixed(2) + '%'; // نمایش درصد
                        },
                        style: { fontSize: '10px', fontWeight: 'bold' },
                        dropShadow: { enabled: true, opacity: 0.6 }
                    },
                    legend: {
                        show: true,
                        position: 'bottom',
                        fontSize: '9px',
                        markers: { width: 8, height: 8 },
                        itemMargin: { vertical: 2 }
                    },
                    tooltip: {
                        theme: 'dark',
                        y: {
                            formatter: (val) => "سهم: " + (val * 100).toFixed(2) + "%"
                        }
                    },
                    title: {
                        text: 'سهم هر وضعیت از کل ارجاع',
                        align: 'center',
                        style: { fontSize: '13px', color: '#fff' }
                    }
                };

                chart = new ApexCharts(document.querySelector("#pieChart"), options);
                chart.render();
            }
        }


        // لود اولیه
        $(document).ready(function () {
            updateChart();
        });
    </script>
