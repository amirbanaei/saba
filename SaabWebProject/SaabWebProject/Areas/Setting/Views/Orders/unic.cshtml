        $(document).on("click", "#downloadFish", function () {



            window.location.href =
                "/Setting/Orders/ExportUnic";
        });
        // متغیرهای سراسری
        let extraFieldsCount = 0;
        const extraFieldsContainer = document.getElementById('extraFieldsContainer');
        const addFieldsBtn = document.getElementById('addFieldsBtn');
        const productForm = document.getElementById('productForm');

        // تابع افزودن فیلدهای اضافی
        function addExtraFields() {
            extraFieldsCount++;
            const fieldId = Date.now(); // ID منحصر به فرد

            const extraFieldsDiv = document.createElement('div');
            extraFieldsDiv.className = 'extra-fields fade-in';
            extraFieldsDiv.id = `extra-${fieldId}`;

            extraFieldsDiv.innerHTML = `
                            <div class="row">
                                <div class="form-group col-xl-3">
                                    <label class="form-label" for="subtitle-${fieldId}">عنوان زیر مجموعه</label>
                                    <input type="text" class="form-control" id="subtitle-${fieldId}" name="subtitle-${fieldId}" placeholder="عنوان زیر مجموعه را وارد کنید">


                            </div>
                             <div class="col-xl-2">
            <button type="button" class="btn btn-danger btn-sm del-btn" data-target="extra-${fieldId}">حذف</button>
        </div> </div>
                        `;

            extraFieldsContainer.appendChild(extraFieldsDiv);
            console.log('فیلد جدید اضافه شد');
        }
        extraFieldsContainer.addEventListener('click', function (e) {
            if (e.target.classList.contains('del-btn')) {
                const targetId = e.target.getAttribute('data-target');
                document.getElementById(targetId).remove();
                console.log(`ردیف ${targetId} حذف شد`);
            }
        });
            // تابع جمع‌آوری اطلاع
        function collectFormData() {
            const formData = {
                جنس: document.getElementById('jens').value,
                وزن: document.getElementById('vazn').value,
                عنوان: document.getElementById('onvan').value,
                extraFields: []
            };

            // جمع‌آوری فیلدهای اضافی
            const extraFields = extraFieldsContainer.querySelectorAll('.extra-fields');
            extraFields.forEach((fieldDiv) => {
                const fieldId = fieldDiv.id.replace('extra-', '');
                const subtitle = document.getElementById(`subtitle-${fieldId}`).value;
                const priority = 0;

                formData.extraFields.push({
                    id: fieldId,
                    subTitle: subtitle,
                    priority: priority
                });
            });

            return formData;
        }

        // Event listener برای دکمه افزودن
        addFieldsBtn.addEventListener('click', addExtraFields);

        // Event listener برای ثبت فرم
        productForm.addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = collectFormData();
            console.log('فرم ثبت شد:', formData);

            // نمایش پیام موفقیت
            alert('فرم با موفقیت ثبت شد!\nاطلاعات در کنسول مرورگر قابل مشاهده است.');
        });

        // اضافه کردن کلاس focus برای بهبود UX
        document.querySelectorAll('.form-control, .form-select').forEach(element => {
            element.addEventListener('focus', function () {
                this.style.borderColor = '#030213';
            //    this.style.backgroundColor = 'white';
            });

            element.addEventListener('blur', function () {
                if (!this.value) {
                    this.style.borderColor = '#ddd';
                    this.style.backgroundColor = '#f9f9f9';
                }
            });
        });
        function collectFormData() {
            const formData = {
                Type: document.getElementById('jens').value,
                Weight:0,
                Title: document.getElementById('onvan').value,
                ExtraFields: []
            };

            // Extra fields
            const extraFields = extraFieldsContainer.querySelectorAll('.extra-fields');
            extraFields.forEach((fieldDiv) => {
                const fieldId = fieldDiv.id.replace('extra-', '');
                const subtitle = document.getElementById(`subtitle-${fieldId}`).value;
                const priority = 0;

                formData.ExtraFields.push({
                    SubTitle: subtitle,
                    Priority: priority
                });
            });

            return formData;
        }

        // Map "jens" values → numeric Type
        const typeMapping = {
            "تاریخ": 1,
            "ریال": 2,
            "عدد": 3,
            "تکست": 4
        };

        // Submit
        productForm.addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = collectFormData();

            // Convert "جنس" string → int
            formData.Type = typeMapping[formData.Type] || 0;

            fetch('/Setting/Orders/SaveProduct', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json;charset=utf-8'
                },
                body: JSON.stringify(formData)
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        productForm.reset();
                        extraFieldsContainer.innerHTML = "";
                    } else {
                        alert("Error: " + data.message);
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert("Unexpected error occurred.");
                });
        });
    </script>
</body>
