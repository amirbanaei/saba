    <script src="~/Assets/js/jalalidatepicker.min.js"></script>
    <link href="~/Assets/css/jalalidatepicker.min.css" rel="stylesheet" />
    <script src="~/Assets/js/jalaali.min.js"></script>
    <link href="~/MyStyles/jalalidatepicker.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-3.3.1.min.js"></script>


    <script>
        jalaliDatepicker.startWatch({
            time: false,
            days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
            persianDigits: true,
            autoClose: true,
            autocomplete: true,
            showEmptyBtn: false,
            showCloseBtn: true,
            zIndex: 100000,
        });

        var inputs = document.querySelectorAll("[data-jdp-miladi-input]");
        for (var i = 0; i < inputs.length; i++) {
            inputs[i].addEventListener("jdp:change", function (e) {
                var miladiInput = document.getElementById(this.getAttribute("data-jdp-miladi-input"));
                var date = this.value.replace(' ', '').slice(0, 10).split('/');
                date = jalaali.toGregorian(parseInt(date[0]), parseInt(date[1]), parseInt(date[2]));
                if (!this.value) {
                    date = "";
                } else if (this.value.replace(' ', '').length < 11) {
                    date = date.gy + '-' + date.gm + '-' + date.gd;
                } else {
                    date = date.gy + '-' + date.gm + '-' + date.gd + ' ' + this.value.replace(' ', '').slice(10, 30);
                }
                miladiInput.value = date;
            });
        }

    </script>

