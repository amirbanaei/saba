    <script>
    $("#Send").click(function (e) {
        //e.preventDefault();

        var rows = [];
        $("table tbody tr").each(function () {
            var $tr = $(this);

            var SalemZakhire = parseInt($tr.find("td:eq(2) input").val());
            var SalemMamor = parseInt($tr.find("td:eq(3) input").val());
            var NiyazmandTamir = parseInt($tr.find("td:eq(4) input").val());
            var GomShode = parseInt($tr.find("td:eq(5) input").val());
            var jam = parseInt($tr.find("td:last-child input").val());

            /*var jam = SalemZakhire + SalemMamor + NiyazmandTamir + GomShode*/

            var Sharh = $tr.find("td:eq(6) input").val();

            // ✅ فقط ردیف‌هایی که داده دارند ارسال بشن
            if (SalemZakhire !== 0 || SalemMamor !== 0 || NiyazmandTamir !== 0 || GomShode !== 0 || jam !== 0 || Sharh.trim() !== "") {
                rows.push({
                    Fk_tarifabzarkar: $tr.data("id"),
                    SalemZakhire: SalemZakhire,
                    SalemMamor: SalemMamor,
                    NiyazmandTamir: NiyazmandTamir,
                    GomShode: GomShode,
                    jam: jam,
                    Sharh: Sharh,
                    TimeSabt: $("#miladi_date1").val()
                });
            }
        });

        $.ajax({
            url: '@Url.Action("SaveAbzarEstedad","Orders")',
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(rows),
            success: function (res) {
                if (res.success) {
                    alert("با موفقیت ذخیره شد ✅");
                    location.reload();
                } else {
                    alert("خطا: " + res.error);
                }
            }
        });
    });
    </script>




