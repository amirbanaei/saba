@{
    ViewBag.Title = "Dynamic Tree Structure";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dynamic Tree Structure</title>
    <link rel="stylesheet" href="~/Content/tree.css">
    <style>
        body {
            font-family: Calibri, Segoe, "Segoe UI", "Gill Sans", "Gill Sans MT", sans-serif !important;
        }

        .tree, .tree ul, .tree li {
            list-style: none !important;
            margin: 0 !important;
            padding: 0 !important;
            position: relative !important;
        }

        .tree {
            margin: 0 0 1em !important;
            text-align: center !important;
        }

            .tree, .tree ul {
                display: table !important;
                width: 100% !important;
            }

                .tree li {
                    display: table-cell !important;
                    padding: .5em 0 !important;
                    vertical-align: top !important;
                    position: relative !important;
                }

                    .tree li:before {
                        outline: solid 1px #666 !important;
                        content: "" !important;
                        left: 0 !important;
                        position: absolute !important;
                        right: 0 !important;
                        top: 0 !important;
                    }

                    .tree li:first-child:before {
                        left: 50% !important;
                    }

                    .tree li:last-child:before {
                        right: 50% !important;
                    }

                .tree code, .tree span {
                    border: solid .1em #666 !important;
                    border-radius: .2em !important;
                    display: inline-block !important;
                    margin: 0 .2em .5em !important;
                    padding: .2em .5em !important;
                    position: relative !important;
                }

                .tree code {
                    font-family: monaco, Consolas, 'Lucida Console', monospace !important;
                }

                    .tree ul:before,
                    .tree code:before,
                    .tree span:before {
                        outline: solid 1px #666 !important;
                        content: "" !important;
                        height: .5em !important;
                        left: 50% !important;
                        position: absolute !important;
                    }

                .tree ul:before {
                    top: -.5em !important;
                }

                .tree code:before,
                .tree span:before {
                    top: -.55em !important;
                }

                /* Remove the top connection for the root node */
                .tree > li {
                    margin-top: 0 !important;
                }

                    .tree > li:before,
                    .tree > li:after,
                    .tree > li > code:before,
                    .tree > li > span:before {
                        outline: none !important;
                    }

        /* Style for the "+" and "-" buttons */
        .add-node, .remove-node {
            cursor: pointer;
            color: #007BFF !important;
            margin-left: 5px !important;
            font-size: 14px !important;
            font-weight: bold !important;
        }

        .remove-node {
            color: #FF5733 !important; /* رنگ قرمز برای دکمه حذف */
        }
    </style>
</head>
<body>

    <figure>
        <figcaption>مثال ساختار درخت پویا</figcaption>
        <ul class="tree" id="tree-container">
            <!-- درخت اینجا قرار می‌گیرد -->
        </ul>
        <button id="add-root">افزودن نود ریشه</button>
    </figure>

    <script>
        // انتخاب کانتینر خالی برای نمایش درخت
        const treeContainer = document.getElementById('tree-container');
        const addRootButton = document.getElementById('add-root');

        // تابع برای ایجاد نود جدید
        function createNode(name, parentId) {
            // ایجاد عنصر نود و تنظیم نام آن
            const nodeLi = document.createElement('li');

            const nodeCode = document.createElement('code');
            nodeCode.textContent = name;
            nodeLi.appendChild(nodeCode);

            const addNodeSpan = document.createElement('span');
            addNodeSpan.classList.add('add-node');
            addNodeSpan.textContent = '+';
            addNodeSpan.dataset.id = parentId; // اضافه کردن ID والد به اسپن
            nodeLi.appendChild(addNodeSpan);

            const removeNodeSpan = document.createElement('span');
            removeNodeSpan.classList.add('remove-node');
            removeNodeSpan.textContent = '-';
            nodeLi.appendChild(removeNodeSpan);

            // اضافه کردن رویداد کلیک برای دکمه افزودن زیرمجموعه
            addNodeSpan.addEventListener('click', () => {
                const childName = prompt("نام نود فرزند را وارد کنید:");
                if (childName) {
                    // ارسال درخواست به سرور برای ایجاد نود جدید
                    $.ajax({
                        url: '@Url.Action("AddNode", "Orders", new { area = "Setting" })',
                        type: 'POST',
                        data: { name: childName, relationId: parentId },
                        success: function (newNode) {
                            const childNode = createNode(newNode.NameAval, newNode.ID); // ساخت نود جدید
                            let childrenContainer = nodeLi.querySelector('ul');
                            if (!childrenContainer) {
                                childrenContainer = document.createElement('ul');
                                nodeLi.appendChild(childrenContainer);
                            }
                            childrenContainer.appendChild(childNode);
                        },
                        error: function () {
                            alert("خطا در افزودن نود فرزند");
                        }
                    });
                }
            });

            // اضافه کردن رویداد کلیک برای دکمه حذف نود
            removeNodeSpan.addEventListener('click', () => {
                const confirmDelete = confirm("آیا مطمئن هستید که می‌خواهید این نود را حذف کنید؟");
                if (confirmDelete) {
                    // ارسال درخواست به سرور برای حذف نود
                    $.ajax({
                        url: '@Url.Action("DeleteNode", "Orders", new { area = "Setting" })',
                        type: 'POST',
                        data: { id: parentId }, // ID نود برای حذف
                        success: function (response) {
                            if (response.success) {
                                nodeLi.remove(); // حذف نود از DOM
                                alert("نود با موفقیت حذف شد.");
                            } else {
                                alert(response.message); // نمایش پیام خطا
                            }
                        },
                        error: function () {
                            alert("خطا در حذف نود");
                        }
                    });
                }
            });

            return nodeLi;
        }

        // افزودن رویداد کلیک برای دکمه افزودن نود ریشه
        addRootButton.addEventListener('click', () => {
            const rootName = prompt("نام نود ریشه را وارد کنید:");
            if (rootName) {
                $.ajax({
                    url: '@Url.Action("AddNode", "Orders", new { area = "Setting" })',
                    type: 'POST',
                    data: { name: rootName, relationId: null },
                    success: function (newNode) {
                        const rootNode = createNode(newNode.NameAval, newNode.ID);
                        treeContainer.appendChild(rootNode);
                        addRootButton.style.display = 'none'; // پنهان کردن دکمه بعد از اضافه شدن ریشه
                    },
                    error: function () {
                        alert("خطا در افزودن نود ریشه");
                    }
                });
            }
        });
    </script>

</body>
</html>
