<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
@model SaabWebProject.Models.ViewModels.Contracts.Function.FunctionModel
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
@using SaabWebProject.Models.DomainModels;

@{
    SaabEntities db = new SaabEntities();
}
@{
    Layout = null;
}

<select class="form-select select_peyman1" id="select_peyman1" name="select_peyman1">
    <option hidden value="Select">انتخاب مورد</option>
    @foreach (var item in Model.arzyzbi5_time2.ToList())
    {
        string icon = item.ID == 1
            ? "✅"   // تیک سبز
            : item.ID == 0
                ? "❌"   // ضربدر قرمز
                : "🔄";  // فلش تکرار

        <option value="@item.arzyzbi5_Time.ID">
            نام گزارش : @item.arzyzbi5_Time.arzyzbi1.name _
            نام دوره : @item.arzyzbi5_Time.namedoreh _ @icon
        </option>
    }
</select>

<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>



