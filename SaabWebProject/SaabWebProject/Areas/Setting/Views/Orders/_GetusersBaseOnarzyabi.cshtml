@*@model IEnumerable<SaabWebProject.Models.DomainModels.tbUsers>*@

<select class="form-select" id="select_peyman22" name="select_users1">
    <option value="0">انتخاب کنید</option>
    @foreach (var item in Model.tbAdamAdam3.ToList())
    {
        if (item.ID1 == 1)
        {
            <option value="@item.ID">
                @item.fullname ✅
            </option>
        }
        else
        {
            <option value="@item.ID">
                @item.fullname ❌
            </option>
        }
    }


</select>

