<script>
let rowIndex = 0;

// تابع افزودن ردیف جدید
function addNewRow() {
    // بررسی اینکه آیا در هیچ ردیفی وضعیت برابر ۶ است
    let hasVazeat6 = false;
    $("#rowsContainer .dynamic-row").each(function () {
        let vazeatVal = $(this).find(".select_peyman").val();
        if (vazeatVal === "6" || vazeatVal === "7" || vazeatVal === "8" || vazeatVal === "10" || vazeatVal === "5" || vazeatVal === "9" ) {
            hasVazeat6 = true;
            return false; // خروج از حلقه
        }
    });

    if (hasVazeat6) {
        alert("شما در این حالت نمی‌توانید ردیف جدیدی اضافه کنید!");
        return;
    }

    rowIndex++;

    let newRow = `
    <div class="row dynamic-row mb-2" data-index="${rowIndex}">
        <div class="col-xl-3">
            <label class="form-label">عنوان فیلد</label>
            <select class="form-select select_peyman1" name="select_peyman${rowIndex}">
                <option hidden value="Select">انتخاب مورد</option>
                @foreach (var item in db.dbergharel_4_4.ToList())
                {
                    <option value="@item.ID">@item.name</option>
                }
            </select>
        </div>

        <div class="col-xl-3">
            <label class="form-label">کاربر</label>
            <select class="form-select peyman-search" name="select_users${rowIndex}">
                <option value="0">انتخاب کنید</option>
                @foreach (var item in db.dbergharel4_5.ToList())
                {
                    <option value="@item.FK_dbergharel2">@item.dbergha2.name ✅</option>
                }
            </select>
        </div>

        <div class="col-xl-2">
            <label class="form-label">علامت</label>
            <select class="form-select select_peyman" name="SelectPeyman[${rowIndex}]">
                <option hidden></option>
                <option value="1">-</option>
                <option value="2">+</option>
                <option value="3">*</option>
                <option value="4">/</option>
                                <option value="5">=</option>
                <option value="7">></option>
                <option value="9"><</option>
                                <option value="8">>=</option>
                <option value="10">=<</option>
                <option value="6">B</option>
            </select>
        </div>

        <div class="col-xl-2"></div>
        <div class="col-xl-1" style="margin-right: 35px;">
            <button type="button" class="btn form-control buttonsabt removeRow">
                <i class="bi bi-x-circle fa-fw me-1 VecGeneral"></i>
                <span class="bSabt-text">حذف</span>
            </button>
        </div>
    </div>
    `;

    $("#rowsContainer").append(newRow);

    // فعال‌سازی picker روی select کاربر جدید
    $("#rowsContainer .peyman-search").last().picker({ search: true });
}

// اضافه کردن ردیف با دکمه +
$("#addRowBtn").on("click", function () {
    addNewRow();
});

// حذف ردیف
$(document).on("click", ".removeRow", function () {
    $(this).closest(".dynamic-row").remove();
});

// بررسی تغییر select وضعیت
$(document).on("change", ".select_peyman", function () {
    let $changedRow = $(this).closest(".dynamic-row");
    let val = $(this).val();
    if (val === "6" || val === "7" || val === "8" || val === "10" || val === "5" || val === "9") {

        // حذف همه ردیف‌های بعد از این ردیف
        $changedRow.nextAll(".dynamic-row").remove();
        alert("شما در این حالت نمی‌توانید ردیف جدیدی اضافه کنید!");
    }
});

// ایجاد یک ردیف اولیه هنگام بارگذاری صفحه
$(document).ready(function () {
    addNewRow();
});

</script>

<script>
    $(document).ready(function () {
        $("#finalSummaryBtn").on("click", function () {
            // بررسی وجود ردیف‌ها
            let rows = $("#rowsContainer .dynamic-row");

            if (rows.length === 0) {
                $("#finalSummaryContainer").hide();
                alert("هیچ ردیفی برای جمع بندی وجود ندارد!");
                return;
            }

            // بررسی وجود مقدار ۶ در select وضعیت
            let hasVazeat6 = false;
            rows.each(function () {
                if ($(this).find(".select_peyman").val() === "6") {
                    hasVazeat6 = true;
                    return false; // خروج از حلقه
                }
            });

            // پاک کردن محتوای قبلی جمع‌بندی
            $("#finalSummaryContainer").empty();

            // ساخت ردیف جمع‌بندی جدید
            let summaryRow = '<div class="row mb-2">';
            if (hasVazeat6) {
                summaryRow += `
                <div class="col-xl-3">
                    <label class="form-label">از این</label>
                    <input id="field1" type="text" class="form-control" placeholder="مقدار اول">
                </div>
                <div class="col-xl-3">
                    <label class="form-label">تا این</label>
                    <input id="field2" type="text" class="form-control" placeholder="مقدار دوم">
                </div>
            `;
            } else {
                summaryRow += `
                <div class="col-xl-3">
                    <label class="form-label">مساوی</label>
                    <input id="field3" type="text" class="form-control" placeholder="مقدار">
                </div>
            `;
            }
            summaryRow += '</div>';

            $("#finalSummaryContainer").append(summaryRow);

            // نمایش دیو جمع‌بندی
            $("#finalSummaryContainer").slideDown(400);
        });
    });

</script>






<script>

   function initPeymanSelect($row) {
    $row.find(".peymans").load('@Url.Content("/../Setting/Orders/_GetAllListPeyman_gozaresh")', function () {

        let $select = $row.find("select.select_peyman");
        let $userInput = $row.find(".userinput");
        let $userDiv = $row.find(".UserOFPeyman");

        $select.off('change').on('change', function () {
            let id = $(this).val();

            // فقط input همان ردیف را مخفی کن
            $userInput.hide();

            // load داده‌ها در div همان ردیف
            $userDiv.load('@Url.Content("/../Setting/Orders/_GetusersBaseOnarzyabiunics")?PeymanID=' + id);
        });
    });
}




</script>
