<script>
    function formatNumber(input) {
        // فقط رقم برداره
        let value = input.value.replace(/[^0-9]/g, "");

        // سه رقم سه رقم جدا کنه
        value = value.replace(/\B(?=(\d{3})+(?!\d))/g, ",");

        input.value = value;
    }

    // اعمال روی دو فیلد مبلغ
    document.getElementById("Mablagh1").addEventListener("input", function () {
        formatNumber(this);
    });

    document.getElementById("Mablagh2").addEventListener("input", function () {
        formatNumber(this);
    });
</script>


<script>
        $(document).ready(function () {

            $("#btnSubmitModal2").click(function () {
                var FK_olaviat = @Model.usrID; // یا ردیف انتخاب‌شده را پیدا کنید
                var input1 = $("#input1-SayerShoroot").val();
                var input2 = $("#input2-SayerShoroot").val();
