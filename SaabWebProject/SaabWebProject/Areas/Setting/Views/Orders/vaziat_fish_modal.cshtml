        }

        .circle2 i {
            font-size: 14px;
            color: white;
            font-style: normal;
        }

        .box {
            position: absolute;
            display: flex;
            flex-direction: column;
            height: fit-content;
            width: 215px !important;
            z-index: 100;
            justify-content: center;
            border-radius: 15px;
            border: 1px solid aqua;
            background: #1d2734;
            padding: 10px;
            /* موقعیت اولیه */
            top: 28px;
            right: -92px;
            /* حالت مخفی و ریز شده */
            opacity: 0;
            visibility: hidden;
            /* ۱. تغییر سایز اولیه به 50% */
            transform: scale(0.1);
            /* ۲. نرم کردن حرکت و تغییر سایز */
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            pointer-events: none;
