    <script src="~/Scripts/leader-line.min.js"></script>
    <script>
        $(document).ready(function () {
            function getNodeColor(node) {
                if (node.classList.contains('green')) return '#00ff88';
                if (node.classList.contains('red')) return '#ff3b3b';
                return '#ffaa00';
            }
            // 1. رسم خطوط بعد از لود شدن کامل

    const lines = [];
    const nodes = Array.from(document.querySelectorAll('.step-node'))
                      .sort((a, b) => a.dataset.id - b.dataset.id);

    nodes.forEach((node, i) => {
        if (i < nodes.length - 1) {
            let line = new LeaderLine(
                nodes[i],
                nodes[i + 1],
                {
                    path: 'grid',
                    size: 4,

                    color: '#00f6ff',
                    gradient: true,

                    dash: { len: 8, gap: 6, animation: true },

                    outline: true,
                    outlineColor: '#003a40',
                    outlineSize: 3,

                    dropShadow: {
                        dx: 0,
                        dy: 0,
                        blur: 10
                    },

                    startPlug: 'disc',
                    startPlugSize: 0.8,

                    endPlug: 'arrow3',
                    endPlugSize: 1.3,

                    zIndex: 0
                }
            );


            lines.push(line);
        }
    });

    // 2. مدیریت کلیک روی دایره‌ها

    // 3. فیکس کردن جابجایی خطوط موقع اسکرول یا تغییر سایز
    $(window).on('scroll resize', function() {
        lines.forEach(l => l.position());
    });
        // وقتی روی هر سلول یا دکمه click2 کلیک شد، مودال باز بشه
    $(".circle2").click(function () {
        var $this = $(this);
        lines.forEach(l => l.hide());

        // موقعیت المان کلیک‌شده
        var offset = $this.offset();
        var elementHeight = $this.outerHeight();
        $("#hiddenID").val(idd);
        // نمایش مودال
        $("#mymodal3")
            .addClass("fade-in")
            .css({
                "display": "block",

            });

        // گرفتن data-id یا هر چیزی که نیاز داری
        var idd = $this.data("id");
        console.log("Clicked ID:", idd);
        //var fromDate = $("#astime").val();
        var Year = $("#Year").val();
        var Month = $("#Month").val();

        // لود محتوا
$("#ss").load('@Url.Content("/Setting/Orders/Modal_Fish")?id=' + idd + '&Year=' + Year + '&Month=' + Month);
    });

    // بستن مودال با آیکون
    $(".close-icon").click(function () {
        $("#mymodal3").fadeOut();
        lines.forEach(l => l.show());

    });

    // بستن مودال وقتی روی بک‌گراند کلیک شد
    $("#mymodal3").click(function (e) {
        if (e.target === this) {
            $(this).fadeOut();
        }
    });
});
    </script>
    <script>

        $(document).ready(function () {



