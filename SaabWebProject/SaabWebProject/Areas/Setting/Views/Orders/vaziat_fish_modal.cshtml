            .circle2:hover {
                border: 1px solid white;
                z-index: 10001 !important;
            }

                .circle2:hover .box {
                    opacity: 1;
                    visibility: visible;
                    z-index: 10002 !important;
                    transform: translateY(-95px) scale(1);
                    pointer-events: all;
                }


        .red {
            box-shadow: inset 0 0 16px 0px #ff0000, 0px 0px 5px 1px #ff0000;
        }

        .green {
            box-shadow: inset 0 0 16px 0px #04ff00, 0px 0px 5px 1px #00ff37;
        }

        .yellow {
