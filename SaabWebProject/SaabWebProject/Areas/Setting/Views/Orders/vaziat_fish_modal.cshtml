        .Naghshe {
            min-height: 600px;
            display: grid;
            grid-template-columns: repeat(6, 60px); /* عرض واقعی هر نود */
            gap: 90px 70px;
            justify-content: center; /* ← مهم */
            align-items: center;
            padding: 60px;
        }

        .circle2 {
            position: relative; /* ← قبلا absolute بود */
            background-color: #1d2734;
            height: 30px;
            width: 30px;
            border-radius: 50%;
            box-shadow: inset 0 0 16px 0px #00ffff, 0px 0px 5px 1px #00ffff;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: .2s;
        }

