        .form-control {
            border-width: 2px;
            border-radius: 8px;
        }

        .row {
            margin-bottom: 10px;
        }

        #head {
            display: flex;
            background-color: #278BF5;
            height: 43px;
            border: none;
            align-content: center;
        }

            #head p {
                font-size: 18px;
            }

        .parts-container {
            padding: 0;
            overflow: hidden;
            text-align: center;
            background-color: #082D59;
        }

        .parts {
            width: 100%;
            border-radius: 0;
            display: flex;
            gap: 5px;
            justify-content: center;
            align-items: center;
            border: none;
            border-bottom: 2px solid var(--bs-border-color);
            font-size: 10px;
            background-color: #082D59;
        }

            .parts p, label {
                margin: 0;
                user-select: none;
            }

        .parts-container .parts:last-child {
            border: none;
            background-color: #082D59;
        }

        .chart {
            width: 100%;
            /*            height:100px;*/
            border: none;
        }

        .chart-container {
            display: flex;
            width: 100%;
            height: 250px;
            border: none;
            padding: 0;
        }

        .chart-date {
            display: flex;
            justify-content: center;
        }

        .chart2 {
            border: none;
            height: 100%;
        }

        #customLegend {
            display: flex;
            width: 100%;
            gap: 150px;
            margin-top: 20px;
            margin-bottom: 10px;
            font-family: var(--bs-body-font-family);
            font-size: 14px;
            text-align: center;
            justify-content: center;
        }

        #customLegend2 {
            display: flex;
            width: 100%;
            gap: 100px;
            margin-top: 40px;
            margin-bottom: 10px;
            font-family: var(--bs-body-font-family);
            font-size: 14px;
            text-align: center;
            justify-content: center;
        }


        .legend-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 10px;
            margin-top: 20px;
        }

        .legend-item2 {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 10px;
            margin-top: 20px;
        }

        .legend-color {
            width: 14px; /* کوچیک‌تر */
            height: 14px; /* کوچیک‌تر */
            border-radius: 4px; /* گوشه نرم */
        }

        #table1 div {
            border-radius: 0;
            border: none;
        }



        #title-table1 {
            display: flex;
            justify-content: center;
            border-bottom: 2px solid var(--bs-border-color) !important;
        }

            #title-table1 p {
                font-size: 16px;
                margin-top: 13px;
            }

        #tr-table1 {
            padding: 0 !important;
            display: flex;
        }



        .td-table1 {
            border-left: 2px solid var(--bs-border-color) !important;
            height: 100px;
            width: calc(100% / 8);
        }

            .td-table1:last-child {
                border-left: none !important;
            }

            .td-table1 label {
                display: flex;
                align-items: center;
                align-content: center;
                justify-content: center;
                height: 50%;
                width: 100%;
            }

        .grid-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr); /* سه ستون با عرض برابر */
            gap: 10px; /* فاصله بین ستون‌ها */
        }

        .grid-column {
            display: grid;
            gap: 10px; /* فاصله بین ردیف‌ها */
        }

        .grid-item {
            /*            border:2px solid var(--bs-border-color);*/
            /*            padding: 10px;*/
            /*            border-radius: 5px;*/
            text-align: center;
        }

        .title {
            background-color: #006AFF;
            border-bottom: none;
            font-size: 14px
        }

        #chartdiv2 {
            width: 100%;
            height: 300px;
        }

        #hide {
            display: flex;
            position: absolute;
            bottom: 0;
            left: 0;
            height: 20px;
            width: 80px;
            background-color: #082D59;
            z-index: 1000;
        }

        .col3 {
            grid-template-rows: 3fr 1fr 1fr;
            gap: 0;
            padding: 0;
            border: 2px solid var(--bs-border-color);
            overflow: hidden;
            border-radius: 8px;
        }

        .col3-row2 {
            height: 280px;
            display: grid;
            grid-template-columns: 3fr 1fr;
            padding: 0;
            gap: 0;
        }

        .col3-row2-col {
            display: flex;
            flex-direction: column;
            height: 100%;
            border: none;
            gap: 0;
        }

        .col3-row2-col-1 {
            border: none;
            border-bottom: 2px solid var(--bs-border-color);
            border-left: 2px solid var(--bs-border-color);
            display: flex;
            flex-direction: row;
            height: calc(100% / 9);
            border-radius: 0;
            font-size: 10px;
            justify-content: center;
            align-items: center;
            align-content: center;
        }

        .height {
            height: calc(100% / 3);
            border-left: none;
        }

        .col3-row2-col-1:last-child {
            border-bottom: none;
        }

        .bi-exclamation-circle-fill::before {
            content: "\f332";
            margin: 3px 4px 0 0;
            color: #C7AF28;
            font-size: 15px;
        }

        .bi-check-circle-fill::before {
            content: "\f26a";
            margin: 3px 4px 0 0;
            color: #29C728;
            font-size: 15px;
        }

        .bi-x-circle-fill::before {
            content: "\f622";
            margin: 3px 4px 0 0;
            color: #C72828;
            font-size: 15px;
        }

        .click2 {
            cursor: pointer;
        }
    </style>
</head>
