@using SaabWebProject.Models.DomainModels;

@{
    SaabEntities db = new SaabEntities();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>NewDashbord</title>
    <style>
        /* ریسپانسیو کامل برای موبایل */
        @@media (max-width: 768px) {
            .row {
                flex-direction: column;
                gap: 5px;
            }

            .modal3 {
                display: none;
                position: absolute; /* Change this from fixed */
                z-index: 1000; /* Adjust z-index as needed */
                left: 0;
                top: 0;
                width: 58%;
                height: 100%;
                overflow: auto;
                background-color: rgba(0, 0, 0, 0.4);
            }

            .modal-content2 {
                background-color: black;
                position: relative; /* Add relative positioning */
                margin: 15% auto;
                padding: 20px;
                border: 4px solid aqua;
                border-radius: 30px;
                width: 100%;
                max-height: 100%;
                overflow-y: auto;
            }


            .close {
                color: #aaa;
                float: right;
                font-size: 28px;
                font-weight: bold;
            }

                .close:hover,
                .close:focus {
                    color: black;
                    text-decoration: none;
                    cursor: pointer;
                }

            .col-xl-12, .col-xl-6, .col-xl-5, .col-xl-1 {
                width: 100% !important;
                max-width: 100% !important;
            }

            #head {
                height: 35px;
            }

                #head p {
                    font-size: 14px;
                }

            .parts-container {
                text-align: right;
                padding: 2px;
            }

            .parts {
                flex-direction: row;
                align-items: flex-start;
                font-size: 8px;
                height: auto;
            }

                .parts p {
                    margin-top: 2px;
                }

            .chart-container {
                flex-direction: column;
                height: auto !important;
            }

            .chart2 {
                width: 102% !important;
                height: auto !important;
                margin-bottom: 30px;
                padding: 10px;
            }

            .chart {
                height: 100px !important;
            }

            #customLegend {
                flex-direction: column !important;
                gap: 5px !important;
                font-size: 8px !important;
            }

            #customLegend2 {
                flex-direction: column !important;
                gap: 5px !important;
                font-size: 8px !important;
            }

            .legend-color {
                width: 10px !important;
                height: 10px !important;
            }

            .chart-date {
                flex-direction: row;
                align-items: flex-start;
                gap: 3px;
                font-size: 10px;
            }

            #tr-table1 {
                flex-direction: column; /* ستون‌ها زیر هم */
            }

            .td-table1 {
                width: 100% !important;
                height: auto !important;
                border-left: none !important; /* چون عمودی شدن */
                border-bottom: 2px solid var(--bs-border-color) !important;
                margin-bottom: 5px; /* فاصله بین ستون‌ها */
            }

                .td-table1:last-child {
                    border-bottom: none !important;
                }

                .td-table1 label {
                    height: auto;
                    font-size: 12px; /* کوچکتر برای موبایل */
                    justify-content: flex-start;
                    padding-left: 5px;
