        $("input[name='MyExcelStream12']").click();
    }
</script>
<script>

    $(function () {


        var Temp = '@TempData["Message"]';
    if (Temp == '#') {
        Toast.fire({
            icon: 'success',
            background: '#35434A',
            color: 'white',
            title: "اطلاعات با موفقیت آپلود شد"
        });
    }
    else if (Temp!='') {

        Toast.fire({
            icon: 'warning',
            background: '#35434A',
            color: 'white',
            title: Temp
        });

    }


    });


    $("#createMoalefeButtonModal").click(function () {
        $("#big_modal_body").load('@Url.Content("/Company/_PartialCreateCompany")');
    });
</script>


