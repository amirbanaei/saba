<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Scripts/sweetalert2.js"></script>

<script>
    $("input[name='MyExcelStream12']").change(function () {
                  console.log("ldsaksda0");

        var file = this.files[0];
        var ext = file.name.split('.')[1];
        if (ext == "xlsx" || ext == "xls") {

            var obj = new FormData();

            obj.append("MyExcelStream", file);

            console.log(file);
            $.ajax({
            beforeSend:function (){
                    document.getElementById("loading-circle").style.display = "block";
            },
                url: "@Url.Action("GETEXCEL", "Company", new { area = "Users" })" ,
               type: "post",
               contentType: false,
               data: obj,
               processData: false,
               cache: false,
                success: function (res) {
                    console.log(res + "kjkjh");
                    if (res == "True") {
                        Toast.fire({
                            icon: 'success',
                            background: '#35434A',
                            color: 'white',
                            title: "اطلاعات با موفقیت ذخیره شد"
                        });
                        location.reload();
                    }

                    else {
                        Toast.fire({
                            icon: 'warning',
                            background: 'rgb(29,40,52)',
                            color: 'white',
                            title: res
                        });


                        location.reload();

                    }
                   //document.getElementById("loading-circle").style.display = "none";
                   //Swal.fire({
                   //    icon: 'success',
                   //    background: 'rgb(29,40,52)',
                   //    color: 'white',
                   //    confirmButtonText: 'باشه',
                   //    title: 'آپلود اکسل',
                   //    text: res,
                   //});

               },
               error: function (res) {
                   Toast.fire({
                       icon: 'warning',
                       background: 'rgb(29,40,52)',
                       color: 'white',
                       title: res
                   });
                   location.reload();
}
           });
        }
        else {

            Swal.fire({
                icon: 'warning',
                background: 'rgb(29,40,52)',
                color: 'white',
                confirmButtonText: 'باشه',
                title: 'نوع فایل',
                text: 'لطفا فایلی با پسوند اکسل وارد کنید',
            });
            return false;
        }

    });
    /// Open Dialog File

</script>
<script>
    function ShowDialogFile1() {
        console.log("ldsaksda0");
