@model IEnumerable<SaabWebProject.Models.DomainModels.tbCompanies>

<link href="~/MyStyles/Tablestyle.css" rel="stylesheet" />
<style>

    .tableH_Lock {
        max-height: 533px;
        /*height: 533px;*/
    }

    thead {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .inputFilter {
        margin-bottom: 0px !important;
    }

    thead th {
        vertical-align: middle;
    }
</style>
<div class="card" style="width: 100%">
    <div class="table-content p-4">
        <div class="table-responsive tableH_Lock">
            <table class="table table-hover text-nowrap">
                <thead>
                    <tr style="text-align:center">
                        <th>
                            @Html.DisplayName("فعالیت")
                        </th>
                        <th>
                            @Html.DisplayName("#")
                        </th>
                        <th>
                            @Html.DisplayName("نام")

                            <div class="inputWithFilterIcon">
                                <input type="text" id="filter01-filter" class="inputFilter form-control" placeholder="">
                                <span><i class="fas fa-filter"></i></span>
                            </div>
                        </th>
                        <th>
                            @Html.DisplayName("شماره ثبت")
                            <div class="inputWithFilterIcon">
                                <input type="text" id="filter02-filter" class="inputFilter form-control" placeholder="">

                                <span><i class="fas fa-filter"></i></span>
                            </div>
                        </th>
                        <th>
                            @Html.DisplayName("نام مسئول")
                            <div class="inputWithFilterIcon">
                                <input type="text" id="filter03-filter" class="inputFilter form-control" placeholder="">

                                <span><i class="fa fa-filter"></i></span>
                            </div>
                        </th>
                        <th>
                            @Html.DisplayName("وضعیت")
                        </th>

                    </tr>
                </thead>
                <tbody>
                    @{ int counter = 0; }
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr class="task-list-row "
                                data-filter01="@Html.DisplayFor(modelItem => item.CompanyName)"
                                data-filter02="@Html.DisplayFor(modelItem => item.RegistrationNumber)"
                                data-filter03="@item.tbUsers.FullName">
                                <td>
                                    <div class="ms-sm-4 mt-sm-0 mt-2 dropdown-toggle">
                                        <a href="#" onclick="Edit('@Url.Action("_PartialUpdateCompanies", "Company", new { id = item.ID })')" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        @*<a href="#" onclick="detail('@Url.Action("_PartialdetailCompanies", "Company", new { id = item.ID })')" data-bs-toggle="dropdown" class="text-white text-opacity-75 text-decoration-none">
                                                <i class="fa fa-detail"></i>
                                            </a>*@
                                        <div class="dropdown-menu">
                                            <a data-bs-toggle="modal" style="cursor:pointer;" data-bs-target="#modalLg" class="dropdown-item edit" id="Edit_@item.ID">ویرایش</a>
                                            @*<a data-bs-toggle="modal" style="cursor:pointer;" data-bs-target="#modalLg" class="dropdown-item detail" id="detail_@item.ID">جزییات</a>*@

                                            @if (item.IsActive != null && (bool)item.IsActive == true)
                                            {
                                                <a onclick="Disable('@Url.Action("Disable_Company", "Company", new { id = item.ID })',false)" style="cursor:pointer;" class="dropdown-item">غیرفعال</a>
                                            }
                                            else
                                            {
                                                <a onclick="Disable('@Url.Action("Disable_Company", "Company", new { id = item.ID })',true)" style="cursor:pointer;" class="dropdown-item">فعال</a>
                                            }

                                            <a class="dropdown-item uploadSummery" id="uploadSummery_@item.ID">
                                                <span>بارگذاری آرم شرکت </span>
                                            </a>
                                            @if (item.FileSystemName != null)
                                            {
                                                <a class="dropdown-item details" id="" href="~/Areas/Contracts/Contents/Peymans/@item.FileSystemName"> مشاهده آرم شرکت </a>

                                            }
                                            <input id="summery_file5" style="display:none" type="file" class="form-control" value="" />


                                        </div>

                                    </div>

                                </td>
                                <td>
                                    @{ counter = counter + 1; }

                                    <span>@counter</span>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CompanyName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RegistrationNumber)
                                </td>
                                <td>
                                    @item.tbUsers.FullName
                                </td>

                                <td>
                                    @if (item.IsActive != null && (bool)item.IsActive == true)
                                    {
                                        <i class="far fa-lg fa-fw me-2 fa-check-square" style="color:green"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-lg fa-fw me-2 fa-window-close" style="color:red"></i>
                                    }
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>
<script src="/Scripts/sweetalert2.js" type="text/javascript"></script>
<script src="/Areas/Users/Scripts/Companies/Companies.js" type="text/javascript"></script>
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script>

    var
        filters = {
            filter01: null,
            filter02: null,
            filter03: null,
            filter04: null,
        };

    function updateFilters() {
        $('.task-list-row').hide().filter(function () {
            var self = $(this),
                result = true;

            Object.keys(filters).forEach(function (filter) {
                var filterData = self.data(filter);
                if (filters[filter] && (filters[filter] != 'None') && (filters[filter] != 'همه')) {
                    // تبدیل داده به رشته و بررسی مقدار
                    result = result && (filterData && filterData.toString().indexOf(filters[filter]) !== -1);
                }
            });

            return result;
        }).show();
    }

    function changeFilter(filterName) {
        filters[filterName] = this.value;
        updateFilters();
    }

    // Assigned User Dropdown Filter
    $('#filter01-filter').on('input', function () {
        changeFilter.call(this, 'filter01');
    });
    $('#filter02-filter').on('input', function () {
        changeFilter.call(this, 'filter02');
    });
    $('#filter03-filter').on('input', function () {
        changeFilter.call(this, 'filter03');
    });
    $('#filter04-filter').on('input', function () {
        changeFilter.call(this, 'filter04');
    });

</script>
