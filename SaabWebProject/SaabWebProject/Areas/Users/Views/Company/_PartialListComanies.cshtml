        $(".inp_file").click();
    });

    $(".inp_file").change(function (e) {
        alert("File selected!"); // Just a test alert to check if change event is triggered
        // Clear FormData object before adding new files
        fd = new FormData(); // Clear FormData object before adding new files
        $.each(e.target.files, function (index, file) {
            fd.append("files", file);
        });
        // Get the ID from the element's ID attribute
        var id = $(this).attr("id").split("_")[2];
        console.log(id);
        // Send the AJAX request
        sendAjaxFile('@Url.Action("UploadFilehogogi", "Peyman", new { area = "Contracts" })', fd, id);
    });

    function sendAjaxFile(url2, fd2, id) {
