@model IEnumerable<SaabWebProject.Models.DomainModels.tbCompanies>

<select class="form-select" id="companies">
    <option value="-1">انتخاب نمایید..</option>
    @foreach (var item in Model)
    {
        <option value="@item.ID">@item.CompanyName  (@item.tbUsers.FullName)</option>
    }
</select>
<script>
    $('#companies').picker({ search: true });
</script>
