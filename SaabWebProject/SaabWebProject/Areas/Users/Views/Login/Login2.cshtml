@model SaabWebProject.Models.DomainModels.tbUsers

@{
    ViewBag.Title = "ورود";
    Layout = "~/Areas/Users/Views/Shared/_LayoutAccount.cshtml";
}
@section Style{
    <link href="~/Areas/Users/Styles/ShareStyle.css" type="text/css" rel="stylesheet" />
}
<style>
    #card-body {
        /*background-color: #ffffff99;*/
        background: linear-gradient(38deg, rgba(37 37 37 / 90%) 0%, rgb(159 159 163 / 90%) 32%, rgba(159 159 163 / 90%) 66%, rgba(37 37 37 / 90%) 100%);
        -webkit-backdrop-filter: blur(5px);
        backdrop-filter: blur(5px);
        padding: 10px 50px 10px 50px;
        color: black !important;
        border-radius: 45px;
        border: 4px solid #074f4e !important;
    }

    input.form-control {
        border: 2px solid #ffffffa6 !important;
        /*background-color: #006666e0 !important;*/
        background: linear-gradient(90deg, rgb(10 123 120) 14%, rgb(4 44 45) 125%) !important;
        color: azure !important;
    }
    input.form-control {
        position: relative;
        background-color: #006666e0 !important;
    }

    .buttonGeneral {
        background: linear-gradient(#199b94, #033f33) padding-box, linear-gradient(to bottom, #7bf1f5, #3cd0a5) border-box;
        border-radius: 33px;
        border: 2px solid transparent;
        margin-bottom: 5px;
        padding: 9px !important;
    }

    .buttonGeneral {
        position: relative;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        font-size: 1em;
        color: white !important;
        padding: 5px 12px 5px 12px;
        cursor: pointer;
    }

    .form-check-input[type="checkbox"] {
        border-radius: 5px !important;
        height: 20px;
        width: 20px;
        border: 2px solid #ffffffa6 !important;
        background-color: #137170d6 !important;
    }

    input[type="checkbox"]:checked {
        background-color: #137170a3 !important;
        border-color: #fff !important;
        border-width: 2px !important;
    }
</style>
<div class="login" style="background: url(../../assets/img/cover/Login2.png) no-repeat center fixed; background-size: cover;">

    <div class="login-content" style="display:contents;">
        <div class="alert alert-danger alert-dismissable fade show p-3" id="alert" style="display:none;">
            <p id="alert_message"></p>
        </div>
        <form name="login_form" style="margin-right:212px;">

            <div class="card-body" id="card-body" style="">
                <div class="row" style="margin-top:20px;">
                    <div class="col-xl-4" style="margin-top: 11px;">
                        <label class="form-label" style="font-weight:bold;"> نام کاربری <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-xl-8">
                        <input id="usr_NationalCode" type="number" class="form-control form-control-lg  bg-opacity-5 text-black" value="" style="border:1px solid #2f7e66;"
                               placeholder="" />
                        <div class="valid-feedback" style="color:#2f7e66;">این درسته !</div>
                        <div class="invalid-feedback">نام را صحیح وارد نمائید</div>
                    </div>
                </div>
                <div class="row" style="margin-top:20px;">
                    <div class="col-xl-4" style="margin-top: 11px;">
                        <label class="form-label" style="font-weight:bold;">رمز عبور <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-xl-8">
                        <input autocomplete="off" id="Password" type="password" class="form-control form-control-lg  bg-opacity-5 text-black" value="" style="border:1px solid #2f7e66;"
                               placeholder="" />
                        <div class="form-check">
                            <input autocomplete="off" class="form-check-input" name="Remember" type="checkbox" value="" id="customCheck1" />
                            <label class="form-check-label" for="customCheck1" style="font-weight:bold;">مرا به خاطر بسپار</label>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:20px;">
                    <div class="col-xl-12">
                        <button id="Login" type="button" class="btn btn-outline-default form-control buttonGeneral " style="border:1px solid #2f7e66;font-weight:bold;">ورود</button>
                        <a href="@Url.Action("FirstLogin","Login")" class="ms-auto  text-decoration-none text-opacity-50" style="color: #007551; font-weight: bolder;">
                            آیا تا به حال وارد نشده اید؟
                        </a>
                    </div>
                </div>
            </div>



        </form>
    </div>

</div>
@section script{
    <script src="~/Areas/Users/Scripts/ShareScript.js"></script>

    <script src="~/Areas/Users/Scripts/Login/Login.js"></script>

    <script>
        Login("@Url.Action("Login","Login")");
    </script>

}
