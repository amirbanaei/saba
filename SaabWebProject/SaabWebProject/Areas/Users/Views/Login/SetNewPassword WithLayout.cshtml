@model long
@{
    Layout = "~/Areas/Users/Views/Shared/_LayoutAccount.cshtml";

}







@{
    ViewBag.Title = "ورود";
    Layout = "~/Areas/Users/Views/Shared/_LayoutAccount.cshtml";
}
@section Style{
    <link href="~/Areas/Users/Styles/ShareStyle.css" type="text/css" rel="stylesheet" />
}

<div class="login" style="background :url(../../assets/img/cover/cover-thumb-8.jpg) no-repeat center fixed;
    background-size: cover;">

    <div class="login-content" style="display:contents;">
        <div class="alert alert-danger alert-dismissable fade show p-3" id="alert" style="display:none;">
            <p id="alert_message"></p>

        </div>

        <form method="POST" name="login_form">
            <p class="text-right" style="color:greenyellow">سلام! </p>
            <p class="text-right">به سامانه صبا خوش آمدید .</p>
            <p class="text-right">لطفا جهت  افزایش امنیت، رمز عبور خود را تغییر دهید و پس از ورود از گوشه سمت چپ منو، تصویر خودرا بارگذاری کنید</p>
            <div class="mb-3">
                <div class="row">
                    <div class="col-md-3">
                        <label class="form-label">رمز عبور جدید<span class="text-danger">*</span></label>
                        <input autocomplete="off" id="Password" type="password" class="form-control form-control-lg bg-white bg-opacity-5" value=""
                               placeholder="" />
                        <div class="invalid-feedback" id="character">رمز عبور باید بیشتر از 8 کاراکتر باشد</div>
                        <div class="invalid-feedback" id="uppercase">رمز عبور باید شامل حروف بزرگ باشد</div>
                        <div class="invalid-feedback" id="lowercase">رمز عبور باید شامل حروف کوچک باشد</div>
                        <div class="invalid-feedback" id="number">رمز عبور باید شامل عدد باشد</div>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex">
                            <label class="form-label">تکرار رمز   <span class="text-danger">*</span></label>
                        </div>
                        <input autocomplete="off" id="confirm_password" type="password" class="form-control form-control-lg bg-white bg-opacity-5" value=""
                               placeholder="" />
                        <div class="invalid-feedback">رمز عبور با هم همخوانی ندارند</div>
                    </div>
                    <div class="col-md-2" style="margin-top:30px;">
                        <button onclick='SetPassword("@Url.Action("SetNewPassword","Login")",@Model)' id="SetPass" type="button" class="btn btn-outline-theme btn-lg d-block w-100 fw-500 mb-3"> ثبت</button>

                    </div>
                </div>

            </div>

        </form>

        <script src="~/Areas/Users/Scripts/Login/SetNewPassword.js"></script>

    </div>

</div>
