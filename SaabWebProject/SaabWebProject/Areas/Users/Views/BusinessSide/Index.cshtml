@{
    ViewBag.Title = "مدیریت چارت سازمانی";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div>
    <div style="float:left;display:block;">
        <a href="@Url.Action("Export_BusinessSide", "BusinessSide")" style="margin-right:10px;margin-bottom:10px;" class="btn btn-outline-info">
            <i class="bi bi-download fa-fw me-1 VecGeneral"></i>
            <span class="bGeneral-text">دانلود فایل اکسل نمونه</span>
            
        </a>
        <a id="CreateBusinessSide" style="margin-right: 10px; cursor: pointer; margin-bottom: 10px;" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#modalLg">
            <i class="fa fa-plus-circle fa-fw me-1 VecGeneral"></i>
            <span class="bGeneral-text">افزودن سمت جدید</span>
            
        </a>
        <a style="margin-right:10px;margin-bottom:10px;cursor:pointer" onclick="OpenDialogfile()" class="btn btn-outline-info">
            <i class="bi bi-upload fa-fw me-1 VecGeneral"></i>
            <span class="bGeneral-text">آپلود فایل</span>
            
        </a>
        <a href="@Url.Action("TreeChart_BusinessSide", "BusinessSide")" style="margin-right:10px;margin-bottom:10px;cursor:pointer" class="btn btn-outline-info">
            <i class="bi bi-upload fa-fw me-1 VecGeneral"></i>
            <span class="bGeneral-text"> چارت سازمانی</span>
           
        </a>
        <input type="file" style="display:none" name="BusinessFile"/>

    </div>
    <hr/>
    <div id="BusinessSide_List">
        @Html.Action("_GetAllBusiness", "BusinessSide", new { area = "Users" })
    </div>
</div>

