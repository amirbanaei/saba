    <style type="text/css">
        #loading-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #000;
            opacity: 0.5;
        }

        #loading-message {
            position: absolute;
            width: 100%;
            height: 100%;
            line-height: 100px;
            background-color: #1a1a1a;
            vertical-align: central;
            text-align: center;
            font-size: 1.2em;
            left: 0;
            top: 0;
            opacity: 0.7;
            margin-left: 0;
            margin-top: 0;
            z-index: 100000000000;
        }
    </style>
</head>

<body class="pace-top" style="background-size: cover;">
<div id="loading-message" style="display:none;">
