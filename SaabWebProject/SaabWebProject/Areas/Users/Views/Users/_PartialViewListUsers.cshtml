@{
    Layout = null;
}
@model IEnumerable<SaabWebProject.Models.DomainModels.tbUsers>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<select class="form-select" id="select_users" name="select_users">
    
    @if (Model != null)

    {
        <option hidden value="SelectNN" >انتخاب کنید</option>
        foreach (var item in Model)
        {
            <option value="@item.usr_ID" id="selectN">@item.FullName _ @item.usr_Personal_ID</option>
        }
    }

</select>
<script src="~/Assets/js/jquery3.6.0.js"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script>
    $('#select_users').picker({ search: true });
</script>

