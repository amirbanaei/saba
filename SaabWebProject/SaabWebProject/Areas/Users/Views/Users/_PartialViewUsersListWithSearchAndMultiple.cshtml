@{
    Layout = null;
}
@model IEnumerable<SaabWebProject.Models.DomainModels.tbUsers>
<link href="~/Assets/plugins/select-picker/dist/picker.min.css" rel="stylesheet" />
<select multiple="multiple" class="form-select" id="select_users1" name="select_users1">
    <option value="-1">همه</option>
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <option value="@item.usr_ID">@item.FullName</option>
        }


    }

    else
    {

        <optgroup label="برای این سمت کاربری ثبت نشده است">
            <option value="0" disabled selected>کاربری یافت نشد</option>
        </optgroup>

    }
</select>
<script src="~/Assets/js/jquery3.6.0.js"></script>
<script src="~/Assets/plugins/select-picker/dist/picker.min.js"></script>
<script>
    $('#select_users1').picker({ search: true });
</script>

