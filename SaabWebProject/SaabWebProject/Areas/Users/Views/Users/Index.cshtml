<script>
    //$('#select_tbBusinessSide').picker({ search: true });

const Toast = Swal.mixin({
            toast: true,
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });
$(function (){

    var res = "@TempData["response"]";
    if (res == "True"){
         document.getElementById("loading-message").style.display = "none";
        Toast.fire({
             icon: 'success',
             background: '#35434A',
             color: 'white',
             title: "اطلاعات با موفقیت ذخیره شد"
         });
    }
    if (res == "False"){
             document.getElementById("loading-message").style.display = "none";
            Toast.fire({
                 icon: 'warning',
                 background: '#35434A',
                 color: 'white',
                 title: "اطلاعات ذخیره نشد"
             });
        }
    if (res == "false_NotFoundUser"){
             document.getElementById("loading-message").style.display = "none";
            Toast.fire({
                 icon: 'warning',
                 background: '#35434A',
                 color: 'white',
                 title: "این کاربر از قبل در سیستم ثبت شده است"
             });
        }
    if (res == "catch"){
             document.getElementById("loading-message").style.display = "none";
            Toast.fire({
                 icon: 'error',
                 background: '#35434A',
                 color: 'white',
                 title: "عملیات ذخیره سازی با خطا مواجه شد لطفا بعدا تلاش فرمائید"
             });
        }

});
$("#Getfilter").click(function () {
    var selectedValue = $('#select_tbBusinessSide').val();
    var url = '@Url.Action("GetFilter", "Users", new { area = "Users" })' + '?id=' + encodeURIComponent(selectedValue);

    $("#ListUsers").load(url);
});


    // Select Excel File And Submit Form
    $("input[name='MyExcelStream']").change(function () {
        var file = this.files[0];
        var ext = file.name.split('.')[1];
        if (ext == "xlsx" || ext == "xls") {

            var  obj = new FormData();

            obj.append("MyExcelStream", file);

            console.log(file);
            $.ajax({
            beforeSend:function (){
              document.getElementById("loading-message").style.display = "block";
            },
               url: "@Url.Action("ImportExel_Users","Users")",
               type: "post",
               contentType: false,
               data: obj,
               processData: false,
               cache: false,
               success: function (res) {
                   document.getElementById("loading-message").style.display = "none";
                   UploadedFile(res);
               },
               error: function (res) {
                   console.log(res);
               }
           });
        }
        else {

            Swal.fire({
                icon: 'warning',
                background: 'rgb(29,40,52)',
                color: 'white',
                confirmButtonText: 'باشه',
                title: 'نوع فایل',
                text: 'لطفا فایلی با پسوند اکسل وارد کنید',
            });
            return false;
        }

    });
    /// Open Dialog File
    function ShowDialogFile() {
        $("input[name='MyExcelStream']").val(null);
        $("input[name='MyExcelStream']").click();
    }

    $("#CreateUser").click(function () {
$("#big_modal_body").html(null);
        $("#big_modal_body").load('@Url.Content("/Users/Users/_CreateUser")');

    });


    $(".EditUser").click(function () {
$("#big_modal_body").html(null);
        var id = $(this).attr("id").split('_')[1];


$("#big_modal_body").load('@Url.Content("/Users/Users/_EditUser")?id='+id);



    });

    $(".SetAccessLevel").click(function () {
$("#big_modal_body").html(null);
        var id = $(this).attr("id").split('_')[1];
       $("#big_modal_body").load('@Url.Content(Url.Action("_TreeViewAccessLevels_Users","AccessLevel") ?? string.Empty)?Id='+id);

    });

    function UploadedFile(res) {

        if (res == "true") {

            Toast.fire({
                icon: 'success',
                background: '#35434A',
                color: 'white',
                title: "اطلاعات با موفقیت ذخیره شد"
            }).then(function () {

                document.location.reload();

            });

        }
        else {

            Toast.fire({
                icon: 'warning',
                background: '#35434A',
                color: 'white',
                title: res
            });
        }


    }


</script>
@section Scripts{
    <script>
        /// DeActive Or Active a Business
        function DeActiveUser(url, input, status) {

            var state = "غیرفعال";
            if (status) {
                state = "فعال";
            }

            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: "این کاربر در کل برنامه " + state + " می شود",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'بله, ' + state + ' کن!',
                cancelButtonText: '' + state + ' نکن'
            }).then((result) => {
                if (result.isConfirmed) {

                    var id = $(input).attr('id').split('_')[1];
                    input.setAttribute('title', state);
                    $.ajax({
                        beforeSend: function () {
                            document.getElementById("loading-message").style.display = "block";
                        },
                        url: url,
                        type: "get",
                        data: { id: id },
                        dataType: "html",
                        success: function (res) {
                            document.getElementById("loading-message").style.display = "none";
                            if (res === "False") {
                                Swal.fire({
                                    icon: 'error',
                                    confirmButtonText: 'باشه',
                                    title: 'خطا',
                                    text: 'برنامه با خطا مواجه شد',
                                });
                                return false;
                            }
                            Swal.fire({
                                icon: 'success',
                                confirmButtonText: 'باشه',
                                title: '' + state + ' شد ',
                                text: 'کاربر مورد نظر ' + state + ' شد',
                            }).then(function () {
                                document.location.reload();
                            });
                        },
                        error: function () {
                            document.getElementById("loading-message").style.display = "none";
                            Toast.fire({
                                icon: 'error',
                                background: '#35434A',
                                color: 'white',
                                title: "عملیات با خطا مواجه شد لطفا بعدا تلاش کنید"
                            });
                        }
                    });
                }
            });
        }

    </script>

}
