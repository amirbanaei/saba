    ///Validation Input Required
    function ValidationInput(inp) {
        var input = $(inp);
        if (input.val() != "") {
            input.removeClass("is-invalid");
        }
        else {
            input.addClass("is-invalid");
        }
    }

    $("#SaveEdit").click(function (){
       var Name = $("input[name='usr_Name']");
       var Family = $("input[name='usr_Family']");
       var NationalCode = $("input[name='usr_NationalCode']");
       var Personal_ID = $("input[name='usr_Personal_ID']");
       var Position = $("#select_position");
       if (Name.val() == "") {
           Name.addClass("is-invalid");
       }else
       if (Family.val() == "") {
           Family.addClass("is-invalid");
       } else
           if (NationalCode.val().length !=10) {
               NationalCode.next().text("کد ملی باید شامل 10 رقم باشد");
               NationalCode.addClass("is-invalid");
       }else
       if (Personal_ID.val() == "") {
           Personal_ID.addClass("is-invalid");
       }else
       if (Position.val() == "" || Position.val() == "0" || Position.val() == null) {
           Position.addClass("is-invalid");
       }
       else{
           document.getElementById("loading-message").style.display = "block";
           var MoalefeList = $(".moalefeItem");

           for (var i = 0; i < MoalefeList.length; i++) {
               var item = $(".moalefeItem")[i];

               try {
                   var slc = item.children[0].children[0].children[0].children[0];
                   var s = slc.nodeValue;
               }
               catch {
                   Toast.fire({
                       icon: 'warning',
                       background: '#35434A',
                       color: 'white',
                       title: "لطفا  مولفه را انتخاب کنید"
                   });
                   return false;
               }
               var inputValue = item.children[1].children[0].children[0].children[0];
               if (inputValue.value.length == 0) {
                   Toast.fire({
                       icon: 'warning',
                       background: '#35434A',
                       color: 'white',
                       title: "لطفا  مقدار مولفه " + (i + 1) + " را وارد کنید"
                   });
                   return false;
               }

           }
             $("#FormEditUser").submit();

       }


    });

</script>
