        Counter_level++;
        console.log(Counter_level);

        $.ajax({
            url: "@Url.Action("AddNewLevelForCreateUser", "Users")",
            type: "Get",
            data: { Counter: Counter_level},
            dataType: "html",
            success: function (result) {
                $("#ShowHeader").css("display", "flex");
                var moalefeList = $(".moalefeList");
                console.log(result);
                moalefeList.append(result);
                $('.select_moalefeKarbari').last().picker({ search: true });
