<script>
    let nodesLength = 0;
    function AddNewHesab(e) {
        var a = 1;
        nodesLength++;
        a++;


        $("#bankInfo").append(`
          <div class="row bankItem" id="bank_${nodesLength}">
                <div class="col-xl-2">
                    <label class="form-label" >نام بانک</label>
                    <input class="form-control"  id="ba_${nodesLength}"   ></div>
                <div class="col-xl-3">
                    <label class="form-label" >شماره کارت</label>
                    <div class="kart">
                        <input class="form-control bankKart" id="ka1_${nodesLength}" maxlength="4" oninput="moveToNext(this, 'ka2_${nodesLength}')" inputmode="numeric"/>
                        <input class="form-control bankKart" id="ka2_${nodesLength}" maxlength="4" oninput="moveToNext(this, 'ka3_${nodesLength}')" inputmode="numeric"/>
                        <input class="form-control bankKart" id="ka3_${nodesLength}" maxlength="4" oninput="moveToNext(this, 'ka4_${nodesLength}')" inputmode="numeric"/>
                        <input class="form-control bankKart" id="ka4_${nodesLength}" maxlength="4" oninput="moveToNext(this, 'ka8_${nodesLength}')" inputmode="numeric" />
                    </div>
                </div>
                <div class="col-xl-3">
                    <label class="form-label" >شماره حساب</label>
                    <input class="form-control "  id="he_${nodesLength}" type="number" inputmode="numeric" pattern="[0-9]*" placeholder=""></div>
                <div class="col-xl-3">
                    <label class="form-label" >شماره شبا</label>
                    <input class="form-control shaba"  id="sh_${nodesLength}"  inputmode="numeric" pattern="[0-9]*" placeholder="بدون IR وارد شود">
                </div>
                <div class="col-xl-1">
                    <a href="#" class="btn form-control buttonGeneralMins" onclick="clearInputs(this)" id="RemoveBank_${nodesLength}">
                          <i class="fa fa-multiply fa-fw me-1 VecGeneral"></i>
                    </a>
                </div>
           </div>


        `);
        const inputs = document.querySelectorAll('.bankKart')

        inputs.forEach(input => {
            input.addEventListener('input', () => {
                input.value = input.value.replace(/\D/g, '');
            });
        })


        //const inputs = document.querySelectorAll('.kartt')  // همه عناصر با کلاس kartt

        //inputs.forEach(input => {
        //    input.addEventListener('input', () => {
        //        let rawValue = input.value.replace(/\D/g, '').slice(0, 16)
        //        input.value = rawValue.match(/.{1,4}/g)?.join('-') || ''
        //    });
        //})
        const inputSh = document.querySelectorAll('.shaba')

        inputSh.forEach(input => {
            input.addEventListener('input', () => {
                let rawValue = input.value.replace(/\D/g, '').slice(0, 26)
                let formattedValue = ''
                if (rawValue.length > 0) formattedValue += rawValue.substring(0, 2)
                if (rawValue.length > 2) formattedValue += '-' + rawValue.substring(2, 6)
                if (rawValue.length > 6) formattedValue += '-' + rawValue.substring(6, 10)
                if (rawValue.length > 10) formattedValue += '-' + rawValue.substring(10, 14)
                if (rawValue.length > 14) formattedValue += '-' + rawValue.substring(14, 18)
                if (rawValue.length > 18) formattedValue += '-' + rawValue.substring(18, 22)
                if (rawValue.length > 22) formattedValue += '-' + rawValue.substring(22, 24)

                input.value = formattedValue
            })
        })
    }
    function clearInputs(input) {
        var RemoveId = input.id;
        var Id = RemoveId.split('_')[1];
        $("#bank_" + Id).remove();
    }
    function moveToNext(currentInput, nextInputId) {
        if (currentInput.value.length >= currentInput.maxLength) {
            if (nextInputId) {
                document.getElementById(nextInputId).focus();
            }
        }
    }

</script>

