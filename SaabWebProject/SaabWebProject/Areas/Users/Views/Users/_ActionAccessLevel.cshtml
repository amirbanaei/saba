@model List<SaabWebProject.Models.DomainModels.tbActions>
@{
    Layout = null;
}


<label class="form-control">دسترسی مورد نظر را انتخاب کنید</label>
<select class="form-control" id="ActionAccess" multiple>
    @foreach (var item in Model.OrderBy(p => p.Controller).ToList())
    {
        <option value="@item.Action_ID">@item.ActionName</option>
    }
</select>
