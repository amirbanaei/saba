@model int
<div class='row moalefeItem' id='Level_@Model'>
    <div class='col-xl-5'>
        <label class="form-label">مولفه</label>
        <div class='div_slc_moalefe' id='#div_slc_moalefe_@Model'>
            @Html.Action("MoalefeKarbari_Select", "MoalefeDastMozdi", new { area = "Contracts" })
        </div>
    </div>
    <div class='col-xl-6'>
        <label class="form-label">مقدار</label>
        <input class='form-control' type='text' name="MoalefeValue" />
    </div>
    <div class='col-xl-1'>
        <a href='#' class="btn form-control buttonGeneralMins" onclick='RemoveLevel(this)' id='RemoveLevel_@Model'>
            <i class="fa fa-multiply fa-fw me-1 VecGeneral"></i>
        </a>
    </div>
</div>
