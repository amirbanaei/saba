@model SaabWebProject.Models.DomainModels.tbUsers

<style>
    .menu .row {
        position: sticky;
        top: 0;
        text-align: center;
        z-index: 2;
    }

    .imgProfile {
        border-radius: 15px;
        background: var(--bs-app-theme-panel-bg);
        backdrop-filter: blur(1px);
        padding: 7px;
        margin-top: -15px;
        height: 240px;
        width: 240px;
    }
</style>
@if (Model != null)
{
    <div class="menu-img">
        @if (Model.usr_Picture != null)
        {
            <img class="imgProfile" src="~/Assets/img/user/@Model.usr_Picture" height="200" width="200" />
        }
        else
        {
            <img class="imgProfile" src="~/Assets/img/user/icons8-male-user-96.png" height="200" width="200" />
        }
    </div>
    <div class="menu-text d-sm-block d-none">
        <span>
            @if (@Model.FullName != null)
            {
                @Model.FullName
            }
        </span>
    </div>
}
else
{
    <div class="menu-img">
        <img class="imgProfile" src="~/Assets/img/user/icons8-male-user-96.png" height="60px" />
    </div>
    <div class="menu-text d-sm-block d-none">
        <span>
            ادمین
        </span>
    </div>
}