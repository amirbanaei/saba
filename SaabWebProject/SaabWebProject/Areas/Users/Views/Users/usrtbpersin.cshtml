@using SaabWebProject.Models.DomainModels;
@{
    Layout = null;
    SaabEntities db = new SaabEntities();

}
@model IEnumerable<SaabWebProject.Models.DomainModels.dbrelatinperson>
@{
    foreach (var item in Model)
    {
        <option value="@item.ID">@db.tbUsers.Where(p=>p.usr_ID==item.FK_usr).FirstOrDefault().FullName</option>

    }
}


