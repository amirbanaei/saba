
<h4>وضعیت وسایل نقلیه ذیل ، مناسب نمی باشد</h4>
<br />
<div class="card">
    <div class="tab-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center;margin:auto">
                            <th colspan="2" rowspan="2" >
                                @Html.DisplayName("نام قرارداد")
                            </th>
                            <th >
                                @Html.DisplayName("نوع وسیله نقلیه")
                            </th>
                            <th>
                                @Html.DisplayName("وضعیت")
                            </th>

                        </tr>
                      
                    </thead>
                    <tbody>

                        <tr style="text-align:center;">
                            <td rowspan="2" style="padding-top:25px"> <span> قوچان</span></td>
                            <td></td>
                            <td> <span> پیکان وانت (ایران 12 -412 ج 27)</span></td>
                            <td> <span> جلوبندی خراب شده است</span></td>

                        </tr>
                        <tr style="text-align:center;">
                            <td></td>
                            <td> <span> موتور سیکلت(212 ه 42)</span></td>
                            <td> <span> فاقد استارت</span></td>

                        </tr>
                        <tr style="text-align:center;">
                            <td rowspan="3" style="padding-top:50px"> <span> سرخس</span></td>
                            <td></td>
                            <td> <span> نیسان</span></td>
                            <td> <span> موجود نیست</span></td>



                        </tr>
                        <tr style="text-align:center;">
                            <td></td>
                            <td> <span>آریسان (ایران 42 -196 ه 72) </span></td>
                            <td> <span> نیاز به تعویض وغن</span></td>

                        </tr>
                        <tr style="text-align:center;">
                            <td></td>
                            <td> <span> مزدا دو کابین (ایران 74 -792 ج 12) </span></td>
                            <td> بیمه شخص ثالث خاتمه یافته است</td>
                            <td></td>
                            <td> <span> </span></td>

                        </tr>



                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>


