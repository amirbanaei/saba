@{
    //TempData["TitleLargModal"] = "dfsdfsf";
    //ViewBag.TitleLargModal = " انحراف از شاخص ها";
    Layout = null;
}
    <h4>انحراف از شاخص </h4><br>
<div class="card">
    <div class="tab-content p-4">
        <div class="tab-pane fade show active" id="allTab">
            <div class="table-responsive">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr style="text-align:center">
                            <th >
                                @Html.DisplayName("نام کارگزار")
                            </th>
                            <th>
                                @Html.DisplayName("تلفات (%)")
                            </th>
                            <th>
                                @Html.DisplayName("وصول(%)")
                            </th>
                            <th>
                                @Html.DisplayName("زمان نصب (روز)")
                            </th>
                           
                        </tr>
                    </thead>
                    <tbody>

                        <tr style="text-align:center;">
                            <td> <span>قوچان</span></td>
                            <td> 1% <i style="color:green" class="bi bi-file-arrow-up text-theme"></i> </td>
                            <td> 2%  <i style="color:red !important" class="bi bi-file-arrow-down text-theme"></i></td>
                            <td> 3% <i style="color:red !important" class="bi bi-file-arrow-down text-theme"></i></td>
                        </tr>

                        <tr style="text-align:center;">
                            <td> <span>سبزوار</span></td>
                            <td> 0.5% <i style="color:red !important" class="bi bi-file-arrow-down text-theme"></i> </td>
                            <td> 3%  <i style="color:red !important" class="bi bi-file-arrow-down text-theme"></i></td>
                            <td> 2% <i style="color:red !important" class="bi bi-file-arrow-down text-theme"></i></td>
                        </tr>

                        <tr style="text-align:center;">
                            <td> <span>نیشابور</span></td>
                            <td> 1.5% <i style="color:green" class="bi bi-file-arrow-up text-theme"></i> </td>
                            <td> 5%  <i style="color:red !important" class="bi bi-file-arrow-down text-theme"></i></td>
                            <td> 4% <i style="color:green" class="bi bi-file-arrow-up text-theme"></i></td>
                        </tr>

                        <tr style="text-align:center;">
                            <td> <span>سرخس</span></td>
                            <td> 3% <i style="color:green" class="bi bi-file-arrow-up text-theme"></i> </td>
                            <td> 12%  <i style="color:red !important" class="bi bi-file-arrow-down text-theme"></i></td>
                            <td> 7% <i style="color:red !important" class="bi bi-file-arrow-down text-theme"></i></td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-arrow">
        <div class="card-arrow-top-left"></div>
        <div class="card-arrow-top-right"></div>
        <div class="card-arrow-bottom-left"></div>
        <div class="card-arrow-bottom-right"></div>
    </div>
</div>

