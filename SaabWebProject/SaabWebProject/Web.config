<system.webServer>
  <security>
    <requestFiltering>
      <!-- اینجا واحد بایت هست -->
      <requestLimits maxAllowedContentLength="1073741824" /> 
      <!-- 200MB -->
    </requestFiltering>
  <!--30MB (دیفالت IIS) = 31457280 بایت

50MB = 52428800 بایت

100MB = 104857600 بایت

200MB = 209715200 بایت

500MB = 524288000 بایت

1GB = 1073741824 بایت-->
  </security>
</system.webServer>
