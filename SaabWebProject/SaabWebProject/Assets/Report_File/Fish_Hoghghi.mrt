        <Text58 Ref="97" type="Text" isKey="true">
          <AllowHtmlTags>True</AllowHtmlTags>
          <Border>All;[0:0:0];1;Solid;False;4;[0:0:0]</Border>
          <Brush>Transparent</Brush>
          <ClientRectangle>0.1,5,4.3,1.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Expressions isList="true" count="0" />
          <Font>B Yekan,9</Font>
          <Guid>a3503888691a446da24e3d413aaf8a92</Guid>
          <HorAlignment>Right</HorAlignment>
          <Margins>0,0,0,0</Margins>
          <Name>Text58</Name>
          <OnlyText>True</OnlyText>
          <Page isRef="30" />
          <Parent isRef="30" />
          <Text>&lt;div style="text-align: right; "&gt;&lt;font face="B Yekan"&gt;توجه:در صورتیکه نسبت به این اعالمیه اعتراض دارید ،ابتدا جزئیات فعالیت خود را کنترل&lt;/font&gt;&lt;/div&gt;&lt;div style="text-align: right; "&gt;&lt;font face="B Yekan"&gt;نموده و پس از ثبت فعالیتهای اعمال نشده یا اصالح فعالیتهای ثبت شده در سیستم ، از طریق&lt;/font&gt;&lt;/div&gt;&lt;div style="text-align: right; "&gt;&lt;font face="B Yekan"&gt;نماینده مقیم کارگزار و یا رئیس مشترکین شهرستان محل فعالیت خود ، نسبت به اعالم موارد&lt;/font&gt;&lt;/div&gt;&lt;div style="text-align: right; "&gt;&lt;font face="B Yekan"&gt;به دستگاه نظارت اقدام فرمایید&lt;/font&gt;&lt;/div&gt;</Text>
          <TextBrush>Black</TextBrush>
          <TextQuality>Wysiwyg</TextQuality>
          <Type>Expression</Type>
        </Text58>
